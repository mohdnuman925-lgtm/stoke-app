function RoutePreview({ path, size = 180, color = "#D7FF3E", mapMode = "map" }) {
  const [interactiveMode, setInteractiveMode] = useState(mapMode);

  if (!path || path.length < 2) {
    return (
      <div style={{ position: "relative", width: "100%", height: size, margin: "0 auto", display: "flex", flexDirection: "column", alignItems: "center", justifyContent: "center", background: "#0D1117", borderRadius: 16, border: `1px solid ${TOKENS.border}`, overflow: "hidden" }}>
        {/* Dark Grid Background */}
        <div style={{ position: "absolute", inset: 0, backgroundImage: "linear-gradient(rgba(255,255,255,0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.04) 1px, transparent 1px)", backgroundSize: "20px 20px" }} />
        <div style={{ position: "relative", zIndex: 2, display: "flex", alignItems: "center", gap: 8 }}>
          <div style={{ width: 10, height: 10, borderRadius: "50%", background: TOKENS.ember, boxShadow: "0 0 10px #D7FF3E", animation: "stokeFadeIn 1s infinite alternate" }} />
          <span style={{ fontSize: 12, color: TOKENS.mutedFaint, fontWeight: 600 }}>Acquiring GPS Satellite Lock…</span>
        </div>
      </div>
    );
  }

  const lats = path.map((p) => p.lat);
  const lngs = path.map((p) => p.lng);
  const minLat = Math.min(...lats), maxLat = Math.max(...lats);
  const minLng = Math.min(...lngs), maxLng = Math.max(...lngs);
  const latRange = maxLat - minLat || 0.0005;
  const lngRange = maxLng - minLng || 0.0005;
  const W = 320;
  const H = size;
  const scale = (Math.min(W, H) * 0.75) / Math.max(latRange, lngRange);
  const midLat = (minLat + maxLat) / 2, midLng = (minLng + maxLng) / 2;

  const points = path
    .map((p) => `${W / 2 + (p.lng - midLng) * scale},${H / 2 - (p.lat - midLat) * scale}`)
    .join(" ");

  const startPt = path[0];
  const startX = W / 2 + (startPt.lng - midLng) * scale;
  const startY = H / 2 - (startPt.lat - midLat) * scale;

  const last = path[path.length - 1];
  const lastX = W / 2 + (last.lng - midLng) * scale;
  const lastY = H / 2 - (last.lat - midLat) * scale;

  return (
    <div style={{ position: "relative", width: "100%", height: H, borderRadius: 16, overflow: "hidden", background: "#0B0E14", border: `1px solid ${TOKENS.border}`, boxShadow: "inset 0 0 20px rgba(0,0,0,0.8)" }}>
      {/* Map Mode: Dark street vector layer */}
      {interactiveMode === "map" && (
        <div style={{ position: "absolute", inset: 0, opacity: 0.85, pointerEvents: "none" }}>
          {/* Simulated Dark Mode Roads & Water */}
          <svg width="100%" height="100%" style={{ position: "absolute", inset: 0 }}>
            {/* Road lines */}
            <path d="M 0 40 Q 120 70 320 30" stroke="rgba(255,255,255,0.08)" strokeWidth="8" fill="none" />
            <path d="M 40 0 Q 70 100 80 200" stroke="rgba(255,255,255,0.06)" strokeWidth="6" fill="none" />
            <path d="M 0 130 L 320 120" stroke="rgba(255,255,255,0.07)" strokeWidth="5" fill="none" />
            <path d="M 220 0 L 240 200" stroke="rgba(255,255,255,0.06)" strokeWidth="6" fill="none" />
            <circle cx="280" cy="140" r="28" fill="rgba(46,212,191,0.06)" />
            {/* Street labels */}
            <text x="14" y="32" fill="rgba(255,255,255,0.22)" fontSize="8.5" fontWeight="600" letterSpacing="0.5">STOKE PARKWAY</text>
            <text x="140" y="114" fill="rgba(255,255,255,0.22)" fontSize="8.5" fontWeight="600" letterSpacing="0.5">AVENUE 7</text>
          </svg>
        </div>
      )}

      {/* Grid Pattern */}
      <div style={{ position: "absolute", inset: 0, backgroundImage: "linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px)", backgroundSize: "24px 24px", pointerEvents: "none" }} />

      {/* SVG Polyline Overlay */}
      <svg width="100%" height="100%" viewBox={`0 0 ${W} ${H}`} style={{ position: "absolute", inset: 0 }}>
        <defs>
          <filter id="routeGlow" x="-20%" y="-20%" width="140%" height="140%">
            <feDropShadow dx="0" dy="0" stdDeviation="3" floodColor="#D7FF3E" floodOpacity="0.8" />
          </filter>
        </defs>
        {/* Route Outer Shadow */}
        <polyline points={points} fill="none" stroke="rgba(215,255,62,0.3)" strokeWidth={7} strokeLinejoin="round" strokeLinecap="round" />
        {/* Route Core */}
        <polyline points={points} fill="none" stroke={color} strokeWidth={3.5} strokeLinejoin="round" strokeLinecap="round" filter="url(#routeGlow)" />
        {/* Start Point */}
        <circle cx={startX} cy={startY} r={5} fill="#10B981" stroke="#FFFFFF" strokeWidth={1.5} />
        {/* Live Runner Beacon with Pulsing Halo */}
        <circle cx={lastX} cy={lastY} r={10} fill="rgba(215,255,62,0.3)" />
        <circle cx={lastX} cy={lastY} r={5.5} fill="#D7FF3E" stroke="#0B0E13" strokeWidth={1.5} />
      </svg>

      {/* Map Mode Switcher Pill */}
      <div style={{ position: "absolute", top: 8, right: 8, zIndex: 10, display: "flex", gap: 4, background: "rgba(0,0,0,0.65)", backdropFilter: "blur(8px)", padding: "2px 4px", borderRadius: 8, border: "1px solid rgba(255,255,255,0.1)" }}>
        <button
          onClick={() => setInteractiveMode("map")}
          style={{ background: interactiveMode === "map" ? "rgba(215,255,62,0.25)" : "transparent", color: interactiveMode === "map" ? TOKENS.ember : TOKENS.muted, border: "none", borderRadius: 6, padding: "3px 6px", fontSize: 10, fontWeight: 700, cursor: "pointer" }}
        >
          🗺️ Street Map
        </button>
        <button
          onClick={() => setInteractiveMode("neon")}
          style={{ background: interactiveMode === "neon" ? "rgba(215,255,62,0.25)" : "transparent", color: interactiveMode === "neon" ? TOKENS.ember : TOKENS.muted, border: "none", borderRadius: 6, padding: "3px 6px", fontSize: 10, fontWeight: 700, cursor: "pointer" }}
        >
          ⚡ Polyline
        </button>
      </div>

      {/* Live Coordinates Pill */}
      <div style={{ position: "absolute", bottom: 8, left: 8, zIndex: 10, background: "rgba(0,0,0,0.65)", backdropFilter: "blur(8px)", padding: "3px 8px", borderRadius: 6, border: "1px solid rgba(255,255,255,0.1)", fontSize: 9.5, color: TOKENS.muted, fontVariantNumeric: "tabular-nums" }}>
        GPS: {last.lat.toFixed(4)}, {last.lng.toFixed(4)}
      </div>
    </div>
  );
}

function haversineKm(a, b) {
  const R = 6371;
  const dLat = ((b.lat - a.lat) * Math.PI) / 180;
  const dLng = ((b.lng - a.lng) * Math.PI) / 180;
  const lat1 = (a.lat * Math.PI) / 180;
  const lat2 = (b.lat * Math.PI) / 180;
  const h = Math.sin(dLat / 2) ** 2 + Math.cos(lat1) * Math.cos(lat2) * Math.sin(dLng / 2) ** 2;
  return R * 2 * Math.atan2(Math.sqrt(h), Math.sqrt(1 - h));
}

function formatTime(totalSeconds) {
  const m = Math.floor(totalSeconds / 60);
  const s = Math.floor(totalSeconds % 60);
  return `${m}:${String(s).padStart(2, "0")}`;
}

function formatDurationRunning(totalSeconds) {
  if (totalSeconds >= 3600) {
    const h = Math.floor(totalSeconds / 3600);
    const m = Math.floor((totalSeconds % 3600) / 60);
    return `${h}h ${m}m`;
  }
  const m = Math.floor(totalSeconds / 60);
  const s = Math.floor(totalSeconds % 60);
  return `${m}h ${s}m`.replace("0h ", "") || `${m}m ${s}s`;
}

const SHARE_CARD_STYLES = [
  { key: "custom", label: "📸 Upload Photo" },
  { key: "dark", label: "🌑 OLED Black" },
];

function drawCardBackground(ctx, W, H, style, customImage = null) {
  if (customImage && customImage.complete && customImage.naturalWidth > 0) {
    // Draw user custom photo with cover aspect ratio
    const imgRatio = customImage.naturalWidth / customImage.naturalHeight;
    const canvasRatio = W / H;
    let sx = 0, sy = 0, sw = customImage.naturalWidth, sh = customImage.naturalHeight;
    if (imgRatio > canvasRatio) {
      sw = customImage.naturalHeight * canvasRatio;
      sx = (customImage.naturalWidth - sw) / 2;
    } else {
      sh = customImage.naturalWidth / canvasRatio;
      sy = (customImage.naturalHeight - sh) / 2;
    }
    ctx.drawImage(customImage, sx, sy, sw, sh, 0, 0, W, H);

    // Soft cinematic gradient overlay preserving photo brilliance
    const darkOverlay = ctx.createLinearGradient(0, 0, 0, H);
    darkOverlay.addColorStop(0, "rgba(0,0,0,0.40)");
    darkOverlay.addColorStop(0.22, "rgba(0,0,0,0.10)");
    darkOverlay.addColorStop(0.55, "rgba(0,0,0,0.0)");
    darkOverlay.addColorStop(0.85, "rgba(0,0,0,0.30)");
    darkOverlay.addColorStop(1, "rgba(0,0,0,0.70)");
    ctx.fillStyle = darkOverlay;
    ctx.fillRect(0, 0, W, H);
    return { textColor: "#FFFFFF", mutedColor: "rgba(255,255,255,0.85)", isPhoto: true };
  }

  // "dark" / Clean Pure OLED Black
  ctx.fillStyle = "#000000";
  ctx.fillRect(0, 0, W, H);

  // Subtle aesthetic glow in background
  const glow = ctx.createRadialGradient(W / 2, H * 0.52, 40, W / 2, H * 0.52, 320);
  glow.addColorStop(0, "rgba(215, 255, 62, 0.22)");
  glow.addColorStop(0.6, "rgba(215, 255, 62, 0.04)");
  glow.addColorStop(1, "rgba(0,0,0,0)");
  ctx.fillStyle = glow;
  ctx.fillRect(0, 0, W, H);

  // Subtle grid pattern
  ctx.strokeStyle = "rgba(255, 255, 255, 0.04)";
  ctx.lineWidth = 1;
  for (let x = 0; x < W; x += 30) {
    ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, H); ctx.stroke();
  }
  for (let y = 0; y < H; y += 30) {
    ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(W, y); ctx.stroke();
  }

  return { textColor: "#FFFFFF", mutedColor: "rgba(255,255,255,0.75)", isPhoto: false };
}

function drawShareCard({ activityType = "run", distanceKm, elapsed, paceMinPerKm, speedKmh, path = [], style = "dark", customImage = null, brand = "STOKE", customSteps = null, athleteName = "Mohd Numan", location = "Worldwide Athlete" }) {
  const W = 450, H = 800;
  const canvas = document.createElement("canvas");
  canvas.width = W;
  canvas.height = H;
  const ctx = canvas.getContext("2d");

  const theme = drawCardBackground(ctx, W, H, style, customImage);

  // Calculate all live stats
  const distVal = typeof distanceKm === "number" ? distanceKm : 0;
  const timeSecs = typeof elapsed === "number" ? elapsed : 0;
  const timeFormatted = formatTime(timeSecs);
  
  // Pace or Speed
  let paceOrSpeedLabel = "Pace";
  let paceOrSpeedVal = (paceMinPerKm > 0 && distVal > 0) ? `${formatPace(paceMinPerKm)} /km` : "--'--\" /km";
  if (activityType === "bike") {
    paceOrSpeedLabel = "Avg Speed";
    const calcSpeed = speedKmh > 0 ? speedKmh : (timeSecs > 0 && distVal > 0 ? distVal / (timeSecs / 3600) : 0);
    paceOrSpeedVal = `${calcSpeed.toFixed(1)} km/h`;
  }

  // Steps
  const stepsVal = (customSteps || Math.round(distVal * (activityType === "walk" ? 1350 : 1240))).toLocaleString();

  // Calories
  const metFactor = activityType === "bike" ? 0.55 : activityType === "walk" ? 0.75 : 1.036;
  const calVal = `${Math.round(distVal * RUNNER_WEIGHT_KG * metFactor)} kcal`;

  // 1. TOP BRANDING BADGE
  ctx.textAlign = "center";
  ctx.shadowColor = "rgba(0, 0, 0, 0.8)";
  ctx.shadowBlur = 8;
  ctx.shadowOffsetX = 0;
  ctx.shadowOffsetY = 2;

  // App Logo
  ctx.fillStyle = "#D7FF3E";
  ctx.font = "900 18px -apple-system, BlinkMacSystemFont, 'Space Grotesk', Roboto, sans-serif";
  ctx.letterSpacing = "3px";
  ctx.fillText("STOKE ⚡", W / 2, 58);

  // Activity Tag
  ctx.fillStyle = "rgba(255, 255, 255, 0.65)";
  ctx.font = "700 12px -apple-system, BlinkMacSystemFont, 'Space Grotesk', Roboto, sans-serif";
  ctx.letterSpacing = "1.5px";
  const actName = activityType === "run" ? "OUTDOOR RUN" : activityType === "bike" ? "CYCLING RIDE" : "OUTDOOR WALK";
  ctx.fillText(actName, W / 2, 80);

  // 2. HERO DISTANCE
  ctx.fillStyle = "rgba(255, 255, 255, 0.75)";
  ctx.font = "600 14px -apple-system, BlinkMacSystemFont, 'Space Grotesk', Roboto, sans-serif";
  ctx.letterSpacing = "1px";
  ctx.fillText("DISTANCE", W / 2, 125);

  ctx.fillStyle = "#FFFFFF";
  ctx.font = "900 52px -apple-system, BlinkMacSystemFont, 'Space Grotesk', Roboto, sans-serif";
  ctx.letterSpacing = "-1px";
  ctx.fillText(`${distVal.toFixed(2)} km`, W / 2, 175);

  // 3. 4-STAT LIVE TELEMETRY GRID (Pace, Steps, Calories, Time)
  const gridY = 205;
  const gridH = 150;
  
  // Translucent Stats Card ONLY in OLED Black mode (NO black box on photos!)
  if (!theme.isPhoto) {
    ctx.fillStyle = "rgba(20, 24, 33, 0.65)";
    ctx.beginPath();
    ctx.roundRect(28, gridY, W - 56, gridH, 18);
    ctx.fill();
    ctx.strokeStyle = "rgba(255, 255, 255, 0.12)";
    ctx.lineWidth = 1.5;
    ctx.stroke();

    // Divider Line
    ctx.strokeStyle = "rgba(255, 255, 255, 0.08)";
    ctx.beginPath();
    ctx.moveTo(44, gridY + 75);
    ctx.lineTo(W - 44, gridY + 75);
    ctx.stroke();
  }

  // Stat text shadow for crisp legibility over custom photo
  ctx.shadowColor = "rgba(0, 0, 0, 0.95)";
  ctx.shadowBlur = 10;
  ctx.shadowOffsetX = 0;
  ctx.shadowOffsetY = 2;

  // Stat 1: Pace / Speed (Top Left)
  ctx.textAlign = "left";
  const col1X = 52;
  const col2X = W / 2 + 20;

  // Row 1
  ctx.fillStyle = "rgba(255, 255, 255, 0.75)";
  ctx.font = "700 12px -apple-system, BlinkMacSystemFont, 'Space Grotesk', Roboto, sans-serif";
  ctx.fillText(`⚡ ${paceOrSpeedLabel.toUpperCase()}`, col1X, gridY + 34);

  ctx.fillStyle = "#FFFFFF";
  ctx.font = "800 24px -apple-system, BlinkMacSystemFont, 'Space Grotesk', Roboto, sans-serif";
  ctx.fillText(paceOrSpeedVal, col1X, gridY + 62);

  // Stat 2: Steps (Top Right)
  ctx.fillStyle = "rgba(255, 255, 255, 0.75)";
  ctx.font = "700 12px -apple-system, BlinkMacSystemFont, 'Space Grotesk', Roboto, sans-serif";
  ctx.fillText("👟 STEPS", col2X, gridY + 34);

  ctx.fillStyle = "#FFFFFF";
  ctx.font = "800 24px -apple-system, BlinkMacSystemFont, 'Space Grotesk', Roboto, sans-serif";
  ctx.fillText(stepsVal, col2X, gridY + 62);

  // Row 2
  // Stat 3: Calories (Bottom Left)
  ctx.fillStyle = "rgba(255, 255, 255, 0.75)";
  ctx.font = "700 12px -apple-system, BlinkMacSystemFont, 'Space Grotesk', Roboto, sans-serif";
  ctx.fillText("🔥 CALORIES", col1X, gridY + 104);

  ctx.fillStyle = "#FFFFFF";
  ctx.font = "800 24px -apple-system, BlinkMacSystemFont, 'Space Grotesk', Roboto, sans-serif";
  ctx.fillText(calVal, col1X, gridY + 132);

  // Stat 4: Time (Bottom Right)
  ctx.fillStyle = "rgba(255, 255, 255, 0.75)";
  ctx.font = "700 12px -apple-system, BlinkMacSystemFont, 'Space Grotesk', Roboto, sans-serif";
  ctx.fillText("⏱️ TIME", col2X, gridY + 104);

  ctx.fillStyle = "#FFFFFF";
  ctx.font = "800 24px -apple-system, BlinkMacSystemFont, 'Space Grotesk', Roboto, sans-serif";
  ctx.fillText(timeFormatted, col2X, gridY + 132);

  // 4. GPS ROUTE POLYLINE (Floating cleanly with no black box when photo uploaded)
  const mapY = 380;
  const mapH = 340;
  const mapW = W - 56;
  const mapX = 28;

  // Only draw black card frame in OLED Black mode
  if (!theme.isPhoto) {
    ctx.fillStyle = "rgba(10, 14, 20, 0.75)";
    ctx.beginPath();
    ctx.roundRect(mapX, mapY, mapW, mapH, 20);
    ctx.fill();
    ctx.strokeStyle = "rgba(255, 255, 255, 0.14)";
    ctx.lineWidth = 1.5;
    ctx.stroke();

    ctx.textAlign = "left";
    ctx.fillStyle = "rgba(255, 255, 255, 0.8)";
    ctx.font = "700 11px -apple-system, BlinkMacSystemFont, 'Space Grotesk', Roboto, sans-serif";
    ctx.fillText("📍 LIVE GPS ROUTE MAP", mapX + 16, mapY + 26);
  }

  // Only draw the route if user ACTUALLY recorded live GPS movement points AND ran real distance
  const hasRealRun = Array.isArray(path) && path.length > 1 && distVal > 0.02;

  if (hasRealRun) {
    const validPath = path;
    const innerBoxW = mapW * 0.85;
    const innerBoxH = mapH * 0.75;
    const innerBoxX = mapX + (mapW - innerBoxW) / 2;
    const innerBoxY = mapY + (mapH - innerBoxH) / 2;

    const toMapXY = (p) => {
      const pLat = p.lat !== undefined ? p.lat : (Array.isArray(p) ? p[0] : (p.x !== undefined ? p.x : 0));
      const pLng = p.lng !== undefined ? p.lng : (Array.isArray(p) ? p[1] : (p.y !== undefined ? p.y : 0));
      
      const lats = validPath.map((pt) => pt.lat !== undefined ? pt.lat : (Array.isArray(pt) ? pt[0] : 0));
      const lngs = validPath.map((pt) => pt.lng !== undefined ? pt.lng : (Array.isArray(pt) ? pt[1] : 0));
      const minLat = Math.min(...lats), maxLat = Math.max(...lats);
      const minLng = Math.min(...lngs), maxLng = Math.max(...lngs);
      const latRange = maxLat - minLat || 0.0005;
      const lngRange = maxLng - minLng || 0.0005;
      const scale = (innerBoxW * 0.85) / Math.max(latRange, lngRange);
      const midLat = (minLat + maxLat) / 2, midLng = (minLng + maxLng) / 2;
      return [innerBoxX + innerBoxW / 2 + (pLng - midLng) * scale, innerBoxY + innerBoxH / 2 - (pLat - midLat) * scale];
    };

    // Glowing Outer Polyline floating directly over photo
    ctx.shadowColor = "rgba(215, 255, 62, 0.95)";
    ctx.shadowBlur = 18;
    ctx.strokeStyle = "rgba(215, 255, 62, 0.55)";
    ctx.lineWidth = 10;
    ctx.lineJoin = "round";
    ctx.lineCap = "round";
    ctx.beginPath();
    validPath.forEach((p, i) => {
      const [x, y] = toMapXY(p);
      if (i === 0) ctx.moveTo(x, y);
      else ctx.lineTo(x, y);
    });
    ctx.stroke();

    // Sharp Core Line
    ctx.strokeStyle = "#D7FF3E";
    ctx.lineWidth = 4.5;
    ctx.stroke();

    // Start Marker 🟢
    const [sX, sY] = toMapXY(validPath[0]);
    ctx.fillStyle = "#10B981";
    ctx.beginPath(); ctx.arc(sX, sY, 6, 0, Math.PI * 2); ctx.fill();
    ctx.strokeStyle = "#FFFFFF";
    ctx.lineWidth = 2;
    ctx.stroke();

    // Finish / Current Live Marker 🟡
    const [eX, eY] = toMapXY(validPath[validPath.length - 1]);
    ctx.fillStyle = "rgba(215, 255, 62, 0.35)";
    ctx.beginPath(); ctx.arc(eX, eY, 12, 0, Math.PI * 2); ctx.fill();
    ctx.fillStyle = "#D7FF3E";
    ctx.beginPath(); ctx.arc(eX, eY, 6.5, 0, Math.PI * 2); ctx.fill();
    ctx.strokeStyle = "#0B0E13";
    ctx.lineWidth = 1.5;
    ctx.stroke();
  }

  // 5. ATHLETE & LOCATION
  ctx.textAlign = "center";
  ctx.fillStyle = "#FFFFFF";
  ctx.font = "800 13px -apple-system, BlinkMacSystemFont, 'Space Grotesk', Roboto, sans-serif";
  ctx.fillText(athleteName, W / 2, 738);

  ctx.fillStyle = "rgba(255, 255, 255, 0.65)";
  ctx.font = "600 10.5px -apple-system, BlinkMacSystemFont, 'Space Grotesk', Roboto, sans-serif";
  ctx.fillText(location, W / 2, 754);

  // 6. FOOTER BRAND
  ctx.fillStyle = "#D7FF3E";
  ctx.font = "800 11px -apple-system, BlinkMacSystemFont, 'Space Grotesk', Roboto, sans-serif";
  ctx.letterSpacing = "2.5px";
  ctx.fillText("STOKE ⚡ ATHLETES CLUB", W / 2, 775);

  return canvas.toDataURL("image/png");
}

const RUNNER_WEIGHT_KG = 70;

const VIKARABAD_SCENIC_ROUTE = [
  { lat: 17.3345, lng: 77.9012, ele: 624 },
  { lat: 17.3352, lng: 77.9026, ele: 627 },
  { lat: 17.3361, lng: 77.9041, ele: 631 },
  { lat: 17.3368, lng: 77.9055, ele: 636 },
  { lat: 17.3379, lng: 77.9068, ele: 640 },
  { lat: 17.3392, lng: 77.9079, ele: 642 },
  { lat: 17.3405, lng: 77.9072, ele: 639 },
  { lat: 17.3418, lng: 77.9061, ele: 635 },
  { lat: 17.3426, lng: 77.9048, ele: 631 },
  { lat: 17.3432, lng: 77.9032, ele: 628 },
  { lat: 17.3428, lng: 77.9015, ele: 625 },
  { lat: 17.3415, lng: 77.9004, ele: 626 },
  { lat: 17.3398, lng: 77.8998, ele: 629 },
  { lat: 17.3382, lng: 77.9002, ele: 632 },
  { lat: 17.3365, lng: 77.9015, ele: 634 },
  { lat: 17.3345, lng: 77.9012, ele: 624 }
];
function formatPace(paceMin) {
  if (!paceMin || !isFinite(paceMin) || paceMin <= 0) return "--'--\"";
  const mins = Math.floor(paceMin);
  const secs = Math.round((paceMin - mins) * 60);
  return `${mins}'${secs < 10 ? "0" : ""}${secs}"`;
}

const GLOBAL_RUN_CITIES = [
  { id: "my_gps", name: "My Live GPS Location", country: "Worldwide Auto-Detect", lat: null, lng: null, flag: "📍", desc: "Auto-detect your real GPS coordinates anywhere" },
  { id: "dubai", name: "Dubai Marina & Palm", country: "United Arab Emirates", lat: 25.0772, lng: 55.1333, flag: "🇦🇪", desc: "Ultra-modern illuminated waterfront promenade" },
  { id: "nyc", name: "Central Park Loop", country: "New York, USA", lat: 40.785091, lng: -73.968285, flag: "🇺🇸", desc: "World-famous reservoir & rolling park hills" },
  { id: "london", name: "Hyde Park & Thames", country: "London, UK", lat: 51.507268, lng: -0.165730, flag: "🇬🇧", desc: "Historic river trail and royal palace grounds" },
  { id: "singapore", name: "Marina Bay Waterfront", country: "Singapore", lat: 1.283333, lng: 103.860667, flag: "🇸🇬", desc: "Iconic illuminated tropical bay circuit" },
  { id: "tokyo", name: "Imperial Palace Circuit", country: "Tokyo, Japan", lat: 35.685175, lng: 139.752799, flag: "🇯🇵", desc: "Japan's most iconic 5.0km runner circuit" },
  { id: "paris", name: "Seine River & Eiffel", country: "Paris, France", lat: 48.858370, lng: 2.294481, flag: "🇫🇷", desc: "Romantic riverside boulevards and monuments" },
  { id: "sydney", name: "Opera House & Harbour", country: "Sydney, Australia", lat: -33.856784, lng: 151.215297, flag: "🇦🇺", desc: "Coastal ocean breeze along the harbour" },
  { id: "berlin", name: "Tiergarten Park", country: "Berlin, Germany", lat: 52.5145, lng: 13.3501, flag: "🇩🇪", desc: "Expansive shaded marathon capital parkway" },
  { id: "hyderabad", name: "Hussain Sagar Loop", country: "Hyderabad, India", lat: 17.4239, lng: 78.4738, flag: "🇮🇳", desc: "Scenic Necklace Road lakefront running track" },
  { id: "vikarabad", name: "Ananthagiri Hills Trail", country: "Vikarabad, Telangana", lat: 17.3345, lng: 77.9012, flag: "🇮🇳", desc: "Lush forest trails & scenic rolling terrain" },
];

function generateScenicLoop(centerLat, centerLng, distKm = 4.2) {
  const points = [];
  const numPoints = 20;
  const radiusLat = (distKm / 111) * 0.35;
  const radiusLng = (distKm / (111 * Math.cos((centerLat * Math.PI) / 180))) * 0.35;

  for (let i = 0; i < numPoints; i++) {
    const angle = (i / numPoints) * 2 * Math.PI;
    const wobble = 1 + 0.22 * Math.sin(3 * angle) + 0.12 * Math.cos(2 * angle);
    const pLat = centerLat + Math.sin(angle) * radiusLat * wobble;
    const pLng = centerLng + Math.cos(angle) * radiusLng * wobble;
    points.push({ lat: Number(pLat.toFixed(5)), lng: Number(pLng.toFixed(5)), ele: Math.round(50 + 25 * Math.sin(angle)) });
  }
  points.push({ ...points[0] });
  return points;
}

function StokeLiveMap({
  path = [],
  routePath = [],
  userPos = null,
  setUserPos = () => {},
  setRoutePath = () => {},
  is3DTilted = false,
  mapTileType = "dark",
  simulating = false,
  runStage = "map_idle",
  flyoverActive = false,
  onToggle3D = () => {},
  onToggleLayers = () => {},
  onRecenter = () => {},
  height = "100%"
}) {
  const containerRef = useRef(null);
  const mapRef = useRef(null);
  const polylineRef = useRef(null);
  const markerRef = useRef(null);
  const tileLayerRef = useRef(null);

  const getLatLng = (p) => {
    if (!p) return [17.3345, 77.9012];
    if (Array.isArray(p) && typeof p[0] === "number" && typeof p[1] === "number" && !isNaN(p[0]) && !isNaN(p[1])) {
      return [p[0], p[1]];
    }
    if (typeof p === "object" && typeof p.lat === "number" && typeof p.lng === "number" && !isNaN(p.lat) && !isNaN(p.lng)) {
      return [p.lat, p.lng];
    }
    return [17.3345, 77.9012];
  };

  const initialCenter = getLatLng(userPos);

  useEffect(() => {
    if (!containerRef.current || typeof window === "undefined" || !window.L) return;
    if (!mapRef.current) {
      const map = L.map(containerRef.current, {
        zoomControl: false,
        attributionControl: false,
        fadeAnimation: true,
        scrollWheelZoom: false
      }).setView(initialCenter, 15);
      mapRef.current = map;

      const tileUrls = {
        dark: "https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Dark_Gray_Base/MapServer/tile/{z}/{y}/{x}",
        satellite: "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",
        topo: "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
      };

      const tileLayer = L.tileLayer(tileUrls[mapTileType] || tileUrls.dark, { maxZoom: 19, maxNativeZoom: 16 }).addTo(map);
      tileLayerRef.current = tileLayer;

      const runnerIcon = L.divIcon({
        className: "custom-runner-icon",
        html: `<div class="stoke-runner-beacon"><div class="stoke-runner-pulse"></div><div class="stoke-runner-dot"></div><div class="stoke-runner-beam"></div></div>`,
        iconSize: [28, 28],
        iconAnchor: [14, 14]
      });

      markerRef.current = L.marker(initialCenter, { icon: runnerIcon }).addTo(map);

      polylineRef.current = L.polyline([], {
        color: "#D7FF3E",
        weight: 5,
        opacity: 0.95,
        lineCap: "round",
        lineJoin: "round"
      }).addTo(map);
    }

    return () => {
      if (mapRef.current) {
        mapRef.current.remove();
        mapRef.current = null;
      }
    };
  }, []);

  useEffect(() => {
    if (!mapRef.current || !tileLayerRef.current || !window.L) return;
    const tileUrls = {
      dark: "https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Dark_Gray_Base/MapServer/tile/{z}/{y}/{x}",
      satellite: "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",
      topo: "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
    };
    tileLayerRef.current.setUrl(tileUrls[mapTileType] || tileUrls.dark);
  }, [mapTileType]);

  useEffect(() => {
    if (!mapRef.current || !window.L) return;

    // When running, paused, or finished, ONLY show real recorded footsteps - NO fake route!
    let sourcePath = [];
    if (runStage === "map_active" || runStage === "paused" || simulating) {
      sourcePath = (path && path.length > 1) ? path : [];
    } else if (runStage === "activity_detail") {
      sourcePath = (path && path.length > 1) ? path : [];
    } else {
      sourcePath = [];
    }
    const latLngs = sourcePath.map(getLatLng);

    if (polylineRef.current) {
      polylineRef.current.setLatLngs(latLngs);
    }

    const currentPos = getLatLng(userPos);
    if (markerRef.current && currentPos) {
      markerRef.current.setLatLng(currentPos);
      if (!flyoverActive && mapRef.current) {
        if (runStage === "map_active" || runStage === "paused" || simulating) {
          // Follow runner live as they run
          mapRef.current.panTo(currentPos, { animate: true, duration: 0.5 });
        } else {
          const center = mapRef.current.getCenter();
          const distDeg = Math.abs(center.lat - currentPos[0]) + Math.abs(center.lng - currentPos[1]);
          if (distDeg > 0.4) {
            mapRef.current.setView(currentPos, 15, { animate: true });
          } else {
            mapRef.current.panTo(currentPos, { animate: true, duration: 0.4 });
          }
        }
      }
    }
  }, [path, routePath, userPos, flyoverActive, runStage, simulating]);

  useEffect(() => {
    if (!flyoverActive || !mapRef.current) return;
    const sourcePath = (routePath && routePath.length > 0) ? routePath : VIKARABAD_SCENIC_ROUTE;
    let idx = 0;
    const interval = setInterval(() => {
      if (idx < sourcePath.length) {
        mapRef.current.panTo(getLatLng(sourcePath[idx]), { animate: true, duration: 0.8 });
        idx++;
      } else {
        clearInterval(interval);
      }
    }, 1000);
    return () => clearInterval(interval);
  }, [flyoverActive, routePath]);

  return (
    <div
      ref={containerRef}
      style={{
        width: "100%",
        height: height,
        position: "relative",
        background: "#0B0E14",
        transform: is3DTilted ? "perspective(900px) rotateX(24deg) scale(1.05)" : "none",
        transition: "transform 0.4s cubic-bezier(0.4, 0, 0.2, 1)",
      }}
    />
  );
}

function RunScreen({ profile, runs, setRuns, status, elapsed, distanceKm, setDistanceKm, gpsError, accuracy, shareCardUrl, shareStyle, onChangeStyle, pathRef, handleStart, handlePause, handleResume, handleFinish, handleReset, liveGpsPos = null }) {
  const [activityType, setActivityType] = useState("run"); // "run" | "bike" | "walk"
  const [runStage, setRunStage] = useState("map_idle"); // "map_idle" | "map_active" | "hud_fullscreen" | "paused" | "save_form" | "celebration" | "activity_detail"
  const [mapTileType, setMapTileType] = useState("dark"); // "dark" | "satellite" | "topo"
  const [is3DTilted, setIs3DTilted] = useState(false);
  const [simulating, setSimulating] = useState(false);
  const [flyoverActive, setFlyoverActive] = useState(false);
  const [audioCues, setAudioCues] = useState(true);
  const [selectedVoice, setSelectedVoice] = useState("lily"); // "lily" | "chloe" | "maya"
  const [showVoicePicker, setShowVoicePicker] = useState(false);
  const [kudosCount, setKudosCount] = useState(1);
  const [hasLiked, setHasLiked] = useState(false);
  const [activeSubTab, setActiveSubTab] = useState("tracker");

  // Global City & Real GPS State
  const [selectedCity, setSelectedCity] = useState(GLOBAL_RUN_CITIES[0]);
  const [showLocationPicker, setShowLocationPicker] = useState(false);
  const [citySearchQuery, setCitySearchQuery] = useState("");
  const [citySearchResults, setCitySearchResults] = useState([]);
  const [isSearchingCity, setIsSearchingCity] = useState(false);
  const [leaderboardFilter, setLeaderboardFilter] = useState("worldwide");

  // Live Leaflet Route & Marker State
  const [routePath, setRoutePath] = useState(VIKARABAD_SCENIC_ROUTE);
  const [userPos, setUserPos] = useState([VIKARABAD_SCENIC_ROUTE[0].lat, VIKARABAD_SCENIC_ROUTE[0].lng]);
  const [customSteps, setCustomSteps] = useState(0);

  // Sync userPos directly with real live outdoor GPS watchPosition
  useEffect(() => {
    if (liveGpsPos && Array.isArray(liveGpsPos) && liveGpsPos.length === 2 && !isNaN(liveGpsPos[0])) {
      setUserPos(liveGpsPos);
    }
  }, [liveGpsPos]);

  // Auto-detect real device GPS anywhere in the world on load
  useEffect(() => {
    if (navigator.geolocation) {
      navigator.geolocation.getCurrentPosition(
        (pos) => {
          const lat = pos.coords.latitude;
          const lng = pos.coords.longitude;
          const liveCity = {
            id: "my_gps",
            name: "Current GPS Location",
            country: "Live Position",
            lat,
            lng,
            flag: "📍",
            desc: "Device GPS tracking active"
          };
          setSelectedCity(liveCity);
          setUserPos([lat, lng]);
          setRoutePath(generateScenicLoop(lat, lng, 4.5));
          fetch(`https://nominatim.openstreetmap.org/reverse?lat=${lat}&lon=${lng}&format=json`)
            .then((r) => r.json())
            .then((data) => {
              const detectedCity = data.address?.city || data.address?.town || data.address?.suburb || data.address?.state_district || "Local Area";
              const detectedCountry = data.address?.country || "Earth";
              setSelectedCity({ ...liveCity, name: detectedCity, country: detectedCountry });
            })
            .catch(() => {});
        },
        () => {
          // If denied, default to Dubai Marina
          const fallback = GLOBAL_RUN_CITIES[1];
          setSelectedCity(fallback);
          setUserPos([fallback.lat, fallback.lng]);
          setRoutePath(generateScenicLoop(fallback.lat, fallback.lng, 5.0));
        },
        { enableHighAccuracy: true, timeout: 6000 }
      );
    }
  }, []);

  function selectGlobalCity(city) {
    if (city.id === "my_gps" || (city.lat === null && city.lng === null)) {
      if (navigator.geolocation) {
        navigator.geolocation.getCurrentPosition(
          (pos) => {
            const lat = pos.coords.latitude;
            const lng = pos.coords.longitude;
            const liveCity = {
              id: "my_gps",
              name: "My Live Location",
              country: "Real GPS",
              lat,
              lng,
              flag: "📍",
              desc: "Accurate real-time GPS tracking"
            };
            setSelectedCity(liveCity);
            setUserPos([lat, lng]);
            setRoutePath(generateScenicLoop(lat, lng, 4.5));
            setShowLocationPicker(false);
            fetch(`https://nominatim.openstreetmap.org/reverse?lat=${lat}&lon=${lng}&format=json`)
              .then((r) => r.json())
              .then((data) => {
                const detectedName = data.address?.city || data.address?.town || data.address?.suburb || "Local Area";
                const detectedCountry = data.address?.country || "Earth";
                setSelectedCity({ ...liveCity, name: detectedName, country: detectedCountry });
              })
              .catch(() => {});
          },
          () => {
            alert("Could not access GPS. Please check location permissions.");
          },
          { enableHighAccuracy: true, timeout: 10000 }
        );
      }
      return;
    }

    setSelectedCity(city);
    setUserPos([city.lat, city.lng]);
    setRoutePath(generateScenicLoop(city.lat, city.lng, 5.0));
    setShowLocationPicker(false);
  }

  async function handleCitySearch() {
    if (!citySearchQuery.trim()) return;
    setIsSearchingCity(true);
    try {
      const res = await fetch(`https://nominatim.openstreetmap.org/search?q=${encodeURIComponent(citySearchQuery)}&format=json&limit=5`);
      const data = await res.json();
      setCitySearchResults(data || []);
    } catch (e) {
      console.warn("City search error:", e);
    } finally {
      setIsSearchingCity(false);
    }
  }

  function handleSelectSearchResult(item) {
    const lat = parseFloat(item.lat);
    const lng = parseFloat(item.lon);
    const parts = item.display_name.split(",");
    const cityName = parts[0].trim();
    const countryName = parts[parts.length - 1].trim();
    const customCity = {
      id: `custom_${Date.now()}`,
      name: cityName,
      country: countryName,
      lat,
      lng,
      flag: "🌍",
      desc: item.display_name
    };
    setSelectedCity(customCity);
    setUserPos([lat, lng]);
    setRoutePath(generateScenicLoop(lat, lng, 4.8));
    setCitySearchResults([]);
    setCitySearchQuery("");
    setShowLocationPicker(false);
  }

  // Save Form Inputs
  const [activityTitle, setActivityTitle] = useState("Afternoon Run");
  const [activityDesc, setActivityDesc] = useState("");
  const [selectedTag, setSelectedTag] = useState("Workout");
  const [exertionRating, setExertionRating] = useState(5);
  const [privateNotes, setPrivateNotes] = useState("");
  const [selectedGear, setSelectedGear] = useState("Nike Air Zoom Pegasus 40");
  const [activityPhotos, setActivityPhotos] = useState([]);
  const [savedActivity, setSavedActivity] = useState(null);

  // Aliases for JSX bindings
  const perceivedExertion = exertionRating;
  const setPerceivedExertion = setExertionRating;

  // Story Generator State
  const [showStoryModal, setShowStoryModal] = useState(false);
  const [cardPhoto, setCardPhoto] = useState(null);
  const [generatedCardUrl, setGeneratedCardUrl] = useState(null);
  const fileInputRef = useRef(null);
  const photoUploadInputRef = useRef(null);
  const lastAnnouncedKmRef = useRef(0);
  const simIntervalRef = useRef(null);
  const [challenges, setChallenges] = useState(INITIAL_CHALLENGES);
  const [isPlayingMusic, setIsPlayingMusic] = useState(false);
  const [currentTrackIdx, setCurrentTrackIdx] = useState(0);

  const activePersona = GIRL_VOICES.find((v) => v.id === selectedVoice) || GIRL_VOICES[0];

  const metFactor = activityType === "bike" ? 0.55 : activityType === "walk" ? 0.75 : 1.036;
  const liveDist = distanceKm > 0 ? distanceKm : 0;
  const livePace = (liveDist >= 0.01 && elapsed > 0) ? (elapsed / 60 / liveDist) : 0;
  const liveCalories = Math.round(liveDist * RUNNER_WEIGHT_KG * metFactor);
  const liveSteps = Math.max(customSteps, Math.round(liveDist * (activityType === "walk" ? 1350 : 1240)));

  const pace = livePace;
  const calories = liveCalories;
  const paceMinPerKm = livePace;
  const speedKmh = (elapsed > 0 && liveDist > 0) ? (liveDist / (elapsed / 3600)) : 0;

  // Sync runStage with parent status
  useEffect(() => {
    if (status === "active" && runStage === "map_idle") {
      setRunStage("map_active");
    } else if (status === "paused" && runStage === "map_active") {
      setRunStage("paused");
    }
  }, [status]);

  // Live hardware accelerometer step counting when walking
  useEffect(() => {
    if (status !== "active" || activityType !== "walk") return;

    let lastAccel = 0;
    let lastStepTime = 0;
    const threshold = 1.8;

    const onMotion = (event) => {
      const acc = event.accelerationIncludingGravity || event.acceleration;
      if (!acc) return;
      const mag = Math.sqrt((acc.x || 0) ** 2 + (acc.y || 0) ** 2 + (acc.z || 0) ** 2);
      const delta = Math.abs(mag - lastAccel);
      lastAccel = mag;

      const now = Date.now();
      if (delta > threshold && now - lastStepTime > 320) {
        lastStepTime = now;
        setCustomSteps((s) => s + 1);
      }
    };

    if (typeof window !== "undefined" && window.DeviceMotionEvent) {
      window.addEventListener("devicemotion", onMotion, { passive: true });
    }

    return () => {
      if (typeof window !== "undefined" && window.DeviceMotionEvent) {
        window.removeEventListener("devicemotion", onMotion);
      }
    };
  }, [status, activityType]);

  // Simulated GPS tracker for test/demo mode across chosen global city
  useEffect(() => {
    if (simulating) {
      let stepIdx = 0;
      const activeRoute = (routePath && routePath.length > 3) ? routePath : VIKARABAD_SCENIC_ROUTE;
      simIntervalRef.current = setInterval(() => {
        if (stepIdx < activeRoute.length) {
          const pt = activeRoute[stepIdx];
          const lat = pt.lat !== undefined ? pt.lat : pt[0];
          const lng = pt.lng !== undefined ? pt.lng : pt[1];
          setUserPos([lat, lng]);
          if (pathRef && pathRef.current) {
            pathRef.current.push({ lat, lng });
          }
          if (stepIdx > 0 && typeof setDistanceKm === "function") {
            const prevPt = activeRoute[stepIdx - 1];
            const prevLat = prevPt.lat !== undefined ? prevPt.lat : prevPt[0];
            const prevLng = prevPt.lng !== undefined ? prevPt.lng : prevPt[1];
            const d = haversineKm({ lat: prevLat, lng: prevLng }, { lat, lng });
            if (d > 0) setDistanceKm((prev) => Number((prev + d).toFixed(3)));
          }
          stepIdx++;
        } else {
          stepIdx = 0;
        }
      }, 1200);
    } else {
      if (simIntervalRef.current) clearInterval(simIntervalRef.current);
    }
    return () => {
      if (simIntervalRef.current) clearInterval(simIntervalRef.current);
    };
  }, [simulating, routePath]);

  // Voice announcements for split milestones
  useEffect(() => {
    if (status === "active" && audioCues && distanceKm >= 1) {
      const currentKm = Math.floor(distanceKm);
      if (currentKm > lastAnnouncedKmRef.current) {
        lastAnnouncedKmRef.current = currentKm;
        const paceM = Math.floor(paceMinPerKm);
        const paceS = Math.round((paceMinPerKm % 1) * 60);
        const msg = activePersona.splitMsg(currentKm, paceM, paceS, speedKmh, activityType === "bike");
        speakAudioCue(msg, selectedVoice);
      }
    }
  }, [distanceKm, status, audioCues, paceMinPerKm, speedKmh, activityType, selectedVoice, activePersona]);

  // Generate 9:16 Story Card
  useEffect(() => {
    if (showStoryModal || runStage === "activity_detail") {
      const activeDist = Number(liveDist.toFixed(2));
      const activeElapsed = elapsed > 0 ? elapsed : 1;
      const activePace = livePace;
      const activeSpeed = speedKmh;

      const loc = selectedCity ? `${selectedCity.name}, ${selectedCity.country}` : "Worldwide Athlete";
      const realPath = (pathRef && pathRef.current && pathRef.current.length > 1 && activeDist > 0.02)
        ? pathRef.current
        : (savedActivity?.path && savedActivity.path.length > 1 && (savedActivity.distance || savedActivity.distanceKm) > 0.02 ? savedActivity.path : []);

      const cardParams = {
        activityType,
        distanceKm: activeDist,
        elapsed: activeElapsed,
        paceMinPerKm: activePace,
        speedKmh: activeSpeed,
        path: realPath,
        style: cardPhoto ? "custom" : shareStyle,
        brand: "STOKE",
        customImage: null,
        athleteName: profile?.name || "Mohd Numan",
        location: loc
      };

      if (cardPhoto) {
        const img = new Image();
        img.onload = () => {
          cardParams.customImage = img;
          setGeneratedCardUrl(drawShareCard(cardParams));
        };
        img.src = cardPhoto;
      } else {
        setGeneratedCardUrl(drawShareCard(cardParams));
      }
    }
  }, [showStoryModal, runStage, distanceKm, elapsed, shareStyle, cardPhoto, activityType, selectedCity]);

  const onStartWithVoice = () => {
    lastAnnouncedKmRef.current = 0;
    setRunStage("map_active");
    if (audioCues) speakAudioCue(activePersona.startMsg(activityType), selectedVoice);
    handleStart();
  };

  const onStartDemoSim = () => {
    setSimulating(true);
    onStartWithVoice();
  };

  const onPauseWithVoice = () => {
    setRunStage("paused");
    if (audioCues) speakAudioCue(activePersona.pauseMsg, selectedVoice);
    handlePause();
  };

  const onResumeWithVoice = () => {
    setRunStage("map_active");
    if (audioCues) speakAudioCue(activePersona.resumeMsg, selectedVoice);
    handleResume();
  };

  const onFinishWithVoice = () => {
    setSimulating(false);
    handlePause();
    setRunStage("save_form");
    
    if (audioCues) {
      speakAudioCue(activePersona.finishMsg(Number(liveDist.toFixed(2)), liveSteps), selectedVoice);
    }
  };

  const handleSaveActivitySubmit = () => {
    const finalDist = Number(liveDist.toFixed(2));
    const finalElapsed = elapsed > 0 ? elapsed : 1;
    const finalPace = livePace;
    const finalCalories = liveCalories;
    const finalSteps = liveSteps;
    const finalPath = (pathRef && pathRef.current && pathRef.current.length > 1 && finalDist > 0.02) ? [...pathRef.current] : [];

    const locString = selectedCity ? `${selectedCity.name}, ${selectedCity.country}` : "Worldwide GPS";
    const newActivity = {
      id: Date.now(),
      title: activityTitle || "Afternoon Run",
      description: activityDesc,
      sport: activityType,
      distance: finalDist,
      distanceKm: finalDist,
      time: finalElapsed,
      elapsed: finalElapsed,
      pace: finalPace,
      paceMinPerKm: finalPace,
      calories: finalCalories,
      elevationGain: Math.max(1, Math.round(finalDist * 16)),
      maxElevation: 682,
      steps: finalSteps,
      tag: selectedTag,
      exertion: exertionRating,
      notes: privateNotes,
      gear: selectedGear,
      path: finalPath,
      photos: activityPhotos,
      athleteName: profile && profile.name ? profile.name : "Mohd Numan",
      location: locString,
      date: `Today at ${new Date().toLocaleTimeString([], { hour: "numeric", minute: "2-digit" })}`,
      dateStr: `Today at ${new Date().toLocaleTimeString([], { hour: "numeric", minute: "2-digit" })} · ${locString}`
    };

    setSavedActivity(newActivity);
    setRuns((prev) => [
      { date: "Today", distanceKm: finalDist, elapsed: finalElapsed, paceMinPerKm: finalPace, calories: finalCalories, path: finalPath, type: activityType },
      ...prev
    ]);

    // Show "Nice work!" celebration splash
    setRunStage("celebration");
    setTimeout(() => {
      setRunStage("activity_detail");
    }, 2200);
  };

  const handleSaveActivity = handleSaveActivitySubmit;

  const toggleLayerStyle = () => {
    setMapTileType((prev) => (prev === "dark" ? "satellite" : prev === "satellite" ? "topo" : "dark"));
  };

  const handlePhotoAdd = (e) => {
    const file = e.target.files && e.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = (evt) => {
      setActivityPhotos((prev) => [...prev, evt.target.result]);
    };
    reader.readAsDataURL(file);
  };

  const handleStoryPhotoUpload = (e) => {
    const file = e.target.files && e.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = (evt) => {
      setCardPhoto(evt.target.result);
      onChangeStyle("custom");
    };
    reader.readAsDataURL(file);
  };

  const activeDistDisplay = Number(liveDist.toFixed(2));
  const activeElapsedDisplay = elapsed;
  const activePaceDisplay = livePace;

  function handlePhotoUpload(e) {
    const file = e.target.files && e.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = (event) => {
      const dataUri = event.target.result;
      setCardPhoto(dataUri);
      onChangeStyle("custom");

      const img = new Image();
      img.onload = () => {
        const activeDist = Number(liveDist.toFixed(2));
        const activeElapsed = elapsed > 0 ? elapsed : 1;
        const loc = selectedCity ? `${selectedCity.name}, ${selectedCity.country}` : "Worldwide Athlete";
        const realPath = (pathRef && pathRef.current && pathRef.current.length > 1 && activeDist > 0.02)
          ? pathRef.current
          : (savedActivity?.path && savedActivity.path.length > 1 && (savedActivity.distance || savedActivity.distanceKm) > 0.02 ? savedActivity.path : []);
        const cardParams = {
          activityType,
          distanceKm: activeDist,
          elapsed: activeElapsed,
          paceMinPerKm: livePace,
          speedKmh,
          path: realPath,
          style: "custom",
          brand: "STOKE",
          customImage: img,
          athleteName: profile?.name || "Mohd Numan",
          location: loc
        };
        const generated = drawShareCard(cardParams);
        setGeneratedCardUrl(generated);
      };
      img.src = dataUri;
    };
    reader.readAsDataURL(file);
  }

  async function handleShare() {
    const urlToShare = generatedCardUrl || shareCardUrl;
    if (!urlToShare) return;
    try {
      const blob = await (await fetch(urlToShare)).blob();
      const filename = `stoke-${activityType}-story.png`;
      const file = new File([blob], filename, { type: "image/png" });
      if (navigator.canShare && navigator.canShare({ files: [file] })) {
        await navigator.share({
          files: [file],
          title: `My STOKE ${activityType.toUpperCase()} Activity`,
          text: `Crushed a ${distanceKm.toFixed(2)} km ${activityType}! ⚡🔥`,
        });
      } else {
        const a = document.createElement("a");
        a.href = urlToShare;
        a.download = filename;
        a.click();
      }
    } catch (err) {
      console.log("Share skipped", err);
    }
  }

  function toggleJoinChallenge(id) {
    setChallenges((prev) =>
      prev.map((c) => (c.id === id ? { ...c, joined: !c.joined, participants: c.joined ? c.participants - 1 : c.participants + 1 } : c))
    );
  }

  const ACTIVITIES = [
    { key: "run", label: "Run", icon: "🏃", unit: "/km pace", desc: "Pace & Splits" },
    { key: "bike", label: "Bike / Ride", icon: "🚴", unit: "km/h speed", desc: "Speed & Distance" },
    { key: "walk", label: "Walk", icon: "🚶", unit: "steps count", desc: "Steps & Active Time" },
  ];

  const currentTrack = WORKOUT_TRACKS[currentTrackIdx];

  return (
    <div style={{ position: "relative", minHeight: "100vh", paddingBottom: 60 }}>
      {/* Voice Coach Picker Modal */}
      {showVoicePicker && (
        <div style={{ position: "fixed", inset: 0, zIndex: 9999, background: "rgba(0,0,0,0.85)", backdropFilter: "blur(8px)", display: "flex", alignItems: "center", justifyContent: "center", padding: 16 }}>
          <div style={{ background: "#13171F", border: `1px solid rgba(255,128,191,0.4)`, borderRadius: 22, padding: 22, maxWidth: 380, width: "100%", boxShadow: "0 20px 50px rgba(0,0,0,0.8)" }}>
            <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 14 }}>
              <div style={{ display: "flex", alignItems: "center", gap: 8 }}>
                <span style={{ fontSize: 20 }}>🎀</span>
                <div>
                  <div style={{ fontSize: 16, fontWeight: 800, color: TOKENS.text }}>Choose Voice Coach</div>
                  <div style={{ fontSize: 11, color: TOKENS.mutedFaint }}>Pick your favorite cute voice personality</div>
                </div>
              </div>
              <button onClick={() => setShowVoicePicker(false)} style={{ background: "rgba(255,255,255,0.1)", border: "none", color: "#fff", width: 28, height: 28, borderRadius: "50%", cursor: "pointer", fontSize: 14 }}>✕</button>
            </div>

            <div style={{ display: "flex", flexDirection: "column", gap: 10, marginBottom: 16 }}>
              {GIRL_VOICES.map((v) => {
                const isSelected = selectedVoice === v.id;
                return (
                  <div
                    key={v.id}
                    onClick={() => {
                      setSelectedVoice(v.id);
                      speakAudioCue(v.preview, v.id);
                    }}
                    style={{
                      display: "flex",
                      alignItems: "center",
                      justifyContent: "space-between",
                      padding: "12px 14px",
                      borderRadius: 14,
                      background: isSelected ? "rgba(255, 128, 191, 0.15)" : "rgba(255,255,255,0.03)",
                      border: isSelected ? `1.5px solid #FF80BF` : `1px solid rgba(255,255,255,0.06)`,
                      cursor: "pointer",
                      transition: "all 0.15s ease",
                    }}
                  >
                    <div style={{ display: "flex", alignItems: "center", gap: 10 }}>
                      <div style={{ width: 38, height: 38, borderRadius: 12, background: isSelected ? "rgba(255,128,191,0.25)" : "rgba(255,255,255,0.06)", display: "flex", alignItems: "center", justifyContent: "center", fontSize: 20 }}>
                        {v.avatar}
                      </div>
                      <div>
                        <div style={{ fontSize: 13.5, fontWeight: 800, color: isSelected ? "#FF80BF" : TOKENS.text }}>
                          Coach {v.name}
                        </div>
                        <div style={{ fontSize: 11, color: TOKENS.mutedFaint }}>{v.tag}</div>
                      </div>
                    </div>

                    <button
                      onClick={(e) => {
                        e.stopPropagation();
                        setSelectedVoice(v.id);
                        speakAudioCue(v.preview, v.id);
                      }}
                      style={{
                        padding: "5px 10px",
                        borderRadius: 8,
                        background: isSelected ? "#FF80BF" : "rgba(255,255,255,0.08)",
                        color: isSelected ? "#000" : TOKENS.text,
                        border: "none",
                        fontSize: 11,
                        fontWeight: 700,
                        cursor: "pointer",
                      }}
                    >
                      ▶ Listen
                    </button>
                  </div>
                );
              })}
            </div>

            <button
              onClick={() => setShowVoicePicker(false)}
              style={{ width: "100%", padding: "12px 0", borderRadius: 12, background: TOKENS.ember, border: "none", color: "#0B0E13", fontWeight: 800, fontSize: 13.5, cursor: "pointer" }}
            >
              ✓ Set Active Coach
            </button>
          </div>
        </div>
      )}

      {/* Worldwide Running Location Picker Modal */}
      {showLocationPicker && (
        <div style={{ position: "fixed", inset: 0, zIndex: 99999, background: "rgba(0,0,0,0.88)", backdropFilter: "blur(10px)", display: "flex", alignItems: "center", justifyContent: "center", padding: 16 }}>
          <div style={{ background: "#11151D", border: `1px solid rgba(255,255,255,0.15)`, borderRadius: 24, padding: 22, maxWidth: 440, width: "100%", maxHeight: "88vh", overflowY: "auto", boxShadow: "0 24px 60px rgba(0,0,0,0.9)" }}>
            <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 14 }}>
              <div style={{ display: "flex", alignItems: "center", gap: 8 }}>
                <span style={{ fontSize: 24 }}>🌍</span>
                <div>
                  <div style={{ fontSize: 17, fontWeight: 900, color: TOKENS.text }}>Choose Running Location</div>
                  <div style={{ fontSize: 11, color: TOKENS.mutedFaint }}>Run anywhere in the world with live GPS & routes</div>
                </div>
              </div>
              <button onClick={() => setShowLocationPicker(false)} style={{ background: "rgba(255,255,255,0.1)", border: "none", color: "#fff", width: 28, height: 28, borderRadius: "50%", cursor: "pointer", fontSize: 14 }}>✕</button>
            </div>

            {/* City Search Bar */}
            <div style={{ display: "flex", gap: 8, marginBottom: 16 }}>
              <input
                type="text"
                value={citySearchQuery}
                onChange={(e) => setCitySearchQuery(e.target.value)}
                onKeyDown={(e) => { if (e.key === "Enter") handleCitySearch(); }}
                placeholder="Search any city or country worldwide..."
                style={{ flex: 1, background: "rgba(255,255,255,0.06)", border: `1px solid rgba(255,255,255,0.15)`, borderRadius: 12, padding: "10px 14px", color: "#FFF", fontSize: 13, outline: "none" }}
              />
              <button
                onClick={handleCitySearch}
                style={{ background: "#D7FF3E", border: "none", color: "#0B0E13", padding: "0 16px", borderRadius: 12, fontWeight: 800, fontSize: 13, cursor: "pointer" }}
              >
                {isSearchingCity ? "..." : "Search"}
              </button>
            </div>

            {/* Search Results if any */}
            {citySearchResults.length > 0 && (
              <div style={{ marginBottom: 16, background: "rgba(255,255,255,0.04)", borderRadius: 16, border: `1px solid rgba(255,255,255,0.1)`, padding: 8 }}>
                <div style={{ fontSize: 11, fontWeight: 800, color: "#D7FF3E", padding: "4px 8px 6px" }}>SEARCH RESULTS</div>
                {citySearchResults.map((item, idx) => (
                  <div
                    key={idx}
                    onClick={() => handleSelectSearchResult(item)}
                    style={{ padding: "10px 12px", borderRadius: 10, cursor: "pointer", display: "flex", alignItems: "center", gap: 10, borderBottom: idx < citySearchResults.length - 1 ? "1px solid rgba(255,255,255,0.06)" : "none" }}
                  >
                    <span style={{ fontSize: 18 }}>📍</span>
                    <div style={{ flex: 1, overflow: "hidden" }}>
                      <div style={{ fontSize: 13, fontWeight: 800, color: "#FFF", textOverflow: "ellipsis", overflow: "hidden", whiteSpace: "nowrap" }}>{item.display_name.split(",")[0]}</div>
                      <div style={{ fontSize: 10.5, color: TOKENS.mutedFaint, textOverflow: "ellipsis", overflow: "hidden", whiteSpace: "nowrap" }}>{item.display_name}</div>
                    </div>
                    <span style={{ fontSize: 12, color: "#D7FF3E", fontWeight: 800 }}>Select →</span>
                  </div>
                ))}
              </div>
            )}

            {/* Real Device GPS Button */}
            <div
              onClick={() => selectGlobalCity(GLOBAL_RUN_CITIES[0])}
              style={{
                display: "flex",
                alignItems: "center",
                gap: 12,
                padding: "14px 16px",
                borderRadius: 16,
                background: selectedCity?.id === "my_gps" ? "rgba(34,197,94,0.18)" : "rgba(255,255,255,0.04)",
                border: `1.5px solid ${selectedCity?.id === "my_gps" ? "#22C55E" : "rgba(255,255,255,0.1)"}`,
                cursor: "pointer",
                marginBottom: 16,
                boxShadow: selectedCity?.id === "my_gps" ? "0 0 16px rgba(34,197,94,0.3)" : "none"
              }}
            >
              <div style={{ width: 40, height: 40, borderRadius: 12, background: "#22C55E", display: "flex", alignItems: "center", justifyContent: "center", fontSize: 20 }}>
                📍
              </div>
              <div style={{ flex: 1 }}>
                <div style={{ fontSize: 14, fontWeight: 900, color: "#FFF", display: "flex", alignItems: "center", gap: 6 }}>
                  <span>Use My Live GPS (Anywhere on Earth)</span>
                  <span style={{ background: "#22C55E", color: "#000", fontSize: 9, fontWeight: 900, padding: "2px 6px", borderRadius: 999 }}>LIVE</span>
                </div>
                <div style={{ fontSize: 11, color: TOKENS.mutedFaint }}>Detects your real latitude & longitude automatically</div>
              </div>
            </div>

            {/* Curated Global Running Capitals */}
            <div style={{ fontSize: 11.5, fontWeight: 800, color: TOKENS.mutedFaint, textTransform: "uppercase", letterSpacing: 0.8, marginBottom: 10 }}>
              World-Famous Running Capitals
            </div>

            <div style={{ display: "flex", flexDirection: "column", gap: 8 }}>
              {GLOBAL_RUN_CITIES.filter((c) => c.id !== "my_gps").map((city) => {
                const isSelected = selectedCity?.id === city.id;
                return (
                  <div
                    key={city.id}
                    onClick={() => selectGlobalCity(city)}
                    style={{
                      display: "flex",
                      alignItems: "center",
                      justifyContent: "space-between",
                      padding: "11px 14px",
                      borderRadius: 14,
                      background: isSelected ? "rgba(215,255,62,0.18)" : "rgba(255,255,255,0.03)",
                      border: isSelected ? `1.5px solid #D7FF3E` : `1px solid rgba(255,255,255,0.06)`,
                      cursor: "pointer",
                      transition: "all 0.15s ease"
                    }}
                  >
                    <div style={{ display: "flex", alignItems: "center", gap: 10 }}>
                      <span style={{ fontSize: 24 }}>{city.flag}</span>
                      <div>
                        <div style={{ fontSize: 13.5, fontWeight: 800, color: isSelected ? "#D7FF3E" : "#FFF" }}>{city.name}</div>
                        <div style={{ fontSize: 11, color: TOKENS.mutedFaint }}>{city.country} • {city.desc}</div>
                      </div>
                    </div>
                    {isSelected && <span style={{ color: "#D7FF3E", fontWeight: 900, fontSize: 14 }}>✓</span>}
                  </div>
                );
              })}
            </div>
          </div>
        </div>
      )}

      {/* Top Header & Sub-Nav Switcher */}
      {runStage !== "hud_fullscreen" && runStage !== "save_form" && runStage !== "celebration" && (
        <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 12, padding: "0 4px" }}>
          <div>
            <div style={{ fontSize: 11, color: "#D7FF3E", letterSpacing: 0.8, textTransform: "uppercase", fontWeight: 800 }}>STOKE ⚡ LIVE GPS</div>
            <h1 style={{ margin: "1px 0 0", fontSize: 22, fontWeight: 800, color: TOKENS.text }}>
              {activityType === "run" ? "Running" : activityType === "bike" ? "Cycling & Riding" : "Walking"}
            </h1>
          </div>

          <div style={{ display: "flex", gap: 6, alignItems: "center" }}>
            {/* Global City Switcher Button */}
            <button
              onClick={() => setShowLocationPicker(true)}
              style={{
                display: "flex",
                alignItems: "center",
                gap: 5,
                padding: "6px 11px",
                borderRadius: 999,
                border: `1px solid rgba(255,255,255,0.15)`,
                background: "rgba(255,255,255,0.06)",
                color: "#FFF",
                fontSize: 11,
                fontWeight: 700,
                cursor: "pointer",
                maxWidth: 140,
                overflow: "hidden",
                whiteSpace: "nowrap"
              }}
              title="Change Running City Worldwide"
            >
              <span>{selectedCity?.flag || "🌍"}</span>
              <span style={{ overflow: "hidden", textOverflow: "ellipsis" }}>{selectedCity ? selectedCity.name.split(" ")[0] : "World"}</span>
              <span style={{ fontSize: 9.5, opacity: 0.8 }}>▼</span>
            </button>

            <button
              onClick={() => setShowVoicePicker(true)}
              style={{
                display: "flex",
                alignItems: "center",
                gap: 5,
                padding: "6px 11px",
                borderRadius: 999,
                border: `1px solid ${audioCues ? "#FF80BF" : TOKENS.border}`,
                background: audioCues ? "rgba(255, 128, 191, 0.16)" : "rgba(255,255,255,0.04)",
                color: audioCues ? "#FF80BF" : TOKENS.muted,
                fontSize: 11,
                fontWeight: 700,
                cursor: "pointer",
              }}
            >
              <span>{activePersona.avatar} {activePersona.name}</span>
              <span style={{ fontSize: 9.5, opacity: 0.8 }}>▼</span>
            </button>

            <button
              onClick={() => {
                const next = !simulating;
                setSimulating(next);
              }}
              style={{
                padding: "6px 10px",
                borderRadius: 999,
                border: `1px solid ${simulating ? "#D7FF3E" : TOKENS.border}`,
                background: simulating ? "rgba(215,255,62,0.15)" : "rgba(255,255,255,0.04)",
                color: simulating ? "#D7FF3E" : TOKENS.muted,
                fontSize: 11,
                fontWeight: 700,
                cursor: "pointer",
              }}
            >
              {simulating ? "⚡ Sim ON" : "📍 Real GPS"}
            </button>
          </div>
        </div>
      )}


      {/* Hub Sub-Tabs: Tracker · Challenges · Leaderboard */}
      <div style={{ display: "flex", gap: 6, background: "rgba(255,255,255,0.04)", padding: 4, borderRadius: 14, border: `1px solid ${TOKENS.border}`, marginBottom: 16 }}>
        {[
          { key: "tracker", label: "⚡ Live GPS Tracker" },
          { key: "challenges", label: "🏆 Challenges" },
          { key: "leaderboard", label: "👑 Leaderboard" },
        ].map((t) => (
          <button
            key={t.key}
            onClick={() => setActiveSubTab(t.key)}
            style={{
              flex: 1,
              padding: "7px 0",
              borderRadius: 10,
              border: "none",
              background: activeSubTab === t.key ? "#D7FF3E" : "transparent",
              color: activeSubTab === t.key ? "#0B0E13" : TOKENS.muted,
              fontSize: 11.5,
              fontWeight: 800,
              cursor: "pointer",
              transition: "all 0.2s ease",
            }}
          >
            {t.label}
          </button>
        ))}
      </div>

      {/* SUB-TAB 1: LIVE TRACKER */}
      {activeSubTab === "tracker" && (
        <div>
          {/* STAGE 1: MAP IDLE & MAP ACTIVE & PAUSED */}
          {(runStage === "map_idle" || runStage === "map_active" || runStage === "paused") && (
            <div style={{ position: "relative", width: "100%", height: "calc(100vh - 210px)", minHeight: 480, borderRadius: 24, overflow: "hidden", border: `1px solid ${TOKENS.border}`, boxShadow: "0 12px 36px rgba(0,0,0,0.6)" }}>
              {/* Leaflet Map */}
              <StokeLiveMap
                path={pathRef && pathRef.current ? [...pathRef.current] : []}
                userPos={userPos}
                setUserPos={setUserPos}
                routePath={[]}
                setRoutePath={setRoutePath}
                is3DTilted={is3DTilted}
                mapTileType={mapTileType}
                simulating={simulating}
                runStage={runStage}
              />

              {/* Map Floating Controls Top Right */}
              <div style={{ position: "absolute", top: 14, right: 14, zIndex: 1000, display: "flex", flexDirection: "column", gap: 8 }}>
                <button
                  onClick={toggleLayerStyle}
                  title="Layer Switcher (Dark/Sat/Topo)"
                  style={{ width: 40, height: 40, borderRadius: 12, background: "rgba(11,14,19,0.85)", backdropFilter: "blur(8px)", border: `1px solid rgba(255,255,255,0.15)`, color: "#FFF", fontSize: 16, fontWeight: 800, cursor: "pointer", display: "flex", alignItems: "center", justifyContent: "center", boxShadow: "0 4px 12px rgba(0,0,0,0.4)" }}
                >
                  {mapTileType === "dark" ? "🗺️" : mapTileType === "satellite" ? "🛰️" : "⛰️"}
                </button>
                <button
                  onClick={() => setIs3DTilted(!is3DTilted)}
                  title="3D Tilt Toggle"
                  style={{ width: 40, height: 40, borderRadius: 12, background: is3DTilted ? "#D7FF3E" : "rgba(11,14,19,0.85)", backdropFilter: "blur(8px)", border: `1px solid ${is3DTilted ? "#D7FF3E" : "rgba(255,255,255,0.15)"}`, color: is3DTilted ? "#0B0E13" : "#FFF", fontSize: 13, fontWeight: 800, cursor: "pointer", display: "flex", alignItems: "center", justifyContent: "center", boxShadow: "0 4px 12px rgba(0,0,0,0.4)" }}
                >
                  3D
                </button>
                <button
                  onClick={() => setShowLocationPicker(true)}
                  title="Choose City Worldwide"
                  style={{ width: 40, height: 40, borderRadius: 12, background: "rgba(11,14,19,0.85)", backdropFilter: "blur(8px)", border: `1px solid rgba(255,255,255,0.15)`, color: "#FFF", fontSize: 16, cursor: "pointer", display: "flex", alignItems: "center", justifyContent: "center", boxShadow: "0 4px 12px rgba(0,0,0,0.4)" }}
                >
                  🌍
                </button>
                <button
                  onClick={() => {
                    if (userPos) {
                      setUserPos([...userPos]);
                    }
                  }}
                  title="Recenter Map"
                  style={{ width: 40, height: 40, borderRadius: 12, background: "rgba(11,14,19,0.85)", backdropFilter: "blur(8px)", border: `1px solid rgba(255,255,255,0.15)`, color: "#FFF", fontSize: 16, cursor: "pointer", display: "flex", alignItems: "center", justifyContent: "center", boxShadow: "0 4px 12px rgba(0,0,0,0.4)" }}
                >
                  🎯
                </button>
              </div>

              {/* Status Banner overlay for Paused State */}
              {runStage === "paused" && (
                <div style={{ position: "absolute", top: 14, left: 14, right: 70, zIndex: 1000, background: "rgba(234, 179, 8, 0.9)", backdropFilter: "blur(8px)", padding: "8px 16px", borderRadius: 14, color: "#000", fontWeight: 800, fontSize: 13, display: "flex", alignItems: "center", gap: 8, boxShadow: "0 4px 16px rgba(0,0,0,0.4)" }}>
                  <span>⏸ PAUSED</span>
                  <span style={{ fontSize: 11, opacity: 0.8, fontWeight: 600 }}>- Take a breath or finish your run</span>
                </div>
              )}

              {/* BOTTOM FLOATING HUD CARD (Idle / Active / Paused) */}
              <div style={{ position: "absolute", bottom: 0, left: 0, right: 0, zIndex: 1000, background: "rgba(11, 14, 19, 0.92)", backdropFilter: "blur(16px) saturate(180%)", WebkitBackdropFilter: "blur(16px) saturate(180%)", borderTop: `1px solid rgba(255,255,255,0.12)`, padding: "16px 20px 24px", borderTopLeftRadius: 28, borderTopRightRadius: 28, boxShadow: "0 -10px 40px rgba(0,0,0,0.8)" }}>

                {/* IDLE BOTTOM CARD */}
                {runStage === "map_idle" && (
                  <div>
                    <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 14 }}>
                      <div style={{ display: "flex", alignItems: "center", gap: 6, background: "rgba(34, 197, 94, 0.15)", border: "1px solid rgba(34, 197, 94, 0.3)", padding: "4px 10px", borderRadius: 999 }}>
                        <div style={{ width: 8, height: 8, borderRadius: "50%", background: "#22C55E", boxShadow: "0 0 8px #22C55E" }} />
                        <span style={{ fontSize: 11, fontWeight: 800, color: "#22C55E", letterSpacing: 0.5 }}>GPS ACQUIRED</span>
                      </div>

                      <button
                        onClick={() => setRunStage("hud_fullscreen")}
                        style={{ background: "rgba(255,255,255,0.06)", border: "1px solid rgba(255,255,255,0.1)", color: TOKENS.text, padding: "5px 12px", borderRadius: 999, fontSize: 11, fontWeight: 700, cursor: "pointer", display: "flex", alignItems: "center", gap: 4 }}
                      >
                        <span>Fullscreen HUD</span>
                        <span>⤢</span>
                      </button>
                    </div>

                    {/* Sport Picker Row */}
                    <div style={{ display: "flex", gap: 8, marginBottom: 16 }}>
                      {ACTIVITIES.map((act) => {
                        const active = activityType === act.key;
                        return (
                          <button
                            key={act.key}
                            onClick={() => setActivityType(act.key)}
                            style={{
                              flex: 1,
                              display: "flex",
                              alignItems: "center",
                              justifyContent: "center",
                              gap: 6,
                              padding: "9px 0",
                              borderRadius: 12,
                              background: active ? "rgba(215,255,62,0.18)" : "rgba(255,255,255,0.04)",
                              border: active ? "1.5px solid #D7FF3E" : "1px solid rgba(255,255,255,0.06)",
                              color: active ? "#D7FF3E" : TOKENS.muted,
                              fontSize: 12.5,
                              fontWeight: 800,
                              cursor: "pointer",
                            }}
                          >
                            <span>{act.icon}</span>
                            <span>{act.label}</span>
                          </button>
                        );
                      })}
                    </div>

                    {/* Metrics 3-column & Big Start Button */}
                    <div style={{ display: "flex", alignItems: "center", justifyContent: "space-between" }}>
                      <div style={{ display: "flex", gap: 20 }}>
                        <div>
                          <div style={{ fontSize: 10, color: TOKENS.mutedFaint, textTransform: "uppercase", fontWeight: 800 }}>TIME</div>
                          <div style={{ fontSize: 20, fontWeight: 900, color: TOKENS.text, fontFamily: "monospace" }}>00:00</div>
                        </div>
                        <div>
                          <div style={{ fontSize: 10, color: TOKENS.mutedFaint, textTransform: "uppercase", fontWeight: 800 }}>{activityType === "walk" ? "👟 STEPS" : activityType === "bike" ? "SPEED" : "AVG PACE"}</div>
                          <div style={{ fontSize: 20, fontWeight: 900, color: activityType === "walk" ? "#D7FF3E" : TOKENS.text, fontFamily: "monospace" }}>
                            {activityType === "walk" ? "0" : activityType === "bike" ? "0.0 km/h" : "--:--"}
                          </div>
                        </div>
                        <div>
                          <div style={{ fontSize: 10, color: TOKENS.mutedFaint, textTransform: "uppercase", fontWeight: 800 }}>DIST (KM)</div>
                          <div style={{ fontSize: 20, fontWeight: 900, color: TOKENS.text, fontFamily: "monospace" }}>0.00</div>
                        </div>
                      </div>

                      <button
                        onClick={onStartWithVoice}
                        style={{
                          width: 72,
                          height: 72,
                          borderRadius: "50%",
                          background: "linear-gradient(135deg, #D7FF3E 0%, #B2E600 100%)",
                          border: "none",
                          color: "#0B0E13",
                          fontWeight: 900,
                          fontSize: 14,
                          cursor: "pointer",
                          boxShadow: "0 0 24px rgba(215,255,62,0.6)",
                          display: "flex",
                          flexDirection: "column",
                          alignItems: "center",
                          justifyContent: "center",
                          letterSpacing: 0.5,
                          transition: "transform 0.15s ease",
                        }}
                      >
                        <span style={{ fontSize: 16, marginBottom: -2 }}>▶</span>
                        <span>START</span>
                      </button>
                    </div>
                  </div>
                )}

                {/* ACTIVE BOTTOM CARD */}
                {runStage === "map_active" && (
                  <div>
                    <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 14 }}>
                      <div style={{ display: "flex", alignItems: "center", gap: 6 }}>
                        <div style={{ width: 10, height: 10, borderRadius: "50%", background: "#D7FF3E", animation: "pulse 1.2s infinite" }} />
                        <span style={{ fontSize: 12, fontWeight: 900, color: "#D7FF3E", letterSpacing: 0.8, textTransform: "uppercase" }}>STOKE LIVE RECORDING</span>
                      </div>
                      <button
                        onClick={() => setRunStage("hud_fullscreen")}
                        style={{ background: "rgba(255,255,255,0.08)", border: "1px solid rgba(255,255,255,0.15)", color: TOKENS.text, padding: "6px 14px", borderRadius: 999, fontSize: 11.5, fontWeight: 800, cursor: "pointer", display: "flex", alignItems: "center", gap: 5 }}
                      >
                        <span>OLED HUD</span>
                        <span>⤢</span>
                      </button>
                    </div>

                    <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr 1fr", gap: 12, marginBottom: 16 }}>
                      <div style={{ background: "rgba(255,255,255,0.03)", padding: "10px 12px", borderRadius: 14, border: "1px solid rgba(255,255,255,0.05)" }}>
                        <div style={{ fontSize: 10, color: TOKENS.mutedFaint, fontWeight: 800, textTransform: "uppercase" }}>DISTANCE</div>
                        <div style={{ fontSize: 24, fontWeight: 900, color: TOKENS.text, fontFamily: "monospace" }}>{liveDist.toFixed(2)} <span style={{ fontSize: 12, color: TOKENS.muted }}>KM</span></div>
                      </div>
                      <div style={{ background: "rgba(255,255,255,0.03)", padding: "10px 12px", borderRadius: 14, border: "1px solid rgba(255,255,255,0.05)" }}>
                        <div style={{ fontSize: 10, color: TOKENS.mutedFaint, fontWeight: 800, textTransform: "uppercase" }}>TIME</div>
                        <div style={{ fontSize: 24, fontWeight: 900, color: TOKENS.text, fontFamily: "monospace" }}>{formatTime(elapsed)}</div>
                      </div>
                      <div style={{ background: "rgba(255,255,255,0.03)", padding: "10px 12px", borderRadius: 14, border: "1px solid rgba(255,255,255,0.05)" }}>
                        <div style={{ fontSize: 10, color: TOKENS.mutedFaint, fontWeight: 800, textTransform: "uppercase" }}>
                          {activityType === "walk" ? "👟 LIVE STEPS" : activityType === "bike" ? "⚡ SPEED" : "SPLIT PACE"}
                        </div>
                        <div style={{ fontSize: 24, fontWeight: 900, color: "#D7FF3E", fontFamily: "monospace" }}>
                          {activityType === "walk" ? liveSteps.toLocaleString() : activityType === "bike" ? `${speedKmh.toFixed(1)} km/h` : formatPace(pace)}
                        </div>
                      </div>
                    </div>

                    <button
                      onClick={onPauseWithVoice}
                      style={{
                        width: "100%",
                        padding: "16px 0",
                        borderRadius: 16,
                        background: "linear-gradient(135deg, #D7FF3E 0%, #B2E600 100%)",
                        border: "none",
                        color: "#0B0E13",
                        fontWeight: 900,
                        fontSize: 16,
                        cursor: "pointer",
                        boxShadow: "0 6px 20px rgba(215,255,62,0.4)",
                        display: "flex",
                        alignItems: "center",
                        justifyContent: "center",
                        gap: 8,
                      }}
                    >
                      <span>⏸</span>
                      <span>PAUSE WORKOUT</span>
                    </button>
                  </div>
                )}

                {/* PAUSED BOTTOM CARD */}
                {runStage === "paused" && (
                  <div>
                    <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr 1fr", gap: 12, marginBottom: 18 }}>
                      <div style={{ background: "rgba(255,255,255,0.03)", padding: "10px 12px", borderRadius: 14 }}>
                        <div style={{ fontSize: 10, color: TOKENS.mutedFaint, fontWeight: 800 }}>TOTAL DISTANCE</div>
                        <div style={{ fontSize: 22, fontWeight: 900, color: TOKENS.text, fontFamily: "monospace" }}>{liveDist.toFixed(2)} km</div>
                      </div>
                      <div style={{ background: "rgba(255,255,255,0.03)", padding: "10px 12px", borderRadius: 14 }}>
                        <div style={{ fontSize: 10, color: TOKENS.mutedFaint, fontWeight: 800 }}>DURATION</div>
                        <div style={{ fontSize: 22, fontWeight: 900, color: TOKENS.text, fontFamily: "monospace" }}>{formatTime(elapsed)}</div>
                      </div>
                      <div style={{ background: "rgba(255,255,255,0.03)", padding: "10px 12px", borderRadius: 14 }}>
                        <div style={{ fontSize: 10, color: TOKENS.mutedFaint, fontWeight: 800 }}>{activityType === "walk" ? "👟 TOTAL STEPS" : "EST. KCAL"}</div>
                        <div style={{ fontSize: 22, fontWeight: 900, color: activityType === "walk" ? "#D7FF3E" : TOKENS.text, fontFamily: "monospace" }}>
                          {activityType === "walk" ? liveSteps.toLocaleString() : calories}
                        </div>
                      </div>
                    </div>

                    <div style={{ display: "flex", gap: 12 }}>
                      <button
                        onClick={onResumeWithVoice}
                        style={{
                          flex: 1,
                          padding: "16px 0",
                          borderRadius: 16,
                          background: "linear-gradient(135deg, #D7FF3E 0%, #B2E600 100%)",
                          border: "none",
                          color: "#0B0E13",
                          fontWeight: 900,
                          fontSize: 15,
                          cursor: "pointer",
                          boxShadow: "0 6px 20px rgba(215,255,62,0.4)",
                          display: "flex",
                          alignItems: "center",
                          justifyContent: "center",
                          gap: 6,
                        }}
                      >
                        <span>▶</span>
                        <span>RESUME</span>
                      </button>

                      <button
                        onClick={onFinishWithVoice}
                        style={{
                          flex: 1,
                          padding: "16px 0",
                          borderRadius: 16,
                          background: "#1E2430",
                          border: "1px solid rgba(255,255,255,0.15)",
                          color: "#FFF",
                          fontWeight: 900,
                          fontSize: 15,
                          cursor: "pointer",
                          display: "flex",
                          alignItems: "center",
                          justifyContent: "center",
                          gap: 6,
                        }}
                      >
                        <span>🏁</span>
                        <span>FINISH & SAVE</span>
                      </button>
                    </div>
                  </div>
                )}
              </div>
            </div>
          )}

          {/* Scrollable Content Below Map (when idle) */}
          {runStage === "map_idle" && (
            <div style={{ marginTop: 20, display: "flex", flexDirection: "column", gap: 16 }}>
              {/* Global City Weather & Running Status Card */}
              <div style={{ background: "rgba(255,255,255,0.03)", border: `1px solid ${TOKENS.border}`, borderRadius: 20, padding: "16px 18px", display: "flex", justifyContent: "space-between", alignItems: "center" }}>
                <div style={{ display: "flex", alignItems: "center", gap: 12 }}>
                  <span style={{ fontSize: 28 }}>{selectedCity?.flag || "🌤️"}</span>
                  <div>
                    <div style={{ fontSize: 14, fontWeight: 800, color: TOKENS.text }}>{selectedCity ? `${selectedCity.name} (${selectedCity.country})` : "Worldwide GPS"}</div>
                    <div style={{ fontSize: 11.5, color: "#22C55E", fontWeight: 700 }}>24°C • Ideal Running Weather • AQI 35 (Good)</div>
                  </div>
                </div>
                <button
                  onClick={() => setShowLocationPicker(true)}
                  style={{ background: "rgba(215,255,62,0.15)", border: "1px solid #D7FF3E", color: "#D7FF3E", padding: "6px 12px", borderRadius: 999, fontSize: 11, fontWeight: 800, cursor: "pointer", flexShrink: 0 }}
                >
                  Change City 🌍
                </button>
              </div>

              {/* Quick Worldwide Running Hubs */}
              <div style={{ background: "rgba(255,255,255,0.03)", border: `1px solid ${TOKENS.border}`, borderRadius: 20, padding: 18 }}>
                <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 12 }}>
                  <div style={{ fontSize: 14, fontWeight: 900, color: TOKENS.text }}>Worldwide Running Hubs & Circuits</div>
                  <button
                    onClick={() => setShowLocationPicker(true)}
                    style={{ background: "none", border: "none", color: "#D7FF3E", fontSize: 11, fontWeight: 800, cursor: "pointer" }}
                  >
                    View All 10+ 🌍
                  </button>
                </div>

                <div style={{ display: "flex", flexDirection: "column", gap: 10 }}>
                  {GLOBAL_RUN_CITIES.filter((c) => c.id !== "my_gps").slice(0, 5).map((city) => (
                    <div
                      key={city.id}
                      onClick={() => selectGlobalCity(city)}
                      style={{
                        display: "flex",
                        justifyContent: "space-between",
                        alignItems: "center",
                        background: selectedCity?.id === city.id ? "rgba(215,255,62,0.12)" : "rgba(255,255,255,0.03)",
                        border: selectedCity?.id === city.id ? "1px solid #D7FF3E" : `1px solid rgba(255,255,255,0.06)`,
                        padding: "12px 14px",
                        borderRadius: 14,
                        cursor: "pointer",
                        transition: "all 0.15s ease"
                      }}
                    >
                      <div style={{ display: "flex", alignItems: "center", gap: 10 }}>
                        <span style={{ fontSize: 22 }}>{city.flag}</span>
                        <div>
                          <div style={{ fontSize: 13, fontWeight: 800, color: TOKENS.text }}>{city.name}</div>
                          <div style={{ fontSize: 11, color: TOKENS.mutedFaint }}>{city.country} • {city.desc}</div>
                        </div>
                      </div>
                      <div style={{ textAlign: "right", flexShrink: 0 }}>
                        <div style={{ fontSize: 12, fontWeight: 900, color: "#D7FF3E" }}>Run Here →</div>
                      </div>
                    </div>
                  ))}
                </div>
              </div>

              {/* Past Recorded Activities */}
              {runs && runs.length > 0 && (
                <div style={{ background: "rgba(255,255,255,0.03)", border: `1px solid ${TOKENS.border}`, borderRadius: 20, padding: 18 }}>
                  <div style={{ fontSize: 14, fontWeight: 900, color: TOKENS.text, marginBottom: 12 }}>Recent Activities</div>
                  <div style={{ display: "flex", flexDirection: "column", gap: 10 }}>
                    {runs.slice(0, 3).map((r, i) => (
                      <div key={i} style={{ display: "flex", alignItems: "center", justifyContent: "space-between", background: "rgba(255,255,255,0.02)", border: `1px solid rgba(255,255,255,0.05)`, padding: "10px 14px", borderRadius: 14 }}>
                        <div style={{ display: "flex", alignItems: "center", gap: 10 }}>
                          <span style={{ fontSize: 20 }}>🏃</span>
                          <div>
                            <div style={{ fontSize: 13, fontWeight: 800, color: TOKENS.text }}>Afternoon Run</div>
                            <div style={{ fontSize: 11, color: TOKENS.mutedFaint }}>{r.date || "Recent"} • {formatTime(r.elapsed || 735)}</div>
                          </div>
                        </div>
                        <div style={{ textAlign: "right" }}>
                          <div style={{ fontSize: 14, fontWeight: 900, color: "#D7FF3E", fontFamily: "monospace" }}>{(r.distanceKm || 2.15).toFixed(2)} km</div>
                          <div style={{ fontSize: 10, color: TOKENS.mutedFaint }}>{formatPace(r.paceMinPerKm || 5.7)} /km</div>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              )}
            </div>
          )}

          {/* STAGE 2: OLED FULLSCREEN HUD */}
          {runStage === "hud_fullscreen" && (
            <div style={{ position: "fixed", inset: 0, zIndex: 99999, background: "#000000", color: "#FFFFFF", display: "flex", flexDirection: "column", padding: "40px 24px 32px" }}>
              {/* Header Bar */}
              <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 20 }}>
                <div style={{ display: "flex", alignItems: "center", gap: 8 }}>
                  <div style={{ width: 10, height: 10, borderRadius: "50%", background: status === "paused" ? "#EAB308" : "#D7FF3E", animation: status === "paused" ? "none" : "pulse 1.2s infinite" }} />
                  <span style={{ fontSize: 13, fontWeight: 900, letterSpacing: 1.2, color: status === "paused" ? "#EAB308" : "#D7FF3E", textTransform: "uppercase" }}>
                    STOKE OLED HUD • {activityType.toUpperCase()}
                  </span>
                </div>

                <button
                  onClick={() => setRunStage(status === "idle" ? "map_idle" : status === "paused" ? "paused" : "map_active")}
                  style={{ background: "rgba(255,255,255,0.12)", border: "1px solid rgba(255,255,255,0.2)", color: "#FFF", padding: "8px 16px", borderRadius: 999, fontSize: 12, fontWeight: 800, cursor: "pointer", display: "flex", alignItems: "center", gap: 6 }}
                >
                  <span>🗺️ MAP VIEW</span>
                </button>
              </div>

              {/* Main Huge Metrics Section */}
              <div style={{ flex: 1, display: "flex", flexDirection: "column", justifyContent: "center", alignItems: "center", textAlign: "center" }}>
                {/* Timer */}
                <div style={{ fontSize: 14, fontWeight: 800, color: "rgba(255,255,255,0.5)", letterSpacing: 1.5, textTransform: "uppercase", marginBottom: 4 }}>
                  DURATION
                </div>
                <div style={{ fontSize: "clamp(48px, 14vw, 84px)", fontWeight: 900, fontFamily: "monospace", letterSpacing: -1, lineHeight: 1, color: "#FFFFFF", marginBottom: 28 }}>
                  {formatTime(elapsed)}
                </div>

                {/* Hero Metric: Large Steps when walking, Distance when run/bike */}
                <div style={{ fontSize: 14, fontWeight: 800, color: "rgba(255,255,255,0.5)", letterSpacing: 1.5, textTransform: "uppercase", marginBottom: 4 }}>
                  {activityType === "walk" ? "👟 LIVE STEPS" : "DISTANCE (KILOMETERS)"}
                </div>
                <div style={{ fontSize: "clamp(56px, 16vw, 96px)", fontWeight: 900, fontFamily: "monospace", letterSpacing: -2, lineHeight: 1, color: "#D7FF3E", marginBottom: 32 }}>
                  {activityType === "walk" ? liveSteps.toLocaleString() : liveDist.toFixed(2)}
                </div>

                {/* 2 Grid Cards */}
                <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 16, width: "100%", maxWidth: 420 }}>
                  <div style={{ background: "rgba(255,255,255,0.06)", padding: "16px 14px", borderRadius: 20, border: "1px solid rgba(255,255,255,0.08)", textAlign: "center" }}>
                    <div style={{ fontSize: 11, color: "rgba(255,255,255,0.5)", fontWeight: 800, textTransform: "uppercase" }}>
                      {activityType === "walk" ? "DISTANCE" : activityType === "bike" ? "⚡ SPEED" : "AVG PACE"}
                    </div>
                    <div style={{ fontSize: 28, fontWeight: 900, fontFamily: "monospace", color: "#FFF", marginTop: 4 }}>
                      {activityType === "walk" ? `${liveDist.toFixed(2)} km` : activityType === "bike" ? `${speedKmh.toFixed(1)} km/h` : formatPace(pace)}
                    </div>
                  </div>

                  <div style={{ background: "rgba(255,255,255,0.06)", padding: "16px 14px", borderRadius: 20, border: "1px solid rgba(255,255,255,0.08)", textAlign: "center" }}>
                    <div style={{ fontSize: 11, color: "rgba(255,255,255,0.5)", fontWeight: 800, textTransform: "uppercase" }}>ACTIVE KCAL</div>
                    <div style={{ fontSize: 28, fontWeight: 900, fontFamily: "monospace", color: "#FFF", marginTop: 4 }}>{calories}</div>
                  </div>
                </div>

                {/* Kilometer / Step Progress Bar indicator */}
                <div style={{ width: "100%", maxWidth: 420, marginTop: 28, background: "rgba(255,255,255,0.04)", padding: 14, borderRadius: 16, border: "1px solid rgba(255,255,255,0.06)" }}>
                  <div style={{ display: "flex", justifyContent: "space-between", fontSize: 11, fontWeight: 800, color: "rgba(255,255,255,0.6)", marginBottom: 8 }}>
                    <span>{activityType === "walk" ? "DAILY STEP GOAL (10,000)" : "KM SPLIT PROGRESS"}</span>
                    <span>{activityType === "walk" ? `${Math.min(100, Math.round((liveSteps / 10000) * 100))}%` : `KM ${Math.floor(liveDist) + 1} (${((liveDist % 1) * 100).toFixed(0)}%)`}</span>
                  </div>
                  <div style={{ width: "100%", height: 8, background: "rgba(255,255,255,0.1)", borderRadius: 999, overflow: "hidden" }}>
                    <div style={{ width: activityType === "walk" ? `${Math.min(100, (liveSteps / 10000) * 100)}%` : `${(distanceKm % 1) * 100}%`, height: "100%", background: "#D7FF3E", borderRadius: 999 }} />
                  </div>
                </div>
              </div>

              {/* Bottom Huge Controls */}
              <div style={{ display: "flex", gap: 14, marginTop: 24, maxWidth: 420, width: "100%", margin: "24px auto 0" }}>
                {status === "idle" && (
                  <button
                    onClick={onStartWithVoice}
                    style={{ flex: 1, padding: "18px 0", borderRadius: 20, background: "#D7FF3E", border: "none", color: "#0B0E13", fontWeight: 900, fontSize: 18, cursor: "pointer", boxShadow: "0 8px 30px rgba(215,255,62,0.5)" }}
                  >
                    ▶ START RECORDING
                  </button>
                )}

                {status === "active" && (
                  <button
                    onClick={onPauseWithVoice}
                    style={{ flex: 1, padding: "18px 0", borderRadius: 20, background: "#D7FF3E", border: "none", color: "#0B0E13", fontWeight: 900, fontSize: 18, cursor: "pointer", boxShadow: "0 8px 30px rgba(215,255,62,0.5)" }}
                  >
                    ⏸ PAUSE WORKOUT
                  </button>
                )}

                {status === "paused" && (
                  <>
                    <button
                      onClick={onResumeWithVoice}
                      style={{ flex: 1, padding: "18px 0", borderRadius: 20, background: "#D7FF3E", border: "none", color: "#0B0E13", fontWeight: 900, fontSize: 16, cursor: "pointer" }}
                    >
                      ▶ RESUME
                    </button>
                    <button
                      onClick={onFinishWithVoice}
                      style={{ flex: 1, padding: "18px 0", borderRadius: 20, background: "rgba(255,255,255,0.15)", border: "1px solid rgba(255,255,255,0.3)", color: "#FFF", fontWeight: 900, fontSize: 16, cursor: "pointer" }}
                    >
                      🏁 FINISH & SAVE
                    </button>
                  </>
                )}
              </div>
            </div>
          )}

          {/* STAGE 3: SAVE ACTIVITY FORM */}
          {runStage === "save_form" && (
            <div style={{ background: "#0D1117", borderRadius: 24, border: `1px solid ${TOKENS.border}`, padding: 22, boxShadow: "0 12px 40px rgba(0,0,0,0.8)" }}>
              {/* Form Top Nav */}
              <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 20, paddingBottom: 14, borderBottom: "1px solid rgba(255,255,255,0.08)" }}>
                <button
                  onClick={() => setRunStage("paused")}
                  style={{ background: "transparent", border: "none", color: "#D7FF3E", fontSize: 14, fontWeight: 800, cursor: "pointer" }}
                >
                  ‹ Resume
                </button>
                <div style={{ fontSize: 16, fontWeight: 900, color: TOKENS.text }}>Save Activity</div>
                <button
                  onClick={handleSaveActivity}
                  style={{ background: "#D7FF3E", border: "none", color: "#0B0E13", padding: "6px 14px", borderRadius: 999, fontSize: 12, fontWeight: 800, cursor: "pointer" }}
                >
                  Save
                </button>
              </div>

              {/* Title Input */}
              <div style={{ marginBottom: 18 }}>
                <label style={{ fontSize: 11, fontWeight: 800, color: TOKENS.mutedFaint, textTransform: "uppercase", display: "block", marginBottom: 6 }}>
                  Title
                </label>
                <input
                  type="text"
                  value={activityTitle}
                  onChange={(e) => setActivityTitle(e.target.value)}
                  style={{ width: "100%", background: "rgba(255,255,255,0.04)", border: `1px solid ${TOKENS.border}`, borderRadius: 14, padding: "12px 14px", color: TOKENS.text, fontSize: 15, fontWeight: 700, outline: "none" }}
                  placeholder="e.g. Afternoon Run"
                />
              </div>

              {/* Description Input */}
              <div style={{ marginBottom: 18 }}>
                <label style={{ fontSize: 11, fontWeight: 800, color: TOKENS.mutedFaint, textTransform: "uppercase", display: "block", marginBottom: 6 }}>
                  Description
                </label>
                <textarea
                  value={activityDesc}
                  onChange={(e) => setActivityDesc(e.target.value)}
                  rows={3}
                  style={{ width: "100%", background: "rgba(255,255,255,0.04)", border: `1px solid ${TOKENS.border}`, borderRadius: 14, padding: "12px 14px", color: TOKENS.text, fontSize: 13.5, outline: "none", resize: "none" }}
                  placeholder="How did it feel? Tag friends, gear, or add notes..."
                />
              </div>

              {/* Media Upload Card */}
              <div style={{ marginBottom: 20 }}>
                <label style={{ fontSize: 11, fontWeight: 800, color: TOKENS.mutedFaint, textTransform: "uppercase", display: "block", marginBottom: 6 }}>
                  Photos & Media
                </label>
                <div style={{ display: "flex", gap: 10, overflowX: "auto", paddingBottom: 6 }}>
                  <label style={{ width: 90, height: 90, borderRadius: 16, border: `2px dashed ${TOKENS.border}`, background: "rgba(255,255,255,0.02)", display: "flex", flexDirection: "column", alignItems: "center", justifyContent: "center", cursor: "pointer", flexShrink: 0 }}>
                    <span style={{ fontSize: 24, marginBottom: 2 }}>📸</span>
                    <span style={{ fontSize: 10, fontWeight: 800, color: "#D7FF3E" }}>+ Add Photo</span>
                    <input type="file" accept="image/*" onChange={handlePhotoAdd} style={{ display: "none" }} />
                  </label>

                  {activityPhotos.map((img, i) => (
                    <div key={i} style={{ width: 90, height: 90, borderRadius: 16, overflow: "hidden", border: `1px solid ${TOKENS.border}`, flexShrink: 0, position: "relative" }}>
                      <img src={img} alt="Uploaded photo" style={{ width: "100%", height: "100%", objectFit: "cover" }} />
                    </div>
                  ))}
                </div>
              </div>

              {/* Map Type Switcher Card */}
              <div style={{ background: "rgba(255,255,255,0.03)", borderRadius: 16, padding: 14, border: `1px solid ${TOKENS.border}`, marginBottom: 20, display: "flex", justifyContent: "space-between", alignItems: "center" }}>
                <div>
                  <div style={{ fontSize: 13, fontWeight: 800, color: TOKENS.text }}>Map Type</div>
                  <div style={{ fontSize: 11, color: TOKENS.mutedFaint }}>Current: {mapTileType.toUpperCase()} street tiles</div>
                </div>
                <button
                  onClick={toggleLayerStyle}
                  style={{ background: "rgba(215,255,62,0.15)", border: "1px solid #D7FF3E", color: "#D7FF3E", padding: "6px 12px", borderRadius: 999, fontSize: 11.5, fontWeight: 800, cursor: "pointer" }}
                >
                  Change Map Type 🗺️
                </button>
              </div>

              {/* Perceived Exertion Slider */}
              <div style={{ marginBottom: 22 }}>
                <div style={{ display: "flex", justifyContent: "space-between", marginBottom: 6 }}>
                  <label style={{ fontSize: 11, fontWeight: 800, color: TOKENS.mutedFaint, textTransform: "uppercase" }}>Perceived Exertion</label>
                  <span style={{ fontSize: 12, fontWeight: 800, color: "#D7FF3E" }}>{perceivedExertion} / 10 - {perceivedExertion <= 3 ? "Easy" : perceivedExertion <= 6 ? "Moderate" : perceivedExertion <= 8 ? "Hard" : "Max Effort"}</span>
                </div>
                <input
                  type="range"
                  min="1"
                  max="10"
                  value={perceivedExertion}
                  onChange={(e) => setPerceivedExertion(parseInt(e.target.value))}
                  style={{ width: "100%", accentColor: "#D7FF3E", cursor: "pointer" }}
                />
              </div>

              {/* Big Save Button */}
              <button
                onClick={handleSaveActivity}
                style={{
                  width: "100%",
                  padding: "16px 0",
                  borderRadius: 16,
                  background: "linear-gradient(135deg, #D7FF3E 0%, #B2E600 100%)",
                  border: "none",
                  color: "#0B0E13",
                  fontWeight: 900,
                  fontSize: 16,
                  cursor: "pointer",
                  boxShadow: "0 8px 24px rgba(215,255,62,0.4)",
                }}
              >
                Save Activity ⚡
              </button>
            </div>
          )}

          {/* STAGE 4: CELEBRATION SPLASH */}
          {runStage === "celebration" && (
            <div style={{ position: "fixed", inset: 0, zIndex: 99999, background: "#090B0E", display: "flex", flexDirection: "column", alignItems: "center", justifyContent: "center", textAlign: "center", padding: 24 }}>
              <div style={{ fontSize: 72, marginBottom: 16, animation: "bounce 1s infinite" }}>👟</div>
              <h1 style={{ fontSize: 32, fontWeight: 900, color: "#FFF", margin: "0 0 8px" }}>Nice work, Mohd Numan!</h1>
              <p style={{ fontSize: 14, color: "#D7FF3E", fontWeight: 800, margin: 0 }}>Activity saved! Preparing your STOKE intelligence report...</p>
            </div>
          )}

          {/* STAGE 5: ACTIVITY DETAIL PAGE SHEET */}
          {runStage === "activity_detail" && savedActivity && (
            <div style={{ background: "#0B0E13", borderRadius: 24, border: `1px solid ${TOKENS.border}`, overflow: "hidden", boxShadow: "0 16px 48px rgba(0,0,0,0.8)" }}>
              {/* Header Map Thumbnail with glowing route */}
              <div style={{ position: "relative", width: "100%", height: 260, background: "#13171F" }}>
                <StokeLiveMap
                  path={savedActivity?.path && savedActivity.path.length > 1 && (savedActivity.distance || savedActivity.distanceKm) > 0.02 ? savedActivity.path : []}
                  userPos={userPos}
                  setUserPos={setUserPos}
                  routePath={[]}
                  setRoutePath={setRoutePath}
                  is3DTilted={true}
                  mapTileType={mapTileType}
                  simulating={false}
                  runStage="activity_detail"
                />

                <button
                  onClick={() => setRunStage("map_idle")}
                  style={{ position: "absolute", top: 14, left: 14, zIndex: 1000, background: "rgba(11,14,19,0.85)", border: "1px solid rgba(255,255,255,0.2)", color: "#FFF", padding: "6px 14px", borderRadius: 999, fontSize: 12, fontWeight: 800, cursor: "pointer" }}
                >
                  ← Record Another
                </button>
              </div>

              {/* Detail Content Sheet */}
              <div style={{ padding: 22 }}>
                {/* Athlete Header */}
                <div style={{ display: "flex", alignItems: "center", gap: 12, marginBottom: 16 }}>
                  <div style={{ width: 44, height: 44, borderRadius: "50%", background: "#22C55E", color: "#FFF", fontWeight: 900, fontSize: 20, display: "flex", alignItems: "center", justifyContent: "center", boxShadow: "0 0 12px rgba(34,197,94,0.4)" }}>
                    M
                  </div>
                  <div>
                    <div style={{ fontSize: 16, fontWeight: 900, color: TOKENS.text }}>Mohd Numan</div>
                    <div style={{ fontSize: 11, color: TOKENS.mutedFaint }}>{savedActivity.date} • {savedActivity.location || (selectedCity ? `${selectedCity.name}, ${selectedCity.country}` : "Worldwide Athlete")}</div>
                  </div>
                </div>

                {/* Activity Title */}
                <h2 style={{ margin: "0 0 16px", fontSize: 22, fontWeight: 900, color: TOKENS.text }}>{savedActivity.title}</h2>

                {/* 6 Metric High-Impact Grid */}
                <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr 1fr", gap: 10, marginBottom: 20 }}>
                  <div style={{ background: "rgba(255,255,255,0.03)", padding: 12, borderRadius: 16, border: `1px solid ${TOKENS.border}` }}>
                    <div style={{ fontSize: 10, color: TOKENS.mutedFaint, fontWeight: 800 }}>DISTANCE</div>
                    <div style={{ fontSize: 20, fontWeight: 900, color: "#D7FF3E", fontFamily: "monospace" }}>{savedActivity.distance.toFixed(2)} km</div>
                  </div>
                  <div style={{ background: "rgba(255,255,255,0.03)", padding: 12, borderRadius: 16, border: `1px solid ${TOKENS.border}` }}>
                    <div style={{ fontSize: 10, color: TOKENS.mutedFaint, fontWeight: 800 }}>AVG PACE</div>
                    <div style={{ fontSize: 20, fontWeight: 900, color: TOKENS.text, fontFamily: "monospace" }}>{formatPace(savedActivity.pace)}</div>
                  </div>
                  <div style={{ background: "rgba(255,255,255,0.03)", padding: 12, borderRadius: 16, border: `1px solid ${TOKENS.border}` }}>
                    <div style={{ fontSize: 10, color: TOKENS.mutedFaint, fontWeight: 800 }}>TIME</div>
                    <div style={{ fontSize: 20, fontWeight: 900, color: TOKENS.text, fontFamily: "monospace" }}>{formatTime(savedActivity.time)}</div>
                  </div>
                  <div style={{ background: "rgba(255,255,255,0.03)", padding: 12, borderRadius: 16, border: `1px solid ${TOKENS.border}` }}>
                    <div style={{ fontSize: 10, color: TOKENS.mutedFaint, fontWeight: 800 }}>ELEV GAIN</div>
                    <div style={{ fontSize: 20, fontWeight: 900, color: TOKENS.text, fontFamily: "monospace" }}>{savedActivity.elevationGain || 0} m</div>
                  </div>
                  <div style={{ background: "rgba(255,255,255,0.03)", padding: 12, borderRadius: 16, border: `1px solid ${TOKENS.border}` }}>
                    <div style={{ fontSize: 10, color: TOKENS.mutedFaint, fontWeight: 800 }}>CALORIES</div>
                    <div style={{ fontSize: 20, fontWeight: 900, color: TOKENS.text, fontFamily: "monospace" }}>{savedActivity.calories}</div>
                  </div>
                  <div style={{ background: "rgba(255,255,255,0.03)", padding: 12, borderRadius: 16, border: `1px solid ${TOKENS.border}` }}>
                    <div style={{ fontSize: 10, color: TOKENS.mutedFaint, fontWeight: 800 }}>EST. STEPS</div>
                    <div style={{ fontSize: 20, fontWeight: 900, color: TOKENS.text, fontFamily: "monospace" }}>{savedActivity.steps}</div>
                  </div>
                </div>

                {/* Social Bar & Create 9:16 Story Card Button */}
                <div style={{ display: "flex", gap: 10, marginBottom: 20 }}>
                  <button
                    onClick={() => setKudosCount(kudosCount + 1)}
                    style={{ flex: 1, padding: "12px 0", borderRadius: 14, background: "rgba(215,255,62,0.15)", border: "1px solid #D7FF3E", color: "#D7FF3E", fontWeight: 800, fontSize: 13, cursor: "pointer", display: "flex", alignItems: "center", justifyContent: "center", gap: 6 }}
                  >
                    <span>⚡ Kudos</span>
                    <span style={{ background: "#D7FF3E", color: "#0B0E13", padding: "2px 7px", borderRadius: 999, fontSize: 11, fontWeight: 900 }}>{kudosCount}</span>
                  </button>

                  <button
                    onClick={() => setShowStoryModal(true)}
                    style={{ flex: 1, padding: "12px 0", borderRadius: 14, background: "linear-gradient(135deg, #D7FF3E 0%, #B2E600 100%)", border: "none", color: "#0B0E13", fontWeight: 900, fontSize: 13, cursor: "pointer", display: "flex", alignItems: "center", justifyContent: "center", gap: 6, boxShadow: "0 4px 16px rgba(215,255,62,0.4)" }}
                  >
                    <span>🖼️ Story Card</span>
                  </button>
                </div>

                {/* STOKE Pro Intelligence Analysis */}
                <div style={{ background: "rgba(255,255,255,0.03)", borderRadius: 18, padding: 16, border: `1px solid ${TOKENS.border}`, marginBottom: 20 }}>
                  <div style={{ display: "flex", alignItems: "center", gap: 8, marginBottom: 8 }}>
                    <span style={{ fontSize: 18 }}>⚡</span>
                    <div style={{ fontSize: 14, fontWeight: 900, color: TOKENS.text }}>STOKE Athlete Intelligence</div>
                  </div>
                  <p style={{ margin: 0, fontSize: 12.5, color: TOKENS.muted, lineHeight: 1.5 }}>
                    {savedActivity.distance >= 0.1
                      ? `Outstanding performance! You maintained a consistent split pace across your route in ${selectedCity ? `${selectedCity.name}, ${selectedCity.country}` : "your city"}. Estimated recovery time is 12 hours.`
                      : `Stationary warm-up or quick session recorded. When you run outdoors, real-time GPS motion tracking will plot your exact trail, splits, elevation, and active calories.`}
                  </p>
                </div>
              </div>
            </div>
          )}
        </div>
      )}

      {/* SUB-TAB 2: CHALLENGES */}
      {activeSubTab === "challenges" && (
        <div style={{ display: "flex", flexDirection: "column", gap: 14, paddingBottom: 30 }}>
          <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center" }}>
            <div>
              <div style={{ fontSize: 18, fontWeight: 900, color: TOKENS.text }}>Monthly Challenges</div>
              <div style={{ fontSize: 12, color: TOKENS.mutedFaint }}>Compete, earn badges & build endurance</div>
            </div>
            <div style={{ background: "rgba(215,255,62,0.15)", border: "1px solid #D7FF3E", color: "#D7FF3E", padding: "4px 10px", borderRadius: 999, fontSize: 11, fontWeight: 800 }}>
              {challenges.filter((c) => c.joined).length} Active
            </div>
          </div>

          {challenges.map((c) => {
            const pct = Math.min(100, Math.round((c.current / c.target) * 100));
            return (
              <div key={c.id} style={{ background: "rgba(255,255,255,0.03)", border: `1px solid ${c.joined ? "rgba(215,255,62,0.5)" : TOKENS.border}`, borderRadius: 20, padding: 18, position: "relative", overflow: "hidden" }}>
                <div style={{ display: "flex", alignItems: "flex-start", gap: 12, marginBottom: 12 }}>
                  <div style={{ width: 44, height: 44, borderRadius: 14, background: "rgba(255,255,255,0.06)", display: "flex", alignItems: "center", justifyContent: "center", fontSize: 24, flexShrink: 0 }}>
                    {c.icon}
                  </div>
                  <div style={{ flex: 1 }}>
                    <div style={{ fontSize: 15, fontWeight: 800, color: TOKENS.text, marginBottom: 3 }}>{c.title}</div>
                    <div style={{ fontSize: 12, color: TOKENS.muted, lineHeight: 1.4, marginBottom: 8 }}>{c.desc}</div>
                    <div style={{ display: "flex", alignItems: "center", gap: 10, fontSize: 11, color: TOKENS.mutedFaint }}>
                      <span>👥 {c.participants.toLocaleString()} athletes</span>
                      <span>•</span>
                      <span style={{ color: "#D7FF3E", fontWeight: 700 }}>{c.reward}</span>
                    </div>
                  </div>
                </div>

                {/* Progress bar */}
                <div style={{ marginBottom: 14 }}>
                  <div style={{ display: "flex", justifyContent: "space-between", fontSize: 12, fontWeight: 800, marginBottom: 6 }}>
                    <span style={{ color: TOKENS.text }}>{c.current} / {c.target} {c.unit}</span>
                    <span style={{ color: "#D7FF3E" }}>{pct}%</span>
                  </div>
                  <div style={{ height: 8, borderRadius: 999, background: "rgba(255,255,255,0.08)", overflow: "hidden" }}>
                    <div style={{ height: "100%", width: `${pct}%`, background: "linear-gradient(90deg, #D7FF3E, #2DD4BF)", borderRadius: 999, transition: "width 0.4s ease" }} />
                  </div>
                </div>

                <button
                  onClick={() => toggleJoinChallenge(c.id)}
                  style={{
                    width: "100%",
                    padding: "10px 0",
                    borderRadius: 12,
                    border: c.joined ? "1px solid rgba(255,255,255,0.15)" : "none",
                    background: c.joined ? "rgba(255,255,255,0.06)" : "#D7FF3E",
                    color: c.joined ? "#FFF" : "#0B0E13",
                    fontWeight: 800,
                    fontSize: 12.5,
                    cursor: "pointer",
                    transition: "all 0.2s ease"
                  }}
                >
                  {c.joined ? "✓ Challenge Active (Leave)" : "Join Challenge ⚡"}
                </button>
              </div>
            );
          })}
        </div>
      )}

      {/* SUB-TAB 3: LEADERBOARD */}
      {activeSubTab === "leaderboard" && (
        <div style={{ display: "flex", flexDirection: "column", gap: 14, paddingBottom: 30 }}>
          <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center" }}>
            <div>
              <div style={{ fontSize: 18, fontWeight: 900, color: TOKENS.text }}>Worldwide Leaderboard</div>
              <div style={{ fontSize: 12, color: TOKENS.mutedFaint }}>Global rankings & regional contenders</div>
            </div>
            <div style={{ display: "flex", gap: 4, background: "rgba(255,255,255,0.06)", padding: 3, borderRadius: 999 }}>
              <button
                onClick={() => setLeaderboardFilter("worldwide")}
                style={{ background: leaderboardFilter === "worldwide" ? "#D7FF3E" : "transparent", border: "none", color: leaderboardFilter === "worldwide" ? "#0B0E13" : "#FFF", padding: "3px 9px", borderRadius: 999, fontSize: 10.5, fontWeight: 800, cursor: "pointer" }}
              >
                🌍 Global
              </button>
              <button
                onClick={() => setLeaderboardFilter("regional")}
                style={{ background: leaderboardFilter === "regional" ? "#D7FF3E" : "transparent", border: "none", color: leaderboardFilter === "regional" ? "#0B0E13" : "#FFF", padding: "3px 9px", borderRadius: 999, fontSize: 10.5, fontWeight: 800, cursor: "pointer" }}
              >
                🏙️ Regional
              </button>
            </div>
          </div>

          {/* Top 3 Podium */}
          <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr 1fr", gap: 8, alignItems: "flex-end", marginBottom: 10, paddingTop: 10 }}>
            {/* Rank 2 */}
            <div style={{ background: "rgba(255,255,255,0.03)", border: `1px solid ${TOKENS.border}`, borderRadius: 16, padding: "14px 8px 12px", textAlign: "center", display: "flex", flexDirection: "column", alignItems: "center" }}>
              <div style={{ fontSize: 20, marginBottom: 4 }}>🥈</div>
              <div style={{ fontSize: 11, fontWeight: 800, color: TOKENS.text, whiteSpace: "nowrap", overflow: "hidden", textOverflow: "ellipsis", maxWidth: "100%" }}>Sarah J.</div>
              <div style={{ fontSize: 13, fontWeight: 900, color: "#D7FF3E", marginTop: 4 }}>76.5 km</div>
            </div>

            {/* Rank 1 */}
            <div style={{ background: "linear-gradient(180deg, rgba(215,255,62,0.2) 0%, rgba(255,255,255,0.03) 100%)", border: "1px solid #D7FF3E", borderRadius: 18, padding: "18px 8px 14px", textAlign: "center", display: "flex", flexDirection: "column", alignItems: "center", transform: "scale(1.04)" }}>
              <div style={{ fontSize: 24, marginBottom: 4 }}>👑</div>
              <div style={{ fontSize: 12, fontWeight: 900, color: "#FFF", whiteSpace: "nowrap", overflow: "hidden", textOverflow: "ellipsis", maxWidth: "100%" }}>Alex Chen</div>
              <div style={{ fontSize: 15, fontWeight: 900, color: "#D7FF3E", marginTop: 4 }}>84.2 km</div>
            </div>

            {/* Rank 3 */}
            <div style={{ background: "rgba(255,255,255,0.03)", border: `1px solid ${TOKENS.border}`, borderRadius: 16, padding: "14px 8px 12px", textAlign: "center", display: "flex", flexDirection: "column", alignItems: "center" }}>
              <div style={{ fontSize: 20, marginBottom: 4 }}>🥉</div>
              <div style={{ fontSize: 11, fontWeight: 800, color: TOKENS.text, whiteSpace: "nowrap", overflow: "hidden", textOverflow: "ellipsis", maxWidth: "100%" }}>Marcus V.</div>
              <div style={{ fontSize: 13, fontWeight: 900, color: "#D7FF3E", marginTop: 4 }}>69.8 km</div>
            </div>
          </div>

          {/* Full List */}
          <div style={{ display: "flex", flexDirection: "column", gap: 8 }}>
            {LEADERBOARD_USERS.map((u) => {
              const isCurrentUser = u.isUser || u.name.includes("You") || u.name.includes("mohdnuman");
              return (
                <div
                  key={u.rank}
                  style={{
                    display: "flex",
                    alignItems: "center",
                    gap: 12,
                    padding: "12px 14px",
                    borderRadius: 16,
                    background: isCurrentUser ? "rgba(215,255,62,0.14)" : "rgba(255,255,255,0.03)",
                    border: `1px solid ${isCurrentUser ? "#D7FF3E" : TOKENS.border}`,
                  }}
                >
                  <div style={{ width: 24, fontSize: 13, fontWeight: 900, color: isCurrentUser ? "#D7FF3E" : TOKENS.muted, textAlign: "center" }}>
                    #{u.rank}
                  </div>
                  <div style={{ width: 36, height: 36, borderRadius: "50%", background: isCurrentUser ? "#D7FF3E" : "rgba(255,255,255,0.08)", display: "flex", alignItems: "center", justifyContent: "center", fontWeight: 900, fontSize: 14, color: isCurrentUser ? "#0B0E13" : "#FFF" }}>
                    {isCurrentUser ? "M" : u.badge || "🏃"}
                  </div>
                  <div style={{ flex: 1 }}>
                    <div style={{ fontSize: 13.5, fontWeight: 800, color: isCurrentUser ? "#FFF" : TOKENS.text, display: "flex", alignItems: "center", gap: 6 }}>
                      <span>{isCurrentUser ? "Mohd Numan (You)" : u.name}</span>
                      {isCurrentUser && <span style={{ background: "#D7FF3E", color: "#0B0E13", fontSize: 9, fontWeight: 800, padding: "1px 6px", borderRadius: 999 }}>YOU</span>}
                    </div>
                    <div style={{ fontSize: 11, color: TOKENS.mutedFaint }}>{u.activity}</div>
                  </div>
                  <div style={{ textAlign: "right" }}>
                    <div style={{ fontSize: 14, fontWeight: 900, color: isCurrentUser ? "#D7FF3E" : TOKENS.text, fontFamily: "monospace" }}>{u.dist.toFixed(1)} km</div>
                    <div style={{ fontSize: 10, color: TOKENS.mutedFaint }}>Total distance</div>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      )}

      {/* 9:16 STORY CARD MODAL */}
      {showStoryModal && (
        <div style={{ position: "fixed", inset: 0, zIndex: 99999, background: "rgba(0,0,0,0.9)", backdropFilter: "blur(12px)", display: "flex", alignItems: "center", justifyContent: "center", padding: 16 }}>
          <div style={{ background: "#11141B", border: `1px solid rgba(255,255,255,0.15)`, borderRadius: 24, padding: 22, maxWidth: 380, width: "100%", boxShadow: "0 20px 60px rgba(0,0,0,0.9)", display: "flex", flexDirection: "column", maxHeight: "90vh", overflowY: "auto" }}>
            <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 14 }}>
              <div style={{ fontSize: 16, fontWeight: 900, color: "#FFF" }}>9:16 Story Card</div>
              <button onClick={() => setShowStoryModal(false)} style={{ background: "rgba(255,255,255,0.1)", border: "none", color: "#FFF", width: 28, height: 28, borderRadius: "50%", cursor: "pointer" }}>✕</button>
            </div>

            {/* Canvas Preview Container */}
            <div style={{ width: "100%", aspectRatio: "9/16", background: "#000", borderRadius: 18, overflow: "hidden", border: "1px solid rgba(255,255,255,0.15)", marginBottom: 12, position: "relative", boxShadow: "0 10px 30px rgba(0,0,0,0.8)" }}>
              {generatedCardUrl ? (
                <img src={generatedCardUrl} alt="STOKE 9:16 Story Card" style={{ width: "100%", height: "100%", objectFit: "cover", display: "block" }} />
              ) : (
                <div style={{ position: "relative", width: "100%", height: "100%", display: "flex", flexDirection: "column", justifyContent: "space-between", padding: 22, textAlign: "center", background: "#0B0E14" }}>
                  {cardPhoto && (
                    <img src={cardPhoto} alt="Story Background" style={{ position: "absolute", inset: 0, width: "100%", height: "100%", objectFit: "cover" }} />
                  )}
                  <div style={{ position: "absolute", inset: 0, background: "linear-gradient(180deg, rgba(0,0,0,0.72) 0%, rgba(0,0,0,0.28) 32%, rgba(0,0,0,0.52) 65%, rgba(0,0,0,0.88) 100%)", pointerEvents: "none" }} />
                  
                  {/* Top Branding */}
                  <div style={{ position: "relative", zIndex: 2 }}>
                    <div style={{ fontSize: 20, fontWeight: 900, color: "#D7FF3E", letterSpacing: 2.5, marginBottom: 2 }}>STOKE ⚡</div>
                    <div style={{ fontSize: 11, fontWeight: 800, color: "rgba(255,255,255,0.75)", letterSpacing: 1.5, textTransform: "uppercase" }}>{activityType === "run" ? "OUTDOOR RUN" : activityType.toUpperCase()}</div>
                  </div>

                  {/* Hero Metric */}
                  <div style={{ position: "relative", zIndex: 2, margin: "auto 0" }}>
                    <div style={{ fontSize: 12, fontWeight: 800, color: "rgba(255,255,255,0.75)", letterSpacing: 1.5, marginBottom: 2 }}>DISTANCE</div>
                    <div style={{ fontSize: 48, fontWeight: 900, color: "#FFF", fontFamily: "monospace", letterSpacing: -1 }}>{Number(liveDist.toFixed(2)).toFixed(2)} KM</div>
                    <div style={{ fontSize: 15, fontWeight: 800, color: "rgba(255,255,255,0.88)", marginTop: 4 }}>{formatPace(livePace)} /km • {formatTime(elapsed)}</div>
                  </div>

                  {/* Athlete & Location Footer */}
                  <div style={{ position: "relative", zIndex: 2 }}>
                    <div style={{ fontSize: 13, fontWeight: 800, color: "#FFF" }}>{profile?.name || "Mohd Numan"}</div>
                    <div style={{ fontSize: 11, color: "rgba(255,255,255,0.65)", marginTop: 2 }}>{selectedCity ? `${selectedCity.name}, ${selectedCity.country}` : "Worldwide Athlete"}</div>
                    <div style={{ fontSize: 10, fontWeight: 800, color: "#D7FF3E", letterSpacing: 2, marginTop: 8 }}>STOKE ⚡ ATHLETES CLUB</div>
                  </div>
                </div>
              )}
            </div>

            {/* Remove Custom Photo Option */}
            {cardPhoto && (
              <div style={{ display: "flex", justifyContent: "center", marginBottom: 12 }}>
                <button
                  onClick={() => {
                    setCardPhoto(null);
                    onChangeStyle("dark");
                    const activeDist = Number(liveDist.toFixed(2));
                    const activeElapsed = elapsed > 0 ? elapsed : 1;
                    const loc = selectedCity ? `${selectedCity.name}, ${selectedCity.country}` : "Worldwide Athlete";
                    const realPath = (pathRef && pathRef.current && pathRef.current.length > 1 && activeDist > 0.02)
                      ? pathRef.current
                      : (savedActivity?.path && savedActivity.path.length > 1 && (savedActivity.distance || savedActivity.distanceKm) > 0.02 ? savedActivity.path : []);
                    const cardParams = {
                      activityType,
                      distanceKm: activeDist,
                      elapsed: activeElapsed,
                      paceMinPerKm: livePace,
                      speedKmh,
                      path: realPath,
                      style: "dark",
                      brand: "STOKE",
                      customImage: null,
                      athleteName: profile?.name || "Mohd Numan",
                      location: loc
                    };
                    setGeneratedCardUrl(drawShareCard(cardParams));
                  }}
                  style={{ background: "rgba(255,255,255,0.06)", border: "1px solid rgba(255,255,255,0.15)", color: "rgba(255,255,255,0.75)", padding: "5px 14px", borderRadius: 999, fontSize: 11.5, fontWeight: 700, cursor: "pointer" }}
                >
                  ✕ Remove Custom Photo (Reset to Dark)
                </button>
              </div>
            )}

            {/* Actions */}
            <div style={{ display: "flex", gap: 10 }}>
              <label style={{ flex: 1, padding: "12px 0", borderRadius: 14, background: "rgba(255,255,255,0.06)", border: "1px solid rgba(255,255,255,0.15)", color: "#FFF", fontWeight: 800, fontSize: 12, cursor: "pointer", display: "flex", alignItems: "center", justifyContent: "center" }}>
                <span>📷 Upload Photo</span>
                <input type="file" accept="image/*" onChange={handlePhotoUpload} style={{ display: "none" }} />
              </label>

              <button
                onClick={handleShare}
                style={{ flex: 1, padding: "12px 0", borderRadius: 14, background: "#D7FF3E", border: "none", color: "#0B0E13", fontWeight: 900, fontSize: 12, cursor: "pointer" }}
              >
                📲 Share / Save
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}

function CoachScreen({ remaining, goals, messages, setMessages, input, setInput, loading, setLoading, profile }) {
  const messagesEndRef = useRef(null);
  const userName = (profile && profile.name) ? profile.name.split(" ")[0] : "Champ";

  useEffect(() => {
    messagesEndRef.current?.scrollIntoView({ behavior: "smooth" });
  }, [messages, loading]);

  // Show welcome message on first open
  useEffect(() => {
    if (messages.length === 0) {
      const hour = new Date().getHours();
      const timeGreet = hour < 12 ? "Good morning" : hour < 17 ? "Good afternoon" : "Good evening";
      setMessages([{
        role: "assistant",
        content: `${timeGreet}, ${userName}! 👋\n\nI'm your STOKE Coach — your personal AI nutrition & fitness assistant.\n\nYou can ask me things like:\n• "Hey coach!"\n• "I have eggs, rice and chicken — what can I make?"\n• "What should I eat with my remaining macros?"\n• "Give me a high protein snack"\n\nHow can I help you today? 💪`
      }]);
    }
  }, []);

  const QUICK_PROMPTS = [
    "Hey coach! 👋",
    "I have eggs, rice & chicken — what to make?",
    "High protein snack under 200 kcal?",
    "Post-workout meal for muscle recovery?",
    "What should I eat with my remaining macros?",
  ];

  const INGREDIENT_MEALS = [
    { ingredients: ["egg", "rice", "chicken"], meal: "🍳 Chicken Fried Rice: Cook rice, stir-fry diced chicken with garlic, add egg and rice. Season with soy sauce & pepper.\n\n📊 ~420 kcal | 38g protein | 40g carbs | 8g fat" },
    { ingredients: ["egg", "bread", "cheese"], meal: "🥚 Cheese Egg Toast: Scramble 2 eggs with cheese on toasted bread. Add veggies if you have them!\n\n📊 ~320 kcal | 20g protein | 28g carbs | 12g fat" },
    { ingredients: ["egg", "milk", "banana"], meal: "🥞 Protein Pancakes: Blend 2 eggs + 1 banana + splash of milk. Cook on a non-stick pan.\n\n📊 ~280 kcal | 14g protein | 38g carbs | 6g fat" },
    { ingredients: ["egg", "chicken"], meal: "🍗 Egg & Chicken Stir Fry: Sauté diced chicken with garlic, scramble in eggs, season with salt & pepper.\n\n📊 ~370 kcal | 42g protein | 2g carbs | 18g fat" },
    { ingredients: ["rice", "chicken"], meal: "🍗 Grilled Chicken & Rice: Cook 180g chicken breast, serve with 1 cup boiled rice and any veggies.\n\n📊 ~450 kcal | 45g protein | 45g carbs | 6g fat" },
    { ingredients: ["oats", "milk", "banana"], meal: "🥣 Banana Oat Smoothie Bowl: Blend oats with milk and banana. Top with honey.\n\n📊 ~360 kcal | 12g protein | 65g carbs | 5g fat" },
    { ingredients: ["tuna", "bread"], meal: "🥪 Tuna Sandwich: Mix 1 can tuna with a little mayo, stuff in bread with lettuce.\n\n📊 ~340 kcal | 32g protein | 28g carbs | 8g fat" },
    { ingredients: ["yogurt", "banana"], meal: "🍌 Banana Yogurt Bowl: Layer Greek yogurt with sliced banana. Add honey if available.\n\n📊 ~220 kcal | 14g protein | 32g carbs | 2g fat" },
    { ingredients: ["egg", "spinach"], meal: "🥬 Spinach Egg Scramble: Sauté fresh spinach, add 3 beaten eggs. Season with salt & pepper.\n\n📊 ~210 kcal | 18g protein | 4g carbs | 13g fat" },
    { ingredients: ["bread", "peanut butter", "banana"], meal: "🥜 PB Banana Toast: Spread peanut butter on toast, top with banana slices.\n\n📊 ~380 kcal | 12g protein | 48g carbs | 14g fat" },
    { ingredients: ["chicken", "pasta"], meal: "🍝 Chicken Pasta: Boil pasta, pan-fry diced chicken with garlic. Mix with olive oil.\n\n📊 ~520 kcal | 40g protein | 55g carbs | 10g fat" },
    { ingredients: ["egg"], meal: "🥚 Boiled Eggs: Boil 3 eggs for 7 minutes. Great high-protein snack!\n\n📊 ~210 kcal | 18g protein | 1g carbs | 14g fat" },
    { ingredients: ["rice"], meal: "🍚 Rice + Olive Oil: 1 cup cooked rice with olive oil and salt. Add any protein you have.\n\n📊 ~260 kcal | 5g protein | 50g carbs | 5g fat" },
  ];

  function detectIngredients(text) {
    const q = text.toLowerCase();
    const hasKeyword = q.includes("i have") || q.includes("i got") || q.includes("make with") || q.includes("using") || q.includes("what can i") || q.includes("can i make") || q.includes("cook") || q.includes("what to make") || q.includes("what should i make");
    if (!hasKeyword) return null;
    const foodWords = ["egg","eggs","rice","chicken","bread","milk","banana","oats","tuna","yogurt","spinach","cheese","pasta","peanut butter","peanut","potato","tomato","onion"];
    const foundIngredients = foodWords.filter(f => q.includes(f));
    if (foundIngredients.length === 0) return null;
    let bestMatch = null;
    let bestScore = 0;
    for (const entry of INGREDIENT_MEALS) {
      const score = entry.ingredients.filter(i => foundIngredients.some(f => f.includes(i) || i.includes(f))).length;
      if (score > bestScore) { bestScore = score; bestMatch = entry; }
    }
    if (bestMatch && bestScore > 0) {
      return `Great! With **${foundIngredients.join(", ")}**, here's what I'd make for you:\n\n${bestMatch.meal}\n\nWant me to suggest something else with those ingredients? 😊`;
    }
    return null;
  }

  function generateSmartResponse(userText) {
    const q = userText.toLowerCase();
    const remCal = remaining.calories;
    const remP = remaining.protein;
    const remC = remaining.carbs;
    const remF = remaining.fat;

    // Greeting detection
    if (q.match(/^(hey|hi|hello|sup|yo|heyy|hiii|helo|salaam|assalam|namaste|coach)[\s!.,]*$/)) {
      const hour = new Date().getHours();
      const timeGreet = hour < 12 ? "Good morning" : hour < 17 ? "Good afternoon" : "Good evening";
      return `${timeGreet}, ${userName}! 👋\n\nYou have **${remCal} kcal** and **${remP}g protein** left today.\n\nWhat can I help you with? Ask me about meals, snacks, or just tell me what ingredients you have! 🔥`;
    }

    // Ingredient-based meal suggestion
    const ingredientResponse = detectIngredients(q);
    if (ingredientResponse) return ingredientResponse;

    if (q.includes("what should i eat") || q.includes("meal") || q.includes("remaining") || q.includes("dinner") || q.includes("lunch")) {
      let suggestions = [];
      if (remP > 25 && remCal >= 350) {
        suggestions.push("🍗 Grilled Chicken & Rice: 180g chicken breast (~45g protein, 3g fat) + 1 cup jasmine rice (~45g carbs) + steamed broccoli.");
      }
      if (remP > 15) {
        suggestions.push("🥣 Greek Yogurt Protein Bowl: 200g 0% Greek yogurt (~20g protein) + 1 scoop whey + 1 tbsp honey (~25g carbs) + berries.");
      }
      if (remCal < 300) {
        suggestions.push("🥚 Light Egg White Scramble: 4 egg whites + 1 whole egg + spinach (~20g protein, 140 kcal).");
      }
      if (suggestions.length === 0) {
        suggestions.push("🥗 Tuna & Avocado Wrap: 1 can tuna in water (~30g protein) with light tortilla and fresh greens.");
      }
      return `Based on your remaining today (${remCal} kcal, ${remP}g protein, ${remC}g carbs, ${remF}g fat):\n\n${suggestions.join("\n\n")}\n\nThis fits right into your daily target! 🎯`;
    }

    if (q.includes("protein") || q.includes("snack")) {
      return `To hit your remaining **${remP}g protein** without blowing calories:\n\n1. Whey Isolate Shake: 1 scoop = 25g protein, only ~120 kcal.\n2. Low-fat Cottage Cheese: 150g = 18g protein, ~110 kcal.\n3. Hard-boiled Eggs: 2 eggs = 13g protein, ~140 kcal.\n4. Edamame: 1 cup = 18g protein + 8g fiber.\n\nWhich one would you like to log?`;
    }

    if (q.includes("workout") || q.includes("post-workout") || q.includes("recovery") || q.includes("lift")) {
      return `For optimal post-workout recovery:\n\n• Aim for 25–40g high-quality protein within 1–2 hours.\n• Pair with 30–50g fast-digesting carbs (banana, rice cakes, or honey).\n• Hydrate with at least 500ml water.\n\nYou have **${remP}g protein** left — you're in a great spot! 💪`;
    }

    if (q.includes("water") || q.includes("hydration")) {
      return `Your daily hydration target is **${goals.water}L**.\n\n💡 Pro-tip: Drink 500ml right after waking up, and 500ml around your workout!`;
    }

    if (q.includes("rest") || q.includes("adjust") || q.includes("cut") || q.includes("bulk")) {
      return `On rest days, keep protein at **${goals.protein}g** to support tissue repair. Slightly taper carbs by 15-20% if cutting, but prioritize sleep and hydration! 🧘`;
    }

    return `Based on your profile (Target: **${goals.calories} kcal**, **${goals.protein}g protein**):\n\nYou have **${remCal} kcal** and **${remP}g protein** remaining today.\n\nTip: Tell me what ingredients you have and I'll suggest a meal! 🍳`;
  }

  async function handleSend(textToSend) {
    const text = (textToSend || input).trim();
    if (!text || loading) return;

    const newMessages = [...messages, { role: "user", content: text }];
    setMessages(newMessages);
    setInput("");
    setLoading(true);

    try {
      // Try Claude API if reachable
      const response = await fetch("https://api.anthropic.com/v1/messages", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          model: "claude-sonnet-4-6",
          max_tokens: 500,
          system: `You are STOKE Coach, an expert fitness and sports nutrition AI. The user has ${remaining.calories} kcal remaining today (Protein: ${remaining.protein}g left, Carbs: ${remaining.carbs}g left, Fat: ${remaining.fat}g left, Daily Calorie Goal: ${goals.calories} kcal, Protein Goal: ${goals.protein}g). Give concise, motivating, actionable advice grounded in their exact remaining numbers. Keep replies under 3-4 short paragraphs.`,
          messages: newMessages.map((m) => ({ role: m.role, content: m.content })),
        }),
      });

      if (response.ok) {
        const data = await response.json();
        const reply = data.content?.[0]?.text || generateSmartResponse(text);
        setMessages((prev) => [...prev, { role: "assistant", content: reply }]);
      } else {
        // Fallback to instant smart local engine
        setTimeout(() => {
          const reply = generateSmartResponse(text);
          setMessages((prev) => [...prev, { role: "assistant", content: reply }]);
        }, 400);
      }
    } catch (err) {
      // Intelligent fallback
      setTimeout(() => {
        const reply = generateSmartResponse(text);
        setMessages((prev) => [...prev, { role: "assistant", content: reply }]);
      }, 300);
    } finally {
      setLoading(false);
    }
  }

  return (
    <div style={{ display: "flex", flexDirection: "column", height: "calc(100vh - 140px)" }}>
      {/* Coach Header & Macro pill */}
      <div style={{ marginBottom: 12 }}>
        <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 8 }}>
          <div>
            <div style={{ fontSize: 12, color: TOKENS.mutedFaint, letterSpacing: 0.5 }}>AI Assistant</div>
            <h1 style={{ margin: "2px 0 0", fontSize: 24, fontWeight: 700, color: TOKENS.text }}>STOKE Coach</h1>
          </div>
          <div style={{ display: "flex", alignItems: "center", gap: 5, background: "rgba(46,212,191,0.12)", border: `1px solid ${TOKENS.teal}`, borderRadius: 999, padding: "4px 10px" }}>
            <span style={{ width: 6, height: 6, borderRadius: "50%", background: TOKENS.teal }} />
            <span style={{ fontSize: 11, fontWeight: 700, color: TOKENS.teal }}>Online</span>
          </div>
        </div>

        {/* Live Context Banner */}
        <div style={{ background: "rgba(255,255,255,0.03)", border: `1px solid ${TOKENS.border}`, borderRadius: 12, padding: "8px 12px", display: "flex", justifyContent: "space-between", fontSize: 11 }}>
          <span style={{ color: TOKENS.muted }}>Left today:</span>
          <span style={{ color: TOKENS.ember, fontWeight: 700 }}>{remaining.calories} kcal</span>
          <span style={{ color: TOKENS.protein, fontWeight: 700 }}>P {remaining.protein}g</span>
          <span style={{ color: TOKENS.carbs, fontWeight: 700 }}>C {remaining.carbs}g</span>
          <span style={{ color: TOKENS.fat, fontWeight: 700 }}>F {remaining.fat}g</span>
        </div>
      </div>

      {/* Quick Prompts */}
      <div style={{ display: "flex", gap: 6, overflowX: "auto", paddingBottom: 6, marginBottom: 10, flexShrink: 0 }}>
        {QUICK_PROMPTS.map((p, i) => (
          <button
            key={i}
            onClick={() => handleSend(p)}
            style={{
              background: "rgba(255,255,255,0.05)",
              border: `1px solid ${TOKENS.border}`,
              borderRadius: 999,
              padding: "6px 12px",
              color: TOKENS.text,
              fontSize: 11,
              fontWeight: 600,
              cursor: "pointer",
              whiteSpace: "nowrap",
            }}
          >
            {p}
          </button>
        ))}
      </div>

      {/* Messages Thread */}
      <div style={{ flex: 1, overflowY: "auto", display: "flex", flexDirection: "column", gap: 10, paddingRight: 4, marginBottom: 12 }}>
        {messages.map((m, i) => {
          const isUser = m.role === "user";
          return (
            <div
              key={i}
              style={{
                alignSelf: isUser ? "flex-end" : "flex-start",
                maxWidth: "85%",
                background: isUser ? TOKENS.ember : TOKENS.surface,
                color: isUser ? "#0B0E13" : TOKENS.text,
                border: isUser ? "none" : `1px solid ${TOKENS.border}`,
                borderRadius: isUser ? "16px 16px 4px 16px" : "16px 16px 16px 4px",
                padding: "12px 14px",
                fontSize: 13.5,
                lineHeight: 1.5,
                boxShadow: CARD_SHADOW,
                whiteSpace: "pre-wrap",
              }}
            >
              {m.content}
            </div>
          );
        })}

        {loading && (
          <div
            style={{
              alignSelf: "flex-start",
              background: TOKENS.surface,
              border: `1px solid ${TOKENS.border}`,
              borderRadius: "16px 16px 16px 4px",
              padding: "10px 14px",
              display: "flex",
              alignItems: "center",
              gap: 4,
            }}
          >
            <span style={{ fontSize: 12, color: TOKENS.muted }}>Thinking</span>
            <span className="dot-flashing" style={{ display: "inline-block", width: 4, height: 4, borderRadius: "50%", background: TOKENS.ember }} />
          </div>
        )}
        <div ref={messagesEndRef} />
      </div>

      {/* Input Bar */}
      <div style={{ display: "flex", gap: 8, flexShrink: 0 }}>
        <input
          type="text"
          value={input}
          onChange={(e) => setInput(e.target.value)}
          onKeyDown={(e) => {
            if (e.key === "Enter") handleSend();
          }}
          placeholder="Ask what to eat, workout tips, etc…"
          style={{
            flex: 1,
            background: TOKENS.surface,
            border: `1px solid ${TOKENS.border}`,
            borderRadius: 12,
            padding: "12px 14px",
            color: TOKENS.text,
            fontSize: 13.5,
            outline: "none",
          }}
        />
        <button
          onClick={() => handleSend()}
          disabled={loading || !input.trim()}
          style={{
            background: input.trim() ? TOKENS.ember : TOKENS.surface2,
            color: input.trim() ? "#0B0E13" : TOKENS.mutedFaint,
            border: "none",
            borderRadius: 12,
            padding: "0 18px",
            fontWeight: 700,
            fontSize: 14,
            cursor: input.trim() ? "pointer" : "default",
          }}
        >
          Send
        </button>
      </div>
    </div>
  );
}

function MoreHubScreen({ profile, setProfile, goals, userPhone, onSignOut, totals, onNavigate }) {
  const [activeModal, setActiveModal] = useState(null);
  const [isFasting, setIsFasting] = useState(true);
  const [fastHours, setFastHours] = useState(14);
  const [fastMins, setFastMins] = useState(22);
  const [fastGoal, setFastGoal] = useState(16);
  const [syncTime, setSyncTime] = useState("6:56 PM");
  const [isSyncing, setIsSyncing] = useState(false);
  const [syncToast, setSyncToast] = useState(false);
  const [stepsCount, setStepsCount] = useState(7420);
  const [sleepHours, setSleepHours] = useState(7.8);
  const [weightLogs, setWeightLogs] = useState([
    { date: "Sep 1", weight: 71.5 },
    { date: "Sep 8", weight: 71.0 },
    { date: "Sep 15", weight: 70.6 },
    { date: "Today", weight: profile.weightKg || 70.0 },
  ]);
  const [newWeightInput, setNewWeightInput] = useState("");
  const [reminders, setReminders] = useState({
    breakfast: true,
    lunch: true,
    dinner: true,
    water: true,
    workout: true,
  });

  const username = profile.name || userPhone || "mohdnuman701402";
  const avatarLetter = (username || "M").trim().charAt(0).toUpperCase();

  function triggerSync() {
    setIsSyncing(true);
    setTimeout(() => {
      setIsSyncing(false);
      const now = new Date();
      setSyncTime(now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }));
      setSyncToast(true);
      setTimeout(() => setSyncToast(false), 2500);
    }, 900);
  }

  function handleAddWeight() {
    const val = parseFloat(newWeightInput);
    if (!isNaN(val) && val > 30 && val < 250) {
      setWeightLogs((prev) => [...prev, { date: "Just now", weight: val }]);
      setProfile((prev) => ({ ...prev, weightKg: val }));
      setNewWeightInput("");
    }
  }

  const MORE_ITEMS = [
    { id: "profile", label: "My Profile", icon: "👤" },
    { id: "fasting", label: "Intermittent Fasting", icon: "⌛", badge: isFasting ? "Active" : null },
    { id: "sleep", label: "Sleep", icon: "🌙", subtitle: `${sleepHours}h · 88% quality` },
    { id: "recipes", label: "Recipe Discovery", icon: "🍳", badge: "New" },
    { id: "routines", label: "Workout Routines", icon: "🏋️" },
    { id: "goals", label: "Goals", icon: "🎯" },
    { id: "weight", label: "Weight & Measurements", icon: "📊", subtitle: `${profile.weightKg} kg` },
    { id: "weekly", label: "My Weekly Report", icon: "📈" },
    { id: "nutrition", label: "Nutrition", icon: "🥗" },
    { id: "meals", label: "My Meals, Recipes & Foods", icon: "🍲" },
    { id: "reminders", label: "Reminders", icon: "⏰" },
    { id: "devices", label: "Apps & Devices", icon: "📱", badge: "Connected" },
    { id: "steps", label: "Steps", icon: "👟", subtitle: `${stepsCount.toLocaleString()} steps` },
    { id: "community", label: "Community", icon: "👥" },
    { id: "learn", label: "Learn", icon: "🎓" },
    { id: "friends", label: "Friends", icon: "🤝" },
    { id: "messages", label: "Messages", icon: "💬", badgeCount: 1 },
    { id: "settings", label: "Settings", icon: "⚙️" },
    { id: "privacy", label: "Privacy", icon: "🔒" },
    { id: "help", label: "Help", icon: "❓" },
  ];

  return (
    <div style={{ color: TOKENS.text, paddingBottom: 24 }}>
      {/* Top Header */}
      <div style={{ textAlign: "center", marginBottom: 18, position: "relative" }}>
        <h1 style={{ margin: 0, fontSize: 18, fontWeight: 700, color: TOKENS.text }}>More</h1>
      </div>

      {/* User Card */}
      <div style={{ background: TOKENS.surface, backdropFilter: "blur(16px)", WebkitBackdropFilter: "blur(16px)", border: `1px solid ${TOKENS.border}`, borderRadius: 20, padding: "20px 18px", marginBottom: 14, boxShadow: CARD_SHADOW }}>
        <div style={{ display: "flex", alignItems: "center", gap: 14, marginBottom: 16 }}>
          <div style={{ width: 56, height: 56, borderRadius: "50%", background: "linear-gradient(135deg, #EC4899 0%, #BE185D 100%)", color: "#FFFFFF", display: "flex", alignItems: "center", justifyContent: "center", fontSize: 24, fontWeight: 800, flexShrink: 0, boxShadow: "0 6px 18px rgba(236,72,153,0.35)" }}>
            {avatarLetter}
          </div>
          <div style={{ flex: 1, minWidth: 0 }}>
            <div style={{ fontSize: 17, fontWeight: 700, color: TOKENS.text, overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" }}>
              {username}
            </div>
            <div style={{ fontSize: 12, color: TOKENS.mutedFaint, marginTop: 2 }}>STOKE Member · Free Tier</div>
          </div>
        </div>

        <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 12, paddingTop: 14, borderTop: `1px solid ${TOKENS.border}` }}>
          <div style={{ textAlign: "center", borderRight: `1px solid ${TOKENS.border}` }}>
            <div style={{ fontSize: 11, color: TOKENS.mutedFaint, textTransform: "uppercase", letterSpacing: 0.5 }}>Streak</div>
            <div style={{ fontSize: 17, fontWeight: 800, color: TOKENS.ember, marginTop: 2 }}>🔥 3 days</div>
          </div>
          <div style={{ textAlign: "center" }}>
            <div style={{ fontSize: 11, color: TOKENS.mutedFaint, textTransform: "uppercase", letterSpacing: 0.5 }}>Progress</div>
            <div style={{ fontSize: 17, fontWeight: 800, color: TOKENS.teal, marginTop: 2 }}>0.8 kg lost</div>
          </div>
        </div>
      </div>

      {/* Try Premium for Free Gold Banner */}
      <div
        onClick={() => setActiveModal("premium")}
        style={{
          cursor: "pointer",
          background: "linear-gradient(90deg, rgba(245,158,11,0.18) 0%, rgba(215,255,62,0.12) 100%)",
          border: "1px solid rgba(245,158,11,0.4)",
          borderRadius: 16,
          padding: "14px 16px",
          marginBottom: 16,
          display: "flex",
          alignItems: "center",
          justifyContent: "space-between",
          boxShadow: "0 6px 20px rgba(245,158,11,0.15)",
        }}
      >
        <div style={{ display: "flex", alignItems: "center", gap: 12 }}>
          <span style={{ fontSize: 24 }}>👑</span>
          <div>
            <div style={{ fontSize: 14, fontWeight: 800, color: "#FBBF24", letterSpacing: -0.2 }}>Try Premium for Free</div>
            <div style={{ fontSize: 11.5, color: "rgba(255,255,255,0.75)", marginTop: 1 }}>Unlock AI camera, fasting stages & custom splits</div>
          </div>
        </div>
        <span style={{ fontSize: 18, color: "#FBBF24", fontWeight: 700 }}>›</span>
      </div>

      {/* Main Feature List */}
      <div style={{ background: TOKENS.surface, backdropFilter: "blur(16px)", WebkitBackdropFilter: "blur(16px)", border: `1px solid ${TOKENS.border}`, borderRadius: 20, overflow: "hidden", marginBottom: 16, boxShadow: CARD_SHADOW }}>
        {MORE_ITEMS.map((item, i) => (
          <div
            key={item.id}
            onClick={() => {
              if (item.id === "routines") onNavigate("workout");
              else if (item.id === "nutrition") onNavigate("nutrition");
              else if (item.id === "messages") onNavigate("coach");
              else setActiveModal(item.id);
            }}
            style={{
              padding: "14px 16px",
              display: "flex",
              alignItems: "center",
              justifyContent: "space-between",
              cursor: "pointer",
              borderBottom: i < MORE_ITEMS.length - 1 ? `1px solid rgba(255,255,255,0.06)` : "none",
              transition: "background 0.15s ease",
            }}
            onMouseEnter={(e) => (e.currentTarget.style.background = "rgba(255,255,255,0.04)")}
            onMouseLeave={(e) => (e.currentTarget.style.background = "transparent")}
          >
            <div style={{ display: "flex", alignItems: "center", gap: 14 }}>
              <span style={{ fontSize: 18, width: 24, textAlign: "center" }}>{item.icon}</span>
              <div>
                <span style={{ fontSize: 14, fontWeight: 600, color: TOKENS.text }}>{item.label}</span>
                {item.subtitle && <div style={{ fontSize: 11, color: TOKENS.mutedFaint, marginTop: 1 }}>{item.subtitle}</div>}
              </div>
            </div>

            <div style={{ display: "flex", alignItems: "center", gap: 8 }}>
              {item.badge && (
                <span style={{ fontSize: 10, background: "rgba(46,212,191,0.15)", color: TOKENS.teal, padding: "2px 7px", borderRadius: 999, fontWeight: 700 }}>
                  {item.badge}
                </span>
              )}
              {item.badgeCount && (
                <span style={{ fontSize: 11, background: "#EF4444", color: "#FFFFFF", padding: "1px 6px", borderRadius: 999, fontWeight: 800 }}>
                  {item.badgeCount}
                </span>
              )}
              <span style={{ fontSize: 18, color: TOKENS.mutedFaint, fontWeight: 600 }}>›</span>
            </div>
          </div>
        ))}
      </div>

      {/* Sync Row */}
      <div
        onClick={triggerSync}
        style={{
          background: TOKENS.surface,
          border: `1px solid ${TOKENS.border}`,
          borderRadius: 16,
          padding: "14px 16px",
          display: "flex",
          alignItems: "center",
          justifyContent: "space-between",
          cursor: "pointer",
          boxShadow: CARD_SHADOW,
        }}
      >
        <div style={{ display: "flex", alignItems: "center", gap: 12 }}>
          <span style={{ fontSize: 18, display: "inline-block", transform: isSyncing ? "rotate(360deg)" : "none", transition: isSyncing ? "transform 0.8s ease-in-out" : "none" }}>
            🔄
          </span>
          <div>
            <div style={{ fontSize: 14, fontWeight: 600, color: TOKENS.text }}>Sync</div>
            <div style={{ fontSize: 11, color: TOKENS.mutedFaint }}>Last synced: {syncTime}</div>
          </div>
        </div>
        <button
          style={{
            background: "rgba(255,255,255,0.06)",
            border: `1px solid ${TOKENS.border}`,
            borderRadius: 8,
            padding: "5px 10px",
            color: TOKENS.ember,
            fontSize: 11,
            fontWeight: 700,
            cursor: "pointer",
          }}
        >
          {isSyncing ? "Syncing…" : "Sync Now"}
        </button>
      </div>

      {/* Sync Toast */}
      {syncToast && (
        <div style={{ position: "fixed", bottom: 80, left: "50%", transform: "translateX(-50%)", background: "#0B0E13", border: `1px solid ${TOKENS.ember}`, borderRadius: 999, padding: "8px 18px", color: TOKENS.ember, fontSize: 12, fontWeight: 700, zIndex: 9999, boxShadow: "0 8px 24px rgba(0,0,0,0.8)" }}>
          ✓ All data synced successfully!
        </div>
      )}

      {/* Sub-Screen Modals */}
      {activeModal && (
        <div style={{ position: "fixed", inset: 0, background: "rgba(0,0,0,0.8)", backdropFilter: "blur(12px)", zIndex: 999, display: "flex", alignItems: "flex-end", justifyContent: "center" }}>
          <div style={{ background: "#121720", border: `1px solid ${TOKENS.border}`, borderRadius: "24px 24px 0 0", width: "100%", maxWidth: 480, maxHeight: "88vh", overflowY: "auto", padding: 22, boxShadow: "0 -10px 40px rgba(0,0,0,0.8)" }}>
            <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 18 }}>
              <h2 style={{ margin: 0, fontSize: 19, fontWeight: 800, color: TOKENS.text }}>
                {activeModal === "profile" && "👤 My Profile & Goals"}
                {activeModal === "fasting" && "⌛ Intermittent Fasting"}
                {activeModal === "sleep" && "🌙 Sleep Tracker"}
                {activeModal === "recipes" && "🍳 Recipe Discovery"}
                {activeModal === "weight" && "📊 Weight & Body Metrics"}
                {activeModal === "weekly" && "📈 Weekly Report"}
                {activeModal === "reminders" && "⏰ Reminders"}
                {activeModal === "devices" && "📱 Connected Devices"}
                {activeModal === "steps" && "👟 Steps & Activity"}
                {activeModal === "premium" && "👑 STOKE Premium"}
                {activeModal === "goals" && "🎯 Target Goals"}
                {activeModal === "meals" && "🍲 Saved Meals & Recipes"}
                {activeModal === "community" && "👥 Community Leaderboards"}
                {activeModal === "learn" && "🎓 Fitness Knowledge Hub"}
                {activeModal === "friends" && "🤝 Friends & Activity Feed"}
                {activeModal === "settings" && "⚙️ App Settings"}
                {activeModal === "privacy" && "🔒 Privacy & Data Protection"}
                {activeModal === "help" && "❓ Help & Support"}
              </h2>
              <button onClick={() => setActiveModal(null)} style={{ background: "rgba(255,255,255,0.1)", border: "none", width: 32, height: 32, borderRadius: "50%", color: TOKENS.text, fontSize: 16, cursor: "pointer" }}>✕</button>
            </div>

            {/* Profile Modal */}
            {activeModal === "profile" && (
              <div>
                <label style={{ fontSize: 11, color: TOKENS.mutedFaint, display: "block", marginBottom: 4 }}>Full Name</label>
                <input type="text" value={profile.name} onChange={(e) => setProfile((p) => ({ ...p, name: e.target.value }))} placeholder="Your name" style={{ ...inputStyle, marginBottom: 12 }} />

                <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 10, marginBottom: 12 }}>
                  <div>
                    <label style={{ fontSize: 11, color: TOKENS.mutedFaint, display: "block", marginBottom: 4 }}>Weight (kg)</label>
                    <input type="number" value={profile.weightKg} onChange={(e) => setProfile((p) => ({ ...p, weightKg: Number(e.target.value) }))} style={inputStyle} />
                  </div>
                  <div>
                    <label style={{ fontSize: 11, color: TOKENS.mutedFaint, display: "block", marginBottom: 4 }}>Height (cm)</label>
                    <input type="number" value={profile.heightCm} onChange={(e) => setProfile((p) => ({ ...p, heightCm: Number(e.target.value) }))} style={inputStyle} />
                  </div>
                  <div>
                    <label style={{ fontSize: 11, color: TOKENS.mutedFaint, display: "block", marginBottom: 4 }}>Age</label>
                    <input type="number" value={profile.age} onChange={(e) => setProfile((p) => ({ ...p, age: Number(e.target.value) }))} style={inputStyle} />
                  </div>
                  <div>
                    <label style={{ fontSize: 11, color: TOKENS.mutedFaint, display: "block", marginBottom: 4 }}>Sex</label>
                    <select value={profile.sex} onChange={(e) => setProfile((p) => ({ ...p, sex: e.target.value }))} style={inputStyle}>
                      <option value="male">Male</option>
                      <option value="female">Female</option>
                    </select>
                  </div>
                </div>

                <label style={{ fontSize: 11, color: TOKENS.mutedFaint, display: "block", marginBottom: 6 }}>Target Strategy</label>
                <div style={{ display: "flex", gap: 8, marginBottom: 18 }}>
                  {[
                    { key: "cut", label: "Cut", desc: "Fat Loss" },
                    { key: "maintain", label: "Maintain", desc: "Steady" },
                    { key: "gain", label: "Gain", desc: "Muscle" },
                  ].map((g) => (
                    <button key={g.key} onClick={() => setProfile((p) => ({ ...p, goalType: g.key }))} style={{ flex: 1, padding: "10px 0", borderRadius: 10, border: `1px solid ${profile.goalType === g.key ? TOKENS.ember : TOKENS.border}`, background: profile.goalType === g.key ? "rgba(215,255,62,0.15)" : "transparent", color: profile.goalType === g.key ? TOKENS.ember : TOKENS.text, fontWeight: 700, cursor: "pointer" }}>
                      <div style={{ fontSize: 13 }}>{g.label}</div>
                      <div style={{ fontSize: 10, opacity: 0.7 }}>{g.desc}</div>
                    </button>
                  ))}
                </div>

                <button onClick={onSignOut} style={{ width: "100%", background: "rgba(239,68,68,0.15)", border: "1px solid rgba(239,68,68,0.3)", borderRadius: 12, padding: "12px 0", color: "#EF4444", fontWeight: 700, fontSize: 13, cursor: "pointer" }}>Sign Out</button>
              </div>
            )}

            {/* Intermittent Fasting Modal */}
            {activeModal === "fasting" && (
              <div style={{ textAlign: "center" }}>
                <div style={{ background: "rgba(255,255,255,0.03)", border: `1px solid ${TOKENS.border}`, borderRadius: 18, padding: 22, marginBottom: 16 }}>
                  <div style={{ fontSize: 12, color: TOKENS.muted, marginBottom: 6 }}>Current Fast · {fastGoal}:8 Protocol</div>
                  <div style={{ fontSize: 40, fontWeight: 800, color: TOKENS.ember, fontVariantNumeric: "tabular-nums" }}>{fastHours}h {fastMins}m</div>
                  <div style={{ fontSize: 12, color: TOKENS.teal, marginTop: 4 }}>🔥 Autophagy & Peak Fat Oxidation Active</div>
                  <div style={{ height: 8, background: "rgba(255,255,255,0.1)", borderRadius: 4, margin: "18px 0 10px", overflow: "hidden" }}>
                    <div style={{ width: `${Math.min(100, (fastHours / fastGoal) * 100)}%`, height: "100%", background: TOKENS.ember, borderRadius: 4 }} />
                  </div>
                  <div style={{ display: "flex", justifyContent: "space-between", fontSize: 11, color: TOKENS.mutedFaint }}>
                    <span>Started 8:00 PM</span>
                    <span>Goal: {fastGoal} hours</span>
                  </div>
                </div>

                <div style={{ display: "flex", gap: 8, marginBottom: 16 }}>
                  {[14, 16, 18, 20].map((h) => (
                    <button key={h} onClick={() => setFastGoal(h)} style={{ flex: 1, padding: "8px 0", borderRadius: 8, border: `1px solid ${fastGoal === h ? TOKENS.ember : TOKENS.border}`, background: fastGoal === h ? "rgba(215,255,62,0.15)" : "transparent", color: fastGoal === h ? TOKENS.ember : TOKENS.text, fontWeight: 700, cursor: "pointer" }}>{h}:{24 - h}</button>
                  ))}
                </div>

                <button onClick={() => setIsFasting(!isFasting)} style={{ width: "100%", background: isFasting ? "#EF4444" : TOKENS.ember, color: isFasting ? "#fff" : "#000", border: "none", borderRadius: 12, padding: "14px 0", fontWeight: 700, fontSize: 14, cursor: "pointer" }}>
                  {isFasting ? "🛑 End Current Fast" : "▶ Start Fasting Now"}
                </button>
              </div>
            )}

            {/* Sleep Modal */}
            {activeModal === "sleep" && (
              <div>
                <div style={{ background: "rgba(255,255,255,0.03)", border: `1px solid ${TOKENS.border}`, borderRadius: 18, padding: 18, marginBottom: 16, textAlign: "center" }}>
                  <div style={{ fontSize: 12, color: TOKENS.muted }}>Last Night Sleep</div>
                  <div style={{ fontSize: 36, fontWeight: 800, color: "#818CF8", margin: "4px 0" }}>{sleepHours} hrs</div>
                  <div style={{ fontSize: 12, color: TOKENS.teal }}>Score: 88 (Excellent Recovery)</div>
                </div>
                <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr 1fr", gap: 8, marginBottom: 14 }}>
                  <div style={{ background: "rgba(255,255,255,0.04)", borderRadius: 12, padding: 10, textAlign: "center" }}>
                    <div style={{ fontSize: 10, color: TOKENS.muted }}>Deep</div>
                    <div style={{ fontSize: 14, fontWeight: 700, color: "#fff" }}>1h 50m</div>
                  </div>
                  <div style={{ background: "rgba(255,255,255,0.04)", borderRadius: 12, padding: 10, textAlign: "center" }}>
                    <div style={{ fontSize: 10, color: TOKENS.muted }}>REM</div>
                    <div style={{ fontSize: 14, fontWeight: 700, color: "#fff" }}>2h 10m</div>
                  </div>
                  <div style={{ background: "rgba(255,255,255,0.04)", borderRadius: 12, padding: 10, textAlign: "center" }}>
                    <div style={{ fontSize: 10, color: TOKENS.muted }}>Light</div>
                    <div style={{ fontSize: 14, fontWeight: 700, color: "#fff" }}>3h 45m</div>
                  </div>
                </div>
                <button onClick={() => setSleepHours((h) => Math.min(12, Number((h + 0.5).toFixed(1))))} style={{ width: "100%", background: TOKENS.surface2, border: `1px solid ${TOKENS.border}`, borderRadius: 10, padding: "12px 0", color: TOKENS.text, fontWeight: 700, cursor: "pointer" }}>+ Log 30m Sleep</button>
              </div>
            )}

            {/* Recipes Modal */}
            {activeModal === "recipes" && (
              <div style={{ display: "flex", flexDirection: "column", gap: 10 }}>
                {[
                  { title: "Chocolate Whey Overnight Oats", cal: 450, p: 38, c: 52, f: 8, icon: "🥣" },
                  { title: "Crispy Air-Fried Chicken Bowl", cal: 520, p: 48, c: 55, f: 12, icon: "🍗" },
                  { title: "Grilled Salmon Quinoa Medley", cal: 480, p: 42, c: 35, f: 18, icon: "🐟" },
                  { title: "High-Protein Banana Pancakes", cal: 390, p: 32, c: 45, f: 6, icon: "🥞" },
                ].map((r, i) => (
                  <div key={i} style={{ background: "rgba(255,255,255,0.03)", border: `1px solid ${TOKENS.border}`, borderRadius: 14, padding: "12px 14px", display: "flex", justifyContent: "space-between", alignItems: "center" }}>
                    <div style={{ display: "flex", alignItems: "center", gap: 10 }}>
                      <span style={{ fontSize: 24 }}>{r.icon}</span>
                      <div>
                        <div style={{ fontSize: 13.5, fontWeight: 700, color: TOKENS.text }}>{r.title}</div>
                        <div style={{ fontSize: 11, color: TOKENS.mutedFaint }}>{r.cal} kcal · P {r.p}g · C {r.c}g · F {r.f}g</div>
                      </div>
                    </div>
                    <button onClick={() => { onNavigate("nutrition"); setActiveModal(null); }} style={{ background: TOKENS.ember, color: "#000", border: "none", borderRadius: 8, padding: "6px 12px", fontSize: 11, fontWeight: 700, cursor: "pointer" }}>+ Log</button>
                  </div>
                ))}
              </div>
            )}

            {/* Weight Modal */}
            {activeModal === "weight" && (
              <div>
                <div style={{ display: "flex", gap: 8, marginBottom: 14 }}>
                  <input type="number" step="0.1" value={newWeightInput} onChange={(e) => setNewWeightInput(e.target.value)} placeholder="Log weight e.g. 70.2" style={{ ...inputStyle, flex: 1 }} />
                  <button onClick={handleAddWeight} style={{ background: TOKENS.ember, color: "#000", border: "none", borderRadius: 8, padding: "0 16px", fontWeight: 700, fontSize: 13, cursor: "pointer" }}>Save</button>
                </div>
                <div style={{ background: "rgba(255,255,255,0.03)", border: `1px solid ${TOKENS.border}`, borderRadius: 14, padding: 14 }}>
                  <div style={{ fontSize: 12, fontWeight: 700, color: TOKENS.muted, marginBottom: 8 }}>Recent Weight History</div>
                  {weightLogs.slice().reverse().map((w, i) => (
                    <div key={i} style={{ display: "flex", justifyContent: "space-between", padding: "8px 0", borderBottom: i < weightLogs.length - 1 ? `1px solid rgba(255,255,255,0.05)` : "none", fontSize: 13 }}>
                      <span style={{ color: TOKENS.mutedFaint }}>{w.date}</span>
                      <span style={{ fontWeight: 700, color: TOKENS.text }}>{w.weight} kg</span>
                    </div>
                  ))}
                </div>
              </div>
            )}

            {/* Reminders Modal */}
            {activeModal === "reminders" && (
              <div style={{ display: "flex", flexDirection: "column", gap: 10 }}>
                {Object.keys(reminders).map((k) => (
                  <div key={k} style={{ display: "flex", justifyContent: "space-between", alignItems: "center", padding: "12px 14px", background: "rgba(255,255,255,0.03)", border: `1px solid ${TOKENS.border}`, borderRadius: 12 }}>
                    <span style={{ fontSize: 13.5, fontWeight: 600, textTransform: "capitalize", color: TOKENS.text }}>{k} Notifications</span>
                    <button onClick={() => setReminders((r) => ({ ...r, [k]: !r[k] }))} style={{ width: 44, height: 24, borderRadius: 12, background: reminders[k] ? TOKENS.ember : "#333", border: "none", position: "relative", cursor: "pointer" }}>
                      <span style={{ width: 18, height: 18, borderRadius: "50%", background: "#fff", position: "absolute", top: 3, left: reminders[k] ? 22 : 4, transition: "left 0.2s" }} />
                    </button>
                  </div>
                ))}
              </div>
            )}

            {/* Apps & Devices Modal */}
            {activeModal === "devices" && (
              <div style={{ display: "flex", flexDirection: "column", gap: 10 }}>
                {[
                  { name: "Apple Health", status: "Connected", icon: "❤️" },
                  { name: "Google Fit", status: "Connected", icon: "🟢" },
                  { name: "Garmin Connect", status: "Available", icon: "⌚" },
                  { name: "Fitbit Tracker", status: "Available", icon: "🔋" },
                ].map((d, i) => (
                  <div key={i} style={{ display: "flex", justifyContent: "space-between", alignItems: "center", padding: "12px 14px", background: "rgba(255,255,255,0.03)", border: `1px solid ${TOKENS.border}`, borderRadius: 12 }}>
                    <div style={{ display: "flex", alignItems: "center", gap: 10 }}>
                      <span style={{ fontSize: 20 }}>{d.icon}</span>
                      <span style={{ fontSize: 13.5, fontWeight: 600, color: TOKENS.text }}>{d.name}</span>
                    </div>
                    <span style={{ fontSize: 11, fontWeight: 700, color: d.status === "Connected" ? TOKENS.teal : TOKENS.mutedFaint }}>{d.status}</span>
                  </div>
                ))}
              </div>
            )}

            {/* Steps Modal */}
            {activeModal === "steps" && (
              <div style={{ textAlign: "center" }}>
                <div style={{ background: "rgba(255,255,255,0.03)", border: `1px solid ${TOKENS.border}`, borderRadius: 18, padding: 20, marginBottom: 14 }}>
                  <div style={{ fontSize: 12, color: TOKENS.muted }}>Today's Steps</div>
                  <div style={{ fontSize: 38, fontWeight: 800, color: TOKENS.ember, margin: "4px 0" }}>{stepsCount.toLocaleString()}</div>
                  <div style={{ fontSize: 12, color: TOKENS.mutedFaint }}>Goal: 10,000 steps (74% achieved)</div>
                  <div style={{ height: 8, background: "rgba(255,255,255,0.1)", borderRadius: 4, margin: "14px 0 8px", overflow: "hidden" }}>
                    <div style={{ width: `${(stepsCount / 10000) * 100}%`, height: "100%", background: TOKENS.ember }} />
                  </div>
                </div>
                <button onClick={() => setStepsCount((s) => s + 500)} style={{ width: "100%", background: TOKENS.surface2, border: `1px solid ${TOKENS.border}`, borderRadius: 10, padding: "12px 0", color: TOKENS.text, fontWeight: 700, cursor: "pointer" }}>+ Log 500 Steps</button>
              </div>
            )}

            {/* Premium Modal */}
            {activeModal === "premium" && (
              <div style={{ textAlign: "center" }}>
                <span style={{ fontSize: 44 }}>👑</span>
                <h3 style={{ margin: "10px 0 4px", fontSize: 20, fontWeight: 800, color: "#FBBF24" }}>STOKE Pro Membership</h3>
                <div style={{ fontSize: 12, color: TOKENS.muted, marginBottom: 16 }}>Supercharge your fitness journey with next-gen AI tools</div>
                <div style={{ textAlign: "left", background: "rgba(255,255,255,0.03)", border: `1px solid ${TOKENS.border}`, borderRadius: 14, padding: 14, display: "flex", flexDirection: "column", gap: 8, marginBottom: 16, fontSize: 12.5 }}>
                  <div>⚡ <strong>Unlimited AI Camera Scans</strong> for instant food recognition</div>
                  <div>⌛ <strong>Autophagy & Fasting Periodization</strong></div>
                  <div>🤖 <strong>24/7 Dedicated AI Sports Dietitian</strong></div>
                  <div>📊 <strong>Advanced Micronutrient & Blood Sugar Analytics</strong></div>
                </div>
                <button onClick={() => { alert("🎉 You have unlocked 7 days of STOKE Pro!"); setActiveModal(null); }} style={{ width: "100%", background: "linear-gradient(90deg, #FBBF24 0%, #F59E0B 100%)", color: "#000", border: "none", borderRadius: 12, padding: "14px 0", fontWeight: 800, fontSize: 14, cursor: "pointer" }}>
                  Start 7-Day Free Trial ($0 today)
                </button>
              </div>
            )}

            {/* Weekly Report Modal */}
            {activeModal === "weekly" && (
              <div>
                <div style={{ background: "rgba(255,255,255,0.03)", border: `1px solid ${TOKENS.border}`, borderRadius: 14, padding: 14, marginBottom: 12, textAlign: "center" }}>
                  <div style={{ fontSize: 11, color: TOKENS.mutedFaint }}>Weekly Adherence</div>
                  <div style={{ fontSize: 32, fontWeight: 800, color: TOKENS.teal, margin: "2px 0" }}>94%</div>
                  <div style={{ fontSize: 11, color: TOKENS.muted }}>Within ±5% of calorie & protein goals</div>
                </div>
                <div style={{ display: "flex", justifyContent: "space-between", alignItems: "flex-end", height: 100, padding: "0 10px", marginBottom: 12 }}>
                  {[
                    { d: "M", h: 80 }, { d: "T", h: 95 }, { d: "W", h: 90 }, { d: "T", h: 100 }, { d: "F", h: 85 }, { d: "S", h: 70 }, { d: "S", h: 92 }
                  ].map((b, i) => (
                    <div key={i} style={{ display: "flex", flexDirection: "column", alignItems: "center", gap: 4 }}>
                      <div style={{ width: 22, height: b.h * 0.7, background: TOKENS.ember, borderRadius: 4 }} />
                      <span style={{ fontSize: 10, color: TOKENS.mutedFaint }}>{b.d}</span>
                    </div>
                  ))}
                </div>
              </div>
            )}

            {/* Generic Fallback for Community/Learn/Help/Settings/Privacy */}
            {["goals", "meals", "community", "learn", "friends", "settings", "privacy", "help"].includes(activeModal) && (
              <div style={{ textAlign: "center", padding: "20px 0" }}>
                <div style={{ fontSize: 32, marginBottom: 10 }}>✨</div>
                <div style={{ fontSize: 14, color: TOKENS.text, fontWeight: 600 }}>{activeModal.toUpperCase()} Center is Active</div>
                <div style={{ fontSize: 12, color: TOKENS.mutedFaint, marginTop: 4 }}>Connected with your active STOKE profile and training records.</div>
                <button onClick={() => setActiveModal(null)} style={{ marginTop: 18, background: TOKENS.ember, color: "#000", border: "none", borderRadius: 10, padding: "10px 24px", fontWeight: 700, cursor: "pointer" }}>Done</button>
              </div>
            )}
          </div>
        </div>
      )}
    </div>
  );
}



/* ============================================================
   STOKE — MULTI-DESIGN-SYSTEM AUTH v3.0
   Fusing: Soft UI · Dark Neumorphism · Material Design · Swiss Design
   ============================================================ */

const AUTH_STYLES_V3 = `
  /* ── SWISS DESIGN: Typography foundation ── */
  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700;800;900&display=swap');

  /* ── KEYFRAMES ── */
  @keyframes neu-ripple {
    0%   { transform: scale(0); opacity: 0.6; }
    100% { transform: scale(4); opacity: 0; }
  }
  @keyframes fadeUp3 {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes slideRight3 {
    from { opacity: 0; transform: translateX(24px); }
    to   { opacity: 1; transform: translateX(0); }
  }
  @keyframes particle3 {
    0%   { transform: translateY(0) rotate(0deg); opacity: 0.8; }
    100% { transform: translateY(-110vh) rotate(360deg); opacity: 0; }
  }
  @keyframes spin3    { to { transform: rotate(360deg); } }
  @keyframes orb3 {
    0%,100% { transform: scale(1) translate(0,0); opacity: 0.5; }
    33%     { transform: scale(1.2) translate(12px,-8px); opacity: 0.75; }
    66%     { transform: scale(0.9) translate(-8px,10px); opacity: 0.6; }
  }
  @keyframes pulseGlow3 {
    0%,100% { box-shadow: 0 0 0 0 rgba(215,255,62,0.4); }
    50%     { box-shadow: 0 0 0 10px rgba(215,255,62,0); }
  }
  @keyframes shimmer3 {
    0%   { background-position: -200% center; }
    100% { background-position:  200% center; }
  }
  @keyframes checkBounce3 {
    0%   { transform: scale(0) rotate(-15deg); }
    70%  { transform: scale(1.2) rotate(5deg); }
    100% { transform: scale(1) rotate(0deg); }
  }

  /* ── SOFT UI / NEUMORPHISM: Dark surface tokens ── */
  :root {
    --neu-bg:    #0B0E14;
    --neu-light: rgba(255,255,255,0.055);
    --neu-dark:  rgba(0,0,0,0.55);
    --neu-inset: inset 3px 3px 8px rgba(0,0,0,0.55), inset -2px -2px 6px rgba(255,255,255,0.04);
    --neu-raised: 5px 5px 14px rgba(0,0,0,0.6), -3px -3px 10px rgba(255,255,255,0.04);
    --neu-flat:  2px 2px 6px rgba(0,0,0,0.4), -1px -1px 4px rgba(255,255,255,0.03);
    --lime:      #D7FF3E;
    --lime-glow: rgba(215,255,62,0.35);
    --mat-elev1: 0 1px 3px rgba(0,0,0,0.5), 0 1px 2px rgba(0,0,0,0.4);
    --mat-elev2: 0 3px 6px rgba(0,0,0,0.5), 0 3px 6px rgba(0,0,0,0.35);
    --mat-elev3: 0 10px 30px rgba(0,0,0,0.6), 0 6px 10px rgba(0,0,0,0.4);
    --mat-elev4: 0 20px 50px rgba(0,0,0,0.7), 0 10px 20px rgba(0,0,0,0.4);
  }

  /* ── MATERIAL DESIGN: Ripple effect ── */
  .mat-ripple {
    position: relative;
    overflow: hidden;
  }
  .mat-ripple::after {
    content: '';
    position: absolute;
    width: 60px; height: 60px;
    border-radius: 50%;
    background: rgba(215,255,62,0.25);
    transform: scale(0);
    top: var(--ry, 50%); left: var(--rx, 50%);
    margin-top: -30px; margin-left: -30px;
    pointer-events: none;
    animation: none;
  }
  .mat-ripple.rippling::after {
    animation: neu-ripple 0.55s ease-out forwards;
  }

  /* ── MAIN BUTTON: Soft UI + Material + Swiss ── */
  .s3-primary-btn {
    width: 100%;
    background: linear-gradient(135deg, #D7FF3E 0%, #C8F200 50%, #D7FF3E 100%);
    background-size: 200% auto;
    color: #060809;
    border: none;
    border-radius: 16px;
    padding: 18px 0;
    font-weight: 900;
    font-size: 15px;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    cursor: pointer;
    font-family: inherit;
    box-shadow: var(--neu-raised), 0 8px 28px rgba(215,255,62,0.35);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
    position: relative;
    overflow: hidden;
  }
  .s3-primary-btn::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, transparent 40%, rgba(255,255,255,0.3) 50%, transparent 60%);
    background-size: 200%;
    opacity: 0;
    transition: opacity 0.3s;
  }
  .s3-primary-btn:hover { transform: translateY(-2px); box-shadow: var(--neu-raised), 0 14px 36px rgba(215,255,62,0.5); }
  .s3-primary-btn:hover::before { opacity: 1; animation: shimmer3 0.65s ease; }
  .s3-primary-btn:active { transform: translateY(1px); box-shadow: var(--neu-inset), 0 4px 12px rgba(215,255,62,0.25); }
  .s3-primary-btn:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }

  /* ── GOOGLE BUTTON: Material elevated card ── */
  .s3-google-btn {
    width: 100%;
    background: #FFFFFF;
    color: #1a1a2e;
    border: none;
    border-radius: 16px;
    padding: 15px 0;
    font-weight: 700;
    font-size: 15px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font-family: inherit;
    box-shadow: var(--mat-elev2);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
    letter-spacing: 0.1px;
  }
  .s3-google-btn:hover { transform: translateY(-2px); box-shadow: var(--mat-elev3); }
  .s3-google-btn:active { transform: translateY(0px); box-shadow: var(--mat-elev1); }

  /* ── GHOST BUTTON: Neumorphic outlined ── */
  .s3-ghost-btn {
    width: 100%;
    background: rgba(255,255,255,0.04);
    color: rgba(255,255,255,0.85);
    border: 1.5px solid rgba(255,255,255,0.1);
    border-radius: 16px;
    padding: 15px 0;
    font-weight: 700;
    font-size: 14px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font-family: inherit;
    box-shadow: var(--neu-flat);
    transition: all 0.18s ease;
    letter-spacing: 0.2px;
  }
  .s3-ghost-btn:hover { background: rgba(255,255,255,0.07); box-shadow: var(--neu-raised); border-color: rgba(255,255,255,0.18); transform: translateY(-1px); }
  .s3-ghost-btn:active { box-shadow: var(--neu-inset); transform: translateY(0); }

  /* ── NEUMORPHIC INPUT (floating label) ── */
  .s3-field {
    position: relative;
    margin-bottom: 0;
  }
  .s3-field input,
  .s3-field select {
    width: 100%;
    background: #0D1018;
    border: 1.5px solid rgba(255,255,255,0.07);
    border-radius: 14px;
    padding: 22px 18px 8px;
    color: #F5F5F5;
    font-size: 15px;
    font-weight: 600;
    font-family: inherit;
    outline: none;
    box-sizing: border-box;
    box-shadow: var(--neu-inset);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
    -webkit-appearance: none;
    appearance: none;
  }
  .s3-field label {
    position: absolute;
    left: 18px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 14px;
    font-weight: 600;
    color: rgba(255,255,255,0.35);
    pointer-events: none;
    transition: all 0.22s cubic-bezier(0.4,0,0.2,1);
    letter-spacing: 0.2px;
  }
  .s3-field input:focus,
  .s3-field select:focus {
    border-color: var(--lime);
    box-shadow: var(--neu-inset), 0 0 0 3px rgba(215,255,62,0.1), 0 0 20px rgba(215,255,62,0.08);
  }
  .s3-field input:focus + label,
  .s3-field.filled label,
  .s3-field select:focus + label,
  .s3-field select.filled + label {
    top: 12px;
    transform: translateY(0);
    font-size: 10px;
    font-weight: 800;
    color: var(--lime);
    letter-spacing: 1px;
    text-transform: uppercase;
  }
  /* auto-filled fix */
  .s3-field input:not(:placeholder-shown) + label { top:12px; transform:translateY(0); font-size:10px; font-weight:800; color:var(--lime); letter-spacing:1px; text-transform:uppercase; }

  /* ── OPTION CARD: Swiss grid + Neumorphic surface ── */
  .s3-option {
    background: #0D1018;
    border: 1.5px solid rgba(255,255,255,0.07);
    border-radius: 14px;
    padding: 15px 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    box-shadow: var(--neu-raised);
    transition: all 0.2s ease;
    user-select: none;
  }
  .s3-option:hover { box-shadow: var(--mat-elev2); border-color: rgba(255,255,255,0.14); transform: translateY(-1px); }
  .s3-option.selected {
    background: rgba(215,255,62,0.07);
    border-color: var(--lime);
    box-shadow: 0 0 0 1px rgba(215,255,62,0.2), var(--mat-elev2), 0 0 20px rgba(215,255,62,0.07);
  }
  .s3-option:active { box-shadow: var(--neu-inset); transform: translateY(0); }

  /* ── CHIP: Material + Swiss ── */
  .s3-chip {
    background: #0D1018;
    color: rgba(255,255,255,0.7);
    border: 1px solid rgba(255,255,255,0.09);
    border-radius: 999px;
    padding: 9px 16px;
    font-size: 12.5px;
    font-weight: 700;
    cursor: pointer;
    font-family: inherit;
    box-shadow: var(--neu-flat);
    transition: all 0.18s ease;
    letter-spacing: 0.2px;
  }
  .s3-chip:hover { box-shadow: var(--neu-raised); transform: translateY(-1px); border-color: rgba(255,255,255,0.15); }
  .s3-chip.sel {
    background: var(--lime);
    color: #060809;
    border-color: var(--lime);
    box-shadow: 0 4px 16px rgba(215,255,62,0.4), var(--neu-flat);
  }
  .s3-chip:active { box-shadow: var(--neu-inset); transform: translateY(0); }

  /* ── PILL TOGGLE: Soft UI ── */
  .s3-pill {
    flex: 1;
    background: #0D1018;
    border: 1.5px solid rgba(255,255,255,0.08);
    border-radius: 14px;
    padding: 16px 0;
    color: rgba(255,255,255,0.6);
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    font-family: inherit;
    box-shadow: var(--neu-raised);
    transition: all 0.2s ease;
    display: flex; align-items: center; justify-content: center; gap: 8px;
    letter-spacing: 0.3px;
  }
  .s3-pill:hover { box-shadow: var(--mat-elev2); color: rgba(255,255,255,0.85); transform: translateY(-1px); }
  .s3-pill.sel {
    background: rgba(215,255,62,0.1);
    border-color: var(--lime);
    color: var(--lime);
    box-shadow: 0 0 0 1px rgba(215,255,62,0.15), 0 0 20px rgba(215,255,62,0.12);
  }
  .s3-pill:active { box-shadow: var(--neu-inset); transform: translateY(0); }

  /* ── GLASS CARD: Soft UI + Material elevation ── */
  .s3-glass {
    background: rgba(255,255,255,0.03);
    backdrop-filter: blur(28px) saturate(160%);
    -webkit-backdrop-filter: blur(28px) saturate(160%);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 24px;
    box-shadow: var(--mat-elev3), inset 0 1px 0 rgba(255,255,255,0.07);
  }

  /* ── INTERMISSION CARD: Neumorphic deep container ── */
  .s3-intermission {
    border-radius: 28px;
    padding: 44px 28px;
    box-shadow: var(--mat-elev4);
    text-align: center;
    backdrop-filter: blur(20px);
  }

  /* ── SWISS: Progress bar ── */
  .s3-progress-bar {
    display: flex;
    gap: 4px;
    margin-bottom: 18px;
  }
  .s3-progress-seg {
    flex: 1;
    height: 3px;
    border-radius: 2px;
    background: rgba(255,255,255,0.08);
    box-shadow: var(--neu-inset);
    overflow: hidden;
    position: relative;
  }
  .s3-progress-seg.done {
    background: var(--lime);
    box-shadow: 0 0 10px rgba(215,255,62,0.55);
  }

  /* ── MATERIAL: Checkbox ── */
  .s3-checkbox {
    width: 24px; height: 24px;
    border-radius: 7px;
    border: 2px solid rgba(255,255,255,0.2);
    background: #0D1018;
    box-shadow: var(--neu-inset);
    display: flex; align-items: center; justify-content: center;
    font-size: 13px; font-weight: 900;
    color: #060809;
    flex-shrink: 0;
    transition: all 0.22s ease;
    cursor: pointer;
  }
  .s3-checkbox.checked {
    background: var(--lime);
    border-color: var(--lime);
    box-shadow: 0 0 0 3px rgba(215,255,62,0.2), var(--mat-elev1);
    animation: checkBounce3 0.3s ease;
  }

  /* ── MATERIAL: Radio ── */
  .s3-radio {
    width: 22px; height: 22px;
    border-radius: 50%;
    border: 2px solid rgba(255,255,255,0.2);
    background: #0D1018;
    box-shadow: var(--neu-inset);
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
    transition: border-color 0.2s ease;
  }
  .s3-radio.checked { border-color: var(--lime); box-shadow: 0 0 0 3px rgba(215,255,62,0.15); }
  .s3-radio .dot { width: 11px; height: 11px; border-radius: 50%; background: var(--lime); animation: checkBounce3 0.25s ease; box-shadow: 0 0 8px rgba(215,255,62,0.6); }

  /* ── SWISS: Divider with label ── */
  .s3-divider {
    display: flex; align-items: center; gap: 12px; margin: 6px 0;
  }
  .s3-divider hr { flex:1; border:none; height:1px; background:rgba(255,255,255,0.08); box-shadow: 0 1px 0 rgba(255,255,255,0.03); }
  .s3-divider span { font-size: 11px; color: rgba(255,255,255,0.3); font-weight: 800; letter-spacing: 2px; text-transform: uppercase; }

  /* ── SOFT UI: Back button ── */
  .s3-back-btn {
    width: 38px; height: 38px;
    border-radius: 12px;
    background: #0D1018;
    border: none;
    color: rgba(255,255,255,0.7);
    font-size: 18px;
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    box-shadow: var(--neu-raised);
    transition: all 0.18s ease;
    font-family: inherit;
  }
  .s3-back-btn:hover { box-shadow: var(--mat-elev2); color: var(--lime); }
  .s3-back-btn:active { box-shadow: var(--neu-inset); }

  /* ── MATERIAL: Floating action card ── */
  .s3-calorie-card {
    border-radius: 24px;
    padding: 30px 24px;
    text-align: center;
    background: linear-gradient(145deg, rgba(215,255,62,0.07) 0%, rgba(11,14,20,0.95) 100%);
    border: 1.5px solid rgba(215,255,62,0.22);
    box-shadow: var(--mat-elev3), 0 0 40px rgba(215,255,62,0.06), inset 0 1px 0 rgba(215,255,62,0.1);
    backdrop-filter: blur(20px);
  }

  /* ── SOFT UI: Preference row ── */
  .s3-pref-row {
    display: flex;
    align-items: center;
    gap: 14px;
    cursor: pointer;
    padding: 14px 18px;
    background: #0D1018;
    border-radius: 14px;
    border: 1px solid rgba(255,255,255,0.06);
    box-shadow: var(--neu-raised);
    transition: all 0.18s ease;
  }
  .s3-pref-row:hover { box-shadow: var(--mat-elev2); border-color: rgba(255,255,255,0.11); }
  .s3-pref-row:active { box-shadow: var(--neu-inset); }

  /* ── SWISS: Feature chip card ── */
  .s3-feature-card {
    background: #0D1018;
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 16px;
    padding: 18px 20px;
    display: flex;
    align-items: center;
    gap: 16px;
    box-shadow: var(--neu-raised);
    transition: all 0.2s ease;
  }
  .s3-feature-card:hover { box-shadow: var(--mat-elev2); border-color: rgba(215,255,62,0.15); transform: translateY(-1px); }

  /* Spinner */
  .s3-spinner {
    width: 18px; height: 18px;
    border-radius: 50%;
    border: 2.5px solid transparent;
    border-top-color: #060809;
    display: inline-block;
    animation: spin3 0.7s linear infinite;
  }
`;

function injectAuthStylesV3() {
  if (document.getElementById("stoke-auth-v3")) return;
  const s = document.createElement("style");
  s.id = "stoke-auth-v3";
  s.textContent = AUTH_STYLES_V3;
  document.head.appendChild(s);
}

// ─── Animated background ────────────────────────────────────────
function NeuBackground({ accent = "#D7FF3E" }) {
  const LIME = "#D7FF3E";
  const rgb = accent === LIME ? "215,255,62" : accent === "#2ED4BF" ? "46,212,191" : "255,138,61";
  return (
    <div style={{ position:"fixed", inset:0, pointerEvents:"none", zIndex:0, overflow:"hidden", background:"#07090E" }}>
      {/* Deep gradient base */}
      <div style={{ position:"absolute", inset:0, background:`radial-gradient(ellipse at 25% 5%, rgba(${rgb},0.1) 0%, transparent 55%), radial-gradient(ellipse at 80% 95%, rgba(60,50,120,0.15) 0%, transparent 50%), linear-gradient(180deg, #0B0E14 0%, #070910 100%)` }} />
      {/* Soft orbs — Soft UI */}
      <div style={{ position:"absolute", top:"-80px", left:"50%", transform:"translateX(-50%)", width:320, height:320, borderRadius:"50%", background:`radial-gradient(circle, rgba(${rgb},0.13) 0%, transparent 72%)`, animation:"orb3 8s ease-in-out infinite" }} />
      <div style={{ position:"absolute", bottom:"-60px", right:"-40px", width:240, height:240, borderRadius:"50%", background:"radial-gradient(circle, rgba(60,50,180,0.14) 0%, transparent 70%)", animation:"orb3 12s ease-in-out infinite reverse" }} />
      {/* Floating particles */}
      {[
        {x:"7%",  sz:3, dur:18, del:0},
        {x:"22%", sz:2, dur:23, del:3},
        {x:"38%", sz:4, dur:16, del:7},
        {x:"55%", sz:2, dur:25, del:1},
        {x:"70%", sz:3, dur:19, del:5},
        {x:"84%", sz:2, dur:21, del:9},
        {x:"93%", sz:3, dur:22, del:2},
      ].map((p, i) => (
        <div key={i} style={{
          position:"absolute", bottom:-10, left:p.x,
          width:p.sz, height:p.sz, borderRadius:"50%",
          background: accent, opacity:0,
          animation:`particle3 ${p.dur}s ${p.del}s ease-in infinite`,
          filter:`blur(${p.sz>2?1:0}px)`
        }} />
      ))}
      {/* Swiss grid lines (very subtle) */}
      <div style={{ position:"absolute", inset:0, backgroundImage:"linear-gradient(rgba(255,255,255,0.015) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.015) 1px, transparent 1px)", backgroundSize:"40px 40px", pointerEvents:"none" }} />
    </div>
  );
}

// ─── Ripple handler ────────────────────────────────────────────
function addRipple(e) {
  const el = e.currentTarget;
  el.classList.remove("rippling");
  void el.offsetWidth;
  const r = el.getBoundingClientRect();
  el.style.setProperty("--rx", (e.clientX - r.left) + "px");
  el.style.setProperty("--ry", (e.clientY - r.top) + "px");
  el.classList.add("rippling");
}

// ─── Google SVG ────────────────────────────────────────────────
function GIcon({sz=20}) {
  return (
    <svg width={sz} height={sz} viewBox="0 0 48 48">
      <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
      <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
      <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
      <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
    </svg>
  );
}

// ─── Logo Mark: Soft UI embossed ──────────────────────────────
function NeuLogo({ size = 52 }) {
  return (
    <div style={{
      width:size, height:size,
      borderRadius: size * 0.28,
      background:"linear-gradient(145deg, #D7FF3E 0%, #C0EC00 100%)",
      boxShadow:"5px 5px 14px rgba(0,0,0,0.6), -3px -3px 10px rgba(255,255,255,0.04), 0 0 28px rgba(215,255,62,0.45)",
      display:"flex", alignItems:"center", justifyContent:"center",
      fontSize: size*0.5, fontWeight:900, color:"#060809",
      animation:"pulseGlow3 3s ease-in-out infinite",
      flexShrink:0
    }}>⚡</div>
  );
}

// ─── Floating label field ──────────────────────────────────────
function NeuInput({ label, type="text", value, onChange, onKeyDown, extraRight }) {
  return (
    <div className={`s3-field${value ? " filled" : ""}`} style={{ position:"relative" }}>
      <input type={type} value={value} onChange={onChange} onKeyDown={onKeyDown} placeholder=" " autoComplete="off" />
      <label>{label}</label>
      {extraRight}
    </div>
  );
}

// ─── Subcomponents ─────────────────────────────────────────────
function NeuCheckbox({ checked }) {
  return <div className={`s3-checkbox${checked?" checked":""}`}>{checked && "✓"}</div>;
}
function NeuRadio({ checked }) {
  return <div className={`s3-radio${checked?" checked":""}`}>{checked && <div className="dot" />}</div>;
}
function NeuSpinner() { return <span className="s3-spinner" />; }
function OrDivider3() {
  return (
    <div className="s3-divider">
      <hr/><span>or</span><hr/>
    </div>
  );
}

// ══════════════════════════════════════════════════════════════════════
//  WELCOME CAROUSEL  ─ Swiss typography + Soft UI cards
// ══════════════════════════════════════════════════════════════════════
const WELCOME_SLIDES = [
  { id:0, quote:"Discover the impact of your food & fitness", sub:"Track every calorie, run, and workout in one place.", accent:"#D7FF3E", type:"dashboard" },
  { id:1, quote:"Ready for wins? Start tracking today!", sub:"Log workouts and crush personal records effortlessly.", accent:"#2ED4BF", type:"workout" },
  { id:2, quote:"Make mindful eating a habit for life", sub:"Balance your macros and fuel peak performance.", accent:"#FF8A3D", type:"nutrition" }
];

function WelcomeSlideVisual({ slide }) {
  const LIME = "#D7FF3E";
  if (slide.type === "dashboard") {
    return (
      <div className="s3-glass" style={{ height:268, padding:"18px", display:"flex", flexDirection:"column", justifyContent:"space-between", position:"relative", overflow:"hidden", borderColor:"rgba(215,255,62,0.18)" }}>
        <div style={{ position:"absolute", top:-30, right:-30, width:160, height:160, borderRadius:"50%", background:"radial-gradient(circle, rgba(215,255,62,0.16) 0%, transparent 70%)", pointerEvents:"none" }} />
        {/* Top */}
        <div style={{ display:"flex", justifyContent:"space-between", alignItems:"center" }}>
          <div style={{ display:"flex", alignItems:"center", gap:9 }}>
            <div style={{ width:32, height:32, borderRadius:"50%", background:"linear-gradient(135deg,#D7FF3E,#C0EC00)", boxShadow:"0 0 12px rgba(215,255,62,0.5)", display:"flex", alignItems:"center", justifyContent:"center", fontWeight:900, fontSize:13, color:"#000" }}>M</div>
            <div>
              <div style={{ fontSize:13, fontWeight:800, color:"#fff", letterSpacing:-0.3, display:"flex", alignItems:"center", gap:5 }}>Today <span style={{ fontSize:9, background:"rgba(215,255,62,0.15)", color:LIME, padding:"2px 6px", borderRadius:4, fontWeight:900, letterSpacing:0.5 }}>PRO</span></div>
              <div style={{ fontSize:10, color:"rgba(255,255,255,0.38)", fontWeight:600 }}>Monday · Sep 29</div>
            </div>
          </div>
          <span style={{ fontSize:11, color:LIME, fontWeight:800, letterSpacing:0.5 }}>EDIT</span>
        </div>
        {/* Ring + stats */}
        <div style={{ display:"flex", alignItems:"center", gap:16 }}>
          <div style={{ position:"relative", width:100, height:100, flexShrink:0 }}>
            <svg width="100" height="100" viewBox="0 0 100 100">
              <circle cx="50" cy="50" r="42" fill="none" stroke="rgba(255,255,255,0.05)" strokeWidth="10"/>
              <circle cx="50" cy="50" r="42" fill="none" stroke="url(#dg)" strokeWidth="10" strokeDasharray="264" strokeDashoffset="78" strokeLinecap="round" transform="rotate(-90 50 50)" style={{filter:"drop-shadow(0 0 10px rgba(215,255,62,0.7))"}}/>
              <defs><linearGradient id="dg" x1="0%" y1="0%" x2="100%"><stop offset="0%" stopColor="#D7FF3E"/><stop offset="100%" stopColor="#2ED4BF"/></linearGradient></defs>
            </svg>
            <div style={{ position:"absolute", inset:0, display:"flex", flexDirection:"column", alignItems:"center", justifyContent:"center" }}>
              <div style={{ fontSize:19, fontWeight:900, color:"#fff", lineHeight:1, letterSpacing:-0.5 }}>1,850</div>
              <div style={{ fontSize:9, color:"rgba(255,255,255,0.4)", fontWeight:700, marginTop:2, letterSpacing:0.5 }}>KCAL LEFT</div>
            </div>
          </div>
          <div style={{ flex:1, display:"flex", flexDirection:"column", gap:6 }}>
            {[["🎯 Goal","2,400","#fff"],["🥗 Food","550","#2ED4BF"],["⚡ Exercise","400",LIME]].map(([l,v,c],i)=>(
              <div key={i} style={{ display:"flex", justifyContent:"space-between", alignItems:"center", background:"rgba(255,255,255,0.03)", borderRadius:9, padding:"5px 10px", boxShadow:"inset 1px 1px 3px rgba(0,0,0,0.4)" }}>
                <span style={{ fontSize:11, color:"rgba(255,255,255,0.48)" }}>{l}</span>
                <span style={{ fontSize:12, fontWeight:800, color:c }}>{v}</span>
              </div>
            ))}
          </div>
        </div>
        {/* Bottom stat bars */}
        <div style={{ display:"flex", gap:8 }}>
          {[["👟","Steps","6,342","63%",LIME],["🔥","Workout","400 cal","42m","rgba(255,255,255,0.35)"]].map(([ic,l,v,s,sc],i)=>(
            <div key={i} style={{ flex:1, background:"rgba(255,255,255,0.03)", border:"1px solid rgba(255,255,255,0.06)", borderRadius:12, padding:"8px 10px", display:"flex", alignItems:"center", gap:8, boxShadow:"inset 1px 1px 3px rgba(0,0,0,0.35)" }}>
              <span style={{ fontSize:17 }}>{ic}</span>
              <div>
                <div style={{ fontSize:10, color:"rgba(255,255,255,0.35)", fontWeight:700, letterSpacing:0.5 }}>{l}</div>
                <div style={{ fontSize:12, fontWeight:800, color:"#fff" }}>{v} <span style={{ fontSize:9, color:sc }}>{s}</span></div>
              </div>
            </div>
          ))}
        </div>
      </div>
    );
  }
  if (slide.type === "workout") {
    return (
      <div className="s3-glass" style={{ height:268, padding:"20px 18px", display:"flex", flexDirection:"column", justifyContent:"space-between", position:"relative", overflow:"hidden", borderColor:"rgba(46,212,191,0.2)", background:"rgba(46,212,191,0.04)" }}>
        <div style={{ position:"absolute", top:8, right:10, opacity:0.75 }}>
          <svg width="130" height="130" viewBox="0 0 100 100">
            <circle cx="68" cy="20" r="8" fill="#2ED4BF" style={{filter:"drop-shadow(0 0 12px #2ED4BF)"}}/>
            <path d="M50 35 L66 32 L78 48 L90 42" stroke="#2ED4BF" strokeWidth="4" strokeLinecap="round" strokeLinejoin="round" fill="none"/>
            <path d="M50 35 L42 54 L25 60 L14 55" stroke="#2ED4BF" strokeWidth="4" strokeLinecap="round" strokeLinejoin="round" fill="none"/>
            <path d="M42 54 L52 70 L58 92" stroke="#D7FF3E" strokeWidth="4" strokeLinecap="round" strokeLinejoin="round" fill="none"/>
            <path d="M52 70 L35 78 L22 88" stroke="#D7FF3E" strokeWidth="4" strokeLinecap="round" strokeLinejoin="round" fill="none"/>
          </svg>
        </div>
        <span style={{ background:"rgba(46,212,191,0.12)", color:"#2ED4BF", border:"1px solid rgba(46,212,191,0.25)", borderRadius:999, padding:"4px 12px", fontSize:11, fontWeight:800, letterSpacing:0.8, display:"inline-flex", alignItems:"center", gap:6, alignSelf:"flex-start", boxShadow:"0 0 14px rgba(46,212,191,0.15)" }}>⚡ STOKE PERFORMANCE</span>
        <div style={{ background:"rgba(10,13,20,0.85)", backdropFilter:"blur(20px)", border:"1px solid rgba(255,255,255,0.09)", borderRadius:18, padding:"14px 16px", boxShadow:"0 12px 40px rgba(0,0,0,0.6), inset 0 1px 0 rgba(255,255,255,0.05)" }}>
          <div style={{ display:"flex", justifyContent:"space-between", alignItems:"center", marginBottom:10 }}>
            <div>
              <div style={{ fontSize:13, fontWeight:800, color:"#fff", letterSpacing:-0.2 }}>Protein <span style={{ fontSize:11, color:"rgba(255,255,255,0.38)", fontWeight:500 }}>· 7 days</span></div>
              <div style={{ fontSize:11, color:"#2ED4BF", fontWeight:700, marginTop:2 }}>Avg 162g · Target Met</div>
            </div>
            <div style={{ background:"rgba(215,255,62,0.12)", color:"#D7FF3E", fontSize:10, fontWeight:900, padding:"3px 8px", borderRadius:6, letterSpacing:0.5 }}>🔥 7-DAY</div>
          </div>
          <div style={{ display:"flex", alignItems:"flex-end", justifyContent:"space-between", height:50, gap:6, padding:"0 2px" }}>
            {[{h:42},{h:48},{h:36},{h:54},{h:46},{h:58},{h:52}].map((col,idx)=>(
              <div key={idx} style={{ flex:1, display:"flex", flexDirection:"column", alignItems:"center", gap:4 }}>
                <div style={{ width:"100%", height:col.h*0.86, background:col.h>=45?"linear-gradient(180deg,#D7FF3E,#2ED4BF)":"rgba(255,255,255,0.12)", borderRadius:4, boxShadow:col.h>=45?"0 0 10px rgba(215,255,62,0.35)":"none" }} />
                <span style={{ fontSize:9, color:"rgba(255,255,255,0.35)", fontWeight:700 }}>{["M","T","W","T","F","S","S"][idx]}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    );
  }
  return (
    <div className="s3-glass" style={{ height:268, padding:"20px 18px", display:"flex", flexDirection:"column", justifyContent:"space-between", position:"relative", overflow:"hidden", borderColor:"rgba(255,138,61,0.2)", background:"rgba(255,138,61,0.03)" }}>
      <div style={{ position:"absolute", top:8, right:12, opacity:0.85 }}>
        <svg width="120" height="120" viewBox="0 0 100 100">
          <circle cx="50" cy="50" r="42" fill="#131720" stroke="rgba(255,138,61,0.25)" strokeWidth="3"/>
          <path d="M20 50 Q50 88 80 50 Z" fill="rgba(255,138,61,0.2)" stroke="#FF8A3D" strokeWidth="2.5"/>
          <path d="M30 38 C30 30 44 26 44 38 C44 48 30 48 30 38 Z" fill="#2ED4BF" opacity="0.85"/>
          <circle cx="37" cy="40" r="4.5" fill="#D7FF3E"/>
          <ellipse cx="62" cy="35" rx="8" ry="4.5" fill="#FF8A3D" transform="rotate(-25 62 35)"/>
          <ellipse cx="68" cy="43" rx="7" ry="4" fill="#FF8A3D" transform="rotate(-15 68 43)"/>
          <circle cx="50" cy="48" r="2.5" fill="#D7FF3E"/>
          <circle cx="56" cy="52" r="2" fill="#D7FF3E"/>
          <circle cx="44" cy="53" r="2" fill="#2ED4BF"/>
        </svg>
      </div>
      <span style={{ background:"rgba(255,138,61,0.12)", color:"#FF8A3D", border:"1px solid rgba(255,138,61,0.25)", borderRadius:999, padding:"4px 12px", fontSize:11, fontWeight:800, letterSpacing:0.8, display:"inline-flex", alignItems:"center", gap:6, alignSelf:"flex-start" }}>🥗 MINDFUL FUEL</span>
      <div style={{ background:"rgba(10,13,20,0.85)", backdropFilter:"blur(20px)", border:"1px solid rgba(255,255,255,0.09)", borderRadius:18, padding:"14px 16px", boxShadow:"0 12px 40px rgba(0,0,0,0.6), inset 0 1px 0 rgba(255,255,255,0.05)" }}>
        <div style={{ fontSize:12, fontWeight:700, color:"rgba(255,255,255,0.5)", marginBottom:10, letterSpacing:0.5, textTransform:"uppercase", fontSize:11 }}>Target Macros</div>
        <div style={{ display:"flex", gap:8 }}>
          {[["Protein","32%","145g","#D7FF3E","rgba(215,255,62,0.1)"],["Fat","20%","52g","#2ED4BF","rgba(46,212,191,0.1)"],["Carbs","48%","220g","#FF8A3D","rgba(255,138,61,0.1)"]].map(([l,p,g,c,bg],i)=>(
            <div key={i} style={{ flex:1, background:bg, border:`1.5px solid ${c}`, borderRadius:12, padding:"10px 8px", textAlign:"center", boxShadow:`0 0 14px ${c}20` }}>
              <div style={{ fontSize:10, color:"rgba(255,255,255,0.5)", fontWeight:700, letterSpacing:0.5 }}>{l}</div>
              <div style={{ fontSize:17, fontWeight:900, color:c, marginTop:2 }}>{p}</div>
              <div style={{ fontSize:10, color:"#fff", fontWeight:700 }}>{g}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  );
}

function WelcomeCarousel({ onSignUp, onLogIn }) {
  useEffect(() => { injectAuthStylesV3(); }, []);
  const [idx, setIdx] = useState(0);
  useEffect(() => {
    const t = setInterval(() => setIdx(i => (i + 1) % WELCOME_SLIDES.length), 4000);
    return () => clearInterval(t);
  }, []);
  const slide = WELCOME_SLIDES[idx];

  return (
    <div style={{ position:"relative", minHeight:"100vh", fontFamily:"'Space Grotesk', ui-sans-serif, system-ui, sans-serif", display:"flex", flexDirection:"column", overflow:"hidden" }}>
      <NeuBackground accent={slide.accent} />
      <div style={{ position:"relative", zIndex:1, maxWidth:390, width:"100%", margin:"0 auto", display:"flex", flexDirection:"column", flex:1, justifyContent:"space-between", padding:"28px 22px 32px" }}>

        {/* Swiss brand header */}
        <div style={{ textAlign:"center", animation:"fadeUp3 0.5s ease-out both" }}>
          <div style={{ fontSize:10, color:"rgba(255,255,255,0.35)", fontWeight:800, letterSpacing:4, textTransform:"uppercase", marginBottom:8 }}>Welcome to</div>
          <div style={{ fontSize:42, fontWeight:900, letterSpacing:-2, background:"linear-gradient(90deg,#D7FF3E 0%,#fff 65%)", WebkitBackgroundClip:"text", backgroundClip:"text", color:"transparent", display:"inline-block", lineHeight:1 }}>stoke⚡</div>
        </div>

        {/* Feature card — click to cycle */}
        <div onClick={() => setIdx(i => (i + 1) % WELCOME_SLIDES.length)} style={{ cursor:"pointer", animation:"fadeUp3 0.5s ease-out 0.08s both" }}>
          <WelcomeSlideVisual slide={slide} />
        </div>

        {/* Swiss copy */}
        <div style={{ textAlign:"center", padding:"14px 8px 8px", animation:"fadeUp3 0.5s ease-out 0.15s both" }}>
          <h2 style={{ fontSize:22, fontWeight:800, color:"#fff", margin:"0 0 8px", lineHeight:1.3, letterSpacing:-0.5 }}>{slide.quote}</h2>
          <p style={{ fontSize:13, color:"rgba(255,255,255,0.42)", margin:0, fontWeight:500, letterSpacing:0.1 }}>{slide.sub}</p>
        </div>

        {/* Pill dots */}
        <div style={{ display:"flex", justifyContent:"center", gap:8, margin:"6px 0 16px" }}>
          {WELCOME_SLIDES.map((_,i) => (
            <span key={i} onClick={() => setIdx(i)} style={{ width:i===idx?26:7, height:7, borderRadius:4, background:i===idx?slide.accent:"rgba(255,255,255,0.18)", cursor:"pointer", transition:"all 0.35s ease", boxShadow:i===idx?`0 0 14px ${slide.accent}`:"none", display:"inline-block" }} />
          ))}
        </div>

        {/* CTA buttons */}
        <div style={{ display:"flex", flexDirection:"column", gap:11, animation:"fadeUp3 0.5s ease-out 0.2s both" }}>
          <button className="s3-primary-btn mat-ripple" onClick={e => { addRipple(e); onSignUp(); }}>
            Get Started — It's Free
          </button>
          <button onClick={onLogIn} style={{ width:"100%", background:"transparent", border:"none", color:"rgba(255,255,255,0.55)", fontWeight:700, fontSize:14, padding:"10px 0 4px", cursor:"pointer", fontFamily:"inherit", letterSpacing:0.2, transition:"color 0.15s" }}
            onMouseEnter={e => e.currentTarget.style.color = "#D7FF3E"}
            onMouseLeave={e => e.currentTarget.style.color = "rgba(255,255,255,0.55)"}>
            Already have an account? <span style={{ color:"#D7FF3E", fontWeight:900 }}>Log In</span>
          </button>
          <div style={{ textAlign:"center", fontSize:10, color:"rgba(255,255,255,0.18)", letterSpacing:1, textTransform:"uppercase" }}>Version 26.37 · STOKE Inc.</div>
        </div>
      </div>
    </div>
  );
}

// ══════════════════════════════════════════════════════════════════════
//  AUTH SCREEN — all sub-views + 14-step questionnaire
// ══════════════════════════════════════════════════════════════════════
function AuthScreen({ onSignIn, initialMode = "signin" }) {
  useEffect(() => { injectAuthStylesV3(); }, []);

  const [view, setView] = useState(initialMode === "signin" ? "signin" : "welcome_choice");
  const [phone, setPhone] = useState("");
  const [password, setPassword] = useState("");
  const [showPw, setShowPw] = useState(false);
  const [error, setError] = useState("");
  const [loading, setLoading] = useState(false);

  const GOOGLE_ACCOUNTS = [
    { name:"Mohd Numan",    email:"mohdnuman925@gmail.com",   avatar:"M", color:"#1E8E3E" },
    { name:"Mohd Numan",    email:"mohdnuman701@gmail.com",   avatar:"M", color:"#D93025" },
    { name:"Mohd Numan",    email:"2210560090@klh.edu.in",    avatar:"N", color:"#E37400" },
    { name:"Mohammed numan",email:"2210560148@klh.edu.in",    avatar:"M", color:"#1A73E8" },
  ];
  const [selGoogle, setSelGoogle] = useState(GOOGLE_ACCOUNTS[1]);
  const [customEmail, setCustomEmail] = useState("");
  const [showCustom, setShowCustom] = useState(false);
  const [gLoading, setGLoading] = useState(false);

  // Questionnaire
  const [qStep, setQStep] = useState(1);
  const [pName, setPName] = useState("Mohd");
  const [pGoals, setPGoals] = useState(["Modify My Diet"]);
  const [pHabits, setPHabits] = useState(["Eat more protein", "Track calories", "Drink more water"]);
  const [pMealFreq, setPMealFreq] = useState("Always");
  const [pHelpMeal, setPHelpMeal] = useState("Yes, definitely");
  const [pActivity, setPActivity] = useState("very");
  const [pSex, setPSex] = useState("male");
  const [pAge, setPAge] = useState("21");
  const [pCountry, setPCountry] = useState("India");
  const [pZip, setPZip] = useState("");
  const [pHeight, setPHeight] = useState("167");
  const [pWeight, setPWeight] = useState("70");
  const [pTerms, setPTerms] = useState(true);
  const [pReminders, setPReminders] = useState(true);
  const [pSteps, setPSteps] = useState(true);
  const [pEmails, setPEmails] = useState(true);

  const LIME = "#D7FF3E";
  const totalQSteps = 14;

  const calcCal = (() => {
    const w=parseFloat(pWeight)||70, h=parseFloat(pHeight)||167, a=parseInt(pAge)||21;
    const bmr = pSex==="female" ? 10*w+6.25*h-5*a-161 : 10*w+6.25*h-5*a+5;
    const act = pActivity==="very"?1.725:pActivity==="active"?1.55:1.375;
    const isGain = pGoals.includes("Gain Muscle")||pGoals.includes("Gain Weight");
    const isLoss = pGoals.includes("Lose Weight");
    const t = Math.round(bmr*act+(isGain?400:isLoss?-400:0));
    return t>1500?t:2450;
  })();

  function doManualLogin() {
    if (!phone.trim()||!password.trim()) { setError("Enter your email/phone and password."); return; }
    setError(""); setLoading(true);
    setTimeout(() => {
      setLoading(false);
      onSignIn(phone, { name:phone.includes("@")?phone.split("@")[0]:"Athlete", weightKg:70, heightCm:175, age:25, sex:"male", goalType:"maintain", activity:1.55 });
    }, 950);
  }
  function selectGoogle(acc) { setSelGoogle(acc); setPName(acc.name.split(" ")[0]); setView("google_confirm"); }
  function confirmGoogle() { setGLoading(true); setTimeout(() => { setGLoading(false); setQStep(1); setView("questionnaire"); }, 850); }
  function finishOnboarding() {
    onSignIn(selGoogle ? selGoogle.email : (phone||"athlete@stoke.app"), {
      name:pName.trim()||"Mohd", age:parseInt(pAge)||21, weightKg:parseFloat(pWeight)||70, heightCm:parseFloat(pHeight)||167, sex:pSex,
      goalType:pGoals.includes("Lose Weight")?"cut":(pGoals.includes("Gain Muscle")||pGoals.includes("Gain Weight"))?"gain":"maintain",
      activity:pActivity==="very"?1.725:pActivity==="active"?1.55:pActivity==="lightly"?1.375:1.2
    });
  }

  const catLabel = qStep===1?"Welcome":qStep<=9?"Goals":qStep<=11?"About You":qStep===12?"Create Account":"Account Created";

  /* ─────────────────────────── SIGN IN ─────────────────────────────── */
  if (view === "signin") {
    return (
      <div style={{ position:"relative", minHeight:"100vh", fontFamily:"'Space Grotesk', ui-sans-serif, system-ui, sans-serif", display:"flex", flexDirection:"column", overflow:"hidden" }}>
        <NeuBackground accent={LIME} />
        <div style={{ position:"relative", zIndex:1, flex:1, display:"flex", flexDirection:"column", justifyContent:"center", padding:"32px 22px 48px" }}>
          <div style={{ maxWidth:390, width:"100%", margin:"0 auto" }}>

            {/* Swiss: Brand header with tight grid */}
            <div style={{ textAlign:"center", marginBottom:32, animation:"fadeUp3 0.5s ease-out both" }}>
              <div style={{ display:"flex", justifyContent:"center", marginBottom:16 }}>
                <NeuLogo size={60} />
              </div>
              {/* Swiss rule lines for visual weight */}
              <div style={{ display:"flex", alignItems:"center", gap:12, margin:"0 auto 14px", maxWidth:240 }}>
                <div style={{ flex:1, height:1, background:"rgba(215,255,62,0.3)" }} />
                <span style={{ fontSize:9, color:"rgba(215,255,62,0.7)", fontWeight:800, letterSpacing:3, textTransform:"uppercase" }}>stoke</span>
                <div style={{ flex:1, height:1, background:"rgba(215,255,62,0.3)" }} />
              </div>
              <h1 style={{ fontSize:28, fontWeight:900, color:"#fff", margin:"0 0 6px", letterSpacing:-0.8 }}>Welcome Back</h1>
              <p style={{ fontSize:14, color:"rgba(255,255,255,0.4)", margin:0, fontWeight:500, letterSpacing:0.1 }}>Log in to access your workouts & nutrition</p>
            </div>

            {/* Soft UI + Material glass card */}
            <div className="s3-glass" style={{ padding:"28px 24px 24px", marginBottom:20, animation:"fadeUp3 0.55s ease-out 0.1s both" }}>

              {/* Material: Google button with elevation */}
              <button className="s3-google-btn mat-ripple" onClick={e => { addRipple(e); setView("google_picker"); }} style={{ marginBottom:16 }}>
                <GIcon /> Continue with Google
              </button>

              <OrDivider3 />

              <div style={{ display:"flex", flexDirection:"column", gap:12, margin:"14px 0 12px" }}>
                <NeuInput label="Email or phone" value={phone} onChange={e => { setPhone(e.target.value); setError(""); }} />
                <NeuInput label="Password" type={showPw?"text":"password"} value={password} onChange={e => { setPassword(e.target.value); setError(""); }} onKeyDown={e => e.key==="Enter"&&doManualLogin()}
                  extraRight={
                    <button onClick={() => setShowPw(p=>!p)} style={{ position:"absolute", right:14, top:"50%", transform:"translateY(-50%)", background:"none", border:"none", color:"rgba(255,255,255,0.35)", cursor:"pointer", fontSize:17, padding:0, lineHeight:1, zIndex:2 }}>
                      {showPw ? "🙈" : "👁️"}
                    </button>
                  }
                />
              </div>

              {/* Material: Forgot password — right-aligned Swiss */}
              <div style={{ textAlign:"right", marginBottom:14 }}>
                <span style={{ fontSize:12, color:"rgba(215,255,62,0.7)", fontWeight:700, cursor:"pointer", letterSpacing:0.2 }}>Forgot password?</span>
              </div>

              {error && (
                <div style={{ background:"rgba(255,60,60,0.09)", border:"1px solid rgba(255,80,80,0.28)", borderRadius:12, padding:"11px 14px", fontSize:13, color:"#FF7070", fontWeight:600, marginBottom:14, boxShadow:"0 0 14px rgba(255,60,60,0.1)", display:"flex", alignItems:"center", gap:8 }}>
                  <span style={{ fontSize:16 }}>⚠️</span> {error}
                </div>
              )}

              <button className="s3-primary-btn mat-ripple" onClick={e => { addRipple(e); doManualLogin(); }} disabled={loading}>
                {loading ? <span style={{ display:"flex", alignItems:"center", justifyContent:"center", gap:8 }}><NeuSpinner /> Signing in…</span> : "Log In"}
              </button>
            </div>

            <div style={{ textAlign:"center", fontSize:14, color:"rgba(255,255,255,0.4)", animation:"fadeUp3 0.55s ease-out 0.18s both" }}>
              New here? <span onClick={() => setView("welcome_choice")} style={{ color:LIME, fontWeight:900, cursor:"pointer" }}>Create account →</span>
            </div>
          </div>
        </div>
      </div>
    );
  }

  /* ─────────────────────────── SIGN UP CHOICE ─────────────────────── */
  if (view === "welcome_choice") {
    return (
      <div style={{ position:"relative", minHeight:"100vh", fontFamily:"'Space Grotesk', ui-sans-serif, system-ui, sans-serif", display:"flex", flexDirection:"column", overflow:"hidden" }}>
        <NeuBackground accent={LIME} />
        <div style={{ position:"relative", zIndex:1, flex:1, display:"flex", flexDirection:"column", padding:"20px 22px 36px" }}>
          <div style={{ maxWidth:390, width:"100%", margin:"0 auto", display:"flex", flexDirection:"column", flex:1 }}>
            <div style={{ display:"flex", alignItems:"center", height:50 }}>
              <button className="s3-back-btn" onClick={() => setView("signin")}>←</button>
            </div>
            <div style={{ margin:"24px 0 auto", animation:"fadeUp3 0.5s ease-out both" }}>
              {/* Swiss: category label */}
              <div style={{ display:"inline-flex", alignItems:"center", gap:8, background:"rgba(215,255,62,0.08)", border:"1px solid rgba(215,255,62,0.2)", borderRadius:999, padding:"5px 14px", marginBottom:20, boxShadow:"0 0 16px rgba(215,255,62,0.08)" }}>
                <span style={{ fontSize:11 }}>⚡</span>
                <span style={{ fontSize:11, fontWeight:900, color:LIME, letterSpacing:2, textTransform:"uppercase" }}>Join Stoke</span>
              </div>
              <h1 style={{ fontSize:29, fontWeight:900, color:"#fff", lineHeight:1.2, letterSpacing:-0.8, margin:"0 0 12px" }}>Customize STOKE for your goals.</h1>
              <p style={{ fontSize:14, color:"rgba(255,255,255,0.42)", margin:0, lineHeight:1.55, letterSpacing:0.1 }}>Personalized workouts, nutrition, and daily targets built for your body.</p>
            </div>
            <div style={{ display:"flex", flexDirection:"column", gap:12, animation:"fadeUp3 0.5s ease-out 0.12s both" }}>
              <button className="s3-primary-btn mat-ripple" onClick={e => { addRipple(e); setQStep(1); setView("questionnaire"); }}>Get Started</button>
              <OrDivider3 />
              <button className="s3-google-btn mat-ripple" onClick={e => { addRipple(e); setView("google_picker"); }}><GIcon /> Continue with Google</button>
              <button className="s3-ghost-btn mat-ripple" onClick={e => { addRipple(e); setPName("Apple User"); setQStep(1); setView("questionnaire"); }}>
                <svg width="18" height="18" viewBox="0 0 170 170" fill="#fff"><path d="M150.37 130.25c-2.45 5.66-5.35 10.87-8.71 15.66-4.58 6.53-8.33 11.05-11.22 13.56-4.48 4.12-9.28 6.23-14.42 6.35-3.69 0-8.14-1.05-13.32-3.18-5.19-2.12-9.97-3.17-14.34-3.17-4.58 0-9.49 1.05-14.75 3.17-5.26 2.13-9.5 3.24-12.74 3.35-4.35.13-9.16-1.9-14.42-6.08-3.69-3.04-7.67-7.81-11.96-14.31-7.06-10.66-12.19-22.65-15.39-35.97-3.2-13.32-4.8-25.75-4.8-37.28 0-14.45 3.65-26.68 10.95-36.68 7.3-10.01 16.59-15.11 27.87-15.32 4.9 0 10.33 1.25 16.3 3.75 5.97 2.5 10.04 3.79 12.21 3.86 1.85 0 6.04-1.34 12.57-4.03 6.53-2.69 11.96-3.87 16.3-3.54 12.27.98 22.06 5.56 29.37 13.73-10.77 6.53-16.05 15.68-15.83 27.46.22 9.14 3.69 16.88 10.42 23.23 6.73 6.35 14.88 10.04 24.45 11.07-2.07 6.31-4.63 12.8-7.69 19.46zM119.22 33.15c0-7.39 2.62-14.28 7.86-20.67 5.24-6.39 11.83-10.59 19.77-12.6-1.09 7.72-3.89 14.73-8.4 21.03-4.51 6.3-10.94 10.49-19.23 12.24z"/></svg>
                Continue with Apple
              </button>
            </div>
            <p style={{ fontSize:11, color:"rgba(255,255,255,0.25)", lineHeight:1.6, textAlign:"center", margin:"20px 0 0", letterSpacing:0.1 }}>
              We collect info to personalise your STOKE experience. See our <span style={{ color:LIME }}>Privacy Policy</span>.
            </p>
          </div>
        </div>
      </div>
    );
  }

  /* ─────────────────────────── GOOGLE PICKER ──────────────────────── */
  if (view === "google_picker") {
    return (
      <div style={{ background:"#1C1C1E", minHeight:"100vh", fontFamily:"-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif", display:"flex", flexDirection:"column" }}>
        <div style={{ background:"#2C2C2E", padding:"10px 16px", display:"flex", alignItems:"center", justifyContent:"space-between", borderBottom:"1px solid rgba(255,255,255,0.07)", boxShadow:"0 1px 4px rgba(0,0,0,0.4)" }}>
          <button onClick={() => setView("welcome_choice")} style={{ background:"rgba(255,255,255,0.08)", border:"none", color:"#fff", width:32, height:32, borderRadius:"50%", cursor:"pointer", fontSize:17, display:"flex", alignItems:"center", justifyContent:"center" }}>✕</button>
          <div style={{ fontSize:12, color:"rgba(255,255,255,0.65)", display:"flex", alignItems:"center", gap:5 }}>🔒 accounts.google.com</div>
          <span style={{ color:"#666", fontSize:16, cursor:"pointer" }}>⋮</span>
        </div>
        <div style={{ maxWidth:420, width:"100%", margin:"0 auto", padding:"32px 24px", flex:1, display:"flex", flexDirection:"column" }}>
          <div style={{ display:"flex", alignItems:"center", gap:9, marginBottom:24 }}><GIcon size={22}/><span style={{ fontSize:13, color:"#aaa" }}>Sign in with Google</span></div>
          <div style={{ width:44, height:44, borderRadius:11, background:"#D7FF3E", display:"flex", alignItems:"center", justifyContent:"center", fontSize:22, fontWeight:900, color:"#000", marginBottom:16, boxShadow:"0 4px 20px rgba(215,255,62,0.4)" }}>⚡</div>
          <h2 style={{ fontSize:22, fontWeight:700, color:"#fff", margin:"0 0 6px" }}>Choose an account</h2>
          <p style={{ fontSize:14, color:"#aaa", margin:"0 0 24px" }}>to continue to <strong style={{ color:"#fff" }}>STOKE</strong></p>
          <div style={{ display:"flex", flexDirection:"column", gap:2 }}>
            {GOOGLE_ACCOUNTS.map((acc,i) => (
              <div key={i} onClick={() => selectGoogle(acc)} style={{ display:"flex", alignItems:"center", gap:14, padding:"13px 10px", borderRadius:10, cursor:"pointer", borderBottom:"1px solid rgba(255,255,255,0.05)", transition:"background 0.15s ease" }}
                onMouseEnter={e => e.currentTarget.style.background="rgba(255,255,255,0.06)"}
                onMouseLeave={e => e.currentTarget.style.background="transparent"}>
                <div style={{ width:40, height:40, borderRadius:"50%", background:acc.color, color:"#fff", display:"flex", alignItems:"center", justifyContent:"center", fontSize:15, fontWeight:700 }}>{acc.avatar}</div>
                <div style={{ flex:1 }}>
                  <div style={{ fontSize:14, fontWeight:600, color:"#fff" }}>{acc.name}</div>
                  <div style={{ fontSize:12, color:"#888" }}>{acc.email}</div>
                </div>
                <span style={{ color:"#555", fontSize:16 }}>›</span>
              </div>
            ))}
            {!showCustom ? (
              <div onClick={() => setShowCustom(true)} style={{ display:"flex", alignItems:"center", gap:14, padding:"13px 10px", cursor:"pointer", borderRadius:10, transition:"background 0.15s ease" }}
                onMouseEnter={e => e.currentTarget.style.background="rgba(255,255,255,0.06)"}
                onMouseLeave={e => e.currentTarget.style.background="transparent"}>
                <div style={{ width:40, height:40, borderRadius:"50%", background:"rgba(255,255,255,0.1)", color:"#fff", display:"flex", alignItems:"center", justifyContent:"center", fontSize:18 }}>+</div>
                <span style={{ fontSize:14, color:"#fff", fontWeight:600 }}>Use another account</span>
              </div>
            ) : (
              <div style={{ padding:"14px 10px" }}>
                <input autoFocus type="email" value={customEmail} onChange={e => setCustomEmail(e.target.value)} placeholder="Enter email"
                  style={{ width:"100%", background:"#2C2C2E", border:"1.5px solid #D7FF3E", borderRadius:10, padding:"10px 14px", color:"#fff", fontSize:14, outline:"none", boxSizing:"border-box", marginBottom:8, fontFamily:"inherit" }}/>
                <button onClick={() => { if(customEmail.includes("@")) selectGoogle({ name:customEmail.split("@")[0], email:customEmail, avatar:"U", color:"#5F6368" }); }}
                  style={{ background:"#D7FF3E", color:"#000", border:"none", borderRadius:8, padding:"9px 20px", fontWeight:800, fontSize:13, cursor:"pointer", fontFamily:"inherit" }}>Continue</button>
              </div>
            )}
          </div>
          <div style={{ marginTop:"auto", paddingTop:24, fontSize:11, color:"#555", lineHeight:1.5 }}>Before using this app, review STOKE's Privacy Policy and Terms of Service.</div>
        </div>
      </div>
    );
  }

  /* ─────────────────────────── GOOGLE CONFIRM ─────────────────────── */
  if (view === "google_confirm") {
    return (
      <div style={{ background:"#1C1C1E", minHeight:"100vh", fontFamily:"-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif", display:"flex", flexDirection:"column" }}>
        <div style={{ background:"#2C2C2E", padding:"10px 16px", display:"flex", alignItems:"center", justifyContent:"space-between", borderBottom:"1px solid rgba(255,255,255,0.07)" }}>
          <button onClick={() => setView("google_picker")} style={{ background:"rgba(255,255,255,0.08)", border:"none", color:"#fff", width:32, height:32, borderRadius:"50%", cursor:"pointer", fontSize:17, display:"flex", alignItems:"center", justifyContent:"center" }}>✕</button>
          <div style={{ fontSize:12, color:"rgba(255,255,255,0.65)" }}>🔒 accounts.google.com</div>
          <span style={{ color:"#666" }}>⋮</span>
        </div>
        <div style={{ maxWidth:420, width:"100%", margin:"0 auto", padding:"40px 24px", flex:1, display:"flex", flexDirection:"column" }}>
          <div style={{ width:44, height:44, borderRadius:11, background:"#D7FF3E", display:"flex", alignItems:"center", justifyContent:"center", fontSize:22, fontWeight:900, color:"#000", marginBottom:24, boxShadow:"0 4px 20px rgba(215,255,62,0.4)" }}>⚡</div>
          <h2 style={{ fontSize:22, fontWeight:700, color:"#fff", margin:"0 0 20px" }}>You're signing back in to STOKE</h2>
          <div style={{ display:"flex", alignItems:"center", gap:12, background:"rgba(255,255,255,0.06)", padding:"12px 16px", borderRadius:10, marginBottom:20, boxShadow:"inset 1px 1px 4px rgba(0,0,0,0.4)" }}>
            <div style={{ width:32, height:32, borderRadius:"50%", background:selGoogle.color, color:"#fff", display:"flex", alignItems:"center", justifyContent:"center", fontSize:13, fontWeight:700 }}>{selGoogle.avatar}</div>
            <span style={{ fontSize:14, color:"#fff", fontWeight:500 }}>{selGoogle.email}</span>
          </div>
          <p style={{ fontSize:12, color:"#888", lineHeight:1.6, marginBottom:32 }}>Review STOKE's privacy policy and Terms of Service to understand how your data will be protected.</p>
          <div style={{ display:"flex", gap:12, marginTop:"auto" }}>
            <button onClick={() => setView("google_picker")} style={{ flex:1, background:"transparent", border:"1px solid rgba(255,255,255,0.15)", borderRadius:999, padding:"13px 0", color:"#fff", fontSize:14, fontWeight:600, cursor:"pointer", fontFamily:"inherit" }}>Cancel</button>
            <button onClick={confirmGoogle} disabled={gLoading} style={{ flex:1, background:"#8ab4f8", border:"none", borderRadius:999, padding:"13px 0", color:"#1C1C1E", fontSize:14, fontWeight:700, cursor:"pointer", display:"flex", alignItems:"center", justifyContent:"center", gap:8, fontFamily:"inherit" }}>
              {gLoading ? <span style={{ width:16, height:16, borderRadius:"50%", border:"2.5px solid rgba(28,28,30,0.4)", borderTopColor:"#1C1C1E", display:"inline-block", animation:"spin3 0.7s linear infinite" }}/> : null}
              {gLoading ? "Signing in…" : "Continue"}
            </button>
          </div>
        </div>
      </div>
    );
  }

  /* ─────────────────────────── QUESTIONNAIRE ─────────────────────── */
  return (
    <div style={{ position:"relative", minHeight:"100vh", fontFamily:"'Space Grotesk', ui-sans-serif, system-ui, sans-serif", display:"flex", flexDirection:"column", overflow:"hidden" }}>
      <NeuBackground accent={LIME} />
      <div style={{ position:"relative", zIndex:1, flex:1, display:"flex", flexDirection:"column", padding:"16px 22px 32px" }}>
        <div style={{ maxWidth:410, width:"100%", margin:"0 auto", display:"flex", flexDirection:"column", flex:1 }}>

          {/* Swiss + Neumorphic progress bar */}
          <div className="s3-progress-bar">
            {Array.from({ length:totalQSteps }).map((_,i) => (
              <div key={i} className={`s3-progress-seg${i+1<=qStep?" done":""}`} />
            ))}
          </div>

          {/* Swiss header row */}
          <div style={{ display:"flex", alignItems:"center", justifyContent:"space-between", height:42, marginBottom:20 }}>
            <button className="s3-back-btn" onClick={() => { if(qStep===1) setView("welcome_choice"); else setQStep(s=>s-1); }}>←</button>
            <span style={{ fontSize:11, fontWeight:900, color:"rgba(255,255,255,0.38)", letterSpacing:2, textTransform:"uppercase" }}>{catLabel} · {qStep}/{totalQSteps}</span>
            <div style={{ width:38 }} />
          </div>

          {/* ── STEP 1: Name ── */}
          {qStep===1&&(
            <div style={{ display:"flex", flexDirection:"column", flex:1, animation:"slideRight3 0.4s ease-out both" }}>
              <h1 style={{ fontSize:26, fontWeight:900, color:"#fff", lineHeight:1.25, margin:"0 0 8px", letterSpacing:-0.5 }}>First, what can we call you?</h1>
              <p style={{ fontSize:14, color:"rgba(255,255,255,0.42)", margin:"0 0 30px" }}>We'd love to get to know you.</p>
              <NeuInput label="Preferred first name" value={pName} onChange={e=>setPName(e.target.value)} onKeyDown={e=>e.key==="Enter"&&setQStep(2)} />
              <div style={{ marginTop:"auto", paddingTop:28 }}>
                <button className="s3-primary-btn mat-ripple" onClick={e=>{addRipple(e);setQStep(2);}}>Next →</button>
              </div>
            </div>
          )}

          {/* ── STEP 2: Goals ── */}
          {qStep===2&&(
            <div style={{ display:"flex", flexDirection:"column", flex:1, animation:"slideRight3 0.4s ease-out both" }}>
              <h1 style={{ fontSize:24, fontWeight:900, color:"#fff", lineHeight:1.25, margin:"0 0 6px", letterSpacing:-0.5 }}>Hey {pName||"there"} 👋 Let's talk goals.</h1>
              <p style={{ fontSize:13, color:"rgba(255,255,255,0.42)", margin:"0 0 18px" }}>Select up to 3 that matter most.</p>
              <div style={{ display:"flex", flexDirection:"column", gap:8, marginBottom:20, overflowY:"auto" }}>
                {["Lose Weight","Maintain Weight","Gain Weight","Gain Muscle","Modify My Diet","Plan Meals","Manage Stress","Stay Active"].map(g=>{
                  const checked=pGoals.includes(g);
                  return (
                    <div key={g} className={`s3-option${checked?" selected":""}`} onClick={()=>{ if(checked) setPGoals(pGoals.filter(x=>x!==g)); else if(pGoals.length<3) setPGoals([...pGoals,g]); }}>
                      <span style={{ fontSize:14, fontWeight:700, color:"#fff" }}>{g}</span>
                      <NeuCheckbox checked={checked} />
                    </div>
                  );
                })}
              </div>
              <button className="s3-primary-btn mat-ripple" onClick={e=>{addRipple(e);setQStep(3);}}>Next →</button>
            </div>
          )}

          {/* ── STEP 3: Encouragement ── */}
          {qStep===3&&(
            <div style={{ display:"flex", flexDirection:"column", flex:1, justifyContent:"space-between", animation:"slideRight3 0.4s ease-out both" }}>
              <div className="s3-intermission" style={{ background:"linear-gradient(145deg, rgba(96,165,250,0.1) 0%, rgba(11,14,20,0.9) 100%)", border:"1px solid rgba(96,165,250,0.2)", margin:"auto 0" }}>
                <div style={{ fontSize:56, marginBottom:20 }}>🚀</div>
                <div style={{ width:40, height:2, background:"rgba(215,255,62,0.6)", margin:"0 auto 16px", borderRadius:1 }} />
                <h1 style={{ fontSize:25, fontWeight:900, color:"#fff", lineHeight:1.3, margin:"0 0 14px", letterSpacing:-0.4 }}>You've taken a big step on your journey.</h1>
                <p style={{ fontSize:14, color:"rgba(255,255,255,0.58)", lineHeight:1.65, margin:0 }}>Tracking your food and workouts builds awareness and prompts you to be mindful of every choice.</p>
              </div>
              <button className="s3-primary-btn mat-ripple" onClick={e=>{addRipple(e);setQStep(4);}}>Next →</button>
            </div>
          )}

          {/* ── STEP 4: Habits ── */}
          {qStep===4&&(
            <div style={{ display:"flex", flexDirection:"column", flex:1, animation:"slideRight3 0.4s ease-out both" }}>
              <h1 style={{ fontSize:24, fontWeight:900, color:"#fff", lineHeight:1.25, margin:"0 0 18px", letterSpacing:-0.5 }}>Which healthy habits matter to you?</h1>
              <div style={{ overflowY:"auto", flex:1 }}>
                <div style={{ fontSize:11, color:"rgba(255,255,255,0.35)", fontWeight:900, marginBottom:10, textTransform:"uppercase", letterSpacing:2 }}>Recommended</div>
                <div style={{ display:"flex", flexWrap:"wrap", gap:8, marginBottom:18 }}>
                  {["Plan more meals","Meal prep and cook","Eat more fiber","Eat a balanced diet","Track nutrients"].map(h=>{const sel=pHabits.includes(h);return(<button key={h} className={`s3-chip${sel?" sel":""}`} onClick={()=>setPHabits(sel?pHabits.filter(x=>x!==h):[...pHabits,h])}>{h}</button>);})}
                </div>
                <div style={{ fontSize:11, color:"rgba(255,255,255,0.35)", fontWeight:900, marginBottom:10, textTransform:"uppercase", letterSpacing:2 }}>More habits</div>
                <div style={{ display:"flex", flexWrap:"wrap", gap:8 }}>
                  {["Track calories","Track macros","Eat mindfully","Eat whole foods","Eat more protein","Eat more vegetables","Eat more fruit","Drink more water","Prioritize sleep","Move more","Workout more"].map(h=>{const sel=pHabits.includes(h);return(<button key={h} className={`s3-chip${sel?" sel":""}`} onClick={()=>setPHabits(sel?pHabits.filter(x=>x!==h):[...pHabits,h])}>{h}</button>);})}
                </div>
              </div>
              <button className="s3-primary-btn mat-ripple" style={{ marginTop:20 }} onClick={e=>{addRipple(e);setQStep(5);}}>Next →</button>
            </div>
          )}

          {/* ── STEP 5: Guide ── */}
          {qStep===5&&(
            <div style={{ display:"flex", flexDirection:"column", flex:1, justifyContent:"space-between", animation:"slideRight3 0.4s ease-out both" }}>
              <div className="s3-intermission" style={{ background:"linear-gradient(145deg, rgba(46,212,191,0.09) 0%, rgba(9,12,18,0.92) 100%)", border:"1px solid rgba(46,212,191,0.2)", margin:"auto 0" }}>
                <div style={{ fontSize:56, marginBottom:20 }}>🧭</div>
                <div style={{ width:40, height:2, background:"#2ED4BF", margin:"0 auto 16px", borderRadius:1 }} />
                <div style={{ fontSize:11, color:"#2ED4BF", fontWeight:900, letterSpacing:2, textTransform:"uppercase", marginBottom:8 }}>No problem!</div>
                <h1 style={{ fontSize:25, fontWeight:900, color:"#fff", lineHeight:1.3, margin:"0 0 14px", letterSpacing:-0.4 }}>This is your journey — we'll guide you.</h1>
                <p style={{ fontSize:14, color:"rgba(255,255,255,0.58)", lineHeight:1.65, margin:0 }}>Get food insights, inspiration, and custom training plans tailored to your habits.</p>
              </div>
              <button className="s3-primary-btn mat-ripple" onClick={e=>{addRipple(e);setQStep(6);}}>Next →</button>
            </div>
          )}

          {/* ── STEP 6: Meal freq ── */}
          {qStep===6&&(
            <div style={{ display:"flex", flexDirection:"column", flex:1, animation:"slideRight3 0.4s ease-out both" }}>
              <h1 style={{ fontSize:24, fontWeight:900, color:"#fff", lineHeight:1.25, margin:"0 0 20px", letterSpacing:-0.5 }}>How often do you plan meals in advance?</h1>
              <div style={{ display:"flex", flexDirection:"column", gap:9, marginBottom:20 }}>
                {["Never","Rarely","Occasionally","Frequently","Always"].map(opt=>{const sel=pMealFreq===opt;return(
                  <div key={opt} className={`s3-option${sel?" selected":""}`} onClick={()=>setPMealFreq(opt)}>
                    <span style={{ fontSize:15, fontWeight:700, color:"#fff" }}>{opt}</span>
                    <NeuRadio checked={sel} />
                  </div>
                );})}
              </div>
              <button className="s3-primary-btn mat-ripple" onClick={e=>{addRipple(e);setQStep(7);}}>Next →</button>
            </div>
          )}

          {/* ── STEP 7: Maven ── */}
          {qStep===7&&(
            <div style={{ display:"flex", flexDirection:"column", flex:1, justifyContent:"space-between", animation:"slideRight3 0.4s ease-out both" }}>
              <div className="s3-intermission" style={{ background:"linear-gradient(145deg, rgba(255,138,61,0.1) 0%, rgba(10,13,20,0.92) 100%)", border:"1px solid rgba(255,138,61,0.2)", margin:"auto 0" }}>
                <div style={{ fontSize:56, marginBottom:20 }}>🔥</div>
                <div style={{ width:40, height:2, background:"#FF8A3D", margin:"0 auto 16px", borderRadius:1 }} />
                <div style={{ fontSize:11, color:"#FF8A3D", fontWeight:900, letterSpacing:2, textTransform:"uppercase", marginBottom:8 }}>Amazing.</div>
                <h1 style={{ fontSize:25, fontWeight:900, color:"#fff", lineHeight:1.3, margin:"0 0 14px", letterSpacing:-0.4 }}>You're a meal-planning maven.</h1>
                <p style={{ fontSize:14, color:"rgba(255,255,255,0.58)", lineHeight:1.65, margin:0 }}>Our tools boost what you're already doing — flexibility, variety, and great taste.</p>
              </div>
              <button className="s3-primary-btn mat-ripple" onClick={e=>{addRipple(e);setQStep(8);}}>Next →</button>
            </div>
          )}

          {/* ── STEP 8: Meal plan ── */}
          {qStep===8&&(
            <div style={{ display:"flex", flexDirection:"column", flex:1, animation:"slideRight3 0.4s ease-out both" }}>
              <h1 style={{ fontSize:24, fontWeight:900, color:"#fff", lineHeight:1.25, margin:"0 0 6px", letterSpacing:-0.5 }}>Want us to build your weekly meal plans?</h1>
              <p style={{ fontSize:13, color:"rgba(255,255,255,0.42)", margin:"0 0 22px" }}>Tailored to your lifestyle and goals.</p>
              <div style={{ display:"flex", flexDirection:"column", gap:9, marginBottom:20 }}>
                {["Yes, definitely","Open to trying","No thanks"].map(opt=>{const sel=pHelpMeal===opt;return(
                  <div key={opt} className={`s3-option${sel?" selected":""}`} onClick={()=>setPHelpMeal(opt)}>
                    <span style={{ fontSize:15, fontWeight:700, color:"#fff" }}>{opt}</span>
                    <NeuRadio checked={sel} />
                  </div>
                );})}
              </div>
              <button className="s3-primary-btn mat-ripple" onClick={e=>{addRipple(e);setQStep(9);}}>Next →</button>
            </div>
          )}

          {/* ── STEP 9: Activity ── */}
          {qStep===9&&(
            <div style={{ display:"flex", flexDirection:"column", flex:1, animation:"slideRight3 0.4s ease-out both" }}>
              <h1 style={{ fontSize:24, fontWeight:900, color:"#fff", lineHeight:1.25, margin:"0 0 6px", letterSpacing:-0.5 }}>What is your baseline activity level?</h1>
              <p style={{ fontSize:13, color:"rgba(255,255,255,0.42)", margin:"0 0 22px" }}>Not including workouts — counted separately.</p>
              <div style={{ display:"flex", flexDirection:"column", gap:9, marginBottom:20 }}>
                {[{id:"not_very",t:"Not Very Active",d:"Spend most of the day sitting (e.g. desk job)"},{id:"lightly",t:"Lightly Active",d:"Spend a good part of the day on your feet"},{id:"active",t:"Active",d:"Spend most of the day doing physical activity"},{id:"very",t:"Very Active",d:"Spend most of the day doing heavy activity"}].map(opt=>{const sel=pActivity===opt.id;return(
                  <div key={opt.id} className={`s3-option${sel?" selected":""}`} style={{ flexDirection:"column", alignItems:"flex-start" }} onClick={()=>setPActivity(opt.id)}>
                    <div style={{ display:"flex", justifyContent:"space-between", width:"100%", alignItems:"center" }}>
                      <span style={{ fontSize:14, fontWeight:700, color:"#fff" }}>{opt.t}</span>
                      <NeuRadio checked={sel} />
                    </div>
                    <div style={{ fontSize:12, color:"rgba(255,255,255,0.38)", marginTop:4 }}>{opt.d}</div>
                  </div>
                );})}
              </div>
              <button className="s3-primary-btn mat-ripple" onClick={e=>{addRipple(e);setQStep(10);}}>Next →</button>
            </div>
          )}

          {/* ── STEP 10: About you ── */}
          {qStep===10&&(
            <div style={{ display:"flex", flexDirection:"column", flex:1, animation:"slideRight3 0.4s ease-out both" }}>
              <h1 style={{ fontSize:24, fontWeight:900, color:"#fff", lineHeight:1.25, margin:"0 0 6px", letterSpacing:-0.5 }}>Tell us about yourself</h1>
              <p style={{ fontSize:13, color:"rgba(255,255,255,0.42)", margin:"0 0 22px" }}>We'll use this to calculate your calorie needs:</p>
              {/* Swiss: Sex toggle pills */}
              <div style={{ display:"flex", gap:10, marginBottom:18 }}>
                {[{id:"male",l:"♂  Male"},{id:"female",l:"♀  Female"}].map(s=>(
                  <button key={s.id} className={`s3-pill${pSex===s.id?" sel":""}`} onClick={()=>setPSex(s.id)}>{s.l}</button>
                ))}
              </div>
              <div style={{ display:"flex", flexDirection:"column", gap:12, marginBottom:20 }}>
                <NeuInput label="Age (years)" type="number" value={pAge} onChange={e=>setPAge(e.target.value)} />
                <div className={`s3-field${pCountry?" filled":""}`}>
                  <select value={pCountry} onChange={e=>setPCountry(e.target.value)}>
                    {["India","Egypt","United States","United Kingdom","United Arab Emirates","Canada","Australia","Germany"].map(c=><option key={c} value={c}>{c}</option>)}
                  </select>
                  <label>Country</label>
                </div>
                <NeuInput label="ZIP / Postal Code" value={pZip} onChange={e=>setPZip(e.target.value)} />
              </div>
              <button className="s3-primary-btn mat-ripple" onClick={e=>{addRipple(e);setQStep(11);}}>Next →</button>
            </div>
          )}

          {/* ── STEP 11: Height & Weight ── */}
          {qStep===11&&(
            <div style={{ display:"flex", flexDirection:"column", flex:1, animation:"slideRight3 0.4s ease-out both" }}>
              <h1 style={{ fontSize:24, fontWeight:900, color:"#fff", lineHeight:1.25, margin:"0 0 6px", letterSpacing:-0.5 }}>Just a few more questions</h1>
              <p style={{ fontSize:13, color:"rgba(255,255,255,0.42)", margin:"0 0 28px" }}>Estimates are fine — update anytime.</p>
              <div style={{ display:"flex", flexDirection:"column", gap:16, marginBottom:24 }}>
                <NeuInput label="Height" type="number" value={pHeight} onChange={e=>setPHeight(e.target.value)}
                  extraRight={<span style={{ position:"absolute", right:18, top:"50%", transform:"translateY(-50%)", color:"#2ED4BF", fontWeight:900, fontSize:13, pointerEvents:"none" }}>cm</span>} />
                <NeuInput label="Weight" type="number" value={pWeight} onChange={e=>setPWeight(e.target.value)}
                  extraRight={<span style={{ position:"absolute", right:18, top:"50%", transform:"translateY(-50%)", color:LIME, fontWeight:900, fontSize:13, pointerEvents:"none" }}>kg</span>} />
              </div>
              <button className="s3-primary-btn mat-ripple" onClick={e=>{addRipple(e);setQStep(12);}}>Next →</button>
            </div>
          )}

          {/* ── STEP 12: Create account ── */}
          {qStep===12&&(
            <div style={{ display:"flex", flexDirection:"column", flex:1, animation:"slideRight3 0.4s ease-out both" }}>
              <h1 style={{ fontSize:26, fontWeight:900, color:"#fff", lineHeight:1.25, margin:"0 0 6px", letterSpacing:-0.5 }}>Almost done! Create your account.</h1>
              <p style={{ fontSize:13, color:"rgba(255,255,255,0.42)", margin:"0 0 24px" }}>Your personalized plan is almost ready.</p>
              {/* Email display — Material outlined card */}
              <div style={{ background:"rgba(215,255,62,0.05)", border:"1.5px solid rgba(215,255,62,0.18)", borderRadius:14, padding:"16px 18px", marginBottom:22, boxShadow:"0 0 20px rgba(215,255,62,0.04), inset 1px 1px 4px rgba(0,0,0,0.4)" }}>
                <div style={{ fontSize:10, color:"rgba(255,255,255,0.35)", fontWeight:900, textTransform:"uppercase", letterSpacing:1.5, marginBottom:5 }}>Account Email</div>
                <div style={{ fontSize:15, color:"#fff", fontWeight:700 }}>{selGoogle?selGoogle.email:"athlete@stoke.app"}</div>
              </div>
              {/* Swiss checkbox with neumorphic box */}
              <div onClick={()=>setPTerms(!pTerms)} style={{ display:"flex", alignItems:"flex-start", gap:14, cursor:"pointer", marginBottom:24 }}>
                <NeuCheckbox checked={pTerms} />
                <div style={{ fontSize:14, color:"rgba(255,255,255,0.7)", lineHeight:1.5 }}>
                  I agree to STOKE's <span style={{ color:LIME, textDecoration:"underline" }}>Terms & Conditions</span> and <span style={{ color:LIME, textDecoration:"underline" }}>Privacy Policy</span>.
                </div>
              </div>
              <button className="s3-primary-btn mat-ripple" onClick={e=>{addRipple(e);if(!pTerms)return;setGLoading(true);setTimeout(()=>{setGLoading(false);setQStep(13);},900);}} disabled={gLoading||!pTerms}>
                {gLoading?<span style={{ display:"flex", alignItems:"center", justifyContent:"center", gap:8 }}><NeuSpinner /> Creating your plan…</span>:"Create My Account →"}
              </button>
            </div>
          )}

          {/* ── STEP 13: Congratulations ── */}
          {qStep===13&&(
            <div style={{ display:"flex", flexDirection:"column", flex:1, animation:"slideRight3 0.4s ease-out both" }}>
              {/* Swiss: status label */}
              <div style={{ display:"inline-flex", alignItems:"center", gap:6, marginBottom:10 }}>
                <div style={{ width:8, height:8, borderRadius:"50%", background:LIME, boxShadow:`0 0 10px ${LIME}` }} />
                <span style={{ fontSize:11, color:LIME, fontWeight:900, letterSpacing:2, textTransform:"uppercase" }}>Account Created</span>
              </div>
              <h1 style={{ fontSize:28, fontWeight:900, color:"#fff", lineHeight:1.25, margin:"0 0 8px", letterSpacing:-0.5 }}>Congratulations, {pName||"Athlete"}!</h1>
              <p style={{ fontSize:14, color:"rgba(255,255,255,0.45)", margin:"0 0 24px", lineHeight:1.5 }}>Your custom plan is ready. One step closer to your goal.</p>

              {/* Material + Soft UI: calorie card */}
              <div className="s3-calorie-card" style={{ marginBottom:24 }}>
                <div style={{ fontSize:11, color:"rgba(255,255,255,0.45)", fontWeight:700, letterSpacing:0.5, marginBottom:8 }}>Your daily net calorie goal</div>
                <div style={{ fontSize:56, fontWeight:900, letterSpacing:-2.5, background:`linear-gradient(135deg, ${LIME} 0%, #fff 100%)`, WebkitBackgroundClip:"text", backgroundClip:"text", color:"transparent", lineHeight:1.1, marginBottom:4 }}>{calcCal.toLocaleString()}</div>
                <div style={{ fontSize:13, color:"rgba(255,255,255,0.45)", fontWeight:700, letterSpacing:0.5 }}>Calories / day</div>
                <div style={{ width:48, height:2, background:"rgba(215,255,62,0.4)", margin:"14px auto 0", borderRadius:1 }} />
                <div style={{ fontSize:11, color:"rgba(255,255,255,0.25)", marginTop:10 }}>ⓘ Based on your profile · Update anytime</div>
              </div>

              {/* Soft UI preference toggles */}
              <div style={{ display:"flex", flexDirection:"column", gap:10, marginBottom:24 }}>
                {[["Keep me on track with reminders", pReminders, setPReminders],["Track my steps with my phone", pSteps, setPSteps],["Receive STOKE emails & tips", pEmails, setPEmails]].map(([l,st,set],i)=>(
                  <div key={i} className="s3-pref-row" onClick={()=>set(!st)}>
                    <NeuCheckbox checked={st} />
                    <span style={{ fontSize:14, color:"#fff", fontWeight:600 }}>{l}</span>
                  </div>
                ))}
              </div>
              <button className="s3-primary-btn mat-ripple" onClick={e=>{addRipple(e);setQStep(14);}}>Next →</button>
            </div>
          )}

          {/* ── STEP 14: Final tools screen ── */}
          {qStep===14&&(
            <div style={{ display:"flex", flexDirection:"column", flex:1, animation:"slideRight3 0.4s ease-out both" }}>
              <div style={{ display:"flex", justifyContent:"flex-end" }}>
                <button className="s3-back-btn" onClick={finishOnboarding}>✕</button>
              </div>
              <div style={{ textAlign:"center", margin:"24px 0 32px" }}>
                <div style={{ fontSize:64, marginBottom:16 }}>⚡</div>
                {/* Swiss: Bold centered display type */}
                <div style={{ width:48, height:3, background:LIME, margin:"0 auto 16px", borderRadius:2, boxShadow:`0 0 12px ${LIME}` }} />
                <h1 style={{ fontSize:26, fontWeight:900, color:"#fff", lineHeight:1.3, margin:"0 0 10px", letterSpacing:-0.6 }}>Stay on it with tools that turn habits into results</h1>
                <p style={{ fontSize:14, color:"rgba(255,255,255,0.45)", lineHeight:1.5 }}>Everything is configured for your profile.</p>
              </div>
              <div style={{ display:"flex", flexDirection:"column", gap:10, marginBottom:28 }}>
                {[["📷","Scan a barcode","Log food lightning fast"],["🎙️","Use your voice","Just say what you ate"],["🔍","Take a photo","Log your entire meal"]].map(([ic,t,s],i)=>(
                  <div key={i} className="s3-feature-card" style={{ animation:`fadeUp3 0.4s ease-out ${0.1+i*0.08}s both` }}>
                    <span style={{ fontSize:28 }}>{ic}</span>
                    <div>
                      <div style={{ fontSize:15, fontWeight:800, color:"#fff", letterSpacing:-0.2 }}>{t}</div>
                      <div style={{ fontSize:12, color:"rgba(255,255,255,0.42)", marginTop:2 }}>{s}</div>
                    </div>
                    <span style={{ marginLeft:"auto", color:"rgba(215,255,62,0.5)", fontSize:16 }}>›</span>
                  </div>
                ))}
              </div>
              <button className="s3-primary-btn mat-ripple" onClick={e=>{addRipple(e);finishOnboarding();}} style={{ animation:"fadeUp3 0.4s ease-out 0.35s both" }}>
                Go to Home Dashboard ⚡
              </button>
            </div>
          )}

        </div>
      </div>
    </div>
  );
}


/* ---------- app shell ---------- */

function NavIcon({ name, size = 18 }) {
  const common = { width: size, height: size, viewBox: "0 0 24 24", fill: "none", stroke: "currentColor", strokeWidth: 1.8, strokeLinecap: "round", strokeLinejoin: "round" };
  switch (name) {
    case "home":
      return (
        <svg {...common}>
          <path d="M4 11.5L12 4l8 7.5" />
          <path d="M6.5 10v9.5h11V10" />
          <path d="M10 19.5v-5h4v5" />
        </svg>
      );
    case "nutrition":
      return (
        <svg {...common}>
          <circle cx="12" cy="14" r="6.5" />
          <path d="M12 7.5V5" />
          <path d="M12 5c1-1.2 2.3-1.4 3.3-0.6" />
        </svg>
      );
    case "workout":
      return (
        <svg {...common}>
          <circle cx="5" cy="12" r="2.2" />
          <circle cx="19" cy="12" r="2.2" />
          <line x1="7.2" y1="12" x2="16.8" y2="12" />
          <line x1="5" y1="9.3" x2="5" y2="14.7" />
          <line x1="19" y1="9.3" x2="19" y2="14.7" />
        </svg>
      );
    case "run":
      return (
        <svg {...common}>
          <circle cx="15.5" cy="5" r="1.8" />
          <path d="M9 20l2.5-5.5 2 1.8 3.5-1" />
          <path d="M7 13.5l3.5-2.5 2 2.5-2.5 3.5" />
        </svg>
      );
    case "coach":
      return (
        <svg {...common}>
          <path d="M4.5 5.5h15v10.5H10l-3.5 3.5v-3.5H4.5z" />
        </svg>
      );
    case "profile":
    case "more":
      return (
        <svg {...common}>
          <circle cx="5" cy="12" r="1.8" fill="currentColor" />
          <circle cx="12" cy="12" r="1.8" fill="currentColor" />
          <circle cx="19" cy="12" r="1.8" fill="currentColor" />
        </svg>
      );
    default:
      return null;
  }
}

const TABS = [
  { key: "home", label: "Today", icon: "home" },
  { key: "nutrition", label: "Nutrition", icon: "nutrition" },
  { key: "workout", label: "Workout", icon: "workout" },
  { key: "coach", label: "Coach", icon: "coach" },
  { key: "more", label: "More", icon: "more" },
];

function StokeApp() {
  const [tab, setTab] = useState("home");
  const [authed, setAuthed] = useState(false);
  const [userPhone, setUserPhone] = useState("");
  const [showWelcome, setShowWelcome] = useState(true);
  const [authMode, setAuthMode] = useState("signin");

  function handleSignIn(phone, profileFromSignup) {
    setUserPhone(phone);
    if (profileFromSignup) {
      setProfile(profileFromSignup);
    }
    setTab("home");
    setAuthed(true);
  }
  function handleSignOut() {
    setAuthed(false);
    setUserPhone("");
    setTab("home");
    setShowWelcome(true);
  }

  const [profile, setProfile] = useState(DEFAULT_PROFILE);
  const goals = computeGoals(profile);

  const [mealSlots, setMealSlots] = useState(DEFAULT_MEAL_SLOTS);
  const [meals, setMeals] = useState(() => {
    const init = {};
    DEFAULT_MEAL_SLOTS.forEach((s) => { init[s.key] = []; });
    return init;
  });
  const [water, setWater] = useState(0);
  const totals = macroSum(meals);
  const calPct = totals.calories / goals.calories;
  function addItem(mealKey, item) { setMeals((prev) => ({ ...prev, [mealKey]: [...prev[mealKey], item] })); }
  function removeItem(mealKey, idx) { setMeals((prev) => ({ ...prev, [mealKey]: prev[mealKey].filter((_, i) => i !== idx) })); }
  function addMealSlot(name) {
    const key = `custom_${Date.now()}`;
    setMealSlots((prev) => [...prev, { key, label: name }]);
    setMeals((prev) => ({ ...prev, [key]: [] }));
  }
  function removeMealSlot(key) {
    setMealSlots((prev) => prev.filter((s) => s.key !== key));
    setMeals((prev) => {
      const next = { ...prev };
      delete next[key];
      return next;
    });
  }

  const [programKey, setProgramKey] = useState("Classic Split");
  const weekIndex = getWeekIndex();
  const week = resolveWeek(WORKOUT_PROGRAMS[programKey], weekIndex);
  const [activeDay, setActiveDay] = useState(TODAY_KEY);
  const [logs, setLogs] = useState(() => buildLogs(resolveWeek(WORKOUT_PROGRAMS["Classic Split"], getWeekIndex())));
  function switchProgram(name) {
    setProgramKey(name);
    setLogs(buildLogs(resolveWeek(WORKOUT_PROGRAMS[name], weekIndex)));
    setActiveDay(TODAY_KEY);
  }
  function updateSet(exName, setIdx, field, value) {
    setLogs((prev) => ({ ...prev, [activeDay]: { ...prev[activeDay], [exName]: { ...prev[activeDay][exName], sets: prev[activeDay][exName].sets.map((s, i) => (i === setIdx ? { ...s, [field]: value } : s)) } } }));
  }
  function addSet(exName) {
    setLogs((prev) => ({ ...prev, [activeDay]: { ...prev[activeDay], [exName]: { ...prev[activeDay][exName], sets: [...prev[activeDay][exName].sets, { reps: "", weight: "" }] } } }));
  }
  function toggleComplete(exName) {
    setLogs((prev) => ({ ...prev, [activeDay]: { ...prev[activeDay], [exName]: { ...prev[activeDay][exName], completed: !prev[activeDay][exName].completed } } }));
  }

  const [runs, setRuns] = useState([]);
  const [runStatus, setRunStatus] = useState("idle");
  const [runElapsed, setRunElapsed] = useState(0);
  const [runDistanceKm, setRunDistanceKm] = useState(0);
  const [runGpsError, setRunGpsError] = useState(null);
  const [runAccuracy, setRunAccuracy] = useState(null);
  const [runShareCardUrl, setRunShareCardUrl] = useState(null);
  const [runShareStyle, setRunShareStyle] = useState("dark");
  const [runLiveGpsPos, setRunLiveGpsPos] = useState(null);
  const runWatchIdRef = useRef(null);
  const runLastPointRef = useRef(null);
  const runPathRef = useRef([]);
  const runTimerRef = useRef(null);
  const lastGpsMotionRef = useRef(0);

  useEffect(() => {
    return () => {
      if (runWatchIdRef.current !== null && navigator.geolocation) navigator.geolocation.clearWatch(runWatchIdRef.current);
      if (runTimerRef.current) clearInterval(runTimerRef.current);
    };
  }, []);

  function runStartWatch() {
    if (!navigator.geolocation) {
      setRunGpsError("GPS isn't available in this preview environment — on a real device the app requests high-accuracy location.");
      return;
    }
    runWatchIdRef.current = navigator.geolocation.watchPosition(
      (pos) => {
        const point = { lat: pos.coords.latitude, lng: pos.coords.longitude };
        setRunAccuracy(pos.coords.accuracy);
        setRunLiveGpsPos([point.lat, point.lng]);
        if (runLastPointRef.current) {
          const d = haversineKm(runLastPointRef.current, point);
          // Only add distance if actual movement occurred (> 5 meters) to ignore stationary jitter
          if (d >= 0.005 && d < 0.2) {
            setRunDistanceKm((prev) => Number((prev + d).toFixed(3)));
            runPathRef.current.push(point);
            lastGpsMotionRef.current = Date.now();
          }
        } else {
          runPathRef.current.push(point);
          lastGpsMotionRef.current = Date.now();
        }
        runLastPointRef.current = point;
      },
      (err) => setRunGpsError(err.message || "Location permission was denied."),
      { enableHighAccuracy: true, maximumAge: 1000, timeout: 15000 }
    );
  }
  function runStartTimer() {
    runTimerRef.current = setInterval(() => {
      setRunElapsed((e) => e + 1);
    }, 1000);
  }
  function runStopTimer() {
    if (runTimerRef.current) clearInterval(runTimerRef.current);
  }
  function handleRunStart() {
    setRunStatus("active");
    setRunElapsed(0);
    setRunDistanceKm(0);
    setRunGpsError(null);
    setRunShareCardUrl(null);
    setRunShareStyle("dark");
    runLastPointRef.current = null;
    runPathRef.current = [];
    lastGpsMotionRef.current = 0;
    runStartWatch();
    runStartTimer();
  }
  function handleRunPause() {
    setRunStatus("paused");
    runStopTimer();
  }
  function handleRunResume() {
    setRunStatus("active");
    runStartTimer();
  }
  function handleRunFinish() {
    setRunStatus("finished");
    runStopTimer();
    if (runWatchIdRef.current !== null && navigator.geolocation) navigator.geolocation.clearWatch(runWatchIdRef.current);
    const liveDist = runDistanceKm > 0 ? runDistanceKm : 0;
    const paceMinPerKm = (liveDist >= 0.01 && runElapsed > 0) ? (runElapsed / 60 / liveDist) : 0;
    const calories = Math.round(liveDist * RUNNER_WEIGHT_KG * 1.036);
    setRunShareCardUrl(drawShareCard({ distanceKm: liveDist, elapsed: runElapsed, paceMinPerKm, path: runPathRef.current, style: runShareStyle }));
    setRuns((prev) => [
      { date: new Date().toLocaleDateString(undefined, { month: "short", day: "numeric" }), distanceKm: liveDist, elapsed: runElapsed, paceMinPerKm, calories, path: [...runPathRef.current] },
      ...prev,
    ]);
  }
  function handleRunChangeStyle(style) {
    setRunShareStyle(style);
    const liveDist = runDistanceKm > 0 ? runDistanceKm : 0;
    const paceMinPerKm = (liveDist >= 0.01 && runElapsed > 0) ? (runElapsed / 60 / liveDist) : 0;
    setRunShareCardUrl(drawShareCard({ distanceKm: liveDist, elapsed: runElapsed, paceMinPerKm, path: runPathRef.current, style }));
  }
  function handleRunReset() {
    setRunStatus("idle");
    setRunElapsed(0);
    setRunDistanceKm(0);
    setRunGpsError(null);
    setRunAccuracy(null);
    setRunShareCardUrl(null);
  }

  const [messages, setMessages] = useState([]);
  const [input, setInput] = useState("");
  const [loading, setLoading] = useState(false);
  const remaining = {
    calories: Math.max(0, Math.round(goals.calories - totals.calories)),
    protein: Math.max(0, Math.round(goals.protein - totals.protein)),
    carbs: Math.max(0, Math.round(goals.carbs - totals.carbs)),
    fat: Math.max(0, Math.round(goals.fat - totals.fat)),
  };

  if (showWelcome) {
    return (
      <WelcomeCarousel
        onSignUp={() => { setAuthMode("signup"); setShowWelcome(false); }}
        onLogIn={() => { setAuthMode("signin"); setShowWelcome(false); }}
      />
    );
  }

  if (!authed) {
    return <AuthScreen onSignIn={handleSignIn} initialMode={authMode} />;
  }

  return (
    <div style={{ background: "radial-gradient(circle at 50% 0%, #1A1A1A 0%, #000000 60%)", height: "100vh", fontFamily: "'Space Grotesk', ui-sans-serif, system-ui, sans-serif", display: "flex", flexDirection: "column" }}>
      <div style={{ maxWidth: 480, width: "100%", margin: "0 auto", display: "flex", flexDirection: "column", height: "100%", position: "relative" }}>
        <div style={{
          flex: 1,
          overflowY: "auto",
          WebkitOverflowScrolling: "touch",
          padding: tab === "run" ? "16px 14px 110px" : "24px 16px 90px",
          display: "flex",
          flexDirection: "column",
          position: "relative"
        }}>
          {tab === "home" && <HomeScreen totals={totals} calPct={calPct} goals={goals} workoutDay={week[TODAY_KEY]} workoutLog={logs[TODAY_KEY]} lastRun={runs[0]} profileName={profile.name} water={water} setWater={setWater} onNavigate={setTab} />}
          {tab === "nutrition" && <NutritionScreen meals={meals} mealSlots={mealSlots} addMealSlot={addMealSlot} removeMealSlot={removeMealSlot} water={water} setWater={setWater} addItem={addItem} removeItem={removeItem} totals={totals} calPct={calPct} goals={goals} />}
          {tab === "workout" && <WorkoutScreen week={week} programKey={programKey} onProgramChange={switchProgram} activeDay={activeDay} setActiveDay={setActiveDay} logs={logs} updateSet={updateSet} addSet={addSet} toggleComplete={toggleComplete} />}
          {tab === "run" && (
            <RunScreen
              profile={profile}
              runs={runs}
              setRuns={setRuns}
              status={runStatus}
              elapsed={runElapsed}
              distanceKm={runDistanceKm}
              setDistanceKm={setRunDistanceKm}
              gpsError={runGpsError}
              accuracy={runAccuracy}
              shareCardUrl={runShareCardUrl}
              shareStyle={runShareStyle}
              onChangeStyle={handleRunChangeStyle}
              pathRef={runPathRef}
              handleStart={handleRunStart}
              handlePause={handleRunPause}
              handleResume={handleRunResume}
              handleFinish={handleRunFinish}
              handleReset={handleRunReset}
              liveGpsPos={runLiveGpsPos}
            />
          )}
          {tab === "coach" && <CoachScreen remaining={remaining} goals={goals} messages={messages} setMessages={setMessages} input={input} setInput={setInput} loading={loading} setLoading={setLoading} profile={profile} />}
          {(tab === "more" || tab === "profile") && <MoreHubScreen profile={profile} setProfile={setProfile} goals={goals} userPhone={userPhone} onSignOut={handleSignOut} totals={totals} onNavigate={setTab} />}
        </div>
        <div style={{ padding: "0 12px 14px", background: "transparent" }}>
          <div style={{ position: "relative", display: "flex", background: "rgba(22,27,36,0.75)", backdropFilter: "blur(20px) saturate(180%)", WebkitBackdropFilter: "blur(20px) saturate(180%)", border: "1px solid rgba(255,255,255,0.1)", borderRadius: 999, padding: 6, boxShadow: "0 8px 24px rgba(0,0,0,0.4)" }}>
            <div
              style={{
                position: "absolute",
                top: 6,
                bottom: 6,
                left: `calc(${(TABS.findIndex((t) => t.key === tab) / TABS.length) * 100}% + 6px)`,
                width: `calc(${100 / TABS.length}% - 12px)`,
                borderRadius: 999,
                background: "linear-gradient(155deg, rgba(215,255,62,0.35), rgba(215,255,62,0.12))",
                backdropFilter: "blur(6px)",
                WebkitBackdropFilter: "blur(6px)",
                border: "1px solid rgba(215,255,62,0.4)",
                boxShadow: "0 0 16px rgba(215,255,62,0.25)",
                transition: "left 0.45s cubic-bezier(0.34, 1.56, 0.64, 1)",
              }}
            />
            {TABS.map((t) => (
              <button key={t.key} onClick={() => setTab(t.key)} style={{ flex: 1, background: "none", border: "none", padding: "9px 0 7px", cursor: "pointer",
                color: tab === t.key ? TOKENS.ember : TOKENS.mutedFaint, display: "flex", flexDirection: "column", alignItems: "center", gap: 2, position: "relative", zIndex: 1 }}>
                <span style={{ position: "relative", display: "flex" }}>
                  <NavIcon name={t.icon} size={19} />
                  {t.key === "run" && runStatus === "active" && (
                    <span style={{ position: "absolute", top: -2, right: -6, width: 8, height: 8, borderRadius: "50%", background: TOKENS.ember, border: "1.5px solid rgba(22,27,36,0.9)" }} />
                  )}
                </span>
                <span style={{ fontSize: 9.5, fontWeight: 600 }}>{t.label}</span>
              </button>
            ))}
          </div>
        </div>
      </div>
    </div>
  );
}

ReactDOM.createRoot(document.getElementById("root")).render(<StokeApp />);
  </script>
</body>
</html>
