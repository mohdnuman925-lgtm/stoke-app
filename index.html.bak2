const PROGRAM_NAMES = Object.keys(WORKOUT_PROGRAMS);
const DAY_ORDER = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
const TODAY_KEY = DAY_ORDER[(new Date().getDay() + 6) % 7];

function getWeekIndex() {
  const now = new Date();
  const start = new Date(now.getFullYear(), 0, 1);
  const days = Math.floor((now - start) / 86400000);
  return Math.floor(days / 7);
}

function resolveWeek(program, weekIndex) {
  const resolved = {};
  DAY_ORDER.forEach((d) => {
    const day = program[d];
    const variantIdx = weekIndex % day.variants.length;
    const rotating = day.variants.length > 1;
    resolved[d] = {
      label: day.label + (rotating && !day.rest ? ` · Week ${String.fromCharCode(65 + variantIdx)}` : ""),
      rest: day.rest,
      exercises: day.variants[variantIdx],
    };
  });
  return resolved;
}

function macroSum(meals) {
  const totals = { calories: 0, protein: 0, carbs: 0, fat: 0, fiber: 0 };
  Object.keys(meals).forEach((k) => {
    meals[k].forEach((item) => {
      totals.calories += item.calories;
      totals.protein += item.protein;
      totals.carbs += item.carbs;
      totals.fat += item.fat;
      totals.fiber += item.fiber;
    });
  });
  return totals;
}

function makeEmptyLog(targetSets) {
  return Array.from({ length: targetSets }, () => ({ reps: "", weight: "" }));
}

function buildLogs(week) {
  const init = {};
  DAY_ORDER.forEach((d) => {
    init[d] = {};
    week[d].exercises.forEach((ex) => { init[d][ex.name] = { sets: makeEmptyLog(ex.targetSets), completed: false }; });
  });
  return init;
}

/* ---------- shared small components ---------- */

function Ring({ pct, size = 168, stroke = 14, color, trackColor }) {
  const r = (size - stroke) / 2;
  const c = 2 * Math.PI * r;
  const clamped = Math.max(0, Math.min(1, pct));
  return (
    <svg width={size} height={size} style={{ transform: "rotate(-90deg)" }}>
      <circle cx={size / 2} cy={size / 2} r={r} fill="none" stroke={trackColor} strokeWidth={stroke} />
      <circle cx={size / 2} cy={size / 2} r={r} fill="none" stroke={color} strokeWidth={stroke}
        strokeDasharray={c} strokeDashoffset={c * (1 - clamped)} strokeLinecap="round"
        style={{ transition: "stroke-dashoffset 0.5s ease" }} />
    </svg>
  );
}

function SmallRing({ pct, size = 44, stroke = 5, color }) {
  const r = (size - stroke) / 2;
  const c = 2 * Math.PI * r;
  return (
    <svg width={size} height={size} style={{ transform: "rotate(-90deg)" }}>
      <circle cx={size / 2} cy={size / 2} r={r} fill="none" stroke={TOKENS.surface2} strokeWidth={stroke} />
      <circle cx={size / 2} cy={size / 2} r={r} fill="none" stroke={color} strokeWidth={stroke}
        strokeDasharray={c} strokeDashoffset={c * (1 - Math.max(0, Math.min(1, pct)))} strokeLinecap="round"
        style={{ transition: "stroke-dashoffset 0.3s ease" }} />
    </svg>
  );
}

function MacroBar({ label, value, goal, color }) {
  const pct = Math.min(100, (value / goal) * 100);
  return (
    <div style={{ marginBottom: 14 }}>
      <div style={{ display: "flex", justifyContent: "space-between", marginBottom: 6, fontSize: 13 }}>
        <span style={{ color: TOKENS.muted, fontWeight: 500 }}>{label}</span>
        <span style={{ color: TOKENS.text, fontVariantNumeric: "tabular-nums" }}>
          {Math.round(value)}<span style={{ color: TOKENS.mutedFaint }}> / {goal}g</span>
        </span>
      </div>
      <div style={{ height: 6, background: TOKENS.surface2, backdropFilter: "blur(16px) saturate(180%)", WebkitBackdropFilter: "blur(16px) saturate(180%)", borderRadius: 3, overflow: "hidden" }}>
        <div style={{ height: "100%", width: `${pct}%`, background: color, borderRadius: 3, transition: "width 0.4s ease" }} />
      </div>
    </div>
  );
}

function VegDot({ type }) {
  const isVeg = type !== "nonveg";
  return (
    <span
      title={isVeg ? "Veg" : "Non-veg"}
      style={{
        display: "inline-flex",
        width: 13,
        height: 13,
        border: `1.5px solid ${isVeg ? "#2E7D32" : "#B71C1C"}`,
        borderRadius: 3,
        alignItems: "center",
        justifyContent: "center",
        flexShrink: 0,
      }}
    >
      <span style={{ width: 6, height: 6, borderRadius: isVeg ? 3 : "50%", background: isVeg ? "#2E7D32" : "#B71C1C" }} />
    </span>
  );
}

function EstimateEditor({ item, onChange, onConfirm, onCancel, confirmLabel, hideActions }) {
  const [perGram] = useState(() => {
    const g = item.grams || 1;
    return {
      calories: item.calories / g,
      protein: item.protein / g,
      carbs: item.carbs / g,
      fat: item.fat / g,
      fiber: item.fiber / g,
    };
  });

  const fields = [["name", "Food", "text"], ["grams", "Grams", "number"], ["calories", "Calories (kcal)", "number"],
    ["protein", "Protein (g)", "number"], ["carbs", "Carbs (g)", "number"], ["fat", "Fat (g)", "number"], ["fiber", "Fibre (g)", "number"]];

  function handleChange(key, rawValue) {
    if (key === "grams") {
      const newGrams = Number(rawValue) || 0;
      onChange({
        ...item,
        grams: newGrams,
        calories: Math.round(perGram.calories * newGrams),
        protein: Math.round(perGram.protein * newGrams * 10) / 10,
        carbs: Math.round(perGram.carbs * newGrams * 10) / 10,
        fat: Math.round(perGram.fat * newGrams * 10) / 10,
        fiber: Math.round(perGram.fiber * newGrams * 10) / 10,
      });
    } else {
      const type = key === "name" ? "text" : "number";
      onChange({ ...item, [key]: type === "number" ? Number(rawValue) : rawValue });
    }
  }

  return (
    <div style={{ background: TOKENS.surface2, backdropFilter: "blur(16px) saturate(180%)", WebkitBackdropFilter: "blur(16px) saturate(180%)", border: `1px solid ${TOKENS.border}`, borderRadius: 12, padding: 16, marginTop: 10 }}>
      <div style={{ marginBottom: 10 }}>
        <label style={{ fontSize: 11, color: TOKENS.mutedFaint, display: "block", marginBottom: 4 }}>Type</label>
        <div style={{ display: "flex", gap: 8 }}>
          {[["veg", "🟢 Veg"], ["nonveg", "🟤 Non-veg"]].map(([val, label]) => {
            const active = (item.dietType || "veg") === val;
            return (
              <button
                key={val}
                onClick={() => onChange({ ...item, dietType: val })}
                style={{
                  flex: 1,
                  background: active ? TOKENS.ember : TOKENS.bg,
                  color: active ? "#0B0E13" : TOKENS.text,
                  border: `1px solid ${active ? TOKENS.ember : TOKENS.border}`,
                  borderRadius: 8,
                  padding: "8px 0",
                  fontSize: 13,
                  fontWeight: 600,
                  cursor: "pointer",
                }}
              >
                {label}
              </button>
            );
          })}
        </div>
      </div>
      <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 10 }}>
        {fields.map(([key, label, type]) => (
          <div key={key} style={{ gridColumn: key === "name" ? "1 / 3" : "auto" }}>
            <label style={{ fontSize: 11, color: TOKENS.mutedFaint, display: "block", marginBottom: 4 }}>
              {label}{key === "grams" && <span style={{ color: TOKENS.mutedFaint }}> (adjusts macros)</span>}
            </label>
            <input type={type} value={item[key]} onChange={(e) => handleChange(key, e.target.value)}
              style={{ width: "100%", background: TOKENS.bg, border: `1px solid ${TOKENS.border}`, borderRadius: 8, padding: "8px 10px", color: TOKENS.text, fontSize: 14, boxSizing: "border-box" }} />
          </div>
        ))}
      </div>
      {!hideActions && (
        <div style={{ display: "flex", gap: 10, marginTop: 14 }}>
          <button onClick={onConfirm} style={{ flex: 1, background: TOKENS.ember, color: "#1A0F08", border: "none", borderRadius: 8, padding: "10px 0", fontWeight: 700, fontSize: 14, cursor: "pointer" }}>{confirmLabel}</button>
          <button onClick={onCancel} style={{ background: "transparent", color: TOKENS.muted, border: `1px solid ${TOKENS.border}`, borderRadius: 8, padding: "10px 16px", fontSize: 14, cursor: "pointer" }}>Cancel</button>
        </div>
      )}
    </div>
  );
}

function actionBtnStyle(bg, color) {
  return { flex: 1, background: bg, color: color || "#1A0F08", border: bg === TOKENS.surface2 ? `1px solid ${TOKENS.border}` : "none",
