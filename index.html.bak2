function getFemaleVoice() {
  if (typeof window === "undefined" || !("speechSynthesis" in window)) return null;
  const voices = window.speechSynthesis.getVoices();
  if (!voices || voices.length === 0) return null;

  // Prioritized list of known sweet/female voice names and identifiers
  const femaleKeywords = [
    "zira", "jenny", "aria", "samantha", "victoria", "karen", "moira", "hazel",
    "eva", "siri", "female", "natural", "salli", "joanna", "ivy", "kendra",
    "kimberly", "cynthia", "fiona", "tessa", "alice", "stephanie", "kate",
    "google us english", "google uk english female"
  ];

  // 1. Search for English female voice
  for (const kw of femaleKeywords) {
    const found = voices.find(
      (v) => (v.lang.startsWith("en") || !v.lang) && v.name.toLowerCase().includes(kw)
    );
    if (found) return found;
  }

  // 2. Search for any female voice
  for (const kw of femaleKeywords) {
    const found = voices.find((v) => v.name.toLowerCase().includes(kw));
    if (found) return found;
  }

  // 3. Fallback to any English voice
  const enVoice = voices.find((v) => v.lang.startsWith("en"));
  return enVoice || voices[0] || null;
}

// Pre-load voices for Chrome / Edge
if (typeof window !== "undefined" && "speechSynthesis" in window) {
  window.speechSynthesis.onvoiceschanged = () => {
    getFemaleVoice();
  };
}

function speakAudioCue(text, voiceId = "lily") {
  if (typeof window !== "undefined" && "speechSynthesis" in window) {
    try {
      window.speechSynthesis.cancel();
      const utterance = new SpeechSynthesisUtterance(text);
      const femaleVoice = getFemaleVoice();
      if (femaleVoice) {
        utterance.voice = femaleVoice;
      }
      const persona = GIRL_VOICES.find((v) => v.id === voiceId) || GIRL_VOICES[0];
      utterance.pitch = persona.pitch; // Super cute pitch for Lily / Chloe
      utterance.rate = persona.rate;   // Natural cheerful cadence
      utterance.volume = 1.0;
      window.speechSynthesis.speak(utterance);
    } catch (e) {
      console.log("Audio cue error", e);
    }
  }
}

