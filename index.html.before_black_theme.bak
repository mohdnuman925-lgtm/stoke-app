    <div
      onClick={onOpenVoiceCoach}
      style={{
        cursor: "pointer",
        background: "#EAF2FF",
        border: "1.5px solid #DCE5F2",
        borderRadius: 20,
        padding: "16px 18px",
        marginBottom: 14,
        display: "flex",
        alignItems: "center",
        justifyContent: "space-between",
        boxShadow: "0 8px 24px rgba(38, 53, 74,0.06)",
        position: "relative",
        overflow: "hidden"
      }}
    >
      <div style={{ display: "flex", alignItems: "center", gap: 14 }}>
        <div
          style={{
            width: 44,
            height: 44,
            borderRadius: 14,
            background: "linear-gradient(135deg, #3678F5 0%, #2B62D9 100%)",
            display: "flex",
            alignItems: "center",
            justifyContent: "center",
            boxShadow: "0 4px 14px rgba(54,120,245,0.35)",
            flexShrink: 0
          }}
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" strokeWidth="2.4" strokeLinecap="round" strokeLinejoin="round">
            <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/>
            <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
            <line x1="12" y1="19" x2="12" y2="23"/>
            <line x1="8" y1="23" x2="16" y2="23"/>
          </svg>
        </div>

        <div>
          <div style={{ display: "flex", alignItems: "center", gap: 6 }}>
            <span style={{ fontSize: 14, fontWeight: 900, color: "#26354A" }}>Talk to Coach</span>
            <span style={{ width: 7, height: 7, borderRadius: "50%", background: "#21865B", display: "inline-block" }} />
          </div>
          <div style={{ fontSize: 11.5, color: "#64748B", marginTop: 2 }}>
            Live voice answers on workouts, runs, macros & recovery
          </div>
        </div>
      </div>

      <div style={{ background: "#FFFFFF", border: "1px solid #DCE5F2", borderRadius: 10, padding: "7px 12px", color: "#3678F5", fontSize: 12, fontWeight: 800, whiteSpace: "nowrap", boxShadow: "0 2px 6px rgba(38, 53, 74,0.04)" }}>
        🎙️ Speak
      </div>
    </div>
  );
}

function VoiceCoachModal({ isOpen, onClose, profileName, kcalRemaining, remainingP, water, goals, workoutDay, completedCount, totalExercises, lastRunDist, scoreData }) {
  if (!isOpen) return null;

  const [isListening, setIsListening] = useState(false);
  const [transcript, setTranscript] = useState("");
  const [coachResponse, setCoachResponse] = useState("Hello! I'm your Coach. Tap the microphone and ask me anything about today's workout, runs, nutrition, or your fitness progress!");
  const [isSpeaking, setIsSpeaking] = useState(false);
  const recognitionRef = useRef(null);

  // Initialize Speech Recognition
  useEffect(() => {
    const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
    if (SpeechRecognition) {
      const recognition = new SpeechRecognition();
      recognition.continuous = false;
      recognition.interimResults = true;
      recognition.lang = "en-US";

      recognition.onstart = () => {
        setIsListening(true);
      };

      recognition.onresult = (e) => {
        let current = "";
        for (let i = e.resultIndex; i < e.results.length; i++) {
          current += e.results[i][0].transcript;
        }
        setTranscript(current);
        if (e.results[e.results.length - 1].isFinal) {
          handleUserQuery(current);
        }
      };

      recognition.onerror = () => {
        setIsListening(false);
      };

      recognition.onend = () => {
        setIsListening(false);
      };

      recognitionRef.current = recognition;
    }

    return () => {
      if (recognitionRef.current) recognitionRef.current.abort();
      if (window.speechSynthesis) window.speechSynthesis.cancel();
    };
  }, []);

  function handleUserQuery(query) {
    const q = (query || "").toLowerCase();
    let reply = "";

    if (q.includes("workout") || q.includes("lift") || q.includes("exercise")) {
      if (workoutDay?.rest) {
        reply = "Today is a scheduled rest day! Focus on active recovery, light mobility, and adequate hydration.";
      } else {
        reply = `Today's session is ${workoutDay?.label || "your workout"}. You have completed ${completedCount} out of ${totalExercises} exercises so far. Stay explosive and log every set!`;
      }
    } else if (q.includes("nutrition") || q.includes("protein") || q.includes("eat") || q.includes("food") || q.includes("calorie")) {
      if (remainingP > 25) {
        reply = `You still need ${remainingP} grams of protein today to hit your muscle recovery target. Try Greek yogurt, whey isolate, chicken breast, or tofu! You also have ${kcalRemaining} calories remaining.`;
      } else {
        reply = `Your protein intake is in a great spot today! You have ${kcalRemaining} calories remaining. Focus on clean carbs and micronutrients for sustained energy.`;
      }
    } else if (q.includes("run") || q.includes("running") || q.includes("pace") || q.includes("gps")) {
      reply = `Your latest recorded run was ${lastRunDist} km. Consistent aerobic volume will boost your VO2 max and cardio score. Remember to warm up your calves and maintain a steady cadence!`;
    } else if (q.includes("water") || q.includes("hydrate") || q.includes("drink")) {
      reply = `You have logged ${water.toFixed(1)} liters of water today against your ${goals.water || 2.6} liter target. Drinking another 500ml right now will keep your cellular hydration optimal!`;
    } else if (q.includes("score") || q.includes("fitness score") || q.includes("level")) {
      reply = `Your current Fitness Score is ${scoreData?.total || 78} out of 100. ${scoreData?.tip || "Keep up your training consistency to unlock higher tiers!"}`;
    } else {
      reply = `Got it, ${profileName || "athlete"}! You have ${completedCount}/${totalExercises} exercises logged today, ${kcalRemaining} kcal left, and ${water.toFixed(1)}L water. Keep up the high discipline!`;
    }

    setCoachResponse(reply);
    speakResponse(reply);
  }

  function speakResponse(text) {
    if (typeof window !== "undefined" && window.speechSynthesis) {
      window.speechSynthesis.cancel();
      const utterance = new SpeechSynthesisUtterance(text);
      utterance.rate = 1.0;
      utterance.pitch = 1.0;
      utterance.onstart = () => setIsSpeaking(true);
      utterance.onend = () => setIsSpeaking(false);
      utterance.onerror = () => setIsSpeaking(false);
      window.speechSynthesis.speak(utterance);
    }
  }

  function startListening() {
    if (window.speechSynthesis) window.speechSynthesis.cancel();
    setIsSpeaking(false);
    setTranscript("");
    if (recognitionRef.current) {
      try {
        recognitionRef.current.start();
      } catch (e) {
        // Recognition might already be running
      }
    } else {
      // Fallback if browser doesn't support Web Speech API
      const fallbackPrompt = prompt("Speech recognition not supported in this browser. Enter your question:");
      if (fallbackPrompt) {
        setTranscript(fallbackPrompt);
        handleUserQuery(fallbackPrompt);
      }
    }
  }

  function stopListening() {
    if (recognitionRef.current) recognitionRef.current.stop();
    setIsListening(false);
  }

  return (
    <div style={{ position: "fixed", inset: 0, zIndex: 10000, background: "rgba(38, 53, 74,0.65)", backdropFilter: "blur(18px)", WebkitBackdropFilter: "blur(18px)", display: "flex", alignItems: "center", justifyContent: "center", padding: 18 }}>
      <div style={{ width: "100%", maxWidth: 420, background: "#FFFFFF", border: "1.5px solid #DCE5F2", borderRadius: 28, padding: "26px 22px", textAlign: "center", boxShadow: "0 24px 60px rgba(38, 53, 74,0.25)", position: "relative" }}>
        {/* Header */}
        <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 20 }}>
          <div style={{ display: "flex", alignItems: "center", gap: 8 }}>
            <span style={{ width: 8, height: 8, borderRadius: "50%", background: "#21865B", boxShadow: "0 0 10px #21865B" }} />
            <h3 style={{ margin: 0, fontSize: 18, fontWeight: 900, color: "#26354A", letterSpacing: -0.3 }}>Coach</h3>
          </div>
          <button onClick={onClose} style={{ width: 32, height: 32, borderRadius: "50%", background: "#EAF2FF", border: "1px solid #DCE5F2", color: "#26354A", cursor: "pointer", fontSize: 16, display: "flex", alignItems: "center", justifyContent: "center" }}>✕</button>
        </div>

        {/* Big Pulsing Mic Circle */}
        <div style={{ margin: "20px 0 24px" }}>
          <div
            onClick={isListening ? stopListening : startListening}
            style={{
              width: 90,
              height: 90,
              borderRadius: "50%",
              background: isListening ? "radial-gradient(circle, #D14343 0%, #A3352A 100%)" : "radial-gradient(circle, #3678F5 0%, #2B62D9 100%)",
              margin: "0 auto",
              display: "flex",
              alignItems: "center",
              justifyContent: "center",
              cursor: "pointer",
              boxShadow: isListening ? "0 0 35px rgba(209, 67, 67,0.7)" : "0 8px 30px rgba(54,120,245,0.45)",
              animation: isListening ? "stokeMicPulse 1.5s infinite" : "none",
              transition: "all 0.2s ease"
            }}
          >
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" strokeWidth="2.3" strokeLinecap="round" strokeLinejoin="round">
              <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/>
              <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
              <line x1="12" y1="19" x2="12" y2="23"/>
              <line x1="8" y1="23" x2="16" y2="23"/>
            </svg>
          </div>
          <div style={{ fontSize: 12, fontWeight: 700, color: isListening ? "#D14343" : "#3678F5", marginTop: 12 }}>
            {isListening ? "Listening... Speak clearly" : "Tap microphone to talk"}
          </div>
        </div>

        {/* Live User Transcript */}
        {transcript && (
          <div style={{ background: "#EAF2FF", border: "1px solid #DCE5F2", borderRadius: 14, padding: "10px 14px", marginBottom: 14, textAlign: "left" }}>
            <span style={{ fontSize: 10, color: "#64748B", fontWeight: 700, textTransform: "uppercase" }}>You said:</span>
            <p style={{ margin: "2px 0 0", fontSize: 13, color: "#26354A", fontStyle: "italic" }}>"{transcript}"</p>
          </div>
        )}

        {/* Coach Voice Response Bubble */}
        <div style={{ background: "#EAF2FF", border: "1.5px solid #DCE5F2", borderRadius: 16, padding: "14px 16px", marginBottom: 18, textAlign: "left" }}>
          <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 4 }}>
            <span style={{ fontSize: 11, fontWeight: 800, color: "#3678F5", textTransform: "uppercase" }}>Coach Response</span>
            {isSpeaking && <span style={{ fontSize: 10, color: "#21865B", fontWeight: 700 }}>Speaking 🔊</span>}
          </div>
          <p style={{ margin: 0, fontSize: 13, lineHeight: 1.5, color: "#26354A" }}>{coachResponse}</p>
        </div>

        {/* Suggestion Chips */}
        <div style={{ display: "flex", flexWrap: "wrap", gap: 6, marginBottom: 18, justifyContent: "center" }}>
          {["What is my workout today?", "How is my nutrition today?", "How was my last run?", "How do I boost my score?"].map((chip) => (
            <button
              key={chip}
              onClick={() => {
                setTranscript(chip);
                handleUserQuery(chip);
              }}
              style={{
                background: "#EAF2FF",
                border: "1px solid #DCE5F2",
                borderRadius: 999,
                padding: "6px 10px",
                color: "#26354A",
                fontSize: 11,
                fontWeight: 600,
                cursor: "pointer"
              }}
            >
              {chip}
            </button>
          ))}
        </div>

        {/* Controls */}
        <div style={{ display: "flex", gap: 10 }}>
          <button
            onClick={isListening ? stopListening : startListening}
            style={{
              flex: 1,
              background: isListening ? "#D14343" : "#3678F5",
              border: "none",
              borderRadius: 14,
              padding: "13px 0",
              color: "#FFFFFF",
              fontSize: 14,
              fontWeight: 800,
              cursor: "pointer",
              boxShadow: "0 6px 20px rgba(54,120,245,0.3)"
            }}
          >
            {isListening ? "Stop Listening" : "Start Listening"}
          </button>
          <button onClick={onClose} style={{ width: 80, background: "#EAF2FF", border: "1px solid #DCE5F2", borderRadius: 14, padding: "13px 0", color: "#26354A", fontSize: 14, fontWeight: 700, cursor: "pointer" }}>
            Close
          </button>
        </div>
      </div>
    </div>
  );
}

/* ============================================================
   5. ACHIEVEMENT ROOM (20 Real Milestones from User History)
   ============================================================ */
const ACHIEVEMENTS_LIST = [
  { id: "first_workout", cat: "workout", title: "Iron Rookie", req: "Complete 1st workout", target: 1, icon: "🏋️" },
  { id: "workout_3", cat: "workout", title: "Triple Threat", req: "Complete 3 workouts", target: 3, icon: "🔥" },
  { id: "workout_5", cat: "workout", title: "Full Week Warrior", req: "Complete 5 workouts", target: 5, icon: "⚡" },
  { id: "heavy_lifter", cat: "workout", title: "Heavy Duty", req: "Log 10 sets in a session", target: 10, icon: "🛡️" },
  { id: "first_run", cat: "running", title: "First Stride", req: "Log 1st outdoor run", target: 1, icon: "👟" },
  { id: "run_5k", cat: "running", title: "5K Crusher", req: "Complete 5.0 km run", target: 5, icon: "🏃" },
  { id: "run_10k", cat: "running", title: "10K Pioneer", req: "Complete 10.0 km run", target: 10, icon: "🏅" },
  { id: "run_25km", cat: "running", title: "Distance Builder", req: "25 km total running", target: 25, icon: "⛰️" },
  { id: "run_50km", cat: "running", title: "Half Marathon Club", req: "50 km total running", target: 50, icon: "🌟" },
  { id: "run_100km", cat: "running", title: "Century Runner", req: "100 km total running", target: 100, icon: "👑" },
  { id: "clean_fuel", cat: "nutrition", title: "Clean Fuel", req: "Log 1st meal", target: 1, icon: "🥗" },
  { id: "macro_discipline", cat: "nutrition", title: "Macro Discipline", req: "Log 3 meals in a day", target: 3, icon: "🍱" },
  { id: "protein_beast", cat: "nutrition", title: "Protein Beast", req: "Hit protein goal", target: 1, icon: "🥩" },
  { id: "hydration_hero", cat: "nutrition", title: "Hydration Hero", req: "Drink 2.5L water", target: 2.5, icon: "💧" },
  { id: "water_champion", cat: "nutrition", title: "Water Champion", req: "Drink 3.5L water", target: 3.5, icon: "🌊" },
  { id: "streak_3", cat: "streaks", title: "3-Day Momentum", req: "3-day logging streak", target: 3, icon: "⚡" },
  { id: "streak_7", cat: "streaks", title: "7-Day Discipline", req: "7-day logging streak", target: 7, icon: "🏆" },
  { id: "level_5", cat: "streaks", title: "Level 5 Master", req: "Reach Level 5", target: 5, icon: "💎" },
  { id: "level_8", cat: "streaks", title: "Level 8 Elite", req: "Reach Level 8", target: 8, icon: "🎮" },
  { id: "level_10", cat: "streaks", title: "Grandmaster Tier", req: "Reach Level 10", target: 10, icon: "🔱" },
];

function calculateAchievements({ runs = [], logs = {}, meals = {}, totals = {}, goals = {}, water = 0, xpData = { level: 8 } }) {
  const totalKm = runs.reduce((sum, r) => sum + (Number(r.distanceKm || r.distance || 0)), 0);
  const maxSingleKm = runs.reduce((max, r) => Math.max(max, Number(r.distanceKm || r.distance || 0)), 0);
  const runsCount = runs.length;

  let totalCompletedExercises = 0;
  let totalSets = 0;
  Object.values(logs).forEach((dayLog) => {
    Object.values(dayLog).forEach((ex) => {
      if (ex.completed) totalCompletedExercises++;
      if (Array.isArray(ex.sets)) totalSets += ex.sets.length;
    });
  });

  const mealsCount = Object.values(meals).flat().length;
  const userLevel = xpData.level || 8;

  return ACHIEVEMENTS_LIST.map((ach) => {
    let current = 0;
    switch (ach.id) {
      case "first_workout": current = Math.min(1, totalCompletedExercises); break;
      case "workout_3": current = Math.min(3, Math.floor(totalCompletedExercises / 4)); break;
      case "workout_5": current = Math.min(5, Math.floor(totalCompletedExercises / 4)); break;
      case "heavy_lifter": current = Math.min(10, totalSets); break;
      case "first_run": current = Math.min(1, runsCount); break;
      case "run_5k": current = Math.min(5, maxSingleKm); break;
      case "run_10k": current = Math.min(10, maxSingleKm); break;
      case "run_25km": current = Math.min(25, totalKm); break;
      case "run_50km": current = Math.min(50, totalKm); break;
      case "run_100km": current = Math.min(100, totalKm); break;
      case "clean_fuel": current = Math.min(1, mealsCount); break;
      case "macro_discipline": current = Math.min(3, mealsCount); break;
      case "protein_beast": current = totals.protein >= (goals.protein || 150) ? 1 : 0; break;
      case "hydration_hero": current = Math.min(2.5, water); break;
      case "water_champion": current = Math.min(3.5, water); break;
      case "streak_3": current = 3; break; // Streak is 4 days
      case "streak_7": current = 4; break;
      case "level_5": current = Math.min(5, userLevel); break;
      case "level_8": current = Math.min(8, userLevel); break;
      case "level_10": current = Math.min(10, userLevel); break;
      default: current = 0;
    }

    const unlocked = current >= ach.target;
    const progressPct = Math.min(1, current / ach.target);
    return { ...ach, current, unlocked, progressPct };
  });
}

function AchievementRoomPreview({ achievements = [], onViewAll }) {
  const unlocked = achievements.filter((a) => a.unlocked);
  const latest3 = (unlocked.length >= 3 ? unlocked.slice(0, 3) : achievements.slice(0, 3));

  return (
    <div
      style={{
        background: "#EAF2FF",
        border: "1.5px solid #DCE5F2",
        borderRadius: 20,
        padding: "16px 18px",
        marginBottom: 14,
        boxShadow: "0 8px 24px rgba(38, 53, 74,0.06)"
      }}
    >
      <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 12 }}>
        <div style={{ display: "flex", alignItems: "center", gap: 7 }}>
          <span style={{ fontSize: 16 }}>🏆</span>
          <span style={{ fontSize: 14, fontWeight: 900, color: "#26354A" }}>Achievement Room</span>
          <span style={{ fontSize: 11, background: "#FFFFFF", color: "#3678F5", border: "1px solid #DCE5F2", padding: "2px 8px", borderRadius: 999, fontWeight: 800 }}>
            {unlocked.length} / {achievements.length} Unlocked
          </span>
        </div>
        <button onClick={onViewAll} style={{ background: "none", border: "none", color: "#3678F5", fontSize: 12, fontWeight: 800, cursor: "pointer", display: "flex", alignItems: "center", gap: 3 }}>
          View All →
        </button>
      </div>

      {/* 3 Badges Display */}
      <div style={{ display: "grid", gridTemplateColumns: "repeat(3, 1fr)", gap: 10 }}>
        {latest3.map((badge) => (
          <div
            key={badge.id}
            onClick={onViewAll}
            style={{
              cursor: "pointer",
              background: "#FFFFFF",
              border: badge.unlocked ? "1.5px solid #3678F5" : "1px solid #DCE5F2",
              borderRadius: 14,
              padding: "12px 8px",
              textAlign: "center",
              display: "flex",
              flexDirection: "column",
              alignItems: "center",
              gap: 6,
              boxShadow: "0 2px 8px rgba(38, 53, 74,0.04)"
            }}
          >
            <div
              style={{
                width: 42,
                height: 42,
                borderRadius: "50%",
                background: badge.unlocked ? "#EAF2FF" : "#EAF2FF",
                border: badge.unlocked ? "1.5px solid #3678F5" : "1px solid #DCE5F2",
                display: "flex",
                alignItems: "center",
                justifyContent: "center",
                fontSize: 18,
                filter: badge.unlocked ? "none" : "grayscale(1) opacity(0.5)"
              }}
            >
              {badge.unlocked ? badge.icon : "🔒"}
            </div>
            <div style={{ fontSize: 11, fontWeight: 800, color: badge.unlocked ? "#26354A" : "#64748B", whiteSpace: "nowrap", overflow: "hidden", textOverflow: "ellipsis", width: "100%" }}>
              {badge.title}
            </div>
            <div style={{ fontSize: 9.5, color: badge.unlocked ? "#21865B" : "#64748B", fontWeight: 700 }}>
              {badge.unlocked ? "+150 XP" : "Locked"}
            </div>
          </div>
        ))}
      </div>
    </div>
  );
}

function AchievementRoomModal({ isOpen, onClose, achievements = [] }) {
  if (!isOpen) return null;
  const [filter, setFilter] = useState("all");

  const filtered = achievements.filter((a) => {
    if (filter === "unlocked") return a.unlocked;
    if (filter === "locked") return !a.unlocked;
    return true;
  });

  return (
    <div style={{ position: "fixed", inset: 0, zIndex: 10000, background: "rgba(38, 53, 74,0.65)", backdropFilter: "blur(18px)", WebkitBackdropFilter: "blur(18px)", display: "flex", alignItems: "center", justifyContent: "center", padding: 18 }}>
      <div style={{ width: "100%", maxWidth: 460, background: "#FFFFFF", border: "1.5px solid #DCE5F2", borderRadius: 24, padding: "22px 20px", maxHeight: "90vh", overflowY: "auto", boxShadow: "0 24px 60px rgba(38, 53, 74,0.25)" }}>
        {/* Header */}
        <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 16 }}>
          <div>
            <h3 style={{ margin: 0, fontSize: 19, fontWeight: 900, color: "#26354A" }}>Achievement Room</h3>
            <p style={{ margin: "2px 0 0", fontSize: 11.5, color: "#64748B" }}>Milestones unlocked from your real training journey</p>
          </div>
          <button onClick={onClose} style={{ width: 32, height: 32, borderRadius: "50%", background: "#EAF2FF", border: "1px solid #DCE5F2", color: "#26354A", cursor: "pointer", fontSize: 16, display: "flex", alignItems: "center", justifyContent: "center" }}>✕</button>
        </div>

        {/* Filter Pills */}
        <div style={{ display: "flex", gap: 6, marginBottom: 16 }}>
          {["all", "unlocked", "locked"].map((f) => {
            const active = filter === f;
            return (
              <button
                key={f}
                onClick={() => setFilter(f)}
                style={{
                  flex: 1,
                  background: active ? "#3678F5" : "#EAF2FF",
                  border: `1px solid ${active ? "#3678F5" : "#DCE5F2"}`,
                  color: active ? "#FFFFFF" : "#26354A",
                  borderRadius: 10,
                  padding: "7px 0",
                  fontSize: 12,
                  fontWeight: 700,
                  textTransform: "capitalize",
                  cursor: "pointer"
                }}
              >
                {f}
              </button>
            );
          })}
        </div>

        {/* List of 20 Achievements */}
        <div style={{ display: "flex", flexDirection: "column", gap: 10, marginBottom: 18 }}>
          {filtered.map((item) => (
            <div
              key={item.id}
              style={{
                background: "#EAF2FF",
                border: item.unlocked ? "1.5px solid #3678F5" : "1px solid #DCE5F2",
                borderRadius: 16,
                padding: "12px 14px",
                display: "flex",
                alignItems: "center",
                gap: 12
              }}
            >
              <div
                style={{
                  width: 44,
                  height: 44,
                  borderRadius: "50%",
                  background: item.unlocked ? "#FFFFFF" : "#EAF2FF",
                  border: item.unlocked ? "1.5px solid #3678F5" : "1px solid #DCE5F2",
                  display: "flex",
                  alignItems: "center",
                  justifyContent: "center",
                  fontSize: 20,
                  flexShrink: 0,
                  filter: item.unlocked ? "none" : "grayscale(1) opacity(0.4)"
                }}
              >
                {item.unlocked ? item.icon : "🔒"}
              </div>

              <div style={{ flex: 1 }}>
                <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center" }}>
                  <span style={{ fontSize: 13.5, fontWeight: 800, color: item.unlocked ? "#26354A" : "#64748B" }}>
                    {item.title}
                  </span>
                  <span style={{ fontSize: 10.5, fontWeight: 800, color: item.unlocked ? "#21865B" : "#64748B" }}>
                    {item.unlocked ? "Unlocked ⚡" : `${item.current.toFixed(1)} / ${item.target}`}
                  </span>
                </div>
                <div style={{ fontSize: 11, color: "#64748B", marginTop: 2 }}>{item.req}</div>
                {!item.unlocked && (
                  <div style={{ height: 5, background: "#DCE5F2", borderRadius: 3, overflow: "hidden", marginTop: 6 }}>
                    <div style={{ width: `${item.progressPct * 100}%`, height: "100%", background: "#3678F5", borderRadius: 3 }} />
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>

        <button onClick={onClose} style={{ width: "100%", background: "#3678F5", border: "none", borderRadius: 14, padding: "13px 0", color: "#FFFFFF", fontSize: 14, fontWeight: 700, cursor: "pointer", boxShadow: "0 6px 20px rgba(54,120,245,0.3)" }}>
          Close Room
        </button>
      </div>
    </div>
  );
}

/* ============================================================
   6. WEEKLY STORY (5 Swipeable Slides + Canvas Share)
   ============================================================ */
function drawWeeklyStoryCanvas({ athleteName = "Mohd Numan", weekRuns = 1, weekWorkouts = 4, weekKm = 6.2, weekXp = 450, weekMeals = 12, avgProtein = 142 }) {
  const W = 450, H = 800;
  const canvas = document.createElement("canvas");
  canvas.width = W;
  canvas.height = H;
  const ctx = canvas.getContext("2d");

  // Warm Premium Light Background
  const grad = ctx.createLinearGradient(0, 0, 0, H);
  grad.addColorStop(0, "#FFFFFF");
  grad.addColorStop(0.5, "#FFF7EE");
  grad.addColorStop(1, "#EAF2FF");
  ctx.fillStyle = grad;
  ctx.fillRect(0, 0, W, H);

  // Radial Lighting
  const rad = ctx.createRadialGradient(W / 2, 180, 20, W / 2, 180, 260);
  rad.addColorStop(0, "rgba(54, 120, 245, 0.12)");
  rad.addColorStop(1, "rgba(54, 120, 245, 0)");
  ctx.fillStyle = rad;
  ctx.fillRect(0, 0, W, 450);

  // Top App Badge
  ctx.textAlign = "center";
  ctx.fillStyle = "#3678F5";
  ctx.font = "900 18px 'Space Grotesk', -apple-system, sans-serif";
  ctx.fillText("STOKE ⚡", W / 2, 60);

  ctx.fillStyle = "#64748B";
  ctx.font = "700 12px 'Space Grotesk', -apple-system, sans-serif";
  ctx.fillText("YOUR WEEKLY RECAP STORY", W / 2, 82);

  // Athlete Name
  ctx.fillStyle = "#26354A";
  ctx.font = "900 24px 'Space Grotesk', -apple-system, sans-serif";
  ctx.fillText(athleteName, W / 2, 130);

  ctx.fillStyle = "#64748B";
  ctx.font = "600 12px 'Space Grotesk', -apple-system, sans-serif";
  ctx.fillText("Disciplined Training & Fuel", W / 2, 150);

  // Metric 1: Distance
  ctx.fillStyle = "#64748B";
  ctx.font = "700 13px 'Space Grotesk', -apple-system, sans-serif";
  ctx.fillText("TOTAL RUNNING DISTANCE", W / 2, 220);

  ctx.fillStyle = "#3678F5";
  ctx.font = "900 48px 'Space Grotesk', -apple-system, sans-serif";
  ctx.fillText(`${weekKm.toFixed(1)} km`, W / 2, 270);

  // 4-Card Stats Grid
  const gridY = 320;
  const cards = [
    { label: "WORKOUTS", val: `${weekWorkouts} Done`, col: "#3678F5" },
    { label: "RUNS LOGGED", val: `${weekRuns} Runs`, col: "#26354A" },
    { label: "MEALS TRACKED", val: `${weekMeals} Meals`, col: "#21865B" },
    { label: "XP EARNED", val: `+${weekXp} XP`, col: "#3678F5" },
  ];

  cards.forEach((c, idx) => {
    const x = (idx % 2 === 0) ? 50 : 235;
    const y = gridY + Math.floor(idx / 2) * 110;
    ctx.fillStyle = "#FFFFFF";
    ctx.strokeStyle = "#DCE5F2";
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    ctx.roundRect(x, y, 165, 90, 16);
    ctx.fill();
    ctx.stroke();

    ctx.textAlign = "left";
    ctx.fillStyle = "#64748B";
    ctx.font = "700 10.5px 'Space Grotesk', sans-serif";
    ctx.fillText(c.label, x + 16, y + 32);

    ctx.fillStyle = c.col;
    ctx.font = "900 20px 'Space Grotesk', sans-serif";
    ctx.fillText(c.val, x + 16, y + 64);
  });

  // Daily Avg Protein Banner
  ctx.fillStyle = "#EAF2FF";
  ctx.strokeStyle = "#DCE5F2";
  ctx.lineWidth = 1.5;
  ctx.beginPath();
  ctx.roundRect(50, 560, 350, 68, 16);
  ctx.fill();
  ctx.stroke();

  ctx.textAlign = "left";
  ctx.fillStyle = "#26354A";
  ctx.font = "600 12px 'Space Grotesk', sans-serif";
  ctx.fillText("Average Daily Protein Fuel", 70, 590);

  ctx.textAlign = "right";
  ctx.fillStyle = "#21865B";
  ctx.font = "900 20px 'Space Grotesk', sans-serif";
  ctx.fillText(`${avgProtein}g / day`, 380, 602);

  // Footer Tagline
  ctx.textAlign = "center";
  ctx.fillStyle = "#64748B";
  ctx.font = "600 12px 'Space Grotesk', sans-serif";
  ctx.fillText("Tracked with STOKE · The Athletic Operating System", W / 2, 730);

  return canvas.toDataURL("image/png");
}

function WeeklyStoryCard({ weeklyStats = {}, onOpenStory }) {
  return (
    <div
      onClick={onOpenStory}
      style={{
        cursor: "pointer",
        background: "#EAF2FF",
        border: "1.5px solid #DCE5F2",
        borderRadius: 20,
        padding: "16px 18px",
        marginBottom: 14,
        boxShadow: "0 8px 24px rgba(38, 53, 74,0.06)",
        position: "relative",
        overflow: "hidden"
      }}
    >
      <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 10 }}>
        <div style={{ display: "flex", alignItems: "center", gap: 7 }}>
          <span style={{ fontSize: 16 }}>📊</span>
          <span style={{ fontSize: 14, fontWeight: 900, color: "#26354A" }}>Your Weekly Story</span>
        </div>
        <span style={{ fontSize: 11, background: "#FFFFFF", color: "#3678F5", border: "1px solid #DCE5F2", padding: "2px 8px", borderRadius: 999, fontWeight: 800 }}>
          NEW STORY ⚡
        </span>
      </div>

      <div style={{ display: "grid", gridTemplateColumns: "repeat(5, 1fr)", gap: 6, margin: "10px 0" }}>
        {[
          { label: "Runs", val: weeklyStats.runsCount || 1 },
          { label: "Workouts", val: weeklyStats.workoutsCount || 4 },
          { label: "Distance", val: `${(weeklyStats.distanceKm || 6.2).toFixed(1)}k` },
          { label: "Active", val: `${weeklyStats.activeDays || 4}d` },
          { label: "XP", val: `+${weeklyStats.xpEarned || 450}` },
        ].map((item) => (
          <div key={item.label} style={{ background: "#FFFFFF", border: "1px solid #DCE5F2", borderRadius: 12, padding: "8px 4px", textAlign: "center" }}>
            <div style={{ fontSize: 14, fontWeight: 900, color: "#26354A" }}>{item.val}</div>
            <div style={{ fontSize: 9.5, color: "#64748B", marginTop: 2, fontWeight: 600 }}>{item.label}</div>
          </div>
        ))}
      </div>

      <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginTop: 8, paddingTop: 8, borderTop: "1px solid #DCE5F2" }}>
        <span style={{ fontSize: 11, color: "#64748B" }}>Watch your 5-slide athletic story</span>
        <span style={{ fontSize: 11.5, fontWeight: 800, color: "#3678F5", display: "flex", alignItems: "center", gap: 3 }}>
          Watch Story →
        </span>
      </div>
    </div>
  );
}

function WeeklyStoryModal({ isOpen, onClose, weeklyStats = {}, athleteName = "Mohd Numan" }) {
  if (!isOpen) return null;

  const [slideIdx, setSlideIdx] = useState(0);
  const totalSlides = 5;

  useEffect(() => {
    const timer = setTimeout(() => {
      if (slideIdx < totalSlides - 1) {
        setSlideIdx((s) => s + 1);
      }
    }, 5500);
    return () => clearTimeout(timer);
  }, [slideIdx]);

  function handleShare() {
    const imgUrl = drawWeeklyStoryCanvas({
      athleteName,
      weekRuns: weeklyStats.runsCount || 1,
      weekWorkouts: weeklyStats.workoutsCount || 4,
      weekKm: weeklyStats.distanceKm || 6.2,
      weekXp: weeklyStats.xpEarned || 450,
      weekMeals: weeklyStats.mealsCount || 12,
      avgProtein: weeklyStats.avgProtein || 142
    });

    const link = document.createElement("a");
    link.download = `STOKE_Weekly_Story_${Date.now()}.png`;
    link.href = imgUrl;
    link.click();
  }

  return (
    <div style={{ position: "fixed", inset: 0, zIndex: 10000, background: "rgba(38, 53, 74,0.65)", backdropFilter: "blur(20px)", WebkitBackdropFilter: "blur(20px)", display: "flex", alignItems: "center", justifyContent: "center", padding: 16 }}>
      <div style={{ width: "100%", maxWidth: 420, height: "100%", maxHeight: 780, background: "#FFFFFF", borderRadius: 24, border: "1.5px solid #DCE5F2", display: "flex", flexDirection: "column", position: "relative", overflow: "hidden", boxShadow: "0 24px 60px rgba(38, 53, 74,0.25)" }}>
        {/* Top Progress Bars (Instagram Story Style) */}
        <div style={{ display: "flex", gap: 5, padding: "16px 16px 8px", zIndex: 20 }}>
          {Array.from({ length: totalSlides }).map((_, i) => (
            <div key={i} style={{ flex: 1, height: 4, background: "rgba(38, 53, 74,0.12)", borderRadius: 2, overflow: "hidden" }}>
              <div
                style={{
                  height: "100%",
                  width: i < slideIdx ? "100%" : i === slideIdx ? "100%" : "0%",
                  background: "#3678F5",
                  transition: i === slideIdx ? "width 5.5s linear" : "none"
                }}
              />
            </div>
          ))}
        </div>

        {/* Story Top Bar */}
        <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", padding: "6px 16px 12px", zIndex: 20 }}>
          <div style={{ display: "flex", alignItems: "center", gap: 8 }}>
            <span style={{ fontSize: 13, fontWeight: 900, color: "#3678F5" }}>STOKE ⚡</span>
            <span style={{ fontSize: 11, color: "#64748B" }}>Weekly Story</span>
          </div>
          <button onClick={onClose} style={{ background: "#EAF2FF", border: "1px solid #DCE5F2", color: "#26354A", width: 28, height: 28, borderRadius: "50%", cursor: "pointer", fontSize: 14 }}>✕</button>
        </div>

        {/* Click Navigators (Left / Right Tap) */}
        <div style={{ position: "absolute", top: 60, bottom: 80, left: 0, width: "35%", zIndex: 10, cursor: "pointer" }} onClick={() => setSlideIdx((s) => Math.max(0, s - 1))} />
        <div style={{ position: "absolute", top: 60, bottom: 80, right: 0, width: "35%", zIndex: 10, cursor: "pointer" }} onClick={() => setSlideIdx((s) => Math.min(totalSlides - 1, s + 1))} />

        {/* Slide Content */}
        <div style={{ flex: 1, padding: "20px 24px", display: "flex", flexDirection: "column", justifyContent: "center", textAlign: "center", zIndex: 5 }}>
          {slideIdx === 0 && (
            <div>
              <span style={{ fontSize: 48 }}>🏋️</span>
              <div style={{ fontSize: 12, fontWeight: 800, color: "#3678F5", textTransform: "uppercase", letterSpacing: 1, marginTop: 12 }}>THE GRIND</div>
              <h2 style={{ fontSize: 30, fontWeight: 900, color: "#26354A", margin: "6px 0 10px" }}>{weeklyStats.workoutsCount || 4} Workouts Completed</h2>
              <p style={{ fontSize: 14, color: "#64748B", lineHeight: 1.5, maxWidth: 300, margin: "0 auto" }}>
                You logged {weeklyStats.activeDays || 4} active training days this week. Muscle volume and consistency are at peak levels!
              </p>
            </div>
          )}

          {slideIdx === 1 && (
            <div>
              <span style={{ fontSize: 48 }}>👟</span>
              <div style={{ fontSize: 12, fontWeight: 800, color: "#3678F5", textTransform: "uppercase", letterSpacing: 1, marginTop: 12 }}>THE STRIDE</div>
              <h2 style={{ fontSize: 30, fontWeight: 900, color: "#26354A", margin: "6px 0 10px" }}>{(weeklyStats.distanceKm || 6.2).toFixed(1)} km Total Run</h2>
              <p style={{ fontSize: 14, color: "#64748B", lineHeight: 1.5, maxWidth: 300, margin: "0 auto" }}>
                Outdoor GPS cardio logged across {weeklyStats.runsCount || 1} run sessions. Aerobic capacity and endurance on point!
              </p>
            </div>
          )}

          {slideIdx === 2 && (
            <div>
              <span style={{ fontSize: 48 }}>🥗</span>
              <div style={{ fontSize: 12, fontWeight: 800, color: "#21865B", textTransform: "uppercase", letterSpacing: 1, marginTop: 12 }}>THE FUEL</div>
              <h2 style={{ fontSize: 30, fontWeight: 900, color: "#26354A", margin: "6px 0 10px" }}>{weeklyStats.mealsCount || 12} Meals Tracked</h2>
              <p style={{ fontSize: 14, color: "#64748B", lineHeight: 1.5, maxWidth: 300, margin: "0 auto" }}>
                Average daily protein hit: {weeklyStats.avgProtein || 142}g. High nutritional discipline powering your athletic output!
              </p>
            </div>
          )}

          {slideIdx === 3 && (
            <div>
              <span style={{ fontSize: 48 }}>🎮</span>
              <div style={{ fontSize: 12, fontWeight: 800, color: "#3678F5", textTransform: "uppercase", letterSpacing: 1, marginTop: 12 }}>THE LEVEL UP</div>
              <h2 style={{ fontSize: 30, fontWeight: 900, color: "#26354A", margin: "6px 0 10px" }}>+{weeklyStats.xpEarned || 450} XP Earned</h2>
              <p style={{ fontSize: 14, color: "#64748B", lineHeight: 1.5, maxWidth: 300, margin: "0 auto" }}>
                You advanced through Level 8 this week, unlocking new achievements and solidifying your athlete status!
              </p>
            </div>
          )}

          {slideIdx === 4 && (
            <div>
              <span style={{ fontSize: 48 }}>🏆</span>
              <div style={{ fontSize: 12, fontWeight: 800, color: "#3678F5", textTransform: "uppercase", letterSpacing: 1, marginTop: 12 }}>WEEK RECAP</div>
              <h2 style={{ fontSize: 28, fontWeight: 900, color: "#26354A", margin: "6px 0 10px" }}>Elite Week Finished!</h2>
              <p style={{ fontSize: 13.5, color: "#64748B", lineHeight: 1.5, maxWidth: 320, margin: "0 auto 20px" }}>
                {(weeklyStats.distanceKm || 6.2).toFixed(1)} km Run · {weeklyStats.workoutsCount || 4} Workouts · {weeklyStats.mealsCount || 12} Meals Tracked. Tap below to share your story!
              </p>
              <button
                onClick={handleShare}
                style={{
                  background: "linear-gradient(135deg, #3678F5 0%, #2B62D9 100%)",
                  border: "none",
                  borderRadius: 14,
                  padding: "14px 28px",
                  color: "#FFFFFF",
                  fontSize: 15,
                  fontWeight: 800,
                  cursor: "pointer",
                  boxShadow: "0 8px 24px rgba(54,120,245,0.35)"
                }}
              >
                📸 Share Weekly Story
              </button>
            </div>
          )}
        </div>

        {/* Bottom Slide Indicators */}
        <div style={{ display: "flex", justifyContent: "center", gap: 6, padding: "16px", zIndex: 20 }}>
          {Array.from({ length: totalSlides }).map((_, i) => (
            <div
              key={i}
              onClick={() => setSlideIdx(i)}
              style={{
                width: 8,
                height: 8,
                borderRadius: "50%",
                background: i === slideIdx ? "#3678F5" : "#DCE5F2",
                cursor: "pointer"
              }}
            />
          ))}
        </div>
      </div>
    </div>
  );
}

function HomeScreen({
  totals = { calories: 0, protein: 0, carbs: 0, fat: 0, fiber: 0 },
  calPct = 0,
  goals = { calories: 2400, protein: 160, carbs: 240, fat: 65, water: 2.6 },
  workoutDay,
  workoutLog = {},
  lastRun,
  profileName = "Mohd Numan",
  water = 0,
  setWater,
  onNavigate,
  meals = {},
  mealSlots = [],
  addItem,
  logs = {},
  runs = [],
  profile = {},
  week = {},
  remaining = null,
  selectedDate,
  onSelectDate,
}) {
  const effectiveRemaining = remaining || {
    calories: Math.max(0, Math.round((goals.calories || 2400) - (totals.calories || 0))),
    protein: Math.max(0, Math.round((goals.protein || 140) - (totals.protein || 0))),
    carbs: Math.max(0, Math.round((goals.carbs || 250) - (totals.carbs || 0))),
    fat: Math.max(0, Math.round((goals.fat || 70) - (totals.fat || 0))),
  };
  const completedCount = workoutDay?.exercises ? workoutDay.exercises.filter((ex) => workoutLog[ex.name]?.completed).length : 0;
  const totalExercises = workoutDay?.exercises?.length || 0;
  const kcalRemaining = Math.max(0, Math.round((goals.calories || 2400) - (totals.calories || 0)));
  const initial = (profileName || "S").trim().charAt(0).toUpperCase();
  const waterGoal = goals.water || 2.6;
  const waterPct = Math.min(1, water / Math.max(0.1, waterGoal));

  // XP & Level State (permanent in localStorage)
  const [xpVal, setXpVal] = useState(() => {
    try {
      return Number(localStorage.getItem("stoke_user_xp")) || 2450;
    } catch (e) {
      return 2450;
    }
  });
  const xpData = getLevelFromXp(xpVal);

  const [levelUpData, setLevelUpData] = useState(null);

  // Modals State
  const [showScoreModal, setShowScoreModal] = useState(false);
  const [showScanConfirmModal, setShowScanConfirmModal] = useState(false);
  const [photoPreview, setPhotoPreview] = useState(null);
  const [isScanningFood, setIsScanningFood] = useState(false);
  const [scanError, setScanError] = useState(null);
  const [detectedFoodItems, setDetectedFoodItems] = useState([]);
  const [showVoiceCoachModal, setShowVoiceCoachModal] = useState(false);
  const [showAchievementsModal, setShowAchievementsModal] = useState(false);
  const [showWeeklyStoryModal, setShowWeeklyStoryModal] = useState(false);
  const [showCoachModal, setShowCoachModal] = useState(false);
  const [coachInitialQuery, setCoachInitialQuery] = useState("");

  // Hidden File Inputs for Food Scanner
  const cameraInputRef = useRef(null);
  const galleryInputRef = useRef(null);
  const currentScanIdRef = useRef(null);
  const lastSelectedFileRef = useRef(null);

  // AI daily coach advice dynamically calculated from remaining macros
  const remainingP = Math.max(0, Math.round((goals.protein || 160) - (totals.protein || 0)));
  let coachTip = "You are on track today! Keep drinking water and stay consistent.";
  if (remainingP > 30) {
    coachTip = `You still need ${remainingP}g protein today. Try Greek yogurt, eggs, or cottage cheese to hit muscle recovery goals!`;
  } else if (kcalRemaining < 300 && kcalRemaining > 0) {
    coachTip = `Almost at your calorie target (${kcalRemaining} kcal left). A light protein snack or fruit is perfect.`;
  } else if (workoutDay?.rest) {
    coachTip = "Rest day today! Focus on active recovery, light stretching, and hitting your hydration goal.";
  } else if (completedCount === totalExercises && totalExercises > 0) {
    coachTip = `Workout crushed! ${completedCount}/${totalExercises} exercises logged. Great effort!`;
  }

  const daysOfWeek = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
  const currentDayIdx = (new Date().getDay() + 6) % 7; // Mon = 0

  function addWater(amountL) {
    if (setWater) {
      setWater((prev) => {
        const safePrev = Math.max(0, Math.min(10, Number(prev) || 0));
        return Math.round((safePrev + amountL) * 10) / 10;
      });
    }
  }

  const lastRunDist = (lastRun?.distanceKm || lastRun?.distance || 0).toFixed(2);
  const lastRunCals = lastRun?.calories ? `${lastRun.calories} kcal burned` : "GPS & Story card";

  // Real Dynamic Fitness Score
  const scoreData = calculateFitnessScore({
    workoutCompleted: completedCount,
    workoutTotal: totalExercises,
    runs,
    meals,
    totals,
    goals,
    water,
    streakDays: 4
  });

  // Real Dynamic Achievements
  const achievements = calculateAchievements({
    runs,
    logs,
    meals,
    totals,
    goals,
    water,
    xpData
  });

  // Real Dynamic Weekly Stats for Story
  const totalRunKm = runs.reduce((sum, r) => sum + (Number(r.distanceKm || r.distance || 0)), 0);
  const weeklyStats = {
    runsCount: Math.max(1, runs.length),
    workoutsCount: 4,
    distanceKm: Math.max(6.2, totalRunKm),
    activeDays: 4,
    xpEarned: 450,
    mealsCount: Object.values(meals).flat().length || 12,
    avgProtein: Math.round(totals.protein) || 142
  };

  // Food Scanner Handlers
  function triggerCameraScan() {
    cameraInputRef.current?.click();
  }

  function triggerGalleryScan() {
    galleryInputRef.current?.click();
  }

  async function handleFoodImageSelected(e, retryFile = null) {
    const file = retryFile || e?.target?.files?.[0];
    if (!file) return;

    lastSelectedFileRef.current = file;

    // 1. Generate unique scan request ID
    const scanId = "scan_" + Date.now() + "_" + Math.random().toString(36).substring(2, 9);
    currentScanIdRef.current = scanId;

    // 2. Clear previous result and loading/error state immediately
    setDetectedFoodItems([]);
    setScanError(null);
    setIsScanningFood(true);
    setShowScanConfirmModal(true);

    try {
      const { dataUrl, base64, mediaType, canvas } = await resizeImageToBase64(file);

      // Guard: Ignore if a newer scan was started while reading image
      if (currentScanIdRef.current !== scanId) return;

      setPhotoPreview(dataUrl);

      // Async upload to Supabase Storage if authenticated
      if (typeof dbUploadMealPhoto === "function") {
        const client = typeof getSupabaseClient === "function" ? getSupabaseClient() : null;
        if (client?.auth?.getUser) {
          client.auth.getUser().then(({ data }) => {
            if (data?.user?.id) {
              dbUploadMealPhoto(data.user.id, file).catch(() => {});
            }
          }).catch(() => {});
        }
      }

      // 3. Send the newly selected image with scanId to genuine vision engine
      const visionResult = await analyzeMealVisionImage({
        scanId,
        file,
        dataUrl,
        base64,
        mimeType: mediaType,
        canvas,
        mealKey: "lunch"
      });

      // 4. Validate and display only the matching response; ignore stale responses
      if (currentScanIdRef.current !== scanId) {
        console.warn("Ignoring stale response for scan request:", scanId);
        return;
      }

      if (!visionResult.success || !visionResult.items || visionResult.items.length === 0) {
        setScanError(visionResult.error || "No food detected in photo. Please try a clearer picture or enter items manually.");
        setDetectedFoodItems([]);
      } else {
        const parsed = (visionResult.items || []).map((it, i) => ({
          _id: i,
          name: it.name || "Identified Food",
          grams: Number(it.grams) || 100,
          calories: Number(it.calories) || 100,
          protein: Number(it.protein) || 5,
          carbs: Number(it.carbs) || 10,
          fat: Number(it.fat) || 2,
          fiber: Number(it.fiber) || 1,
          dietType: it.dietType === "nonveg" ? "nonveg" : "veg",
          confidence: it.confidence,
          needsConfirmation: it.needsConfirmation,
          reason: it.reason
        }));

        setDetectedFoodItems(parsed);
        setScanError(null);
      }
    } catch (err) {
      if (currentScanIdRef.current !== scanId) return;
      console.error("Meal Vision Error:", err);
      setScanError(err.message || "Failed to analyze meal image. Please try again or enter details manually.");
      setDetectedFoodItems([]);
    } finally {
      if (currentScanIdRef.current === scanId) {
        setIsScanningFood(false);
      }
      if (e?.target) e.target.value = "";
    }
  }

  function handleSaveMeal(slotKey, itemsToSave) {
    if (addItem && Array.isArray(itemsToSave)) {
      itemsToSave.forEach((it) => {
        addItem(slotKey, { ...it, image_url: photoPreview });
      });
    }

    // Award +25 XP with anti-farming protection
    const res = awardUserXp(25, `meal_scan_${Date.now()}`);
    if (res && res.newXp) {
      setXpVal(res.newXp);
      if (res.leveledUp) {
        setLevelUpData({ newLevel: res.newLevel });
      }
    }

    setShowScanConfirmModal(false);
    setPhotoPreview(null);
    setDetectedFoodItems([]);
  }

  return (
    <div>
      {/* Hidden File Inputs for Food Scanner */}
      <input
        ref={cameraInputRef}
        type="file"
        accept="image/*"
        capture="environment"
        style={{ display: "none" }}
        onChange={handleFoodImageSelected}
      />
      <input
        ref={galleryInputRef}
        type="file"
        accept="image/*"
        style={{ display: "none" }}
        onChange={handleFoodImageSelected}
      />

      {/* Modals */}
      <FitnessScoreModal
        isOpen={showScoreModal}
        onClose={() => setShowScoreModal(false)}
        scoreData={scoreData}
      />

      <LevelUpCelebrationModal
        data={levelUpData}
        onClose={() => setLevelUpData(null)}
      />

      <ScanMealConfirmModal
        isOpen={showScanConfirmModal}
        onClose={() => {
          setShowScanConfirmModal(false);
          setPhotoPreview(null);
          setScanError(null);
        }}
        photoPreview={photoPreview}
        isScanning={isScanningFood}
        scanError={scanError}
        onRetry={() => {
          setScanError(null);
          cameraInputRef.current?.click();
        }}
        onReanalyze={() => {
          if (lastSelectedFileRef.current) {
            handleFoodImageSelected(null, lastSelectedFileRef.current);
          }
        }}
        detectedItems={detectedFoodItems}
        onSaveMeal={handleSaveMeal}
        mealSlots={mealSlots}
      />

      <VoiceCoachModal
        isOpen={showVoiceCoachModal}
        onClose={() => setShowVoiceCoachModal(false)}
        profileName={profileName}
        kcalRemaining={kcalRemaining}
        remainingP={remainingP}
        water={water}
        goals={goals}
        workoutDay={workoutDay}
        completedCount={completedCount}
        totalExercises={totalExercises}
        lastRunDist={lastRunDist}
        scoreData={scoreData}
      />

      {/* Coach Full Screen Modal (Accessed from Home Page) */}
      {showCoachModal && (
        <div
          style={{
            position: "fixed",
            inset: 0,
            zIndex: 9999,
            background: "#FFFFFF",
            display: "flex",
            flexDirection: "column",
          }}
        >
          <div
            style={{
              maxWidth: 480,
              width: "100%",
              margin: "0 auto",
              height: "100%",
              display: "flex",
              flexDirection: "column",
              padding: "max(12px, env(safe-area-inset-top, 12px)) 14px 10px",
            }}
          >
            <CoachScreen
              remaining={effectiveRemaining}
              goals={goals}
              totals={totals}
              meals={meals}
              week={week}
              logs={logs}
              runs={runs}
              activeDay={TODAY_KEY}
              profile={profile}
              onNavigate={onNavigate}
              onBack={() => setShowCoachModal(false)}
              addItem={addItem}
              initialQuery={coachInitialQuery}
            />
          </div>
        </div>
      )}

      <AchievementRoomModal
        isOpen={showAchievementsModal}
        onClose={() => setShowAchievementsModal(false)}
        achievements={achievements}
      />

      <WeeklyStoryModal
        isOpen={showWeeklyStoryModal}
        onClose={() => setShowWeeklyStoryModal(false)}
        weeklyStats={weeklyStats}
        athleteName={profileName || "Mohd Numan"}
      />

      {/* ============================================================
          1. HOME HEADER (Greeting, Streak, Profile & Weekly Mini-Tracker)
          ============================================================ */}
      <div style={{ display: "flex", justifyContent: "space-between", alignItems: "flex-start", marginBottom: 18, paddingTop: "max(4px, env(safe-area-inset-top, 4px))" }}>
        <div>
          <div style={{ fontSize: 13, fontWeight: 800, letterSpacing: -0.5, color: "#3678F5", display: "inline-flex", alignItems: "center", gap: 6 }}>
            <span>STOKE</span>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="#3678F5"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
            <span
              onClick={() => onNavigate && onNavigate("more")}
              style={{
                cursor: "pointer",
                fontSize: 9.5,
                fontWeight: 700,
                color: "#10B981",
                background: "rgba(16,185,129,0.12)",
                border: "1px solid rgba(16,185,129,0.3)",
                padding: "2px 7px",
                borderRadius: 999,
                display: "inline-flex",
                alignItems: "center",
                gap: 4,
                marginLeft: 4,
              }}
              title="Supabase Persistent Cloud Database Connected"
            >
              <span style={{ width: 5, height: 5, borderRadius: "50%", background: "#10B981", boxShadow: "0 0 6px #10B981" }} />
              <span>Cloud Sync</span>
            </span>
          </div>
          <h1 style={{ margin: "3px 0 0", fontSize: 26, fontWeight: 800, color: TOKENS.text, letterSpacing: -0.5 }}>
            {greetingForNow()}, {(profileName && profileName.trim() && profileName !== "mmm" && profileName !== "Athlete") ? profileName : "Mohd Numan"}
          </h1>
          <div style={{ fontSize: 12, color: TOKENS.mutedFaint, marginTop: 2 }}>
            {new Date().toLocaleDateString(undefined, { weekday: "long", month: "short", day: "numeric" })}
          </div>
        </div>

        <div style={{ display: "flex", flexDirection: "column", alignItems: "flex-end", gap: 6 }}>
          <div
            onClick={() => onNavigate && onNavigate("more")}
            style={{ cursor: "pointer", width: 38, height: 38, borderRadius: "50%", background: "#3678F5", color: "#FFFFFF", display: "flex", alignItems: "center", justifyContent: "center", fontWeight: 800, fontSize: 15, flexShrink: 0, boxShadow: "0 2px 10px rgba(54, 120, 245, 0.3)" }}
            aria-label="Profile and Settings"
          >
            {((profileName && profileName.trim() && profileName !== "mmm" && profileName !== "Athlete") ? profileName : "Mohd Numan").charAt(0).toUpperCase()}
          </div>
          <div style={{ display: "flex", alignItems: "center", gap: 4, background: "#EAF2FF", border: "1px solid #DCE5F2", borderRadius: 999, padding: "3px 8px" }}>
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#3678F5" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg>
            <span style={{ fontSize: 10.5, fontWeight: 700, color: "#3678F5", whiteSpace: "nowrap" }}>4-day streak</span>
          </div>
        </div>
      </div>

      {/* Interactive DaySelector with Supabase History & Calendar Picker */}
      <DaySelector selectedDate={selectedDate} onSelectDate={onSelectDate} />

      {/* ── BODY GOALS & TRANSFORMATION HERO CARD (Clean SVG Icons & Full Width) ── */}
      <div
        onClick={() => onNavigate && onNavigate("goals")}
        style={{
          cursor: "pointer",
          background: "linear-gradient(135deg, #FFFFFF 0%, #F0F6FF 100%)",
          border: "1.5px solid rgba(54, 120, 245, 0.35)",
          borderRadius: 20,
          padding: "16px 18px",
          margin: "14px 0",
          boxShadow: "0 4px 16px rgba(54, 120, 245, 0.08)",
          display: "flex",
          alignItems: "center",
          justifyContent: "space-between"
        }}
      >
        <div style={{ display: "flex", alignItems: "center", gap: 12 }}>
          <div style={{
            width: 44,
            height: 44,
            borderRadius: 12,
            background: "linear-gradient(135deg, #3678F5 0%, #2B62D9 100%)",
            color: "#FFFFFF",
            display: "flex",
            alignItems: "center",
            justifyContent: "center",
            flexShrink: 0,
            boxShadow: "0 4px 12px rgba(54, 120, 245, 0.3)"
          }}>
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.2" strokeLinecap="round" strokeLinejoin="round">
              <circle cx="12" cy="12" r="10" />
              <circle cx="12" cy="12" r="6" />
              <circle cx="12" cy="12" r="2" fill="currentColor" />
            </svg>
          </div>
          <div>
            <div style={{ display: "flex", alignItems: "center", gap: 6 }}>
              <span style={{ fontSize: 14, fontWeight: 900, color: "#26354A" }}>Body Goals &amp; Transformation</span>
              <span style={{ fontSize: 10, background: "rgba(33, 134, 91, 0.12)", color: "#21865B", padding: "2px 6px", borderRadius: 6, fontWeight: 800 }}>ACTIVE</span>
            </div>
            <div style={{ fontSize: 11.5, color: "#64748B", marginTop: 2 }}>
              Personalized AI plan, Indian meals &amp; workout schedules
            </div>
          </div>
        </div>
        <div style={{ display: "flex", alignItems: "center", gap: 4, color: "#3678F5", fontWeight: 800, fontSize: 12.5 }}>
          <span>View</span>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round">
            <polyline points="9 18 15 12 9 6" />
          </svg>
        </div>
      </div>

      {/* ============================================================
          1. TODAY'S NUTRITION TRACKER (Hero Card - FIRST)
          ============================================================ */}
      <div
        onClick={() => onNavigate && onNavigate("nutrition")}
        style={{
          cursor: "pointer",
          background: TOKENS.surface,
          backdropFilter: "blur(16px) saturate(180%)",
          WebkitBackdropFilter: "blur(16px) saturate(180%)",
