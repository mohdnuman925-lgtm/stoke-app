            </div>
          </div>
          <Ring progress={calPct} size={84} stroke={8} color={calPct > 1 ? TOKENS.ember : TOKENS.lime}>
            <div style={{ textAlign: "center" }}>
              <div style={{ fontSize: 16, fontWeight: 800, color: TOKENS.text }}>{Math.round(calPct * 100)}%</div>
            </div>
          </Ring>
        </div>

        <div style={{ display: "flex", gap: 14 }}>
          <MiniMacroCard label="Protein" value={totals.protein || 0} goal={goals.protein || 160} color={TOKENS.lime} />
          <MiniMacroCard label="Carbs" value={totals.carbs || 0} goal={goals.carbs || 240} color={TOKENS.water} />
          <MiniMacroCard label="Fat" value={totals.fat || 0} goal={goals.fat || 65} color={TOKENS.ember} />
        </div>
      </div>

      {/* ============================================================
          2. LARGE SCAN YOUR MEAL CARD (AI Food Vision - SECOND)
          ============================================================ */}
