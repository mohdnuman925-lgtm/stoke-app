            </div>
            <div style={{ fontSize: 10, color: "#64748B", marginTop: 3, lineHeight: 1.2 }}>
              Consistency Index
            </div>
          </div>
        </div>

        <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginTop: 4, paddingTop: 6, borderTop: "1px solid #DCE5F2" }}>
          <span style={{ fontSize: 10, color: "#64748B" }}>Hydration & Lift</span>
          <span style={{ fontSize: 10.5, fontWeight: 800, color: "#3678F5", display: "flex", alignItems: "center", gap: 2 }}>
            View Details →
          </span>
        </div>
      </div>

      {/* Card 2: Fitness Level + XP */}
