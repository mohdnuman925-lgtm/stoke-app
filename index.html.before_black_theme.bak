        athleteName={profileName || "Athlete"}
        remCal={effectiveRemaining.calories}
        remP={effectiveRemaining.protein}
        coachTip={coachTip}
        onOpenCoach={() => { setCoachInitialQuery(""); setShowCoachModal(true); }}
        onOpenVoice={() => setShowVoiceCoachModal(true)}
        onQuickAsk={(query) => { setCoachInitialQuery(query); setShowCoachModal(true); }}
      />

      {/* ============================================================
          3. FITNESS SCORE (0-100) + FITNESS LEVEL/XP (Beside each other)
          ============================================================ */}
      <FitnessScoreAndXpCard
        scoreData={scoreData}
        xpData={xpData}
        onViewScoreDetails={() => setShowScoreModal(true)}
      />

      {/* Hydration Card */}
      <div
        style={{
          background: "#EAF2FF",
          border: "1px solid #DCE5F2",
          borderRadius: 20,
          padding: "16px 18px",
          marginBottom: 14,
          boxShadow: "0 4px 16px rgba(38, 53, 74,0.08)",
        }}
      >
        <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 10 }}>
          <div style={{ display: "flex", alignItems: "center", gap: 8 }}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#3DDCFF" strokeWidth="2.2" strokeLinecap="round" strokeLinejoin="round"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/></svg>
            <span style={{ fontSize: 13, fontWeight: 700, color: TOKENS.text }}>Daily Hydration</span>
          </div>
          <div style={{ display: "flex", alignItems: "center", gap: 8 }}>
            <span style={{ fontSize: 13, fontWeight: 800, color: TOKENS.water }}>
              {Math.max(0, Math.min(10, Number(water) || 0)).toFixed(1)} <span style={{ fontSize: 11, color: TOKENS.mutedFaint, fontWeight: 500 }}>/ {waterGoal}L</span>
            </span>
            <button
              onClick={(e) => { e.stopPropagation(); setWater && setWater(0); }}
