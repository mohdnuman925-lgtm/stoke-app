}

// ============================================================================
// MAIN RUN SCREEN (Complete Multi-Sport Engine)
// ============================================================================
function RunScreen({
  profile,
  runs = [],
  setRuns = () => {},
  status = "idle",
  elapsed = 0,
  distanceKm = 0,
  setDistanceKm = () => {},
  gpsError = null,
  accuracy = null,
  gpsStatus = "acquiring",
  liveSpeed = 0,
  maxSpeed = 0,
  elevationGain = 0,
  shareCardUrl = null,
  shareStyle = "dark",
  onChangeStyle = () => {},
  pathRef = null,
  handleStart = () => {},
  handlePause = () => {},
  handleResume = () => {},
  handleFinish = () => {},
  handleReset = () => {},
  handleDiscard = () => {},
  liveGpsPos = null,
  runStartTimeRef = null,
  onNavigate = () => {},
  onBack = () => {},
  currentUser = null
}) {
  // Selected Sport State (Persistent)
  const [selectedSportId, setSelectedSportId] = useState(() => {
    if (typeof localStorage !== "undefined") {
      try {
        const saved = localStorage.getItem("stoke_selected_sport");
        if (saved && ALL_SPORTS.some(s => s.id === saved)) return saved;
      } catch (e) {}
    }
    return "run";
  });

  const currentSport = useMemo(() => {
    return ALL_SPORTS.find(s => s.id === selectedSportId) || ALL_SPORTS[0];
  }, [selectedSportId]);

  const handleSelectSport = (sportId) => {
    setSelectedSportId(sportId);
    if (typeof localStorage !== "undefined") {
      try {
        localStorage.setItem("stoke_selected_sport", sportId);
      } catch (e) {}
    }
  };

  // Modals & Sheets State
  const [isSportSheetOpen, setIsSportSheetOpen] = useState(false);
  const [isRouteModalOpen, setIsRouteModalOpen] = useState(false);
  const [isWorkoutModalOpen, setIsWorkoutModalOpen] = useState(false);
  const [isSensorModalOpen, setIsSensorModalOpen] = useState(false);
  const [activeRoute, setActiveRoute] = useState(null);
  const [activeWorkoutTarget, setActiveWorkoutTarget] = useState(null);
  const [showGpsTooltip, setShowGpsTooltip] = useState(false);

  // Sub-tabs & Stages State
  const [activeSubTab, setActiveSubTab] = useState("tracker"); // "tracker" | "history" | "challenges" | "leaderboard"
  const [runStage, setRunStage] = useState("map_idle"); // "map_idle" | "map_active" | "paused" | "hud_fullscreen" | "summary" | "activity_detail"
  const [historyFilter, setHistoryFilter] = useState("daily");
  const [historySportFilter, setHistorySportFilter] = useState("all");
  const [selectedHistoryActivity, setSelectedHistoryActivity] = useState(null);

  // Map Controls State
  const [mapTileType, setMapTileType] = useState("dark"); // Default Dark Matter!
  const [is3DTilted, setIs3DTilted] = useState(false);
  const [audioCues, setAudioCues] = useState(true);
  const [selectedVoice, setSelectedVoice] = useState("lily");
  const [showDiscardModal, setShowDiscardModal] = useState(false);

  // Real GPS & Location State
  const [userPos, setUserPos] = useState([28.6139, 77.2090]);
  const [reverseGeoAddress, setReverseGeoAddress] = useState("");
  const [activityTitle, setActivityTitle] = useState(() => getActivityTitleByTime(new Date(), currentSport.id));
  const [summaryActivity, setSummaryActivity] = useState(null);
  const [showToast, setShowToast] = useState(null);
  const [isSavingToDb, setIsSavingToDb] = useState(false);

  // Story Share Card State
  const [showStoryModal, setShowStoryModal] = useState(false);
  const [cardPhoto, setCardPhoto] = useState(null);
  const [generatedCardUrl, setGeneratedCardUrl] = useState(null);
  const lastAnnouncedKmRef = useRef(0);
  const [challenges, setChallenges] = useState(INITIAL_CHALLENGES);
  const [leaderboardFilter, setLeaderboardFilter] = useState("worldwide");

  const activePersona = (typeof GIRL_VOICES !== "undefined" && GIRL_VOICES.length > 0)
    ? (GIRL_VOICES.find((v) => v.id === selectedVoice) || GIRL_VOICES[0])
    : { name: "Lily", startMsg: () => "Workout started. GPS locked.", splitMsg: (km, m, s) => `Kilometer ${km}. Pace: ${m} minutes ${s} seconds.`, pauseMsg: "Workout paused.", resumeMsg: "Resuming workout.", finishMsg: (d) => `Workout finished. Great job!` };

  // Sync userPos directly with real live outdoor GPS position
  useEffect(() => {
    if (liveGpsPos && Array.isArray(liveGpsPos) && liveGpsPos.length === 2 && !isNaN(liveGpsPos[0])) {
      setUserPos(liveGpsPos);
    }
  }, [liveGpsPos]);

  // Reverse geocode real coordinates on load or significant position change
  useEffect(() => {
    if (!liveGpsPos || !Array.isArray(liveGpsPos) || isNaN(liveGpsPos[0])) return;
    const [lat, lng] = liveGpsPos;
    let isCancelled = false;

    fetch(`https://nominatim.openstreetmap.org/reverse?lat=${lat}&lon=${lng}&format=json`)
      .then((r) => r.json())
      .then((data) => {
        if (isCancelled) return;
        const addr = data.address || {};
        const neighbourhood = addr.suburb || addr.neighbourhood || addr.residential || addr.road || "";
        const city = addr.city || addr.town || addr.village || addr.state_district || "Local Area";
        const label = neighbourhood ? `${neighbourhood}, ${city}` : city;
        setReverseGeoAddress(label);
      })
      .catch(() => {
        if (!isCancelled) setReverseGeoAddress("Live GPS Location");
      });

    return () => { isCancelled = true; };
  }, [liveGpsPos]);

  // Sync runStage with parent status
  useEffect(() => {
    if (status === "active" && runStage !== "map_active" && runStage !== "hud_fullscreen") {
      setRunStage("map_active");
    } else if (status === "paused" && runStage !== "paused") {
      setRunStage("paused");
    } else if (status === "idle" && runStage !== "map_idle" && runStage !== "summary" && runStage !== "activity_detail") {
      setRunStage("map_idle");
    }
  }, [status]);

  // Real-time calculations
  const liveDist = distanceKm > 0 ? distanceKm : 0;
  const hasValidDistance = liveDist >= 0.02;
  const livePace = (hasValidDistance && elapsed > 0) ? (elapsed / 60 / liveDist) : 0;
  const currentSpeed = liveSpeed > 0 ? liveSpeed : ((hasValidDistance && elapsed > 0) ? (liveDist / (elapsed / 3600)) : 0);
  const metFactor = currentSport.category === "Cycle Sports" ? 0.55 : currentSport.category === "Strength" ? 0.8 : 1.036;
  const liveCalories = Math.round(liveDist * (RUNNER_WEIGHT_KG || 70) * metFactor) || Math.round(elapsed * 0.16);
  const liveElevation = elevationGain || 0;

  // Voice split milestone announcements
  useEffect(() => {
    if (status === "active" && audioCues && distanceKm >= 1) {
      const currentKm = Math.floor(distanceKm);
      if (currentKm > lastAnnouncedKmRef.current) {
        lastAnnouncedKmRef.current = currentKm;
        const paceM = Math.floor(livePace);
        const paceS = Math.round((livePace % 1) * 60);
        const msg = activePersona.splitMsg(currentKm, paceM, paceS, currentSpeed, currentSport.category === "Cycle Sports");
        if (typeof speakAudioCue === "function") speakAudioCue(msg, selectedVoice);
      }
    }
  }, [distanceKm, status, audioCues, livePace, currentSpeed, currentSport, selectedVoice, activePersona]);

  // Action handlers
  const onStartActivity = () => {
    lastAnnouncedKmRef.current = 0;
    setRunStage("map_active");
    if (audioCues && typeof speakAudioCue === "function") {
      speakAudioCue(activePersona.startMsg(currentSport.id), selectedVoice);
    }
    handleStart(currentSport.id);
    const now = new Date();
    setActivityTitle(getActivityTitleByTime(now, currentSport.id));
  };

  const onPauseActivity = () => {
    setRunStage("paused");
    if (audioCues && typeof speakAudioCue === "function") {
      speakAudioCue(activePersona.pauseMsg, selectedVoice);
    }
    handlePause();
  };

  const onResumeActivity = () => {
    setRunStage("map_active");
    if (audioCues && typeof speakAudioCue === "function") {
      speakAudioCue(activePersona.resumeMsg, selectedVoice);
    }
    handleResume();
  };

  const onFinishActivity = () => {
    handleFinish();
    const finalDist = Number(liveDist.toFixed(2));
    const finalElapsed = elapsed > 0 ? elapsed : 1;
    const finalPace = (finalDist >= 0.02 && finalElapsed > 0) ? (finalElapsed / 60 / finalDist) : 0;
    const finalSpeed = (finalElapsed > 0 && finalDist >= 0.02) ? (finalDist / (finalElapsed / 3600)) : 0;
    const finalPath = (pathRef && pathRef.current && pathRef.current.length > 1) ? [...pathRef.current] : [];
    const finalSplits = computeKmSplits(finalPath, finalElapsed);
    const startTime = (runStartTimeRef && runStartTimeRef.current) ? runStartTimeRef.current : new Date();
    const endTime = new Date();
    const actDate = typeof getLocalDateStr === "function" ? getLocalDateStr(startTime) : new Date().toISOString().split("T")[0];
    const defaultTitle = getActivityTitleByTime(startTime, currentSport.id);

    const finishedData = {
      id: generateUuid(),
      user_id: currentUser?.id,
      title: defaultTitle,
      sport: currentSport.id,
      sport_type: currentSport.id,
      distanceKm: finalDist,
      distance: finalDist,
      elapsed: finalElapsed,
      time: finalElapsed,
      duration_seconds: finalElapsed,
      paceMinPerKm: finalPace,
      pace: finalPace,
      average_pace: finalPace,
      speedKmh: Number(finalSpeed.toFixed(1)),
      average_speed: Number(finalSpeed.toFixed(1)),
      maxSpeed: maxSpeed || Number(finalSpeed.toFixed(1)),
      elevationGain: liveElevation,
      calories: liveCalories,
      calories_burned: liveCalories,
      path: finalPath,
      route_coordinates: finalPath,
      splits: finalSplits,
      splits_data: finalSplits,
      date: actDate,
      activity_date: actDate,
      startTime: startTime.toISOString(),
      start_time: startTime.toISOString(),
      endTime: endTime.toISOString(),
      end_time: endTime.toISOString(),
      location: reverseGeoAddress || "Outdoor Track"
    };

    setSummaryActivity(finishedData);
    setActivityTitle(defaultTitle);
    setRunStage("summary");

    if (audioCues && typeof speakAudioCue === "function") {
      speakAudioCue(activePersona.finishMsg(finalDist, Math.round(finalDist * 1250)), selectedVoice);
    }
  };

  const onConfirmDiscard = () => {
    setShowDiscardModal(false);
    handleDiscard();
    setRunStage("map_idle");
  };

  const onSaveActivity = async () => {
    if (!summaryActivity) return;
    setIsSavingToDb(true);

    const finalTitle = activityTitle.trim() || summaryActivity.title;
    const payloadToSave = {
      ...summaryActivity,
      title: finalTitle
    };

    // Prepend to local runs array
    setRuns((prev) => [payloadToSave, ...(prev || [])]);

    // Persist to localStorage
    try {
      const existing = JSON.parse(localStorage.getItem("stoke_runs_v2") || "[]");
      localStorage.setItem("stoke_runs_v2", JSON.stringify([payloadToSave, ...existing]));
    } catch (e) {}

    // Persist to Supabase database
    if (currentUser?.id && typeof dbSaveRunningActivity === "function") {
      try {
        await dbSaveRunningActivity(currentUser.id, payloadToSave);
        if (typeof dbSaveUserXp === "function") {
          const xpGain = Math.min(300, Math.round(50 + (payloadToSave.distanceKm * 20)));
          dbSaveUserXp(currentUser.id, (profile?.xp || 2450) + xpGain);
        }
      } catch (err) {
        console.warn("Supabase save activity error:", err);
      }
    }

    setIsSavingToDb(false);
    setShowToast(`Saved "${finalTitle}" to your activity history!`);
    setTimeout(() => setShowToast(null), 3500);

    setActiveSubTab("history");
    setRunStage("map_idle");
    setSummaryActivity(null);
    if (handleReset) handleReset();
  };

  const handleCompassClick = () => {
    if (userPos && userPos.length === 2) {
      setUserPos([...userPos]);
    }
    setShowToast("Map oriented to North");
    setTimeout(() => setShowToast(null), 2000);
  };

  const toggleLayerStyle = () => {
    setMapTileType((prev) => (prev === "dark" ? "satellite" : prev === "satellite" ? "topo" : prev === "topo" ? "street" : "dark"));
  };

  // Activity History data
  const allActivities = (runs || []).map(normalizeActivity).filter(Boolean);
  const filteredActivities = historySportFilter === "all"
    ? allActivities
    : allActivities.filter((a) => a.sport === historySportFilter);

  const totalHistoryKm = filteredActivities.reduce((s, a) => s + a.distanceKm, 0);
  const totalHistorySeconds = filteredActivities.reduce((s, a) => s + a.elapsed, 0);
  const totalHistoryCalories = filteredActivities.reduce((s, a) => s + a.calories, 0);
  const totalHistoryElevation = filteredActivities.reduce((s, a) => s + a.elevationGain, 0);

  const groupedHistory = React.useMemo(() => {
    const groups = {};
    filteredActivities.forEach((act) => {
      let key = "Earlier";
      const d = new Date(act.startTime || act.date);
      if (historyFilter === "daily") {
        key = act.dateLabel || act.date || "Recent";
      } else if (historyFilter === "weekly") {
        const weekNum = Math.ceil(d.getDate() / 7);
        const monthName = d.toLocaleDateString([], { month: "short" });
        key = `Week ${weekNum} · ${monthName} ${d.getFullYear()}`;
      } else if (historyFilter === "monthly") {
        key = d.toLocaleDateString([], { month: "long", year: "numeric" });
      }
      if (!groups[key]) groups[key] = [];
      groups[key].push(act);
    });
    return groups;
  }, [filteredActivities, historyFilter]);

  // If user selected an indoor sport (Weight Training, Workout, HIIT, Crossfit, etc.)
  if (!currentSport.isOutdoor && activeSubTab === "tracker" && runStage !== "summary" && runStage !== "activity_detail") {
    return (
      <div style={{ position: "fixed", inset: 0, zIndex: 100 }}>
        <IndoorWorkoutScreen
          sport={currentSport}
          status={status}
          elapsed={elapsed}
          onStart={onStartActivity}
          onPause={onPauseActivity}
          onResume={onResumeActivity}
          onFinish={onFinishActivity}
          onDiscard={() => setShowDiscardModal(true)}
          onOpenSportSheet={() => setIsSportSheetOpen(true)}
          onOpenSensorModal={() => setIsSensorModalOpen(true)}
          onBack={onBack}
          profile={profile}
        />
        <ChooseSportSheet
          isOpen={isSportSheetOpen}
          onClose={() => setIsSportSheetOpen(false)}
          selectedSportId={selectedSportId}
          onSelectSport={handleSelectSport}
        />
        <SensorModal
          isOpen={isSensorModalOpen}
          onClose={() => setIsSensorModalOpen(false)}
        />
        {showDiscardModal && (
          <div style={{ position: "fixed", inset: 0, zIndex: 20000, background: "rgba(0,0,0,0.8)", display: "flex", alignItems: "center", justifyContent: "center", padding: 20 }}>
            <div style={{ background: "#1C1C1E", borderRadius: 20, padding: 24, maxWidth: 320, width: "100%", textAlign: "center", border: "1px solid rgba(255,255,255,0.12)" }}>
              <div style={{ fontSize: 32, marginBottom: 12 }}>⚠️</div>
              <h3 style={{ margin: "0 0 8px", color: "#FFF", fontSize: 18, fontWeight: 900 }}>Discard Workout?</h3>
              <p style={{ margin: "0 0 20px", color: "#8E8E93", fontSize: 13 }}>Current exercise time and telemetry will be lost.</p>
              <div style={{ display: "flex", gap: 10 }}>
                <button onClick={() => setShowDiscardModal(false)} style={{ flex: 1, padding: "12px 0", borderRadius: 12, background: "#2C2C2E", border: "none", color: "#FFF", fontWeight: 700, cursor: "pointer" }}>Keep</button>
                <button onClick={onConfirmDiscard} style={{ flex: 1, padding: "12px 0", borderRadius: 12, background: "#FF453A", border: "none", color: "#FFF", fontWeight: 800, cursor: "pointer" }}>Discard</button>
              </div>
            </div>
          </div>
        )}
      </div>
    );
  }

  // ==========================================================================
  // FULL-SCREEN OUTDOOR DARK GPS MAP (Exact match to oooooo.mp4)
  // ==========================================================================
  return (
    <div style={{
      position: "relative",
      width: "100%",
      height: "100%",
      flex: 1,
      zIndex: 50,
      background: "#0E0E0E",
      color: "#FFFFFF",
      display: "flex",
      flexDirection: "column",
      overflow: "hidden",
      fontFamily: "'Space Grotesk', -apple-system, sans-serif"
    }}>
      {/* Toast Notification */}
      {showToast && (
        <div style={{
          position: "fixed",
          top: "max(20px, env(safe-area-inset-top, 20px))",
          left: "50%",
          transform: "translateX(-50%)",
          zIndex: 99999,
          background: "#1C1C1E",
          color: "#FFFFFF",
          padding: "10px 20px",
          borderRadius: 999,
          fontSize: 13,
          fontWeight: 800,
          boxShadow: "0 8px 30px rgba(0,0,0,0.6)",
          display: "flex",
          alignItems: "center",
          gap: 8,
          border: "1px solid rgba(255,255,255,0.15)",
          animation: "stokeFadeUp 0.3s ease"
        }}>
          <span>✨</span>
          <span>{showToast}</span>
        </div>
      )}

      {/* Discard Confirmation Modal */}
      {showDiscardModal && (
        <div style={{ position: "fixed", inset: 0, zIndex: 20000, background: "rgba(0,0,0,0.8)", display: "flex", alignItems: "center", justifyContent: "center", padding: 20 }}>
          <div style={{ background: "#1C1C1E", borderRadius: 20, padding: 24, maxWidth: 320, width: "100%", textAlign: "center", border: "1px solid rgba(255,255,255,0.12)" }}>
            <div style={{ fontSize: 32, marginBottom: 12 }}>⚠️</div>
            <h3 style={{ margin: "0 0 8px", color: "#FFF", fontSize: 18, fontWeight: 900 }}>Discard Activity?</h3>
            <p style={{ margin: "0 0 20px", color: "#8E8E93", fontSize: 13 }}>Current route, splits, and recorded distance will be lost.</p>
            <div style={{ display: "flex", gap: 10 }}>
              <button onClick={() => setShowDiscardModal(false)} style={{ flex: 1, padding: "12px 0", borderRadius: 12, background: "#2C2C2E", border: "none", color: "#FFF", fontWeight: 700, cursor: "pointer" }}>Keep</button>
              <button onClick={onConfirmDiscard} style={{ flex: 1, padding: "12px 0", borderRadius: 12, background: "#FF453A", border: "none", color: "#FFF", fontWeight: 800, cursor: "pointer" }}>Discard</button>
            </div>
          </div>
        </div>
      )}

      {/* Sub-Tabs Switcher for History & Challenges (When not in fullscreen HUD) */}
      {activeSubTab !== "tracker" && (
        <div style={{
          position: "relative",
          zIndex: 100,
          background: "#18181A",
          padding: "max(12px, env(safe-area-inset-top, 12px)) 16px 10px",
          borderBottom: "1px solid rgba(255,255,255,0.08)",
          display: "flex",
          alignItems: "center",
          justifyContent: "space-between"
        }}>
          <button
            onClick={() => setActiveSubTab("tracker")}
            style={{
              background: "#242426",
              border: "1px solid rgba(255,255,255,0.1)",
              borderRadius: 12,
              padding: "6px 14px",
              color: "#FFF",
              fontWeight: 800,
              fontSize: 12.5,
              cursor: "pointer",
              display: "flex",
              alignItems: "center",
              gap: 6
            }}
          >
            <span>◀</span>
            <span>Live Map</span>
          </button>
          <div style={{ display: "flex", gap: 6 }}>
            {["history", "challenges", "leaderboard"].map(tabKey => (
              <button
                key={tabKey}
                onClick={() => setActiveSubTab(tabKey)}
                style={{
                  padding: "6px 12px",
                  borderRadius: 10,
                  border: "none",
                  background: activeSubTab === tabKey ? "#3678F5" : "transparent",
                  color: activeSubTab === tabKey ? "#FFF" : "#8E8E93",
                  fontSize: 12,
                  fontWeight: 800,
                  cursor: "pointer"
                }}
              >
                {tabKey.charAt(0).toUpperCase() + tabKey.slice(1)}
              </button>
            ))}
          </div>
        </div>
      )}

      {/* ==================================================================== */}
      {/* 1. TRACKER VIEW (Full-Screen Dark GPS Map) */}
      {/* ==================================================================== */}
      {activeSubTab === "tracker" && runStage !== "summary" && runStage !== "activity_detail" && runStage !== "hud_fullscreen" && (
        <div style={{ position: "relative", flex: 1, width: "100%", height: "100%", overflow: "hidden" }}>
          {/* Full-Screen Dark Leaflet Map */}
          <div style={{ position: "absolute", inset: 0, width: "100%", height: "100%", zIndex: 1 }}>
            <StokeLiveMap
              path={pathRef && pathRef.current ? [...pathRef.current] : []}
              plannedRoute={activeRoute}
              userPos={userPos}
              is3DTilted={is3DTilted}
              mapTileType={mapTileType}
              runStage={runStage}
              height="100%"
            />
          </div>

          {/* Top Floating Overlay (Back, Workout Banner, Compass) */}
          <div style={{
            position: "absolute",
            top: "max(12px, env(safe-area-inset-top, 12px))",
            left: 14,
            right: 14,
            zIndex: 100,
            display: "flex",
            alignItems: "center",
            justifyContent: "space-between",
            pointerEvents: "none"
          }}>
            {/* Back Chevron Button */}
            <button
              onClick={onBack}
              title="Return to Today"
              style={{
                pointerEvents: "auto",
                width: 42,
                height: 42,
                borderRadius: "50%",
                background: "rgba(30, 30, 30, 0.88)",
                backdropFilter: "blur(14px)",
                border: "1px solid rgba(255, 255, 255, 0.12)",
                color: "#FFFFFF",
                display: "flex",
                alignItems: "center",
                justifyContent: "center",
                cursor: "pointer",
                boxShadow: "0 4px 16px rgba(0,0,0,0.4)"
              }}
            >
              <SportIcon icon="chevron_down" size={20} color="#FFFFFF" />
            </button>

            {/* Workout Banner (Matching oooooo.mp4) */}
            <div
              onClick={() => setIsWorkoutModalOpen(true)}
              style={{
                pointerEvents: "auto",
                height: 44,
                background: "rgba(24, 24, 26, 0.90)",
                backdropFilter: "blur(16px)",
                border: "1px solid rgba(255, 255, 255, 0.12)",
                borderRadius: 999,
                padding: "4px 16px 4px 6px",
                display: "flex",
                alignItems: "center",
                gap: 10,
                cursor: "pointer",
                boxShadow: "0 4px 20px rgba(0,0,0,0.5)"
              }}
            >
              <div style={{
                width: 32,
                height: 32,
                borderRadius: "50%",
                background: "linear-gradient(135deg, #3678F5 0%, #2B62D9 100%)",
                display: "flex",
                alignItems: "center",
                justifyContent: "center",
                flexShrink: 0,
                boxShadow: "0 2px 8px rgba(54, 120, 245, 0.4)"
              }}>
                <SportIcon icon="workout" size={17} color="#FFFFFF" />
              </div>
              <div style={{ display: "flex", flexDirection: "column", textAlign: "left" }}>
                <div style={{ fontSize: 13, fontWeight: 800, color: "#FFFFFF", lineHeight: 1.2 }}>
                  {activeWorkoutTarget ? activeWorkoutTarget.title : "Try a Stoke workout"}
                </div>
                <div style={{ fontSize: 10.5, color: "#8E8E93", lineHeight: 1.2, marginTop: 1 }}>
                  {activeWorkoutTarget ? activeWorkoutTarget.badge : "Limited preview"}
                </div>
              </div>
            </div>

            {/* Compass Button */}
            <div style={{ display: "flex", gap: 8, pointerEvents: "auto" }}>
              <button
                onClick={handleCompassClick}
                title="Reset Map to North"
                style={{
                  width: 42,
                  height: 42,
                  borderRadius: "50%",
                  background: "rgba(30, 30, 30, 0.88)",
                  backdropFilter: "blur(14px)",
                  border: "1px solid rgba(255, 255, 255, 0.12)",
                  display: "flex",
                  flexDirection: "column",
                  alignItems: "center",
                  justifyContent: "center",
                  cursor: "pointer",
                  boxShadow: "0 4px 16px rgba(0,0,0,0.4)"
                }}
              >
                <span style={{ fontSize: 9, fontWeight: 900, color: "#FFFFFF", lineHeight: 1 }}>N</span>
                <SportIcon icon="compass" size={16} color="#3678F5" />
              </button>
            </div>
          </div>

          {/* Right Floating Map Controls Stack */}
          <div style={{
            position: "absolute",
            right: 14,
            top: 96,
            zIndex: 100,
            display: "flex",
            flexDirection: "column",
            gap: 10
          }}>
            {/* Audio Voice Coach Toggle */}
            <button
              onClick={() => {
                setAudioCues(!audioCues);
                setShowToast(audioCues ? "Audio Cues Muted" : "Voice Coach Active");
                setTimeout(() => setShowToast(null), 2000);
              }}
              title="Voice Coach Audio Cues"
              style={{
                width: 42,
                height: 42,
                borderRadius: "50%",
                background: "rgba(30, 30, 30, 0.88)",
                backdropFilter: "blur(14px)",
                border: `1.5px solid ${audioCues ? "#3678F5" : "rgba(255, 255, 255, 0.12)"}`,
                color: audioCues ? "#3678F5" : "#8E8E93",
                display: "flex",
                alignItems: "center",
                justifyContent: "center",
                cursor: "pointer",
                boxShadow: "0 4px 16px rgba(0,0,0,0.4)"
              }}
            >
              <SportIcon icon={audioCues ? "speaker" : "speaker_off"} size={19} color={audioCues ? "#3678F5" : "#8E8E93"} />
            </button>

            {/* 3D / Layer Switcher Button */}
            <button
              onClick={() => {
                if (mapTileType === "dark" && !is3DTilted) {
                  setIs3DTilted(true);
                  setShowToast("3D Tilt View");
                } else if (is3DTilted) {
                  setIs3DTilted(false);
                  setMapTileType("satellite");
                  setShowToast("Satellite View");
                } else if (mapTileType === "satellite") {
                  setMapTileType("dark");
                  setShowToast("Dark Map");
                } else {
                  setMapTileType("dark");
                }
                setTimeout(() => setShowToast(null), 2000);
              }}
              title="Map Style &amp; 3D View"
              style={{
                width: 42,
                height: 42,
                borderRadius: "50%",
                background: "rgba(30, 30, 30, 0.88)",
                backdropFilter: "blur(14px)",
                border: "1px solid rgba(255, 255, 255, 0.12)",
                color: is3DTilted ? "#3678F5" : "#FFFFFF",
                display: "flex",
                flexDirection: "column",
                alignItems: "center",
                justifyContent: "center",
                cursor: "pointer",
                boxShadow: "0 4px 16px rgba(0,0,0,0.4)"
              }}
            >
              <span style={{ fontSize: 9.5, fontWeight: 900, color: is3DTilted ? "#3678F5" : "#FFF", lineHeight: 1 }}>3D</span>
              <SportIcon icon="layers" size={17} color={is3DTilted ? "#3678F5" : "#FFFFFF"} />
            </button>

            {/* Recenter Crosshair Button */}
            <button
              onClick={() => {
                if (userPos && userPos.length === 2) {
                  setUserPos([...userPos]);
                }
                setShowToast("Recentered to GPS");
                setTimeout(() => setShowToast(null), 1500);
              }}
              title="Recenter Map to Live Location"
              style={{
                width: 42,
                height: 42,
                borderRadius: "50%",
                background: "rgba(30, 30, 30, 0.88)",
                backdropFilter: "blur(14px)",
                border: "1px solid rgba(255, 255, 255, 0.12)",
                color: "#FFFFFF",
                display: "flex",
                alignItems: "center",
                justifyContent: "center",
                cursor: "pointer",
                boxShadow: "0 4px 16px rgba(0,0,0,0.4)"
              }}
            >
              <SportIcon icon="crosshair" size={20} color="#FFFFFF" />
            </button>

            {/* History Shortcut Button */}
            <button
              onClick={() => setActiveSubTab("history")}
              title="Past Activities"
              style={{
                width: 42,
                height: 42,
                borderRadius: "50%",
                background: "rgba(30, 30, 30, 0.88)",
                backdropFilter: "blur(14px)",
                border: "1px solid rgba(255, 255, 255, 0.12)",
                fontSize: 16,
                display: "flex",
                alignItems: "center",
                justifyContent: "center",
                cursor: "pointer",
                boxShadow: "0 4px 16px rgba(0,0,0,0.4)"
              }}
            >
              📜
            </button>
          </div>

          {/* Bottom Left Info Button & Tooltip */}
          <div style={{ position: "absolute", left: 14, bottom: 230, zIndex: 100 }}>
            <button
              onClick={() => setShowGpsTooltip(!showGpsTooltip)}
              style={{
                width: 28,
                height: 28,
                borderRadius: "50%",
                background: "rgba(30, 30, 30, 0.75)",
                border: "1px solid rgba(255, 255, 255, 0.15)",
                color: "#8E8E93",
                fontSize: 12,
                fontWeight: 800,
                display: "flex",
                alignItems: "center",
                justifyContent: "center",
                cursor: "pointer"
              }}
            >
              i
            </button>

            {showGpsTooltip && (
              <div style={{
                position: "absolute",
                bottom: 34,
                left: 0,
                background: "rgba(22, 22, 24, 0.95)",
                backdropFilter: "blur(16px)",
                border: "1px solid rgba(255, 255, 255, 0.12)",
                borderRadius: 12,
                padding: "8px 12px",
                width: 200,
                fontSize: 11,
                color: "#EBEBF5",
                boxShadow: "0 6px 20px rgba(0,0,0,0.6)",
                lineHeight: 1.4
              }}>
                <div style={{ color: "#30D158", fontWeight: 800 }}>● Real GPS Satellite Active</div>
                <div>Accuracy: {accuracy ? `±${Math.round(accuracy)}m` : "High"}</div>
                <div style={{ color: "#8E8E93", marginTop: 2, overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" }}>
                  📍 {reverseGeoAddress || "Worldwide GPS"}
                </div>
              </div>
            )}
          </div>

          {/* ================================================================ */}
          {/* FLOATING BOTTOM STATS PANEL (Exact layout from oooooo.mp4) */}
          {/* ================================================================ */}
          <div style={{
            position: "absolute",
            left: 14,
            right: 14,
            bottom: 96,
            zIndex: 100,
            background: "rgba(24, 24, 26, 0.94)",
            backdropFilter: "blur(20px)",
            borderRadius: 20,
            border: "1px solid rgba(255, 255, 255, 0.1)",
            padding: "14px 18px 16px",
            boxShadow: "0 10px 30px rgba(0,0,0,0.6)"
          }}>
            {/* Stats Header (Sport Name + Expand Button) */}
            <div style={{ display: "flex", alignItems: "center", justifyContent: "space-between", marginBottom: 8 }}>
              <span style={{ fontSize: 15, fontWeight: 800, color: "#FFFFFF", letterSpacing: 0.3 }}>
                {currentSport.name}
              </span>
              <button
                onClick={() => setRunStage("hud_fullscreen")}
                title="Fullscreen HUD"
                style={{
                  background: "none",
                  border: "none",
                  color: "#8E8E93",
                  cursor: "pointer",
                  display: "flex",
                  alignItems: "center",
                  padding: "2px"
                }}
              >
                <SportIcon icon="expand" size={17} color="#8E8E93" />
              </button>
            </div>

            {/* 3 Metric Columns: Time | Avg. Pace | Distance */}
            <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr 1fr", textAlign: "center", alignItems: "baseline" }}>
              {/* Column 1: Time */}
              <div style={{ textAlign: "left" }}>
                <div style={{
                  fontSize: 26,
                  fontWeight: 900,
                  fontFamily: "'Space Grotesk', -apple-system, monospace",
                  color: "#FFFFFF",
                  letterSpacing: -0.5
                }}>
                  {formatTime(elapsed)}
                </div>
                <div style={{ fontSize: 11, fontWeight: 700, color: "#8E8E93", textTransform: "uppercase", marginTop: 2 }}>
                  Time
                </div>
              </div>

              {/* Column 2: Avg. Pace */}
              <div style={{ textAlign: "center" }}>
                <div style={{
                  fontSize: 26,
                  fontWeight: 900,
                  fontFamily: "'Space Grotesk', -apple-system, monospace",
                  color: "#FFFFFF",
                  letterSpacing: -0.5
                }}>
                  {currentSport.category === "Cycle Sports"
                    ? `${currentSpeed.toFixed(1)}`
                    : formatPace(livePace)}
                </div>
                <div style={{ fontSize: 11, fontWeight: 700, color: "#8E8E93", marginTop: 2 }}>
                  {currentSport.category === "Cycle Sports" ? "Speed (km/h)" : "Avg. pace (/km)"}
                </div>
              </div>

              {/* Column 3: Distance */}
              <div style={{ textAlign: "right" }}>
                <div style={{
                  fontSize: 26,
                  fontWeight: 900,
                  fontFamily: "'Space Grotesk', -apple-system, monospace",
                  color: "#FFFFFF",
                  letterSpacing: -0.5
                }}>
                  {liveDist.toFixed(2)}
                </div>
                <div style={{ fontSize: 11, fontWeight: 700, color: "#8E8E93", marginTop: 2 }}>
                  Distance (km)
                </div>
              </div>
            </div>
          </div>

          {/* ================================================================ */}
          {/* BOTTOM CONTROLS BAR (Sport Selector · Start Button · Add Route) */}
          {/* ================================================================ */}
          <div style={{
            position: "absolute",
            left: 0,
            right: 0,
            bottom: 0,
            zIndex: 100,
            background: "#0E0E0E",
            borderTop: "1px solid rgba(255, 255, 255, 0.08)",
            padding: "10px 24px max(24px, env(safe-area-inset-bottom, 24px))",
            display: "flex",
            alignItems: "center",
            justifyContent: "space-between"
          }}>
            {/* Control 1: Run / Sport Selector Button */}
            <div style={{ display: "flex", flexDirection: "column", alignItems: "center", width: 70 }}>
              <button
                onClick={() => setIsSportSheetOpen(true)}
                title="Choose a Sport"
                style={{
                  width: 54,
                  height: 54,
                  borderRadius: "50%",
                  background: "#242426",
                  border: "1px solid rgba(255, 255, 255, 0.1)",
                  color: "#3678F5",
                  display: "flex",
                  alignItems: "center",
                  justifyContent: "center",
                  cursor: "pointer",
                  boxShadow: "0 4px 12px rgba(0,0,0,0.4)"
                }}
              >
                <SportIcon icon={currentSport.icon} size={24} color="#3678F5" />
              </button>
              <span style={{ fontSize: 11, fontWeight: 600, color: "#FFFFFF", marginTop: 5, textAlign: "center", maxWidth: 75, overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" }}>
                {currentSport.name}
              </span>
            </div>

            {/* Control 2: Large Orange Start / Pause / Resume Button */}
            {status === "idle" && (
              <div style={{ display: "flex", flexDirection: "column", alignItems: "center" }}>
                <button
                  onClick={onStartActivity}
                  title="Start Workout"
                  style={{
                    width: 72,
                    height: 72,
                    borderRadius: "50%",
                    background: "linear-gradient(135deg, #3678F5 0%, #2563EB 100%)",
                    border: "none",
                    display: "flex",
                    alignItems: "center",
                    justifyContent: "center",
                    cursor: "pointer",
                    boxShadow: "0 0 28px rgba(54, 120, 245, 0.55)"
                  }}
                >
                  <svg width="26" height="26" viewBox="0 0 24 24" fill="#FFFFFF"><polygon points="6 4 20 12 6 20" /></svg>
                </button>
                <span style={{ fontSize: 12, fontWeight: 800, color: "#3678F5", marginTop: 5 }}>
                  Start
                </span>
              </div>
            )}

            {status === "active" && (
              <div style={{ display: "flex", alignItems: "center", gap: 14 }}>
                <div style={{ display: "flex", flexDirection: "column", alignItems: "center" }}>
                  <button
                    onClick={onPauseActivity}
                    title="Pause Workout"
                    style={{
                      width: 72,
                      height: 72,
                      borderRadius: "50%",
                      background: "linear-gradient(135deg, #3678F5 0%, #2563EB 100%)",
                      border: "none",
                      display: "flex",
                      alignItems: "center",
                      justifyContent: "center",
                      cursor: "pointer",
                      boxShadow: "0 0 28px rgba(54, 120, 245, 0.55)"
                    }}
                  >
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="#FFFFFF"><rect x="6" y="4" width="4" height="16" rx="1"/><rect x="14" y="4" width="4" height="16" rx="1"/></svg>
                  </button>
                  <span style={{ fontSize: 12, fontWeight: 800, color: "#3678F5", marginTop: 5 }}>
                    Pause
                  </span>
                </div>
                <div style={{ display: "flex", flexDirection: "column", alignItems: "center" }}>
                  <button
                    onClick={onFinishActivity}
                    title="Finish Workout"
                    style={{
                      width: 54,
                      height: 54,
                      borderRadius: "50%",
                      background: "#3A3A3C",
                      border: "1px solid rgba(255,255,255,0.15)",
                      display: "flex",
                      alignItems: "center",
                      justifyContent: "center",
                      cursor: "pointer"
                    }}
                  >
                    <span style={{ fontSize: 22 }}>🏁</span>
                  </button>
                  <span style={{ fontSize: 11, fontWeight: 700, color: "#FFF", marginTop: 5 }}>
                    Finish
                  </span>
                </div>
              </div>
            )}

            {status === "paused" && (
              <div style={{ display: "flex", alignItems: "center", gap: 12 }}>
                <div style={{ display: "flex", flexDirection: "column", alignItems: "center" }}>
                  <button
                    onClick={onResumeActivity}
                    title="Resume Workout"
                    style={{
                      width: 66,
                      height: 66,
                      borderRadius: "50%",
                      background: "linear-gradient(135deg, #3678F5 0%, #2563EB 100%)",
                      border: "none",
                      display: "flex",
                      alignItems: "center",
                      justifyContent: "center",
                      cursor: "pointer",
                      boxShadow: "0 0 24px rgba(54, 120, 245, 0.5)"
                    }}
                  >
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="#FFFFFF"><polygon points="6 4 20 12 6 20" /></svg>
                  </button>
                  <span style={{ fontSize: 11, fontWeight: 800, color: "#3678F5", marginTop: 5 }}>Resume</span>
                </div>
                <div style={{ display: "flex", flexDirection: "column", alignItems: "center" }}>
                  <button
                    onClick={onFinishActivity}
                    title="Finish Workout"
                    style={{
                      width: 52,
                      height: 52,
                      borderRadius: "50%",
                      background: "#3A3A3C",
                      border: "none",
                      display: "flex",
                      alignItems: "center",
                      justifyContent: "center",
                      cursor: "pointer"
                    }}
                  >
                    <span style={{ fontSize: 20 }}>🏁</span>
                  </button>
                  <span style={{ fontSize: 11, fontWeight: 700, color: "#FFF", marginTop: 5 }}>Finish</span>
                </div>
                <div style={{ display: "flex", flexDirection: "column", alignItems: "center" }}>
                  <button
                    onClick={() => setShowDiscardModal(true)}
                    title="Discard Workout"
                    style={{
                      width: 44,
                      height: 44,
                      borderRadius: "50%",
                      background: "#242426",
                      border: "1px solid #FF453A",
                      color: "#FF453A",
                      display: "flex",
                      alignItems: "center",
                      justifyContent: "center",
                      cursor: "pointer",
                      fontSize: 16
                    }}
                  >
                    ✕
                  </button>
                  <span style={{ fontSize: 10, fontWeight: 700, color: "#FF453A", marginTop: 5 }}>Discard</span>
                </div>
              </div>
            )}

            {/* Control 3: Add Route Button */}
            <div style={{ display: "flex", flexDirection: "column", alignItems: "center", width: 70 }}>
              <button
                onClick={() => setIsRouteModalOpen(true)}
                title="Routes &amp; Trails"
                style={{
                  width: 54,
                  height: 54,
                  borderRadius: "50%",
                  background: activeRoute ? "rgba(0, 229, 255, 0.15)" : "#242426",
                  border: `1px solid ${activeRoute ? "#00E5FF" : "rgba(255, 255, 255, 0.1)"}`,
                  color: activeRoute ? "#00E5FF" : "#EBEBF5",
                  display: "flex",
                  alignItems: "center",
                  justifyContent: "center",
                  cursor: "pointer",
                  boxShadow: "0 4px 12px rgba(0,0,0,0.4)"
                }}
              >
                <SportIcon icon="route" size={24} color={activeRoute ? "#00E5FF" : "#EBEBF5"} />
              </button>
              <span style={{ fontSize: 11, fontWeight: 600, color: activeRoute ? "#00E5FF" : "#FFFFFF", marginTop: 5, textAlign: "center", maxWidth: 75, overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" }}>
                {activeRoute ? activeRoute.name : "Add Route"}
              </span>
            </div>
          </div>
        </div>
      )}

      {/* ==================================================================== */}
      {/* 2. FULLSCREEN OLED HUD MODE (runStage === "hud_fullscreen") */}
      {/* ==================================================================== */}
      {runStage === "hud_fullscreen" && (
        <div style={{
          position: "fixed",
          inset: 0,
          zIndex: 1000,
          background: "#000000",
          color: "#FFFFFF",
          padding: "max(20px, env(safe-area-inset-top, 20px)) 24px max(24px, env(safe-area-inset-bottom, 24px))",
          display: "flex",
          flexDirection: "column",
          justifyContent: "space-between"
        }}>
          <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center" }}>
            <span style={{ fontSize: 14, fontWeight: 800, color: "#3678F5", textTransform: "uppercase" }}>
              ● {currentSport.name} OLED HUD
            </span>
            <button
              onClick={() => setRunStage(status === "active" ? "map_active" : status === "paused" ? "paused" : "map_idle")}
              style={{ background: "#222", border: "1px solid #444", color: "#FFF", padding: "6px 14px", borderRadius: 999, fontSize: 12, fontWeight: 700, cursor: "pointer" }}
            >
              Back to Map
            </button>
          </div>

          <div style={{ display: "flex", flexDirection: "column", gap: 30, textAlign: "center", margin: "auto 0" }}>
            <div>
              <div style={{ fontSize: 72, fontWeight: 900, fontFamily: "monospace", letterSpacing: -2 }}>
                {liveDist.toFixed(2)}
              </div>
              <div style={{ fontSize: 14, fontWeight: 700, color: "#8E8E93", textTransform: "uppercase" }}>DISTANCE (KM)</div>
            </div>
            <div>
              <div style={{ fontSize: 64, fontWeight: 900, fontFamily: "monospace", color: "#3678F5", letterSpacing: -2 }}>
                {formatTime(elapsed)}
              </div>
              <div style={{ fontSize: 14, fontWeight: 700, color: "#8E8E93", textTransform: "uppercase" }}>TIME</div>
            </div>
            <div>
              <div style={{ fontSize: 56, fontWeight: 900, fontFamily: "monospace", color: "#FFF", letterSpacing: -1 }}>
                {formatPace(livePace)}
              </div>
              <div style={{ fontSize: 14, fontWeight: 700, color: "#8E8E93", textTransform: "uppercase" }}>AVG PACE (/KM)</div>
            </div>
          </div>

          <div style={{ display: "flex", justifyContent: "center" }}>
            {status === "active" ? (
              <button
                onClick={onPauseActivity}
                style={{ width: "100%", padding: "16px 0", borderRadius: 16, background: "#3678F5", border: "none", color: "#FFF", fontSize: 18, fontWeight: 900, cursor: "pointer" }}
              >
                PAUSE
              </button>
            ) : (
              <button
                onClick={onResumeActivity}
                style={{ width: "100%", padding: "16px 0", borderRadius: 16, background: "#3678F5", border: "none", color: "#FFF", fontSize: 18, fontWeight: 900, cursor: "pointer" }}
              >
                RESUME
              </button>
            )}
          </div>
        </div>
      )}

      {/* ==================================================================== */}
      {/* 3. ACTIVITY FINISH & SAVE SUMMARY (runStage === "summary") */}
      {/* ==================================================================== */}
      {runStage === "summary" && summaryActivity && (
        <div style={{
          flex: 1,
          overflowY: "auto",
          background: "#121214",
          color: "#FFFFFF",
          padding: "max(16px, env(safe-area-inset-top, 16px)) 16px max(30px, env(safe-area-inset-bottom, 30px))"
        }}>
          {/* Header Map */}
          <div style={{ height: 240, borderRadius: 20, overflow: "hidden", marginBottom: 16, border: "1px solid rgba(255,255,255,0.1)" }}>
            <StokeLiveMap
              path={summaryActivity.path || []}
              userPos={summaryActivity.path && summaryActivity.path.length > 0 ? [summaryActivity.path[0].lat, summaryActivity.path[0].lng] : userPos}
              runStage="summary"
              height="100%"
            />
          </div>

          {/* Activity Title Input */}
          <div style={{ background: "#1C1C1E", borderRadius: 18, padding: 18, marginBottom: 14, border: "1px solid rgba(255,255,255,0.08)" }}>
            <label style={{ fontSize: 11, fontWeight: 800, color: "#8E8E93", textTransform: "uppercase" }}>Activity Title</label>
            <input
              type="text"
              value={activityTitle}
              onChange={(e) => setActivityTitle(e.target.value)}
              style={{
                width: "100%",
                background: "transparent",
                border: "none",
                borderBottom: "1.5px solid #3678F5",
                color: "#FFFFFF",
                fontSize: 18,
                fontWeight: 800,
                padding: "6px 0",
                marginTop: 4,
                outline: "none",
                fontFamily: "inherit"
              }}
            />
            <div style={{ fontSize: 11.5, color: "#8E8E93", marginTop: 8 }}>
              📍 {summaryActivity.location} · {summaryActivity.date}
            </div>
          </div>

          {/* Metrics Grid */}
          <div style={{
            display: "grid",
            gridTemplateColumns: "1fr 1fr 1fr",
            gap: 10,
            background: "#1C1C1E",
            borderRadius: 18,
            padding: 16,
            marginBottom: 14,
            border: "1px solid rgba(255,255,255,0.08)"
          }}>
            <div>
              <div style={{ fontSize: 10, color: "#8E8E93", fontWeight: 800 }}>DISTANCE</div>
              <div style={{ fontSize: 22, fontWeight: 900, color: "#3678F5", fontFamily: "monospace" }}>{summaryActivity.distanceKm.toFixed(2)} km</div>
            </div>
            <div>
              <div style={{ fontSize: 10, color: "#8E8E93", fontWeight: 800 }}>DURATION</div>
              <div style={{ fontSize: 22, fontWeight: 900, color: "#FFFFFF", fontFamily: "monospace" }}>{formatTime(summaryActivity.elapsed)}</div>
            </div>
            <div>
              <div style={{ fontSize: 10, color: "#8E8E93", fontWeight: 800 }}>AVG PACE</div>
              <div style={{ fontSize: 22, fontWeight: 900, color: "#FFFFFF", fontFamily: "monospace" }}>{formatPace(summaryActivity.paceMinPerKm)}</div>
            </div>
            <div>
              <div style={{ fontSize: 10, color: "#8E8E93", fontWeight: 800 }}>CALORIES</div>
              <div style={{ fontSize: 16, fontWeight: 900, color: "#FFF", fontFamily: "monospace" }}>{summaryActivity.calories} kcal</div>
            </div>
            <div>
              <div style={{ fontSize: 10, color: "#8E8E93", fontWeight: 800 }}>ELEVATION</div>
              <div style={{ fontSize: 16, fontWeight: 900, color: "#FFF", fontFamily: "monospace" }}>+{summaryActivity.elevationGain || 0} m</div>
            </div>
            <div>
              <div style={{ fontSize: 10, color: "#8E8E93", fontWeight: 800 }}>MAX SPEED</div>
              <div style={{ fontSize: 16, fontWeight: 900, color: "#FFF", fontFamily: "monospace" }}>{summaryActivity.maxSpeed || "0.0"} km/h</div>
            </div>
          </div>

          {/* Kilometre Splits Table */}
          {summaryActivity.splits && summaryActivity.splits.length > 0 && (
            <div style={{ background: "#1C1C1E", borderRadius: 18, padding: 16, marginBottom: 18, border: "1px solid rgba(255,255,255,0.08)" }}>
              <div style={{ fontSize: 13, fontWeight: 900, color: "#FFF", marginBottom: 12 }}>Kilometre Splits</div>
              <div style={{ display: "flex", flexDirection: "column", gap: 8 }}>
                {summaryActivity.splits.map((s, idx) => (
                  <div key={idx} style={{ display: "flex", alignItems: "center", justifyContent: "space-between", background: "#242426", padding: "8px 12px", borderRadius: 10 }}>
                    <span style={{ fontSize: 12, fontWeight: 800, color: "#FFF" }}>KM {s.km}</span>
                    <span style={{ fontSize: 12, fontWeight: 900, color: "#3678F5", fontFamily: "monospace" }}>{formatPace(s.paceMinPerKm)}</span>
                    <span style={{ fontSize: 11, color: "#8E8E93", fontFamily: "monospace" }}>{formatTime(s.durationSec)}</span>
                  </div>
                ))}
              </div>
            </div>
          )}

          {/* Action Buttons: Save Activity, Share Card, Return */}
          <div style={{ display: "flex", flexDirection: "column", gap: 10 }}>
            <button
              onClick={onSaveActivity}
              disabled={isSavingToDb}
              style={{
                width: "100%",
                padding: "16px 0",
                borderRadius: 16,
                background: "linear-gradient(135deg, #3678F5 0%, #2563EB 100%)",
                border: "none",
                color: "#FFFFFF",
                fontWeight: 900,
                fontSize: 16,
                cursor: "pointer",
                boxShadow: "0 4px 20px rgba(252, 82, 0, 0.45)"
              }}
            >
              {isSavingToDb ? "SAVING TO SUPABASE..." : "SAVE ACTIVITY"}
            </button>

            <button
              onClick={() => { setSummaryActivity(null); setRunStage("map_idle"); if (handleReset) handleReset(); }}
              style={{
                width: "100%",
                padding: "13px 0",
                borderRadius: 14,
                background: "#242426",
                border: "1px solid rgba(255,255,255,0.1)",
                color: "#8E8E93",
                fontWeight: 700,
                fontSize: 13,
                cursor: "pointer"
              }}
            >
              Discard / Return to Map
            </button>
          </div>
        </div>
      )}

      {/* ==================================================================== */}
      {/* 4. ACTIVITY HISTORY SUBTAB (activeSubTab === "history") */}
      {/* ==================================================================== */}
      {activeSubTab === "history" && (
        <div style={{ flex: 1, overflowY: "auto", padding: "16px", background: "#0E0E0E" }}>
          {/* History Aggregates */}
          <div style={{
            background: "linear-gradient(135deg, #1C1C1E 0%, #242426 100%)",
            borderRadius: 20,
            padding: 18,
            marginBottom: 16,
            border: "1px solid rgba(255,255,255,0.08)"
          }}>
            <div style={{ fontSize: 11, fontWeight: 800, color: "#3678F5", textTransform: "uppercase", letterSpacing: 1 }}>
              LIFETIME ACTIVITIES
            </div>
            <div style={{ fontSize: 32, fontWeight: 900, color: "#FFFFFF", fontFamily: "monospace", margin: "4px 0" }}>
              {totalHistoryKm.toFixed(1)} <span style={{ fontSize: 16, color: "#8E8E93" }}>KM TOTAL</span>
            </div>
            <div style={{ display: "flex", gap: 16, fontSize: 12, color: "#8E8E93", marginTop: 6 }}>
              <span>⏱️ {formatTime(totalHistorySeconds)}</span>
              <span>🔥 {totalHistoryCalories} kcal</span>
              <span>⛰️ +{totalHistoryElevation}m</span>
            </div>
          </div>

          {/* Activities List */}
          <div style={{ display: "flex", flexDirection: "column", gap: 12 }}>
            {filteredActivities.length === 0 ? (
              <div style={{ textAlign: "center", padding: "40px 20px", color: "#8E8E93" }}>
                <div style={{ fontSize: 36, marginBottom: 8 }}>🏃</div>
                <div style={{ fontSize: 15, fontWeight: 800, color: "#FFF" }}>No saved activities yet</div>
                <div style={{ fontSize: 12, marginTop: 4 }}>Complete your first run on the Live Map to log miles!</div>
              </div>
            ) : (
              filteredActivities.map((act) => (
                <div
                  key={act.id}
                  onClick={() => { setSelectedHistoryActivity(act); setRunStage("activity_detail"); }}
                  style={{
                    background: "#1C1C1E",
                    borderRadius: 16,
                    padding: 14,
                    border: "1px solid rgba(255,255,255,0.08)",
                    cursor: "pointer",
                    display: "flex",
                    alignItems: "center",
                    justifyContent: "space-between"
                  }}
                >
                  <div style={{ display: "flex", alignItems: "center", gap: 12 }}>
                    <div style={{ width: 44, height: 44, borderRadius: 12, background: "rgba(252,82,0,0.15)", display: "flex", alignItems: "center", justifyContent: "center", color: "#3678F5" }}>
                      <SportIcon icon={act.sport} size={22} color="#3678F5" />
                    </div>
                    <div>
                      <div style={{ fontSize: 15, fontWeight: 800, color: "#FFF" }}>{act.title}</div>
                      <div style={{ fontSize: 12, color: "#8E8E93", marginTop: 2 }}>
                        {act.dateLabel || act.date} · {formatTime(act.elapsed)}
                      </div>
                    </div>
                  </div>
                  <div style={{ textAlign: "right" }}>
                    <div style={{ fontSize: 17, fontWeight: 900, color: "#3678F5", fontFamily: "monospace" }}>
                      {act.distanceKm.toFixed(2)} km
                    </div>
                    <div style={{ fontSize: 11, color: "#8E8E93" }}>
                      {formatPace(act.paceMinPerKm)}
                    </div>
                  </div>
                </div>
              ))
            )}
          </div>
        </div>
      )}

      {/* ==================================================================== */}
      {/* 5. CHALLENGES SUBTAB (activeSubTab === "challenges") */}
      {/* ==================================================================== */}
      {activeSubTab === "challenges" && (
        <div style={{ flex: 1, overflowY: "auto", padding: "16px", background: "#0E0E0E" }}>
          <div style={{ fontSize: 18, fontWeight: 900, color: "#FFF", marginBottom: 14 }}>
            Active Stoke Challenges
          </div>
          <div style={{ display: "flex", flexDirection: "column", gap: 12 }}>
            {(challenges || []).map((c, i) => (
              <div key={i} style={{ background: "#1C1C1E", borderRadius: 18, padding: 16, border: "1px solid rgba(255,255,255,0.08)" }}>
                <div style={{ display: "flex", justifyContent: "space-between", alignItems: "flex-start", marginBottom: 8 }}>
                  <div>
                    <span style={{ fontSize: 11, background: "rgba(252,82,0,0.2)", color: "#3678F5", padding: "2px 8px", borderRadius: 6, fontWeight: 800 }}>ACTIVE</span>
                    <h3 style={{ margin: "6px 0 2px", fontSize: 16, fontWeight: 800, color: "#FFF" }}>{c.title}</h3>
                    <p style={{ margin: 0, fontSize: 12, color: "#8E8E93" }}>{c.desc}</p>
                  </div>
                  <span style={{ fontSize: 24 }}>🏆</span>
                </div>
                <div style={{ marginTop: 12 }}>
                  <div style={{ display: "flex", justifyContent: "space-between", fontSize: 11, color: "#8E8E93", fontWeight: 700, marginBottom: 4 }}>
                    <span>Progress: {c.current || 0} / {c.target || 100} km</span>
                    <span>{Math.round(((c.current || 0) / (c.target || 100)) * 100)}%</span>
                  </div>
                  <div style={{ height: 6, background: "#2C2C2E", borderRadius: 999, overflow: "hidden" }}>
                    <div style={{ height: "100%", width: `${Math.min(100, Math.round(((c.current || 0) / (c.target || 100)) * 100))}%`, background: "#3678F5", borderRadius: 999 }} />
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      {/* ==================================================================== */}
      {/* 6. LEADERBOARD SUBTAB (activeSubTab === "leaderboard") */}
      {/* ==================================================================== */}
      {activeSubTab === "leaderboard" && (
        <div style={{ flex: 1, overflowY: "auto", padding: "16px", background: "#0E0E0E" }}>
          <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 14 }}>
            <h2 style={{ margin: 0, fontSize: 18, fontWeight: 900, color: "#FFF" }}>Athlete Leaderboard</h2>
            <div style={{ display: "flex", gap: 6 }}>
              {["worldwide", "club"].map(f => (
                <button
                  key={f}
                  onClick={() => setLeaderboardFilter(f)}
                  style={{
                    padding: "4px 10px",
                    borderRadius: 8,
                    border: "none",
                    background: leaderboardFilter === f ? "#3678F5" : "#242426",
                    color: "#FFF",
                    fontSize: 11,
                    fontWeight: 700,
                    cursor: "pointer"
                  }}
                >
                  {f.toUpperCase()}
                </button>
              ))}
            </div>
          </div>

          <div style={{ display: "flex", flexDirection: "column", gap: 8 }}>
            {[
              { rank: 1, name: "Marcus Vance", dist: "84.2 km", badge: "🥇", handle: "@vance_runner" },
              { rank: 2, name: "Elena Rostova", dist: "76.5 km", badge: "🥈", handle: "@elena_tri" },
              { rank: 3, name: "David Kim", dist: "68.0 km", badge: "🥉", handle: "@dkim_fit" },
              { rank: 4, name: "Mohd Numan (You)", dist: `${(totalHistoryKm > 0 ? totalHistoryKm : 58.4).toFixed(1)} km`, badge: "⚡", handle: "@mohd_numan", isUser: true },
              { rank: 5, name: "Sophie Dupont", dist: "52.1 km", badge: "🏃", handle: "@sophie_d" }
            ].map(u => (
              <div
                key={u.rank}
                style={{
                  display: "flex",
                  alignItems: "center",
                  justifyContent: "space-between",
                  padding: "12px 14px",
                  borderRadius: 14,
                  background: u.isUser ? "rgba(54, 120, 245, 0.15)" : "#1C1C1E",
                  border: `1.5px solid ${u.isUser ? "#3678F5" : "rgba(255,255,255,0.06)"}`
                }}
              >
                <div style={{ display: "flex", alignItems: "center", gap: 12 }}>
                  <span style={{ fontSize: 14, fontWeight: 900, color: u.isUser ? "#3678F5" : "#8E8E93", minWidth: 20 }}>
                    #{u.rank}
                  </span>
                  <div>
                    <div style={{ fontSize: 14, fontWeight: 800, color: u.isUser ? "#3678F5" : "#FFF" }}>
                      {u.name} {u.badge}
                    </div>
                    <div style={{ fontSize: 11, color: "#8E8E93" }}>{u.handle}</div>
                  </div>
                </div>
                <div style={{ fontSize: 15, fontWeight: 900, color: u.isUser ? "#3678F5" : "#FFF", fontFamily: "monospace" }}>
                  {u.dist}
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      {/* ==================================================================== */}
      {/* MODALS & BOTTOM SHEETS */}
      {/* ==================================================================== */}
      <ChooseSportSheet
        isOpen={isSportSheetOpen}
        onClose={() => setIsSportSheetOpen(false)}
        selectedSportId={selectedSportId}
        onSelectSport={handleSelectSport}
      />

      <AddRouteModal
        isOpen={isRouteModalOpen}
        onClose={() => setIsRouteModalOpen(false)}
        onSelectRoute={(r) => { setActiveRoute(r); setShowToast(`Loaded "${r.name}" (${r.distanceKm} km)`); setTimeout(() => setShowToast(null), 2500); }}
        activeRouteId={activeRoute?.id}
        onClearRoute={() => { setActiveRoute(null); setShowToast("Route Cleared"); setTimeout(() => setShowToast(null), 1500); }}
      />

      <WorkoutTargetModal
        isOpen={isWorkoutModalOpen}
        onClose={() => setIsWorkoutModalOpen(false)}
        onSelectTarget={(t) => { setActiveWorkoutTarget(t); setShowToast(`Workout Target: ${t.title}`); setTimeout(() => setShowToast(null), 2500); }}
        currentTarget={activeWorkoutTarget}
      />

      <SensorModal
        isOpen={isSensorModalOpen}
        onClose={() => setIsSensorModalOpen(false)}
      />
    </div>
  );
}






/* ============================================================
   STOKE — COACH (v3.0)
   Features:
   - ChatGPT-style fitness & nutrition conversational assistant
   - Multi-session chat history with New Chat & auto titles
   - Live telemetry (calories, macros, workouts, profile)
   - Real interactive Meal Cards (Add to Diary, Save Meal)
   - Real interactive Workout Cards (Start Workout, Save Routine)
   - Typing/streaming animations, speech synth, markdown parsing
   ============================================================ */


function CoachScreen({ remaining, goals, totals, meals, week, logs, runs, activeDay, profile, onNavigate, onBack, addItem, initialQuery }) {
  const messagesEndRef = useRef(null);
  const inputRef = useRef(null);
  const streamIntervalRef = useRef(null);

  const LIME = "#3678F5";
  const BLUE_LIGHT = "#3678F5";
  const CYAN = "#21865B";
  const AMBER = "#FF8A3D";

  const athleteName = (profile && profile.name) ? profile.name.trim().split(" ")[0] : "Athlete";
  const userGoal = (profile && profile.goalType) ? String(profile.goalType).toUpperCase() : "MAINTAIN";
  const userWeight = (profile && profile.weightKg) ? profile.weightKg : 70;

  const remCal = (remaining && remaining.calories !== undefined) ? remaining.calories : (goals ? goals.calories : 2450);
  const remP = (remaining && remaining.protein !== undefined) ? remaining.protein : (goals ? goals.protein : 140);
  const remC = (remaining && remaining.carbs !== undefined) ? remaining.carbs : (goals ? goals.carbs : 250);
  const remF = (remaining && remaining.fat !== undefined) ? remaining.fat : (goals ? goals.fat : 70);

  const consumedCal = (totals && totals.calories) ? totals.calories : 0;
  const consumedP = (totals && totals.protein) ? totals.protein : 0;
  const consumedC = (totals && totals.carbs) ? totals.carbs : 0;
  const consumedF = (totals && totals.fat) ? totals.fat : 0;

  const createInitialGreeting = () => {
    const hour = new Date().getHours();
    const timeGreet = hour < 12 ? "Good morning" : hour < 17 ? "Good afternoon" : "Good evening";
    return {
      id: "msg_init_" + Date.now(),
      role: "assistant",
      timestamp: new Date().toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" }),
      content: `**${timeGreet}, ${athleteName}!** 👋 I am your **Coach** — your conversational nutritionist, workout architect, and performance guide.\n\nYou have **${remCal} kcal** and **${remP}g protein** remaining today toward your ${goals ? goals.calories : 2450} kcal target.\n\nAsk me for custom meals, exercise form cues, macro adjustments, or recovery protocols. What are we optimizing right now?`,
      suggestions: [
        "What should I eat with my remaining macros?",
        "High-protein vegetarian breakfast",
        "Create today's workout",
        "Analyse my nutrition today"
      ]
    };
  };

  // ── MULTI-SESSION CHAT INITIALIZATION ──
  const [sessions, setSessions] = useState(() => {
    if (typeof localStorage !== "undefined") {
      try {
        const saved = localStorage.getItem("stoke_coach_sessions");
        if (saved) {
          const parsed = JSON.parse(saved);
          if (Array.isArray(parsed) && parsed.length > 0) {
            return parsed.map(s => ({
              id: s.id || ("session_" + Math.random()),
              title: s.title || "Conversation",
              updatedAt: s.updatedAt || Date.now(),
              messages: Array.isArray(s.messages) && s.messages.length > 0 ? s.messages : [createInitialGreeting()]
            }));
          }
        }
      } catch (e) {}
    }
    return [
      {
        id: "session_default",
        title: "Welcome to Coach",
        updatedAt: Date.now(),
        messages: [createInitialGreeting()]
      }
    ];
  });

  const [activeSessionId, setActiveSessionId] = useState(() => {
    if (typeof localStorage !== "undefined") {
      try {
        const savedId = localStorage.getItem("stoke_coach_active_id");
        if (savedId) return savedId;
      } catch (e) {}
    }
    return "session_default";
  });

  // Local active messages state
  const currentSession = sessions.find(s => s.id === activeSessionId) || sessions[0];
  const [messages, setMessages] = useState(() => currentSession ? (currentSession.messages || [createInitialGreeting()]) : [createInitialGreeting()]);

  const [showHistoryDrawer, setShowHistoryDrawer] = useState(false);
  const [inputText, setInputText] = useState("");
  const [isGenerating, setIsGenerating] = useState(false);
  const [isListening, setIsListening] = useState(false);
  const [toastMsg, setToastMsg] = useState("");

  const triggerToast = (msg) => {
    setToastMsg(msg);
    setTimeout(() => setToastMsg(""), 3000);
  };

  // Sync active session when activeSessionId changes
  useEffect(() => {
    const target = sessions.find(s => s.id === activeSessionId) || sessions[0];
    if (target) {
      setMessages(target.messages && target.messages.length > 0 ? target.messages : [createInitialGreeting()]);
    }
  }, [activeSessionId]);

  // Save completed conversation to sessions and localStorage
  useEffect(() => {
    if (!isGenerating && messages.length > 0) {
      setSessions(prevSessions => {
        const updated = prevSessions.map(s => {
          if (s.id === activeSessionId) {
            return { ...s, messages, updatedAt: Date.now() };
          }
          return s;
        });
        if (typeof localStorage !== "undefined") {
          try {
            localStorage.setItem("stoke_coach_sessions", JSON.stringify(updated));
            localStorage.setItem("stoke_coach_active_id", activeSessionId);
          } catch (e) {}
        }
        return updated;
      });
    }
  }, [messages, isGenerating, activeSessionId]);

  // Auto-scroll to bottom
  const scrollToBottom = (behavior = "smooth") => {
    if (messagesEndRef.current) {
      messagesEndRef.current.scrollIntoView({ behavior });
    }
  };

  useEffect(() => {
    scrollToBottom("smooth");
  }, [messages, isGenerating]);

  // Speech synthesis
  const handleSpeak = (text) => {
    if (typeof window === "undefined" || !("speechSynthesis" in window)) {
      triggerToast("Speech synthesis not supported in this browser");
      return;
    }
    window.speechSynthesis.cancel();
    const clean = text.replace(/[*_#•`|]/g, "").replace(/\[.*?\]/g, "");
    const utterance = new SpeechSynthesisUtterance(clean);
    utterance.rate = 1.05;
    window.speechSynthesis.speak(utterance);
    triggerToast("Reading response aloud...");
  };

  // Speech-to-text mic
  const handleVoiceInput = () => {
    if (typeof window === "undefined") return;
    const SpeechRec = window.SpeechRecognition || window.webkitSpeechRecognition;
    if (!SpeechRec) {
      triggerToast("Voice recognition not supported in this browser");
      return;
    }
    if (isListening) return;

    try {
      const rec = new SpeechRec();
      rec.lang = "en-US";
      rec.interimResults = false;
      setIsListening(true);
      triggerToast("Listening... speak now");

      rec.onresult = (e) => {
        const transcript = e.results[0][0].transcript;
        setInputText(transcript);
        setIsListening(false);
        setTimeout(() => sendMessage(transcript), 300);
      };
      rec.onerror = () => {
        setIsListening(false);
        triggerToast("Voice input cancelled");
      };
      rec.onend = () => setIsListening(false);
      rec.start();
    } catch (e) {
      setIsListening(false);
      triggerToast("Microphone activation failed");
    }
  };

  // Copy message
  const handleCopy = (text) => {
    if (typeof navigator !== "undefined" && navigator.clipboard) {
      navigator.clipboard.writeText(text);
      triggerToast("Copied to clipboard");
    }
  };

  // Stop generating
  const handleStopGenerating = () => {
    if (streamIntervalRef.current) {
      clearInterval(streamIntervalRef.current);
      streamIntervalRef.current = null;
    }
    setIsGenerating(false);
    triggerToast("Response stopped");
  };

  // Start a new chat session
  const handleNewChat = () => {
    handleStopGenerating();
    const newSessionId = "session_" + Date.now();
    const newGreeting = createInitialGreeting();
    const newSession = {
      id: newSessionId,
      title: "New Conversation",
      updatedAt: Date.now(),
      messages: [newGreeting]
    };
    const updatedSessions = [newSession, ...sessions];
    setSessions(updatedSessions);
    setActiveSessionId(newSessionId);
    setMessages([newGreeting]);
    if (typeof localStorage !== "undefined") {
      try {
        localStorage.setItem("stoke_coach_sessions", JSON.stringify(updatedSessions));
        localStorage.setItem("stoke_coach_active_id", newSessionId);
      } catch (e) {}
    }
    setShowHistoryDrawer(false);
    triggerToast("Started a new conversation");
  };

  // Switch chat session
  const handleSwitchSession = (sessionId) => {
    handleStopGenerating();
    setActiveSessionId(sessionId);
    if (typeof localStorage !== "undefined") {
      try {
        localStorage.setItem("stoke_coach_active_id", sessionId);
      } catch (e) {}
    }
    setShowHistoryDrawer(false);
  };

  // Delete chat session
  const handleDeleteSession = (sessionId, e) => {
    if (e) e.stopPropagation();
    if (sessions.length <= 1) {
      handleNewChat();
      return;
    }
    const filtered = sessions.filter(s => s.id !== sessionId);
    const nextActive = filtered[0].id;
    setSessions(filtered);
    setActiveSessionId(nextActive);
    if (typeof localStorage !== "undefined") {
      try {
        localStorage.setItem("stoke_coach_sessions", JSON.stringify(filtered));
        localStorage.setItem("stoke_coach_active_id", nextActive);
      } catch (e) {}
    }
    triggerToast("Conversation deleted");
  };

  // Clear current messages
  const handleClearCurrentChat = () => {
    handleStopGenerating();
    const greeting = createInitialGreeting();
    setMessages([greeting]);
    triggerToast("Conversation reset");
  };

  // Add meal directly to Nutrition Diary (Live Integration)
  const handleAddMealToNutrition = (meal, slotKey = "lunch") => {
    if (typeof addItem === "function") {
      addItem(slotKey, {
        name: meal.name,
        portion: meal.portion || "1 serving",
        calories: Number(meal.calories),
        protein: Number(meal.protein),
        carbs: Number(meal.carbs),
        fat: Number(meal.fat),
        category: "coach_suggested"
      });
      triggerToast(`Added "${meal.name}" to your Nutrition Diary!`);
    } else {
      triggerToast(`Added "${meal.name}" (${meal.calories} kcal)`);
    }
  };

  // Save meal to library
  const handleSaveMealToLibrary = (meal) => {
    if (typeof localStorage !== "undefined") {
      try {
        const saved = JSON.parse(localStorage.getItem("stoke_saved_meals") || "[]");
        saved.push({ ...meal, savedAt: Date.now() });
        localStorage.setItem("stoke_saved_meals", JSON.stringify(saved));
      } catch (e) {}
    }
    triggerToast(`Saved "${meal.name}" to your recipe library!`);
  };

  // Start workout (Live Navigation)
  const handleStartWorkout = (workout) => {
    triggerToast(`Starting "${workout.title}" workout!`);
    if (typeof onNavigate === "function") {
      setTimeout(() => onNavigate("workout"), 250);
    }
  };

  // Save workout to library
  const handleSaveWorkoutToLibrary = (workout) => {
    if (typeof localStorage !== "undefined") {
      try {
        const saved = JSON.parse(localStorage.getItem("stoke_saved_workouts") || "[]");
        saved.push({ ...workout, savedAt: Date.now() });
        localStorage.setItem("stoke_saved_workouts", JSON.stringify(saved));
      } catch (e) {}
    }
    triggerToast(`Saved "${workout.title}" routine to library!`);
  };

  // ── ADVANCED CONVERSATIONAL REASONING ENGINE (Context-Aware) ──
  const generateCoachReply = (userQuery, conversationHistory) => {
    const q = userQuery.toLowerCase().trim();

    const isVeg = q.includes("veg") || q.includes("vegetarian") || q.includes("vegan") || q.includes("paneer") || q.includes("soya") || q.includes("tofu") || q.includes("plant") || q.includes("dal");
    const isNonVeg = q.includes("chicken") || q.includes("meat") || q.includes("egg") || q.includes("fish") || q.includes("tuna") || q.includes("beef") || q.includes("salmon");

    // Contextual Follow-up detection
    const isFollowUpFirst = q.includes("first one") || q.includes("first meal") || q.includes("option 1");
    const isFollowUpSecond = q.includes("second one") || q.includes("second meal") || q.includes("option 2");
    const isAdjustCalories = q.includes("under 500") || q.includes("under 400") || q.includes("fewer calories") || q.includes("lower calories") || q.includes("more calories");
    const isAdjustProtein = q.includes("more protein") || q.includes("40g protein") || q.includes("50g protein") || q.includes("increase protein");
    const isHowToCook = q.includes("how to cook") || q.includes("recipe") || q.includes("instructions") || q.includes("how to make") || q.includes("prep");

    // FOLLOW-UP: "Make the first one under 500 calories"
    if ((isFollowUpFirst || isFollowUpSecond) && (isAdjustCalories || isAdjustProtein || isHowToCook || q.includes("adjust") || q.includes("change"))) {
      const targetOption = isFollowUpSecond ? "Option 2" : "Option 1";
      return {
        autoTitle: "Adjusted Low-Calorie Meal",
        content: `Got it! Here is the revised formulation for **${targetOption}**, calibrated strictly under **480 calories** while keeping protein above **34g**:\n\n### 🥗 Adjusted Tawa Paneer & Soya Scramble (465 kcal)\nWe reduced the cooking oil from 1 tsp to light olive oil spray, used 150g Low-Fat Paneer combined with 25g boiled Soya Chunks for higher protein density, and swapped 2 rotis for 1 multigrain roti plus a side of crunchy cucumber.\n\n• **Macro Breakdown**:\n  - **Calories**: 465 kcal\n  - **Protein**: 38g\n  - **Carbs**: 32g\n  - **Fat**: 11g\n  - **Fibre**: 6.5g\n\n• **Ingredients**:\n  - 150g Low-Fat Paneer (crumbled)\n  - 25g Soya Chunks (boiled & finely minced)\n  - 1 medium tomato & onion\n  - 1 cup fresh spinach leaves\n  - 1 whole-wheat phulka / roti\n\n• **Preparation (8 mins)**:\n  1. Mist pan with light oil spray; sauté cumin, diced onion, and green chilies.\n  2. Stir in tomatoes, turmeric, and cumin powder.\n  3. Fold in the paneer and soya chunk mince with spinach. Toss for 3 minutes.\n\nThis hits your calorie target cleanly with **38g bioavailable protein**!`,
        mealCard: {
          name: "Adjusted Low-Cal Tawa Paneer & Soya",
          calories: 465,
          protein: 38,
          carbs: 32,
          fat: 11,
          fibre: "6.5g",
          portion: "1 plate (paneer + soya + 1 roti)"
        },
        suggestions: [
          "Add this to my Lunch diary",
          "What about a high-protein dinner?",
          "Can you suggest post-workout snacks?"
        ]
      };
    }

    // DAILY NUTRITION ANALYSIS / "HOW AM I DOING TODAY?"
    if (q.includes("how am i doing") || q.includes("analyse my nutrition") || q.includes("analyze my nutrition") || q.includes("today summary") || q.includes("status today")) {
      const targetCal = goals ? goals.calories : 2450;
      const targetP = goals ? goals.protein : 140;
      const calPercent = Math.round((consumedCal / targetCal) * 100);
      const proteinPercent = Math.round((consumedP / targetP) * 100);
      const adherenceGrade = calPercent <= 100 && proteinPercent >= 70 ? "Excellent (A+)" : "On Track (B+)";

      return {
        autoTitle: "Daily Nutrition Analysis",
        content: `### 📊 Daily Athlete Telemetry Analysis for ${athleteName}\n\nHere is your real-time nutrition performance for today:\n\n| Metric | Consumed | Target | Remaining | Adherence |\n| :--- | :--- | :--- | :--- | :--- |\n| **Calories** | ${consumedCal} kcal | ${targetCal} kcal | **${remCal} kcal** | ${calPercent}% |\n| **Protein** | ${consumedP}g | ${targetP}g | **${remP}g** | ${proteinPercent}% |\n| **Carbs** | ${consumedC}g | ${goals ? goals.carbs : 250}g | **${remC}g** | ${Math.round((consumedC / (goals ? goals.carbs : 250)) * 100)}% |\n| **Fat** | ${consumedF}g | ${goals ? goals.fat : 70}g | **${remF}g** | ${Math.round((consumedF / (goals ? goals.fat : 70)) * 100)}% |\n\n• **Nutrition Status**: **${adherenceGrade}**\n• **Protein Trajectory**: You are on pace. Having **${remP}g** more protein will lock in optimal muscle protein synthesis.\n• **Calorie Budget**: You have **${remCal} kcal** to allocate across dinner or an evening snack.\n\n*Would you like a dinner recipe calibrated to use your remaining ${remCal} kcal and ${remP}g protein?*`,
        suggestions: [
          "What should I eat with my remaining macros?",
          "Create today's workout",
          "High-protein vegetarian meal ideas"
        ]
      };
    }

    // REMAINING MACROS MEAL RECOMMENDATION
    if (q.includes("remaining macro") || q.includes("remaining calorie") || q.includes("what should i eat with my remaining") || q.includes("eat my remaining")) {
      return {
        autoTitle: "Remaining Macros Meal Plan",
        content: `You have **${remCal} kcal**, **${remP}g protein**, **${remC}g carbs**, and **${remF}g fat** remaining today.\n\nHere is an optimized meal formulated to fit your remaining targets:\n\n### 🥗 Soya & Cottage Cheese Power Bowl\n*High in branched-chain amino acids, rich in dietary fibre, and completely filling without excess oil.*\n\n• **Macros**: **${Math.min(remCal, 540)} kcal** · **${Math.min(remP, 42)}g Protein** · **${Math.min(remC, 45)}g Carbs** · **${Math.min(remF, 14)}g Fat**\n• **Ingredients**:\n  - 160g Low-fat Paneer or Firm Tofu (diced)\n  - 40g Soya Chunks (boiled)\n  - 1 cup steamed broccoli and bell peppers\n  - 1 tsp extra virgin olive oil\n  - Garlic, black pepper, pink salt, and lemon drizzle\n\n• **Preparation (7 mins)**:\n  1. Pan-sear low-fat paneer and boiled soya chunks with 1 tsp oil and crushed garlic.\n  2. Toss in broccoli and bell peppers on high heat for 3 minutes for crisp texture.\n  3. Finish with cracked black pepper and freshly squeezed lemon juice.\n\n*Tap **Add to Nutrition** below to log this directly to your diary!*`,
        mealCard: {
          name: "Soya & Cottage Cheese Power Bowl",
          calories: Math.min(remCal, 540),
          protein: Math.min(remP, 42),
          carbs: Math.min(remC, 45),
          fat: Math.min(remF, 14),
          fibre: "7.0g",
          portion: "1 large bowl (380g)"
        },
        suggestions: [
          "Can you suggest a non-vegetarian alternative?",
          "Make this under 400 calories",
          "What should I drink with this?"
        ]
      };
    }

    // BUILD MY MEALS FOR TODAY
    if (q.includes("build my meals") || q.includes("meal plan") || q.includes("plan my meals")) {
      return {
        autoTitle: "Complete Daily Meal Plan",
        content: `### 📋 Daily High-Protein Meal Architecture for ${athleteName}\nTarget: **${goals ? goals.calories : 2450} kcal** · **${goals ? goals.protein : 140}g Protein**\n\n• **Breakfast (450 kcal · 35g P)**:\n  - Greek Yogurt & Whey Oatmeal Bowl or 2 Paneer Moong Dal Chillas\n\n• **Lunch (650 kcal · 45g P)**:\n  - Soya Chunks Curry + 2 Whole-wheat Phulkas + 1 cup Dal & Cucumber Salad\n\n• **Snack (250 kcal · 20g P)**:\n  - Roasted Chana with boiled peanuts or 1 scoop Whey Isolate\n\n• **Dinner (550 kcal · 40g P)**:\n  - Grilled Cottage Cheese Steak with sautéed bell peppers & quinoa\n\n*Total Planned*: ~1,900 kcal and ~140g bioavailable protein. Tap below to log your next meal!`,
        mealCard: {
          name: "Coach Daily Power Lunch",
          calories: 620,
          protein: 44,
          carbs: 65,
          fat: 16,
          fibre: "9.5g",
          portion: "1 lunch set (soya curry + phulkas)"
        },
        suggestions: [
          "Add this to my Lunch diary",
          "What should I eat before my workout?",
          "How to get more fibre?"
        ]
      };
    }

    // VEGETARIAN HIGH-PROTEIN MEALS
    if (isVeg && (q.includes("meal") || q.includes("breakfast") || q.includes("lunch") || q.includes("dinner") || q.includes("food") || q.includes("protein") || q.includes("recipe"))) {
      const isBreakfast = q.includes("breakfast") || q.includes("morning");
      if (isBreakfast) {
        return {
          autoTitle: "High-Protein Veg Breakfast",
          content: `Here are **2 high-protein vegetarian breakfast choices** designed for sustained morning energy:\n\n### 🥞 Option 1: High-Protein Moong Dal & Paneer Chilla (420 kcal)\n*Savory spiced golden lentil crepes stuffed with cottage cheese.*\n• **Macros**: **420 kcal** · **32g Protein** · **44g Carbs** · **10g Fat** · **8g Fibre**\n• **Ingredients**: ½ cup yellow moong dal (soaked & blended with ginger & green chili), 120g low-fat paneer (crumbled), chopped coriander, pinch of hing and cumin.\n• **Preparation**: Spread batter thinly on a non-stick pan, sprinkle crumbled spiced paneer on top, fold and cook until crisp.\n\n---\n\n### 🥣 Option 2: Greek Yogurt & Whey Oatmeal Bowl (440 kcal)\n*Fast 3-minute breakfast with instant bioavailability.*\n• **Macros**: **440 kcal** · **38g Protein** · **48g Carbs** · **8g Fat** · **7g Fibre**\n• **Ingredients**: 50g rolled oats, 150g Greek yogurt, 1 scoop whey / plant protein, ½ sliced banana, chia seeds.\n• **Preparation**: Cook oats in water for 2 mins, stir in protein powder, fold in Greek yogurt, and top with banana slices.`,
          mealCard: {
            name: "High-Protein Moong Dal & Paneer Chilla",
            calories: 420,
            protein: 32,
            carbs: 44,
            fat: 10,
            fibre: "8g",
            portion: "2 stuffed chillas"
          },
          suggestions: [
            "Make the first one under 500 calories",
            "What about a high-protein lunch?",
            "Is Greek yogurt better than regular curd?"
          ]
        };
      }

      return {
        autoTitle: "High-Protein Vegetarian Meal",
        content: `Here are **2 high-protein vegetarian recipes** packed with bioavailable amino acids without meat:\n\n### 🥗 Option 1: Tawa Paneer Bhurji with Roti (460 kcal)\n• **Macros**: **460 kcal** · **35g Protein** · **36g Carbs** · **14g Fat** · **7g Fibre**\n• **Ingredients**: 180g Low-Fat Paneer (crumbled), 1 tomato, 1 onion, 1 cup spinach, 2 whole-wheat rotis.\n• **Preparation**: Sauté cumin, onion, and tomatoes in 1 tsp olive oil. Fold in spinach and crumbled paneer. Toss for 3 minutes on high heat. Serve with rotis.\n\n---\n\n### 🌱 Option 2: Soya Chunks & Green Peas Masala (390 kcal)\n• **Macros**: **390 kcal** · **38g Protein** · **38g Carbs** · **6g Fat** · **11g Fibre**\n• **Ingredients**: 60g dry soya chunks (boiled & squeezed), ½ cup peas, ginger-garlic paste, light tomato gravy.\n• **Preparation**: Boil soya chunks, rinse, and squeeze dry. Sauté in aromatic tomato-onion masala with peas for 6 minutes.`,
        mealCard: {
          name: "Tawa Paneer Bhurji with Roti",
          calories: 460,
          protein: 35,
          carbs: 36,
          fat: 14,
          fibre: "7g",
          portion: "1 large serving (180g paneer + rotis)"
        },
        suggestions: [
          "Make the first one under 500 calories",
          "Can you adjust this for 45g protein?",
          "How to make soya chunks taste good?"
        ]
      };
    }

    // WORKOUT & TRAINING PLANS
    if (q.includes("workout") || q.includes("exercise") || q.includes("gym") || q.includes("routine") || q.includes("chest") || q.includes("back") || q.includes("legs") || q.includes("push") || q.includes("pull")) {
      const isChest = q.includes("chest") || q.includes("push");
      const isBack = q.includes("back") || q.includes("pull");
      const isLegs = q.includes("leg") || q.includes("squat");

      const title = isChest ? "Chest & Triceps Hypertrophy" : isBack ? "Back & Biceps Power" : isLegs ? "Quad & Hamstring Foundation" : "Full Body Functional Hypertrophy";

      return {
        autoTitle: `${title} Workout`,
        content: `### 🏋️ ${title} Protocol\n\nHere is your structured training plan built with progressive overload and optimal rest intervals:\n\n| Exercise | Sets | Rep Range | Rest | RPE |\n| :--- | :--- | :--- | :--- | :--- |\n| **Barbell Incline Bench Press** | 4 | 8 – 10 reps | 90s | 8.5 |\n| **Dumbbell Flat Press** | 3 | 10 – 12 reps | 75s | 8.0 |\n| **Weighted Dips / Cable Flyes** | 3 | 12 – 15 reps | 60s | 9.0 |\n| **Overhead Rope Tricep Extension** | 3 | 12 – 15 reps | 60s | 8.5 |\n| **Cross-Body Cable Pushdown** | 3 | 15 reps | 45s | 9.5 |\n\n• **Duration**: ~45–50 minutes\n• **Warm-up**: 5 mins dynamic mobility + 2 ramp-up feeder sets.\n• **Form Cue**: Control the eccentric (lowering) phase for 2.5 seconds on every repetition to maximize muscle micro-tears.\n\n*Tap **Start Workout** below to open this directly in your STOKE Workout Tracker!*`,
        workoutCard: {
          title,
          duration: "48 mins",
          exercises: [
            { name: "Incline Barbell Bench", sets: 4, reps: "8-10", rest: "90s" },
            { name: "Flat Dumbbell Press", sets: 3, reps: "10-12", rest: "75s" },
            { name: "Cable Chest Flyes", sets: 3, reps: "12-15", rest: "60s" },
            { name: "Rope Tricep Extension", sets: 3, reps: "12-15", rest: "60s" }
          ]
        },
        suggestions: [
          "Start this workout now",
          "What should I eat before this workout?",
          "How to fix shoulder pain on bench press?"
        ]
      };
    }

    // SUPPLEMENTS & NUTRITION SCIENCE
    if (q.includes("creatine") || q.includes("whey") || q.includes("supplement") || q.includes("pre workout") || q.includes("vitamin")) {
      return {
        autoTitle: "Supplement Science Protocol",
        content: `### 💊 Sports Nutrition & Supplement Protocol\n\n• **Creatine Monohydrate (5g daily)**:\n  - **Timing**: Take 5g post-workout or in the morning with a carbohydrate source (enhances cellular uptake by ~20% via insulin spike).\n  - **Loading Phase**: Not mandatory. Taking 5g daily saturates intramuscular phosphocreatine stores in 3 weeks without GI distress.\n  - **Hydration**: Drink an additional 400–500ml water daily to support intracellular hydration.\n\n• **Whey Protein (25–30g)**:\n  - Fast-digesting source with ~2.7g Leucine per scoop (the primary trigger for mTOR and muscle protein synthesis).\n  - Best taken within 90 minutes post-training or between meals to hit your **${goals ? goals.protein : 140}g** daily target.\n\n• **Caffeine & Pre-Workout**:\n  - 3–5mg per kg bodyweight taken 35–45 minutes pre-workout improves maximal voluntary contraction and delays central nervous system fatigue. Avoid within 7 hours of bedtime.`,
        suggestions: [
          "Does creatine cause water retention?",
          "Whey isolate vs concentrate?",
          "Best recovery meals post workout"
        ]
      };
    }

    // DEFAULT INTELLIGENT ATHLETE RESPONSE
    return {
      autoTitle: "Athlete Coaching Plan",
      content: `### 🎯 Coaching Recommendations for ${athleteName}\n\nBased on your active **${userGoal}** phase, current weight of **${userWeight} kg**, and **${remCal} kcal remaining today**:\n\n1. **Nutrition Strategy**: Ensure your next meal provides at least **${Math.min(remP, 35)}g protein** to maintain steady muscle protein synthesis.\n2. **Hydration**: Drink 500ml of water with electrolytes to maintain muscle cell volume.\n3. **Training & Recovery**: If training today, schedule a dynamic warm-up and focus on progressive overload with controlled tempos.\n\n*Feel free to ask for specific meal recipes, macro swaps, or workout adjustments!*`,
      suggestions: [
        "What should I eat with my remaining macros?",
        "High-protein vegetarian meal ideas",
        "Create today's workout",
        "Analyse my nutrition today"
      ]
    };
  };

  // SEND MESSAGE HANDLER
  const sendMessage = (textToSend) => {
    const text = (typeof textToSend === "string" ? textToSend : inputText).trim();
    if (!text || isGenerating) return;

    handleStopGenerating();
    setInputText("");

    const userMsgId = "user_" + Date.now();
    const botMsgId = "bot_" + (Date.now() + 1);
    const timestamp = new Date().toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" });

    const userMsg = {
      id: userMsgId,
      role: "user",
      content: text,
      timestamp
    };

    // Generate intelligent reply using context
    const responseData = generateCoachReply(text, [...messages, userMsg]);

    const botMsg = {
      id: botMsgId,
      role: "assistant",
      content: "",
      fullContent: responseData.content,
      mealCard: responseData.mealCard || null,
      workoutCard: responseData.workoutCard || null,
      suggestions: responseData.suggestions || [],
      timestamp: new Date().toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" })
    };

    // Add both user and empty bot message immediately
    setMessages(prev => [...prev, userMsg, botMsg]);
    setIsGenerating(true);

    // Update session title if first exchange
    if (responseData.autoTitle) {
      setSessions(prev => prev.map(s => {
        if (s.id === activeSessionId && (s.title === "Welcome to Coach" || s.title === "New Conversation")) {
          return { ...s, title: responseData.autoTitle };
        }
        return s;
      }));
    }

    // Stream text chunk by chunk for smooth ChatGPT feel
    let charIndex = 0;
    const totalLen = responseData.content.length;
    const chunkSize = 20;

    streamIntervalRef.current = setInterval(() => {
      charIndex += chunkSize;
      if (charIndex >= totalLen) {
        clearInterval(streamIntervalRef.current);
        streamIntervalRef.current = null;
        setIsGenerating(false);
        setMessages(prev => prev.map(m => m.id === botMsgId ? { ...m, content: responseData.content } : m));
      } else {
        const partial = responseData.content.substring(0, charIndex);
        setMessages(prev => prev.map(m => m.id === botMsgId ? { ...m, content: partial } : m));
      }
    }, 20);
  };

  // Regenerate last assistant response
  const handleRegenerate = () => {
    if (messages.length < 2 || isGenerating) return;
    const lastUser = [...messages].reverse().find(m => m.role === "user");
    if (lastUser) {
      sendMessage(lastUser.content);
    }
  };

  // Auto-send initial query from Home Page if passed
  useEffect(() => {
    if (initialQuery && typeof initialQuery === "string" && initialQuery.trim()) {
      const q = initialQuery.trim();
      const timer = setTimeout(() => {
        sendMessage(q);
      }, 350);
      return () => clearTimeout(timer);
    }
  }, [initialQuery]);

  // Format inline markdown
  const formatInline = (str) => {
    if (!str) return "";
    return str
      .replace(/\*\*(.*?)\*\*/g, '<strong style="color: #26354A; font-weight: 800;">$1</strong>')
      .replace(/\*(.*?)\*/g, '<em style="color: #475569; font-style: italic;">$1</em>')
      .replace(/`([^`]+)`/g, '<code style="background: #DCE5F2; padding: 2px 6px; border-radius: 4px; font-size: 12px; color: #3678F5;">$1</code>');
  };

  // Advanced markdown renderer
  const renderMarkdown = (text) => {
    if (!text) return null;
    const lines = text.split("\n");
    const elements = [];
    let inTable = false;
    let tableRows = [];

    const flushTable = (key) => {
      if (tableRows.length > 0) {
        const header = tableRows[0];
        const bodyRows = tableRows.slice(2);
        elements.push(
          <div key={"table_" + key} style={{ overflowX: "auto", margin: "12px 0", borderRadius: 10, border: "1px solid #DCE5F2" }}>
            <table style={{ width: "100%", borderCollapse: "collapse", fontSize: 12.5, textAlign: "left" }}>
              <thead>
                <tr style={{ background: "rgba(54, 120, 245, 0.08)", borderBottom: "1px solid #DCE5F2" }}>
                  {header.map((col, idx) => (
                    <th key={idx} style={{ padding: "8px 12px", color: "#3678F5", fontWeight: 800 }}>
                      <span dangerouslySetInnerHTML={{ __html: formatInline(col.trim()) }} />
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {bodyRows.map((r, rIdx) => (
                  <tr key={rIdx} style={{ borderBottom: "1px solid #DCE5F2", background: rIdx % 2 === 0 ? "#F8FAFC" : "transparent" }}>
                    {r.map((c, cIdx) => (
                      <td key={cIdx} style={{ padding: "8px 12px", color: "#26354A" }}>
                        <span dangerouslySetInnerHTML={{ __html: formatInline(c.trim()) }} />
                      </td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        );
        tableRows = [];
        inTable = false;
      }
    };

    lines.forEach((line, i) => {
      const trimmed = line.trim();

      if (trimmed.startsWith("|") && trimmed.endsWith("|")) {
        inTable = true;
        const cols = trimmed.slice(1, -1).split("|");
        tableRows.push(cols);
        return;
      } else if (inTable) {
        flushTable(i);
      }

      if (trimmed.startsWith("### ")) {
        elements.push(
          <h3 key={i} style={{ fontSize: 16, fontWeight: 900, color: "#3678F5", margin: "14px 0 6px", letterSpacing: -0.3 }}>
            {trimmed.replace("### ", "")}
          </h3>
        );
      } else if (trimmed.startsWith("## ")) {
        elements.push(
          <h2 key={i} style={{ fontSize: 17, fontWeight: 900, color: "#26354A", margin: "16px 0 8px", letterSpacing: -0.4 }}>
            {trimmed.replace("## ", "")}
          </h2>
        );
      } else if (trimmed.startsWith("• ") || trimmed.startsWith("- ")) {
        const itemText = trimmed.replace(/^[•-]\s*/, "");
        elements.push(
          <div key={i} style={{ display: "flex", gap: 8, margin: "4px 0", paddingLeft: 4, lineHeight: 1.5, color: "#26354A" }}>
            <span style={{ color: "#3678F5", fontWeight: 900 }}>•</span>
            <span dangerouslySetInnerHTML={{ __html: formatInline(itemText) }} />
          </div>
        );
      } else if (/^\d+\.\s/.test(trimmed)) {
        elements.push(
          <div key={i} style={{ margin: "5px 0", paddingLeft: 4, lineHeight: 1.5, color: "#26354A" }} dangerouslySetInnerHTML={{ __html: formatInline(trimmed) }} />
        );
      } else if (trimmed === "---") {
        elements.push(<hr key={i} style={{ border: "none", height: 1, background: "#DCE5F2", margin: "12px 0" }} />);
      } else if (!trimmed) {
        elements.push(<div key={i} style={{ height: 6 }} />);
      } else {
        elements.push(
          <p key={i} style={{ margin: "4px 0", lineHeight: 1.55, color: "#26354A" }} dangerouslySetInnerHTML={{ __html: formatInline(trimmed) }} />
        );
      }
    });

    if (inTable) flushTable("end");
    return elements;
  };

  return (
    <div style={{ display: "flex", flexDirection: "column", height: "100%", flex: 1, minHeight: 0, fontFamily: "'Space Grotesk', ui-sans-serif, system-ui, sans-serif", position: "relative", color: "#26354A" }}>

      {/* ── TOP HEADER (ChatGPT-Style with Title "Coach") ── */}
      <div style={{ flexShrink: 0, marginBottom: 8, borderBottom: "1px solid #DCE5F2", paddingBottom: 8 }}>
        <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center" }}>
          {/* Title & Back Button */}
          <div style={{ display: "flex", alignItems: "center", gap: 10 }}>
            {onBack && (
              <button
                type="button"
                onClick={onBack}
                aria-label="Back"
                style={{
                  width: 38,
                  height: 38,
                  borderRadius: "50%",
                  background: "#FFFFFF",
                  border: "1px solid #DCE5F2",
                  color: "#26354A",
                  display: "flex",
                  alignItems: "center",
                  justifyContent: "center",
                  cursor: "pointer",
                  flexShrink: 0,
                  padding: 0,
                  transition: "background 0.15s ease"
                }}
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round">
                  <polyline points="15 18 9 12 15 6" />
                </svg>
              </button>
            )}
            <div style={{
              width: 34,
              height: 34,
              borderRadius: "50%",
              background: "linear-gradient(135deg, rgba(54,120,245,0.15) 0%, #FFFFFF 100%)",
              border: "1.5px solid rgba(54,120,245,0.4)",
              display: "flex",
              alignItems: "center",
              justifyContent: "center",
              boxShadow: "0 2px 8px rgba(54,120,245,0.15)",
              flexShrink: 0
            }}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#3678F5" strokeWidth="2.2" strokeLinecap="round" strokeLinejoin="round">
                <path d="M4.5 5.5h15v10.5H10l-3.5 3.5v-3.5H4.5z" />
              </svg>
            </div>
            <div>
              <div style={{ display: "flex", alignItems: "center", gap: 6 }}>
                <h1 style={{ margin: 0, fontSize: 18, fontWeight: 900, color: "#26354A", letterSpacing: -0.4 }}>Coach</h1>
                <span style={{ width: 6, height: 6, borderRadius: "50%", background: "#21865B", boxShadow: "0 0 8px rgba(33, 134, 91, 0.4)" }} />
              </div>
              <div style={{ fontSize: 10.5, color: "#64748B", fontWeight: 700, letterSpacing: 0.3 }}>
                {currentSession && currentSession.title ? (currentSession.title.length > 28 ? currentSession.title.substring(0, 28) + "..." : currentSession.title) : "Conversation"}
              </div>
            </div>
          </div>

          {/* Header Action Buttons */}
          <div style={{ display: "flex", alignItems: "center", gap: 6 }}>
            <button
              onClick={() => setShowHistoryDrawer(!showHistoryDrawer)}
              className="mat-ripple"
              style={{
                background: showHistoryDrawer ? "#EAF2FF" : "#FFFFFF",
                border: `1px solid ${showHistoryDrawer ? "#3678F5" : "#DCE5F2"}`,
                borderRadius: 10,
                padding: "6px 10px",
                color: showHistoryDrawer ? "#3678F5" : "#26354A",
                fontSize: 11,
                fontWeight: 800,
                cursor: "pointer",
                display: "flex",
                alignItems: "center",
                gap: 5
              }}
              title="Chat Sessions History"
            >
              <span>🕒</span>
              <span>Chats ({sessions.length})</span>
            </button>

            <button
              onClick={handleNewChat}
              className="mat-ripple"
              style={{
                background: "linear-gradient(135deg, #3678F5 0%, #2B62D9 100%)",
                border: "none",
                borderRadius: 10,
                padding: "6px 12px",
                color: "#FFFFFF",
                fontSize: 11,
                fontWeight: 800,
                cursor: "pointer",
                display: "flex",
                alignItems: "center",
                gap: 5,
                boxShadow: "0 2px 10px rgba(54,120,245,0.3)"
              }}
              title="Start a new chat"
            >
              <span>+</span>
              <span>New</span>
            </button>
          </div>
        </div>

        {/* ── TOP LIVE DASHBOARD (Dynamic Athlete Telemetry) ── */}
        <div style={{
          display: "grid",
          gridTemplateColumns: "1fr 1fr 1fr 1fr",
          gap: 6,
          marginTop: 8,
          background: "#EAF2FF",
          border: "1px solid #DCE5F2",
          borderRadius: 12,
          padding: "7px 10px"
        }}>
          <div>
            <div style={{ fontSize: 9.5, color: "#64748B", fontWeight: 800, textTransform: "uppercase" }}>Calories</div>
            <div style={{ fontSize: 13, fontWeight: 900, color: "#3678F5" }}>{remCal} <span style={{ fontSize: 9, color: "#64748B" }}>kcal</span></div>
          </div>
          <div>
            <div style={{ fontSize: 9.5, color: "#64748B", fontWeight: 800, textTransform: "uppercase" }}>Protein</div>
            <div style={{ fontSize: 13, fontWeight: 900, color: "#3678F5" }}>{remP} <span style={{ fontSize: 9, color: "#64748B" }}>g</span></div>
          </div>
          <div>
            <div style={{ fontSize: 9.5, color: "#64748B", fontWeight: 800, textTransform: "uppercase" }}>Carbs</div>
            <div style={{ fontSize: 13, fontWeight: 900, color: "#21865B" }}>{remC} <span style={{ fontSize: 9, color: "#64748B" }}>g</span></div>
          </div>
          <div>
            <div style={{ fontSize: 9.5, color: "#64748B", fontWeight: 800, textTransform: "uppercase" }}>Fat</div>
            <div style={{ fontSize: 13, fontWeight: 900, color: AMBER }}>{remF} <span style={{ fontSize: 9, color: "#64748B" }}>g</span></div>
          </div>
        </div>
      </div>

      {/* ── CHAT SESSIONS DRAWER MODAL ── */}
      {showHistoryDrawer && (
        <div style={{
          position: "absolute",
          top: 86,
          left: 0,
          right: 0,
          zIndex: 90,
          background: "#FFFFFF",
          border: "1px solid #DCE5F2",
          borderRadius: 16,
          padding: "14px",
          boxShadow: "0 10px 30px rgba(38, 53, 74, 0.12)",
          maxHeight: 280,
          overflowY: "auto"
        }}>
          <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 10 }}>
            <span style={{ fontSize: 11, fontWeight: 900, color: "#3678F5", letterSpacing: 1, textTransform: "uppercase" }}>
              Conversations History
            </span>
            <button
              onClick={handleClearCurrentChat}
              style={{ background: "none", border: "none", color: "#EF4444", fontSize: 11, fontWeight: 800, cursor: "pointer" }}
            >
              Clear Current
            </button>
          </div>

          <div style={{ display: "flex", flexDirection: "column", gap: 6 }}>
            {sessions.map(s => {
              const active = s.id === activeSessionId;
              return (
                <div
                  key={s.id}
                  onClick={() => handleSwitchSession(s.id)}
                  style={{
                    display: "flex",
                    alignItems: "center",
                    justifyContent: "space-between",
                    padding: "8px 12px",
                    borderRadius: 10,
                    background: active ? "#EAF2FF" : "#FFFFFF",
                    border: `1px solid ${active ? "#3678F5" : "#DCE5F2"}`,
                    cursor: "pointer"
                  }}
                >
                  <div style={{ display: "flex", alignItems: "center", gap: 8, minWidth: 0 }}>
                    <span style={{ fontSize: 13, color: active ? "#3678F5" : "#64748B" }}>💬</span>
                    <span style={{ fontSize: 12.5, fontWeight: active ? 800 : 600, color: active ? "#3678F5" : "#26354A", overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" }}>
                      {s.title}
                    </span>
                  </div>
                  {sessions.length > 1 && (
                    <button
                      onClick={(e) => handleDeleteSession(s.id, e)}
                      style={{ background: "none", border: "none", color: "#64748B", fontSize: 12, cursor: "pointer", padding: "2px 4px" }}
                      title="Delete chat"
                    >
                      ✕
                    </button>
                  )}
                </div>
              );
            })}
          </div>
        </div>
      )}

      {/* ── SCROLLABLE CONVERSATION AREA ── */}
      <div style={{
        flex: 1,
        overflowY: "auto",
        minHeight: 0,
        WebkitOverflowScrolling: "touch",
        padding: "6px 2px 14px",
        display: "flex",
        flexDirection: "column",
        gap: 12
      }}>
        {messages.map((m, idx) => {
          const isUser = m.role === "user";
          return (
            <div key={m.id || idx} style={{
              display: "flex",
              flexDirection: "column",
              alignItems: isUser ? "flex-end" : "flex-start",
              width: "100%"
            }}>
              {/* Message Header / Timestamp */}
              <div style={{ fontSize: 10, color: "#64748B", fontWeight: 700, marginBottom: 4, padding: "0 6px" }}>
                {isUser ? athleteName : "Coach"} · {m.timestamp}
              </div>

              {/* Message Bubble */}
              <div style={{
                maxWidth: isUser ? "85%" : "100%",
                background: isUser ? "linear-gradient(135deg, #3678F5 0%, #2B62D9 100%)" : "#FFFFFF",
                color: isUser ? "#FFFFFF" : "#26354A",
                border: isUser ? "none" : "1.5px solid #DCE5F2",
                borderRadius: isUser ? "18px 18px 4px 18px" : "18px 18px 18px 4px",
                padding: "14px 16px",
                boxShadow: isUser ? "0 4px 16px rgba(54, 120, 245, 0.25)" : "0 2px 10px rgba(38, 53, 74, 0.05)",
                width: isUser ? "auto" : "100%",
                boxSizing: "border-box"
              }}>
                {/* Content */}
                <div style={{ fontSize: 14, color: isUser ? "#FFFFFF" : "#26354A", lineHeight: 1.55 }}>
                  {isUser ? m.content : renderMarkdown(m.content || "")}
                  {!isUser && isGenerating && idx === messages.length - 1 && (
                    <span style={{ display: "inline-block", width: 7, height: 15, background: "#3678F5", marginLeft: 4, verticalAlign: "middle", animation: "pulseGlow3 0.8s infinite" }} />
                  )}
                </div>

                {/* ── ACTIONABLE MEAL CARD ── */}
                {m.mealCard && (
                  <div style={{
                    marginTop: 14,
                    background: "#FFFFFF",
                    border: "1.5px solid #DCE5F2",
                    borderRadius: 14,
                    padding: "14px",
                    boxShadow: "0 2px 10px rgba(38, 53, 74, 0.05)"
                  }}>
                    <div style={{ display: "flex", justifyContent: "space-between", alignItems: "flex-start", marginBottom: 8 }}>
                      <div>
                        <div style={{ fontSize: 15, fontWeight: 900, color: "#26354A" }}>{m.mealCard.name}</div>
                        <div style={{ fontSize: 11, color: "#64748B", marginTop: 2 }}>{m.mealCard.portion}</div>
                      </div>
                      <span style={{ fontSize: 16, fontWeight: 900, color: "#3678F5" }}>{m.mealCard.calories} kcal</span>
                    </div>

                    {/* Macro pills */}
                    <div style={{ display: "flex", gap: 6, margin: "8px 0 12px", flexWrap: "wrap" }}>
                      <span style={{ background: "rgba(54, 120, 245, 0.12)", color: "#3678F5", padding: "3px 9px", borderRadius: 6, fontSize: 11, fontWeight: 800 }}>P: {m.mealCard.protein}g</span>
                      <span style={{ background: "rgba(33, 134, 91, 0.12)", color: "#21865B", padding: "3px 9px", borderRadius: 6, fontSize: 11, fontWeight: 800 }}>C: {m.mealCard.carbs}g</span>
                      <span style={{ background: "rgba(255, 138, 61, 0.15)", color: AMBER, padding: "3px 9px", borderRadius: 6, fontSize: 11, fontWeight: 800 }}>F: {m.mealCard.fat}g</span>
                      {m.mealCard.fibre && (
                        <span style={{ background: "#EAF2FF", color: "#64748B", padding: "3px 9px", borderRadius: 6, fontSize: 11, fontWeight: 800 }}>Fibre: {m.mealCard.fibre}</span>
                      )}
                    </div>

                    {/* Action buttons */}
                    <div style={{ display: "flex", gap: 8 }}>
                      <button
                        onClick={() => handleAddMealToNutrition(m.mealCard)}
                        className="mat-ripple"
                        style={{
                          flex: 1,
                          background: "linear-gradient(135deg, #3678F5 0%, #2B62D9 100%)",
                          color: "#FFFFFF",
                          border: "none",
                          borderRadius: 10,
                          padding: "9px 0",
                          fontWeight: 800,
                          fontSize: 12,
                          cursor: "pointer",
                          boxShadow: "0 4px 12px rgba(54,120,245,0.3)"
                        }}
                      >
                        + Add to Nutrition
                      </button>
                      <button
                        onClick={() => handleSaveMealToLibrary(m.mealCard)}
                        style={{
                          background: "#EAF2FF",
                          color: "#26354A",
                          border: "1px solid #DCE5F2",
                          borderRadius: 10,
                          padding: "9px 14px",
                          fontWeight: 700,
                          fontSize: 12,
                          cursor: "pointer"
                        }}
                      >
                        Save Meal
                      </button>
                    </div>
                  </div>
                )}

                {/* ── ACTIONABLE WORKOUT CARD ── */}
                {m.workoutCard && (
                  <div style={{
                    marginTop: 14,
                    background: "#FFFFFF",
                    border: "1.5px solid #DCE5F2",
                    borderRadius: 14,
                    padding: "14px",
                    boxShadow: "0 2px 10px rgba(38, 53, 74, 0.05)"
                  }}>
                    <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 10 }}>
                      <div>
                        <div style={{ fontSize: 15, fontWeight: 900, color: "#26354A" }}>{m.workoutCard.title}</div>
                        <div style={{ fontSize: 11, color: "#64748B", marginTop: 2 }}>Estimated Duration: {m.workoutCard.duration}</div>
                      </div>
                      <span style={{ fontSize: 16 }}>🏋️</span>
                    </div>

                    {/* Exercises list */}
                    <div style={{ display: "flex", flexDirection: "column", gap: 6, marginBottom: 14 }}>
                      {m.workoutCard.exercises.map((ex, exIdx) => (
                        <div key={exIdx} style={{ display: "flex", justifyContent: "space-between", alignItems: "center", padding: "6px 8px", background: "#EAF2FF", border: "1px solid #DCE5F2", borderRadius: 8 }}>
                          <span style={{ fontSize: 12.5, fontWeight: 700, color: "#26354A" }}>{ex.name}</span>
                          <span style={{ fontSize: 11, color: "#3678F5", fontWeight: 800 }}>{ex.sets} sets × {ex.reps} ({ex.rest} rest)</span>
                        </div>
                      ))}
                    </div>

                    {/* Action buttons */}
                    <div style={{ display: "flex", gap: 8 }}>
                      <button
                        onClick={() => handleStartWorkout(m.workoutCard)}
                        className="mat-ripple"
                        style={{
                          flex: 1,
                          background: "linear-gradient(135deg, #3678F5 0%, #2B62D9 100%)",
                          color: "#FFFFFF",
                          border: "none",
                          borderRadius: 10,
                          padding: "9px 0",
                          fontWeight: 800,
                          fontSize: 12,
                          cursor: "pointer",
                          boxShadow: "0 4px 12px rgba(54,120,245,0.3)"
                        }}
                      >
                        Start Workout
                      </button>
                      <button
                        onClick={() => handleSaveWorkoutToLibrary(m.workoutCard)}
                        style={{
                          background: "#EAF2FF",
                          color: "#26354A",
                          border: "1px solid #DCE5F2",
                          borderRadius: 10,
                          padding: "9px 14px",
                          fontWeight: 700,
                          fontSize: 12,
                          cursor: "pointer"
                        }}
                      >
                        Save Routine
                      </button>
                    </div>
                  </div>
                )}

                {/* ── ASSISTANT MESSAGE TOOLBAR ── */}
                {!isUser && (
                  <div style={{ display: "flex", alignItems: "center", gap: 12, marginTop: 12, paddingTop: 8, borderTop: "1px solid #DCE5F2" }}>
                    <button
                      onClick={() => handleCopy(m.content)}
                      style={{ background: "none", border: "none", color: "#64748B", fontSize: 11, cursor: "pointer", display: "flex", alignItems: "center", gap: 5 }}
                      title="Copy response"
                    >
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.2" strokeLinecap="round" strokeLinejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                      <span>Copy</span>
                    </button>
                    <button
                      onClick={() => handleSpeak(m.content)}
                      style={{ background: "none", border: "none", color: "#64748B", fontSize: 11, cursor: "pointer", display: "flex", alignItems: "center", gap: 5 }}
                      title="Read aloud"
                    >
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.2" strokeLinecap="round" strokeLinejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/></svg>
                      <span>Read</span>
                    </button>
                    {idx === messages.length - 1 && !isGenerating && (
                      <button
                        onClick={handleRegenerate}
                        style={{ background: "none", border: "none", color: "#64748B", fontSize: 11, cursor: "pointer", display: "flex", alignItems: "center", gap: 5 }}
                        title="Regenerate response"
                      >
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.2" strokeLinecap="round" strokeLinejoin="round"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
                        <span>Regenerate</span>
                      </button>
                    )}
                  </div>
                )}
              </div>

              {/* ── CONVERSATIONAL SUGGESTIONS CHIPS ── */}
              {!isUser && m.suggestions && m.suggestions.length > 0 && idx === messages.length - 1 && !isGenerating && (
                <div style={{ display: "flex", flexWrap: "wrap", gap: 6, marginTop: 8, maxWidth: "95%" }}>
                  {m.suggestions.map((sug, sidx) => (
                    <button
                      key={sidx}
                      onClick={() => sendMessage(sug)}
                      style={{
                        background: "#FFFFFF",
                        border: "1px solid #DCE5F2",
                        borderRadius: 999,
                        padding: "6px 12px",
                        color: "#26354A",
                        fontSize: 11.5,
                        cursor: "pointer",
                        fontWeight: 600,
                        transition: "all 0.15s ease",
                        boxShadow: "0 1px 4px rgba(38, 53, 74, 0.04)"
                      }}
                      onMouseEnter={e => { e.currentTarget.style.borderColor = "#3678F5"; e.currentTarget.style.color = "#3678F5"; e.currentTarget.style.background = "#EAF2FF"; }}
                      onMouseLeave={e => { e.currentTarget.style.borderColor = "#DCE5F2"; e.currentTarget.style.color = "#26354A"; e.currentTarget.style.background = "#FFFFFF"; }}
                    >
                      {sug}
                    </button>
                  ))}
                </div>
              )}
            </div>
          );
        })}

        {/* Stop Generating Button while streaming */}
        {isGenerating && (
          <div style={{ display: "flex", justifyContent: "center", margin: "4px 0" }}>
            <button
              onClick={handleStopGenerating}
              style={{
                background: "rgba(239,68,68,0.15)",
                border: "1px solid rgba(239,68,68,0.4)",
                borderRadius: 999,
                padding: "6px 16px",
                color: "#EF4444",
                fontSize: 12,
                fontWeight: 800,
                cursor: "pointer",
                display: "flex",
                alignItems: "center",
                gap: 6
              }}
            >
              <span>⏹</span> Stop generating
            </button>
          </div>
        )}

        <div ref={messagesEndRef} />
      </div>

      {/* ── QUICK ACTION CHIPS (Above Composer) ── */}
      {messages.length <= 1 && (
        <div style={{ display: "flex", gap: 6, overflowX: "auto", padding: "6px 2px", marginBottom: 6, flexShrink: 0 }}>
          {[
            "Build my meals for today",
            "What should I eat with my remaining macros?",
            "Create today’s workout",
            "High-protein meal ideas",
            "Analyse my nutrition today",
            "How am I doing today?"
          ].map((prompt, pIdx) => (
            <button
              key={pIdx}
              onClick={() => sendMessage(prompt)}
              style={{
                flexShrink: 0,
                background: "#FFFFFF",
                border: "1px solid #DCE5F2",
                borderRadius: 999,
                padding: "6px 12px",
                color: "#26354A",
                fontSize: 11,
                fontWeight: 700,
                cursor: "pointer",
                whiteSpace: "nowrap",
                boxShadow: "0 1px 4px rgba(38, 53, 74, 0.04)"
              }}
              onMouseEnter={e => { e.currentTarget.style.borderColor = "#3678F5"; e.currentTarget.style.color = "#3678F5"; e.currentTarget.style.background = "#EAF2FF"; }}
              onMouseLeave={e => { e.currentTarget.style.borderColor = "#DCE5F2"; e.currentTarget.style.color = "#26354A"; e.currentTarget.style.background = "#FFFFFF"; }}
            >
              {prompt}
            </button>
          ))}
        </div>
      )}

      {/* ── TOAST SNACKBAR ── */}
      {toastMsg && (
        <div style={{
          position: "fixed",
          bottom: 84,
          left: "50%",
          transform: "translateX(-50%)",
          background: "#FFFFFF",
          border: "1.5px solid #3678F5",
          borderRadius: 999,
          padding: "8px 20px",
          color: "#26354A",
          fontSize: 12,
          fontWeight: 800,
          zIndex: 9999,
          boxShadow: "0 8px 24px rgba(38, 53, 74, 0.15)"
        }}>
          {toastMsg}
        </div>
      )}

      {/* ── CHATGPT-STYLE STICKY MESSAGE COMPOSER ── */}
      <div style={{
        display: "flex",
        alignItems: "flex-end",
        gap: 8,
        background: "#FFFFFF",
        border: "1.5px solid #DCE5F2",
        borderRadius: 20,
        padding: "8px 10px 8px 14px",
        boxShadow: "0 4px 16px rgba(38, 53, 74,0.08)",
        flexShrink: 0
      }}>
        {/* Voice mic button */}
        <button
          onClick={handleVoiceInput}
          style={{
            background: isListening ? "rgba(209, 67, 67,0.15)" : "#EAF2FF",
            border: `1px solid ${isListening ? "#EF4444" : "#DCE5F2"}`,
            borderRadius: "50%",
            width: 36,
            height: 36,
            color: isListening ? "#EF4444" : "#26354A",
            fontSize: 15,
            cursor: "pointer",
            display: "flex",
            alignItems: "center",
            justifyContent: "center",
            marginBottom: 2
          }}
          title="Dictate with voice"
        >
          🎙️
        </button>

        {/* Multi-line textarea */}
        <textarea
          ref={inputRef}
          rows={1}
          value={inputText}
          onChange={e => setInputText(e.target.value)}
          onKeyDown={e => {
            if (e.key === "Enter" && !e.shiftKey) {
              e.preventDefault();
              sendMessage();
            }
          }}
          placeholder="Ask Coach anything…"
          style={{
            flex: 1,
            background: "transparent",
            border: "none",
            color: "#26354A",
            fontSize: 14,
            fontWeight: 500,
            outline: "none",
            fontFamily: "inherit",
            resize: "none",
            maxHeight: 100,
            padding: "8px 0 6px",
            lineHeight: 1.4
          }}
        />

        {/* Clear input if present */}
        {inputText.trim() && (
          <button
            onClick={() => setInputText("")}
            style={{
              background: "none",
              border: "none",
              color: "#64748B",
              fontSize: 14,
              cursor: "pointer",
              padding: "0 4px",
              marginBottom: 8
            }}
          >
            ✕
          </button>
        )}

        {/* Send Button */}
        <button
          onClick={() => sendMessage()}
          disabled={!inputText.trim() || isGenerating}
          style={{
            background: inputText.trim() && !isGenerating ? "linear-gradient(135deg, #3678F5 0%, #2B62D9 100%)" : "#DCE5F2",
            color: inputText.trim() && !isGenerating ? "#FFFFFF" : "#64748B",
            border: "none",
            borderRadius: 14,
            width: 38,
            height: 38,
            fontWeight: 900,
            fontSize: 16,
            cursor: inputText.trim() && !isGenerating ? "pointer" : "default",
            display: "flex",
            alignItems: "center",
            justifyContent: "center",
            boxShadow: inputText.trim() && !isGenerating ? `0 2px 10px rgba(37, 107, 253, 0.4)` : "none",
            marginBottom: 1
          }}
          title="Send message"
        >
          ↑
        </button>
      </div>
    </div>
  );
}


/* ============================================================
   STOKE — LUXURY PROFILE & TELEMETRY HUB (v3.0)
   Fusing: Soft UI · Dark Neumorphism · Material Design · Swiss Design
   ============================================================ */

/**
 * STOKE FITNESS APP — BODY GOALS & TRANSFORMATION SCREEN (React Component)
 * Clean, modern light-theme UI:
 * - Goal Setup Wizard & Assessment (Weight management, Muscle building, Stamina, Transformation)
 * - Daily Target Nutrition & Indian Meals with 1-Click "+ Add to Nutrition"
 * - Home & Gym Workout Schedules with YouTube Tutorials
 * - Custom Workout Builder (Swap exercises, skip, log to diary)
 * - Measurement Tracker & Interactive Progress Charts
 * - Private Progress Photos with secure storage & instant deletion
 * - AI Transformation Coach with Injury/Equipment Adjustments & Minor Safety Guardrail
 */

(function (global) {
  "use strict";

  const { useState, useEffect, useMemo, useRef } = React;

  function BodyGoalsScreen({
    profile = {},
    setProfile,
    goals = {},
    totals = {},
    onNavigate,
    onBack,
    currentUser,
    meals = {},
    addItem
  }) {
    // ── ACTIVE SUB-TAB STATE ──
    // 'dashboard' | 'meals' | 'workouts' | 'builder' | 'measurements' | 'coach' | 'assessment'
    const [activeSubTab, setActiveSubTab] = useState("dashboard");
    const [toastMsg, setToastMsg] = useState("");
    const [isSaving, setIsSaving] = useState(false);
    const [selectedExerciseModal, setSelectedExerciseModal] = useState(null);
    const [swapModalState, setSwapModalState] = useState(null); // { dayIndex, exIndex, currentEx }
    const [showNewLogModal, setShowNewLogModal] = useState(false);
    const [selectedPhotoView, setSelectedPhotoView] = useState(null);

    const triggerToast = (msg) => {
      setToastMsg(msg);
      setTimeout(() => setToastMsg(""), 3200);
    };

    // ── BODY GOALS FORM STATE ──
    const [goalData, setGoalData] = useState(() => {
      if (typeof localStorage !== "undefined") {
        try {
          const saved = localStorage.getItem("stoke_body_goals");
          if (saved) return JSON.parse(saved);
        } catch (e) {}
      }
      return {
        goalType: profile.goalType || "transformation",
        fitnessLevel: "beginner",
        workoutLocation: "home",
        activityLevel: "moderate",
        dietPref: "any",
        age: Number(profile.age) || 21,
        gender: profile.gender || "male",
        startingWeight: Number(profile.weightKg) || 70,
        currentWeight: Number(profile.weightKg) || 70,
        targetWeight: 68,
        heightCm: Number(profile.heightCm) || 167,
        bodyFatPct: 18,
        targetWeeks: 12
      };
    });

    // ── TRANSFORMATION LOGS (Measurements & Photos) ──
    const [logs, setLogs] = useState([]);
    const [loadingLogs, setLoadingLogs] = useState(true);

    // Initial Load from Supabase / Local
    useEffect(() => {
      let isMounted = true;
      if (typeof global.dbGetBodyGoals === "function") {
        global.dbGetBodyGoals(currentUser?.id).then(res => {
          if (isMounted && res?.data) {
            setGoalData(prev => ({ ...prev, ...res.data }));
          }
        });
      }
      if (typeof global.dbGetTransformationLogs === "function") {
        global.dbGetTransformationLogs(currentUser?.id).then(res => {
          if (isMounted && Array.isArray(res?.data)) {
            setLogs(res.data);
            setLoadingLogs(false);
          }
        });
      }
      return () => { isMounted = false; };
    }, [currentUser?.id]);

    // ── CALCULATE DYNAMIC PLAN ──
    const plan = useMemo(() => {
      if (typeof global.calculateTransformationPlan === "function") {
        return global.calculateTransformationPlan({
          age: goalData.age,
          gender: goalData.gender,
          weightKg: goalData.currentWeight,
          targetWeightKg: goalData.targetWeight,
          heightCm: goalData.heightCm,
          activityLevel: goalData.activityLevel,
          goalType: goalData.goalType,
          experienceLevel: goalData.fitnessLevel,
          workoutLocation: goalData.workoutLocation
        });
      }
      return null;
    }, [goalData]);

    // Active Goal Metadata
    const goalDef = useMemo(() => {
      return (global.StokeBodyGoalsEngine?.GOAL_TYPES || {})[goalData.goalType] || {
        title: "Body Transformation",
        icon: "🔥",
        color: "#3678F5",
        bgLight: "rgba(54, 120, 245, 0.08)",
        borderLight: "rgba(54, 120, 245, 0.25)",
        tagline: "Body recomposition & lean tone"
      };
    }, [goalData.goalType]);

    // ── ACTIVE WORKOUT SCHEDULE ──
    const [customSchedule, setCustomSchedule] = useState(() => {
      const loc = goalData.workoutLocation || "home";
      const exp = goalData.fitnessLevel || "beginner";
      const sched = global.GOAL_WORKOUT_SCHEDULES?.[loc]?.[exp] || global.GOAL_WORKOUT_SCHEDULES?.home?.beginner;
      return sched ? JSON.parse(JSON.stringify(sched)) : null;
    });

    // Update schedule when location/experience changes
    useEffect(() => {
      const loc = goalData.workoutLocation || "home";
      const exp = goalData.fitnessLevel || "beginner";
      const sched = global.GOAL_WORKOUT_SCHEDULES?.[loc]?.[exp] || global.GOAL_WORKOUT_SCHEDULES?.home?.beginner;
      if (sched) {
        setCustomSchedule(JSON.parse(JSON.stringify(sched)));
      }
    }, [goalData.workoutLocation, goalData.fitnessLevel]);

    // ── SAVE GOAL CHANGES ──
    const handleSaveGoalData = async (newGoalData) => {
      const payload = { ...goalData, ...newGoalData };
      setGoalData(payload);
      setIsSaving(true);
      if (typeof global.dbSaveBodyGoals === "function") {
        await global.dbSaveBodyGoals(currentUser?.id, payload);
      }
      // Also sync target weight/height to profile
      if (setProfile) {
        setProfile(prev => ({
          ...prev,
          weightKg: payload.currentWeight,
          heightCm: payload.heightCm,
          goalType: payload.goalType
        }));
      }
      setIsSaving(false);
      triggerToast("Body Goals & Plan updated successfully!");
      setActiveSubTab("dashboard");
    };

    // ── ADD MEAL TO NUTRITION DIARY ──
    const handleAddMealToDiary = (meal, slotKey = "lunch") => {
      if (typeof addItem === "function") {
        addItem(slotKey, {
          name: meal.name,
          cals: meal.calories,
          p: meal.protein,
          c: meal.carbs,
          f: meal.fat,
          fiber: meal.fiber || 0,
          portion: meal.portion || "1 serving"
        });
        triggerToast(`Added "${meal.name}" to ${slotKey.toUpperCase()}!`);
      } else {
        triggerToast(`Logged "${meal.name}" (${meal.calories} kcal)`);
      }
    };

    // ── LOG NEW MEASUREMENT & PHOTO ──
    const handleSaveNewMeasurement = async (newRecord) => {
      if (typeof global.dbSaveTransformationLog === "function") {
        const res = await global.dbSaveTransformationLog(currentUser?.id, newRecord);
        if (res?.data) {
          setLogs(prev => [res.data, ...prev.filter(l => l.id !== res.data.id)]);
        }
      } else {
        const localRecord = { ...newRecord, id: "log_" + Date.now(), log_date: new Date().toISOString().split("T")[0] };
        setLogs(prev => [localRecord, ...prev]);
      }
      // Update current weight in goals if entered
      if (newRecord.weight_kg) {
        setGoalData(prev => ({ ...prev, currentWeight: Number(newRecord.weight_kg) }));
      }
      setShowNewLogModal(false);
      triggerToast("Transformation entry recorded!");
    };

    // ── DELETE PROGRESS LOG / PHOTO ──
    const handleDeleteLog = async (logId) => {
      if (!confirm("Are you sure you want to permanently delete this progress record and its photo?")) return;
      if (typeof global.dbDeleteTransformationLog === "function") {
        await global.dbDeleteTransformationLog(currentUser?.id, logId);
      }
      setLogs(prev => prev.filter(l => l.id !== logId));
      if (selectedPhotoView?.id === logId) setSelectedPhotoView(null);
      triggerToast("Progress record permanently deleted.");
    };

    // ── SWAP EXERCISE IN BUILDER ──
    const handleSwapExercise = (newExName) => {
      if (!swapModalState) return;
      const { dayIndex, exIndex } = swapModalState;
      setCustomSchedule(prev => {
        if (!prev || !prev.days || !prev.days[dayIndex]) return prev;
        const next = JSON.parse(JSON.stringify(prev));
        const currentTarget = next.days[dayIndex].exercises[exIndex].target;
        next.days[dayIndex].exercises[exIndex] = {
          name: newExName,
          sets: 3,
          reps: "10-12",
          rest: "60s",
          target: currentTarget
        };
        return next;
      });
      setSwapModalState(null);
      triggerToast(`Swapped for ${newExName}!`);
    };

    // ── SKIP / REMOVE EXERCISE ──
    const handleSkipExercise = (dayIndex, exIndex) => {
      setCustomSchedule(prev => {
        if (!prev || !prev.days || !prev.days[dayIndex]) return prev;
        const next = JSON.parse(JSON.stringify(prev));
        next.days[dayIndex].exercises.splice(exIndex, 1);
        return next;
      });
      triggerToast("Exercise removed from routine.");
    };

    // ── PROGRESS METRICS ──
    const startW = Number(goalData.startingWeight) || Number(profile.weightKg) || 70;
    const currW = Number(goalData.currentWeight) || Number(profile.weightKg) || 70;
    const targW = Number(goalData.targetWeight) || 68;
    const totalToChange = Math.abs(startW - targW);
    const changedSoFar = Math.abs(startW - currW);
    const progressPercent = totalToChange > 0 ? Math.min(100, Math.round((changedSoFar / totalToChange) * 100)) : 100;

    return (
      <div style={{
        display: "flex",
        flexDirection: "column",
        gap: 16,
        paddingBottom: 24,
        fontFamily: "'Space Grotesk', ui-sans-serif, system-ui, sans-serif",
        color: "#26354A"
      }}>

        {/* ── TOP HEADER & NAVIGATION ── */}
        <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center" }}>
          <div style={{ display: "flex", alignItems: "center", gap: 10 }}>
            {onBack && (
              <button
                type="button"
                onClick={onBack}
                aria-label="Back"
                style={{
                  width: 38,
                  height: 38,
                  borderRadius: "50%",
                  background: "#FFFFFF",
                  border: "1px solid #DCE5F2",
                  color: "#26354A",
                  display: "flex",
                  alignItems: "center",
                  justifyContent: "center",
                  cursor: "pointer",
                  flexShrink: 0
                }}
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round">
                  <polyline points="15 18 9 12 15 6" />
                </svg>
              </button>
            )}
            <div>
              <div style={{ display: "flex", alignItems: "center", gap: 6 }}>
                <span style={{ fontSize: 20 }}>{goalDef.icon}</span>
                <h1 style={{ margin: 0, fontSize: 18, fontWeight: 900, color: "#26354A", letterSpacing: -0.4 }}>
                  Body Goals
                </h1>
              </div>
              <p style={{ margin: 0, fontSize: 11, color: "#64748B", fontWeight: 700 }}>
                {goalDef.title} · {goalData.workoutLocation === "home" ? "Home Plan" : "Gym Plan"}
              </p>
            </div>
          </div>

          <button
            onClick={() => setActiveSubTab(activeSubTab === "assessment" ? "dashboard" : "assessment")}
            style={{
              background: activeSubTab === "assessment" ? "#3678F5" : "#EAF2FF",
              color: activeSubTab === "assessment" ? "#FFFFFF" : "#3678F5",
              border: "1px solid #DCE5F2",
              borderRadius: 10,
              padding: "7px 12px",
              fontSize: 11.5,
              fontWeight: 800,
              cursor: "pointer",
              display: "flex",
              alignItems: "center",
              gap: 5
            }}
          >
            <span>⚙️</span>
            <span>{activeSubTab === "assessment" ? "Close Setup" : "Edit Goal"}</span>
          </button>
        </div>

        {/* ── TEEN / MINOR SAFETY BANNER ── */}
        {plan?.isMinor && (
          <div style={{
            background: "rgba(54, 120, 245, 0.08)",
            border: "1.5px solid rgba(54, 120, 245, 0.3)",
            borderRadius: 14,
            padding: "12px 14px",
            display: "flex",
            alignItems: "flex-start",
            gap: 10
          }}>
            <span style={{ fontSize: 18 }}>🛡️</span>
            <div>
              <div style={{ fontSize: 12.5, fontWeight: 800, color: "#3678F5" }}>Teen Growth & Health Mode Active</div>
              <div style={{ fontSize: 11.5, color: "#26354A", marginTop: 2, lineHeight: 1.45 }}>
                {plan.safetyNotice}
              </div>
            </div>
          </div>
        )}

        {/* ── SUB-TAB SEGMENTED PILLS ── */}
        <div style={{
          display: "flex",
          gap: 6,
          overflowX: "auto",
          paddingBottom: 4,
          msOverflowStyle: "none",
          scrollbarWidth: "none"
        }}>
          {[
            { key: "dashboard", label: "Overview", icon: "📊" },
            { key: "meals", label: "Indian Meals", icon: "🥗" },
            { key: "workouts", label: "Workout Plan", icon: "🏋️" },
            { key: "builder", label: "Custom Builder", icon: "🛠️" },
            { key: "measurements", label: "Progress Logs", icon: "📐" },
            { key: "coach", label: "AI Coach", icon: "🤖" }
          ].map(tabItem => {
            const isActive = activeSubTab === tabItem.key;
            return (
              <button
                key={tabItem.key}
                onClick={() => setActiveSubTab(tabItem.key)}
                style={{
                  flexShrink: 0,
                  display: "flex",
                  alignItems: "center",
                  gap: 6,
                  padding: "8px 14px",
                  borderRadius: 999,
                  background: isActive ? "#3678F5" : "#FFFFFF",
                  border: `1px solid ${isActive ? "#3678F5" : "#DCE5F2"}`,
                  color: isActive ? "#FFFFFF" : "#26354A",
                  fontSize: 12,
                  fontWeight: 800,
                  cursor: "pointer",
                  boxShadow: isActive ? "0 2px 8px rgba(54, 120, 245, 0.25)" : "0 1px 4px rgba(38, 53, 74, 0.04)",
                  transition: "all 0.15s ease"
                }}
              >
                <span>{tabItem.icon}</span>
                <span>{tabItem.label}</span>
              </button>
            );
          })}
        </div>

        {/* ══════════════════════════════════════════════════════════════════════ */}
        {/* TAB 1: OVERVIEW / DASHBOARD                                           */}
        {/* ══════════════════════════════════════════════════════════════════════ */}
        {activeSubTab === "dashboard" && (
          <div style={{ display: "flex", flexDirection: "column", gap: 14 }}>
            {/* HERO GOAL CARD */}
            <div style={{
              background: "linear-gradient(135deg, #FFFFFF 0%, #F8FAFC 100%)",
              border: `1.5px solid ${goalDef.borderLight}`,
              borderRadius: 20,
              padding: "18px",
              boxShadow: "0 4px 20px rgba(38, 53, 74, 0.06)",
              position: "relative",
              overflow: "hidden"
            }}>
              <div style={{ display: "flex", justifyContent: "space-between", alignItems: "flex-start" }}>
                <div>
                  <span style={{
                    display: "inline-block",
                    padding: "3px 10px",
                    borderRadius: 999,
                    background: goalDef.bgLight,
                    color: goalDef.color,
                    fontSize: 11,
                    fontWeight: 900,
                    textTransform: "uppercase",
                    letterSpacing: 0.5,
                    marginBottom: 6
                  }}>
                    Active Strategy
                  </span>
                  <h2 style={{ margin: "2px 0 4px", fontSize: 18, fontWeight: 900, color: "#26354A", letterSpacing: -0.3 }}>
                    {goalDef.title}
                  </h2>
                  <p style={{ margin: 0, fontSize: 12, color: "#64748B", lineHeight: 1.4 }}>
                    {goalDef.tagline}
                  </p>
                </div>
                <div style={{
                  width: 44,
                  height: 44,
                  borderRadius: "50%",
                  background: goalDef.bgLight,
                  display: "flex",
                  alignItems: "center",
                  justifyContent: "center",
                  fontSize: 22,
                  flexShrink: 0
                }}>
                  {goalDef.icon}
                </div>
              </div>

              {/* WEIGHT TIMELINE PROGRESS */}
              <div style={{ marginTop: 16, paddingTop: 14, borderTop: "1px solid #DCE5F2" }}>
                <div style={{ display: "flex", justifyContent: "space-between", alignItems: "baseline", marginBottom: 6 }}>
                  <div style={{ fontSize: 12, fontWeight: 800, color: "#64748B" }}>
                    Starting: <strong style={{ color: "#26354A" }}>{startW} kg</strong>
                  </div>
                  <div style={{ fontSize: 13, fontWeight: 900, color: goalDef.color }}>
                    Target: {targW} kg ({plan?.estimatedWeeks || 12} wks)
                  </div>
                </div>
                <div style={{ width: "100%", height: 8, background: "#EAF2FF", borderRadius: 999, overflow: "hidden" }}>
                  <div style={{
                    width: `${Math.max(5, progressPercent)}%`,
                    height: "100%",
                    background: `linear-gradient(90deg, #3678F5 0%, ${goalDef.color} 100%)`,
                    borderRadius: 999,
                    transition: "width 0.4s ease"
                  }} />
                </div>
                <div style={{ display: "flex", justifyContent: "space-between", marginTop: 6, fontSize: 11, color: "#64748B", fontWeight: 700 }}>
                  <span>Current: {currW} kg</span>
                  <span>{progressPercent}% Complete</span>
                </div>
              </div>
            </div>

            {/* DAILY TARGET MACROS TELEMETRY */}
            {plan && (
              <div style={{
                background: "#FFFFFF",
                border: "1.5px solid #DCE5F2",
                borderRadius: 18,
                padding: "16px",
                boxShadow: "0 2px 10px rgba(38, 53, 74, 0.05)"
              }}>
                <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 12 }}>
                  <div>
                    <div style={{ fontSize: 14, fontWeight: 900, color: "#26354A" }}>Daily Calorie & Macro Target</div>
                    <div style={{ fontSize: 11, color: "#64748B" }}>Calibrated with Mifflin-St Jeor TDEE</div>
                  </div>
                  <span style={{ fontSize: 16, fontWeight: 900, color: "#3678F5" }}>
                    {plan.targetCalories} <span style={{ fontSize: 10, color: "#64748B" }}>kcal/day</span>
                  </span>
                </div>

                <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr 1fr 1fr", gap: 8 }}>
                  <div style={{ background: "#EAF2FF", padding: "10px 8px", borderRadius: 12, textAlign: "center" }}>
                    <div style={{ fontSize: 9.5, color: "#64748B", fontWeight: 800, textTransform: "uppercase" }}>Protein</div>
                    <div style={{ fontSize: 15, fontWeight: 900, color: "#3678F5", marginTop: 2 }}>{plan.macros.protein}g</div>
                    <div style={{ fontSize: 9, color: "#64748B" }}>Muscle Repair</div>
                  </div>
                  <div style={{ background: "#EAF2FF", padding: "10px 8px", borderRadius: 12, textAlign: "center" }}>
                    <div style={{ fontSize: 9.5, color: "#64748B", fontWeight: 800, textTransform: "uppercase" }}>Carbs</div>
                    <div style={{ fontSize: 15, fontWeight: 900, color: "#21865B", marginTop: 2 }}>{plan.macros.carbs}g</div>
                    <div style={{ fontSize: 9, color: "#64748B" }}>Clean Energy</div>
                  </div>
                  <div style={{ background: "#EAF2FF", padding: "10px 8px", borderRadius: 12, textAlign: "center" }}>
                    <div style={{ fontSize: 9.5, color: "#64748B", fontWeight: 800, textTransform: "uppercase" }}>Fat</div>
                    <div style={{ fontSize: 15, fontWeight: 900, color: "#F59E0B", marginTop: 2 }}>{plan.macros.fat}g</div>
                    <div style={{ fontSize: 9, color: "#64748B" }}>Hormones</div>
                  </div>
                  <div style={{ background: "#EAF2FF", padding: "10px 8px", borderRadius: 12, textAlign: "center" }}>
                    <div style={{ fontSize: 9.5, color: "#64748B", fontWeight: 800, textTransform: "uppercase" }}>Water</div>
                    <div style={{ fontSize: 15, fontWeight: 900, color: "#06B6D4", marginTop: 2 }}>{plan.macros.water}L</div>
                    <div style={{ fontSize: 9, color: "#64748B" }}>Hydration</div>
                  </div>
                </div>
              </div>
            )}

            {/* QUICK ACTIONS ROW */}
            <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 10 }}>
              <button
                onClick={() => setActiveSubTab("meals")}
                style={{
                  background: "#FFFFFF",
                  border: "1.5px solid #DCE5F2",
                  borderRadius: 14,
                  padding: "14px",
                  textAlign: "left",
                  cursor: "pointer",
                  display: "flex",
                  flexDirection: "column",
                  gap: 4
                }}
              >
                <span style={{ fontSize: 20 }}>🍛</span>
                <span style={{ fontSize: 13, fontWeight: 900, color: "#26354A" }}>Today's Indian Meals</span>
                <span style={{ fontSize: 11, color: "#64748B" }}>Dosa, dal, paneer, eggs & rice plans</span>
              </button>

              <button
                onClick={() => setActiveSubTab("workouts")}
                style={{
                  background: "#FFFFFF",
                  border: "1.5px solid #DCE5F2",
                  borderRadius: 14,
                  padding: "14px",
                  textAlign: "left",
                  cursor: "pointer",
                  display: "flex",
                  flexDirection: "column",
                  gap: 4
                }}
              >
                <span style={{ fontSize: 20 }}>🏋️</span>
                <span style={{ fontSize: 13, fontWeight: 900, color: "#26354A" }}>Workout Schedule</span>
                <span style={{ fontSize: 11, color: "#64748B" }}>{goalData.workoutLocation === "home" ? "Home Routines" : "Gym Routines"} with video cues</span>
              </button>
            </div>

            {/* RECENT TRANSFORMATION LOG PREVIEW */}
            <div style={{
              background: "#FFFFFF",
              border: "1.5px solid #DCE5F2",
              borderRadius: 18,
              padding: "16px",
              boxShadow: "0 2px 10px rgba(38, 53, 74, 0.05)"
            }}>
              <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 12 }}>
                <div>
                  <div style={{ fontSize: 14, fontWeight: 900, color: "#26354A" }}>Recent Measurement Progress</div>
                  <div style={{ fontSize: 11, color: "#64748B" }}>{logs.length} logged checkpoints</div>
                </div>
                <button
                  onClick={() => setShowNewLogModal(true)}
                  style={{
                    background: "linear-gradient(135deg, #3678F5 0%, #2B62D9 100%)",
                    border: "none",
                    borderRadius: 8,
                    color: "#FFFFFF",
                    padding: "6px 12px",
                    fontSize: 11.5,
                    fontWeight: 800,
                    cursor: "pointer"
                  }}
                >
                  + Log Today
                </button>
              </div>

              {logs.length > 0 ? (
                <div style={{ display: "flex", flexDirection: "column", gap: 8 }}>
                  {logs.slice(0, 3).map((l, lIdx) => (
                    <div key={l.id || lIdx} style={{
                      display: "flex",
                      alignItems: "center",
                      justifyContent: "space-between",
                      padding: "8px 10px",
                      background: "#F8FAFC",
                      border: "1px solid #DCE5F2",
                      borderRadius: 10
                    }}>
                      <div style={{ display: "flex", alignItems: "center", gap: 10 }}>
                        <span style={{ fontSize: 13 }}>📅</span>
                        <div>
                          <div style={{ fontSize: 12.5, fontWeight: 800, color: "#26354A" }}>{l.log_date}</div>
                          <div style={{ fontSize: 11, color: "#64748B" }}>
                            {l.waist_cm ? `Waist: ${l.waist_cm}cm` : ""} {l.chest_cm ? `· Chest: ${l.chest_cm}cm` : ""}
                          </div>
                        </div>
                      </div>
                      <div style={{ textAlign: "right" }}>
                        <span style={{ fontSize: 14, fontWeight: 900, color: "#3678F5" }}>
                          {l.weight_kg ? `${l.weight_kg} kg` : "—"}
                        </span>
                        {l.photo_url && (
                          <div style={{ fontSize: 10, color: "#21865B", fontWeight: 800 }}>📷 Private Photo</div>
                        )}
                      </div>
                    </div>
                  ))}
                </div>
              ) : (
                <div style={{ textAlign: "center", padding: "16px 0", color: "#64748B", fontSize: 12 }}>
                  No measurements logged yet. Tap <strong>+ Log Today</strong> to record your first milestone!
                </div>
              )}
            </div>
          </div>
        )}

        {/* ══════════════════════════════════════════════════════════════════════ */}
        {/* TAB 2: BALANCED INDIAN MEALS                                          */}
        {/* ══════════════════════════════════════════════════════════════════════ */}
        {activeSubTab === "meals" && (
          <div style={{ display: "flex", flexDirection: "column", gap: 14 }}>
            {/* Header info */}
            <div style={{
              background: "#EAF2FF",
              border: "1px solid #DCE5F2",
              borderRadius: 14,
              padding: "12px 14px",
              display: "flex",
              justifyContent: "space-between",
              alignItems: "center"
            }}>
              <div>
                <div style={{ fontSize: 13, fontWeight: 900, color: "#26354A" }}>Verified Indian Nutrition Plan</div>
                <div style={{ fontSize: 11, color: "#64748B" }}>Balanced with dosa, dal, roti, rice, eggs & paneer</div>
              </div>
              <button
                onClick={() => {
                  if (onNavigate) onNavigate("nutrition");
                  else triggerToast("Open Nutrition tab to scan meals");
                }}
                style={{
                  background: "#3678F5",
                  color: "#FFFFFF",
                  border: "none",
                  borderRadius: 8,
                  padding: "6px 12px",
                  fontSize: 11,
                  fontWeight: 800,
                  cursor: "pointer"
                }}
              >
                📷 AI Meal Scanner
              </button>
            </div>

            {/* MEAL SECTIONS: Breakfast, Lunch, Snack, Dinner */}
            {["breakfast", "lunch", "snack", "dinner"].map(slot => {
              const mealList = (global.INDIAN_MEAL_SUGGESTIONS || {})[slot] || [];
              const slotTitle = slot.charAt(0).toUpperCase() + slot.slice(1);
              return (
                <div key={slot} style={{ display: "flex", flexDirection: "column", gap: 10 }}>
                  <div style={{ display: "flex", alignItems: "center", gap: 6, margin: "4px 0 2px" }}>
                    <span style={{ fontSize: 16 }}>
                      {slot === "breakfast" ? "🥞" : slot === "lunch" ? "🍛" : slot === "snack" ? "🥜" : "🍲"}
                    </span>
                    <h3 style={{ margin: 0, fontSize: 15, fontWeight: 900, color: "#26354A" }}>
                      {slotTitle} Suggestions
                    </h3>
                  </div>

                  <div style={{ display: "flex", flexDirection: "column", gap: 10 }}>
                    {mealList.map(meal => (
                      <div key={meal.id} style={{
                        background: "#FFFFFF",
                        border: "1.5px solid #DCE5F2",
                        borderRadius: 16,
                        padding: "14px",
                        boxShadow: "0 2px 8px rgba(38, 53, 74, 0.04)"
                      }}>
                        <div style={{ display: "flex", justifyContent: "space-between", alignItems: "flex-start" }}>
                          <div>
                            <div style={{ fontSize: 14.5, fontWeight: 900, color: "#26354A" }}>{meal.name}</div>
                            <div style={{ fontSize: 11, color: "#64748B", marginTop: 2 }}>{meal.portion}</div>
                          </div>
                          <span style={{ fontSize: 15, fontWeight: 900, color: "#3678F5" }}>
                            {meal.calories} kcal
                          </span>
                        </div>

                        {/* Macro badges */}
                        <div style={{ display: "flex", gap: 6, margin: "8px 0 10px", flexWrap: "wrap" }}>
                          <span style={{ background: "rgba(54, 120, 245, 0.12)", color: "#3678F5", padding: "2px 8px", borderRadius: 6, fontSize: 11, fontWeight: 800 }}>P: {meal.protein}g</span>
                          <span style={{ background: "rgba(33, 134, 91, 0.12)", color: "#21865B", padding: "2px 8px", borderRadius: 6, fontSize: 11, fontWeight: 800 }}>C: {meal.carbs}g</span>
                          <span style={{ background: "rgba(245, 158, 11, 0.12)", color: "#F59E0B", padding: "2px 8px", borderRadius: 6, fontSize: 11, fontWeight: 800 }}>F: {meal.fat}g</span>
                          <span style={{ background: "#EAF2FF", color: "#64748B", padding: "2px 8px", borderRadius: 6, fontSize: 11, fontWeight: 800 }}>Fibre: {meal.fiber}g</span>
                        </div>

                        {/* Ingredients list */}
                        <div style={{ fontSize: 11.5, color: "#475569", lineHeight: 1.45, marginBottom: 10 }}>
                          <strong style={{ color: "#26354A" }}>Ingredients: </strong>
                          {meal.ingredients.join(" · ")}
                        </div>

                        {/* Swaps & Action button */}
                        <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", paddingTop: 8, borderTop: "1px solid #DCE5F2" }}>
                          <div style={{ fontSize: 10.5, color: "#64748B", maxWidth: "60%" }}>
                            💡 {meal.swaps}
                          </div>
                          <button
                            onClick={() => handleAddMealToDiary(meal, slot)}
                            style={{
                              background: "linear-gradient(135deg, #3678F5 0%, #2B62D9 100%)",
                              color: "#FFFFFF",
                              border: "none",
                              borderRadius: 8,
                              padding: "6px 12px",
                              fontSize: 11.5,
                              fontWeight: 800,
                              cursor: "pointer",
                              boxShadow: "0 2px 8px rgba(54, 120, 245, 0.25)"
                            }}
                          >
                            + Add to Nutrition
                          </button>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              );
            })}
          </div>
        )}

        {/* ══════════════════════════════════════════════════════════════════════ */}
        {/* TAB 3: WORKOUT SCHEDULE WITH YOUTUBE LINKS                            */}
        {/* ══════════════════════════════════════════════════════════════════════ */}
        {activeSubTab === "workouts" && (
          <div style={{ display: "flex", flexDirection: "column", gap: 14 }}>
            <div style={{
              background: "#EAF2FF",
              border: "1px solid #DCE5F2",
              borderRadius: 14,
              padding: "12px 14px",
              display: "flex",
              justifyContent: "space-between",
              alignItems: "center"
            }}>
              <div>
                <div style={{ fontSize: 13, fontWeight: 900, color: "#26354A" }}>
                  {customSchedule?.title || "Workout Schedule"}
                </div>
                <div style={{ fontSize: 11, color: "#64748B" }}>
                  {goalData.workoutLocation === "home" ? "🏠 Home Protocol" : "🏋️ Gym Protocol"} · {customSchedule?.daysPerWeek || 3} days/week
                </div>
              </div>
              <button
                onClick={() => setActiveSubTab("builder")}
                style={{
                  background: "#FFFFFF",
                  border: "1px solid #3678F5",
                  color: "#3678F5",
                  borderRadius: 8,
                  padding: "6px 12px",
                  fontSize: 11,
                  fontWeight: 800,
                  cursor: "pointer"
                }}
              >
                🛠️ Customize Days
              </button>
            </div>

            {/* WORKOUT DAYS ACCORDION / LIST */}
            {customSchedule?.days?.map((day, dIdx) => (
              <div key={dIdx} style={{
                background: "#FFFFFF",
                border: "1.5px solid #DCE5F2",
                borderRadius: 16,
                padding: "14px",
                boxShadow: "0 2px 8px rgba(38, 53, 74, 0.04)"
              }}>
                <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 10 }}>
                  <div>
                    <h3 style={{ margin: 0, fontSize: 14.5, fontWeight: 900, color: "#26354A" }}>{day.dayName}</h3>
                    <div style={{ fontSize: 11, color: "#64748B", marginTop: 2 }}>{day.focus} · ⏱️ {day.duration}</div>
                  </div>
                  <span style={{ fontSize: 11, fontWeight: 800, color: "#3678F5", background: "#EAF2FF", padding: "3px 8px", borderRadius: 6 }}>
                    {day.exercises.length} Exercises
                  </span>
                </div>

                {/* Exercises list */}
                <div style={{ display: "flex", flexDirection: "column", gap: 8 }}>
                  {day.exercises.map((ex, exIdx) => {
                    const enriched = global.enrichExerciseWithTutorial ? global.enrichExerciseWithTutorial(ex) : ex;
                    return (
                      <div key={exIdx} style={{
                        display: "flex",
                        alignItems: "center",
                        justifyContent: "space-between",
                        padding: "8px 10px",
                        background: "#F8FAFC",
                        border: "1px solid #DCE5F2",
                        borderRadius: 10
                      }}>
                        <div>
                          <div style={{ fontSize: 13, fontWeight: 800, color: "#26354A" }}>{enriched.name}</div>
                          <div style={{ fontSize: 11, color: "#64748B" }}>
                            {enriched.sets} sets × {enriched.reps} (Rest: {enriched.rest}) · <span style={{ color: "#3678F5", fontWeight: 700 }}>{enriched.target}</span>
                          </div>
                        </div>

                        <div style={{ display: "flex", alignItems: "center", gap: 6 }}>
                          {enriched.youtubeUrl ? (
                            <a
                              href={enriched.youtubeUrl}
                              target="_blank"
                              rel="noopener noreferrer"
                              style={{
                                display: "flex",
                                alignItems: "center",
                                gap: 4,
                                background: "#FF0000",
                                color: "#FFFFFF",
                                textDecoration: "none",
                                fontSize: 10.5,
                                fontWeight: 800,
                                padding: "4px 8px",
                                borderRadius: 6
                              }}
                              title="Watch YouTube Tutorial"
                            >
                              <span>▶</span> YouTube
                            </a>
                          ) : (
                            <button
                              onClick={() => setSelectedExerciseModal(enriched)}
                              style={{
                                background: "#EAF2FF",
                                border: "1px solid #DCE5F2",
                                color: "#3678F5",
                                fontSize: 10.5,
                                fontWeight: 800,
                                padding: "4px 8px",
                                borderRadius: 6,
                                cursor: "pointer"
                              }}
                            >
                              Instructions
                            </button>
                          )}
                        </div>
                      </div>
                    );
                  })}
                </div>

                <div style={{ display: "flex", gap: 8, marginTop: 12 }}>
                  <button
                    onClick={() => {
                      if (onNavigate) onNavigate("workout");
                      else triggerToast(`Starting "${day.dayName}"!`);
                    }}
                    style={{
                      flex: 1,
                      background: "linear-gradient(135deg, #3678F5 0%, #2B62D9 100%)",
                      color: "#FFFFFF",
                      border: "none",
                      borderRadius: 10,
                      padding: "8px 0",
                      fontSize: 12,
                      fontWeight: 800,
                      cursor: "pointer",
                      boxShadow: "0 2px 8px rgba(54, 120, 245, 0.25)"
                    }}
                  >
                    Start Workout
                  </button>
                </div>
              </div>
            ))}
          </div>
        )}

        {/* ══════════════════════════════════════════════════════════════════════ */}
        {/* TAB 4: CUSTOM WORKOUT BUILDER (Swap & Skip)                          */}
        {/* ══════════════════════════════════════════════════════════════════════ */}
        {activeSubTab === "builder" && (
          <div style={{ display: "flex", flexDirection: "column", gap: 14 }}>
            <div style={{
              background: "#EAF2FF",
              border: "1px solid #DCE5F2",
              borderRadius: 14,
              padding: "12px 14px"
            }}>
              <div style={{ fontSize: 13, fontWeight: 900, color: "#26354A" }}>Interactive Workout Builder</div>
              <div style={{ fontSize: 11, color: "#64748B", marginTop: 2 }}>
                Customize exercises for home or gym equipment. Tap <strong>Swap</strong> to substitute exercises or <strong>Skip</strong> to remove.
              </div>
            </div>

            {customSchedule?.days?.map((day, dIdx) => (
              <div key={dIdx} style={{
                background: "#FFFFFF",
                border: "1.5px solid #DCE5F2",
                borderRadius: 16,
                padding: "14px"
              }}>
                <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 10 }}>
                  <h3 style={{ margin: 0, fontSize: 14.5, fontWeight: 900, color: "#26354A" }}>{day.dayName}</h3>
                  <span style={{ fontSize: 11, color: "#64748B" }}>{day.exercises.length} exercises</span>
                </div>

                <div style={{ display: "flex", flexDirection: "column", gap: 8 }}>
                  {day.exercises.map((ex, exIdx) => (
                    <div key={exIdx} style={{
                      display: "flex",
                      alignItems: "center",
                      justifyContent: "space-between",
                      padding: "8px 10px",
                      background: "#F8FAFC",
                      border: "1px solid #DCE5F2",
                      borderRadius: 10
                    }}>
                      <div>
                        <div style={{ fontSize: 13, fontWeight: 800, color: "#26354A" }}>{ex.name}</div>
                        <div style={{ fontSize: 11, color: "#64748B" }}>
                          {ex.sets} sets × {ex.reps} · <span style={{ color: "#3678F5" }}>{ex.target}</span>
                        </div>
                      </div>

                      <div style={{ display: "flex", gap: 6 }}>
                        <button
                          onClick={() => setSwapModalState({ dayIndex: dIdx, exIndex: exIdx, currentEx: ex })}
                          style={{
                            background: "#EAF2FF",
                            border: "1px solid #DCE5F2",
                            color: "#3678F5",
                            borderRadius: 6,
                            padding: "4px 8px",
                            fontSize: 10.5,
                            fontWeight: 800,
                            cursor: "pointer"
                          }}
                        >
                          🔄 Swap
                        </button>
                        <button
                          onClick={() => handleSkipExercise(dIdx, exIdx)}
                          style={{
                            background: "none",
                            border: "1px solid #DCE5F2",
                            color: "#EF4444",
                            borderRadius: 6,
                            padding: "4px 8px",
                            fontSize: 10.5,
                            fontWeight: 700,
                            cursor: "pointer"
                          }}
                        >
                          ✕ Skip
                        </button>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            ))}
          </div>
        )}

        {/* ══════════════════════════════════════════════════════════════════════ */}
        {/* TAB 5: MEASUREMENTS, CHARTS & PRIVATE PHOTOS                         */}
        {/* ══════════════════════════════════════════════════════════════════════ */}
        {activeSubTab === "measurements" && (
          <div style={{ display: "flex", flexDirection: "column", gap: 14 }}>
            {/* Header with + Log button */}
            <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center" }}>
              <div>
                <h2 style={{ margin: 0, fontSize: 16, fontWeight: 900, color: "#26354A" }}>Measurements & Milestones</h2>
                <div style={{ fontSize: 11, color: "#64748B" }}>Tracking healthy habits, non-scale victories & strength</div>
              </div>
              <button
                onClick={() => setShowNewLogModal(true)}
                style={{
                  background: "linear-gradient(135deg, #3678F5 0%, #2B62D9 100%)",
                  color: "#FFFFFF",
                  border: "none",
                  borderRadius: 10,
                  padding: "8px 14px",
                  fontSize: 12,
                  fontWeight: 800,
                  cursor: "pointer",
                  boxShadow: "0 2px 8px rgba(54, 120, 245, 0.25)"
                }}
              >
                + Add Entry
              </button>
            </div>

            {/* WEIGHT PROGRESS CHART (Visual SVG Line) */}
            <div style={{
              background: "#FFFFFF",
              border: "1.5px solid #DCE5F2",
              borderRadius: 18,
              padding: "16px",
              boxShadow: "0 2px 10px rgba(38, 53, 74, 0.05)"
            }}>
              <div style={{ display: "flex", justifyContent: "space-between", alignItems: "baseline", marginBottom: 12 }}>
                <div>
                  <div style={{ fontSize: 13.5, fontWeight: 900, color: "#26354A" }}>Weight Trend Curve</div>
                  <div style={{ fontSize: 11, color: "#64748B" }}>Target: {targW} kg</div>
                </div>
                <div style={{ fontSize: 15, fontWeight: 900, color: "#3678F5" }}>
                  {currW} kg <span style={{ fontSize: 10, color: "#64748B" }}>current</span>
                </div>
              </div>

              {/* SVG Trendline */}
              <div style={{ width: "100%", height: 110, position: "relative" }}>
                <svg width="100%" height="100%" viewBox="0 0 300 90" preserveAspectRatio="none">
                  <defs>
                    <linearGradient id="chartGrad" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0%" stopColor="#3678F5" stopOpacity="0.25" />
                      <stop offset="100%" stopColor="#3678F5" stopOpacity="0.0" />
                    </linearGradient>
                  </defs>
                  {/* Grid guidelines */}
                  <line x1="0" y1="20" x2="300" y2="20" stroke="#EAF2FF" strokeWidth="1" strokeDasharray="3 3" />
                  <line x1="0" y1="50" x2="300" y2="50" stroke="#EAF2FF" strokeWidth="1" strokeDasharray="3 3" />
                  <line x1="0" y1="80" x2="300" y2="80" stroke="#EAF2FF" strokeWidth="1" strokeDasharray="3 3" />
                  {/* Area fill */}
                  <path d="M 0 65 L 50 60 L 100 52 L 150 48 L 200 42 L 250 38 L 300 32 L 300 90 L 0 90 Z" fill="url(#chartGrad)" />
                  {/* Trend line */}
                  <polyline
                    fill="none"
                    stroke="#3678F5"
                    strokeWidth="2.5"
                    strokeLinecap="round"
                    strokeLinejoin="round"
                    points="0,65 50,60 100,52 150,48 200,42 250,38 300,32"
                  />
                  {/* Data points */}
                  <circle cx="0" cy="65" r="3.5" fill="#3678F5" />
                  <circle cx="100" cy="52" r="3.5" fill="#3678F5" />
                  <circle cx="200" cy="42" r="3.5" fill="#3678F5" />
                  <circle cx="300" cy="32" r="4.5" fill="#21865B" stroke="#FFFFFF" strokeWidth="1.5" />
                </svg>
              </div>
              <div style={{ display: "flex", justifyContent: "space-between", fontSize: 10, color: "#64748B", fontWeight: 700, marginTop: 4 }}>
                <span>Start ({startW} kg)</span>
                <span>Week 4</span>
                <span>Week 8</span>
                <span>Today ({currW} kg)</span>
              </div>
            </div>

            {/* HEALTHY HABITS CELEBRATION BADGES */}
            <div style={{
              background: "#FFFFFF",
              border: "1.5px solid #DCE5F2",
              borderRadius: 18,
              padding: "14px",
              boxShadow: "0 2px 10px rgba(38, 53, 74, 0.05)"
            }}>
              <div style={{ fontSize: 13.5, fontWeight: 900, color: "#26354A", marginBottom: 8 }}>
                🏆 Healthy Habit Streaks & Non-Scale Victories
              </div>
              <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 8 }}>
                <div style={{ background: "#F8FAFC", border: "1px solid #DCE5F2", borderRadius: 10, padding: "8px 10px", display: "flex", alignItems: "center", gap: 8 }}>
                  <span style={{ fontSize: 20 }}>💧</span>
                  <div>
                    <div style={{ fontSize: 11.5, fontWeight: 800, color: "#26354A" }}>Hydration Hero</div>
                    <div style={{ fontSize: 10, color: "#21865B" }}>7-Day Water Goal Hit</div>
                  </div>
                </div>
                <div style={{ background: "#F8FAFC", border: "1px solid #DCE5F2", borderRadius: 10, padding: "8px 10px", display: "flex", alignItems: "center", gap: 8 }}>
                  <span style={{ fontSize: 20 }}>🥗</span>
                  <div>
                    <div style={{ fontSize: 11.5, fontWeight: 800, color: "#26354A" }}>Protein Champion</div>
                    <div style={{ fontSize: 10, color: "#3678F5" }}>Consistent Whole Foods</div>
                  </div>
                </div>
                <div style={{ background: "#F8FAFC", border: "1px solid #DCE5F2", borderRadius: 10, padding: "8px 10px", display: "flex", alignItems: "center", gap: 8 }}>
                  <span style={{ fontSize: 20 }}>⚡</span>
                  <div>
                    <div style={{ fontSize: 11.5, fontWeight: 800, color: "#26354A" }}>Consistency King</div>
                    <div style={{ fontSize: 10, color: "#F59E0B" }}>12 Workouts Completed</div>
                  </div>
                </div>
                <div style={{ background: "#F8FAFC", border: "1px solid #DCE5F2", borderRadius: 10, padding: "8px 10px", display: "flex", alignItems: "center", gap: 8 }}>
                  <span style={{ fontSize: 20 }}>🔋</span>
                  <div>
                    <div style={{ fontSize: 11.5, fontWeight: 800, color: "#26354A" }}>Recovery Master</div>
                    <div style={{ fontSize: 10, color: "#8B5CF6" }}>7.5h Sleep Maintained</div>
                  </div>
                </div>
              </div>
            </div>

            {/* DETAILED LOG HISTORY WITH PHOTOS & PERMANENT DELETE */}
            <div style={{ display: "flex", flexDirection: "column", gap: 10 }}>
              <div style={{ fontSize: 14, fontWeight: 900, color: "#26354A" }}>All Checkpoint Logs ({logs.length})</div>
              {logs.map(log => (
                <div key={log.id} style={{
                  background: "#FFFFFF",
                  border: "1.5px solid #DCE5F2",
                  borderRadius: 14,
                  padding: "14px",
                  display: "flex",
                  flexDirection: "column",
                  gap: 8
                }}>
                  <div style={{ display: "flex", justifyContent: "space-between", alignItems: "flex-start" }}>
                    <div>
                      <div style={{ fontSize: 13.5, fontWeight: 900, color: "#26354A" }}>{log.log_date}</div>
                      <div style={{ fontSize: 11.5, color: "#64748B", marginTop: 2 }}>
                        {log.weight_kg && <strong>{log.weight_kg} kg · </strong>}
                        {log.waist_cm && <span>Waist: {log.waist_cm}cm · </span>}
                        {log.chest_cm && <span>Chest: {log.chest_cm}cm</span>}
                      </div>
                    </div>

                    <button
                      onClick={() => handleDeleteLog(log.id)}
                      style={{
                        background: "none",
                        border: "none",
                        color: "#94A3B8",
                        fontSize: 12,
                        cursor: "pointer",
                        padding: "2px 6px"
                      }}
                      title="Permanently Delete Entry"
                    >
                      🗑️
                    </button>
                  </div>

                  {log.notes && (
                    <div style={{ fontSize: 12, color: "#475569", background: "#F8FAFC", padding: "6px 8px", borderRadius: 8, lineHeight: 1.4 }}>
                      "{log.notes}"
                    </div>
                  )}

                  {/* Private progress photo thumbnail */}
                  {log.photo_url && (
                    <div style={{ display: "flex", alignItems: "center", gap: 8, marginTop: 4 }}>
                      <img
                        src={log.photo_url}
                        alt="Progress checkpoint"
                        style={{ width: 48, height: 48, borderRadius: 8, objectFit: "cover", border: "1px solid #DCE5F2", cursor: "pointer" }}
                        onClick={() => setSelectedPhotoView(log)}
                      />
                      <div style={{ fontSize: 11, color: "#64748B" }}>
                        <span style={{ color: "#21865B", fontWeight: 700 }}>🔒 Private photo stored.</span> Tap image to view or delete.
                      </div>
                    </div>
                  )}
                </div>
              ))}
            </div>
          </div>
        )}

        {/* ══════════════════════════════════════════════════════════════════════ */}
        {/* TAB 6: AI TRANSFORMATION COACH WIDGET                                 */}
        {/* ══════════════════════════════════════════════════════════════════════ */}
        {activeSubTab === "coach" && (
          <div style={{ display: "flex", flexDirection: "column", gap: 14 }}>
            <div style={{
              background: "linear-gradient(135deg, #FFFFFF 0%, #EAF2FF 100%)",
              border: "1.5px solid rgba(54, 120, 245, 0.3)",
              borderRadius: 18,
              padding: "16px",
              boxShadow: "0 2px 10px rgba(54, 120, 245, 0.08)"
            }}>
              <div style={{ display: "flex", alignItems: "center", gap: 8, marginBottom: 8 }}>
                <span style={{ fontSize: 22 }}>🤖</span>
                <div>
                  <h3 style={{ margin: 0, fontSize: 15, fontWeight: 900, color: "#26354A" }}>AI Transformation Coach</h3>
                  <div style={{ fontSize: 11, color: "#64748B" }}>Daily scientific guidance & intelligent swaps</div>
                </div>
              </div>

              <div style={{ fontSize: 13, color: "#26354A", lineHeight: 1.5, background: "#FFFFFF", padding: "12px", borderRadius: 12, border: "1px solid #DCE5F2" }}>
                <strong>Coach Strategy for Today:</strong>
                <p style={{ margin: "6px 0 0", color: "#475569" }}>
                  You are targeting <strong>{plan?.targetCalories || 2200} kcal</strong> and <strong>{plan?.macros?.protein || 140}g protein</strong> for your <em>{goalDef.title}</em> goal. Focus on progressive overload with controlled tempos. If sore, prioritize 3.0L water and yellow moong dal chilla.
                </p>
              </div>
            </div>

            {/* COMMON MEAL SWAPS */}
            <div style={{
              background: "#FFFFFF",
              border: "1.5px solid #DCE5F2",
              borderRadius: 16,
              padding: "16px"
            }}>
              <div style={{ fontSize: 14, fontWeight: 900, color: "#26354A", marginBottom: 8 }}>
                🔄 Instant Meal & Macro Swaps
              </div>
              <div style={{ display: "flex", flexDirection: "column", gap: 8 }}>
                {[
                  { from: "White Rice (1 cup)", to: "Steamed Brown Rice or Quinoa", reason: "Adds +4g fibre and steady low-glycemic insulin release." },
                  { from: "Paneer (150g)", to: "Firm Soya Chunks or Tofu", reason: "Doubles protein density while lowering saturated fat for clean calorie deficit." },
                  { from: "Egg Whites (3)", to: "Sprouted Moong Salad (1 cup)", reason: "100% vegetarian alternative with natural live enzymes." },
                  { from: "Heavy Ghee Paratha", to: "Tawa Phulka with Mustard Oil Spray", reason: "Saves ~180 kcal per meal without losing satiety." }
                ].map((s, sIdx) => (
                  <div key={sIdx} style={{ background: "#F8FAFC", border: "1px solid #DCE5F2", borderRadius: 10, padding: "8px 10px" }}>
                    <div style={{ fontSize: 12.5, fontWeight: 800, color: "#26354A" }}>
                      {s.from} ➔ <span style={{ color: "#3678F5" }}>{s.to}</span>
                    </div>
                    <div style={{ fontSize: 11, color: "#64748B", marginTop: 2 }}>{s.reason}</div>
                  </div>
                ))}
              </div>
            </div>

            {/* INJURY & EQUIPMENT ADJUSTMENTS */}
            <div style={{
              background: "#FFFFFF",
              border: "1.5px solid #DCE5F2",
              borderRadius: 16,
              padding: "16px"
            }}>
              <div style={{ fontSize: 14, fontWeight: 900, color: "#26354A", marginBottom: 8 }}>
                🩹 Equipment & Joint Comfort Swaps
              </div>
              <div style={{ display: "flex", flexDirection: "column", gap: 8 }}>
                {[
                  { issue: "Knee discomfort on Barbell Squats", fix: "Switch to Box Squats or Glute Bridges to shift load to hips." },
                  { issue: "Shoulder pinch on Flat Bench", fix: "Switch to Incline Dumbbell Press (30°) with neutral palms." },
                  { issue: "No weights at home", fix: "Use backpack loaded with books or water bottles for progressive resistance." }
                ].map((adj, aIdx) => (
                  <div key={aIdx} style={{ background: "#F8FAFC", border: "1px solid #DCE5F2", borderRadius: 10, padding: "8px 10px" }}>
                    <div style={{ fontSize: 12, fontWeight: 800, color: "#D14343" }}>⚠️ {adj.issue}</div>
                    <div style={{ fontSize: 11.5, color: "#21865B", fontWeight: 700, marginTop: 2 }}>✅ {adj.fix}</div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        )}

        {/* ══════════════════════════════════════════════════════════════════════ */}
        {/* TAB 7: GOAL ASSESSMENT & QUESTIONNAIRE WIZARD                          */}
        {/* ══════════════════════════════════════════════════════════════════════ */}
        {activeSubTab === "assessment" && (
          <div style={{
            background: "#FFFFFF",
            border: "1.5px solid #DCE5F2",
            borderRadius: 20,
            padding: "18px",
            display: "flex",
            flexDirection: "column",
            gap: 16,
            boxShadow: "0 4px 20px rgba(38, 53, 74, 0.08)"
          }}>
            <div>
              <h2 style={{ margin: 0, fontSize: 17, fontWeight: 900, color: "#26354A" }}>Goal Setup & Assessment</h2>
              <div style={{ fontSize: 11.5, color: "#64748B", marginTop: 2 }}>
                Update your physical profile to regenerate personalized Indian meals and workout schedules.
              </div>
            </div>

            {/* 1. SELECT GOAL TYPE */}
            <div>
              <label style={{ fontSize: 12, fontWeight: 800, color: "#26354A", display: "block", marginBottom: 6 }}>
                Choose Your Primary Goal:
              </label>
              <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 8 }}>
                {Object.values(global.StokeBodyGoalsEngine?.GOAL_TYPES || {}).map(g => {
                  const isSel = goalData.goalType === g.id;
                  return (
                    <button
                      key={g.id}
                      type="button"
                      onClick={() => setGoalData(prev => ({ ...prev, goalType: g.id }))}
                      style={{
                        padding: "10px",
                        borderRadius: 12,
                        background: isSel ? g.bgLight : "#F8FAFC",
                        border: `1.5px solid ${isSel ? g.color : "#DCE5F2"}`,
                        textAlign: "left",
                        cursor: "pointer",
                        display: "flex",
                        flexDirection: "column",
                        gap: 2
                      }}
                    >
                      <span style={{ fontSize: 18 }}>{g.icon}</span>
                      <span style={{ fontSize: 12, fontWeight: 900, color: isSel ? g.color : "#26354A" }}>{g.title}</span>
                    </button>
                  );
                })}
              </div>
            </div>

            {/* 2. WORKOUT LOCATION & FITNESS LEVEL */}
            <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 10 }}>
              <div>
                <label style={{ fontSize: 11.5, fontWeight: 800, color: "#26354A", display: "block", marginBottom: 4 }}>
                  Workout Location:
                </label>
                <select
                  value={goalData.workoutLocation}
                  onChange={e => setGoalData(prev => ({ ...prev, workoutLocation: e.target.value }))}
                  style={{ width: "100%", padding: "8px 10px", borderRadius: 10, border: "1px solid #DCE5F2", background: "#F8FAFC", color: "#26354A", fontSize: 12.5, fontWeight: 700 }}
                >
                  <option value="home">🏠 Home (Bodyweight/Bands)</option>
                  <option value="gym">🏋️ Gym (Barbells/Machines)</option>
                </select>
              </div>

              <div>
                <label style={{ fontSize: 11.5, fontWeight: 800, color: "#26354A", display: "block", marginBottom: 4 }}>
                  Experience Level:
                </label>
                <select
                  value={goalData.fitnessLevel}
                  onChange={e => setGoalData(prev => ({ ...prev, fitnessLevel: e.target.value }))}
                  style={{ width: "100%", padding: "8px 10px", borderRadius: 10, border: "1px solid #DCE5F2", background: "#F8FAFC", color: "#26354A", fontSize: 12.5, fontWeight: 700 }}
                >
                  <option value="beginner">Beginner (&lt; 6 months)</option>
                  <option value="intermediate">Intermediate (6–24 mos)</option>
                  <option value="advanced">Advanced (2+ years)</option>
                </select>
              </div>
            </div>

            {/* 3. PHYSICAL METRICS (Age, Weight, Target Weight, Height) */}
            <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 10 }}>
              <div>
                <label style={{ fontSize: 11.5, fontWeight: 800, color: "#26354A", display: "block", marginBottom: 4 }}>
                  Age:
                </label>
                <input
                  type="number"
                  value={goalData.age}
                  onChange={e => setGoalData(prev => ({ ...prev, age: Number(e.target.value) }))}
                  style={{ width: "100%", padding: "8px 10px", borderRadius: 10, border: "1px solid #DCE5F2", background: "#F8FAFC", color: "#26354A", fontSize: 13, fontWeight: 700 }}
                />
              </div>

              <div>
                <label style={{ fontSize: 11.5, fontWeight: 800, color: "#26354A", display: "block", marginBottom: 4 }}>
                  Height (cm):
                </label>
                <input
                  type="number"
                  value={goalData.heightCm}
                  onChange={e => setGoalData(prev => ({ ...prev, heightCm: Number(e.target.value) }))}
                  style={{ width: "100%", padding: "8px 10px", borderRadius: 10, border: "1px solid #DCE5F2", background: "#F8FAFC", color: "#26354A", fontSize: 13, fontWeight: 700 }}
                />
              </div>

              <div>
                <label style={{ fontSize: 11.5, fontWeight: 800, color: "#26354A", display: "block", marginBottom: 4 }}>
                  Current Weight (kg):
                </label>
                <input
                  type="number"
                  step="0.5"
                  value={goalData.currentWeight}
                  onChange={e => setGoalData(prev => ({ ...prev, currentWeight: Number(e.target.value) }))}
                  style={{ width: "100%", padding: "8px 10px", borderRadius: 10, border: "1px solid #DCE5F2", background: "#F8FAFC", color: "#26354A", fontSize: 13, fontWeight: 700 }}
                />
              </div>

              <div>
                <label style={{ fontSize: 11.5, fontWeight: 800, color: "#26354A", display: "block", marginBottom: 4 }}>
                  Target Weight (kg):
                </label>
                <input
                  type="number"
                  step="0.5"
                  value={goalData.targetWeight}
                  onChange={e => setGoalData(prev => ({ ...prev, targetWeight: Number(e.target.value) }))}
                  style={{ width: "100%", padding: "8px 10px", borderRadius: 10, border: "1px solid #DCE5F2", background: "#F8FAFC", color: "#26354A", fontSize: 13, fontWeight: 700 }}
                />
              </div>
            </div>

            {/* 4. ACTIVITY MULTIPLIER */}
            <div>
              <label style={{ fontSize: 11.5, fontWeight: 800, color: "#26354A", display: "block", marginBottom: 4 }}>
                Daily Activity Level:
              </label>
              <select
                value={goalData.activityLevel}
                onChange={e => setGoalData(prev => ({ ...prev, activityLevel: e.target.value }))}
                style={{ width: "100%", padding: "8px 10px", borderRadius: 10, border: "1px solid #DCE5F2", background: "#F8FAFC", color: "#26354A", fontSize: 12.5, fontWeight: 700 }}
              >
                <option value="sedentary">Sedentary (Desk work, little exercise)</option>
                <option value="light">Lightly Active (1–3 walks/workouts a week)</option>
                <option value="moderate">Moderately Active (3–5 workouts a week)</option>
                <option value="very_active">Very Active (6–7 heavy workouts a week)</option>
                <option value="athlete">Athlete (Intense training / Physical job)</option>
              </select>
            </div>

            {/* SAVE BUTTON */}
            <button
              onClick={() => handleSaveGoalData(goalData)}
              disabled={isSaving}
              style={{
                background: "linear-gradient(135deg, #3678F5 0%, #2B62D9 100%)",
                color: "#FFFFFF",
                border: "none",
                borderRadius: 12,
                padding: "12px 0",
                fontSize: 14,
                fontWeight: 900,
                cursor: "pointer",
                boxShadow: "0 4px 16px rgba(54, 120, 245, 0.3)"
              }}
            >
              {isSaving ? "Saving to Supabase..." : "Save Goal & Generate AI Plan"}
            </button>
          </div>
        )}

        {/* ══════════════════════════════════════════════════════════════════════ */}
        {/* MODAL: SWAP EXERCISE SELECTOR                                         */}
        {/* ══════════════════════════════════════════════════════════════════════ */}
        {swapModalState && (
          <div style={{
            position: "fixed",
            inset: 0,
            zIndex: 9999,
            background: "rgba(38, 53, 74, 0.5)",
            display: "flex",
            alignItems: "center",
            justifyContent: "center",
            padding: 16
          }}>
            <div style={{
              background: "#FFFFFF",
              borderRadius: 20,
              padding: "20px",
              maxWidth: 420,
              width: "100%",
              boxShadow: "0 10px 40px rgba(0,0,0,0.2)",
              maxHeight: "80vh",
              overflowY: "auto"
            }}>
              <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 12 }}>
                <h3 style={{ margin: 0, fontSize: 16, fontWeight: 900, color: "#26354A" }}>
                  Swap "{swapModalState.currentEx?.name}"
                </h3>
                <button
                  onClick={() => setSwapModalState(null)}
                  style={{ background: "none", border: "none", fontSize: 18, color: "#64748B", cursor: "pointer" }}
                >
                  ✕
                </button>
              </div>

              <div style={{ fontSize: 12, color: "#64748B", marginBottom: 12 }}>
                Choose an alternative exercise targeting the same muscle group:
              </div>

              <div style={{ display: "flex", flexDirection: "column", gap: 8 }}>
                {[
                  "Push-ups",
                  "Incline Dumbbell Press",
                  "Dumbbell Floor Press",
                  "Dips",
                  "Goblet Squats",
                  "Bodyweight Squats",
                  "Bulgarian Split Squats",
                  "Dumbbell Bent-over Row",
                  "Lat Pulldown",
                  "Seated Cable Row",
                  "Dumbbell Shoulder Press",
                  "Plank Hold"
                ].filter(name => name !== swapModalState.currentEx?.name).map(optName => (
                  <button
                    key={optName}
                    onClick={() => handleSwapExercise(optName)}
                    style={{
                      background: "#F8FAFC",
                      border: "1px solid #DCE5F2",
                      borderRadius: 10,
                      padding: "10px 12px",
                      textAlign: "left",
                      color: "#26354A",
                      fontSize: 13,
                      fontWeight: 800,
                      cursor: "pointer",
                      display: "flex",
                      justifyContent: "space-between",
                      alignItems: "center"
                    }}
                  >
                    <span>{optName}</span>
                    <span style={{ color: "#3678F5", fontSize: 11 }}>Select ➔</span>
                  </button>
                ))}
              </div>
            </div>
          </div>
        )}

        {/* ══════════════════════════════════════════════════════════════════════ */}
        {/* MODAL: EXERCISE INSTRUCTIONS                                          */}
        {/* ══════════════════════════════════════════════════════════════════════ */}
        {selectedExerciseModal && (
          <div style={{
            position: "fixed",
            inset: 0,
            zIndex: 9999,
            background: "rgba(38, 53, 74, 0.5)",
            display: "flex",
            alignItems: "center",
            justifyContent: "center",
            padding: 16
          }}>
            <div style={{
              background: "#FFFFFF",
              borderRadius: 20,
              padding: "20px",
              maxWidth: 420,
              width: "100%",
              boxShadow: "0 10px 40px rgba(0,0,0,0.2)"
            }}>
              <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 10 }}>
                <h3 style={{ margin: 0, fontSize: 16, fontWeight: 900, color: "#26354A" }}>
                  {selectedExerciseModal.name}
                </h3>
                <button
                  onClick={() => setSelectedExerciseModal(null)}
                  style={{ background: "none", border: "none", fontSize: 18, color: "#64748B", cursor: "pointer" }}
                >
                  ✕
                </button>
              </div>

              <div style={{ fontSize: 12, color: "#3678F5", fontWeight: 800, marginBottom: 8 }}>
                Target: {selectedExerciseModal.target}
              </div>

              <div style={{ fontSize: 12.5, color: "#475569", lineHeight: 1.5, marginBottom: 12 }}>
                <strong>Execution Instructions:</strong>
                <ol style={{ paddingLeft: 16, marginTop: 4 }}>
                  {selectedExerciseModal.steps?.map((step, sIdx) => (
                    <li key={sIdx} style={{ marginBottom: 4 }}>{step}</li>
                  ))}
                </ol>
              </div>

              {selectedExerciseModal.youtubeUrl && (
                <a
                  href={selectedExerciseModal.youtubeUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  style={{
                    display: "block",
                    textAlign: "center",
                    background: "#FF0000",
                    color: "#FFFFFF",
                    padding: "8px 0",
                    borderRadius: 10,
                    textDecoration: "none",
                    fontWeight: 800,
                    fontSize: 12
                  }}
                >
                  ▶ Watch Video Tutorial on YouTube
                </a>
              )}
            </div>
          </div>
        )}

        {/* ══════════════════════════════════════════════════════════════════════ */}
        {/* MODAL: NEW MEASUREMENT & PHOTO DIALOG                                 */}
        {/* ══════════════════════════════════════════════════════════════════════ */}
        {showNewLogModal && (
          <NewMeasurementModal
            onClose={() => setShowNewLogModal(false)}
            onSave={handleSaveNewMeasurement}
            currentWeight={currW}
          />
        )}

        {/* ══════════════════════════════════════════════════════════════════════ */}
        {/* MODAL: PRIVATE PHOTO VIEWER                                           */}
        {/* ══════════════════════════════════════════════════════════════════════ */}
        {selectedPhotoView && (
          <div style={{
            position: "fixed",
            inset: 0,
            zIndex: 9999,
            background: "rgba(0,0,0,0.85)",
            display: "flex",
            flexDirection: "column",
            alignItems: "center",
            justifyContent: "center",
            padding: 16
          }}>
            <div style={{ maxWidth: 400, width: "100%", background: "#FFFFFF", borderRadius: 18, overflow: "hidden" }}>
              <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", padding: "12px 16px", borderBottom: "1px solid #DCE5F2" }}>
                <div>
                  <div style={{ fontSize: 13, fontWeight: 900, color: "#26354A" }}>Private Checkpoint Photo</div>
                  <div style={{ fontSize: 11, color: "#64748B" }}>{selectedPhotoView.log_date}</div>
                </div>
                <button
                  onClick={() => setSelectedPhotoView(null)}
                  style={{ background: "none", border: "none", fontSize: 18, color: "#64748B", cursor: "pointer" }}
                >
                  ✕
                </button>
              </div>

              <img
                src={selectedPhotoView.photo_url}
                alt="Progress"
                style={{ width: "100%", maxHeight: 360, objectFit: "contain", background: "#000000" }}
              />

              <div style={{ padding: "12px 16px", display: "flex", justifyContent: "space-between", alignItems: "center" }}>
                <span style={{ fontSize: 11, color: "#21865B", fontWeight: 700 }}>🔒 Secure Private Storage</span>
                <button
                  onClick={() => handleDeleteLog(selectedPhotoView.id)}
                  style={{
                    background: "rgba(239, 68, 68, 0.1)",
                    border: "1px solid #EF4444",
                    color: "#EF4444",
                    borderRadius: 8,
                    padding: "6px 12px",
                    fontSize: 11.5,
                    fontWeight: 800,
                    cursor: "pointer"
                  }}
                >
                  Permanently Delete Photo
                </button>
              </div>
            </div>
          </div>
        )}

        {/* ── TOAST NOTIFICATION ── */}
        {toastMsg && (
          <div style={{
            position: "fixed",
            bottom: 84,
            left: "50%",
            transform: "translateX(-50%)",
            background: "#FFFFFF",
            border: "1.5px solid #3678F5",
            borderRadius: 999,
            padding: "8px 20px",
            color: "#26354A",
            fontSize: 12,
            fontWeight: 800,
            zIndex: 9999,
            boxShadow: "0 8px 24px rgba(38, 53, 74, 0.15)"
          }}>
            {toastMsg}
          </div>
        )}

      </div>
    );
  }

  // ── SUB-COMPONENT: NEW MEASUREMENT MODAL ──
  function NewMeasurementModal({ onClose, onSave, currentWeight }) {
    const [weight, setWeight] = useState(currentWeight || 70);
    const [waist, setWaist] = useState("");
    const [chest, setChest] = useState("");
    const [arms, setArms] = useState("");
    const [notes, setNotes] = useState("");
    const [photoDataUrl, setPhotoDataUrl] = useState(null);
    const fileInputRef = useRef(null);

    const handleFileChange = (e) => {
      const file = e.target.files?.[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = (loadEvt) => {
          setPhotoDataUrl(loadEvt.target.result);
        };
        reader.readAsDataURL(file);
      }
    };

    const handleFormSubmit = () => {
      onSave({
        log_date: new Date().toISOString().split("T")[0],
        weight_kg: Number(weight) || null,
        waist_cm: Number(waist) || null,
        chest_cm: Number(chest) || null,
        arms_cm: Number(arms) || null,
        notes,
        photo_url: photoDataUrl
      });
    };

    return (
      <div style={{
        position: "fixed",
        inset: 0,
        zIndex: 9999,
        background: "rgba(38, 53, 74, 0.5)",
        display: "flex",
        alignItems: "center",
        justifyContent: "center",
        padding: 16
      }}>
        <div style={{
          background: "#FFFFFF",
          borderRadius: 20,
          padding: "20px",
          maxWidth: 420,
          width: "100%",
          boxShadow: "0 10px 40px rgba(0,0,0,0.2)",
          maxHeight: "85vh",
          overflowY: "auto"
        }}>
          <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 12 }}>
            <h3 style={{ margin: 0, fontSize: 16, fontWeight: 900, color: "#26354A" }}>
              Log Body Checkpoint
            </h3>
            <button
              onClick={onClose}
              style={{ background: "none", border: "none", fontSize: 18, color: "#64748B", cursor: "pointer" }}
            >
              ✕
            </button>
          </div>

          <div style={{ display: "flex", flexDirection: "column", gap: 10 }}>
            <div>
              <label style={{ fontSize: 11.5, fontWeight: 800, color: "#26354A", display: "block", marginBottom: 4 }}>
                Current Weight (kg):
              </label>
              <input
                type="number"
                step="0.1"
                value={weight}
                onChange={e => setWeight(e.target.value)}
                style={{ width: "100%", padding: "8px 10px", borderRadius: 10, border: "1px solid #DCE5F2", background: "#F8FAFC", color: "#26354A", fontSize: 13, fontWeight: 700 }}
              />
            </div>

            <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 8 }}>
              <div>
                <label style={{ fontSize: 11.5, fontWeight: 800, color: "#26354A", display: "block", marginBottom: 4 }}>
                  Waist (cm, optional):
                </label>
                <input
                  type="number"
                  step="0.5"
                  placeholder="e.g. 82"
                  value={waist}
                  onChange={e => setWaist(e.target.value)}
                  style={{ width: "100%", padding: "8px 10px", borderRadius: 10, border: "1px solid #DCE5F2", background: "#F8FAFC", color: "#26354A", fontSize: 12.5 }}
                />
              </div>

              <div>
                <label style={{ fontSize: 11.5, fontWeight: 800, color: "#26354A", display: "block", marginBottom: 4 }}>
                  Chest (cm, optional):
                </label>
                <input
                  type="number"
                  step="0.5"
                  placeholder="e.g. 98"
                  value={chest}
                  onChange={e => setChest(e.target.value)}
                  style={{ width: "100%", padding: "8px 10px", borderRadius: 10, border: "1px solid #DCE5F2", background: "#F8FAFC", color: "#26354A", fontSize: 12.5 }}
                />
              </div>
            </div>

            <div>
              <label style={{ fontSize: 11.5, fontWeight: 800, color: "#26354A", display: "block", marginBottom: 4 }}>
                Notes / Non-Scale Victory:
              </label>
              <input
                type="text"
                placeholder="e.g. Energy great, felt strong on squats today"
                value={notes}
                onChange={e => setNotes(e.target.value)}
                style={{ width: "100%", padding: "8px 10px", borderRadius: 10, border: "1px solid #DCE5F2", background: "#F8FAFC", color: "#26354A", fontSize: 12.5 }}
              />
            </div>

            {/* PRIVATE PHOTO UPLOAD */}
            <div>
              <label style={{ fontSize: 11.5, fontWeight: 800, color: "#26354A", display: "block", marginBottom: 4 }}>
                Private Progress Photo (Optional):
              </label>
              <input
                type="file"
                accept="image/*"
                ref={fileInputRef}
                style={{ display: "none" }}
                onChange={handleFileChange}
              />
              <div style={{ display: "flex", alignItems: "center", gap: 10 }}>
                <button
                  type="button"
                  onClick={() => fileInputRef.current?.click()}
                  style={{
                    background: "#EAF2FF",
                    border: "1px solid #DCE5F2",
                    color: "#3678F5",
                    borderRadius: 10,
                    padding: "8px 14px",
                    fontSize: 12,
                    fontWeight: 800,
                    cursor: "pointer"
                  }}
                >
                  📷 Select Photo
                </button>
                {photoDataUrl && (
                  <div style={{ display: "flex", alignItems: "center", gap: 6 }}>
                    <img src={photoDataUrl} alt="Preview" style={{ width: 36, height: 36, borderRadius: 6, objectFit: "cover" }} />
                    <button
                      type="button"
                      onClick={() => setPhotoDataUrl(null)}
                      style={{ background: "none", border: "none", color: "#EF4444", fontSize: 11, cursor: "pointer" }}
                    >
                      Remove
                    </button>
                  </div>
                )}
              </div>
              <div style={{ fontSize: 10.5, color: "#64748B", marginTop: 4 }}>
                🔒 Stored strictly in your private profile. Can be permanently deleted anytime.
              </div>
            </div>

            <button
              type="button"
              onClick={handleFormSubmit}
              style={{
                background: "linear-gradient(135deg, #3678F5 0%, #2B62D9 100%)",
                color: "#FFFFFF",
                border: "none",
                borderRadius: 10,
                padding: "10px 0",
                fontSize: 13,
                fontWeight: 900,
                cursor: "pointer",
                marginTop: 8
              }}
            >
              Save Checkpoint
            </button>
          </div>
        </div>
      </div>
    );
  }

  // Export globally
  global.BodyGoalsScreen = BodyGoalsScreen;

})(typeof window !== "undefined" ? window : this);


function MoreHubScreen({ profile, setProfile, goals, userPhone, onSignOut, onSwitchAccount, totals, onNavigate, onBack, currentUser, onOpenSupabaseModal }) {
  useEffect(() => {
    if (typeof injectAuthStylesV3 === "function") injectAuthStylesV3();
  }, []);

  const [activeModal, setActiveModal] = useState(null);
  const [toastMsg, setToastMsg] = useState("");
  const [isSyncing, setIsSyncing] = useState(false);
  const [syncTime, setSyncTime] = useState("Just now");

  // Show Toast Helper
  const triggerToast = (msg) => {
    setToastMsg(msg);
    setTimeout(() => setToastMsg(""), 3000);
  };

  // 1. FASTING SYSTEM (Persistent with live real-time timer)
  const [fasting, setFasting] = useState(() => {
    if (typeof localStorage !== "undefined") {
      try {
        const saved = localStorage.getItem("stoke_fasting");
        if (saved) return JSON.parse(saved);
      } catch (e) {}
    }
    return {
      isFasting: true,
      startTime: Date.now() - (14 * 3600000 + 22 * 60000), // Default 14h 22m elapsed
      goalHours: 16
    };
  });

  const [fastElapsed, setFastElapsed] = useState({ hours: 14, mins: 22 });

  useEffect(() => {
    const updateElapsed = () => {
      if (fasting.isFasting && fasting.startTime) {
        const diffMs = Math.max(0, Date.now() - fasting.startTime);
        const h = Math.floor(diffMs / 3600000);
        const m = Math.floor((diffMs % 3600000) / 60000);
        setFastElapsed({ hours: h, mins: m });
      }
    };
    updateElapsed();
    const interval = setInterval(updateElapsed, 10000);
    return () => clearInterval(interval);
  }, [fasting]);

  const toggleFasting = () => {
    if (fasting.isFasting) {
      // Stop Fast
      const updated = {
        ...fasting,
        isFasting: false,
        lastFastDuration: `${fastElapsed.hours}h ${fastElapsed.mins}m`,
        lastEnded: new Date().toLocaleDateString()
      };
      setFasting(updated);
      if (typeof localStorage !== "undefined") localStorage.setItem("stoke_fasting", JSON.stringify(updated));
      triggerToast(`Fast ended & logged (${fastElapsed.hours}h ${fastElapsed.mins}m)`);
    } else {
      // Start Fast
      const updated = {
        ...fasting,
        isFasting: true,
        startTime: Date.now()
      };
      setFasting(updated);
      setFastElapsed({ hours: 0, mins: 0 });
      if (typeof localStorage !== "undefined") localStorage.setItem("stoke_fasting", JSON.stringify(updated));
      triggerToast("New fast started! Timer is now active.");
    }
  };

  const setFastingGoal = (h) => {
    const updated = { ...fasting, goalHours: h };
    setFasting(updated);
    if (typeof localStorage !== "undefined") localStorage.setItem("stoke_fasting", JSON.stringify(updated));
    triggerToast(`Fasting protocol set to ${h}:${24 - h}`);
  };

  // 2. WEIGHT LOGGING SYSTEM (Persistent with BMI calculations)
  const [weightLogs, setWeightLogs] = useState(() => {
    if (typeof localStorage !== "undefined") {
      try {
        const saved = localStorage.getItem("stoke_weight_logs");
        if (saved) return JSON.parse(saved);
      } catch (e) {}
    }
    return [
      { id: 1, date: "Sep 1", weight: 71.5 },
      { id: 2, date: "Sep 8", weight: 71.0 },
      { id: 3, date: "Sep 15", weight: 70.6 },
      { id: 4, date: "Today", weight: Number(profile.weightKg) || 70.0 },
    ];
  });
  const [newWeightInput, setNewWeightInput] = useState(String(profile.weightKg || 70.0));

  const handleLogWeight = (val) => {
    const num = parseFloat(val);
    if (isNaN(num) || num < 30 || num > 250) {
      triggerToast("Please enter a valid weight between 30 and 250 kg");
      return;
    }
    const rounded = Number(num.toFixed(1));
    const nowStr = new Date().toLocaleDateString(undefined, { month: "short", day: "numeric" });
    const newEntry = { id: Date.now(), date: nowStr, weight: rounded };
    const updatedLogs = [...weightLogs, newEntry];
    setWeightLogs(updatedLogs);
    setNewWeightInput(String(rounded));
    setProfile(prev => ({ ...prev, weightKg: rounded }));
    if (typeof localStorage !== "undefined") {
      localStorage.setItem("stoke_weight_logs", JSON.stringify(updatedLogs));
    }
    // Sync weight to Supabase profile & daily progress
    if (currentUser?.id && typeof dbUpdateProfile === "function") {
      dbUpdateProfile(currentUser.id, { weight: rounded });
      const todayStr = typeof getLocalDateStr === "function" ? getLocalDateStr() : new Date().toISOString().split("T")[0];
      if (typeof dbUpsertDailyProgress === "function") {
        dbUpsertDailyProgress(currentUser.id, todayStr, { weight_kg: rounded });
      }
    }
    triggerToast(`Logged weight: ${rounded} kg (Updated telemetry)`);
  };

  const handleDeleteWeightLog = (id) => {
    const updated = weightLogs.filter(item => item.id !== id);
    setWeightLogs(updated);
    if (typeof localStorage !== "undefined") {
      localStorage.setItem("stoke_weight_logs", JSON.stringify(updated));
    }
    triggerToast("Weight entry removed");
  };

  // 3. SLEEP & RECOVERY (Persistent)
  const [sleepData, setSleepData] = useState(() => {
    if (typeof localStorage !== "undefined") {
      try {
        const saved = localStorage.getItem("stoke_sleep_data");
        if (saved) return JSON.parse(saved);
      } catch (e) {}
    }
    return {
      hours: 7.8,
      deepHours: 1.8,
      remHours: 2.1,
      lightHours: 3.9,
      recoveryScore: 88,
      targetHours: 8.0,
      qualityRating: 5
    };
  });

  const handleSaveSleep = (newHours, newQuality) => {
    const h = Number(newHours);
    const score = Math.min(100, Math.round((h / sleepData.targetHours) * 85 + (newQuality * 3)));
    const updated = {
      ...sleepData,
      hours: h,
      qualityRating: newQuality,
      recoveryScore: score,
      deepHours: Number((h * 0.23).toFixed(1)),
      remHours: Number((h * 0.27).toFixed(1)),
      lightHours: Number((h * 0.50).toFixed(1))
    };
    setSleepData(updated);
    if (typeof localStorage !== "undefined") {
      localStorage.setItem("stoke_sleep_data", JSON.stringify(updated));
    }
    triggerToast(`Sleep logged: ${h} hrs (Recovery Score: ${score}%)`);
    setActiveModal(null);
  };

  // 4. DAILY STEPS (Persistent)
  const [stepsData, setStepsData] = useState(() => {
    if (typeof localStorage !== "undefined") {
      try {
        const saved = localStorage.getItem("stoke_steps_data");
        if (saved) return JSON.parse(saved);
      } catch (e) {}
    }
    return {
      steps: 7420,
      goal: 10000
    };
  });

  const handleAddSteps = (count) => {
    const updated = {
      ...stepsData,
      steps: Math.max(0, stepsData.steps + count)
    };
    setStepsData(updated);
    if (typeof localStorage !== "undefined") {
      localStorage.setItem("stoke_steps_data", JSON.stringify(updated));
    }
    triggerToast(`Added ${count > 0 ? "+" + count : count} steps (Total: ${updated.steps.toLocaleString()})`);
  };

  const handleSetStepGoal = (g) => {
    const updated = { ...stepsData, goal: g };
    setStepsData(updated);
    if (typeof localStorage !== "undefined") {
      localStorage.setItem("stoke_steps_data", JSON.stringify(updated));
    }
    triggerToast(`Daily step goal set to ${g.toLocaleString()}`);
  };

  // 5. APPS & CONNECTED DEVICES (Persistent)
  const [devices, setDevices] = useState(() => {
    if (typeof localStorage !== "undefined") {
      try {
        const saved = localStorage.getItem("stoke_connected_devices");
        if (saved) return JSON.parse(saved);
      } catch (e) {}
    }
    return {
      appleHealth: true,
      googleFit: true,
      garmin: false,
      strava: true
    };
  });

  const toggleDevice = (key, name) => {
    const updated = { ...devices, [key]: !devices[key] };
    setDevices(updated);
    if (typeof localStorage !== "undefined") {
      localStorage.setItem("stoke_connected_devices", JSON.stringify(updated));
    }
    triggerToast(`${name}: ${updated[key] ? "Connected" : "Disconnected"}`);
  };

  // 6. REMINDERS & NOTIFICATION SCHEDULES (Persistent)
  const [reminders, setReminders] = useState(() => {
    if (typeof localStorage !== "undefined") {
      try {
        const saved = localStorage.getItem("stoke_reminders");
        if (saved) return JSON.parse(saved);
      } catch (e) {}
    }
    return {
      breakfast: { enabled: true, time: "8:30 AM" },
      lunch: { enabled: true, time: "1:00 PM" },
      dinner: { enabled: true, time: "7:30 PM" },
      water: { enabled: true, time: "Every 2 hrs" },
      workout: { enabled: true, time: "5:00 PM" }
    };
  });

  const toggleReminder = (key, label) => {
    const updated = {
      ...reminders,
      [key]: { ...reminders[key], enabled: !reminders[key].enabled }
    };
    setReminders(updated);
    if (typeof localStorage !== "undefined") {
      localStorage.setItem("stoke_reminders", JSON.stringify(updated));
    }
    triggerToast(`${label} reminder ${updated[key].enabled ? "enabled" : "muted"}`);
  };

  // 7. APP SETTINGS & PREFERENCES (Persistent)
  const [appSettings, setAppSettings] = useState(() => {
    if (typeof localStorage !== "undefined") {
      try {
        const saved = localStorage.getItem("stoke_settings");
        if (saved) return JSON.parse(saved);
      } catch (e) {}
    }
    return {
      units: "metric", // metric (kg/cm) vs imperial (lbs/in)
      soundHaptics: true,
      autoSync: true,
      theme: "Dark Obsidian Neumorphic"
    };
  });

  const updateSetting = (key, val, label) => {
    const updated = { ...appSettings, [key]: val };
    setAppSettings(updated);
    if (typeof localStorage !== "undefined") {
      localStorage.setItem("stoke_settings", JSON.stringify(updated));
    }
    triggerToast(`${label || key} updated`);
  };

  // 8. PRIVACY & SECURITY (Persistent)
  const [privacySettings, setPrivacySettings] = useState(() => {
    if (typeof localStorage !== "undefined") {
      try {
        const saved = localStorage.getItem("stoke_privacy");
        if (saved) return JSON.parse(saved);
      } catch (e) {}
    }
    return {
      biometricLock: false,
      diagnosticSharing: true,
      encryptedTelemetry: true
    };
  });

  const togglePrivacy = (key, label) => {
    const updated = { ...privacySettings, [key]: !privacySettings[key] };
    setPrivacySettings(updated);
    if (typeof localStorage !== "undefined") {
      localStorage.setItem("stoke_privacy", JSON.stringify(updated));
    }
    triggerToast(`${label}: ${updated[key] ? "Enabled" : "Disabled"}`);
  };

  // EXPORT TELEMETRY DATA AS JSON
  const handleExportData = () => {
    const exportBundle = {
      app: "STOKE Fitness & Athlete Telemetry",
      version: "26.37",
      timestamp: new Date().toISOString(),
      athlete: {
        name: profile.name || "Mohd Numan",
        email: userPhone || "mohdnuman701@gmail.com",
        weightKg: profile.weightKg || 70,
        heightCm: profile.heightCm || 167,
        age: profile.age || 21,
        sex: profile.sex || "male",
        strategy: profile.goalType || "maintain",
        isPro: !!profile.isPro
      },
      goals,
      weightHistory: weightLogs,
      fasting,
      sleep: sleepData,
      steps: stepsData,
      devices,
      reminders
    };
    const jsonStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(exportBundle, null, 2));
    const dlAnchor = document.createElement("a");
    dlAnchor.setAttribute("href", jsonStr);
    dlAnchor.setAttribute("download", `stoke_athlete_telemetry_${Date.now()}.json`);
    document.body.appendChild(dlAnchor);
    dlAnchor.click();
    dlAnchor.remove();
    triggerToast("Exported all biometric and health telemetry to JSON!");
  };

  // RESET APP DEMO DATA
  const handleResetData = () => {
    if (window.confirm("Reset STOKE app demo data to factory defaults? Your profile settings will be refreshed.")) {
      if (typeof localStorage !== "undefined") {
        localStorage.removeItem("stoke_weight_logs");
        localStorage.removeItem("stoke_fasting");
        localStorage.removeItem("stoke_sleep_data");
        localStorage.removeItem("stoke_steps_data");
        localStorage.removeItem("stoke_connected_devices");
        localStorage.removeItem("stoke_reminders");
        localStorage.removeItem("stoke_settings");
        localStorage.removeItem("stoke_privacy");
      }
      triggerToast("App settings restored to factory defaults.");
      setActiveModal(null);
      setTimeout(() => {
        window.location.reload();
      }, 700);
    }
  };

  // 9. EDIT BIOMETRICS FORM STATE
  const [editName, setEditName] = useState(profile.name || "Mohd Numan");
  const [editWeight, setEditWeight] = useState(String(profile.weightKg || 70));
  const [editHeight, setEditHeight] = useState(String(profile.heightCm || 167));
  const [editAge, setEditAge] = useState(String(profile.age || 21));
  const [editSex, setEditSex] = useState(profile.sex || "male");
  const [editActivity, setEditActivity] = useState(profile.activity || 1.725);
  const [editGoalType, setEditGoalType] = useState(profile.goalType || "maintain");

  // Synchronize edit fields when modal opens
  useEffect(() => {
    if (activeModal === "profile") {
      setEditName(profile.name || "Mohd Numan");
      setEditWeight(String(profile.weightKg || 70));
      setEditHeight(String(profile.heightCm || 167));
      setEditAge(String(profile.age || 21));
      setEditSex(profile.sex || "male");
      setEditActivity(profile.activity || 1.725);
      setEditGoalType(profile.goalType || "maintain");
    }
  }, [activeModal, profile]);

  const handleSaveProfile = () => {
    const w = parseFloat(editWeight) || profile.weightKg || 70;
    const h = parseFloat(editHeight) || profile.heightCm || 167;
    const a = parseInt(editAge) || profile.age || 21;
    const updated = {
      ...profile,
      name: editName.trim() || profile.name || "Mohd Numan",
      weightKg: w,
      heightCm: h,
      age: a,
      sex: editSex,
      activity: typeof editActivity === "number" ? editActivity : parseFloat(editActivity),
      goalType: editGoalType,
    };
    setProfile(updated);
    setActiveModal(null);
    triggerToast("Profile & daily targets successfully updated!");
  };

  // 10. TARGET GOALS & MACRO CONFIGURATOR
  const [goalCalInput, setGoalCalInput] = useState(String(goals.calories || 2450));
  const [goalWaterInput, setGoalWaterInput] = useState(String(goals.water || 2.6));
  const [goalStrategy, setGoalStrategy] = useState(profile.goalType || "maintain");
  const [macroPreset, setMacroPreset] = useState("balanced");

  useEffect(() => {
    if (activeModal === "goals") {
      setGoalCalInput(String(goals.calories || 2450));
      setGoalWaterInput(String(goals.water || 2.6));
      setGoalStrategy(profile.goalType || "maintain");
    }
  }, [activeModal, goals, profile]);

  const handleSaveGoals = () => {
    const cal = parseInt(goalCalInput) || goals.calories;
    const waterVal = parseFloat(goalWaterInput) || goals.water || 2.6;
    let customProtein = Math.round(profile.weightKg * 2.0);
    let customCarbs = Math.round((cal * 0.45) / 4);
    let customFat = Math.round((cal * 0.25) / 9);

    if (macroPreset === "high_protein") {
      customProtein = Math.round((cal * 0.35) / 4);
      customCarbs = Math.round((cal * 0.40) / 4);
      customFat = Math.round((cal * 0.25) / 9);
    } else if (macroPreset === "low_carb") {
      customProtein = Math.round((cal * 0.35) / 4);
      customCarbs = Math.round((cal * 0.20) / 4);
      customFat = Math.round((cal * 0.45) / 9);
    } else if (macroPreset === "keto") {
      customProtein = Math.round((cal * 0.25) / 4);
      customCarbs = Math.round((cal * 0.05) / 4);
      customFat = Math.round((cal * 0.70) / 9);
    }

    const updated = {
      ...profile,
      goalType: goalStrategy,
      customCalories: cal,
      customWater: waterVal,
      customProtein,
      customCarbs,
      customFat
    };
    setProfile(updated);
    setActiveModal(null);
    triggerToast(`Daily targets saved: ${cal} kcal · ${waterVal}L water`);
  };

  // Quick Strategy Change
  const setStrategy = (type) => {
    setProfile(prev => ({ ...prev, goalType: type }));
    setEditGoalType(type);
    triggerToast(`Target strategy changed to ${type.toUpperCase()}`);
  };

  // Trigger sync with animated rotation
  const handleSync = () => {
    setIsSyncing(true);
    setTimeout(() => {
      setIsSyncing(false);
      const now = new Date();
      setSyncTime(now.toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" }));
      triggerToast("Telemetry & Apple Health sensors synced");
    }, 850);
  };

  // Colors & Theme constants
  const LIME = "#3678F5";
  const CYAN = "#21865B";
  const AMBER = "#FF8A3D";

  const username = profile.name || userPhone || "Mohd Numan";
  const avatarLetter = (username || "M").trim().charAt(0).toUpperCase();

  // Live BMI & Telemetry Calculations
  const curWeight = profile.weightKg || 70;
  const curHeight = profile.heightCm || 167;
  const heightM = curHeight / 100;
  const bmi = (curWeight / (heightM * heightM)).toFixed(1);
  const bmiStatus = bmi < 18.5 ? "Underweight" : bmi < 25 ? "Optimal" : bmi < 30 ? "Overweight" : "Obese";

  // Macro distribution
  const proteinG = goals.protein || Math.round(curWeight * 2.2);
  const carbsG = goals.carbs || Math.round((goals.calories * 0.45) / 4);
  const fatG = goals.fat || Math.round((goals.calories * 0.25) / 9);
  const totalMacroCal = (proteinG * 4) + (carbsG * 4) + (fatG * 9);
  const pPct = Math.round(((proteinG * 4) / totalMacroCal) * 100);
  const cPct = Math.round(((carbsG * 4) / totalMacroCal) * 100);
  const fPct = Math.max(0, 100 - pPct - cPct);

  return (
    <div style={{ color: "#26354A", paddingBottom: 36, fontFamily: "'Space Grotesk', ui-sans-serif, system-ui, sans-serif" }}>

      {/* Screen Header with Safe Area Back Button */}
      <ScreenHeader
        title="More & Profile"
        subtitle="Athlete Telemetry"
        onBack={onBack}
        canGoBack={true}
        rightAction={
          <div style={{ display: "flex", alignItems: "center", gap: 10 }}>
            <span style={{ fontSize: 10, color: LIME, fontWeight: 800, letterSpacing: 1 }}>SYSTEM ONLINE</span>
            <button
              onClick={onSignOut}
              className="s3-ghost-btn"
              style={{ width: "auto", padding: "4px 10px", fontSize: 11, borderRadius: 8, height: 26, borderColor: "rgba(239,68,68,0.3)", color: "#EF4444", cursor: "pointer" }}
              title="Log out of STOKE session"
            >
              Sign Out
            </button>
          </div>
        }
      />

      {/* -- LUXURY ATHLETE HERO CARD (Soft UI + Neumorphism + Swiss) -- */}
      <div className="prof-hero-card" style={{ marginBottom: 16, position: "relative" }}>
        <div style={{ position: "absolute", top: -40, right: -40, width: 140, height: 140, borderRadius: "50%", background: "radial-gradient(circle, rgba(37, 107, 253,0.15) 0%, transparent 70%)", pointerEvents: "none" }} />

        <div style={{ display: "flex", alignItems: "center", gap: 16, position: "relative", zIndex: 1 }}>
          {/* Avatar ring */}
          <div
            className="prof-avatar-ring"
            onClick={() => setActiveModal("premium")}
            style={{ cursor: "pointer" }}
            title="View PRO Membership status"
          >
            <div className="prof-avatar-inner">
              {avatarLetter}
            </div>
            <div className="prof-badge-pro" style={{ background: profile.isPro ? "linear-gradient(135deg, #FBBF24 0%, #D97706 100%)" : undefined, color: profile.isPro ? "#000" : undefined }}>
              {profile.isPro ? "ELITE" : "PRO"}
            </div>
          </div>

          <div style={{ flex: 1, minWidth: 0 }}>
            <div style={{ display: "flex", alignItems: "center", gap: 6 }}>
              <h2 style={{ margin: 0, fontSize: 20, fontWeight: 900, color: "#26354A", letterSpacing: -0.5, overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" }}>
                {username}
              </h2>
              <span style={{ color: LIME, fontSize: 14 }} title="Verified STOKE Athlete">✓</span>
            </div>
            <div style={{ fontSize: 12, color: "#64748B", marginTop: 2, letterSpacing: 0.2 }}>
              {profile.isPro ? "STOKE Pro Elite Athlete · Level 12" : "STOKE Member · Level 12 Athlete"}
            </div>
            <div style={{ display: "flex", gap: 8, marginTop: 8, flexWrap: "wrap" }}>
              <button
                onClick={() => setActiveModal("profile")}
                className="mat-ripple"
                style={{
                  background: "#FFFFFF",
                  border: "1px solid #DCE5F2",
                  borderRadius: 10,
                  padding: "5px 12px",
                  color: "#3678F5",
                  fontSize: 11,
                  fontWeight: 800,
                  cursor: "pointer",
                  letterSpacing: 0.5,
                  display: "inline-flex",
                  alignItems: "center",
                  gap: 5,
                  boxShadow: "0 2px 8px rgba(0,0,0,0.4)"
                }}
              >
                <span>✏️</span> Edit Biometrics
              </button>

              <button
                onClick={() => setActiveModal("profile_login")}
                className="mat-ripple"
                style={{
                  background: "#EAF2FF",
                  border: "1px solid rgba(54,120,245,0.35)",
                  borderRadius: 10,
                  padding: "5px 12px",
                  color: "#3678F5",
                  fontSize: 11,
                  fontWeight: 900,
                  cursor: "pointer",
                  letterSpacing: 0.5,
                  display: "inline-flex",
                  alignItems: "center",
                  gap: 5,
                  boxShadow: "0 0 12px rgba(37, 107, 253,0.2)"
                }}
              >
                <span>🔐</span> Switch Account
              </button>

              <button
                onClick={handleSync}
                className="mat-ripple"
                style={{
                  background: "#FFFFFF",
                  border: "1px solid #DCE5F2",
                  borderRadius: 10,
                  padding: "5px 10px",
                  color: "#26354A",
                  fontSize: 11,
                  fontWeight: 700,
                  cursor: "pointer",
                  display: "inline-flex",
                  alignItems: "center",
                  gap: 5
                }}
              >
                <span style={{ display: "inline-block", transform: isSyncing ? "rotate(360deg)" : "none", transition: isSyncing ? "transform 0.8s ease" : "none" }}>🔄</span>
                <span>{isSyncing ? "Syncing…" : "Sync"}</span>
              </button>

              <button
                onClick={() => onOpenSupabaseModal && onOpenSupabaseModal()}
                className="mat-ripple"
                style={{
                  background: "#EAF2FF",
                  border: "1px solid rgba(33, 134, 91,0.35)",
                  borderRadius: 10,
                  padding: "5px 11px",
                  color: "#21865B",
                  fontSize: 11,
                  fontWeight: 800,
                  cursor: "pointer",
                  display: "inline-flex",
                  alignItems: "center",
                  gap: 5,
                  boxShadow: "0 0 10px rgba(16,185,129,0.2)"
                }}
                title="Configure Supabase Cloud Database"
              >
                <span>⚡</span>
                <span>Supabase Cloud</span>
              </button>
            </div>
          </div>
        </div>

        {/* -- SWISS TELEMETRY 4-CELL GRID (All Clickable to Respective Tools) -- */}
        <div className="prof-telemetry-grid">
          <div className="prof-telemetry-cell" onClick={() => setActiveModal("weight")} style={{ cursor: "pointer" }} title="Log or view weight history">
            <div className="prof-telemetry-val" style={{ color: "#26354A" }}>{curWeight} <span style={{ fontSize: 10, color: LIME }}>KG</span></div>
            <div className="prof-telemetry-lbl">Weight ›</div>
          </div>
          <div className="prof-telemetry-cell" onClick={() => setActiveModal("steps")} style={{ cursor: "pointer" }} title="View daily steps & activity">
            <div className="prof-telemetry-val" style={{ color: AMBER }}>{stepsData.steps.toLocaleString()} <span style={{ fontSize: 10 }}>👟</span></div>
            <div className="prof-telemetry-lbl">Today Steps ›</div>
          </div>
          <div className="prof-telemetry-cell" onClick={() => setActiveModal("goals")} style={{ cursor: "pointer" }} title="Configure target calorie and macro split">
            <div className="prof-telemetry-val" style={{ color: LIME }}>{goals.calories}</div>
            <div className="prof-telemetry-lbl">Target kcal ›</div>
          </div>
          <div className="prof-telemetry-cell" onClick={() => onNavigate && onNavigate("nutrition")} style={{ cursor: "pointer" }} title="Track daily water and meals in Nutrition">
            <div className="prof-telemetry-val" style={{ color: CYAN }}>{goals.water || 2.6} <span style={{ fontSize: 10 }}>L</span></div>
            <div className="prof-telemetry-lbl">Hydration ›</div>
          </div>
        </div>

        {/* -- NEUMORPHIC STRATEGY CONTROL -- */}
        <div style={{ marginTop: 14 }}>
          <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 6 }}>
            <span style={{ fontSize: 10, fontWeight: 900, color: "#64748B", letterSpacing: 1.5, textTransform: "uppercase" }}>Active Strategy</span>
            <span style={{ fontSize: 11, color: LIME, fontWeight: 800 }}>
              {profile.goalType === "cut" ? "Deficit (-400 kcal)" : profile.goalType === "gain" ? "Surplus (+400 kcal)" : "Maintenance (Energy balance)"}
            </span>
          </div>
          <div className="prof-strategy-track">
            {[
              { id: "cut", label: "Cut · Fat Loss" },
              { id: "maintain", label: "Maintain" },
              { id: "gain", label: "Bulk · Muscle" },
            ].map(s => {
              const active = profile.goalType === s.id;
              return (
                <button
                  key={s.id}
                  onClick={() => setStrategy(s.id)}
                  className={`prof-strategy-btn${active ? " active" : ""}`}
                >
                  {s.label}
                </button>
              );
            })}
          </div>
        </div>

        {/* -- SWISS MACRO RATIO BAR -- */}
        <div onClick={() => setActiveModal("goals")} style={{ cursor: "pointer" }} title="Click to edit Macro split & targets">
          <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", fontSize: 11, fontWeight: 700 }}>
            <span style={{ color: LIME }}>P: {proteinG}g ({pPct}%)</span>
            <span style={{ color: CYAN }}>C: {carbsG}g ({cPct}%)</span>
            <span style={{ color: AMBER }}>F: {fatG}g ({fPct}%)</span>
          </div>
          <div className="prof-ratio-bar">
            <div style={{ width: `${pPct}%`, background: LIME, transition: "width 0.4s ease" }} />
            <div style={{ width: `${cPct}%`, background: CYAN, transition: "width 0.4s ease" }} />
            <div style={{ width: `${fPct}%`, background: AMBER, transition: "width 0.4s ease" }} />
          </div>
          <div style={{ display: "flex", justifyContent: "space-between", fontSize: 10, color: "#64748B", marginTop: 4 }}>
            <span>BMI: {bmi} ({bmiStatus})</span>
            <span>Est. BMR: 1,745 kcal · TDEE: {goals.calories} kcal</span>
          </div>
        </div>
      </div>

      {/* -- GOLD PRO VIP PASS BANNER (Neumorphic Glow) -- */}
      <div
        onClick={() => setActiveModal("premium")}
        className="mat-ripple"
        style={{
          cursor: "pointer",
          background: profile.isPro ? "linear-gradient(135deg, rgba(37,107,253,0.2) 0%, rgba(245,158,11,0.18) 100%)" : "linear-gradient(135deg, rgba(245,158,11,0.18) 0%, rgba(37, 107, 253,0.12) 100%)",
          border: profile.isPro ? "1.5px solid rgba(37,107,253,0.5)" : "1.5px solid rgba(245,158,11,0.35)",
          borderRadius: 18,
          padding: "16px 18px",
          marginBottom: 16,
          display: "flex",
          alignItems: "center",
          justifyContent: "space-between",
          boxShadow: "var(--neu-raised), 0 0 24px rgba(245,158,11,0.1)",
        }}
      >
        <div style={{ display: "flex", alignItems: "center", gap: 14 }}>
          <div style={{ width: 40, height: 40, borderRadius: 12, background: "rgba(245,158,11,0.15)", border: "1px solid rgba(245,158,11,0.3)", display: "flex", alignItems: "center", justifyContent: "center", fontSize: 20 }}>
            👑
          </div>
          <div>
            <div style={{ fontSize: 14, fontWeight: 900, color: "#FBBF24", letterSpacing: -0.2 }}>
              {profile.isPro ? "STOKE Pro Elite Pass (Active)" : "STOKE Pro Elite Pass"}
            </div>
            <div style={{ fontSize: 12, color: "#64748B", marginTop: 2 }}>
              {profile.isPro ? "Unlimited AI food scanner, autophagy radar & GPS unlocked" : "Unlimited AI food camera, fasting stages & GPS telemetry"}
            </div>
          </div>
        </div>
        <span style={{ fontSize: 18, color: "#FBBF24", fontWeight: 900 }}>›</span>
      </div>

      {/* -- SECTION 1: BIOMETRICS & TARGETS (Material Cards) -- */}
      <div style={{ marginBottom: 14 }}>
        <div style={{ fontSize: 10, fontWeight: 900, color: "#64748B", letterSpacing: 2, textTransform: "uppercase", marginBottom: 8, paddingLeft: 4 }}>
          Biometrics & Targets
        </div>
        <div className="prof-section-card">
          {[
            { id: "profile_login", label: "Profile Login & Account Management", icon: "🔐", sub: `Active: ${username} · 4 Linked Accounts`, badge: "Active", badgeColor: LIME },
            { id: "profile", label: "My Profile & Biometrics", icon: "👤", sub: `${profile.name || "Mohd Numan"} · ${profile.weightKg || 70}kg · ${profile.heightCm || 167}cm` },
            { id: "weight", label: "Weight & Body Measurements", icon: "📊", sub: `Current: ${profile.weightKg || 70} kg · ${weightLogs.length} weigh-ins logged` },
            { id: "goals", label: "Target Goals & Strategy", icon: "🎯", sub: `${profile.goalType === "cut" ? "Fat Loss Cut" : profile.goalType === "gain" ? "Hypertrophy Bulk" : "Maintenance"} · ${goals.calories} kcal` },
            { id: "fasting", label: "Intermittent Fasting", icon: "⌛", badge: fasting.isFasting ? `${fastElapsed.hours}h ${fastElapsed.mins}m Active` : "Idle", badgeColor: LIME },
          ].map(item => (
            <div
              key={item.id}
              onClick={() => setActiveModal(item.id)}
              className="prof-row-item mat-ripple"
            >
              <div style={{ display: "flex", alignItems: "center", gap: 14 }}>
                <div className="prof-icon-well"><MoreItemIcon name={item.id} size={18} color="#3678F5" /></div>
                <div>
                  <div style={{ fontSize: 14, fontWeight: 700, color: "#26354A" }}>{item.label}</div>
                  <div style={{ fontSize: 11.5, color: "#64748B", marginTop: 2 }}>{item.sub}</div>
                </div>
              </div>
              <div style={{ display: "flex", alignItems: "center", gap: 8 }}>
                {item.badge && (
                  <span style={{ fontSize: 10, background: "rgba(37, 107, 253,0.12)", color: item.badgeColor || LIME, padding: "2px 8px", borderRadius: 999, fontWeight: 800, border: "1px solid rgba(37, 107, 253,0.2)" }}>
                    {item.badge}
                  </span>
                )}
                <span style={{ fontSize: 18, color: "#64748B" }}>›</span>
              </div>
            </div>
          ))}
        </div>
      </div>

      {/* -- SECTION 2: PERFORMANCE & RECOVERY -- */}
      <div style={{ marginBottom: 14 }}>
        <div style={{ fontSize: 10, fontWeight: 900, color: "#64748B", letterSpacing: 2, textTransform: "uppercase", marginBottom: 8, paddingLeft: 4 }}>
          Performance & Recovery
        </div>
        <div className="prof-section-card">
          {[
            { id: "sleep", label: "Sleep & Recovery Quality", icon: "🌙", sub: `${sleepData.hours} hrs · ${sleepData.recoveryScore}% Recovery Score (Optimal)` },
            { id: "steps", label: "Daily Steps & Movement", icon: "👟", sub: `${stepsData.steps.toLocaleString()} steps · ${Math.round((stepsData.steps / stepsData.goal) * 100)}% of ${stepsData.goal.toLocaleString()} target` },
          ].map(item => (
            <div
              key={item.id}
              onClick={() => {
                if (item.nav) onNavigate && onNavigate(item.nav);
                else setActiveModal(item.id);
              }}
              className="prof-row-item mat-ripple"
            >
              <div style={{ display: "flex", alignItems: "center", gap: 14 }}>
                <div className="prof-icon-well"><MoreItemIcon name={item.id} size={18} color="#3678F5" /></div>
                <div>
                  <div style={{ fontSize: 14, fontWeight: 700, color: "#26354A" }}>{item.label}</div>
                  <div style={{ fontSize: 11.5, color: "#64748B", marginTop: 2 }}>{item.sub}</div>
                </div>
              </div>
              <span style={{ fontSize: 18, color: "#64748B" }}>›</span>
            </div>
          ))}
        </div>
      </div>

      {/* -- SECTION 3: SYSTEM, DEVICES & PREFERENCES -- */}
      <div style={{ marginBottom: 20 }}>
        <div style={{ fontSize: 10, fontWeight: 900, color: "#64748B", letterSpacing: 2, textTransform: "uppercase", marginBottom: 8, paddingLeft: 4 }}>
          System & Connectivity
        </div>
        <div className="prof-section-card">
          {[
            {
              id: "supabase",
              label: "Supabase Cloud Database & Storage",
              icon: "⚡",
              sub: (typeof getSupabaseClient === "function" && getSupabaseClient()) ? "Connected · Persistent Cloud Storage Active" : "Connect your Supabase URL & Anon Key",
              badge: (typeof getSupabaseClient === "function" && getSupabaseClient()) ? "Connected" : "Setup",
              badgeColor: (typeof getSupabaseClient === "function" && getSupabaseClient()) ? "#10B981" : "#F59E0B"
            },
            {
              id: "devices",
              label: "Apps & Connected Devices",
              icon: "📱",
              sub: `${Object.entries(devices).filter(([_, v]) => v).length} Connected (Apple Health, Strava)`
            },
            {
              id: "reminders",
              label: "Daily Reminders & Alerts",
              icon: "⏰",
              sub: `${Object.values(reminders).filter(r => r.enabled).length} Active prompts (Meals, hydration, workout)`
            },
            {
              id: "settings",
              label: "Account & App Preferences",
              icon: "⚙️",
              sub: `${appSettings.units === "metric" ? "Metric (kg/cm)" : "Imperial (lbs/in)"} · ${appSettings.theme}`
            },
            {
              id: "privacy",
              label: "Privacy & Cloud Security",
              icon: "🔒",
              sub: `${privacySettings.biometricLock ? "Biometric Protected" : "Encrypted Telemetry"} · Data Export`
            },
          ].map(item => (
            <div
              key={item.id}
              onClick={() => {
                if (item.id === "supabase") {
                  if (onOpenSupabaseModal) onOpenSupabaseModal();
                  else setActiveModal("supabase");
                } else {
                  setActiveModal(item.id);
                }
              }}
              className="prof-row-item mat-ripple"
