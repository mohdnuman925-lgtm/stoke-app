          borderRadius: 20,
          padding: 20,
          marginBottom: 14,
          boxShadow: CARD_SHADOW,
        }}
      >
        <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 16 }}>
          <div>
            <div style={{ fontSize: 11.5, color: TOKENS.mutedFaint, letterSpacing: 0.5, textTransform: "uppercase", fontWeight: 700 }}>Nutrition Tracker</div>
            <div style={{ display: "flex", alignItems: "baseline", gap: 6, marginTop: 4 }}>
              <span style={{ fontSize: 32, fontWeight: 800, color: TOKENS.text, fontVariantNumeric: "tabular-nums", letterSpacing: -1 }}>
                {Math.round(totals.calories || 0)}
              </span>
              <span style={{ fontSize: 13, color: TOKENS.mutedFaint, fontWeight: 500 }}>/ {goals.calories} kcal</span>
            </div>
            <div style={{ fontSize: 12, color: kcalRemaining > 0 ? TOKENS.teal : TOKENS.ember, fontWeight: 600, marginTop: 2 }}>
