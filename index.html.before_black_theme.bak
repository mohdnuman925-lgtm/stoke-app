  { name: "Greek yogurt, plain", calories: 100, protein: 17, carbs: 6, fat: 0.7, fiber: 0, grams: 170, dietType: "veg" },
  { name: "Banana", calories: 105, protein: 1.3, carbs: 27, fat: 0.4, fiber: 3.1, grams: 118, dietType: "veg" },
  { name: "Almonds, raw", calories: 164, protein: 6, carbs: 6, fat: 14, fiber: 3.5, grams: 28, dietType: "veg" },
  { name: "Oatmeal, cooked", calories: 158, protein: 6, carbs: 27, fat: 3.2, fiber: 4, grams: 234, dietType: "veg" },
];

const DEFAULT_MEAL_SLOTS = [
  { key: "breakfast", label: "Breakfast" },
  { key: "lunch", label: "Lunch" },
  { key: "workout", label: "Pre Workout" },
  { key: "postworkout", label: "Post Workout" },
  { key: "dinner", label: "Dinner" },
];

const WORKOUT_PROGRAMS = {
