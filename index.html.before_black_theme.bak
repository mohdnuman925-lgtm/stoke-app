                            <div style={{ fontSize: 11, color: "#64748B" }}>{act.d}</div>
                          </div>
                          <NeuRadio checked={sel} />
                        </div>
                      );
                    })}
                  </div>
                </div>

                {/* Target Strategy */}
                <div>
                  <div style={{ fontSize: 11, fontWeight: 800, color: "#64748B", textTransform: "uppercase", letterSpacing: 1.5, marginBottom: 8 }}>
