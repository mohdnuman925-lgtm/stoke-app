  primaryHover: "#2B62D9",  // Deeper warm orange for hover / pressed states
  primarySoft: "rgba(54, 120, 245, 0.12)", // Warm orange tint for chips / badges / pills
  primaryBorder: "rgba(54, 120, 245, 0.35)",
  text: "#26354A",          // Dark brown headings and primary text
  textMuted: "#64748B",     // Secondary text
  textFaint: "#64748B",     // Subtle caption text
  border: "#DCE5F2",        // Warm borders and dividers
  borderSoft: "rgba(220, 229, 242, 0.7)",
  inputBg: "#F8FAFF",       // Clean subtle input backgrounds
  inputBorder: "#DCE5F2",   // Input border
  success: "#21865B",       // Success indicator
  successSoft: "rgba(33, 134, 91, 0.14)",
  error: "#D14343",         // Error indicator
  errorSoft: "rgba(209, 67, 67, 0.14)",
  shadowSm: "0 2px 8px rgba(38, 53, 74, 0.04)",
  shadowMd: "0 4px 16px rgba(38, 53, 74, 0.06)",
  shadowLg: "0 8px 24px rgba(38, 53, 74, 0.08)",
  shadowCard: "0 4px 16px rgba(38, 53, 74, 0.08)",
  protein: "#3678F5",       // Primary blue protein
  carbs: "#60A5FA",         // Sky blue carbs
  fat: "#F59E0B",           // Warm amber fat
  fiber: "#21865B",         // Forest green fiber
  water: "#0284C7",         // Clear cyan-blue water
};

const TOKENS = {
  bg: THEME.bg,
  surface: THEME.card,
  surface2: "#EAF2FF",
  surfaceWhite: THEME.cardWhite,
  border: THEME.border,
  text: THEME.text,
  muted: THEME.textMuted,
  mutedFaint: THEME.textFaint,
  ember: THEME.primary,
  primary: THEME.primary,
  protein: THEME.protein,
  carbs: THEME.carbs,
  fat: THEME.fat,
  fiber: THEME.fiber,
  water: THEME.water,
  teal: THEME.fiber,
  lime: THEME.primary,
  success: THEME.success,
  error: THEME.error,
};

const CARD_SHADOW = "0 4px 16px rgba(38, 53, 74, 0.08)";

const DEFAULT_PROFILE = { name: "", weightKg: 70, heightCm: 175, age: 28, sex: "male", goalType: "maintain", activity: 1.55 };

function computeGoals(profile) {
  const { weightKg, heightCm, age, sex, goalType, activity } = profile;
  const bmr = sex === "female"
    ? 10 * weightKg + 6.25 * heightCm - 5 * age - 161
    : 10 * weightKg + 6.25 * heightCm - 5 * age + 5;
  const tdee = bmr * (activity || 1.55);
  const calculatedCal = Math.round(goalType === "cut" ? tdee - 500 : goalType === "gain" ? tdee + 300 : tdee);
  const calories = profile.customCalories ? Number(profile.customCalories) : calculatedCal;
  const protein = profile.customProtein ? Number(profile.customProtein) : Math.round(weightKg * (goalType === "cut" ? 2.0 : 1.8));
  const fat = profile.customFat ? Number(profile.customFat) : Math.round((calories * 0.25) / 9);
  const carbs = profile.customCarbs ? Number(profile.customCarbs) : Math.max(0, Math.round((calories - protein * 4 - fat * 9) / 4));
  const fiber = Math.round((calories / 1000) * 14);
  const water = profile.customWater ? Number(profile.customWater) : (Math.round(((weightKg * 0.033) + 0.3) * 10) / 10);
  return { calories, protein, carbs, fat, fiber, water };
}

