                        fontSize: 22,
                        fontWeight: 900,
                        textAlign: "center",
                        outline: "none"
                      }}
                    />
                    <button
                      onClick={() => setGoalCalInput(String(Math.min(5000, (parseInt(goalCalInput) || 2450) + 100)))}
                      className="s3-ghost-btn"
                      style={{ width: 44, height: 48, fontSize: 18, fontWeight: 800, borderRadius: 12 }}
                    >
                      +
