          <div style={{ fontSize: 11, fontWeight: 800, color: "#F59E0B", textTransform: "uppercase", letterSpacing: 0.5, marginBottom: 4 }}>How to Increase Score</div>
          <p style={{ margin: 0, fontSize: 12.5, lineHeight: 1.45, color: "rgba(255,255,255,0.85)" }}>{scoreData.tip}</p>
        </div>

        <button onClick={onClose} style={{ width: "100%", background: "#3678F5", border: "none", borderRadius: 14, padding: "13px 0", color: "#FFFFFF", fontSize: 14, fontWeight: 700, cursor: "pointer", boxShadow: "0 6px 20px rgba(37,107,253,0.35)" }}>
          Got It
        </button>
      </div>
    </div>
  );
}

