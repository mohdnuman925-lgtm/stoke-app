              style={{ background: "#FFFFFF", border: "1px solid #DCE5F2", borderRadius: 6, color: "#64748B", fontSize: 10, cursor: "pointer", padding: "2px 6px" }}
            >
              ↺ Reset
            </button>
          </div>
        </div>
        <div style={{ height: 6, background: "#DCE5F2", borderRadius: 999, overflow: "hidden", marginBottom: 12 }}>
          <div style={{ width: `${waterPct * 100}%`, height: "100%", background: TOKENS.water, borderRadius: 999, transition: "width 0.3s ease" }} />
        </div>
        <div style={{ display: "flex", gap: 8 }}>
          <button
            onClick={() => addWater(0.25)}
            style={{ flex: 1, background: "#FFFFFF", border: "1.5px solid #DCE5F2", borderRadius: 10, padding: "7px 0", color: TOKENS.water, fontSize: 12, fontWeight: 700, cursor: "pointer" }}
          >
            +250ml
          </button>
          <button
            onClick={() => addWater(0.5)}
            style={{ flex: 1, background: "#FFFFFF", border: "1.5px solid #DCE5F2", borderRadius: 10, padding: "7px 0", color: TOKENS.water, fontSize: 12, fontWeight: 700, cursor: "pointer" }}
          >
            +500ml
          </button>
          <button
            onClick={() => addWater(0.75)}
            style={{ flex: 1, background: "#FFFFFF", border: "1.5px solid #DCE5F2", borderRadius: 10, padding: "7px 0", color: TOKENS.water, fontSize: 12, fontWeight: 700, cursor: "pointer" }}
          >
            +750ml
          </button>
        </div>
      </div>


      {/* ============================================================
          7. TODAY'S WORKOUT / RUNNING + READINESS
          ============================================================ */}
      <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 12, marginBottom: 14 }}>
        <div
          onClick={() => onNavigate && onNavigate("workout")}
          style={{ cursor: "pointer", background: TOKENS.ember, borderRadius: 20, padding: 18, boxShadow: CARD_SHADOW }}
        >
          <div style={{ display: "flex", justifyContent: "space-between", alignItems: "flex-start", marginBottom: 12 }}>
            <IconBadge icon="workout" bg="rgba(0,0,0,0.12)" />
            {totalExercises > 0 && <SmallRing progress={completedCount / Math.max(1, totalExercises)} color="#0B0E13" size={32} stroke={4} />}
          </div>
          <div style={{ fontSize: 10.5, color: "rgba(11,14,19,0.65)", fontWeight: 700, textTransform: "uppercase", letterSpacing: 0.5 }}>{TODAY_KEY} Workout</div>
          <div style={{ fontSize: 15, fontWeight: 800, color: "#0B0E13", marginTop: 2 }}>{workoutDay?.label || "Workout"}</div>
          {!workoutDay?.rest && totalExercises > 0 && (
            <div style={{ fontSize: 11.5, color: "rgba(11,14,19,0.7)", marginTop: 2, fontWeight: 600 }}>
              {completedCount}/{totalExercises} finished
            </div>
          )}
        </div>

        <div
          onClick={() => onNavigate && onNavigate("run")}
          style={{ cursor: "pointer", background: "#EAF2FF", border: "1px solid #DCE5F2", borderRadius: 20, padding: 18, boxShadow: "0 4px 16px rgba(38, 53, 74,0.08)" }}
        >
          <div style={{ display: "flex", justifyContent: "space-between", alignItems: "flex-start", marginBottom: 12 }}>
            <IconBadge icon="run" bg="rgba(37, 107, 253,0.16)" />
            <span style={{ fontSize: 10, background: "rgba(54,120,245,0.15)", color: "#3678F5", padding: "2px 6px", borderRadius: 6, fontWeight: 700 }}>STOKE</span>
          </div>
          <div style={{ fontSize: 10.5, color: TOKENS.mutedFaint, fontWeight: 700, textTransform: "uppercase", letterSpacing: 0.5 }}>Run Tracker</div>
          <div style={{ fontSize: 15, fontWeight: 800, color: "#26354A", marginTop: 2 }}>
            {lastRun ? `${lastRunDist} km` : "Start Run"}
          </div>
          <div style={{ fontSize: 11.5, color: TOKENS.muted, marginTop: 2 }}>
            {lastRunCals}
          </div>
        </div>
      </div>

      {/* Readiness / Energy Gauge */}
      <div
        style={{
          background: TOKENS.surface,
          border: `1px solid ${TOKENS.border}`,
          borderRadius: 18,
          padding: "14px 18px",
          display: "flex",
          justifyContent: "space-between",
          alignItems: "center",
          marginBottom: 14
        }}
      >
        <div style={{ display: "flex", alignItems: "center", gap: 10 }}>
          <div style={{ width: 36, height: 36, borderRadius: 10, background: "rgba(46,212,191,0.15)", display: "flex", alignItems: "center", justifyContent: "center", color: TOKENS.teal }}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2ED4BF" strokeWidth="2.4" strokeLinecap="round" strokeLinejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
          </div>
          <div>
            <div style={{ fontSize: 13, fontWeight: 700, color: TOKENS.text }}>Readiness: Optimal (92%)</div>
            <div style={{ fontSize: 11, color: TOKENS.mutedFaint }}>Based on today's calories, training & hydration</div>
          </div>
        </div>
        <span style={{ fontSize: 12, fontWeight: 700, color: TOKENS.teal }}>Ready</span>
      </div>

      {/* ============================================================
          8. ACHIEVEMENT ROOM PREVIEW
          ============================================================ */}
      <AchievementRoomPreview
        achievements={achievements}
        onViewAll={() => setShowAchievementsModal(true)}
      />

      {/* ============================================================
          9. YOUR WEEKLY STORY
          ============================================================ */}
      <WeeklyStoryCard
        weeklyStats={weeklyStats}
        onOpenStory={() => setShowWeeklyStoryModal(true)}
      />


    </div>
  );
}


/* ─── SUPABASE CLOUD LOADING SCREEN ─── */
function AppLoadingScreen() {
  return (
    <div style={{
      position: "fixed",
      inset: 0,
      background: "#FFFFFF",
      display: "flex",
      flexDirection: "column",
      alignItems: "center",
