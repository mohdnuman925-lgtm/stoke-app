        <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 20 }}>
          <div style={{ display: "flex", alignItems: "center", gap: 8 }}>
            <div style={{ width: 34, height: 34, borderRadius: 10, background: "rgba(37,107,253,0.18)", display: "flex", alignItems: "center", justifyContent: "center", color: "#3B82F6" }}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
            </div>
            <div>
              <h3 style={{ margin: 0, fontSize: 18, fontWeight: 800, color: "#FFFFFF" }}>Fitness Score Breakdown</h3>
              <p style={{ margin: "2px 0 0", fontSize: 11, color: "#64748B" }}>Real-time telemetry from your training & nutrition</p>
            </div>
          </div>
          <button onClick={onClose} style={{ width: 32, height: 32, borderRadius: "50%", background: "rgba(255,255,255,0.08)", border: "none", color: "#FFF", cursor: "pointer", fontSize: 16, display: "flex", alignItems: "center", justifyContent: "center" }}>✕</button>
        </div>

        {/* Hero Score Badge */}
        <div style={{ display: "flex", alignItems: "center", justifyContent: "space-between", background: "linear-gradient(135deg, rgba(37,107,253,0.12) 0%, rgba(61,220,255,0.05) 100%)", border: "1px solid rgba(37,107,253,0.3)", borderRadius: 18, padding: "16px 18px", marginBottom: 20 }}>
          <div>
            <div style={{ fontSize: 11, fontWeight: 700, color: "#3B82F6", textTransform: "uppercase", letterSpacing: 0.6 }}>Current Daily Index</div>
            <div style={{ display: "flex", alignItems: "baseline", gap: 4, marginTop: 2 }}>
              <span style={{ fontSize: 38, fontWeight: 900, color: "#FFFFFF", letterSpacing: -1 }}>{scoreData.total}</span>
              <span style={{ fontSize: 15, color: "#64748B", fontWeight: 700 }}>/ 100</span>
            </div>
            <div style={{ fontSize: 11.5, color: "#22C55E", fontWeight: 700, marginTop: 4, display: "inline-flex", alignItems: "center", gap: 3 }}>
            ▲ {scoreData.weeklyDelta}
              <span style={{ color: "#64748B", fontWeight: 500 }}>vs previous 7 days</span>
            </div>
          </div>

          <div style={{ width: 72, height: 72, position: "relative", display: "flex", alignItems: "center", justifyContent: "center" }}>
            <svg width="72" height="72" viewBox="0 0 72 72" style={{ transform: "rotate(-90deg)" }}>
              <circle cx="36" cy="36" r="30" stroke="rgba(255,255,255,0.08)" strokeWidth="6" fill="none" />
              <circle cx="36" cy="36" r="30" stroke="url(#modalScoreGrad)" strokeWidth="6" fill="none" strokeDasharray={188.5} strokeDashoffset={188.5 * (1 - scoreData.total / 100)} strokeLinecap="round" style={{ transition: "stroke-dashoffset 1s ease" }} />
              <defs>
                <linearGradient id="modalScoreGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stopColor="#256BFD" />
                  <stop offset="100%" stopColor="#3DDCFF" />
                </linearGradient>
              </defs>
            </svg>
            <div style={{ position: "absolute", fontSize: 13, fontWeight: 800, color: "#FFFFFF" }}>{scoreData.total}%</div>
          </div>
        </div>

        {/* 5-Factor Score Sliders */}
        <div style={{ display: "flex", flexDirection: "column", gap: 14, marginBottom: 20 }}>
          {scoreData.breakdown.map((item) => {
            const pct = Math.min(100, Math.round((item.score / item.max) * 100));
            return (
              <div key={item.label} style={{ background: "rgba(255,255,255,0.03)", border: "1px solid rgba(255,255,255,0.06)", borderRadius: 14, padding: "12px 14px" }}>
