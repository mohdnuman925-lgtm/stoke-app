}

/* ─── SUPABASE DATABASE & STORAGE SETTINGS MODAL ─── */
function SupabaseSettingsModal({ isOpen, onClose }) {
  const [cfg, setCfg] = useState(() => (typeof getSupabaseConfig === "function" ? getSupabaseConfig() : { url: "", key: "" }));
  const [status, setStatus] = useState("idle");
  const [statusMsg, setStatusMsg] = useState("");
  const [pendingQueueCount, setPendingQueueCount] = useState(0);

  useEffect(() => {
    if (isOpen) {
      if (typeof getSupabaseConfig === "function") setCfg(getSupabaseConfig());
      setStatus("idle");
      setStatusMsg("");
      if (typeof getOfflineQueue === "function") {
        setPendingQueueCount(getOfflineQueue().length);
      }
    }
  }, [isOpen]);

  if (!isOpen) return null;

  const handleTestAndSave = async () => {
    setStatus("testing");
    setStatusMsg("Connecting to Supabase...");
    try {
      if (typeof saveSupabaseConfig === "function") saveSupabaseConfig(cfg.url, cfg.key);
      const client = typeof resetSupabaseClient === "function" ? resetSupabaseClient() : null;
      if (!client) {
        throw new Error("Please enter both Supabase Project URL and Anon Public Key.");
      }
      const { error } = await client.from("profiles").select("id").limit(1);
      if (error && error.code !== "PGRST116") {
        console.warn("Supabase test warning:", error);
      }
      setStatus("success");
      setStatusMsg("Connected successfully to Supabase! Live sync active.");
      setTimeout(() => {
        onClose();
        if (typeof window !== "undefined") window.location.reload();
      }, 900);
    } catch (e) {
      setStatus("error");
      setStatusMsg(e.message || "Failed to connect to Supabase.");
    }
  };

  const handleFlushQueue = async () => {
    if (typeof flushOfflineQueue === "function") await flushOfflineQueue();
    if (typeof getOfflineQueue === "function") {
      const q = getOfflineQueue();
      setPendingQueueCount(q.length);
      setStatusMsg(`Queue synchronized! ${q.length} items remaining.`);
    }
  };

  return (
    <div style={{
      position: "fixed",
      inset: 0,
      background: "rgba(38, 53, 74,0.65)",
      backdropFilter: "blur(12px)",
      WebkitBackdropFilter: "blur(12px)",
      zIndex: 999999,
      display: "flex",
      alignItems: "center",
      justifyContent: "center",
      padding: 18,
      fontFamily: "'Space Grotesk', ui-sans-serif, system-ui, sans-serif",
    }}>
      <div style={{
        background: "#EAF2FF",
        border: "1.5px solid #DCE5F2",
        borderRadius: 24,
        padding: 24,
        maxWidth: 440,
        width: "100%",
        boxShadow: "0 20px 60px rgba(38, 53, 74,0.18)",
        color: "#26354A",
      }}>
        <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 18 }}>
          <div style={{ display: "flex", alignItems: "center", gap: 10 }}>
            <div style={{ width: 34, height: 34, borderRadius: 10, background: "#FFFFFF", border: "1px solid #DCE5F2", display: "flex", alignItems: "center", justifyContent: "center", fontSize: 18 }}>
              ⚡
            </div>
            <div>
              <h3 style={{ margin: 0, fontSize: 17, fontWeight: 900 }}>Supabase Cloud Database</h3>
              <p style={{ margin: 0, fontSize: 11, color: "#64748B" }}>Persistent storage & authentication</p>
            </div>
          </div>
          <button
            type="button"
            onClick={onClose}
            style={{ background: "transparent", border: "none", color: "#64748B", fontSize: 22, cursor: "pointer", padding: "4px 8px" }}
          >
            ✕
          </button>
        </div>

        <div style={{ display: "flex", flexDirection: "column", gap: 14 }}>
          <div>
            <label style={{ fontSize: 11, fontWeight: 800, color: "#64748B", display: "block", marginBottom: 6, textTransform: "uppercase", letterSpacing: 1 }}>
              Supabase Project URL
            </label>
            <input
              type="text"
              value={cfg.url}
              onChange={(e) => setCfg({ ...cfg, url: e.target.value })}
              placeholder="https://xyzcompany.supabase.co"
              style={{
                width: "100%",
                padding: "12px 14px",
                borderRadius: 14,
                background: "#FFFFFF",
                border: "1.5px solid #DCE5F2",
                color: "#26354A",
                fontSize: 13,
                outline: "none",
                fontFamily: "monospace",
              }}
            />
          </div>

          <div>
            <label style={{ fontSize: 11, fontWeight: 800, color: "#64748B", display: "block", marginBottom: 6, textTransform: "uppercase", letterSpacing: 1 }}>
              Supabase Anon Public Key
            </label>
            <textarea
              rows={3}
              value={cfg.key}
              onChange={(e) => setCfg({ ...cfg, key: e.target.value })}
              placeholder="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
              style={{
                width: "100%",
                padding: "12px 14px",
                borderRadius: 14,
                background: "#FFFFFF",
                border: "1.5px solid #DCE5F2",
                color: "#26354A",
                fontSize: 12,
                outline: "none",
                fontFamily: "monospace",
                resize: "none",
              }}
            />
          </div>

          {statusMsg && (
            <div style={{
              padding: "10px 14px",
              borderRadius: 12,
              fontSize: 12.5,
              fontWeight: 600,
              background: status === "success" ? "rgba(16,185,129,0.12)" : status === "error" ? "rgba(239,68,68,0.12)" : "rgba(37,107,253,0.12)",
              color: status === "success" ? "#10B981" : status === "error" ? "#EF4444" : "#3B82F6",
              border: `1px solid ${status === "success" ? "rgba(16,185,129,0.3)" : status === "error" ? "rgba(239,68,68,0.3)" : "rgba(37,107,253,0.3)"}`,
            }}>
              {statusMsg}
            </div>
          )}

          <div style={{ display: "flex", gap: 10, marginTop: 4 }}>
            <button
              type="button"
              onClick={handleTestAndSave}
              disabled={status === "testing"}
              style={{
                flex: 1,
                padding: "13px 0",
                borderRadius: 14,
                background: "linear-gradient(135deg, #3678F5 0%, #2B62D9 100%)",
                color: "#FFFFFF",
                border: "none",
                fontSize: 13,
                fontWeight: 800,
                cursor: status === "testing" ? "not-allowed" : "pointer",
              }}
            >
              {status === "testing" ? "Testing..." : "Test & Save Connection"}
            </button>
          </div>

          <div style={{
            marginTop: 8,
            padding: 12,
            borderRadius: 14,
            background: "rgba(255,255,255,0.03)",
            border: "1px solid rgba(255,255,255,0.07)",
            fontSize: 11.5,
            color: "#64748B",
            lineHeight: 1.5,
          }}>
            <div><strong>Offline Sync Queue:</strong> {pendingQueueCount} pending changes</div>
            {pendingQueueCount > 0 && (
              <button
                type="button"
                onClick={handleFlushQueue}
                style={{
                  marginTop: 6,
                  background: "#256BFD",
                  color: "#FFF",
                  border: "none",
                  borderRadius: 6,
                  padding: "4px 10px",
                  fontSize: 10.5,
                  fontWeight: 700,
                  cursor: "pointer",
                }}
              >
                Sync Queue Now
              </button>
            )}
            <div style={{ marginTop: 6 }}>
              All 9 tables, Row Level Security policies, indexes, and Storage buckets are defined in <code>supabase_schema.sql</code>.
            </div>
          </div>
        </div>
      </div>
    </div>
  );
}

/* ─── INTERACTIVE DAY SELECTOR WITH SUPABASE HISTORY & CALENDAR PICKER ─── */
function DaySelector({ selectedDate, onSelectDate }) {
  const todayStr = typeof getLocalDateStr === "function" ? getLocalDateStr() : new Date().toISOString().split("T")[0];
  const activeDate = selectedDate || todayStr;
  const dateInputRef = useRef(null);

  const days = [];
  const curr = new Date();
  for (let i = 6; i >= 0; i--) {
    const d = new Date(curr.getTime() - i * 86400000);
    const dateStr = typeof getLocalDateStr === "function" ? getLocalDateStr(d) : d.toISOString().split("T")[0];
    const dow = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"][d.getDay()];
    const dayNum = d.getDate();
    days.push({ dateStr, dow, dayNum, isToday: dateStr === todayStr });
  }

  const isViewingPast = activeDate !== todayStr;
  const isCustomHistoricalDate = !days.some((d) => d.dateStr === activeDate);

  return (
    <div style={{ marginBottom: 14 }}>
      <div style={{ display: "flex", alignItems: "center", justifyContent: "space-between", gap: 5 }}>
        {days.map((d) => {
          const isSelected = d.dateStr === activeDate;
          return (
            <button
              key={d.dateStr}
              type="button"
              onClick={() => onSelectDate && onSelectDate(d.dateStr)}
              style={{
                flex: 1,
                display: "flex",
                flexDirection: "column",
                alignItems: "center",
                gap: 4,
                padding: "8px 0",
                background: isSelected ? "#EAF2FF" : "#FFFFFF",
                border: isSelected ? "1.5px solid #3678F5" : d.isToday ? "1.5px dashed #3678F5" : "1px solid #DCE5F2",
                borderRadius: 14,
                cursor: "pointer",
                transition: "all 0.15s ease",
              }}
            >
              <span style={{ fontSize: 10, color: isSelected ? "#3678F5" : "#64748B", fontWeight: 700 }}>
                {d.dow}
              </span>
              <span style={{
                width: 26,
                height: 26,
                borderRadius: "50%",
                background: isSelected ? "#3678F5" : "transparent",
                color: isSelected ? "#FFFFFF" : d.isToday ? "#3678F5" : "#26354A",
                display: "flex",
                alignItems: "center",
                justifyContent: "center",
                fontSize: 12,
                fontWeight: 800,
                boxShadow: isSelected ? "0 2px 8px rgba(54,120,245,0.3)" : "none",
              }}>
                {d.dayNum}
              </span>
            </button>
          );
        })}

        {/* Calendar Picker button to select any past date */}
        <div style={{ position: "relative" }}>
          <button
            type="button"
            title="Select date from calendar"
            onClick={() => {
              if (dateInputRef.current) {
                if (typeof dateInputRef.current.showPicker === "function") {
                  dateInputRef.current.showPicker();
                } else {
                  dateInputRef.current.click();
                }
              }
            }}
            style={{
              display: "flex",
              flexDirection: "column",
              alignItems: "center",
              justifyContent: "center",
              padding: "7px 9px",
              background: isCustomHistoricalDate ? "rgba(37,107,253,0.25)" : "rgba(255,255,255,0.03)",
              border: isCustomHistoricalDate ? "1.5px solid #256BFD" : "1px solid rgba(255,255,255,0.08)",
              borderRadius: 14,
              cursor: "pointer",
              gap: 3
            }}
          >
            <span style={{ fontSize: 12 }}>📅</span>
            <span style={{ fontSize: 9, color: isCustomHistoricalDate ? "#3B82F6" : TOKENS.mutedFaint, fontWeight: 700 }}>
              Cal
            </span>
          </button>
          <input
            ref={dateInputRef}
            type="date"
            max={todayStr}
            value={activeDate}
            onChange={(e) => {
              if (e.target.value) onSelectDate && onSelectDate(e.target.value);
            }}
            style={{
              position: "absolute",
              opacity: 0,
              pointerEvents: "none",
              width: 1,
              height: 1,
              bottom: 0,
              left: 0
            }}
          />
        </div>
      </div>

      {isViewingPast && (
        <div style={{
          display: "flex",
          alignItems: "center",
          justifyContent: "space-between",
          marginTop: 8,
          padding: "6px 12px",
          borderRadius: 10,
          background: "rgba(37,107,253,0.12)",
          border: "1px solid rgba(37,107,253,0.3)",
        }}>
          <div style={{ display: "flex", alignItems: "center", gap: 6 }}>
            <span style={{ fontSize: 12 }}>📅</span>
            <span style={{ fontSize: 11, color: "#3B82F6", fontWeight: 700 }}>
              Viewing records for {activeDate} (Supabase)
            </span>
          </div>
          <button
            type="button"
            onClick={() => onSelectDate && onSelectDate(todayStr)}
            style={{
              background: "#256BFD",
              color: "#FFF",
              border: "none",
              borderRadius: 6,
              padding: "4px 10px",
              fontSize: 10.5,
              fontWeight: 800,
              cursor: "pointer",
            }}
          >
            Today
          </button>
        </div>
      )}
    </div>
  );
}

function MiniMacroCard({ label, value, goal, color }) {
  const pct = Math.min(100, (value / goal) * 100);
  return (
    <div style={{ flex: 1 }}>
      <div style={{ fontSize: 11, color: TOKENS.mutedFaint, marginBottom: 4 }}>{label}</div>
      <div style={{ fontSize: 15, fontWeight: 700, color: TOKENS.text, marginBottom: 6 }}>
        {Math.round(value)}g <span style={{ fontSize: 11, color: TOKENS.mutedFaint, fontWeight: 400 }}>/ {goal}</span>
      </div>
      <div style={{ height: 4, background: TOKENS.surface2, borderRadius: 2, overflow: "hidden" }}>
        <div style={{ height: "100%", width: `${pct}%`, background: color, borderRadius: 2 }} />
      </div>
    </div>
  );
}

function NutritionScreen({ meals, mealSlots, addMealSlot, removeMealSlot, water, setWater, addItem, removeItem, totals, calPct, goals, onBack, onNavigate, selectedDate, onSelectDate }) {
  const [newMealName, setNewMealName] = useState("");
  const addMealInputRef = useRef(null);

  function handleAddSlot() {
    if (!newMealName.trim()) return;
    addMealSlot(newMealName.trim());
    setNewMealName("");
  }

  function handleFabClick() {
    addMealInputRef.current?.scrollIntoView({ behavior: "smooth", block: "center" });
    addMealInputRef.current?.focus();
  }

  const kcalLeft = Math.max(0, Math.round(goals.calories - totals.calories));

  return (
    <div>
      <ScreenHeader
        title="Today's fuel"
        subtitle="Nutrition"
        onBack={onBack}
        canGoBack={true}
      />

      <DaySelector selectedDate={selectedDate} onSelectDate={onSelectDate} />

      <div style={{ background: TOKENS.surface, backdropFilter: "blur(16px) saturate(180%)", WebkitBackdropFilter: "blur(16px) saturate(180%)", border: `1px solid ${TOKENS.border}`, borderRadius: 18, padding: "18px 20px", marginBottom: 12, boxShadow: CARD_SHADOW }}>
        <div style={{ fontSize: 12, color: TOKENS.mutedFaint, marginBottom: 8 }}>Calories</div>
        <div style={{ display: "flex", justifyContent: "space-between", alignItems: "baseline", marginBottom: 10 }}>
          <div style={{ fontSize: 24, fontWeight: 700, color: TOKENS.text }}>
            {Math.round(totals.calories)} <span style={{ fontSize: 13, color: TOKENS.mutedFaint, fontWeight: 400 }}>/ {goals.calories}</span>
          </div>
          <div style={{ fontSize: 14, fontWeight: 700, color: TOKENS.ember }}>{kcalLeft} <span style={{ fontSize: 11, color: TOKENS.mutedFaint, fontWeight: 500 }}>left</span></div>
        </div>
        <div style={{ height: 6, background: TOKENS.surface2, borderRadius: 3, overflow: "hidden" }}>
          <div style={{ height: "100%", width: `${Math.min(100, calPct * 100)}%`, background: TOKENS.ember, borderRadius: 3 }} />
        </div>
      </div>

      <div style={{ background: TOKENS.surface, backdropFilter: "blur(16px) saturate(180%)", WebkitBackdropFilter: "blur(16px) saturate(180%)", border: `1px solid ${TOKENS.border}`, borderRadius: 18, padding: "18px 20px", marginBottom: 18, display: "flex", gap: 18, boxShadow: CARD_SHADOW }}>
        <MiniMacroCard label="Carbs" value={totals.carbs} goal={goals.carbs} color={TOKENS.carbs} />
        <MiniMacroCard label="Fat" value={totals.fat} goal={goals.fat} color={TOKENS.fat} />
        <MiniMacroCard label="Protein" value={totals.protein} goal={goals.protein} color={TOKENS.protein} />
        <MiniMacroCard label="Fibre" value={totals.fiber} goal={goals.fiber} color={TOKENS.fiber} />
      </div>
      <div style={{ background: TOKENS.surface, backdropFilter: "blur(16px) saturate(180%)", WebkitBackdropFilter: "blur(16px) saturate(180%)", border: `1px solid ${TOKENS.border}`, borderRadius: 14, padding: "14px 18px", marginBottom: 22, display: "flex", alignItems: "center", justifyContent: "space-between", boxShadow: CARD_SHADOW }}>
        <div>
          <div style={{ fontSize: 13, color: TOKENS.muted, fontWeight: 500 }}>💧 Water</div>
          <div style={{ fontSize: 18, fontWeight: 700, color: TOKENS.text }}>{Math.max(0, Math.min(10, Number(water) || 0)).toFixed(1)}L <span style={{ fontSize: 13, color: TOKENS.mutedFaint, fontWeight: 400 }}>/ {goals.water}L</span></div>
        </div>
        <div style={{ display: "flex", gap: 8 }}>
          <button onClick={() => setWater((w) => Math.max(0, Math.round(((Number(w) || 0) - 0.25) * 100) / 100))} style={waterBtnStyle}>−</button>
          <button onClick={() => setWater((w) => Math.min(10, Math.round(((Number(w) || 0) + 0.25) * 100) / 100))} style={waterBtnStyle}>+</button>
        </div>
      </div>
      {mealSlots.map((slot) => (
        <MealSection
          key={slot.key}
          mealKey={slot.key}
          label={slot.label}
          items={meals[slot.key] || []}
          onAdd={(item) => addItem(slot.key, item)}
          onRemove={(idx) => removeItem(slot.key, idx)}
          onRemoveSlot={mealSlots.length > 1 ? () => removeMealSlot(slot.key) : null}
        />
      ))}

      <div style={{ background: TOKENS.surface2, backdropFilter: "blur(16px) saturate(180%)", WebkitBackdropFilter: "blur(16px) saturate(180%)", border: `1px dashed ${TOKENS.border}`, borderRadius: 14, padding: 16, marginTop: 4 }}>
        <label style={{ fontSize: 11, color: TOKENS.mutedFaint, display: "block", marginBottom: 6 }}>Add a custom meal</label>
        <div style={{ display: "flex", gap: 8 }}>
          <input
            ref={addMealInputRef}
            value={newMealName}
            onChange={(e) => setNewMealName(e.target.value)}
            onKeyDown={(e) => e.key === "Enter" && handleAddSlot()}
            placeholder="e.g. Late Night Snack"
            style={{ flex: 1, background: TOKENS.bg, border: `1px solid ${TOKENS.border}`, borderRadius: 8, padding: "9px 12px", color: TOKENS.text, fontSize: 14, boxSizing: "border-box" }}
          />
          <button onClick={handleAddSlot} style={{ background: "#111111", color: "#FFFFFF", border: "none", borderRadius: 8, padding: "0 18px", fontSize: 13, fontWeight: 700, cursor: "pointer" }}>
            + Add
          </button>
        </div>
      </div>

      <button
        onClick={handleFabClick}
        aria-label="Quick add"
        style={{
          position: "fixed",
          right: 20,
          bottom: 86,
          width: 52,
          height: 52,
          borderRadius: "50%",
          background: TOKENS.ember,
          color: "#0B0E13",
          border: "none",
          fontSize: 26,
          fontWeight: 700,
          cursor: "pointer",
          boxShadow: "0 6px 18px rgba(37, 107, 253,0.35)",
          zIndex: 40,
        }}
      >
        +
      </button>
    </div>
  );
}

const waterBtnStyle = { width: 34, height: 34, borderRadius: "50%", border: "none", background: "#161616", color: TOKENS.text, fontSize: 18, cursor: "pointer", display: "flex", alignItems: "center", justifyContent: "center",
  boxShadow: "4px 4px 8px rgba(0,0,0,0.6), -4px -4px 8px rgba(255,255,255,0.04)" };

/* ============================================================
   UPGRADED WORKOUT SCREEN WITH HORIZONTAL SCROLL & PERSONALIZATION
   ============================================================ */

/* ============================================================
   UPGRADED WORKOUT SCREEN WITH HORIZONTAL SCROLL & PERSONALIZATION
   ============================================================ */

function WorkoutScreen({ week, programKey, onProgramChange, activeDay, setActiveDay, logs, updateSet, addSet, toggleComplete, onNavigate, onBack, profile }) {
  const day = week[activeDay] || { label: "Workout", rest: false, exercises: [] };
  const dayLog = logs[activeDay] || {};

  const isHomeWorkout = programKey === "Home Workout" || (programKey && programKey.includes("Home"));

  // Personalization settings
  const [showPersonalize, setShowPersonalize] = useState(false);
  const [activeModalExerciseIndex, setActiveModalExerciseIndex] = useState(null);
  const [userLevel, setUserLevel] = useState(() => {
    try {
      return localStorage.getItem("stoke_user_level") || (profile && profile.level) || "Intermediate";
    } catch (e) { return "Intermediate"; }
  });
  const [userGoal, setUserGoal] = useState(() => {
    try {
      return localStorage.getItem("stoke_user_goal") || (profile && profile.goal) || (profile && profile.goalType) || "Build Muscle";
    } catch (e) { return "Build Muscle"; }
  });
  const [userDuration, setUserDuration] = useState(() => {
    try {
      return localStorage.getItem("stoke_user_duration") || "30 Mins";
    } catch (e) { return "30 Mins"; }
  });
  const [userDays, setUserDays] = useState(() => {
    try {
      return localStorage.getItem("stoke_user_days") || "5 Days";
    } catch (e) { return "5 Days"; }
  });

  const athleteName = (profile && profile.name) ? profile.name.trim().split(" ")[0] : "Athlete";
  const athleteAge = (profile && profile.age) ? profile.age : 25;

  const handleSavePersonalization = (level, goal, duration, days) => {
    setUserLevel(level);
    setUserGoal(goal);
    setUserDuration(duration);
    setUserDays(days);
    if (typeof localStorage !== "undefined") {
      try {
        localStorage.setItem("stoke_user_level", level);
        localStorage.setItem("stoke_user_goal", goal);
        localStorage.setItem("stoke_user_duration", duration);
        localStorage.setItem("stoke_user_days", days);
      } catch (e) {}
    }
  };

  // Filter exercises based on personalized duration
  let displayedExercises = day.exercises || [];
  if (userDuration === "15 Mins") {
    displayedExercises = displayedExercises.slice(0, 3);
  } else if (userDuration === "30 Mins") {
    displayedExercises = displayedExercises.slice(0, 5);
  }

  // Adjust sets based on level
  const targetSetsOverride = userLevel === "Beginner" ? 2 : userLevel === "Advanced" ? 4 : null;
  const processedExercises = displayedExercises.map((ex) => {
    if (targetSetsOverride) {
      return { ...ex, targetSets: targetSetsOverride };
    }
    return ex;
  });

  // Calculate day completion
  const completedCount = processedExercises.filter((ex) => dayLog[ex.name]?.completed).length;

  return (
    <div>
      <ScreenHeader
        title={programKey}
        subtitle="Workout Routine"
        onBack={onBack}
        canGoBack={true}
        rightAction={
          <button
            type="button"
            onClick={() => setShowPersonalize(!showPersonalize)}
            style={{
              background: showPersonalize ? "rgba(37,107,253,0.2)" : "rgba(255,255,255,0.06)",
              border: showPersonalize ? "1px solid #256BFD" : "1px solid rgba(255,255,255,0.12)",
              borderRadius: 999,
              padding: "6px 12px",
              color: showPersonalize ? "#60A5FA" : "rgba(255,255,255,0.8)",
              fontSize: 11.5,
              fontWeight: 800,
              cursor: "pointer",
              display: "flex",
              alignItems: "center",
              gap: 5
            }}
          >
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.2" strokeLinecap="round" strokeLinejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
            <span>Personalize</span>
          </button>
        }
      />
      {/* Top Segmented Bar: Workout | Run */}
      <div style={{ display: "flex", background: "#EAF2FF", borderRadius: 14, padding: 3, marginBottom: 14, border: "1px solid #DCE5F2" }}>
        <button
          type="button"
          style={{
            flex: 1,
            padding: "9px 0",
            borderRadius: 11,
            border: "none",
            background: "linear-gradient(135deg, #3678F5 0%, #2B62D9 100%)",
            color: "#FFFFFF",
            fontWeight: 800,
            fontSize: 12.5,
            cursor: "pointer",
            display: "flex",
            alignItems: "center",
            justifyContent: "center",
            gap: 6,
            boxShadow: "0 2px 10px rgba(37,107,253,0.35)"
          }}
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
            <circle cx="5" cy="12" r="2.2" />
            <circle cx="19" cy="12" r="2.2" />
            <line x1="7.2" y1="12" x2="16.8" y2="12" />
            <line x1="5" y1="9.3" x2="5" y2="14.7" />
            <line x1="19" y1="9.3" x2="19" y2="14.7" />
          </svg>
          <span>Workout Plan</span>
        </button>
        <button
          type="button"
          onClick={() => onNavigate && onNavigate("run")}
          style={{
            flex: 1,
            padding: "9px 0",
            borderRadius: 11,
            border: "none",
            background: "transparent",
            color: "#64748B",
            fontWeight: 700,
            fontSize: 12.5,
            cursor: "pointer",
            display: "flex",
            alignItems: "center",
            justifyContent: "center",
            gap: 6,
            transition: "all 0.2s ease"
          }}
          onMouseEnter={(e) => { e.currentTarget.style.color = "#3B82F6"; }}
          onMouseLeave={(e) => { e.currentTarget.style.color = "rgba(255,255,255,0.6)"; }}
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
            <circle cx="15.5" cy="5" r="1.8" />
            <path d="M9 20l2.5-5.5 2 1.8 3.5-1" />
            <path d="M7 13.5l3.5-2.5 2 2.5-2.5 3.5" />
          </svg>
          <span>Run & GPS</span>
        </button>
      </div>

      <div style={{ display: "flex", justifyContent: "space-between", alignItems: "flex-end", marginBottom: 14 }}>
        <div>
          <div style={{ fontSize: 12, color: TOKENS.mutedFaint, letterSpacing: 0.5 }}>This week</div>
          <h1 style={{ margin: "2px 0 0", fontSize: 24, fontWeight: 800, color: TOKENS.text, letterSpacing: -0.5 }}>
            {isHomeWorkout ? "Home Workout" : "Workout plan"}
          </h1>
        </div>

        {/* Personalization Quick Badge */}
        <button
          onClick={() => setShowPersonalize(!showPersonalize)}
          style={{
            background: showPersonalize ? "rgba(37,107,253,0.2)" : "rgba(255,255,255,0.06)",
            border: `1px solid ${showPersonalize ? "#256BFD" : "rgba(255,255,255,0.12)"}`,
            borderRadius: 10,
            padding: "6px 10px",
            color: showPersonalize ? "#60A5FA" : "rgba(255,255,255,0.8)",
            fontSize: 11,
            fontWeight: 800,
            cursor: "pointer",
            display: "flex",
            alignItems: "center",
            gap: 5
          }}
        >
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
          </svg>
          <span>Personalize</span>
        </button>
      </div>

      {/* ── PERSONALIZATION DRAWER ── */}
      {showPersonalize && (
        <div style={{
          background: "#EAF2FF",
          border: "1.5px solid #DCE5F2",
          borderRadius: 16,
          padding: "14px 16px",
          marginBottom: 16,
          boxShadow: "0 4px 16px rgba(38, 53, 74,0.08)"
        }}>
          <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 10 }}>
            <div>
              <div style={{ fontSize: 13, fontWeight: 900, color: "#26354A" }}>Personalized Plan Generator</div>
              <div style={{ fontSize: 11, color: "#64748B" }}>Athlete: {athleteName} · Age {athleteAge}</div>
            </div>
            <button
              onClick={() => setShowPersonalize(false)}
              style={{ background: "none", border: "none", color: "#64748B", cursor: "pointer", padding: 4 }}
              aria-label="Close"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"/>
                <line x1="6" y1="6" x2="18" y2="18"/>
              </svg>
            </button>
          </div>

          <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 10, marginBottom: 12 }}>
            <div>
              <label style={{ fontSize: 10.5, color: "#64748B", fontWeight: 800, display: "block", marginBottom: 4 }}>FITNESS LEVEL</label>
              <select
                value={userLevel}
                onChange={(e) => handleSavePersonalization(e.target.value, userGoal, userDuration, userDays)}
                style={{ width: "100%", background: "#FFFFFF", border: "1.5px solid #DCE5F2", borderRadius: 8, padding: "7px 10px", color: "#26354A", fontSize: 12, fontWeight: 700, outline: "none" }}
              >
                <option value="Beginner">Beginner (Gentle / 2 sets)</option>
                <option value="Intermediate">Intermediate (Standard / 3 sets)</option>
                <option value="Advanced">Advanced (High Intensity / 4 sets)</option>
              </select>
            </div>

            <div>
              <label style={{ fontSize: 10.5, color: "#64748B", fontWeight: 800, display: "block", marginBottom: 4 }}>PRIMARY GOAL</label>
              <select
                value={userGoal}
                onChange={(e) => handleSavePersonalization(userLevel, e.target.value, userDuration, userDays)}
                style={{ width: "100%", background: "#FFFFFF", border: "1.5px solid #DCE5F2", borderRadius: 8, padding: "7px 10px", color: "#26354A", fontSize: 12, fontWeight: 700, outline: "none" }}
              >
                <option value="Build Muscle">Build Muscle</option>
                <option value="Lose Fat">Tone & Fat Loss</option>
                <option value="Get Stronger">Get Stronger</option>
                <option value="Mobility & Longevity">Mobility & Health</option>
              </select>
            </div>

            <div>
              <label style={{ fontSize: 10.5, color: "#64748B", fontWeight: 800, display: "block", marginBottom: 4 }}>DURATION</label>
              <select
                value={userDuration}
                onChange={(e) => handleSavePersonalization(userLevel, userGoal, e.target.value, userDays)}
                style={{ width: "100%", background: "#FFFFFF", border: "1.5px solid #DCE5F2", borderRadius: 8, padding: "7px 10px", color: "#26354A", fontSize: 12, fontWeight: 700, outline: "none" }}
              >
                <option value="15 Mins">15 Mins (Express Routine)</option>
                <option value="30 Mins">30 Mins (Standard Focus)</option>
                <option value="45 Mins">45 Mins (Full Session)</option>
              </select>
            </div>

            <div>
              <label style={{ fontSize: 10.5, color: "#64748B", fontWeight: 800, display: "block", marginBottom: 4 }}>DAYS PER WEEK</label>
              <select
                value={userDays}
                onChange={(e) => handleSavePersonalization(userLevel, userGoal, userDuration, e.target.value)}
                style={{ width: "100%", background: "#FFFFFF", border: "1.5px solid #DCE5F2", borderRadius: 8, padding: "7px 10px", color: "#26354A", fontSize: 12, fontWeight: 700, outline: "none" }}
              >
                <option value="3 Days">3 Days (Mon / Wed / Fri)</option>
                <option value="4 Days">4 Days (Mon / Tue / Thu / Fri)</option>
                <option value="5 Days">5 Days (Weekdays)</option>
                <option value="6 Days">6 Days (Full Split)</option>
              </select>
            </div>
          </div>

          <div style={{ fontSize: 11, color: "#60A5FA", fontWeight: 700, display: "flex", alignItems: "center", gap: 5 }}>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#60A5FA" strokeWidth="3" strokeLinecap="round" strokeLinejoin="round">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
            <span>Plan calibrated for {athleteName}: {userLevel} · {userGoal} · {userDuration}</span>
          </div>
        </div>
      )}

      {/* ── PROGRAM SELECTOR (HORIZONTALLY SCROLLABLE WITH REQUIRED ORDER) ── */}
      <div style={{ marginBottom: 14 }}>
        <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 6 }}>
          <label style={{ fontSize: 11, color: TOKENS.mutedFaint, display: "block", fontWeight: 700, textTransform: "uppercase" }}>Program</label>
          <span style={{ fontSize: 10.5, color: "rgba(255,255,255,0.4)" }}>← Scroll to explore →</span>
        </div>

        <div style={{
          display: "flex",
          gap: 8,
          overflowX: "auto",
          paddingBottom: 6,
          WebkitOverflowScrolling: "touch",
          scrollbarWidth: "none"
        }}>
          {PROGRAM_NAMES.map((name) => {
            const active = name === programKey;
            return (
              <button
                key={name}
                onClick={() => onProgramChange(name)}
                style={{
                  flex: "0 0 auto",
                  padding: "9px 15px",
                  borderRadius: 12,
                  border: active ? "1.5px solid #3678F5" : "1px solid #DCE5F2",
                  background: active ? "linear-gradient(135deg, #3678F5 0%, #2B62D9 100%)" : "#FFFFFF",
                  color: active ? "#FFFFFF" : "#64748B",
                  fontSize: 12.5,
                  fontWeight: active ? 800 : 600,
                  cursor: "pointer",
                  whiteSpace: "nowrap",
                  boxShadow: active ? "0 2px 12px rgba(37,107,253,0.4)" : "none",
                  transition: "all 0.15s ease"
                }}
              >
                {name}
              </button>
            );
          })}
        </div>
      </div>

      {/* Special Home Workout Banner */}
      {isHomeWorkout && (
        <div style={{
          background: "linear-gradient(135deg, rgba(46,212,191,0.12) 0%, rgba(37,107,253,0.08) 100%)",
          border: "1px solid rgba(46,212,191,0.3)",
          borderRadius: 14,
          padding: "10px 14px",
          marginBottom: 14,
          display: "flex",
          alignItems: "center",
          gap: 12
        }}>
          <div style={{ width: 36, height: 36, borderRadius: 10, background: "rgba(46,212,191,0.2)", display: "flex", alignItems: "center", justifyContent: "center", color: "#2ED4BF", flexShrink: 0 }}>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
              <polyline points="9 22 9 12 15 12 15 22"/>
            </svg>
          </div>
          <div>
            <div style={{ fontSize: 13, fontWeight: 900, color: "#2ED4BF" }}>
              Home Workout
            </div>
            <div style={{ fontSize: 11, color: "rgba(255,255,255,0.7)", marginTop: 1 }}>
              100% Bodyweight Home Routine · Zero equipment needed · Shorts tutorials & voice coach
            </div>
          </div>
        </div>
      )}

      {/* Days of Week Selector */}
      <div style={{ display: "flex", gap: 6, marginBottom: 16, overflowX: "auto", paddingBottom: 2 }}>
        {DAY_ORDER.map((d) => {
          const isActive = d === activeDay;
          const dRest = week[d]?.rest;
          const dExercises = week[d]?.exercises || [];
          const dCompleted = !dRest && dExercises.length > 0 && dExercises.every((ex) => logs[d]?.[ex.name]?.completed);
          return (
            <button
              key={d}
              onClick={() => setActiveDay(d)}
              style={{
                flex: "0 0 auto",
                padding: "8px 14px",
                borderRadius: 10,
                border: isActive ? "1.5px solid #3678F5" : "1px solid #DCE5F2",
                background: isActive ? "linear-gradient(135deg, #3678F5 0%, #2B62D9 100%)" : "#EAF2FF",
                color: isActive ? "#FFFFFF" : dRest ? TOKENS.mutedFaint : "#26354A",
                fontSize: 13,
                fontWeight: 700,
                cursor: "pointer",
                position: "relative",
                boxShadow: isActive ? "0 2px 10px rgba(37,107,253,0.35)" : "none"
              }}
            >
              {d}
              {dCompleted && !isActive && (
                <span style={{ position: "absolute", top: -4, right: -4, width: 14, height: 14, borderRadius: "50%", background: "#2ED4BF", display: "flex", alignItems: "center", justifyContent: "center", color: "#000000" }}>
                  <svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="3.5" strokeLinecap="round" strokeLinejoin="round">
                    <polyline points="20 6 9 17 4 12"/>
                  </svg>
                </span>
              )}
            </button>
          );
        })}
      </div>

      {/* Day Overview Banner */}
      <div style={{
        background: TOKENS.surface,
        backdropFilter: "blur(16px) saturate(180%)",
        WebkitBackdropFilter: "blur(16px) saturate(180%)",
        border: `1px solid ${TOKENS.border}`,
        borderRadius: 14,
        padding: "14px 18px",
        marginBottom: 14,
        display: "flex",
        justifyContent: "space-between",
        alignItems: "center",
        boxShadow: CARD_SHADOW
      }}>
        <div>
          <div style={{ fontSize: 17, fontWeight: 800, color: TOKENS.text }}>{day.label}</div>
          {!day.rest && (
            <div style={{ fontSize: 12, color: TOKENS.mutedFaint, marginTop: 2 }}>
              {completedCount} / {processedExercises.length} exercises completed
            </div>
          )}
        </div>
        {!day.rest && <SmallRing pct={completedCount / Math.max(1, processedExercises.length)} color={TOKENS.ember} />}
      </div>

      {/* Exercises List */}
      {day.rest ? (
        <div style={{
          textAlign: "center",
          padding: "50px 20px",
          background: "#EAF2FF",
          border: "1.5px dashed #DCE5F2",
          borderRadius: 16,
          color: "#64748B",
          fontSize: 14
        }}>
          <div style={{ width: 48, height: 48, borderRadius: "50%", background: "rgba(46,212,191,0.15)", margin: "0 auto 12px", display: "flex", alignItems: "center", justifyContent: "center", color: "#2ED4BF" }}>
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
              <path d="M12 22v-8"/>
              <path d="M12 14c-4-4-4-10 0-12 4 2 4 8 0 12z"/>
              <path d="M12 14c4-4 4-10 0-12-4 2-4 8 0 12z"/>
            </svg>
          </div>
          <div style={{ fontWeight: 800, color: "#26354A", marginBottom: 4 }}>Rest & Recovery Day</div>
          <div>Focus on hydration, gentle walking, and nutrient-dense recovery meals.</div>
        </div>
      ) : (
        <>
          {processedExercises.map((ex, idx) => (
            <ExerciseCard
              key={ex.name}
              ex={ex}
              exerciseIndex={idx}
              allExercises={processedExercises}
              log={dayLog[ex.name]?.sets || []}
              completed={dayLog[ex.name]?.completed || false}
              workoutLabel={day.label}
              programKey={programKey}
              isHomeWorkout={isHomeWorkout}
              onOpenModal={(i) => setActiveModalExerciseIndex(i)}
              onSetChange={(i, field, val) => updateSet(ex.name, i, field, val)}
              onAddSet={() => addSet(ex.name)}
              onToggleComplete={() => toggleComplete(ex.name)}
            />
          ))}

          {/* Upgraded Full 3D Exercise Demonstration Screen Modal */}
          {activeModalExerciseIndex !== null && processedExercises[activeModalExerciseIndex] && (
            <ExerciseDetailModal
              ex={processedExercises[activeModalExerciseIndex]}
              exerciseIndex={activeModalExerciseIndex}
              allExercises={processedExercises}
              isHomeWorkout={isHomeWorkout}
              onClose={() => setActiveModalExerciseIndex(null)}
              onNavigateExercise={(newIdx) => setActiveModalExerciseIndex(newIdx)}
              onLogSet={(exName) => addSet(exName)}
              onToggleComplete={(exName) => toggleComplete(exName)}
              isCompleted={dayLog[processedExercises[activeModalExerciseIndex].name]?.completed || false}
            />
          )}
        </>      )}
    </div>
  );
}

