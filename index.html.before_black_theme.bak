          border: "1px solid #DCE5F2",
          borderRadius: 20,
          padding: "16px 14px",
          display: "flex",
          flexDirection: "column",
          justifyContent: "space-between",
          boxShadow: "0 2px 10px rgba(38, 53, 74, 0.08)",
          position: "relative",
          overflow: "hidden"
        }}
      >
        <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 6 }}>
          <div style={{ display: "flex", alignItems: "center", gap: 5 }}>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="#3678F5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <span style={{ fontSize: 10.5, fontWeight: 800, color: "#3678F5", textTransform: "uppercase", letterSpacing: 0.5 }}>Level {xpData.level}</span>
          </div>
          <span style={{ fontSize: 9.5, background: "rgba(54,120,245,0.15)", color: "#3678F5", padding: "2px 6px", borderRadius: 999, fontWeight: 800 }}>
