        { name: "Single-Arm Lat Pulldown", targetSets: 3, targetReps: 10 },
        { name: "T-Bar Row", targetSets: 3, targetReps: 10 },
        { name: "Chest-Supported Row", targetSets: 3, targetReps: 12 },
        { name: "Preacher Curl", targetSets: 3, targetReps: 12 },
        { name: "Cable Curl", targetSets: 3, targetReps: 12 },
        { name: "Rear Delt Row", targetSets: 2, targetReps: 15 },
      ],
      [
        { name: "Trap Bar Deadlift", targetSets: 3, targetReps: 6 },
        { name: "Neutral-Grip Pull-up", targetSets: 3, targetReps: 8 },
        { name: "Straight-Arm Pulldown", targetSets: 3, targetReps: 12 },
