              onClick={onOpenSportSheet}
              style={{
                width: 54,
                height: 54,
                borderRadius: "50%",
                background: "#242426",
                border: "1px solid rgba(255,255,255,0.1)",
                color: "#3678F5",
                display: "flex",
                alignItems: "center",
                justifyContent: "center",
                cursor: "pointer"
              }}
            >
              <SportIcon icon={sport.icon} size={24} color="#3678F5" />
            </button>
            <span style={{ fontSize: 11, fontWeight: 600, color: "#FFF", marginTop: 6, textAlign: "center", maxWidth: 80, overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" }}>
              {sport.name}
            </span>
          </div>

          {/* Center Start / Pause / Resume Button */}
          {status === "idle" && (
            <div style={{ display: "flex", flexDirection: "column", alignItems: "center" }}>
              <button
                onClick={onStart}
                style={{
                  width: 72,
                  height: 72,
                  borderRadius: "50%",
                  background: "linear-gradient(135deg, #3678F5 0%, #2563EB 100%)",
                  border: "none",
                  display: "flex",
                  alignItems: "center",
                  justifyContent: "center",
                  cursor: "pointer",
                  boxShadow: "0 0 26px rgba(54, 120, 245, 0.5)"
                }}
              >
                <svg width="26" height="26" viewBox="0 0 24 24" fill="#FFFFFF"><polygon points="6 4 20 12 6 20" /></svg>
              </button>
              <span style={{ fontSize: 12, fontWeight: 800, color: "#3678F5", marginTop: 6 }}>
                Start
              </span>
            </div>
          )}

          {status === "active" && (
            <div style={{ display: "flex", alignItems: "center", gap: 14 }}>
              <div style={{ display: "flex", flexDirection: "column", alignItems: "center" }}>
                <button
                  onClick={onPause}
                  style={{
                    width: 72,
                    height: 72,
                    borderRadius: "50%",
                    background: "linear-gradient(135deg, #3678F5 0%, #2563EB 100%)",
                    border: "none",
                    display: "flex",
                    alignItems: "center",
                    justifyContent: "center",
                    cursor: "pointer",
                    boxShadow: "0 0 26px rgba(54, 120, 245, 0.5)"
                  }}
                >
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="#FFFFFF"><rect x="6" y="4" width="4" height="16" rx="1"/><rect x="14" y="4" width="4" height="16" rx="1"/></svg>
                </button>
                <span style={{ fontSize: 12, fontWeight: 800, color: "#3678F5", marginTop: 6 }}>
                  Pause
                </span>
              </div>
              <div style={{ display: "flex", flexDirection: "column", alignItems: "center" }}>
                <button
                  onClick={onFinish}
                  style={{
                    width: 54,
                    height: 54,
                    borderRadius: "50%",
                    background: "#3A3A3C",
                    border: "1px solid rgba(255,255,255,0.15)",
                    display: "flex",
                    alignItems: "center",
                    justifyContent: "center",
                    cursor: "pointer"
                  }}
                >
                  <span style={{ fontSize: 22 }}>🏁</span>
                </button>
                <span style={{ fontSize: 11, fontWeight: 700, color: "#FFF", marginTop: 6 }}>
                  Finish
                </span>
              </div>
            </div>
          )}

          {status === "paused" && (
            <div style={{ display: "flex", alignItems: "center", gap: 12 }}>
              <div style={{ display: "flex", flexDirection: "column", alignItems: "center" }}>
                <button
                  onClick={onResume}
                  style={{
                    width: 66,
                    height: 66,
                    borderRadius: "50%",
                    background: "linear-gradient(135deg, #3678F5 0%, #2563EB 100%)",
                    border: "none",
                    display: "flex",
                    alignItems: "center",
                    justifyContent: "center",
                    cursor: "pointer"
                  }}
                >
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="#FFFFFF"><polygon points="6 4 20 12 6 20" /></svg>
                </button>
                <span style={{ fontSize: 11, fontWeight: 800, color: "#3678F5", marginTop: 6 }}>Resume</span>
              </div>
              <div style={{ display: "flex", flexDirection: "column", alignItems: "center" }}>
                <button
                  onClick={onFinish}
                  style={{
                    width: 52,
                    height: 52,
                    borderRadius: "50%",
                    background: "#3A3A3C",
                    border: "none",
                    display: "flex",
                    alignItems: "center",
                    justifyContent: "center",
                    cursor: "pointer"
                  }}
                >
                  <span style={{ fontSize: 20 }}>🏁</span>
                </button>
                <span style={{ fontSize: 11, fontWeight: 700, color: "#FFF", marginTop: 6 }}>Finish</span>
              </div>
              <div style={{ display: "flex", flexDirection: "column", alignItems: "center" }}>
                <button
                  onClick={onDiscard}
                  style={{
                    width: 44,
                    height: 44,
                    borderRadius: "50%",
                    background: "#242426",
                    border: "1px solid #FF453A",
                    color: "#FF453A",
                    display: "flex",
                    alignItems: "center",
                    justifyContent: "center",
                    cursor: "pointer",
                    fontSize: 16
                  }}
                >
                  ✕
                </button>
                <span style={{ fontSize: 10, fontWeight: 700, color: "#FF453A", marginTop: 6 }}>Discard</span>
              </div>
            </div>
          )}

          {/* Add a Sensor Button */}
          <div style={{ display: "flex", flexDirection: "column", alignItems: "center", width: 70 }}>
            <button
              onClick={onOpenSensorModal}
              style={{
                width: 54,
                height: 54,
                borderRadius: "50%",
                background: "#242426",
                border: "1px solid rgba(255,255,255,0.1)",
                color: "#EBEBF5",
                display: "flex",
                alignItems: "center",
                justifyContent: "center",
                cursor: "pointer"
              }}
            >
              <SportIcon icon="sensor" size={24} color="#EBEBF5" />
            </button>
            <span style={{ fontSize: 11, fontWeight: 600, color: "#FFF", marginTop: 6, textAlign: "center" }}>
              Add a sensor
            </span>
