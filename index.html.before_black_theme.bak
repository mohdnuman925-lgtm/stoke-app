          </span>
        </div>

        <div>
          <div style={{ fontSize: 15, fontWeight: 900, color: "#26354A", letterSpacing: -0.3 }}>
            {xpData.xp.toLocaleString()} <span style={{ fontSize: 11, color: "#64748B", fontWeight: 500 }}>/ {xpData.nextLevelThreshold.toLocaleString()} XP</span>
          </div>

          {/* High-tech Segmented Bar */}
          <div style={{ display: "flex", gap: 3, margin: "8px 0" }}>
            {Array.from({ length: totalBlocks }).map((_, idx) => {
              const isFilled = idx < filledBlocks;
              return (
                <div
                  key={idx}
                  style={{
                    flex: 1,
                    height: 8,
                    borderRadius: 2,
                    background: isFilled ? "linear-gradient(180deg, #3678F5 0%, #2B62D9 100%)" : "#DCE5F2",
                    boxShadow: isFilled ? "0 0 4px rgba(54,120,245,0.3)" : "none",
                    transition: "all 0.3s ease"
                  }}
                />
              );
            })}
          </div>

          <div style={{ fontSize: 10.5, color: "#64748B", fontWeight: 600 }}>
            {xpData.xpUntilNext.toLocaleString()} XP until Level {xpData.level + 1}
          </div>
        </div>

        <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginTop: 4, paddingTop: 6, borderTop: "1px solid #DCE5F2" }}>
          <span style={{ fontSize: 10, color: "#64748B" }}>Workouts +100 · Runs +50</span>
        </div>
      </div>
    </div>
  );
}

