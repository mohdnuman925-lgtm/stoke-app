<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <title>Stoke ⚡ — Fitness, Nutrition & Running Tracker</title>
  <meta name="description" content="Stoke — Premium fitness, nutrition tracker, workout architect and GPS running companion." />
  <meta name="theme-color" content="#FFFFFF" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  <meta name="apple-mobile-web-app-title" content="STOKE" />
  <meta name="application-name" content="STOKE" />
  <meta name="format-detection" content="telephone=no" />
  <link rel="manifest" href="manifest.json" />
  <link rel="apple-touch-icon" href="apple-touch-icon.png" />
  <link rel="icon" type="image/png" sizes="192x192" href="icon-192.png" />
  <link rel="icon" type="image/png" sizes="512x512" href="icon-512.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="leaflet.css" />
  <script src="leaflet.js"></script>
  <script src="meal_vision_engine.js"></script>
  <script src="body_goals_engine.js"></script>

  <style>
    :root {
      --bg-main: #FFFFFF;
      --bg-card: #EAF2FF;
      --bg-card-white: #FFFFFF;
      --primary-accent: #3678F5;
      --primary-hover: #2B62D9;
      --text-main: #26354A;
      --text-secondary: #64748B;
      --border-divider: #DCE5F2;
      --input-bg: #F8FAFF;
      --indicator-success: #21865B;
      --indicator-error: #D14343;
      --shadow-subtle: 0 4px 16px rgba(38, 53, 74, 0.06);
      --shadow-card: 0 2px 10px rgba(38, 53, 74, 0.08);
      --shadow-sm: 0 2px 8px rgba(38, 53, 74, 0.04);
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body {
      width: 100%;
      max-width: 100vw;
      min-height: 100%;
      min-height: 100dvh;
      overflow-x: hidden;
      -webkit-text-size-adjust: 100%;
      touch-action: manipulation;
    }
    #root {
      width: 100%;
      max-width: 100vw;
      min-height: 100%;
      min-height: 100dvh;
      overflow-x: hidden;
    }
    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: #FFFFFF;
      color: #26354A;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      -webkit-tap-highlight-color: transparent;
      padding-top: env(safe-area-inset-top, 0px);
      padding-bottom: env(safe-area-inset-bottom, 0px);
      padding-left: env(safe-area-inset-left, 0px);
      padding-right: env(safe-area-inset-right, 0px);
    }
    input, select, textarea {
      font-family: inherit;
      color: #26354A;
      font-size: 16px !important; /* Prevents auto-zoom on iOS Safari */
      touch-action: manipulation;
    }
    button, a {
      font-family: inherit;
      touch-action: manipulation;
      -webkit-tap-highlight-color: transparent;
    }
    ::placeholder {
      color: #64748B !important;
      -webkit-text-fill-color: #64748B;
      opacity: 1 !important;
    }
    ::-webkit-input-placeholder {
      color: #64748B !important;
      -webkit-text-fill-color: #64748B;
      opacity: 1 !important;
    }
    :-moz-placeholder {
      color: #64748B !important;
      opacity: 1 !important;
    }
    ::-moz-placeholder {
      color: #64748B !important;
      opacity: 1 !important;
    }
    :-ms-input-placeholder {
      color: #64748B !important;
      opacity: 1 !important;
    }
    ::-webkit-scrollbar { width: 0; height: 0; }
    input[type="number"]::-webkit-inner-spin-button,
    input[type="number"]::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
    input[type="number"] { -moz-appearance: textfield; }
    @keyframes stokeFadeUp { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: translateY(0); } }
    @keyframes stokeFadeIn { from { opacity: 0; } to { opacity: 1; } }
    @keyframes spin { to { transform: rotate(360deg); } }
    .stoke-auth-header { animation: stokeFadeUp 0.5s ease-out both; }
    .stoke-auth-card { animation: stokeFadeUp 0.5s ease-out 0.12s both; }
    .stoke-auth-footer { animation: stokeFadeIn 0.6s ease-out 0.3s both; }
    .stoke-btn-primary {
      background: #3678F5;
      color: #FFFFFF;
      transition: transform 0.15s ease, background 0.15s ease;
    }
    .stoke-btn-primary:hover { background: #2B62D9; }
    .stoke-btn-primary:active { transform: scale(0.97); opacity: 0.9; }
    .stoke-btn-secondary { transition: transform 0.15s ease, background 0.15s ease; }
    .stoke-btn-secondary:active { transform: scale(0.97); }
    .stoke-auth-input { transition: border-color 0.15s ease; }
    .stoke-auth-input:focus { outline: none; border-color: #3678F5 !important; }

    /* Leaflet Warm Customizations */
    .leaflet-container {
      background: #EAF2FF !important;
      font-family: inherit !important;
    }
    .leaflet-control-attribution {
      display: none !important;
    }
    .stoke-runner-beacon {
      position: relative;
      width: 28px;
      height: 28px;
      pointer-events: none;
    }
    .stoke-runner-dot {
      position: absolute;
      top: 7px;
      left: 7px;
      width: 14px;
      height: 14px;
      background: #3678F5;
      border: 2.5px solid #FFFFFF;
      border-radius: 50%;
      box-shadow: 0 0 14px rgba(54, 120, 245, 0.95);
      z-index: 2;
    }
    .stoke-runner-pulse {
      position: absolute;
      top: -2px;
      left: -2px;
      width: 32px;
      height: 32px;
      background: rgba(54, 120, 245, 0.35);
      border-radius: 50%;
      animation: stokeBeaconPulse 2s infinite ease-out;
      z-index: 1;
    }
    .stoke-runner-beam {
      position: absolute;
      top: -22px;
      left: -2px;
      width: 32px;
      height: 30px;
      background: radial-gradient(circle at 50% 100%, rgba(54, 120, 245, 0.55) 0%, rgba(54, 120, 245, 0) 75%);
      clip-path: polygon(50% 100%, 0% 0%, 100% 0%);
      pointer-events: none;
    }
    @keyframes stokeBeaconPulse {
      0% { transform: scale(0.6); opacity: 0.9; }
      100% { transform: scale(2.2); opacity: 0; }
    }
    @keyframes stokeSwoosh {
      0% { transform: scale(0.7) translateY(40px); opacity: 0; }
      60% { transform: scale(1.05) translateY(-5px); opacity: 1; }
      100% { transform: scale(1) translateY(0); opacity: 1; }
    }
    @keyframes stokeSparkle {
      0%, 100% { transform: scale(0.8) rotate(0deg); opacity: 0.6; }
      50% { transform: scale(1.2) rotate(15deg); opacity: 1; }
    }
    @keyframes stokeLaserScan {
      0% { top: 4px; opacity: 0.3; }
      50% { top: calc(100% - 8px); opacity: 0.95; }
      100% { top: 4px; opacity: 0.3; }
    }
    @keyframes stokeMicPulse {
      0% { transform: scale(1); box-shadow: 0 0 0 0 rgba(54, 120, 245, 0.7); }
      70% { transform: scale(1.08); box-shadow: 0 0 0 16px rgba(54, 120, 245, 0); }
      100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(54, 120, 245, 0); }
    }
    @keyframes stokeConfettiPop {
      0% { transform: scale(0.6) translateY(20px); opacity: 0; }
      50% { transform: scale(1.1) translateY(-6px); opacity: 1; }
      100% { transform: scale(1) translateY(0); opacity: 1; }
    }
    /* Warm Light Profile & Telemetry styles */
    .prof-hero-card {
      background: #EAF2FF;
      border: 1px solid #DCE5F2;
      border-radius: 20px;
      padding: 18px 20px;
      box-shadow: 0 4px 16px rgba(38, 53, 74, 0.08);
    }
    .prof-avatar-ring {
      width: 58px; height: 58px;
      border-radius: 50%;
      background: linear-gradient(135deg, #3678F5 0%, #2B62D9 100%);
      display: flex; align-items: center; justify-content: center;
      position: relative;
      box-shadow: 0 4px 14px rgba(54, 120, 245, 0.35);
    }
    .prof-avatar-inner {
      width: 52px; height: 52px;
      border-radius: 50%;
      background: #EAF2FF;
      display: flex; align-items: center; justify-content: center;
      font-size: 22px; font-weight: 900; color: #26354A;
    }
    .prof-badge-pro {
      position: absolute; bottom: -2px; right: -2px;
      background: #3678F5; color: #FFFFFF;
      font-size: 9px; font-weight: 900;
      padding: 2px 6px; border-radius: 999px;
      border: 1.5px solid #EAF2FF;
    }
    .prof-telemetry-grid {
      display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px;
      margin: 16px 0 14px;
    }
    .prof-telemetry-cell {
      background: #FFFFFF;
      border: 1px solid #DCE5F2;
      border-radius: 12px;
      padding: 10px 6px;
      text-align: center;
      box-shadow: 0 2px 6px rgba(38, 53, 74, 0.04);
    }
    .prof-telemetry-val {
      font-size: 15px; font-weight: 900; color: #26354A;
    }
    .prof-telemetry-lbl {
      font-size: 10px; font-weight: 700; color: #64748B; margin-top: 2px;
    }
    .prof-strategy-track {
      display: flex; gap: 6px; background: #EAF2FF; border: 1px solid #DCE5F2;
      padding: 4px; border-radius: 12px;
    }
    .prof-strategy-btn {
      flex: 1; padding: 7px 0; border: none; background: transparent;
      color: #64748B; font-size: 11.5px; font-weight: 700; border-radius: 8px; cursor: pointer;
    }
    .prof-strategy-btn.active {
      background: #FFFFFF; color: #3678F5; font-weight: 800;
      box-shadow: 0 2px 6px rgba(38, 53, 74, 0.08);
    }
    .prof-ratio-bar {
      display: flex; height: 6px; border-radius: 3px; overflow: hidden;
      margin: 8px 0 6px; background: #DCE5F2;
    }
    .prof-section-card {
      background: #EAF2FF;
      border: 1px solid #DCE5F2;
      border-radius: 18px;
      overflow: hidden;
      box-shadow: 0 4px 16px rgba(38, 53, 74, 0.06);
    }
    .prof-row-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 14px 16px;
      cursor: pointer;
      border-bottom: 1px solid #DCE5F2;
      transition: background 0.15s ease;
    }
    .prof-row-item:last-child {
      border-bottom: none;
    }
    .prof-row-item:hover {
      background: #EAF2FF;
    }
    .prof-icon-well {
      width: 38px;
      height: 38px;
      border-radius: 12px;
      background: #FFFFFF;
      border: 1px solid #DCE5F2;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 2px 6px rgba(38, 53, 74, 0.05);
    }
  
    .stoke-dark-tiles {
      filter: invert(100%) hue-rotate(180deg) brightness(88%) contrast(92%) saturate(40%) !important;
      -webkit-filter: invert(100%) hue-rotate(180deg) brightness(88%) contrast(92%) saturate(40%) !important;
    }
</style>
</head>
<body>
  <div id="root"></div>
  <div id="stoke-fatal-error" style="display:none; position:fixed; inset:0; z-index:9999999; background:#EAF2FF; color:#26354A; padding:24px; font-family:sans-serif; font-size:14px; overflow:auto; border:3px solid #3678F5;">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
      <h3 style="margin:0; color:#D14343; font-size:18px;">Application Notice</h3>
      <button onclick="document.getElementById('stoke-fatal-error').style.display='none'" style="background:#3678F5; color:#fff; border:none; padding:8px 16px; border-radius:12px; font-weight:700; cursor:pointer;">Dismiss & Continue to App</button>
    </div>
    <div id="stoke-fatal-error-content" style="white-space:pre-wrap; font-family:monospace; background:#fff; padding:16px; border-radius:12px; border:1px solid #DCE5F2; color:#D14343;"></div>
  </div>

  <script>
    function reportAppError(title, err) {
      var str = (err && err.stack ? err.stack : String(err));
      if (!str || str.indexOf('[BABEL]') !== -1 || str.indexOf('deoptimised') !== -1) return;
      if (str.indexOf('chrome-extension:') !== -1 || str.indexOf('moz-extension:') !== -1 || str.indexOf('ms-browser-extension:') !== -1) return;
      if (str.indexOf('Script error.') !== -1 || str.indexOf('ResizeObserver') !== -1 || str.indexOf('NetworkError') !== -1 || str.indexOf('Failed to fetch') !== -1) return;
      var box = document.getElementById('stoke-fatal-error');
      var content = document.getElementById('stoke-fatal-error-content');
      if (box && content) {
        box.style.display = 'block';
        content.innerHTML += '<strong>' + title + '</strong>\n' + str + '\n\n';
      }
    }
    window.addEventListener('error', function(e) {
      if (!e) return;
      if (e.filename && (e.filename.indexOf('extension') !== -1 || e.filename.indexOf('chrome') !== -1 || e.filename.indexOf('moz') !== -1)) return;
      if (e.message && (e.message.indexOf('[BABEL]') !== -1 || e.message.indexOf('deoptimised') !== -1 || e.message.indexOf('Script error') !== -1 || e.message.indexOf('ResizeObserver') !== -1)) return;
      reportAppError('Application Notice (' + (e.filename || 'app') + ':' + (e.lineno || 0) + ')', e.message || e.error);
    });
  </script>

  <script src="react.min.js"></script>
  <script src="react-dom.min.js"></script>
  <script src="babel.min.js"></script>
  <script src="supabase.min.js"></script>
  <script src="supabase_client.js"></script>
  <script src="exercise_database.js"></script>
  <script src="exercise_youtube_database.js"></script>

  <script type="text/babel" data-presets="react" data-compact="true">
const { useState, useRef, useEffect, useMemo, useCallback } = React;

const THEME = {
