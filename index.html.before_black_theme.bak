// Clean Inline SVG Icons (Zero encoding dependency)
function AuthEyeIcon({ visible }) {
  if (visible) {
    return (
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#64748B" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" style={{ display: "block" }}>
        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
        <circle cx="12" cy="12" r="3" />
      </svg>
    );
  }
  return (
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#64748B" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" style={{ display: "block" }}>
      <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24" />
      <line x1="1" y1="1" x2="23" y2="23" />
    </svg>
  );
}

function AuthBackIcon() {
  return (
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.4" strokeLinecap="round" strokeLinejoin="round" style={{ display: "block" }}>
      <path d="M19 12H5M12 19l-7-7 7-7" />
    </svg>
  );
}

function AuthCloseIcon() {
  return (
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.4" strokeLinecap="round" strokeLinejoin="round" style={{ display: "block" }}>
      <line x1="18" y1="6" x2="6" y2="18" />
      <line x1="6" y1="6" x2="18" y2="18" />
    </svg>
  );
}

function AuthCheckIcon() {
  return (
    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" strokeWidth="3.2" strokeLinecap="round" strokeLinejoin="round" style={{ display: "block" }}>
      <polyline points="20 6 9 17 4 12" />
    </svg>
  );
}

function AuthAlertIcon() {
  return (
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#D14343" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" style={{ flexShrink: 0 }}>
      <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
      <line x1="12" y1="9" x2="12" y2="13" />
      <line x1="12" y1="17" x2="12.01" y2="17" />
    </svg>
  );
}

function AuthUserAvatar() {
  return (
    <svg width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="#3678F5" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
      <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
      <circle cx="12" cy="7" r="4" />
    </svg>
  );
}

function AuthLightningIcon() {
  return (
    <svg width="14" height="14" viewBox="0 0 24 24" fill="#3678F5" style={{ display: "block" }}>
      <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
    </svg>
  );
}

function AuthScreen({ onSignIn, initialMode = "signin" }) {
  useEffect(() => {
    if (typeof injectAuthStylesV3 === "function") injectAuthStylesV3();
  }, []);

  const [screen, setScreen] = useState(initialMode === "signup" ? "signup" : "login");
  const [step, setStep] = useState(0);

  const [form, setForm] = useState({
    email: "",
    password: "",
    name: "",
    age: "",
    height: "",
    weight: "",
    goal: "",
    level: "",
    frequency: "",
    activity: "",
  });

  const [loading, setLoading] = useState(false);
  const [error, setError] = useState("");
  const [showPassword, setShowPassword] = useState(false);
  const [showGoogleModal, setShowGoogleModal] = useState(false);
  const [resendCooldown, setResendCooldown] = useState(0);
  const [resendStatus, setResendStatus] = useState("");
  const [pendingProfile, setPendingProfile] = useState(null);
  const [checkingVerification, setCheckingVerification] = useState(false);
  const [resendingEmail, setResendingEmail] = useState(false);
  const [verifyFeedback, setVerifyFeedback] = useState(null);

  // Live cooldown timer for email verification resend
  useEffect(() => {
    if (resendCooldown <= 0) return;
    const timer = setInterval(() => {
      setResendCooldown((prev) => (prev <= 1 ? 0 : prev - 1));
    }, 1000);
    return () => clearInterval(timer);
  }, [resendCooldown]);

  const GOOGLE_ACCOUNTS = [
    { name: "Mohd Numan", email: "mohdnuman701@gmail.com", avatar: "M", color: "#1A73E8", label: "Primary" },
    { name: "Mohd Numan", email: "mohdnuman925@gmail.com", avatar: "M", color: "#256BFD", label: "Personal" },
    { name: "KLH Edu", email: "mohdnuman@klh.edu.in", avatar: "N", color: "#E37400", label: "KLH Edu" },
    { name: "Mohammed numan .", email: "2210560148@klh.edu.in", avatar: "M", color: "#1E8E3E", label: "KLH Student" },
  ];

  const update = (key, value) => {
    setForm((prev) => ({
      ...prev,
      [key]: value,
    }));
    setError("");
  };

  /*
   * LOGIN (Requirement 1, 4: Rate Limited & Anti-Enumeration Protected)
   */
  const handleLogin = async (customEmail) => {
    const emailToUse = (customEmail || form.email || "").trim();
    if (!emailToUse || (!customEmail && !form.password)) {
      setError("Please enter your email and password.");
      return;
    }

    // Client-side rate limit check (5 attempts per 15 minutes)
    if (typeof checkAuthRateLimit === "function") {
      const rate = checkAuthRateLimit(emailToUse, 5, 15 * 60 * 1000);
      if (!rate.allowed) {
        setError(`Security notice: Account temporarily throttled due to multiple failed attempts. Please retry in ${rate.retryAfterSeconds}s.`);
        return;
      }
    }

    setLoading(true);
    setError("");

    try {
      if (typeof dbSignIn === "function") {
        const res = await dbSignIn(emailToUse, form.password || "password123");
        if (res && res.requiresEmailVerification) {
          setLoading(false);
          setScreen("verify_email");
          return;
        }
        if (res && res.error) {
          // If demo athlete login fails on remote Supabase (unconfigured/offline), smoothly continue offline
          if (emailToUse === "mohdnuman701@gmail.com" || emailToUse === "athlete@stoke.app") {
            console.warn("Supabase auth offline for demo athlete, continuing offline:", res.error);
            onSignIn(emailToUse);
            return;
          }
          setError(res.error.message || "Invalid login credentials. Please check your email and password.");
          setLoading(false);
          return;
        }
      }
      onSignIn(emailToUse);
    } catch (err) {
      if (emailToUse === "mohdnuman701@gmail.com" || emailToUse === "athlete@stoke.app") {
        onSignIn(emailToUse);
        return;
      }
      setError(err?.message || "Invalid login credentials. Please check your email and password.");
    } finally {
      setLoading(false);
    }
  };

  /*
   * RESEND VERIFICATION EMAIL (Requirement 3, 4: Cooldown & Rate Limiting)
   */
  const handleResendVerification = async () => {
    const cleanEmail = (form.email || "").trim();
    if (!cleanEmail) {
      setVerifyFeedback({ type: "error", message: "Email address not found. Please return to login." });
      return;
    }
    if (resendCooldown > 0) return;
    setResendingEmail(true);
    setVerifyFeedback(null);
    try {
      if (typeof dbResendVerificationEmail === "function") {
        const res = await dbResendVerificationEmail(cleanEmail);
        if (res && res.throttled) {
          setVerifyFeedback({ type: "error", message: res.error?.message || `Please wait ${res.retryAfterSeconds}s before retrying.` });
          setResendCooldown(res.retryAfterSeconds || 60);
          return;
        }
        if (res && res.error) {
          setVerifyFeedback({ type: "error", message: res.error?.message || "Failed to resend verification email." });
          return;
        }
      }
      setVerifyFeedback({ type: "success", message: "A fresh verification link has been sent to your inbox!" });
      setResendCooldown(60);
    } catch (err) {
      setVerifyFeedback({ type: "error", message: err?.message || "Failed to resend." });
    } finally {
      setResendingEmail(false);
    }
  };

  /*
   * CHECK EMAIL VERIFICATION STATUS (Requirement 3: Server-side check)
   */
  const handleCheckVerification = async () => {
    const cleanEmail = (form.email || "").trim();
    setCheckingVerification(true);
    setVerifyFeedback(null);
    try {
      if (typeof dbCheckEmailVerified === "function") {
        const res = await dbCheckEmailVerified(cleanEmail);
        if (res && (res.verified || res.offline)) {
          setVerifyFeedback({ type: "success", message: "Email confirmed successfully! Entering dashboard..." });
          setTimeout(() => {
            onSignIn(cleanEmail, pendingProfile);
          }, 800);
          return;
        }
      }
      setVerifyFeedback({
        type: "error",
        message: "Email is not verified yet. Please click the confirmation link in your email inbox and try again."
      });
    } catch (err) {
      setVerifyFeedback({ type: "error", message: "Could not verify email status. Please check your connection." });
    } finally {
      setCheckingVerification(false);
    }
  };

  /*
   * FORGOT PASSWORD (Requirement 4: Anti-Enumeration generic response & Rate Limiting)
   */
  const handleForgotPassword = async () => {
    const cleanEmail = (form.email || "").trim();
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!cleanEmail || !emailRegex.test(cleanEmail)) {
      setError("Please enter a valid email address above to receive password reset instructions.");
      return;
    }

    // Rate limiting check
    if (typeof checkAuthRateLimit === "function") {
      const rate = checkAuthRateLimit("reset_" + cleanEmail, 3, 15 * 60 * 1000);
      if (!rate.allowed) {
        setError(`Please wait ${rate.retryAfterSeconds}s before requesting another password reset.`);
        return;
      }
    }

    setLoading(true);
    setError("");
    try {
      if (typeof dbResetPassword === "function") {
        await dbResetPassword(cleanEmail);
      }
      alert(`If an account exists for ${cleanEmail}, instructions to reset your password have been sent.`);
    } catch (err) {
      alert(`If an account exists for ${cleanEmail}, instructions to reset your password have been sent.`);
    } finally {
      setLoading(false);
    }
  };

  /*
   * CREATE ACCOUNT (Requirement 5: 12+ characters, complexity, blacklist)
   */
  const handleCreateAccount = async () => {
    const cleanEmail = (form.email || "").trim();
    if (!cleanEmail || !form.password) {
      setError("Please enter both email and password.");
      return;
    }
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!emailRegex.test(cleanEmail)) {
      setError("Please enter a valid email address (e.g. athlete@domain.com).");
      return;
    }

    if (typeof validatePasswordStrength === "function") {
      const strength = validatePasswordStrength(form.password);
      if (!strength.isValid) {
        setError(strength.errors[0] || "Password must be at least 12 characters and include uppercase, lowercase, numbers, and symbols.");
        return;
      }
    } else if (form.password.length < 12) {
      setError("Password must be at least 12 characters long.");
      return;
    }

    setError("");
    setStep(0);
    setScreen("profile");
  };

  /*
   * SELECT PROFILE OPTION
   */
  const selectOption = (value) => {
    const key = STEPS[step].key;
    update(key, value);
  };

  /*
   * NEXT PROFILE STEP
   */
  const nextStep = () => {
    const currentStep = STEPS[step];
    const value = form[currentStep.key];

    if (!value || String(value).trim() === "") {
      setError("Please complete this step before continuing.");
      return;
    }

    setError("");

    if (step < STEPS.length - 1) {
      setStep((prev) => prev + 1);
    } else {
      setScreen("summary");
    }
  };

  /*
   * BACK
   */
  const goBack = () => {
    setError("");

    if (step === 0) {
      if (screen === "profile") {
        setScreen("signup");
      }
      return;
    }

    setStep((prev) => prev - 1);
  };

  /*
   * FINISH PROFILE
   */
  const finishProfile = async () => {
    setLoading(true);
    setError("");

    try {
      await new Promise((resolve) => setTimeout(resolve, 700));

      const activityMap = {
        "Low": 1.2,
        "Moderate": 1.55,
        "High": 1.725,
        "Very High": 1.9,
      };
      const goalTypeMap = {
        "Build Muscle": "gain",
        "Lose Fat": "cut",
        "Get Stronger": "gain",
        "Improve Fitness": "maintain",
      };

      const userProfile = {
        ...DEFAULT_PROFILE,
        name: form.name || "Athlete",
        age: parseInt(form.age, 10) || 25,
        heightCm: parseFloat(form.height) || 175,
        weightKg: parseFloat(form.weight) || 70,
        goalType: goalTypeMap[form.goal] || "maintain",
        goal: form.goal || "Improve Fitness",
        level: form.level || "Intermediate",
        frequency: form.frequency || "3-4 days",
        activity: activityMap[form.activity] || 1.55,
        activityLevel: form.activity || "Moderate",
      };

      if (typeof dbSignUp === "function") {
        try {
          await dbSignUp(form.email || "athlete@stoke.app", form.password || "password123", {
            name: userProfile.name,
            age: userProfile.age,
            height: userProfile.heightCm,
            weight: userProfile.weightKg,
            goal: userProfile.goalType,
            activity: userProfile.activityLevel
          });
        } catch (dbErr) {
          console.warn("dbSignUp background sync notice:", dbErr);
        }
      }

      console.log("Profile completed:", userProfile);
      setLoading(false);
      onSignIn(form.email || "athlete@stoke.app", userProfile);
    } catch (err) {
      console.warn("Profile setup local fallback:", err);
      // Ensure the user is never blocked from entering the app
      setLoading(false);
      onSignIn(form.email || "athlete@stoke.app", {
        ...DEFAULT_PROFILE,
        name: form.name || "Athlete"
      });
    }
  };

  /*
   * QUICK DEMO LOGIN (Mohd Numan)
   */
  const handleDemoLogin = () => {
    update("email", "mohdnuman701@gmail.com");
    update("password", "password123");
    handleLogin("mohdnuman701@gmail.com");
  };

  /*
   * LOGIN SCREEN
   */
  if (screen === "login") {
    return (
      <div style={{
        minHeight: "100vh",
        background: "#FFFFFF",
        color: "#26354A",
        display: "flex",
        alignItems: "center",
        justifyContent: "center",
        padding: "clamp(20px, 4vw, 44px) 16px",
        fontFamily: "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
        position: "relative",
        overflowX: "hidden"
      }}>
        {/* Soft background glow */}
        <div style={{
          position: "absolute",
          top: -80,
          left: "50%",
          transform: "translateX(-50%)",
          width: 440,
          height: 440,
          borderRadius: "50%",
          background: "radial-gradient(circle, rgba(54,120,245,0.14) 0%, transparent 70%)",
          pointerEvents: "none",
          filter: "blur(50px)"
        }} />

        {/* Clean, centered modern login card */}
        <div style={{
          width: "100%",
          maxWidth: 440,
          background: "#FFFFFF",
          border: "2px solid #DCE5F2",
          borderRadius: 24,
          padding: "clamp(24px, 5vw, 36px) clamp(20px, 4.5vw, 28px)",
          boxShadow: "0 12px 36px rgba(37,45,53,0.08)",
          position: "relative",
          zIndex: 1,
          boxSizing: "border-box"
        }}>

          {/* REALISTIC GYM PHOTO HERO CARD */}
          <div style={{ textAlign: "center", marginBottom: 20 }}>
            <div style={{
              width: "100%",
              height: "clamp(180px, 30vw, 215px)",
              borderRadius: 20,
              overflow: "hidden",
              border: "2px solid #DCE5F2",
              boxShadow: "0 8px 24px rgba(37, 45, 53, 0.08)",
              position: "relative",
              background: "#EAF2FF"
            }}>
              <img
                src="athlete_login.jpg"
                alt="STOKE athlete training in gym"
                loading="eager"
                style={{
                  width: "100%",
                  height: "100%",
                  objectFit: "cover",
                  objectPosition: "center 28%",
                  display: "block"
                }}
              />
              <div style={{
                position: "absolute",
                inset: 0,
                background: "linear-gradient(180deg, rgba(37, 45, 53, 0.05) 0%, transparent 45%, rgba(37, 45, 53, 0.7) 100%)",
                pointerEvents: "none"
              }} />
              <div style={{
                position: "absolute",
                bottom: 12,
                left: 14,
                display: "flex",
                alignItems: "center",
                gap: 8,
                background: "rgba(20, 26, 32, 0.92)",
                backdropFilter: "blur(8px)",
                WebkitBackdropFilter: "blur(8px)",
                padding: "6px 14px",
                borderRadius: 999,
                border: "1px solid rgba(255, 255, 255, 0.25)"
              }}>
                <span style={{ width: 8, height: 8, borderRadius: "50%", background: "#3678F5", boxShadow: "0 0 8px #3678F5" }} />
                <span style={{ color: "#FFFFFF", fontSize: "12px", fontWeight: 800, letterSpacing: "1.2px", textTransform: "uppercase" }}>
                  STOKE ATHLETE
                </span>
              </div>
            </div>
          </div>

          {/* BRAND HEADER */}
          <div style={{ textAlign: "center", marginBottom: 22 }}>
            <div style={{
              display: "inline-flex",
              alignItems: "center",
              gap: 8,
              background: "#EAF2FF",
              border: "1.5px solid #DCE5F2",
              padding: "6px 16px",
              borderRadius: 999,
              marginBottom: 12,
              boxShadow: "0 2px 8px rgba(54,120,245,0.12)"
            }}>
              <span style={{ width: 8, height: 8, borderRadius: "50%", background: "#3678F5", boxShadow: "0 0 8px #3678F5" }} />
              <span style={{ color: "#3678F5", fontSize: "13px", fontWeight: 800, letterSpacing: "2.5px", textTransform: "uppercase" }}>
                STOKE⚡
              </span>
            </div>

            <h1 style={{
              fontSize: "clamp(30px, 5vw, 36px)",
              fontWeight: 800,
              letterSpacing: "-0.8px",
              lineHeight: 1.15,
              margin: "0 0 8px",
              color: "#26354A",
              fontFamily: "'Inter', -apple-system, BlinkMacSystemFont, sans-serif"
            }}>
              Welcome back
            </h1>

            <p style={{
              color: "#64748B",
              fontSize: "16px",
              fontWeight: 500,
              margin: 0,
              lineHeight: 1.5,
              fontFamily: "'Inter', -apple-system, BlinkMacSystemFont, sans-serif"
            }}>
              Sign in to continue your fitness and nutrition journey.
            </p>
          </div>

          <div style={{ display: "flex", flexDirection: "column", gap: 14 }}>

            {/* CONTINUE WITH GOOGLE BUTTON */}
            <button
              type="button"
              onClick={() => setShowGoogleModal(true)}
              style={{
                width: "100%",
                height: 52,
                borderRadius: 16,
                background: "#FFFFFF",
                color: "#26354A",
                border: "2px solid #DCE5F2",
                fontWeight: 600,
                fontSize: "15.5px",
                display: "flex",
                alignItems: "center",
                justifyContent: "center",
                gap: 12,
                cursor: "pointer",
                transition: "all 0.2s ease",
                boxShadow: "0 2px 6px rgba(37,45,53,0.04)",
                fontFamily: "'Inter', -apple-system, BlinkMacSystemFont, sans-serif"
              }}
              onMouseEnter={(e) => { e.currentTarget.style.borderColor = "#3678F5"; e.currentTarget.style.background = "#EAF2FF"; }}
              onMouseLeave={(e) => { e.currentTarget.style.borderColor = "#DCE5F2"; e.currentTarget.style.background = "#FFFFFF"; }}
            >
              <svg width="20" height="20" viewBox="0 0 24 24">
                <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.8-2.4 3.68v3.05h3.88c2.27-2.09 3.665-5.17 3.665-9.17z"/>
                <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.25v3.15C3.26 21.36 7.33 24 12 24z"/>
                <path fill="#FBBC05" d="M5.28 14.27c-.25-.72-.38-1.49-.38-2.27s.13-1.55.38-2.27V6.58H1.25C.45 8.18 0 9.99 0 12s.45 3.82 1.25 5.42l4.03-3.15z"/>
                <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.33 0 3.26 2.64 1.25 6.58l4.03 3.15c.95-2.83 3.6-4.98 6.72-4.98z"/>
              </svg>
              <span style={{ color: "#26354A", fontWeight: 600, fontSize: "15.5px" }}>Continue with Google</span>
            </button>

            {/* DIVIDER */}
            <div style={{ display: "flex", alignItems: "center", gap: 14, margin: "4px 0" }}>
              <div style={{ flex: 1, height: 1.5, background: "#DCE5F2" }} />
              <span style={{ fontSize: "12.5px", color: "#64748B", fontWeight: 700, letterSpacing: "1.5px" }}>
                OR
              </span>
              <div style={{ flex: 1, height: 1.5, background: "#DCE5F2" }} />
            </div>

            {/* EMAIL INPUT WITH EXPLICIT LABEL */}
            <div style={{ display: "flex", flexDirection: "column", gap: 6 }}>
              <label style={{ fontSize: "14.5px", fontWeight: 600, color: "#26354A", fontFamily: "'Inter', sans-serif" }}>
                Email
              </label>
              <div style={{
                display: "flex",
                alignItems: "center",
                height: 52,
                padding: "0 16px",
                borderRadius: 14,
                background: "#FFFFFF",
                border: "2px solid #DCE5F2",
                transition: "all 0.2s ease"
              }}>
                <input
                  type="email"
                  value={form.email}
                  onChange={(e) => update("email", e.target.value)}
                  placeholder="athlete@stoke.app"
                  style={{
                    width: "100%",
                    height: "100%",
                    background: "transparent",
                    border: "none",
                    outline: "none",
                    color: "#26354A",
                    fontSize: "15.5px",
                    fontWeight: 500,
                    fontFamily: "'Inter', -apple-system, BlinkMacSystemFont, sans-serif"
                  }}
                  onFocus={(e) => {
                    e.currentTarget.parentElement.style.borderColor = "#3678F5";
                    e.currentTarget.parentElement.style.boxShadow = "0 0 0 3px rgba(54,120,245,0.18)";
                  }}
                  onBlur={(e) => {
                    e.currentTarget.parentElement.style.borderColor = "#DCE5F2";
                    e.currentTarget.parentElement.style.boxShadow = "none";
                  }}
                />
              </div>
            </div>

            {/* PASSWORD INPUT WITH EXPLICIT LABEL AND EYE TOGGLE */}
            <div style={{ display: "flex", flexDirection: "column", gap: 6 }}>
              <div style={{ display: "flex", alignItems: "center", justifyContent: "space-between" }}>
                <label style={{ fontSize: "14.5px", fontWeight: 600, color: "#26354A", fontFamily: "'Inter', sans-serif" }}>
                  Password
                </label>
                {/* FORGOT PASSWORD LINK */}
                <button
                  type="button"
                  onClick={handleForgotPassword}
                  style={{
                    background: "transparent",
                    border: "none",
                    color: "#3678F5",
                    fontSize: "14px",
                    fontWeight: 600,
                    cursor: "pointer",
                    padding: "0 2px",
                    textDecoration: "none",
                    fontFamily: "'Inter', sans-serif"
                  }}
                  onMouseEnter={(e) => { e.currentTarget.style.textDecoration = "underline"; }}
                  onMouseLeave={(e) => { e.currentTarget.style.textDecoration = "none"; }}
                >
                  Forgot password?
                </button>
              </div>
              <div style={{
                display: "flex",
                alignItems: "center",
                height: 52,
                padding: "0 16px",
                borderRadius: 14,
                background: "#FFFFFF",
                border: "2px solid #DCE5F2",
                transition: "all 0.2s ease"
              }}>
                <input
                  type={showPassword ? "text" : "password"}
                  value={form.password}
                  onChange={(e) => update("password", e.target.value)}
                  onKeyDown={(e) => { if (e.key === "Enter") handleLogin(); }}
                  placeholder="Enter your password"
                  style={{
                    width: "100%",
                    height: "100%",
                    background: "transparent",
                    border: "none",
                    outline: "none",
                    color: "#26354A",
                    fontSize: "15.5px",
                    fontWeight: 500,
                    fontFamily: "'Inter', -apple-system, BlinkMacSystemFont, sans-serif"
                  }}
                  onFocus={(e) => {
                    e.currentTarget.parentElement.style.borderColor = "#3678F5";
                    e.currentTarget.parentElement.style.boxShadow = "0 0 0 3px rgba(54,120,245,0.18)";
                  }}
                  onBlur={(e) => {
                    e.currentTarget.parentElement.style.borderColor = "#DCE5F2";
                    e.currentTarget.parentElement.style.boxShadow = "none";
                  }}
                />
                <button
                  type="button"
                  onClick={() => setShowPassword(!showPassword)}
                  aria-label={showPassword ? "Hide password" : "Show password"}
                  style={{
                    background: "transparent",
                    border: "none",
                    padding: 6,
                    cursor: "pointer",
                    display: "flex",
                    alignItems: "center",
                    justifyContent: "center",
                    marginLeft: 6,
                    color: "#64748B"
                  }}
                >
                  <AuthEyeIcon visible={showPassword} />
                </button>
              </div>
            </div>

  /* --- ERROR MESSAGE --- */
            {error && (
              <div style={{
                background: "rgba(209, 67, 67,0.1)",
                border: "1.5px solid rgba(209, 67, 67,0.35)",
                color: "#D14343",
                fontSize: 13.5,
                fontWeight: 600,
                padding: "10px 14px",
                borderRadius: 14,
                display: "flex",
                alignItems: "center",
                gap: 8,
                fontFamily: "'Inter', sans-serif"
              }}>
                <AuthAlertIcon />
                <span>{error}</span>
              </div>
            )}

            {/* LOG IN PRIMARY BUTTON - STOKE ORANGE */}
            <button
              type="button"
              onClick={() => handleLogin()}
              disabled={loading}
              style={{
                width: "100%",
                height: 54,
                borderRadius: 16,
                background: "linear-gradient(135deg, #3678F5 0%, #2B62D9 100%)",
                color: "#FFFFFF",
                border: "none",
                fontWeight: 700,
                fontSize: "16px",
                letterSpacing: "0.5px",
                cursor: loading ? "not-allowed" : "pointer",
                transition: "all 0.2s cubic-bezier(0.16, 1, 0.3, 1)",
                boxShadow: "0 8px 24px rgba(54,120,245,0.35)",
                display: "flex",
                alignItems: "center",
                justifyContent: "center",
                opacity: loading ? 0.7 : 1,
                marginTop: 2,
                fontFamily: "'Inter', -apple-system, BlinkMacSystemFont, sans-serif"
              }}
              onMouseEnter={(e) => { if (!loading) e.currentTarget.style.filter = "brightness(1.05)"; }}
              onMouseLeave={(e) => { e.currentTarget.style.filter = "none"; }}
            >
              {loading ? (
                <span style={{ display: "flex", alignItems: "center", gap: 8 }}>
                  <span className="s3-spinner" style={{ borderTopColor: "#fff" }} />
                  <span>LOGGING IN...</span>
                </span>
              ) : (
                "LOG IN"
              )}
            </button>

            {/* QUICK DEMO ONE-TAP LOGIN */}
            <button
              type="button"
              onClick={handleDemoLogin}
              style={{
                background: "#EAF2FF",
                border: "2px solid #DCE5F2",
                color: "#2B62D9",
                borderRadius: 14,
                height: 50,
                padding: "0 16px",
                fontSize: "14.5px",
                fontWeight: 700,
                cursor: "pointer",
                display: "flex",
                alignItems: "center",
                justifyContent: "center",
                gap: 8,
                marginTop: 2,
                transition: "all 0.15s ease",
                boxShadow: "0 2px 8px rgba(54,120,245,0.08)",
                fontFamily: "'Inter', -apple-system, BlinkMacSystemFont, sans-serif"
              }}
              onMouseEnter={(e) => { e.currentTarget.style.background = "#EAF2FF"; e.currentTarget.style.borderColor = "#3678F5"; }}
              onMouseLeave={(e) => { e.currentTarget.style.background = "#EAF2FF"; e.currentTarget.style.borderColor = "#DCE5F2"; }}
            >
              <AuthLightningIcon />
              <span>Quick Demo Login (Mohd Numan)</span>
            </button>

          </div>

          {/* SIGN UP FOOTER LINK */}
          <p style={{
            textAlign: "center",
            color: "#64748B",
            marginTop: 22,
            fontSize: "15.5px",
            fontWeight: 500,
            fontFamily: "'Inter', -apple-system, BlinkMacSystemFont, sans-serif"
          }}>
            New to STOKE?{" "}
            <button
              type="button"
              onClick={() => {
                setError("");
                setScreen("signup");
              }}
              style={{
                background: "transparent",
                border: "none",
                color: "#3678F5",
                fontWeight: 700,
                cursor: "pointer",
                fontSize: "15.5px",
                textDecoration: "underline",
                textUnderlineOffset: 3,
                fontFamily: "inherit"
              }}
            >
              Create account
            </button>
          </p>

        </div>

        {/* GOOGLE ACCOUNTS MODAL */}
        {showGoogleModal && (
          <div style={{
            position: "fixed",
            inset: 0,
            background: "rgba(37,45,53,0.65)",
            backdropFilter: "blur(12px)",
            WebkitBackdropFilter: "blur(12px)",
            zIndex: 9999,
            display: "flex",
            alignItems: "center",
            justifyContent: "center",
            padding: 20
          }}>
            <div style={{
              background: "#FFFFFF",
              border: "1.5px solid #DCE5F2",
              borderRadius: 24,
              padding: 24,
              width: "100%",
              maxWidth: 400,
              boxShadow: "0 20px 50px rgba(37,45,53,0.18)",
              animation: "fadeUp3 0.3s ease-out both"
            }}>
              <div style={{ display: "flex", alignItems: "center", justifyContent: "space-between", marginBottom: 16 }}>
                <div style={{ display: "flex", alignItems: "center", gap: 10 }}>
                  <GIcon sz={22} />
                  <span style={{ fontSize: 16, fontWeight: 700, color: "#26354A" }}>Sign in with Google</span>
                </div>
                <button
                  type="button"
                  onClick={() => setShowGoogleModal(false)}
                  style={{
                    background: "#F8FAFC",
                    border: "1px solid #DCE5F2",
                    borderRadius: 8,
                    padding: "4px 8px",
                    color: "#64748B",
                    cursor: "pointer",
                    fontWeight: 700,
                    fontSize: 14
                  }}
                >
                  ✕
                </button>
              </div>

              <div style={{ fontSize: 14, color: "#64748B", marginBottom: 14, fontWeight: 500 }}>
                Choose an account to continue to <strong>STOKE</strong>:
              </div>

              <div style={{ display: "flex", flexDirection: "column", gap: 8 }}>
                {GOOGLE_ACCOUNTS.map((acc) => (
                  <div
                    key={acc.email}
                    onClick={() => {
                      setShowGoogleModal(false);
                      handleLogin(acc.email);
                    }}
                    style={{
                      display: "flex",
                      alignItems: "center",
                      gap: 12,
                      padding: "10px 14px",
                      borderRadius: 14,
                      background: "#FFFFFF",
                      border: "1.5px solid #E2E8F0",
                      cursor: "pointer",
                      transition: "all 0.15s ease"
                    }}
                    onMouseEnter={(e) => { e.currentTarget.style.background = "#FFF3E0"; e.currentTarget.style.borderColor = "#3678F5"; }}
                    onMouseLeave={(e) => { e.currentTarget.style.background = "#FFFFFF"; e.currentTarget.style.borderColor = "#E2E8F0"; }}
                  >
                    <div style={{
                      width: 36,
                      height: 36,
                      borderRadius: "50%",
                      background: acc.color,
                      color: "#FFFFFF",
                      display: "flex",
                      alignItems: "center",
                      justifyContent: "center",
                      fontWeight: 800,
                      fontSize: 14
                    }}>
                      {acc.avatar}
                    </div>
                    <div style={{ flex: 1, minWidth: 0 }}>
                      <div style={{ fontSize: 14, fontWeight: 700, color: "#26354A", overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" }}>
                        {acc.name}
                      </div>
                      <div style={{ fontSize: 12.5, color: "#64748B", fontWeight: 500, overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" }}>
                        {acc.email}
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        )}

      </div>
    );
  }

  /*
   * SIGN UP SCREEN
   */
  if (screen === "signup") {
    return (
      <div style={{
        minHeight: "100vh",
        background: "#FFFFFF",
        color: "#26354A",
        display: "flex",
        alignItems: "center",
        justifyContent: "center",
        padding: "clamp(20px, 4vw, 44px) 16px",
        fontFamily: "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
        position: "relative",
        overflowX: "hidden"
      }}>
        {/* Ambient lighting orb */}
        <div style={{
          position: "absolute",
          top: -100,
          left: "50%",
          transform: "translateX(-50%)",
          width: 360,
          height: 360,
          borderRadius: "50%",
          background: "radial-gradient(circle, rgba(54,120,245,0.14) 0%, transparent 70%)",
          pointerEvents: "none",
          filter: "blur(40px)"
        }} />

        <div style={{
          width: "100%",
          maxWidth: 440,
          background: "#FFFFFF",
          border: "2px solid #DCE5F2",
          borderRadius: 24,
          padding: "clamp(24px, 5vw, 36px) clamp(20px, 4.5vw, 28px)",
          boxShadow: "0 12px 36px rgba(37,45,53,0.08)",
          position: "relative",
          zIndex: 1,
          boxSizing: "border-box"
        }}>

          {/* BACK BUTTON WITH CLEAN SVG ARROW */}
          <button
            type="button"
            onClick={() => setScreen("login")}
            style={{
              width: 40,
              height: 40,
              borderRadius: "50%",
              background: "#EAF2FF",
              border: "1.5px solid #DCE5F2",
              color: "#26354A",
              display: "flex",
              alignItems: "center",
              justifyContent: "center",
              marginBottom: 18,
              cursor: "pointer",
              transition: "all 0.2s ease",
              boxShadow: "0 2px 8px rgba(37,45,53,0.04)"
            }}
          >
            <AuthBackIcon />
          </button>

          {/* BRAND HEADER */}
          <div style={{ textAlign: "center", marginBottom: 22 }}>
            <div style={{
              display: "inline-flex",
              alignItems: "center",
              gap: 8,
              background: "#EAF2FF",
              border: "1.5px solid #DCE5F2",
              padding: "6px 16px",
              borderRadius: 999,
              marginBottom: 12,
              boxShadow: "0 2px 8px rgba(54,120,245,0.12)"
            }}>
              <span style={{ width: 8, height: 8, borderRadius: "50%", background: "#3678F5", boxShadow: "0 0 8px #3678F5" }} />
              <span style={{ color: "#3678F5", fontSize: "13px", fontWeight: 800, letterSpacing: "2.5px", textTransform: "uppercase" }}>
                STOKE⚡
              </span>
            </div>

            <h1 style={{
              fontSize: "clamp(30px, 5vw, 36px)",
              fontWeight: 800,
              letterSpacing: "-0.8px",
              lineHeight: 1.15,
              margin: "0 0 8px",
              color: "#26354A",
              fontFamily: "'Inter', -apple-system, BlinkMacSystemFont, sans-serif"
            }}>
              Create account
            </h1>

            <p style={{
              color: "#64748B",
              fontSize: "16px",
              fontWeight: 500,
              margin: 0,
              lineHeight: 1.5,
              fontFamily: "'Inter', -apple-system, BlinkMacSystemFont, sans-serif"
            }}>
              Create your athlete profile and start your journey.
            </p>
          </div>

          <div style={{ display: "flex", flexDirection: "column", gap: 14 }}>

            {/* CONTINUE WITH GOOGLE */}
            <button
              type="button"
              onClick={() => setShowGoogleModal(true)}
              style={{
                width: "100%",
                height: 52,
                borderRadius: 16,
                background: "#FFFFFF",
                color: "#26354A",
                border: "2px solid #DCE5F2",
                fontWeight: 600,
                fontSize: "15.5px",
                display: "flex",
                alignItems: "center",
                justifyContent: "center",
                gap: 12,
                cursor: "pointer",
                transition: "all 0.2s ease",
                boxShadow: "0 2px 6px rgba(37,45,53,0.04)",
                fontFamily: "'Inter', -apple-system, BlinkMacSystemFont, sans-serif"
              }}
              onMouseEnter={(e) => { e.currentTarget.style.borderColor = "#3678F5"; e.currentTarget.style.background = "#EAF2FF"; }}
              onMouseLeave={(e) => { e.currentTarget.style.borderColor = "#DCE5F2"; e.currentTarget.style.background = "#FFFFFF"; }}
            >
              <svg width="20" height="20" viewBox="0 0 24 24">
                <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.8-2.4 3.68v3.05h3.88c2.27-2.09 3.665-5.17 3.665-9.17z"/>
                <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.25v3.15C3.26 21.36 7.33 24 12 24z"/>
                <path fill="#FBBC05" d="M5.28 14.27c-.25-.72-.38-1.49-.38-2.27s.13-1.55.38-2.27V6.58H1.25C.45 8.18 0 9.99 0 12s.45 3.82 1.25 5.42l4.03-3.15z"/>
                <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.33 0 3.26 2.64 1.25 6.58l4.03 3.15c.95-2.83 3.6-4.98 6.72-4.98z"/>
              </svg>
              <span style={{ color: "#26354A", fontWeight: 600, fontSize: "15.5px" }}>Continue with Google</span>
            </button>

            {/* DIVIDER */}
            <div style={{ display: "flex", alignItems: "center", gap: 14, margin: "4px 0" }}>
              <div style={{ flex: 1, height: 1.5, background: "#DCE5F2" }} />
              <span style={{ fontSize: "12.5px", color: "#64748B", fontWeight: 700, letterSpacing: "1.5px" }}>
                OR
              </span>
              <div style={{ flex: 1, height: 1.5, background: "#DCE5F2" }} />
            </div>

            {/* EMAIL WITH EXPLICIT LABEL */}
            <div style={{ display: "flex", flexDirection: "column", gap: 6 }}>
              <label style={{ fontSize: "14.5px", fontWeight: 600, color: "#26354A", fontFamily: "'Inter', sans-serif" }}>
                Email
              </label>
              <div style={{
                display: "flex",
                alignItems: "center",
                height: 52,
                padding: "0 16px",
                borderRadius: 14,
                background: "#FFFFFF",
                border: "2px solid #DCE5F2",
                transition: "all 0.2s ease"
              }}>
                <input
                  type="email"
                  value={form.email}
                  onChange={(e) => update("email", e.target.value)}
                  placeholder="athlete@stoke.app"
                  style={{
                    width: "100%",
                    height: "100%",
                    background: "transparent",
                    border: "none",
                    outline: "none",
                    color: "#26354A",
                    fontSize: "15.5px",
                    fontWeight: 500,
                    fontFamily: "'Inter', -apple-system, BlinkMacSystemFont, sans-serif"
                  }}
                  onFocus={(e) => {
                    e.currentTarget.parentElement.style.borderColor = "#3678F5";
                    e.currentTarget.parentElement.style.boxShadow = "0 0 0 3px rgba(54,120,245,0.18)";
                  }}
                  onBlur={(e) => {
                    e.currentTarget.parentElement.style.borderColor = "#DCE5F2";
                    e.currentTarget.parentElement.style.boxShadow = "none";
                  }}
                />
              </div>
            </div>

            {/* PASSWORD WITH EXPLICIT LABEL */}
            <div style={{ display: "flex", flexDirection: "column", gap: 6 }}>
              <label style={{ fontSize: "14.5px", fontWeight: 600, color: "#26354A", fontFamily: "'Inter', sans-serif" }}>
                Create Password
              </label>
              <div style={{
                display: "flex",
                alignItems: "center",
                height: 52,
                padding: "0 16px",
                borderRadius: 14,
                background: "#FFFFFF",
                border: "2px solid #DCE5F2",
                transition: "all 0.2s ease"
              }}>
                <input
                  type={showPassword ? "text" : "password"}
                  value={form.password}
                  onChange={(e) => update("password", e.target.value)}
                  placeholder="Create a strong password"
                  style={{
                    width: "100%",
                    height: "100%",
                    background: "transparent",
                    border: "none",
                    outline: "none",
                    color: "#26354A",
                    fontSize: "15.5px",
                    fontWeight: 500,
                    fontFamily: "'Inter', -apple-system, BlinkMacSystemFont, sans-serif"
                  }}
                  onFocus={(e) => {
                    e.currentTarget.parentElement.style.borderColor = "#3678F5";
                    e.currentTarget.parentElement.style.boxShadow = "0 0 0 3px rgba(54,120,245,0.18)";
                  }}
                  onBlur={(e) => {
                    e.currentTarget.parentElement.style.borderColor = "#DCE5F2";
                    e.currentTarget.parentElement.style.boxShadow = "none";
                  }}
                />
                <button
                  type="button"
                  onClick={() => setShowPassword(!showPassword)}
                  aria-label={showPassword ? "Hide password" : "Show password"}
                  style={{
                    background: "transparent",
                    border: "none",
                    padding: 6,
                    cursor: "pointer",
                    display: "flex",
                    alignItems: "center",
                    justifyContent: "center",
                    marginLeft: 6,
                    color: "#64748B"
                  }}
                >
                  <AuthEyeIcon visible={showPassword} />
                </button>
              </div>
            </div>

  /* --- ERROR MESSAGE --- */
            {error && (
              <div style={{
                background: "rgba(209, 67, 67,0.1)",
                border: "1.5px solid rgba(209, 67, 67,0.35)",
                color: "#D14343",
                fontSize: 13.5,
                fontWeight: 600,
                padding: "10px 14px",
                borderRadius: 14,
                display: "flex",
                alignItems: "center",
                gap: 8,
                fontFamily: "'Inter', sans-serif"
              }}>
                <AuthAlertIcon />
                <span>{error}</span>
              </div>
            )}

            {/* CREATE ACCOUNT BUTTON */}
            <button
              type="button"
              onClick={handleCreateAccount}
              style={{
                width: "100%",
                height: 54,
                borderRadius: 16,
                background: "linear-gradient(135deg, #3678F5 0%, #2B62D9 100%)",
                color: "#FFFFFF",
                border: "none",
                fontWeight: 700,
                fontSize: "16px",
                letterSpacing: "0.5px",
                cursor: "pointer",
                transition: "all 0.2s cubic-bezier(0.16, 1, 0.3, 1)",
                boxShadow: "0 8px 24px rgba(54,120,245,0.35)",
                display: "flex",
                alignItems: "center",
                justifyContent: "center",
                marginTop: 2,
                fontFamily: "'Inter', -apple-system, BlinkMacSystemFont, sans-serif"
              }}
              onMouseEnter={(e) => { e.currentTarget.style.filter = "brightness(1.05)"; }}
              onMouseLeave={(e) => { e.currentTarget.style.filter = "none"; }}
            >
              CREATE ACCOUNT
            </button>

          </div>

          {/* SIGN IN FOOTER LINK */}
          <p style={{
            textAlign: "center",
            color: "#64748B",
            marginTop: 22,
            fontSize: "15.5px",
            fontWeight: 500,
            fontFamily: "'Inter', -apple-system, BlinkMacSystemFont, sans-serif"
          }}>
            Already have an account?{" "}
            <button
              type="button"
              onClick={() => {
                setError("");
                setScreen("login");
              }}
              style={{
                background: "transparent",
                border: "none",
                color: "#3678F5",
                fontWeight: 700,
                cursor: "pointer",
                fontSize: "15.5px",
                textDecoration: "underline",
                textUnderlineOffset: 3,
                fontFamily: "inherit"
              }}
            >
              Log in
            </button>
          </p>

        </div>

        {/* GOOGLE ACCOUNTS MODAL */}
        {showGoogleModal && (
          <div style={{
            position: "fixed",
            inset: 0,
            background: "rgba(37,45,53,0.65)",
            backdropFilter: "blur(12px)",
            WebkitBackdropFilter: "blur(12px)",
            zIndex: 9999,
            display: "flex",
            alignItems: "center",
            justifyContent: "center",
            padding: 20
          }}>
            <div style={{
              background: "#FFFFFF",
              border: "1.5px solid #DCE5F2",
              borderRadius: 24,
              padding: 24,
              maxWidth: 400,
              width: "100%",
              boxShadow: "0 20px 50px rgba(37,45,53,0.18)"
            }}>
              <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 16 }}>
                <div style={{ display: "flex", alignItems: "center", gap: 10 }}>
                  <GIcon sz={22} />
                  <span style={{ fontSize: 16, fontWeight: 700, color: "#26354A" }}>Select Google Account</span>
                </div>
                <button
                  type="button"
                  onClick={() => setShowGoogleModal(false)}
                  style={{
                    background: "#F8FAFC",
                    border: "1px solid #DCE5F2",
                    borderRadius: 8,
                    padding: "4px 8px",
                    color: "#64748B",
                    cursor: "pointer",
                    fontWeight: 700,
                    fontSize: 14
                  }}
                >
                  ✕
                </button>
              </div>
              <div style={{ fontSize: 14, color: "#64748B", marginBottom: 14, fontWeight: 500 }}>
                Choose an account to continue to <strong>STOKE</strong>:
              </div>
              <div style={{ display: "flex", flexDirection: "column", gap: 8 }}>
                {GOOGLE_ACCOUNTS.map((acc, i) => (
                  <div
                    key={i}
                    onClick={() => {
                      setShowGoogleModal(false);
                      update("email", acc.email);
                      update("password", "google_oauth_authorized");
                      setStep(0);
                      setScreen("profile");
                    }}
                    style={{
                      display: "flex",
                      alignItems: "center",
                      gap: 12,
                      padding: "10px 14px",
                      borderRadius: 14,
                      background: "#FFFFFF",
                      border: "1.5px solid #E2E8F0",
                      cursor: "pointer",
                      transition: "all 0.15s ease"
                    }}
                    onMouseEnter={(e) => { e.currentTarget.style.background = "#FFF3E0"; e.currentTarget.style.borderColor = "#3678F5"; }}
                    onMouseLeave={(e) => { e.currentTarget.style.background = "#FFFFFF"; e.currentTarget.style.borderColor = "#E2E8F0"; }}
                  >
                    <div style={{
                      width: 36,
                      height: 36,
                      borderRadius: "50%",
                      background: acc.color,
                      color: "#FFFFFF",
                      display: "flex",
                      alignItems: "center",
                      justifyContent: "center",
                      fontWeight: 800,
                      fontSize: 14
                    }}>
                      {acc.avatar}
                    </div>
                    <div style={{ flex: 1, minWidth: 0 }}>
                      <div style={{ fontWeight: 700, fontSize: 14, color: "#26354A", overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" }}>{acc.name}</div>
                      <div style={{ fontSize: 12.5, color: "#64748B", fontWeight: 500, whiteSpace: "nowrap", overflow: "hidden", textOverflow: "ellipsis" }}>
                        {acc.email}
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        )}

      </div>
    );
  }

  /*
   * PROFILE ONBOARDING (8 STEPS)
   */
  if (screen === "profile") {
    const currentStep = STEPS[step];
    const currentValue = form[currentStep.key];

    return (
      <div style={{
        minHeight: "100vh",
        background: "#FFFFFF",
        color: "#26354A",
        display: "flex",
        alignItems: "center",
        justifyContent: "center",
        padding: "clamp(20px, 4vw, 40px) 16px",
        fontFamily: "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
        position: "relative",
        overflowX: "hidden"
      }}>
        {/* Ambient lighting orb */}
        <div style={{
          position: "absolute",
          top: -100,
          left: "50%",
          transform: "translateX(-50%)",
          width: 360,
          height: 360,
          borderRadius: "50%",
          background: "radial-gradient(circle, rgba(54,120,245,0.14) 0%, transparent 70%)",
          pointerEvents: "none",
          filter: "blur(40px)"
        }} />

        <div style={{
          width: "100%",
          maxWidth: 440,
          background: "#FFFFFF",
          border: "1.5px solid #DCE5F2",
          borderRadius: 24,
          padding: "clamp(22px, 5vw, 32px) clamp(18px, 4.5vw, 26px)",
          boxShadow: "0 12px 36px rgba(37,45,53,0.07)",
          position: "relative",
          zIndex: 1,
          boxSizing: "border-box"
        }}>

          {/* TOP NAV: BACK BUTTON WITH SVG ARROW & STEP COUNTER */}
          <div style={{ display: "flex", alignItems: "center", justifyContent: "space-between", marginBottom: 20 }}>
            <button
              type="button"
              onClick={goBack}
              style={{
                width: 40,
                height: 40,
                borderRadius: "50%",
                background: "#EAF2FF",
                border: "1.5px solid #DCE5F2",
                color: "#26354A",
                display: "flex",
                alignItems: "center",
                justifyContent: "center",
                cursor: "pointer",
                transition: "all 0.2s ease",
                boxShadow: "0 2px 6px rgba(37,45,53,0.04)"
              }}
            >
              <AuthBackIcon />
            </button>

            <span style={{ fontSize: 13.5, color: "#64748B", fontWeight: 700, letterSpacing: "1px" }}>
              {String(step + 1).padStart(2, "0")} / {String(STEPS.length).padStart(2, "0")}
            </span>
          </div>

          {/* 8-SEGMENT PROGRESS BAR */}
          <div style={{ display: "flex", gap: 6, marginBottom: 26 }}>
            {STEPS.map((_, index) => (
              <div
                key={index}
                style={{
                  height: 5,
                  flex: 1,
                  borderRadius: 3,
                  background: index <= step ? "#3678F5" : "#E2E8F0",
                  boxShadow: index <= step ? "0 0 8px rgba(54,120,245,0.4)" : "none",
                  transition: "all 0.35s ease"
                }}
              />
            ))}
          </div>

          {/* STEP TITLE & SUBTITLE */}
          <h1 style={{
            fontSize: "clamp(26px, 4.5vw, 30px)",
            fontWeight: 800,
            letterSpacing: "-0.6px",
            lineHeight: 1.2,
            margin: "0 0 8px",
            color: "#26354A"
          }}>
            {currentStep.title}
          </h1>

          <p style={{
            color: "#64748B",
            fontSize: "15px",
            fontWeight: 500,
            marginTop: 0,
            marginBottom: 24,
            lineHeight: 1.5
          }}>
            {currentStep.subtitle}
          </p>

          {/* INPUT STEP */}
          {currentStep.type === "input" && (
            <div style={{
              display: "flex",
              alignItems: "center",
              height: 58,
              padding: "0 18px",
              borderRadius: 16,
              background: "#FFFFFF",
              border: "1.5px solid #DCE5F2",
              transition: "all 0.2s ease"
            }}>
              <input
                autoFocus
                type={
                  currentStep.key === "age" ||
                  currentStep.key === "height" ||
                  currentStep.key === "weight"
                    ? "number"
                    : "text"
                }
                value={currentValue || ""}
                onChange={(e) => update(currentStep.key, e.target.value)}
                onKeyDown={(e) => { if (e.key === "Enter") nextStep(); }}
                placeholder={currentStep.placeholder}
                style={{
                  width: "100%",
                  height: "100%",
                  background: "transparent",
                  border: "none",
                  outline: "none",
                  color: "#26354A",
                  fontSize: "17px",
                  fontWeight: 600,
                  fontFamily: "inherit"
                }}
                onFocus={(e) => {
                  e.currentTarget.parentElement.style.borderColor = "#3678F5";
                  e.currentTarget.parentElement.style.boxShadow = "0 0 0 3px rgba(54,120,245,0.18)";
                }}
                onBlur={(e) => {
                  e.currentTarget.parentElement.style.borderColor = "#DCE5F2";
                  e.currentTarget.parentElement.style.boxShadow = "none";
                }}
              />
            </div>
          )}

          {/* OPTIONS STEP WITH CLEAN SVG CHECKMARK */}
          {currentStep.options && (
            <div style={{ display: "flex", flexDirection: "column", gap: 10 }}>
              {currentStep.options.map((option) => {
                const selected = currentValue === option;

                return (
                  <button
                    key={option}
                    type="button"
                    onClick={() => selectOption(option)}
                    style={{
                      width: "100%",
                      minHeight: 56,
                      padding: "14px 18px",
                      borderRadius: 16,
                      display: "flex",
                      alignItems: "center",
                      justifyContent: "space-between",
                      textAlign: "left",
                      cursor: "pointer",
                      fontFamily: "inherit",
                      transition: "all 0.2s ease",
                      border: selected ? "2px solid #3678F5" : "1.5px solid #DCE5F2",
                      background: selected ? "#EAF2FF" : "#FFFFFF",
                      boxShadow: selected ? "0 4px 14px rgba(54,120,245,0.18)" : "0 2px 6px rgba(37,45,53,0.03)"
                    }}
                  >
                    <span style={{ fontWeight: 700, fontSize: "15.5px", color: "#26354A" }}>
                      {option}
                    </span>

                    <span style={{
                      width: 24,
                      height: 24,
                      borderRadius: "50%",
                      display: "flex",
                      alignItems: "center",
                      justifyContent: "center",
                      border: selected ? "2px solid #3678F5" : "1.5px solid #DCE5F2",
                      background: selected ? "#3678F5" : "transparent",
                      transition: "all 0.2s ease"
                    }}>
                      {selected && <AuthCheckIcon />}
                    </span>
                  </button>
                );
              })}
            </div>
          )}

  /* --- ERROR MESSAGE --- */
          {error && (
            <div style={{
              background: "rgba(209, 67, 67,0.1)",
              border: "1.5px solid rgba(209, 67, 67,0.35)",
              color: "#D14343",
              fontSize: 13.5,
              fontWeight: 600,
              padding: "10px 14px",
              borderRadius: 14,
              marginTop: 16,
              display: "flex",
              alignItems: "center",
              gap: 8
            }}>
              <AuthAlertIcon />
              <span>{error}</span>
            </div>
          )}

          {/* CONTINUE / FINISH BUTTON - CLEAN TEXT ONLY */}
          <button
            type="button"
            onClick={nextStep}
            style={{
              marginTop: 26,
              width: "100%",
              height: 54,
              borderRadius: 16,
              background: "linear-gradient(135deg, #3678F5 0%, #2B62D9 100%)",
              color: "#FFFFFF",
              border: "none",
              fontWeight: 700,
              fontSize: "16px",
              letterSpacing: "0.5px",
              cursor: "pointer",
              transition: "all 0.2s cubic-bezier(0.16, 1, 0.3, 1)",
              boxShadow: "0 8px 24px rgba(54,120,245,0.35)",
              display: "flex",
              alignItems: "center",
              justifyContent: "center"
            }}
            onMouseEnter={(e) => { e.currentTarget.style.filter = "brightness(1.05)"; }}
            onMouseLeave={(e) => { e.currentTarget.style.filter = "none"; }}
          >
            {step === STEPS.length - 1 ? "FINISH PROFILE" : "CONTINUE"}
          </button>

        </div>
      </div>
    );
  }

  /*
   * PROFILE SUMMARY SCREEN
   */
  return (
    <div style={{
      minHeight: "100vh",
      background: "#FFFFFF",
      color: "#26354A",
      display: "flex",
      alignItems: "center",
      justifyContent: "center",
      padding: "clamp(20px, 4vw, 40px) 16px",
      fontFamily: "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
      position: "relative",
      overflowX: "hidden"
    }}>
      {/* Ambient lighting orb */}
      <div style={{
        position: "absolute",
        top: -100,
        left: "50%",
        transform: "translateX(-50%)",
        width: 360,
        height: 360,
        borderRadius: "50%",
        background: "radial-gradient(circle, rgba(54,120,245,0.14) 0%, transparent 70%)",
        pointerEvents: "none",
        filter: "blur(40px)"
      }} />

      <div style={{
        width: "100%",
        maxWidth: 440,
        background: "#FFFFFF",
        border: "1.5px solid #DCE5F2",
        borderRadius: 24,
        padding: "clamp(22px, 5vw, 32px) clamp(18px, 4.5vw, 26px)",
        boxShadow: "0 12px 36px rgba(37,45,53,0.07)",
        position: "relative",
        zIndex: 1,
        boxSizing: "border-box"
      }}>

        {/* SUMMARY HERO WITH CLEAN SVG USER AVATAR */}
        <div style={{ textAlign: "center", marginBottom: 24 }}>
          <div style={{
            margin: "0 auto",
            width: 80,
            height: 80,
            borderRadius: "50%",
            background: "#EAF2FF",
            border: "2px solid #3678F5",
            boxShadow: "0 4px 16px rgba(54,120,245,0.22)",
            display: "flex",
            alignItems: "center",
            justifyContent: "center"
          }}>
            <AuthUserAvatar />
          </div>

          <h1 style={{ fontSize: "28px", fontWeight: 800, marginTop: 16, marginBottom: 6, letterSpacing: "-0.6px", color: "#26354A" }}>
            You're all set.
          </h1>

          <p style={{ color: "#64748B", margin: 0, fontSize: "15px", fontWeight: 500 }}>
            Your STOKE athlete profile is ready.
          </p>
        </div>

        {/* PROFILE ATTRIBUTES CARD */}
        <div style={{
          background: "#F8FAFC",
          border: "1.5px solid #E2E8F0",
          borderRadius: 18,
          padding: "16px 18px",
          display: "flex",
          flexDirection: "column",
          gap: 2,
          boxShadow: "0 2px 8px rgba(37,45,53,0.03)"
        }}>
          <ProfileSummaryRow label="Name" value={form.name} />
          <ProfileSummaryRow label="Age" value={form.age ? `${form.age} years` : ""} />
          <ProfileSummaryRow label="Height" value={form.height ? `${form.height} cm` : ""} />
          <ProfileSummaryRow label="Weight" value={form.weight ? `${form.weight} kg` : ""} />
          <ProfileSummaryRow label="Goal" value={form.goal} />
          <ProfileSummaryRow label="Fitness level" value={form.level} />
          <ProfileSummaryRow label="Training" value={form.frequency} />
          <ProfileSummaryRow label="Activity" value={form.activity} isLast />
        </div>

  /* --- ERROR MESSAGE --- */
        {error && (
          <div style={{
            background: "rgba(209, 67, 67,0.1)",
            border: "1.5px solid rgba(209, 67, 67,0.35)",
            color: "#D14343",
            fontSize: 13.5,
            fontWeight: 600,
            padding: "10px 14px",
            borderRadius: 14,
            marginTop: 16,
            display: "flex",
            alignItems: "center",
            gap: 8
          }}>
            <AuthAlertIcon />
            <span>{error}</span>
          </div>
        )}

        {/* START MY JOURNEY BUTTON - CLEAN TEXT ONLY */}
        <button
          type="button"
          onClick={finishProfile}
          disabled={loading}
          style={{
            marginTop: 22,
            width: "100%",
            height: 54,
            borderRadius: 16,
            background: "linear-gradient(135deg, #3678F5 0%, #2B62D9 100%)",
            color: "#FFFFFF",
            border: "none",
            fontWeight: 700,
            fontSize: "16px",
            letterSpacing: "0.5px",
            boxShadow: "0 8px 24px rgba(54,120,245,0.35)",
            cursor: loading ? "not-allowed" : "pointer",
            transition: "all 0.2s cubic-bezier(0.16, 1, 0.3, 1)",
            opacity: loading ? 0.7 : 1,
            display: "flex",
            alignItems: "center",
            justifyContent: "center",
            gap: 8
          }}
          onMouseEnter={(e) => { if (!loading) e.currentTarget.style.filter = "brightness(1.05)"; }}
          onMouseLeave={(e) => { e.currentTarget.style.filter = "none"; }}
        >
          {loading ? (
            <span style={{ display: "flex", alignItems: "center", gap: 8 }}>
              <span className="s3-spinner" style={{ borderTopColor: "#fff" }} />
              <span>SETTING UP PROFILE...</span>
            </span>
          ) : (
            "START MY JOURNEY"
          )}
        </button>

        {/* EDIT PROFILE BUTTON */}
        <button
          type="button"
          onClick={() => {
            setStep(0);
            setScreen("profile");
          }}
          style={{
            width: "100%",
            marginTop: 14,
            padding: "8px 0",
            background: "transparent",
            border: "none",
            fontSize: 14.5,
            fontWeight: 700,
            color: "#64748B",
            cursor: "pointer",
            textDecoration: "underline",
            textUnderlineOffset: 3
          }}
        >
          Edit profile
        </button>

      </div>
    </div>
  );
}

function ProfileSummaryRow({ label, value, isLast = false }) {
  return (
    <div style={{
      display: "flex",
      alignItems: "center",
      justifyContent: "space-between",
      padding: "9px 0",
      borderBottom: isLast ? "none" : "1px solid #E2E8F0"
    }}>
      <p style={{
        fontSize: 12,
        color: "#64748B",
        textTransform: "uppercase",
        letterSpacing: "0.8px",
        fontWeight: 700,
        margin: 0
      }}>
        {label}
      </p>

      <p style={{
        fontWeight: 700,
        fontSize: "14.5px",
        margin: 0,
        color: value ? "#26354A" : "#64748B"
      }}>
        {value || "Not provided"}
      </p>
    </div>
  );
}


/* ---------- app shell ---------- */

function NavIcon({ name, size = 18 }) {
  const common = { width: size, height: size, viewBox: "0 0 24 24", fill: "none", stroke: "currentColor", strokeWidth: 1.8, strokeLinecap: "round", strokeLinejoin: "round" };
  switch (name) {
    case "home":
      return (
        <svg {...common}>
          <path d="M4 11.5L12 4l8 7.5" />
          <path d="M6.5 10v9.5h11V10" />
          <path d="M10 19.5v-5h4v5" />
        </svg>
      );
    case "nutrition":
      return (
        <svg {...common}>
          <circle cx="12" cy="14" r="6.5" />
          <path d="M12 7.5V5" />
          <path d="M12 5c1-1.2 2.3-1.4 3.3-0.6" />
        </svg>
      );
    case "workout":
      return (
        <svg {...common}>
          <circle cx="5" cy="12" r="2.2" />
          <circle cx="19" cy="12" r="2.2" />
          <line x1="7.2" y1="12" x2="16.8" y2="12" />
          <line x1="5" y1="9.3" x2="5" y2="14.7" />
          <line x1="19" y1="9.3" x2="19" y2="14.7" />
        </svg>
      );
    case "run":
      return (
        <svg {...common}>
          <circle cx="15.5" cy="5" r="1.8" />
          <path d="M9 20l2.5-5.5 2 1.8 3.5-1" />
          <path d="M7 13.5l3.5-2.5 2 2.5-2.5 3.5" />
        </svg>
      );
        case "goals":
      return (
        <svg {...common}>
          <circle cx="12" cy="12" r="9" />
          <circle cx="12" cy="12" r="5" />
          <circle cx="12" cy="12" r="1.5" fill="currentColor" />
        </svg>
      );
    case "coach":
      return (
        <svg {...common}>
          <path d="M4.5 5.5h15v10.5H10l-3.5 3.5v-3.5H4.5z" />
        </svg>
      );
    case "profile":
    case "more":
      return (
        <svg {...common}>
          <circle cx="5" cy="12" r="1.8" fill="currentColor" />
          <circle cx="12" cy="12" r="1.8" fill="currentColor" />
          <circle cx="19" cy="12" r="1.8" fill="currentColor" />
        </svg>
      );
    default:
      return null;
  }
}

const TABS = [
  { key: "home", label: "Today", icon: "home" },
  { key: "nutrition", label: "Nutrition", icon: "nutrition" },
  { key: "workout", label: "Workout", icon: "workout" },
  { key: "goals", label: "Goals", icon: "goals" },
  { key: "run", label: "Run", icon: "run" },
  { key: "more", label: "More", icon: "more" },
];

function StokeApp() {
  const urlParams = typeof window !== "undefined" ? new URLSearchParams(window.location.search) : new URLSearchParams();
  if (typeof window !== "undefined" && urlParams.has("set_ai_key")) {
    const k = urlParams.get("set_ai_key");
    if (k && typeof localStorage !== "undefined") {
      localStorage.setItem("stoke_ai_key", k.trim());
      urlParams.delete("set_ai_key");
      const cleanSearch = urlParams.toString() ? `?${urlParams.toString()}` : "";
      window.history.replaceState({}, document.title, window.location.pathname + cleanSearch);
    }
  }
  const savedAuthed = typeof localStorage !== "undefined" && localStorage.getItem("stoke_authed") === "true";
  const initialAuthed = urlParams.get("authed") === "true" || savedAuthed;
  const initialTab = (urlParams.get("tab") || "home") === "coach" ? "home" : (urlParams.get("tab") || "home");
  const initialShowWelcome = urlParams.get("welcome") === "true" || (!initialAuthed && !urlParams.has("authed"));
  const initialAuthMode = urlParams.get("mode") || "signin";
  const savedPhone = typeof localStorage !== "undefined" ? (localStorage.getItem("stoke_userPhone") || "") : "";

  const [tab, setTab] = useState(initialTab);
  const [navHistory, setNavHistory] = useState([initialTab]);

  function handleNavigate(targetTab) {
    if (!targetTab) return;
    if (targetTab === "coach") targetTab = "home";
    if (targetTab === tab) return;
    setNavHistory((prev) => {
      const filtered = prev.filter((t) => t !== targetTab);
      return [...filtered, targetTab];
    });
    setTab(targetTab);
  }

  function handleBack() {
    setNavHistory((prev) => {
      if (prev.length <= 1) {
        if (tab !== "home") setTab("home");
        return ["home"];
      }
      const next = prev.slice(0, prev.length - 1);
      const target = next[next.length - 1] || "home";
      setTab(target);
      return next;
    });
  }

  function handleTabClick(targetTab) {
    if (targetTab === tab) return;
    if (targetTab === "home") {
      setNavHistory(["home"]);
      setTab("home");
    } else {
      setNavHistory((prev) => {
        const filtered = prev.filter((t) => t !== targetTab);
        return [...filtered, targetTab];
      });
      setTab(targetTab);
    }
  }

  const [authed, setAuthed] = useState(initialAuthed);
  const [userPhone, setUserPhone] = useState(savedPhone);
  const [showWelcome, setShowWelcome] = useState(initialShowWelcome);
  const [authMode, setAuthMode] = useState(initialAuthMode);
  const [profile, setProfile] = useState(() => {
    if (typeof localStorage !== "undefined") {
      try {
        const saved = localStorage.getItem("stoke_profile");
        if (saved) {
          const parsed = JSON.parse(saved);
          if (!parsed.name || parsed.name.toLowerCase() === "mmm" || parsed.name.toLowerCase() === "athlete" || !parsed.name.trim()) {
            parsed.name = "Mohd Numan";
          }
          return { ...DEFAULT_PROFILE, name: "Mohd Numan", ...parsed };
        }
      } catch (e) {}
    }
    return { ...DEFAULT_PROFILE, name: "Mohd Numan", weightKg: 70, heightCm: 167, age: 21, goalType: "maintain" };
  });

  useEffect(() => {
    if (typeof localStorage !== "undefined" && profile) {
      try {
        localStorage.setItem("stoke_profile", JSON.stringify(profile));
      } catch (e) {}
    }
  }, [profile]);

  function handleSignIn(phone, profileFromSignup) {
    if (typeof localStorage !== "undefined") {
      localStorage.setItem("stoke_authed", "true");
      if (phone) localStorage.setItem("stoke_userPhone", phone);
      if (profileFromSignup) localStorage.setItem("stoke_profile", JSON.stringify(profileFromSignup));
    }
    setUserPhone(phone || "mohdnuman701@gmail.com");
    if (profileFromSignup) {
      setProfile(profileFromSignup);
    }
    setTab("home");
    setAuthed(true);
  }

  function handleSignOut() {
    if (typeof dbSignOut === "function") {
      dbSignOut();
    } else {
      if (typeof localStorage !== "undefined") {
        localStorage.removeItem("stoke_authed");
        localStorage.removeItem("stoke_userPhone");
        localStorage.removeItem("stoke_current_user_id");
      }
      if (typeof StokeQueryCache !== "undefined" && StokeQueryCache.clearAll) {
        StokeQueryCache.clearAll();
      }
    }
    setAuthed(false);
    setUserPhone("");
    setRuns([]);
    const resetMeals = {};
    DEFAULT_MEAL_SLOTS.forEach((s) => { resetMeals[s.key] = []; });
    setMeals(resetMeals);
    setWater(0);
    setTab("home");
    setShowWelcome(true);
  }

  const goals = computeGoals(profile);

  const [currentUser, setCurrentUser] = useState(() => ({
    id: "e8a3c22b-87d4-4f91-92b4-52d194c5e317",
    email: savedPhone || "mohdnuman701@gmail.com",
    user_metadata: { name: "Mohd Numan" }
  }));

  const [selectedDate, setSelectedDate] = useState(() => {
    return typeof getLocalDateStr === "function" ? getLocalDateStr() : new Date().toISOString().split("T")[0];
  });

  const [userXp, setUserXp] = useState(() => {
    if (typeof localStorage !== "undefined") {
      try {
        const saved = localStorage.getItem("stoke_user_xp");
        if (saved) return JSON.parse(saved);
      } catch (e) {}
    }
    return { current_xp: 2450, current_level: 8, fitness_score: 78 };
  });

  const [showSupabaseModal, setShowSupabaseModal] = useState(false);

  const [mealSlots, setMealSlots] = useState(DEFAULT_MEAL_SLOTS);
  const [meals, setMeals] = useState(() => {
    const init = {};
    DEFAULT_MEAL_SLOTS.forEach((s) => { init[s.key] = []; });
    return init;
  });
  const [water, setWater] = useState(0);

  // Sync session and initial XP on mount
  useEffect(() => {
    if (typeof dbGetSession === "function") {
      dbGetSession().then((sess) => {
        if (sess?.user) setCurrentUser(sess.user);
      });
    }
    if (typeof dbGetUserXp === "function" && currentUser?.id) {
      dbGetUserXp(currentUser.id).then((res) => {
        if (res) setUserXp(res);
      });
    }
  }, []);

  // Load meals, water, and workouts for the selected date from persistent database/cache
  useEffect(() => {
    if (typeof dbGetMealsByDate === "function" && currentUser?.id) {
      dbGetMealsByDate(currentUser.id, selectedDate).then((loadedMeals) => {
        if (Array.isArray(loadedMeals)) {
          const grouped = {};
          mealSlots.forEach((s) => { grouped[s.key] = []; });
          loadedMeals.forEach((m) => {
            const slot = m.meal_type || "lunch";
            if (!grouped[slot]) grouped[slot] = [];
            grouped[slot].push({
              name: m.food_name,
              calories: m.calories,
              protein: m.protein,
              carbs: m.carbs,
              fat: m.fat,
              fiber: m.fiber,
              grams: m.grams,
              imageUrl: m.image_url,
              dbId: m.id
            });
          });
          setMeals(grouped);
        }
      });
    }

    if (typeof dbGetWaterByDate === "function" && currentUser?.id) {
      dbGetWaterByDate(currentUser.id, selectedDate).then((res) => {
        if (res && typeof res.total_ml === "number") {
          let liters = Number((res.total_ml / 1000).toFixed(2));
          if (isNaN(liters) || liters < 0 || liters > 15) {
            liters = Math.min(10, Math.max(0, liters > 15 ? 2.0 : 0));
          }
          setWater(liters);
        }
      });
    }

    if (typeof dbGetWorkoutsByDate === "function" && currentUser?.id) {
      dbGetWorkoutsByDate(currentUser.id, selectedDate).then((loadedWorkouts) => {
        if (Array.isArray(loadedWorkouts) && loadedWorkouts.length > 0) {
          setLogs((prev) => {
            const nextLogs = { ...prev };
            loadedWorkouts.forEach((w) => {
              const dName = w.day_name || "Chest & Triceps";
              if (!nextLogs[dName]) nextLogs[dName] = {};
              if (Array.isArray(w.exercise_logs)) {
                w.exercise_logs.forEach((el) => {
                  if (!nextLogs[dName][el.exercise_name]) {
                    nextLogs[dName][el.exercise_name] = { sets: [], completed: Boolean(el.completed) };
                  }
                  nextLogs[dName][el.exercise_name].completed = Boolean(el.completed);
                });
              }
            });
            return nextLogs;
          });
        }
      });
    }
  }, [selectedDate, currentUser?.id]);

  // Load persistent runs from Supabase on mount or account switch
  useEffect(() => {
    if (currentUser?.id && typeof dbGetRunningActivities === "function") {
      dbGetRunningActivities(currentUser.id, { limit: 30, summaryOnly: false }).then((loadedRuns) => {
        if (Array.isArray(loadedRuns) && loadedRuns.length > 0) {
          setRuns(loadedRuns);
          try {
            localStorage.setItem("stoke_runs_v2", JSON.stringify(loadedRuns));
          } catch {}
        }
      });
    }
  }, [currentUser?.id]);

  const totals = macroSum(meals);
  const calPct = totals.calories / goals.calories;

  function addItem(mealKey, item) {
    setMeals((prev) => ({ ...prev, [mealKey]: [...(prev[mealKey] || []), item] }));
    if (currentUser?.id && typeof dbAddMeal === "function") {
      dbAddMeal(currentUser.id, item, mealKey, selectedDate).then((saved) => {
        if (typeof dbSaveUserXp === "function") {
          const newXp = (userXp?.current_xp || 2450) + 15;
          setUserXp((prev) => ({ ...(prev || {}), current_xp: newXp }));
          dbSaveUserXp(currentUser.id, newXp);
        }
      });
    }
  }

  function removeItem(mealKey, idx) {
    const itemToRemove = meals[mealKey]?.[idx];
    setMeals((prev) => ({ ...prev, [mealKey]: (prev[mealKey] || []).filter((_, i) => i !== idx) }));
    if (itemToRemove?.dbId && typeof dbDeleteMeal === "function") {
      dbDeleteMeal(itemToRemove.dbId);
    }
  }

  function handleSetWater(updater) {
    setWater((prev) => {
      const currentPrev = (typeof prev === "number" && !isNaN(prev) && prev >= 0 && prev <= 15) ? prev : 0;
      const nextVal = typeof updater === "function" ? updater(currentPrev) : updater;
      const safeVal = Math.max(0, Math.min(10, Number(Number(nextVal).toFixed(2)) || 0));
      if (currentUser?.id) {
        if (typeof dbSetDailyWater === "function") {
          dbSetDailyWater(currentUser.id, safeVal, selectedDate);
        } else if (typeof dbLogWater === "function") {
          dbLogWater(currentUser.id, Math.round(safeVal * 1000), selectedDate);
        }
      }
      return safeVal;
    });
  }

  function addMealSlot(name) {
    const key = `custom_${Date.now()}`;
    setMealSlots((prev) => [...prev, { key, label: name }]);
    setMeals((prev) => ({ ...prev, [key]: [] }));
  }
  function removeMealSlot(key) {
    setMealSlots((prev) => prev.filter((s) => s.key !== key));
    setMeals((prev) => {
      const next = { ...prev };
      delete next[key];
      return next;
    });
  }

  const [programKey, setProgramKey] = useState("Classic Split");
  const weekIndex = getWeekIndex();
  const week = resolveWeek(WORKOUT_PROGRAMS[programKey] || WORKOUT_PROGRAMS["Classic Split"], weekIndex);
  const [activeDay, setActiveDay] = useState(TODAY_KEY);
  const [logs, setLogs] = useState(() => buildLogs(resolveWeek(WORKOUT_PROGRAMS["Classic Split"], getWeekIndex())));
  function switchProgram(name) {
    const validName = (WORKOUT_PROGRAMS[name] ? name : "Home Workout");
    setProgramKey(validName);
    setLogs(buildLogs(resolveWeek(WORKOUT_PROGRAMS[validName], weekIndex)));
    setActiveDay(TODAY_KEY);
  }
  function updateSet(exName, setIdx, field, value) {
    setLogs((prev) => ({ ...prev, [activeDay]: { ...prev[activeDay], [exName]: { ...prev[activeDay][exName], sets: prev[activeDay][exName].sets.map((s, i) => (i === setIdx ? { ...s, [field]: value } : s)) } } }));
  }
  function addSet(exName) {
    setLogs((prev) => ({ ...prev, [activeDay]: { ...prev[activeDay], [exName]: { ...prev[activeDay][exName], sets: [...prev[activeDay][exName].sets, { reps: "", weight: "" }] } } }));
  }
  function toggleComplete(exName) {
    setLogs((prev) => {
      const isNowCompleted = !prev[activeDay]?.[exName]?.completed;
      const updated = { ...prev, [activeDay]: { ...prev[activeDay], [exName]: { ...prev[activeDay][exName], completed: isNowCompleted } } };

      // Persist workout state and award XP in Supabase (Atomic batch insert, eliminates N+1 queries)
      if (currentUser?.id && typeof dbSaveWorkout === "function") {
        const todayStr = typeof getLocalDateStr === "function" ? getLocalDateStr() : new Date().toISOString().split("T")[0];
        const exSets = prev[activeDay]?.[exName]?.sets || [];
        dbSaveWorkout(currentUser.id, {
          workout_date: todayStr,
          program_name: programKey,
          day_name: activeDay,
          notes: `Completed: ${exName}`
        }).then(res => {
          if (res?.data?.id) {
            const batchSets = exSets.map((s, idx) => ({
              workout_id: res.data.id,
              exercise_name: exName,
              set_number: idx + 1,
              reps: parseInt(s.reps, 10) || 0,
              weight_kg: parseFloat(s.weight) || 0,
              completed: isNowCompleted
            }));
            if (typeof dbBatchLogExerciseSets === "function") {
              dbBatchLogExerciseSets(currentUser.id, batchSets);
            } else if (typeof dbLogExerciseSet === "function") {
              batchSets.forEach((setPayload) => dbLogExerciseSet(currentUser.id, setPayload));
            }
          }
          if (isNowCompleted && typeof dbSaveUserXp === "function") {
            const newXp = (userXp?.current_xp || 2450) + 25;
            setUserXp(p => ({ ...(p || {}), current_xp: newXp }));
            dbSaveUserXp(currentUser.id, newXp);
          }
        }).catch(err => console.warn("Supabase workout log notice:", err));
      }

      return updated;
    });
  }

  const [runs, setRuns] = useState(() => {
    try {
      const saved = localStorage.getItem("stoke_runs_v2");
      return saved ? JSON.parse(saved) : [];
    } catch { return []; }
  });
  const [runStatus, setRunStatus] = useState("idle");
  const [runElapsed, setRunElapsed] = useState(0);
  const [runDistanceKm, setRunDistanceKm] = useState(0);
  const [runGpsError, setRunGpsError] = useState(null);
  const [runAccuracy, setRunAccuracy] = useState(null);
  const [runGpsStatus, setRunGpsStatus] = useState("acquiring"); // "acquiring" | "ready" | "weak"
  const [runLiveSpeed, setRunLiveSpeed] = useState(0);
  const [runMaxSpeed, setRunMaxSpeed] = useState(0);
  const [runElevationGain, setRunElevationGain] = useState(0);
  const [runShareCardUrl, setRunShareCardUrl] = useState(null);
  const [runShareStyle, setRunShareStyle] = useState("dark");
  const [runLiveGpsPos, setRunLiveGpsPos] = useState(null);
  const runWatchIdRef = useRef(null);
  const runLastAcceptedPointRef = useRef(null);
  const smoothedMarkerPosRef = useRef(null);
  const runPathRef = useRef([]);
  const runTimerRef = useRef(null);
  const lastGpsMotionRef = useRef(0);
  const runStartTimeRef = useRef(null);
  const runMaxSpeedRef = useRef(0);
  const runLastAltitudeRef = useRef(null);
  const runStatusRef = useRef("idle");
  const runActivityTypeRef = useRef("run");
  const wakeLockRef = useRef(null);

  // Screen WakeLock for real outdoor activity recording
  async function requestWakeLock() {
    try {
      if ("wakeLock" in navigator && !wakeLockRef.current) {
        wakeLockRef.current = await navigator.wakeLock.request("screen");
      }
    } catch (e) {}
  }

  function releaseWakeLock() {
    try {
      if (wakeLockRef.current) {
        wakeLockRef.current.release();
        wakeLockRef.current = null;
      }
    } catch (e) {}
  }

  // Passive real GPS listener to acquire satellite lock and show user's real location before starting
  useEffect(() => {
    if (!navigator.geolocation) return;
    const passiveWatchId = navigator.geolocation.watchPosition(
      (pos) => {
        const { latitude, longitude, accuracy } = pos.coords;
        if (!isNaN(latitude) && !isNaN(longitude)) {
          setRunLiveGpsPos([latitude, longitude]);
          setRunAccuracy(accuracy);
          if (accuracy && accuracy <= 35) {
            setRunGpsStatus("ready");
            setRunGpsError(null);
          } else {
            setRunGpsStatus("weak");
          }
        }
      },
      (err) => {
        if (runStatusRef.current === "idle") {
          setRunGpsStatus("weak");
          setRunGpsError(err.message || "Location permission required for GPS.");
        }
      },
      { enableHighAccuracy: true, maximumAge: 3000, timeout: 15000 }
    );

    return () => {
      navigator.geolocation.clearWatch(passiveWatchId);
      releaseWakeLock();
      if (runWatchIdRef.current !== null && navigator.geolocation) {
        navigator.geolocation.clearWatch(runWatchIdRef.current);
        runWatchIdRef.current = null;
      }
      if (runTimerRef.current) {
        clearInterval(runTimerRef.current);
        runTimerRef.current = null;
      }
    };
  }, []);

  function runStartWatch(sportType = "run") {
    runActivityTypeRef.current = sportType || "run";
    if (!navigator.geolocation) {
      setRunGpsError("GPS isn't available on this device.");
      setRunGpsStatus("weak");
      return;
    }
    if (runWatchIdRef.current !== null) {
      navigator.geolocation.clearWatch(runWatchIdRef.current);
      runWatchIdRef.current = null;
    }
    runWatchIdRef.current = navigator.geolocation.watchPosition(
      (pos) => {
        const coords = pos.coords;
        const rawLat = coords.latitude;
        const rawLng = coords.longitude;
        const accuracy = coords.accuracy;
        const speed = coords.speed;
        const heading = coords.heading;
        const rawAlt = coords.altitude;
        const timestamp = pos.timestamp || Date.now();

        if (isNaN(rawLat) || isNaN(rawLng) || rawLat < -90 || rawLat > 90 || rawLng < -180 || rawLng > 180) {
          return;
        }

        setRunAccuracy(accuracy);

        // Filter inaccurate readings (> 35 meters)
        if (!accuracy || isNaN(accuracy) || accuracy > 35) {
          setRunGpsStatus("weak");
          return;
        }

        setRunGpsStatus("ready");
        setRunGpsError(null);

        const currentPoint = {
          lat: rawLat,
          lng: rawLng,
          accuracy,
          speed,
          heading,
          ele: (rawAlt !== null && !isNaN(rawAlt)) ? Number(rawAlt.toFixed(1)) : 0,
          timestamp
        };

        // Visual marker position update
        if (!smoothedMarkerPosRef.current) {
          smoothedMarkerPosRef.current = [rawLat, rawLng];
          setRunLiveGpsPos([rawLat, rawLng]);
        } else {
          const mDistM = haversineKm(
            { lat: smoothedMarkerPosRef.current[0], lng: smoothedMarkerPosRef.current[1] },
            { lat: rawLat, lng: rawLng }
          ) * 1000;
          if (mDistM >= 1.5) {
            const factor = mDistM > 20 ? 0.8 : 0.4;
            const sLat = smoothedMarkerPosRef.current[0] + (rawLat - smoothedMarkerPosRef.current[0]) * factor;
            const sLng = smoothedMarkerPosRef.current[1] + (rawLng - smoothedMarkerPosRef.current[1]) * factor;
            smoothedMarkerPosRef.current = [sLat, sLng];
            setRunLiveGpsPos([sLat, sLng]);
          }
        }

        // Only accumulate route coordinates and distance if activity is actively recording (NOT paused)
        if (runStatusRef.current !== "active") {
          return;
        }

        // First accepted movement coordinate
        if (!runLastAcceptedPointRef.current) {
          runLastAcceptedPointRef.current = currentPoint;
          runPathRef.current = [{ lat: rawLat, lng: rawLng, ele: currentPoint.ele, timestamp }];
          if (rawAlt !== null && !isNaN(rawAlt)) runLastAltitudeRef.current = rawAlt;
          return;
        }

        const lastPoint = runLastAcceptedPointRef.current;
        const distKm = haversineKm(lastPoint, currentPoint);
        const distMeters = distKm * 1000;

        // Duplicate point filter: discard stationary micro-jitter under 2 meters
        if (distMeters < 2.0) {
          return;
        }

        const dtSeconds = Math.max(0.5, (timestamp - lastPoint.timestamp) / 1000);
        const calculatedSpeedKmh = distKm / (dtSeconds / 3600);

        // Sanity check / GPS teleportation glitch rejection (45 km/h for run/walk, 95 km/h for bike)
        const maxKmh = runActivityTypeRef.current === "bike" ? 95 : 45;
        if (calculatedSpeedKmh > maxKmh) {
          return;
        }

        // Stationary GPS drift rejection
        const isHardwareStationary = speed !== null && speed !== undefined && !isNaN(speed) && speed < 0.4;
        const minThresholdMeters = Math.max(3.5, accuracy * 0.4);
        if (distMeters < minThresholdMeters && isHardwareStationary) {
          setRunLiveSpeed(0);
          return;
        }

        // Genuine real GPS movement accepted
        runLastAcceptedPointRef.current = currentPoint;
        runPathRef.current.push({ lat: rawLat, lng: rawLng, ele: currentPoint.ele, timestamp });
        setRunDistanceKm((prev) => Number((prev + distKm).toFixed(3)));

        const currentSpeedKmh = (speed !== null && speed !== undefined && !isNaN(speed) && speed >= 0.4)
          ? (speed * 3.6)
          : calculatedSpeedKmh;
        setRunLiveSpeed(currentSpeedKmh);

        // Track maximum speed
        if (currentSpeedKmh > runMaxSpeedRef.current) {
          runMaxSpeedRef.current = currentSpeedKmh;
          setRunMaxSpeed(Number(currentSpeedKmh.toFixed(1)));
        }

        // Track real elevation gain
        if (rawAlt !== null && rawAlt !== undefined && !isNaN(rawAlt)) {
          if (runLastAltitudeRef.current !== null) {
            const dAlt = rawAlt - runLastAltitudeRef.current;
            if (dAlt >= 1.5 && dAlt < 60) {
              setRunElevationGain((prev) => Math.round(prev + dAlt));
              runLastAltitudeRef.current = rawAlt;
            } else if (dAlt <= -1.5) {
              runLastAltitudeRef.current = rawAlt;
            }
          } else {
            runLastAltitudeRef.current = rawAlt;
          }
        }

        lastGpsMotionRef.current = Date.now();
      },
      (err) => {
        setRunGpsError(err.message || "Location permission was denied.");
        setRunGpsStatus("weak");
      },
      { enableHighAccuracy: true, maximumAge: 1000, timeout: 20000 }
    );
  }

  function runStartTimer() {
    if (runTimerRef.current) clearInterval(runTimerRef.current);
    runTimerRef.current = setInterval(() => {
      setRunElapsed((e) => e + 1);
    }, 1000);
  }

  function runStopTimer() {
    if (runTimerRef.current) {
      clearInterval(runTimerRef.current);
      runTimerRef.current = null;
    }
  }

  function handleRunStart(sportType = "run") {
    runStatusRef.current = "active";
    runActivityTypeRef.current = sportType || "run";
    setRunStatus("active");
    setRunElapsed(0);
    setRunDistanceKm(0);
    setRunGpsError(null);
    setRunAccuracy(null);
    setRunGpsStatus("acquiring");
    setRunLiveSpeed(0);
    setRunMaxSpeed(0);
    setRunElevationGain(0);
    setRunShareCardUrl(null);
    setRunShareStyle("dark");
    runMaxSpeedRef.current = 0;
    runLastAltitudeRef.current = null;
    runStartTimeRef.current = new Date();
    runLastAcceptedPointRef.current = null;
    smoothedMarkerPosRef.current = null;
    runPathRef.current = [];
    lastGpsMotionRef.current = 0;
    runStartWatch(sportType);
    runStartTimer();
    requestWakeLock();
  }

  function handleRunPause() {
    runStatusRef.current = "paused";
    setRunStatus("paused");
    runStopTimer();
    releaseWakeLock();
  }

  function handleRunResume() {
    runStatusRef.current = "active";
    setRunStatus("active");
    runStartTimer();
    requestWakeLock();
  }

  function handleRunDiscard() {
    runStatusRef.current = "idle";
    setRunStatus("idle");
    runStopTimer();
    releaseWakeLock();
    setRunElapsed(0);
    setRunDistanceKm(0);
    setRunLiveSpeed(0);
    setRunMaxSpeed(0);
    setRunElevationGain(0);
    runPathRef.current = [];
    runLastAcceptedPointRef.current = null;
  }

  function handleRunFinish() {
    runStatusRef.current = "finished";
    setRunStatus("finished");
    runStopTimer();
    releaseWakeLock();
    if (runWatchIdRef.current !== null && navigator.geolocation) {
      navigator.geolocation.clearWatch(runWatchIdRef.current);
      runWatchIdRef.current = null;
    }
  }

  function handleRunChangeStyle(style) {
    setRunShareStyle(style);
    const liveDist = runDistanceKm > 0 ? runDistanceKm : 0;
    const paceMinPerKm = (liveDist >= 0.03 && runElapsed > 0) ? (runElapsed / 60 / liveDist) : 0;
    setRunShareCardUrl(drawShareCard({ distanceKm: liveDist, elapsed: runElapsed, paceMinPerKm, path: runPathRef.current, style }));
  }

  function handleRunReset() {
    runStatusRef.current = "idle";
    setRunStatus("idle");
    setRunElapsed(0);
    setRunDistanceKm(0);
    setRunGpsError(null);
    setRunAccuracy(null);
    setRunGpsStatus("acquiring");
    setRunLiveSpeed(0);
    setRunMaxSpeed(0);
    setRunElevationGain(0);
    setRunShareCardUrl(null);
    runPathRef.current = [];
    runLastAcceptedPointRef.current = null;
    releaseWakeLock();
    if (runWatchIdRef.current !== null && navigator.geolocation) {
      navigator.geolocation.clearWatch(runWatchIdRef.current);
      runWatchIdRef.current = null;
    }
    if (runTimerRef.current) {
      clearInterval(runTimerRef.current);
      runTimerRef.current = null;
    }
  }
  const [messages, setMessages] = useState([]);
  const [input, setInput] = useState("");
  const [loading, setLoading] = useState(false);
  const remaining = {
    calories: Math.max(0, Math.round(goals.calories - totals.calories)),
    protein: Math.max(0, Math.round(goals.protein - totals.protein)),
    carbs: Math.max(0, Math.round(goals.carbs - totals.carbs)),
    fat: Math.max(0, Math.round(goals.fat - totals.fat)),
  };

  if (showWelcome) {
    return (
      <WelcomeCarousel
        onSignUp={() => { setAuthMode("signup"); setShowWelcome(false); }}
        onLogIn={() => { setAuthMode("signin"); setShowWelcome(false); }}
      />
    );
  }

  if (!authed) {
    return <AuthScreen onSignIn={handleSignIn} initialMode={authMode} />;
  }

  return (
    <div style={{ background: tab === "run" ? "#0A0A0A" : "#FFFFFF", height: "100vh", fontFamily: "'Space Grotesk', ui-sans-serif, system-ui, sans-serif", display: "flex", flexDirection: "column" }}>
      <div style={{ maxWidth: 480, width: "100%", margin: "0 auto", display: "flex", flexDirection: "column", height: "100%", position: "relative" }}>
        <div style={{
          flex: 1,
          overflowY: tab === "run" ? "hidden" : "auto",
          WebkitOverflowScrolling: "touch",
          padding: tab === "run" ? 0 : "max(20px, env(safe-area-inset-top, 20px)) 16px 90px",
          display: "flex",
          flexDirection: "column",
          position: "relative"
        }}>
          {tab === "home" && (
            <HomeScreen
              totals={totals}
              calPct={calPct}
              goals={goals}
              workoutDay={week[TODAY_KEY]}
              workoutLog={logs[TODAY_KEY]}
              lastRun={runs[0]}
              profileName={profile.name}
              water={water}
              setWater={handleSetWater}
              onNavigate={handleNavigate}
              meals={meals}
              mealSlots={mealSlots}
              addItem={addItem}
              logs={logs}
              runs={runs}
              profile={profile}
              week={week}
              remaining={remaining}
              selectedDate={selectedDate}
              onSelectDate={setSelectedDate}
            />
          )}
          {tab === "nutrition" && (
            <NutritionScreen
              meals={meals}
              mealSlots={mealSlots}
              addMealSlot={addMealSlot}
              removeMealSlot={removeMealSlot}
              water={water}
              setWater={handleSetWater}
              addItem={addItem}
              removeItem={removeItem}
              totals={totals}
              calPct={calPct}
              goals={goals}
              onBack={handleBack}
              onNavigate={handleNavigate}
              selectedDate={selectedDate}
              onSelectDate={setSelectedDate}
            />
          )}
          {tab === "workout" && <WorkoutScreen week={week} programKey={programKey} onProgramChange={switchProgram} activeDay={activeDay} setActiveDay={setActiveDay} logs={logs} updateSet={updateSet} addSet={addSet} toggleComplete={toggleComplete} onNavigate={handleNavigate} onBack={handleBack} profile={profile} />}
          {tab === "goals" && (
            <BodyGoalsScreen
              profile={profile}
              setProfile={setProfile}
              goals={goals}
              totals={totals}
              onNavigate={handleNavigate}
              onBack={handleBack}
              currentUser={currentUser}
              meals={meals}
              addItem={addItem}
            />
          )}
          {tab === "run" && (
            <RunScreen
              profile={profile}
              runs={runs}
              setRuns={setRuns}
              status={runStatus}
              elapsed={runElapsed}
              distanceKm={runDistanceKm}
              setDistanceKm={setRunDistanceKm}
              gpsError={runGpsError}
              accuracy={runAccuracy}
              gpsStatus={runGpsStatus}
              liveSpeed={runLiveSpeed}
              maxSpeed={runMaxSpeed}
              elevationGain={runElevationGain}
              shareCardUrl={runShareCardUrl}
              shareStyle={runShareStyle}
              onChangeStyle={handleRunChangeStyle}
              pathRef={runPathRef}
              handleStart={handleRunStart}
              handlePause={handleRunPause}
              handleResume={handleRunResume}
              handleFinish={handleRunFinish}
              handleReset={handleRunReset}
              handleDiscard={handleRunDiscard}
              liveGpsPos={runLiveGpsPos}
              runStartTimeRef={runStartTimeRef}
              onNavigate={handleNavigate}
              onBack={handleBack}
              currentUser={currentUser}
            />
          )}

          {(tab === "more" || tab === "profile") && <MoreHubScreen profile={profile} setProfile={setProfile} goals={goals} userPhone={userPhone} onSignOut={handleSignOut} onSwitchAccount={handleSignIn} totals={totals} onNavigate={handleNavigate} onBack={handleBack} currentUser={currentUser} onOpenSupabaseModal={() => setShowSupabaseModal(true)} />}
        </div>
        {tab !== "run" && (
          <div style={{ padding: "0 12px max(14px, env(safe-area-inset-bottom, 14px))", background: "transparent" }}>
          <div style={{ position: "relative", display: "flex", background: "#FFFFFF", backdropFilter: "blur(20px)", WebkitBackdropFilter: "blur(20px)", border: "1px solid #DCE5F2", borderRadius: 999, padding: 6, boxShadow: "0 8px 30px rgba(38, 53, 74,0.08)" }}>
            <div
              style={{
                position: "absolute",
                top: 6,
                bottom: 6,
                left: `calc(${(TABS.findIndex((t) => t.key === tab) / TABS.length) * 100}% + 6px)`,
                width: `calc(${100 / TABS.length}% - 12px)`,
                borderRadius: 999,
                background: "#EAF2FF",
                border: "1px solid rgba(54,120,245,0.35)",
                boxShadow: "0 2px 10px rgba(54,120,245,0.15)",
                transition: "left 0.45s cubic-bezier(0.34, 1.56, 0.64, 1)",
              }}
            />
            {TABS.map((t) => (
              <button key={t.key} onClick={() => handleTabClick(t.key)} style={{ flex: 1, background: "none", border: "none", padding: "9px 0 7px", cursor: "pointer",
                color: tab === t.key ? "#3678F5" : "#64748B", display: "flex", flexDirection: "column", alignItems: "center", gap: 2, position: "relative", zIndex: 1 }}>
                <span style={{ position: "relative", display: "flex" }}>
                  <NavIcon name={t.icon} size={19} />
                  {t.key === "run" && runStatus === "active" && (
                    <span style={{ position: "absolute", top: -2, right: -6, width: 8, height: 8, borderRadius: "50%", background: TOKENS.ember, border: "1.5px solid rgba(22,27,36,0.9)" }} />
                  )}
                </span>
                <span style={{ fontSize: 9.5, fontWeight: 600 }}>{t.label}</span>
              </button>
            ))}
          </div>
        </div>
        )}
        <SupabaseSettingsModal isOpen={showSupabaseModal} onClose={() => setShowSupabaseModal(false)} />
      </div>
    </div>
  );
}

ReactDOM.createRoot(document.getElementById("root")).render(<StokeApp />);
  </script>
</body>
</html>