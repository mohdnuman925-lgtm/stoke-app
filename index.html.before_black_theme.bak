      }}>
        <div style={{
          position: "absolute",
          inset: -4,
          borderRadius: "50%",
          border: "2px solid rgba(54,120,245,0.2)",
          borderTopColor: "#3678F5",
          animation: "spin 1s linear infinite",
        }} />
        <div style={{
          width: 58,
          height: 58,
          borderRadius: "50%",
          background: "linear-gradient(135deg, #3678F5 0%, #2B62D9 100%)",
          display: "flex",
          alignItems: "center",
          justifyContent: "center",
          boxShadow: "0 0 24px rgba(54,120,245,0.4)",
        }}>
          <span style={{ fontSize: 26, fontWeight: 900, color: "#FFFFFF" }}>⚡</span>
        </div>
      </div>

      <div style={{
        fontSize: 20,
        fontWeight: 900,
        letterSpacing: 2,
        color: "#26354A",
        marginBottom: 8,
      }}>
        STOKE
      </div>

      <div style={{
        fontSize: 13,
        color: "#64748B",
        fontWeight: 600,
