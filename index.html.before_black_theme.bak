                  />
                </div>

                <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 12 }}>
                  <NeuInput
                    label="Age"
                    type="number"
                    value={editAge}
                    onChange={e => setEditAge(e.target.value)}
                    extraRight={<span style={{ position: "absolute", right: 16, top: "50%", transform: "translateY(-50%)", color: "#64748B", fontWeight: 700, fontSize: 11 }}>yrs</span>}
                  />
                  {/* Sex toggle */}
                  <div style={{ display: "flex", gap: 6 }}>
                    {[{ id: "male", l: "♂ Male" }, { id: "female", l: "♀ Female" }].map(s => (
                      <button
                        key={s.id}
