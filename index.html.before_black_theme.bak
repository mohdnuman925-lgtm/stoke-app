/* ============================================================
   CONFIRM DETECTED MEAL MODAL
   ============================================================ */
function ScanMealConfirmModal({
  isOpen,
  onClose,
  photoPreview,
  isScanning,
  scanError,
  onRetry,
  onReanalyze,
  detectedItems = [],
  onSaveMeal,
  mealSlots = []
}) {
  if (!isOpen) return null;

  const defaultSlot = (() => {
    const hr = new Date().getHours();
    if (hr < 11) return "breakfast";
    if (hr < 16) return "lunch";
    if (hr < 21) return "dinner";
    return "snack";
  })();

  const [selectedSlot, setSelectedSlot] = useState(defaultSlot);
  const [items, setItems] = useState(() => {
    return (detectedItems || []).map((it) => {
      if (typeof recalculateItemNutrients === "function") {
        return recalculateItemNutrients(it, it.grams || 100);
      }
      return { ...it, grams: Number(it.grams) || 100 };
    });
  });

  const [editingIdx, setEditingIdx] = useState(null);
  const [editingName, setEditingName] = useState("");
  const [showAddModal, setShowAddModal] = useState(false);
  const [addSearchQuery, setAddSearchQuery] = useState("");
  const [customItemGrams, setCustomItemGrams] = useState(100);
  const [showKeyConfig, setShowKeyConfig] = useState(false);
  const [aiProvider, setAiProvider] = useState(() => {
    const k = localStorage.getItem("stoke_ai_key") || "";
    if (k.startsWith("AIzaSy") || k.startsWith("AQ.")) return "gemini";
    if (k.startsWith("sk-ant-")) return "anthropic";
    if (k.startsWith("sk-")) return "openai";
    return "gemini";
  });
  const [inputApiKey, setInputApiKey] = useState(() => localStorage.getItem("stoke_ai_key") || "");

  useEffect(() => {
    if (detectedItems && detectedItems.length > 0) {
      setItems(detectedItems.map((it) => {
        if (typeof recalculateItemNutrients === "function") {
          return recalculateItemNutrients(it, it.grams || 100);
        }
        return { ...it, grams: Number(it.grams) || 100 };
      }));
    } else {
      setItems([]);
    }
  }, [detectedItems]);

  const totals = typeof calculateMealTotals === "function" 
    ? calculateMealTotals(items) 
    : {
        calories: items.reduce((s, it) => s + (Number(it.calories) || 0), 0),
        protein: items.reduce((s, it) => s + (Number(it.protein) || 0), 0),
        carbs: items.reduce((s, it) => s + (Number(it.carbs) || 0), 0),
        fat: items.reduce((s, it) => s + (Number(it.fat) || 0), 0),
        fiber: items.reduce((s, it) => s + (Number(it.fiber) || 0), 0),
        totalGrams: items.reduce((s, it) => s + (Number(it.grams) || 0), 0)
      };

  function setItemGrams(idx, rawVal) {
    const val = Math.max(1, Math.min(2500, parseInt(rawVal, 10) || 0));
    setItems((prev) =>
      prev.map((it, i) => {
        if (i !== idx) return it;
        if (typeof recalculateItemNutrients === "function") {
          return recalculateItemNutrients(it, val);
        }
        const ratio = it.grams > 0 ? val / it.grams : 1;
        return { ...it, grams: val, calories: Math.round(it.calories * ratio) };
      })
    );
  }

  function adjustGrams(idx, delta) {
    const cur = items[idx]?.grams || 100;
    setItemGrams(idx, cur + delta);
  }

  function removeItem(idx) {
    setItems((prev) => prev.filter((_, i) => i !== idx));
  }

  function startEditingName(idx) {
    setEditingIdx(idx);
    setEditingName(items[idx]?.name || "");
  }

  function saveEditedName(idx) {
    if (editingName.trim()) {
      setItems((prev) =>
        prev.map((it, i) => {
          if (i !== idx) return it;
          const trimmed = editingName.trim();
          const dbMatch = typeof STOKE_VERIFIED_NUTRITION_DB !== "undefined" ? STOKE_VERIFIED_NUTRITION_DB[trimmed] : null;
          const updated = { ...it, name: trimmed };
          if (dbMatch) {
            updated.per100g = dbMatch.per100g;
            updated.dietType = dbMatch.dietType;
            if (typeof recalculateItemNutrients === "function") {
              return recalculateItemNutrients(updated, it.grams);
            }
          }
          return updated;
        })
      );
    }
    setEditingIdx(null);
  }

  function handleSelectAlternative(idx, altName) {
    const dbMatch = typeof STOKE_VERIFIED_NUTRITION_DB !== "undefined" ? STOKE_VERIFIED_NUTRITION_DB[altName] : null;
    if (dbMatch) {
      setItems((prev) =>
        prev.map((it, i) => {
          if (i !== idx) return it;
          const updated = {
            ...it,
            name: dbMatch.name,
            dietType: dbMatch.dietType,
            per100g: dbMatch.per100g,
            needsConfirmation: false,
            confidence: 90
          };
          if (typeof recalculateItemNutrients === "function") {
            return recalculateItemNutrients(updated, it.grams || dbMatch.defaultGrams);
          }
          return updated;
        })
      );
    }
  }

  function handleAddFood(foodDbItem) {
    const g = Number(customItemGrams) || foodDbItem.defaultGrams || 100;
    const itemData = {
      name: foodDbItem.name,
      grams: g,
      per100g: foodDbItem.per100g,
      confidence: 100,
      dietType: foodDbItem.dietType,
      needsConfirmation: false,
      alternatives: foodDbItem.alternatives || []
    };
    const newItem = typeof recalculateItemNutrients === "function"
      ? recalculateItemNutrients(itemData, g)
      : itemData;

    setItems((prev) => [...prev, newItem]);
    setShowAddModal(false);
    setAddSearchQuery("");
  }

  function saveAiKey() {
    if (inputApiKey.trim()) {
      localStorage.setItem("stoke_ai_key", inputApiKey.trim());
      if (aiProvider === "anthropic") localStorage.setItem("anthropic_key", inputApiKey.trim());
      if (aiProvider === "gemini") localStorage.setItem("gemini_key", inputApiKey.trim());
      if (aiProvider === "openai") localStorage.setItem("openai_key", inputApiKey.trim());
    } else {
      localStorage.removeItem("stoke_ai_key");
      localStorage.removeItem("anthropic_key");
      localStorage.removeItem("gemini_key");
      localStorage.removeItem("openai_key");
    }
    setShowKeyConfig(false);
    if (inputApiKey.trim() && onReanalyze) {
      onReanalyze();
    }
  }

  const hasApiKey = Boolean(localStorage.getItem("stoke_ai_key") || localStorage.getItem("anthropic_key") || localStorage.getItem("gemini_key") || localStorage.getItem("openai_key"));
  const filteredFoods = typeof searchVerifiedFoods === "function" 
    ? searchVerifiedFoods(addSearchQuery) 
    : [];

  return (
    <div style={{ position: "fixed", inset: 0, zIndex: 10000, background: "rgba(38, 53, 74,0.65)", backdropFilter: "blur(20px)", WebkitBackdropFilter: "blur(20px)", display: "flex", alignItems: "center", justifyContent: "center", padding: 16 }}>
      <div style={{ width: "100%", maxWidth: 440, maxHeight: "90vh", overflowY: "auto", background: "#FFFFFF", border: "1.5px solid #DCE5F2", borderRadius: 28, padding: "24px 20px", boxShadow: "0 24px 60px rgba(38, 53, 74,0.18)", color: "#26354A" }}>
        
        {/* Header */}
        <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 16 }}>
          <div style={{ display: "flex", alignItems: "center", gap: 10 }}>
            <div style={{ width: 38, height: 38, borderRadius: 12, background: "linear-gradient(135deg, rgba(54,120,245,0.18) 0%, rgba(54,120,245,0.12) 100%)", border: "1.5px solid rgba(54,120,245,0.4)", display: "flex", alignItems: "center", justifyContent: "center" }}>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#3678F5" strokeWidth="2.2" strokeLinecap="round" strokeLinejoin="round">
                <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z" />
                <circle cx="12" cy="13" r="4" />
              </svg>
            </div>
            <div>
              <div style={{ display: "flex", alignItems: "center", gap: 6 }}>
                <h2 style={{ margin: 0, fontSize: 18, fontWeight: 900, color: "#26354A" }}>Meal Vision Analysis</h2>
                <span
                  onClick={() => setShowKeyConfig(!showKeyConfig)}
                  style={{
                    cursor: "pointer",
                    fontSize: 9.5,
                    fontWeight: 800,
                    padding: "2px 7px",
                    borderRadius: 999,
                    background: hasApiKey ? "rgba(33, 134, 91,0.14)" : "rgba(54,120,245,0.14)",
                    color: hasApiKey ? "#21865B" : "#3678F5",
                    border: `1px solid ${hasApiKey ? "rgba(33, 134, 91,0.3)" : "rgba(54,120,245,0.3)"}`
                  }}
                  title="Click to configure Vision AI model key (Gemini / Claude / OpenAI)"
                >
                  {hasApiKey ? "AI Vision Active ⚡" : "Set API Key ⚙️"}
                </span>
              </div>
              <div style={{ fontSize: 11.5, color: "#64748B" }}>Real-time food identification & certified macros</div>
            </div>
          </div>
          <button
            onClick={onClose}
            style={{
              background: "#EAF2FF",
              border: "1px solid #DCE5F2",
              color: "#64748B",
              width: 32,
              height: 32,
              borderRadius: "50%",
              cursor: "pointer",
              display: "flex",
              alignItems: "center",
              justifyContent: "center"
            }}
            aria-label="Close modal"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round">
              <line x1="18" y1="6" x2="6" y2="18" />
              <line x1="6" y1="6" x2="18" y2="18" />
            </svg>
          </button>
        </div>

        {/* AI Key Configuration Drawer */}
        {showKeyConfig && (
          <div style={{ background: "#EAF2FF", border: "1.5px solid #DCE5F2", borderRadius: 16, padding: "14px 16px", marginBottom: 14 }}>
            <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 8 }}>
              <span style={{ fontSize: 12, fontWeight: 800, color: "#26354A" }}>Configure Vision AI Key</span>
              <button onClick={() => setShowKeyConfig(false)} style={{ background: "none", border: "none", color: "#64748B", cursor: "pointer", fontSize: 12, fontWeight: 700 }}>Close</button>
            </div>
            <div style={{ fontSize: 11, color: "#64748B", marginBottom: 8 }}>
              STOKE uses genuine Computer Vision models to inspect real food photos. Choose your provider and paste your key:
            </div>
            <div style={{ display: "flex", gap: 6, marginBottom: 8 }}>
              {[
                { id: "gemini", label: "Google Gemini (Free)" },
                { id: "openai", label: "OpenAI GPT-4o" },
                { id: "anthropic", label: "Claude 3.5" }
              ].map((p) => (
                <button
                  key={p.id}
                  onClick={() => setAiProvider(p.id)}
                  style={{
                    flex: 1,
                    background: aiProvider === p.id ? "#3678F5" : "#FFFFFF",
                    color: aiProvider === p.id ? "#FFFFFF" : "#26354A",
                    border: `1px solid ${aiProvider === p.id ? "#3678F5" : "#DCE5F2"}`,
                    borderRadius: 8,
                    padding: "6px 4px",
                    fontSize: 10.5,
                    fontWeight: 700,
                    cursor: "pointer"
                  }}
                >
                  {p.label}
                </button>
              ))}
            </div>
            <input
              type="password"
              placeholder={aiProvider === "gemini" ? "AIzaSy..." : aiProvider === "openai" ? "sk-..." : "sk-ant-..."}
              value={inputApiKey}
              onChange={(e) => setInputApiKey(e.target.value)}
              style={{ width: "100%", boxSizing: "border-box", background: "#FFFFFF", border: "1.5px solid #DCE5F2", borderRadius: 10, padding: "8px 10px", fontSize: 12, color: "#26354A", outline: "none", marginBottom: 6 }}
            />
            <div style={{ fontSize: 10.5, color: "#64748B", marginBottom: 10 }}>
              {aiProvider === "gemini" && "Tip: Free Google Gemini keys available in 30 seconds at aistudio.google.com"}
              {aiProvider === "openai" && "Tip: Available in your OpenAI platform dashboard at platform.openai.com"}
              {aiProvider === "anthropic" && "Tip: Available in Anthropic Console at console.anthropic.com"}
            </div>
            <div style={{ display: "flex", justifyContent: "flex-end", gap: 8 }}>
              <button
                onClick={saveAiKey}
                style={{ background: "#3678F5", color: "#FFFFFF", border: "none", borderRadius: 10, padding: "7px 16px", fontSize: 11.5, fontWeight: 800, cursor: "pointer" }}
              >
                Save & Analyze
              </button>
            </div>
          </div>
        )}

        {/* Photo Preview & Status */}
        {photoPreview && (
          <div style={{ position: "relative", width: "100%", height: 140, borderRadius: 16, overflow: "hidden", marginBottom: 14, border: "1.5px solid #DCE5F2" }}>
            <img src={photoPreview} alt="Scanned Food" style={{ width: "100%", height: "100%", objectFit: "cover" }} />
            {isScanning && (
              <div style={{ position: "absolute", inset: 0, background: "rgba(255,255,255,0.92)", display: "flex", flexDirection: "column", alignItems: "center", justifyContent: "center", gap: 8 }}>
                <div style={{ width: 32, height: 32, border: "3px solid #3678F5", borderTopColor: "transparent", borderRadius: "50%", animation: "spin 0.8s linear infinite" }} />
                <span style={{ fontSize: 12.5, fontWeight: 800, color: "#3678F5" }}>Analyzing food with Vision AI model...</span>
              </div>
            )}
          </div>
        )}

        {/* Scan Error Message (Never fake success on error) */}
        {scanError && (
          <div style={{ background: "rgba(209, 67, 67,0.08)", border: "1.5px solid rgba(209, 67, 67,0.25)", borderRadius: 14, padding: "12px 14px", marginBottom: 14, display: "flex", alignItems: "flex-start", gap: 10 }}>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#D14343" strokeWidth="2.2" strokeLinecap="round" strokeLinejoin="round" style={{ flexShrink: 0, marginTop: 1 }}>
              <circle cx="12" cy="12" r="10" />
              <line x1="12" y1="8" x2="12" y2="12" />
              <line x1="12" y1="16" x2="12.01" y2="16" />
            </svg>
            <div style={{ flex: 1 }}>
              <div style={{ fontSize: 12.5, fontWeight: 800, color: "#D14343" }}>Vision Analysis Notice</div>
              <div style={{ fontSize: 11.5, color: "#64748B", marginTop: 2 }}>{scanError}</div>
              <div style={{ display: "flex", gap: 8, marginTop: 10, flexWrap: "wrap" }}>
                <button onClick={() => setShowKeyConfig(true)} style={{ background: "#3678F5", color: "#FFFFFF", border: "none", borderRadius: 8, padding: "6px 12px", fontSize: 11, fontWeight: 800, cursor: "pointer" }}>
                  ⚙️ Configure AI Key
                </button>
                {onReanalyze && (
                  <button onClick={onReanalyze} style={{ background: "#EAF2FF", border: "1px solid #DCE5F2", color: "#26354A", borderRadius: 8, padding: "6px 12px", fontSize: 11, fontWeight: 700, cursor: "pointer" }}>
                    🔄 Retry Analysis
                  </button>
                )}
                {onRetry && (
                  <button onClick={onRetry} style={{ background: "#FFFFFF", border: "1px solid #DCE5F2", color: "#26354A", borderRadius: 8, padding: "6px 12px", fontSize: 11, fontWeight: 700, cursor: "pointer" }}>
                    📸 Pick Other Photo
                  </button>
                )}
                <button onClick={() => setShowAddModal(true)} style={{ background: "#FFFFFF", border: "1px solid #DCE5F2", color: "#26354A", borderRadius: 8, padding: "6px 12px", fontSize: 11, fontWeight: 700, cursor: "pointer" }}>
                  🔍 Search Nutrition DB
                </button>
              </div>
            </div>
          </div>
        )}

        {/* Target Meal Slot Selector */}
        <div style={{ marginBottom: 14 }}>
          <label style={{ fontSize: 11, fontWeight: 700, color: "#64748B", textTransform: "uppercase", display: "block", marginBottom: 6 }}>
            Target Meal Slot
          </label>
          <div style={{ display: "grid", gridTemplateColumns: "repeat(4, 1fr)", gap: 6 }}>
            {["breakfast", "lunch", "dinner", "snack"].map((s) => {
              const active = selectedSlot === s;
              return (
                <button
                  key={s}
                  onClick={() => setSelectedSlot(s)}
                  style={{
                    background: active ? "#3678F5" : "#FFFFFF",
                    border: `1.5px solid ${active ? "#3678F5" : "#DCE5F2"}`,
                    color: active ? "#FFFFFF" : "#26354A",
                    borderRadius: 10,
                    padding: "8px 0",
                    fontSize: 12,
                    fontWeight: 700,
                    textTransform: "capitalize",
                    cursor: "pointer"
                  }}
                >
                  {s}
                </button>
              );
            })}
          </div>
        </div>

        {/* Detected Food Items Header */}
        <div style={{ marginBottom: 16 }}>
          <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 8 }}>
            <span style={{ fontSize: 11, fontWeight: 700, color: "#64748B", textTransform: "uppercase" }}>
              Identified Food Items ({items.length})
            </span>
            <button
              onClick={() => setShowAddModal(true)}
              style={{
                background: "transparent",
                border: "none",
                color: "#3678F5",
                fontSize: 12,
                fontWeight: 800,
                cursor: "pointer",
                display: "flex",
                alignItems: "center",
                gap: 4
              }}
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round">
                <line x1="12" y1="5" x2="12" y2="19" />
                <line x1="5" y1="12" x2="19" y2="12" />
              </svg>
              <span>Add Item</span>
            </button>
          </div>

          {/* List of Detected Items */}
          <div style={{ display: "flex", flexDirection: "column", gap: 10 }}>
            {items.map((it, idx) => {
              const isEditing = editingIdx === idx;
              const isLowConf = it.needsConfirmation || (it.confidence && it.confidence < 60);

              return (
                <div key={idx} style={{ background: "#FFFFFF", border: `1.5px solid ${isLowConf ? "rgba(217,119,6,0.4)" : "#DCE5F2"}`, borderRadius: 14, padding: "12px 14px", boxShadow: "0 2px 6px rgba(38, 53, 74,0.03)" }}>
                  {/* Food Title & Confidence & Remove */}
                  <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 6 }}>
                    <div style={{ display: "flex", alignItems: "center", gap: 6, flex: 1, minWidth: 0, marginRight: 8 }}>
                      {isEditing ? (
                        <div style={{ display: "flex", alignItems: "center", gap: 4, flex: 1 }}>
                          <input
                            type="text"
                            value={editingName}
                            onChange={(e) => setEditingName(e.target.value)}
                            onKeyDown={(e) => { if (e.key === "Enter") saveEditedName(idx); }}
                            autoFocus
                            style={{ flex: 1, background: "#EAF2FF", border: "1px solid #DCE5F2", borderRadius: 8, padding: "4px 8px", fontSize: 13, fontWeight: 700, color: "#26354A", outline: "none" }}
                          />
                          <button onClick={() => saveEditedName(idx)} style={{ background: "#3678F5", color: "#FFFFFF", border: "none", borderRadius: 8, padding: "4px 8px", fontSize: 11, fontWeight: 800, cursor: "pointer" }}>Save</button>
                        </div>
                      ) : (
                        <div style={{ display: "flex", alignItems: "center", gap: 6, overflow: "hidden" }}>
                          <span style={{ fontWeight: 800, fontSize: 14, color: "#26354A", overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" }}>
                            {it.name}
                          </span>
                          <button
                            onClick={() => startEditingName(idx)}
                            style={{ background: "none", border: "none", color: "#64748B", cursor: "pointer", padding: 2, display: "flex", alignItems: "center" }}
                            title="Edit food name"
                          >
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.2" strokeLinecap="round" strokeLinejoin="round">
                              <path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z" />
                            </svg>
                          </button>
                        </div>
                      )}

                      {/* Confidence Pill */}
                      {!isEditing && it.confidence && (
                        <span
                          style={{
                            fontSize: 9.5,
                            fontWeight: 800,
                            padding: "2px 6px",
                            borderRadius: 999,
                            background: isLowConf ? "rgba(217,119,6,0.14)" : "rgba(33, 134, 91,0.12)",
                            color: isLowConf ? "#D97706" : "#21865B",
                            border: `1px solid ${isLowConf ? "rgba(217,119,6,0.3)" : "rgba(33, 134, 91,0.25)"}`,
                            flexShrink: 0
                          }}
                        >
                          {it.confidence}% {isLowConf ? "Confirm" : "Match"}
                        </span>
                      )}
                    </div>

                    <button
                      onClick={() => removeItem(idx)}
                      style={{ background: "transparent", border: "none", color: "#D14343", cursor: "pointer", padding: "2px 4px", display: "flex", alignItems: "center", gap: 3, fontSize: 11, fontWeight: 700 }}
                      title="Remove detected item"
                    >
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.2" strokeLinecap="round" strokeLinejoin="round">
                        <polyline points="3 6 5 6 21 6" />
                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                      </svg>
                      <span>Remove</span>
                    </button>
                  </div>

                  {/* Low confidence alternatives quick-switch */}
                  {isLowConf && it.alternatives && it.alternatives.length > 0 && (
                    <div style={{ background: "rgba(217,119,6,0.08)", border: "1px dashed rgba(217,119,6,0.3)", borderRadius: 10, padding: "6px 8px", marginBottom: 8 }}>
                      <div style={{ fontSize: 10.5, fontWeight: 700, color: "#D97706", marginBottom: 4 }}>
                        Low confidence. Did you have one of these?
                      </div>
                      <div style={{ display: "flex", gap: 5, flexWrap: "wrap" }}>
                        {it.alternatives.map((alt) => (
                          <button
                            key={alt}
                            onClick={() => handleSelectAlternative(idx, alt)}
                            style={{
                              background: "#FFFFFF",
                              border: "1px solid rgba(217,119,6,0.35)",
                              borderRadius: 6,
                              padding: "2px 6px",
                              fontSize: 10,
                              fontWeight: 700,
                              color: "#26354A",
                              cursor: "pointer"
                            }}
                          >
                            {alt}
                          </button>
                        ))}
                      </div>
                    </div>
                  )}

                  {/* Portion Stepper & Nutritional Values */}
                  <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", gap: 10 }}>
                    {/* Portion Control with accessible SVG buttons */}
                    <div style={{ display: "flex", alignItems: "center", gap: 4, background: "#EAF2FF", border: "1px solid #DCE5F2", borderRadius: 10, padding: "3px 6px" }}>
                      <button
                        type="button"
                        onClick={() => adjustGrams(idx, -25)}
                        style={{
                          background: "none",
                          border: "none",
                          color: "#26354A",
                          cursor: "pointer",
                          padding: "2px 4px",
                          display: "flex",
                          alignItems: "center",
                          justifyContent: "center"
                        }}
                        aria-label="Decrease portion by 25g"
                      >
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="3" strokeLinecap="round" strokeLinejoin="round">
                          <line x1="5" y1="12" x2="19" y2="12" />
                        </svg>
                      </button>
                      <input
                        type="number"
                        value={it.grams}
                        onChange={(e) => setItemGrams(idx, e.target.value)}
                        style={{ width: 44, background: "transparent", border: "none", textAlign: "center", color: "#26354A", fontSize: 13, fontWeight: 800, outline: "none" }}
                        aria-label="Portion grams"
                      />
                      <span style={{ fontSize: 11, color: "#64748B", paddingRight: 2 }}>g</span>
                      <button
                        type="button"
                        onClick={() => adjustGrams(idx, 25)}
                        style={{
                          background: "none",
                          border: "none",
                          color: "#26354A",
                          cursor: "pointer",
                          padding: "2px 4px",
                          display: "flex",
                          alignItems: "center",
                          justifyContent: "center"
                        }}
                        aria-label="Increase portion by 25g"
                      >
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="3" strokeLinecap="round" strokeLinejoin="round">
                          <line x1="12" y1="5" x2="12" y2="19" />
                          <line x1="5" y1="12" x2="19" y2="12" />
                        </svg>
                      </button>
                    </div>

                    {/* Proportional Nutrients */}
                    <div style={{ display: "flex", gap: 7, fontSize: 11.5 }}>
                      <span style={{ color: "#3678F5", fontWeight: 800 }}>{it.calories} kcal</span>
                      <span style={{ color: "#E86A33" }}>P:{it.protein}g</span>
                      <span style={{ color: "#3678F5" }}>C:{it.carbs}g</span>
                      <span style={{ color: "#D97706" }}>F:{it.fat}g</span>
                      <span style={{ color: "#21865B" }}>Fib:{it.fiber}g</span>
                    </div>
                  </div>
                </div>
              );
            })}

            {items.length === 0 && !isScanning && !scanError && (
              <div style={{ textAlign: "center", padding: "18px 0", color: "#64748B", fontSize: 13 }}>
                No food items in this meal yet. Tap "Add Item" above to add foods.
              </div>
            )}
          </div>
        </div>

        {/* Dynamic Meal Totals Card */}
        <div style={{ background: "#EAF2FF", border: "1.5px solid rgba(54,120,245,0.3)", borderRadius: 16, padding: "14px 16px", marginBottom: 14 }}>
          <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 6 }}>
            <span style={{ fontSize: 13, fontWeight: 800, color: "#26354A" }}>Meal Total ({totals.totalGrams}g)</span>
            <span style={{ fontSize: 18, fontWeight: 900, color: "#3678F5" }}>{totals.calories} kcal</span>
          </div>
          <div style={{ display: "flex", justifyContent: "space-between", fontSize: 12, fontWeight: 700 }}>
            <span style={{ color: "#E86A33" }}>Protein: {Math.round(totals.protein)}g</span>
            <span style={{ color: "#3678F5" }}>Carbs: {Math.round(totals.carbs)}g</span>
            <span style={{ color: "#D97706" }}>Fat: {Math.round(totals.fat)}g</span>
            <span style={{ color: "#21865B" }}>Fibre: {Math.round(totals.fiber)}g</span>
          </div>
        </div>

        {/* Estimation Disclaimer */}
        <div style={{ display: "flex", alignItems: "flex-start", gap: 8, marginBottom: 16, background: "rgba(38, 53, 74,0.06)", border: "1px solid #DCE5F2", borderRadius: 12, padding: "10px 12px" }}>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#64748B" strokeWidth="2.2" strokeLinecap="round" strokeLinejoin="round" style={{ flexShrink: 0, marginTop: 1 }}>
            <circle cx="12" cy="12" r="10" />
            <line x1="12" y1="16" x2="12" y2="12" />
            <line x1="12" y1="8" x2="12.01" y2="8" />
          </svg>
          <div style={{ fontSize: 10.5, color: "#64748B", lineHeight: 1.35 }}>
            Nutritional values are estimates based on visual portion volume. Camera AI cannot determine exact ingredients, cooking oils, or precise weight from pixels alone.
          </div>
        </div>

        {/* Save Meal CTA Button */}
        <button
          onClick={() => onSaveMeal && items.length > 0 && onSaveMeal(selectedSlot, items)}
          disabled={items.length === 0 || isScanning}
          style={{
            width: "100%",
            background: items.length === 0 || isScanning ? "#DCE5F2" : "linear-gradient(135deg, #3678F5 0%, #2B62D9 100%)",
            border: "none",
            borderRadius: 14,
            padding: "14px 0",
            color: "#FFFFFF",
            fontSize: 14.5,
            fontWeight: 800,
            cursor: items.length === 0 || isScanning ? "not-allowed" : "pointer",
            boxShadow: items.length === 0 || isScanning ? "none" : "0 6px 20px rgba(54,120,245,0.35)",
            display: "flex",
            alignItems: "center",
            justifyContent: "center",
            gap: 8
          }}
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round">
            <polyline points="20 6 9 17 4 12" />
          </svg>
          <span>Save Meal & Log to Supabase</span>
        </button>

        {/* Add Food Item Drawer / Modal */}
        {showAddModal && (
          <div style={{ position: "fixed", inset: 0, background: "rgba(0,0,0,0.5)", zIndex: 10001, display: "flex", alignItems: "flex-end", justifyContent: "center" }} onClick={() => setShowAddModal(false)}>
            <div style={{ width: "100%", maxWidth: 440, maxHeight: "75vh", background: "#FFFFFF", borderTopLeftRadius: 24, borderTopRightRadius: 24, padding: "20px 18px", overflowY: "auto" }} onClick={(e) => e.stopPropagation()}>
              <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 12 }}>
                <h3 style={{ margin: 0, fontSize: 16, fontWeight: 800, color: "#26354A" }}>Add Food to Meal</h3>
                <button onClick={() => setShowAddModal(false)} style={{ background: "none", border: "none", color: "#64748B", fontSize: 14, fontWeight: 700, cursor: "pointer" }}>✕</button>
              </div>

              <input
                type="text"
                placeholder="Search food (biryani, roti, rice, dal, chicken...)"
                value={addSearchQuery}
                onChange={(e) => setAddSearchQuery(e.target.value)}
                autoFocus
                style={{ width: "100%", boxSizing: "border-box", background: "#FFFFFF", border: "1.5px solid #DCE5F2", borderRadius: 12, padding: "10px 12px", fontSize: 13, color: "#26354A", outline: "none", marginBottom: 12 }}
              />

              <div style={{ display: "flex", alignItems: "center", gap: 8, marginBottom: 14 }}>
                <span style={{ fontSize: 12, fontWeight: 700, color: "#64748B" }}>Portion:</span>
                <input
                  type="number"
                  value={customItemGrams}
                  onChange={(e) => setCustomItemGrams(e.target.value)}
                  style={{ width: 60, background: "#FFFFFF", border: "1px solid #DCE5F2", borderRadius: 8, padding: "5px 8px", fontSize: 12, fontWeight: 700, textAlign: "center" }}
                />
                <span style={{ fontSize: 12, color: "#64748B" }}>grams</span>
              </div>

              <div style={{ display: "flex", flexDirection: "column", gap: 8, maxHeight: "40vh", overflowY: "auto" }}>
                {filteredFoods.map((f) => (
                  <div
                    key={f.name}
                    onClick={() => handleAddFood(f)}
                    style={{ background: "#FFFFFF", border: "1px solid #DCE5F2", borderRadius: 12, padding: "10px 12px", display: "flex", justifyContent: "space-between", alignItems: "center", cursor: "pointer" }}
                  >
                    <div>
                      <div style={{ fontSize: 13, fontWeight: 800, color: "#26354A" }}>{f.name}</div>
                      <div style={{ fontSize: 11, color: "#64748B" }}>
                        Per 100g: {f.per100g.calories} kcal · P:{f.per100g.protein}g C:{f.per100g.carbs}g F:{f.per100g.fat}g
                      </div>
                    </div>
                    <span style={{ fontSize: 11, fontWeight: 800, color: "#3678F5", background: "#EAF2FF", padding: "4px 8px", borderRadius: 8 }}>+ Add</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        )}

      </div>
    </div>
  );
}


/* ============================================================
   4. VOICE COACH CARD & MODAL (Strictly named "Coach")
   ============================================================ */
function HomeCoachCard({
  onOpenCoach,
  onOpenVoice,
  athleteName = "Athlete",
  remCal = 0,
  remP = 0,
  coachTip = "",
  onQuickAsk,
}) {
  const [localInput, setLocalInput] = useState("");

  const handleSend = (e) => {
    if (e) e.preventDefault();
    if (!localInput.trim()) {
      onOpenCoach();
      return;
    }
    onQuickAsk(localInput.trim());
    setLocalInput("");
  };

  const chips = [
    { label: "🥗 What to eat?", q: "What should I eat with my remaining macros?" },
    { label: "🏋️ Today's workout", q: "Give me form cues and tips for today's workout" },
    { label: "⚡ Recovery advice", q: "How can I optimize muscle recovery and soreness?" },
    { label: "🥛 Hit protein goal", q: "High-protein quick snack recommendations" },
  ];

  return (
    <div
      style={{
        background: "#EAF2FF",
        border: "1.5px solid #DCE5F2",
        borderRadius: 22,
        padding: "16px 18px",
        marginBottom: 14,
        boxShadow: "0 8px 24px rgba(38, 53, 74,0.06)",
        position: "relative",
        overflow: "hidden",
      }}
    >
      {/* Header with Title and BOTH Voice Coach & Chat AI buttons */}
      <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 12, flexWrap: "wrap", gap: 8 }}>
        <div style={{ display: "flex", alignItems: "center", gap: 10 }}>
          <div
            style={{
              width: 40,
              height: 40,
              borderRadius: 13,
              background: "linear-gradient(135deg, #3678F5 0%, #2B62D9 100%)",
              display: "flex",
              alignItems: "center",
              justifyContent: "center",
              boxShadow: "0 4px 14px rgba(54,120,245,0.35)",
              flexShrink: 0,
            }}
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" strokeWidth="2.4" strokeLinecap="round" strokeLinejoin="round">
              <path d="M4.5 5.5h15v10.5H10l-3.5 3.5v-3.5H4.5z" />
            </svg>
          </div>
          <div>
            <div style={{ display: "flex", alignItems: "center", gap: 6 }}>
              <span style={{ fontSize: 14.5, fontWeight: 900, color: "#26354A", letterSpacing: 0.3 }}>Coach</span>
              <span style={{ display: "inline-flex", alignItems: "center", gap: 4, background: "rgba(33, 134, 91,0.12)", border: "1px solid rgba(33, 134, 91,0.28)", padding: "2px 7px", borderRadius: 999, fontSize: 9.5, fontWeight: 800, color: "#21865B" }}>
                <span style={{ width: 6, height: 6, borderRadius: "50%", background: "#21865B", display: "inline-block" }} />
                ACTIVE
              </span>
            </div>
            <div style={{ fontSize: 11, color: "#64748B", marginTop: 1 }}>
              Personalized nutritionist & training architect
            </div>
          </div>
        </div>

        {/* Action Buttons: Voice Coach & Chat */}
        <div style={{ display: "flex", alignItems: "center", gap: 6 }}>
          <button
            type="button"
            onClick={onOpenVoice}
            title="Talk to Voice Coach"
            style={{
              background: "#FFFFFF",
              border: "1px solid #DCE5F2",
              borderRadius: 11,
              padding: "6px 11px",
              color: "#21865B",
              fontSize: 11.5,
              fontWeight: 800,
              cursor: "pointer",
              display: "flex",
              alignItems: "center",
              gap: 5,
              boxShadow: "0 2px 6px rgba(38, 53, 74,0.04)",
            }}
          >
            <span>🎙️</span>
            <span>Voice Coach</span>
          </button>

          <button
            type="button"
            onClick={onOpenCoach}
            title="Chat with Coach"
            style={{
              background: "#FFFFFF",
              border: "1px solid #DCE5F2",
              borderRadius: 11,
              padding: "6px 11px",
              color: "#3678F5",
              fontSize: 11.5,
              fontWeight: 800,
              cursor: "pointer",
              display: "flex",
              alignItems: "center",
              gap: 4,
              boxShadow: "0 2px 6px rgba(38, 53, 74,0.04)",
            }}
          >
            <span>Chat</span>
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round">
              <polyline points="9 18 15 12 9 6" />
            </svg>
          </button>
        </div>
      </div>

      {/* Dynamic Status / Coach Insight Message */}
      <div
        onClick={onOpenCoach}
        style={{
          cursor: "pointer",
          background: "#FFFFFF",
          border: "1.5px solid #DCE5F2",
          borderRadius: 14,
          padding: "10px 14px",
          marginBottom: 11,
          fontSize: 12.5,
          lineHeight: 1.45,
          color: "#26354A",
          boxShadow: "0 2px 8px rgba(38, 53, 74,0.03)",
        }}
      >
        💡 <strong style={{ color: "#3678F5" }}>Coach Advice:</strong> {coachTip || `You have ${remCal} kcal and ${remP}g protein remaining today. Ask Coach to optimize your meals or workout!`}
      </div>

      {/* Quick Prompts Chips */}
      <div
        style={{
          display: "flex",
          gap: 6,
          overflowX: "auto",
          paddingBottom: 4,
          marginBottom: 11,
          scrollbarWidth: "none",
        }}
      >
        {chips.map((c, i) => (
          <button
            key={i}
            onClick={() => onQuickAsk(c.q)}
            style={{
              whiteSpace: "nowrap",
              background: "#FFFFFF",
              border: "1px solid #DCE5F2",
              borderRadius: 20,
              padding: "5px 11px",
              fontSize: 11,
              fontWeight: 700,
              color: "#26354A",
              cursor: "pointer",
              transition: "all 0.15s ease",
            }}
          >
            {c.label}
          </button>
        ))}
      </div>

      {/* Interactive Input Form */}
      <form
        onSubmit={handleSend}
        style={{
          display: "flex",
          alignItems: "center",
          gap: 7,
          background: "#FFFFFF",
          border: "1.5px solid #DCE5F2",
          borderRadius: 14,
          padding: "5px 7px 5px 12px",
          boxShadow: "0 2px 8px rgba(38, 53, 74,0.04)",
        }}
      >
        <input
          type="text"
          value={localInput}
          onChange={(e) => setLocalInput(e.target.value)}
          placeholder={`Ask Coach anything, ${athleteName}...`}
          style={{
            flex: 1,
            background: "transparent",
            border: "none",
            color: "#26354A",
            fontSize: 12.5,
            outline: "none",
            fontFamily: "inherit",
          }}
        />

        <button
          type="button"
          onClick={onOpenVoice}
          title="Voice Coach"
          style={{
            background: "#EAF2FF",
            border: "1px solid #DCE5F2",
            borderRadius: 9,
            width: 30,
            height: 30,
            display: "flex",
            alignItems: "center",
            justifyContent: "center",
            color: "#21865B",
            cursor: "pointer",
            flexShrink: 0,
          }}
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.4" strokeLinecap="round" strokeLinejoin="round">
            <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/>
            <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
            <line x1="12" y1="19" x2="12" y2="23"/>
            <line x1="8" y1="23" x2="16" y2="23"/>
          </svg>
        </button>

        <button
          type="submit"
          style={{
            background: "linear-gradient(135deg, #3678F5 0%, #2B62D9 100%)",
            border: "none",
            borderRadius: 9,
            width: 30,
            height: 30,
            display: "flex",
            alignItems: "center",
            justifyContent: "center",
            color: "#FFFFFF",
            cursor: "pointer",
            flexShrink: 0,
            boxShadow: "0 2px 8px rgba(54,120,245,0.3)",
          }}
        >
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round">
            <line x1="22" y1="2" x2="11" y2="13"/>
            <polygon points="22 2 15 22 11 13 2 9 22 2"/>
          </svg>
        </button>
      </form>
    </div>
  );
}

function VoiceCoachCard({ onOpenVoiceCoach }) {
