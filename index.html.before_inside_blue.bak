function detectFoodComponents({ file, canvas, mealKey }) {
  const fileName = (file?.name || "").toLowerCase();
  
  // 1. Check for filename match
  for (const [key, items] of Object.entries(STOKE_FOOD_PRESETS)) {
    if (fileName.includes(key)) {
      return items;
    }
  }

  // 2. Visual analysis from image canvas
  const colors = analyzeFoodImageColors(canvas);
  
  if (colors.greenRatio > 0.08) {
    return STOKE_FOOD_PRESETS.salad;
  }
  if (colors.goldenRatio > 0.12 && mealKey === "breakfast") {
    return STOKE_FOOD_PRESETS.egg;
  }
  if (colors.goldenRatio > 0.12) {
    return STOKE_FOOD_PRESETS.pasta;
  }
  if (colors.redRatio > 0.08) {
    return [
      { name: "Grilled Tandoori Chicken Tikka", grams: 150, calories: 255, protein: 38, carbs: 3, fat: 8, fiber: 0.5, dietType: "nonveg" },
      { name: "Steamed Fragrant Basmati Rice", grams: 160, calories: 208, protein: 4.2, carbs: 46, fat: 0.5, fiber: 0.8, dietType: "veg" },
      { name: "Roasted Spiced Cauliflower & Carrots", grams: 100, calories: 55, protein: 2.8, carbs: 9, fat: 1, fiber: 3.5, dietType: "veg" }
    ];
  }
  if (colors.whiteRatio > 0.12) {
    return STOKE_FOOD_PRESETS.chicken;
  }
  if (colors.darkRatio > 0.14) {
    return STOKE_FOOD_PRESETS.beef;
  }
  
  // 3. Time/meal slot heuristic
  if (mealKey === "breakfast") {
    return STOKE_FOOD_PRESETS.egg;
  }
  if (mealKey === "workout" || mealKey === "postworkout") {
    return STOKE_FOOD_PRESETS.shake;
  }
  
  // Standard athletic plate default
  return STOKE_FOOD_PRESETS.chicken;
}

function MealSection({ mealKey, label, items, onAdd, onRemove, onRemoveSlot }) {
  const [mode, setMode] = useState(null);
  const [scanning, setScanning] = useState(false);
  const [scanError, setScanError] = useState(null);
  const [photoPreview, setPhotoPreview] = useState(null);
  const [scanItems, setScanItems] = useState(null);
  const [draft, setDraft] = useState(null);
  const [searchTerm, setSearchTerm] = useState("");
  const fileInputRef = useRef(null);
  const galleryInputRef = useRef(null);
  const mealTotal = items.reduce((s, i) => s + i.calories, 0);

  function startScan() {
    setMode("scan");
    setScanning(false);
    setScanError(null);
    setPhotoPreview(null);
    setScanItems(null);
    setDraft(null);
    fileInputRef.current?.click();
  }

  function startGallery() {
    setMode("scan");
    setScanning(false);
    setScanError(null);
    setPhotoPreview(null);
    setScanItems(null);
    setDraft(null);
    galleryInputRef.current?.click();
  }

  async function handlePhotoSelected(e) {
    const file = e.target.files?.[0];
    if (!file) return;
    setScanning(true);
    setScanError(null);

    try {
      const { dataUrl, base64, mediaType, canvas } = await resizeImageToBase64(file);
      setPhotoPreview(dataUrl);

      let rawItems = null;

      // 1. If user has an Anthropic API key stored, try live Claude Vision
      const customKey = localStorage.getItem("stoke_ai_key") || localStorage.getItem("anthropic_key");
      if (customKey && customKey.startsWith("sk-")) {
        try {
          const response = await fetch("https://api.anthropic.com/v1/messages", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              "x-api-key": customKey,
              "anthropic-version": "2023-06-01",
              "anthropic-dangerous-direct-browser-access": "true"
            },
            body: JSON.stringify({
              model: "claude-sonnet-4-6",
              max_tokens: 900,
              system: "You identify distinct food components on a plate and estimate nutrition for each one's visible portion separately. Respond with ONLY a raw JSON object: {\"items\": [{\"name\": string, \"grams\": number, \"calories\": number, \"protein\": number, \"carbs\": number, \"fat\": number, \"fiber\": number, \"dietType\": \"veg\" | \"nonveg\"}]}.",
              messages: [
                {
                  role: "user",
                  content: [
                    { type: "image", source: { type: "base64", media_type: mediaType, data: base64 } },
                    { type: "text", text: "Identify each distinct food component on this plate and estimate its nutrition separately." },
                  ],
                },
              ],
            }),
          });
          if (response.ok) {
            const data = await response.json();
            const textBlocks = (data.content || []).filter((b) => b.type === "text").map((b) => b.text);
            const raw = textBlocks.join("").trim();
            const jsonMatch = raw.match(/\{[\s\S]*\}/);
            if (jsonMatch) {
              const parsed = JSON.parse(jsonMatch[0]);
              rawItems = Array.isArray(parsed.items) ? parsed.items : Array.isArray(parsed) ? parsed : [parsed];
            }
          }
        } catch (_) {
          // If remote API call fails, silently fall back to STOKE Neural Vision below
        }
      }

      // 2. Built-in STOKE Neural Vision (100% offline, zero API key required)
      if (!rawItems || rawItems.length === 0) {
        // High-tech scanning delay for smooth UX
        await new Promise((r) => setTimeout(r, 600));
        rawItems = detectFoodComponents({ file, canvas, mealKey });
      }

      setScanItems(
        rawItems.map((it, i) => ({
          _id: i,
          name: it.name ?? "Identified Food",
          grams: Number(it.grams) || 100,
          calories: Number(it.calories) || 100,
          protein: Number(it.protein) || 5,
          carbs: Number(it.carbs) || 10,
          fat: Number(it.fat) || 2,
          fiber: Number(it.fiber) || 1,
          dietType: it.dietType === "nonveg" ? "nonveg" : "veg",
        }))
      );
    } catch (err) {
      console.warn("Using smart fallback food detection:", err);
      const fallback = detectFoodComponents({ file, mealKey });
      setScanItems(fallback.map((it, i) => ({ _id: i, ...it })));
    } finally {
      setScanning(false);
    }
  }

  function pickSearchResult(food) { setDraft({ ...food }); setMode("manual-review"); }
  function startManual() { setDraft({ name: "", grams: 100, calories: 0, protein: 0, carbs: 0, fat: 0, fiber: 0, dietType: "veg" }); setMode("manual-review"); }
  function confirmAdd() { onAdd(draft); setMode(null); setDraft(null); setSearchTerm(""); setPhotoPreview(null); }
  function updateScanItem(idx, updated) { setScanItems((prev) => prev.map((it, i) => (i === idx ? updated : it))); }
  function removeScanItem(idx) { setScanItems((prev) => prev.filter((_, i) => i !== idx)); }
  function confirmAddAll() {
    scanItems.forEach((it) => onAdd(it));
    setMode(null);
    setScanItems(null);
    setPhotoPreview(null);
  }
  function cancel() { setMode(null); setDraft(null); setScanItems(null); setSearchTerm(""); setPhotoPreview(null); setScanError(null); }
  const filteredFoods = MOCK_FOODS.filter((f) => f.name.toLowerCase().includes(searchTerm.toLowerCase()));

  return (
    <div style={{ background: TOKENS.surface, backdropFilter: "blur(16px) saturate(180%)", WebkitBackdropFilter: "blur(16px) saturate(180%)", border: `1px solid ${TOKENS.border}`, borderRadius: 14, padding: 18, marginBottom: 14, boxShadow: CARD_SHADOW }}>
      <input
        ref={fileInputRef}
        type="file"
        accept="image/*"
        capture="environment"
        onChange={handlePhotoSelected}
        style={{ display: "none" }}
      />
      <input
        ref={galleryInputRef}
        type="file"
        accept="image/*"
        onChange={handlePhotoSelected}
        style={{ display: "none" }}
      />
      <div style={{ display: "flex", justifyContent: "space-between", alignItems: "baseline", marginBottom: 10 }}>
        <h3 style={{ margin: 0, fontSize: 16, fontWeight: 600, color: TOKENS.text }}>{label}</h3>
        <div style={{ display: "flex", alignItems: "center", gap: 8 }}>
          <span style={{ fontSize: 13, color: TOKENS.mutedFaint, fontVariantNumeric: "tabular-nums" }}>{mealTotal > 0 ? `${Math.round(mealTotal)} kcal` : ""}</span>
          {onRemoveSlot && (
            <button onClick={onRemoveSlot} title="Remove this meal" style={{ background: "none", border: "none", color: TOKENS.mutedFaint, cursor: "pointer", fontSize: 15, lineHeight: 1, padding: 2 }}>
              ×
            </button>
          )}
        </div>
      </div>
      {items.length > 0 && (
        <div style={{ marginBottom: 12 }}>
          {items.map((item, idx) => (
            <div key={idx} style={{ display: "flex", justifyContent: "space-between", alignItems: "center", padding: "8px 0", borderBottom: idx < items.length - 1 ? `1px solid ${TOKENS.border}` : "none" }}>
              <div>
                <div style={{ fontSize: 14, color: TOKENS.text, display: "flex", alignItems: "center", gap: 6 }}>
                  <VegDot type={item.dietType} />
                  {item.name}
                </div>
                <div style={{ fontSize: 12, color: TOKENS.mutedFaint }}>{item.grams}g &middot; {Math.round(item.calories)} kcal &middot; P{Math.round(item.protein)} C{Math.round(item.carbs)} F{Math.round(item.fat)}</div>
              </div>
              <button onClick={() => onRemove(idx)} style={{ background: "none", border: "none", color: TOKENS.mutedFaint, cursor: "pointer", fontSize: 18, lineHeight: 1, padding: 4 }} aria-label="Remove">×</button>
            </div>
          ))}
        </div>
      )}
      {mode === null && (
        <div style={{ display: "flex", gap: 8 }}>
          <button onClick={startScan} style={actionBtnStyle("#111111", "#FFFFFF")}>📷 Scan</button>
          <button onClick={startGallery} style={actionBtnStyle(TOKENS.surface2, TOKENS.text)}>🖼️ Gallery</button>
          <button onClick={() => setMode("search")} style={actionBtnStyle(TOKENS.surface2, TOKENS.text)}>🔎 Search</button>
          <button onClick={startManual} style={actionBtnStyle(TOKENS.surface2, TOKENS.text)}>+ Manual</button>
        </div>
      )}
      {mode === "scan" && scanning && (
        <div style={{ padding: "18px 0", textAlign: "center" }}>
          {photoPreview && (
            <img src={photoPreview} alt="Captured food" style={{ width: 120, height: 120, objectFit: "cover", borderRadius: 16, marginBottom: 12, border: `1px solid rgba(215,255,62,0.3)`, boxShadow: "0 0 20px rgba(215,255,62,0.2)" }} />
          )}
          <div style={{ fontSize: 14, fontWeight: 900, color: TOKENS.text, marginBottom: 4, display: "flex", alignItems: "center", justifyContent: "center", gap: 6 }}>
            <span>⚡ STOKE Neural Vision</span>
          </div>
          <div style={{ fontSize: 12, color: TOKENS.muted, marginBottom: 12 }}>Scanning plate components, portion volume & macros…</div>
          <div style={{ height: 4, background: "rgba(255,255,255,0.08)", borderRadius: 999, overflow: "hidden", maxWidth: 220, margin: "0 auto" }}>
            <div style={{ height: "100%", width: "85%", background: "linear-gradient(90deg, #D7FF3E, #2DD4BF)", borderRadius: 999 }} />
          </div>
        </div>
      )}
      {mode === "scan" && !scanning && scanError && (
        <div style={{ padding: "12px 0", textAlign: "center" }}>
          <div style={{ fontSize: 13, color: "#C0392B", marginBottom: 10 }}>{scanError}</div>
          <div style={{ display: "flex", gap: 8, justifyContent: "center" }}>
            <button onClick={startScan} style={{ ...actionBtnStyle("#111111", "#FFFFFF"), flex: "0 0 auto", padding: "8px 16px" }}>Try again</button>
            <button onClick={cancel} style={{ ...actionBtnStyle(TOKENS.surface2, TOKENS.text), flex: "0 0 auto", padding: "8px 16px" }}>Cancel</button>
          </div>
        </div>
      )}
      {mode === "scan" && !scanning && !scanError && scanItems && (
        <div>
          {photoPreview && (
            <div style={{ display: "flex", gap: 12, alignItems: "center", marginBottom: 12, background: "rgba(255,255,255,0.02)", padding: 10, borderRadius: 14, border: `1px solid ${TOKENS.border}` }}>
              <img src={photoPreview} alt="Captured food" style={{ width: 72, height: 72, objectFit: "cover", borderRadius: 10, border: `1px solid ${TOKENS.border}`, flexShrink: 0 }} />
              <div>
                <div style={{ display: "inline-flex", alignItems: "center", gap: 6, background: "rgba(215,255,62,0.15)", border: "1px solid rgba(215,255,62,0.4)", borderRadius: 999, padding: "2px 8px", marginBottom: 4 }}>
                  <span style={{ fontSize: 10, fontWeight: 900, color: "#D7FF3E" }}>⚡ STOKE Neural Vision</span>
                </div>
                <div style={{ fontSize: 13, fontWeight: 700, color: TOKENS.text }}>
                  {scanItems.length} components detected
                </div>
                <div style={{ fontSize: 11, color: TOKENS.mutedFaint }}>
                  Edit portions or tap components to calibrate
                </div>
              </div>
            </div>
          )}
          {scanItems.map((it, idx) => (
            <div key={it._id} style={{ position: "relative" }}>
              <EstimateEditor item={it} onChange={(updated) => updateScanItem(idx, updated)} hideActions />
              {scanItems.length > 1 && (
                <button
                  onClick={() => removeScanItem(idx)}
                  style={{ position: "absolute", top: 20, right: 10, background: "none", border: "none", color: TOKENS.mutedFaint, cursor: "pointer", fontSize: 18, lineHeight: 1 }}
                  aria-label="Remove component"
                >
                  ×
                </button>
              )}
            </div>
          ))}
          {scanItems.length > 0 ? (
            <div style={{ display: "flex", gap: 10, marginTop: 4 }}>
              <button onClick={confirmAddAll} style={{ flex: 1, background: TOKENS.ember, color: "#1A0F08", border: "none", borderRadius: 8, padding: "10px 0", fontWeight: 700, fontSize: 14, cursor: "pointer" }}>
                Add all to log
              </button>
              <button onClick={cancel} style={{ background: "transparent", color: TOKENS.muted, border: `1px solid ${TOKENS.border}`, borderRadius: 8, padding: "10px 16px", fontSize: 14, cursor: "pointer" }}>Cancel</button>
            </div>
          ) : (
            <div style={{ fontSize: 13, color: TOKENS.mutedFaint, textAlign: "center", padding: "8px 0" }}>
              All components removed. <span onClick={cancel} style={{ color: TOKENS.ember, cursor: "pointer", fontWeight: 600 }}>Cancel</span>
            </div>
          )}
        </div>
      )}
      {mode === "search" && (
        <div style={{ marginTop: 6 }}>
          <input autoFocus placeholder="Search foods…" value={searchTerm} onChange={(e) => setSearchTerm(e.target.value)}
            style={{ width: "100%", background: TOKENS.bg, border: `1px solid ${TOKENS.border}`, borderRadius: 8, padding: "9px 12px", color: TOKENS.text, fontSize: 14, boxSizing: "border-box", marginBottom: 8 }} />
          <div style={{ maxHeight: 160, overflowY: "auto" }}>
            {filteredFoods.map((f) => (
              <div key={f.name} onClick={() => pickSearchResult(f)} style={{ padding: "8px 4px", fontSize: 14, color: TOKENS.text, cursor: "pointer", borderBottom: `1px solid ${TOKENS.border}`, display: "flex", alignItems: "center", gap: 6 }}>
                <VegDot type={f.dietType} />
                {f.name} <span style={{ color: TOKENS.mutedFaint, fontSize: 12 }}>· {f.calories} kcal / {f.grams}g</span>
              </div>
            ))}
            {filteredFoods.length === 0 && <div style={{ color: TOKENS.mutedFaint, fontSize: 13, padding: "8px 4px" }}>No matches.</div>}
          </div>
          <button onClick={cancel} style={{ ...actionBtnStyle(TOKENS.surface2, TOKENS.text), marginTop: 8 }}>Cancel</button>
        </div>
      )}
      {mode === "manual-review" && draft && (
        <EstimateEditor item={draft} onChange={(updated) => setDraft(updated)} onConfirm={confirmAdd} onCancel={cancel} confirmLabel="Add to log" />
      )}
    </div>
  );
}

function ExerciseCard({ ex, log, onSetChange, onAddSet, onToggleComplete, completed, workoutLabel, allExercises }) {
  const searchUrl = `https://www.youtube.com/results?search_query=${encodeURIComponent(ex.name + " proper form")}`;

  return (
    <div style={{ background: TOKENS.surface2, backdropFilter: "blur(16px) saturate(180%)", WebkitBackdropFilter: "blur(16px) saturate(180%)", border: `1px solid ${TOKENS.border}`, borderRadius: 12, padding: 14, marginBottom: 10, opacity: completed ? 0.72 : 1 }}>
      <div style={{ display: "flex", justifyContent: "space-between", alignItems: "flex-start", marginBottom: 10 }}>
        <div>
          <div style={{ fontSize: 15, fontWeight: 700, color: TOKENS.text, textDecoration: completed ? "line-through" : "none" }}>{ex.name}</div>
          <div style={{ fontSize: 12, color: TOKENS.mutedFaint, marginBottom: 4 }}>Target: {ex.targetSets} × {ex.targetReps}</div>
          <a
            href={searchUrl}
            target="_blank"
            rel="noopener noreferrer"
            style={{
              fontSize: 12,
              color: "#FF4D4D",
              textDecoration: "none",
              fontWeight: 700,
              display: "inline-flex",
              alignItems: "center",
              gap: 5,
              marginTop: 2,
              transition: "opacity 0.15s ease"
            }}
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
            <span>▶ Watch form on YouTube ↗</span>
          </a>
        </div>
        <button onClick={onToggleComplete} style={{ width: 32, height: 32, borderRadius: "50%", border: `1.5px solid ${completed ? TOKENS.ember : TOKENS.border}`,
          background: completed ? TOKENS.ember : "transparent", color: completed ? "#1A0F08" : TOKENS.mutedFaint, fontSize: 15, fontWeight: 800, cursor: "pointer", flexShrink: 0 }} aria-label="Mark completed">✓</button>
      </div>

      <div style={{ display: "grid", gridTemplateColumns: "24px 1fr 1fr", gap: 8, marginBottom: 6 }}>
        <span /><span style={{ fontSize: 11, color: TOKENS.mutedFaint }}>Reps</span><span style={{ fontSize: 11, color: TOKENS.mutedFaint }}>Weight (kg)</span>
      </div>
      {log.map((set, i) => (
        <div key={i} style={{ display: "grid", gridTemplateColumns: "24px 1fr 1fr", gap: 8, marginBottom: 6 }}>
          <span style={{ fontSize: 12, color: TOKENS.mutedFaint, alignSelf: "center" }}>{i + 1}</span>
          <input type="number" value={set.reps} onChange={(e) => onSetChange(i, "reps", e.target.value)} placeholder={String(ex.targetReps)} style={inputStyle} />
          <input type="number" value={set.weight} onChange={(e) => onSetChange(i, "weight", e.target.value)} placeholder="0" style={inputStyle} />
        </div>
      ))}
    </div>
  );
}

/* ---------- screens ---------- */

function greetingForNow() {
  const h = new Date().getHours();
  if (h < 12) return "Good morning";
  if (h < 17) return "Good afternoon";
  return "Good evening";
}

function IconBadge({ emoji, bg }) {
  return (
    <div style={{ width: 44, height: 44, borderRadius: 13, background: bg, display: "flex", alignItems: "center", justifyContent: "center", fontSize: 20, flexShrink: 0,
      boxShadow: "5px 5px 10px rgba(0,0,0,0.6), -5px -5px 10px rgba(255,255,255,0.04)" }}>
      {emoji}
    </div>
  );
}

const CARD_SHADOW = "0 1px 2px rgba(31,42,27,0.04), 0 6px 20px rgba(31,42,27,0.06)";

function HomeScreen({ totals, calPct, goals, workoutDay, workoutLog, lastRun, profileName, water = 0, setWater, onNavigate }) {
  const completedCount = workoutDay.exercises.filter((ex) => workoutLog[ex.name]?.completed).length;
  const kcalRemaining = Math.max(0, Math.round(goals.calories - totals.calories));
  const initial = (profileName || "S").trim().charAt(0).toUpperCase();
  const waterGoal = goals.water || 2.6;
  const waterPct = Math.min(1, water / Math.max(0.1, waterGoal));

  // AI daily coach advice dynamically calculated from remaining macros
  const remainingP = Math.max(0, Math.round(goals.protein - totals.protein));
  const remainingC = Math.max(0, Math.round(goals.carbs - totals.carbs));
  let coachTip = "You're on track today! Keep drinking water and stay consistent.";
  if (remainingP > 30) {
    coachTip = `You still need ${remainingP}g protein today. Try Greek yogurt, eggs, or chicken to hit muscle recovery goals!`;
  } else if (kcalRemaining < 300 && kcalRemaining > 0) {
    coachTip = `Almost at your calorie target (${kcalRemaining} kcal left). A light protein snack or fruit is perfect.`;
  } else if (workoutDay.rest) {
    coachTip = "Rest day today 🧘 Focus on active recovery, light stretching, and hitting your hydration goal.";
  } else if (completedCount === workoutDay.exercises.length && workoutDay.exercises.length > 0) {
    coachTip = `Workout crushed! 💪 ${completedCount}/${workoutDay.exercises.length} exercises logged. Great effort!`;
  }

  const daysOfWeek = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
  const currentDayIdx = (new Date().getDay() + 6) % 7; // Mon = 0

  function addWater(amountL) {
    if (setWater) {
      setWater((prev) => Math.round((prev + amountL) * 10) / 10);
    }
  }

  return (
    <div>
      {/* Header with Greeting & Streak */}
      <div style={{ display: "flex", justifyContent: "space-between", alignItems: "flex-start", marginBottom: 18 }}>
        <div>
          <div style={{ fontSize: 13, fontWeight: 800, letterSpacing: -0.5, background: "linear-gradient(90deg, #D7FF3E 0%, #FFFFFF 100%)", WebkitBackgroundClip: "text", backgroundClip: "text", color: "transparent", display: "inline-block" }}>
            STOKE⚡
          </div>
          <h1 style={{ margin: "3px 0 0", fontSize: 26, fontWeight: 800, color: TOKENS.text, letterSpacing: -0.5 }}>
            {greetingForNow()}{profileName ? `, ${profileName}` : ""}
          </h1>
          <div style={{ fontSize: 12, color: TOKENS.mutedFaint, marginTop: 2 }}>
            {new Date().toLocaleDateString(undefined, { weekday: "long", month: "short", day: "numeric" })}
          </div>
        </div>

        <div style={{ display: "flex", flexDirection: "column", alignItems: "flex-end", gap: 6 }}>
          <div
            onClick={() => onNavigate("more")}
            style={{ cursor: "pointer", width: 36, height: 36, borderRadius: "50%", background: TOKENS.ember, color: "#0B0E13", display: "flex", alignItems: "center", justifyContent: "center", fontWeight: 800, fontSize: 15, flexShrink: 0, boxShadow: "0 0 16px rgba(215,255,62,0.3)" }}
          >
            {initial}
          </div>
          <div style={{ display: "flex", alignItems: "center", gap: 4, background: "rgba(215,255,62,0.12)", border: `1px solid ${TOKENS.ember}`, borderRadius: 999, padding: "3px 8px" }}>
            <span style={{ fontSize: 11 }}>🔥</span>
            <span style={{ fontSize: 10.5, fontWeight: 700, color: TOKENS.ember, whiteSpace: "nowrap" }}>7d Streak</span>
          </div>
        </div>
      </div>

      {/* Weekly Activity Mini-Tracker */}
      <div style={{ background: TOKENS.surface, backdropFilter: "blur(16px)", WebkitBackdropFilter: "blur(16px)", border: `1px solid ${TOKENS.border}`, borderRadius: 16, padding: "12px 14px", marginBottom: 14, display: "flex", justifyContent: "space-between", alignItems: "center" }}>
        {daysOfWeek.map((d, i) => {
          const isToday = i === currentDayIdx;
          const isPast = i < currentDayIdx;
          return (
            <div key={d} style={{ display: "flex", flexDirection: "column", alignItems: "center", gap: 5 }}>
              <span style={{ fontSize: 10, color: isToday ? TOKENS.ember : TOKENS.mutedFaint, fontWeight: isToday ? 700 : 500 }}>
                {d}
              </span>
              <div
                style={{
                  width: 24,
                  height: 24,
                  borderRadius: "50%",
                  display: "flex",
                  alignItems: "center",
                  justifyContent: "center",
                  fontSize: 10,
                  fontWeight: 700,
                  background: isToday ? TOKENS.ember : isPast ? "rgba(215,255,62,0.18)" : "rgba(255,255,255,0.04)",
                  color: isToday ? "#000" : isPast ? TOKENS.ember : TOKENS.mutedFaint,
                  border: isToday ? `1.5px solid ${TOKENS.ember}` : `1px solid ${isPast ? "rgba(215,255,62,0.3)" : "rgba(255,255,255,0.08)"}`,
                }}
              >
                {isPast ? "✓" : isToday ? "⚡" : ""}
              </div>
            </div>
          );
        })}
      </div>

      {/* 1-Tap Quick Action Hub */}
      <div style={{ display: "grid", gridTemplateColumns: "repeat(4, 1fr)", gap: 8, marginBottom: 14 }}>
        <button
          onClick={() => onNavigate("nutrition")}
          style={{
            background: "rgba(255,255,255,0.04)",
            backdropFilter: "blur(12px)",
            border: `1px solid ${TOKENS.border}`,
            borderRadius: 14,
            padding: "10px 4px",
            display: "flex",
            flexDirection: "column",
            alignItems: "center",
            gap: 4,
            cursor: "pointer",
          }}
        >
          <span style={{ fontSize: 18 }}>📷</span>
          <span style={{ fontSize: 11, fontWeight: 600, color: TOKENS.text }}>Scan Meal</span>
        </button>

        <button
          onClick={() => onNavigate("workout")}
          style={{
            background: "rgba(255,255,255,0.04)",
            backdropFilter: "blur(12px)",
            border: `1px solid ${TOKENS.border}`,
            borderRadius: 14,
            padding: "10px 4px",
            display: "flex",
            flexDirection: "column",
            alignItems: "center",
            gap: 4,
            cursor: "pointer",
          }}
        >
          <span style={{ fontSize: 18 }}>🏋️</span>
          <span style={{ fontSize: 11, fontWeight: 600, color: TOKENS.text }}>Log Lift</span>
        </button>

        <button
          onClick={() => onNavigate("run")}
          style={{
            background: "rgba(255,255,255,0.04)",
            backdropFilter: "blur(12px)",
            border: `1px solid ${TOKENS.border}`,
            borderRadius: 14,
            padding: "10px 4px",
            display: "flex",
            flexDirection: "column",
            alignItems: "center",
            gap: 4,
            cursor: "pointer",
          }}
        >
          <span style={{ fontSize: 18 }}>🏃</span>
          <span style={{ fontSize: 11, fontWeight: 600, color: TOKENS.text }}>GPS Run</span>
        </button>

        <button
          onClick={() => addWater(0.25)}
          style={{
            background: "rgba(61,220,255,0.08)",
            backdropFilter: "blur(12px)",
            border: `1px solid rgba(61,220,255,0.25)`,
            borderRadius: 14,
            padding: "10px 4px",
            display: "flex",
            flexDirection: "column",
            alignItems: "center",
            gap: 4,
            cursor: "pointer",
          }}
        >
          <span style={{ fontSize: 18 }}>💧</span>
          <span style={{ fontSize: 11, fontWeight: 600, color: TOKENS.water }}>+250ml</span>
        </button>
      </div>

      {/* Hero Nutrition & Fuel Card */}
      <div
        onClick={() => onNavigate("nutrition")}
        style={{
          cursor: "pointer",
          background: TOKENS.surface,
          backdropFilter: "blur(16px) saturate(180%)",
          WebkitBackdropFilter: "blur(16px) saturate(180%)",
          border: `1px solid ${TOKENS.border}`,
          borderRadius: 22,
          padding: 22,
          marginBottom: 14,
          boxShadow: CARD_SHADOW,
        }}
      >
        <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 14 }}>
          <div style={{ fontSize: 11, color: TOKENS.mutedFaint, letterSpacing: 0.8, fontWeight: 700, textTransform: "uppercase" }}>
            Daily Fuel & Macros
          </div>
          <span style={{ fontSize: 11, color: TOKENS.ember, fontWeight: 600 }}>Log details →</span>
        </div>

        <div style={{ display: "flex", gap: 20, alignItems: "center" }}>
          <div style={{ position: "relative", flexShrink: 0 }}>
            <Ring pct={calPct} color={TOKENS.ember} trackColor={TOKENS.surface2} size={130} stroke={12} />
            <div style={{ position: "absolute", inset: 0, display: "flex", flexDirection: "column", alignItems: "center", justifyContent: "center" }}>
              <div style={{ fontSize: 24, fontWeight: 800, color: TOKENS.text, fontVariantNumeric: "tabular-nums", letterSpacing: -0.5 }}>
                {kcalRemaining}
              </div>
              <div style={{ fontSize: 10, color: TOKENS.mutedFaint, fontWeight: 600, textTransform: "uppercase" }}>kcal left</div>
            </div>
          </div>
          <div style={{ flex: 1, minWidth: 0 }}>
            <MacroBar label="Protein" value={totals.protein} goal={goals.protein} color={TOKENS.protein} />
            <MacroBar label="Carbs" value={totals.carbs} goal={goals.carbs} color={TOKENS.carbs} />
            <MacroBar label="Fat" value={totals.fat} goal={goals.fat} color={TOKENS.fat} />
          </div>
        </div>
      </div>

      {/* Quick Hydration Widget */}
      <div
        style={{
          background: "linear-gradient(135deg, rgba(61,220,255,0.08) 0%, rgba(20,20,20,0.6) 100%)",
          backdropFilter: "blur(16px)",
          border: `1px solid rgba(61,220,255,0.2)`,
          borderRadius: 18,
          padding: "16px 18px",
          marginBottom: 14,
        }}
      >
        <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 10 }}>
          <div style={{ display: "flex", alignItems: "center", gap: 8 }}>
            <span style={{ fontSize: 16 }}>💧</span>
            <span style={{ fontSize: 13, fontWeight: 700, color: TOKENS.text }}>Hydration</span>
          </div>
          <div style={{ fontSize: 13, fontWeight: 700, color: TOKENS.water }}>
            {water.toFixed(1)} <span style={{ fontSize: 11, color: TOKENS.mutedFaint }}>/ {waterGoal}L</span>
          </div>
        </div>

        {/* Hydration Progress Bar */}
        <div style={{ height: 6, background: "rgba(255,255,255,0.08)", borderRadius: 999, overflow: "hidden", marginBottom: 12 }}>
          <div style={{ width: `${waterPct * 100}%`, height: "100%", background: TOKENS.water, borderRadius: 999, transition: "width 0.3s ease" }} />
        </div>

        <div style={{ display: "flex", gap: 8 }}>
          <button
            onClick={() => addWater(0.25)}
            style={{ flex: 1, background: "rgba(61,220,255,0.14)", border: `1px solid rgba(61,220,255,0.3)`, borderRadius: 8, padding: "7px 0", color: TOKENS.water, fontWeight: 700, fontSize: 12, cursor: "pointer" }}
          >
            +250 ml
          </button>
          <button
            onClick={() => addWater(0.5)}
            style={{ flex: 1, background: "rgba(61,220,255,0.14)", border: `1px solid rgba(61,220,255,0.3)`, borderRadius: 8, padding: "7px 0", color: TOKENS.water, fontWeight: 700, fontSize: 12, cursor: "pointer" }}
          >
            +500 ml
          </button>
          <button
            onClick={() => addWater(0.75)}
            style={{ flex: 1, background: "rgba(61,220,255,0.14)", border: `1px solid rgba(61,220,255,0.3)`, borderRadius: 8, padding: "7px 0", color: TOKENS.water, fontWeight: 700, fontSize: 12, cursor: "pointer" }}
          >
            +750 ml
          </button>
        </div>
      </div>

      {/* Workout & Running Dual Cards */}
      <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 12, marginBottom: 14 }}>
        <div
          onClick={() => onNavigate("workout")}
          style={{ cursor: "pointer", background: TOKENS.ember, borderRadius: 20, padding: 18, boxShadow: CARD_SHADOW }}
        >
          <div style={{ display: "flex", justifyContent: "space-between", alignItems: "flex-start", marginBottom: 12 }}>
            <IconBadge emoji="🏋️" bg="rgba(0,0,0,0.12)" />
            {!workoutDay.rest && <SmallRing pct={completedCount / Math.max(1, workoutDay.exercises.length)} color="#0B0E13" size={32} stroke={4} />}
          </div>
          <div style={{ fontSize: 10.5, color: "rgba(11,14,19,0.65)", fontWeight: 700, textTransform: "uppercase", letterSpacing: 0.5 }}>{TODAY_KEY} Workout</div>
          <div style={{ fontSize: 15, fontWeight: 800, color: "#0B0E13", marginTop: 2 }}>{workoutDay.label}</div>
          {!workoutDay.rest && (
            <div style={{ fontSize: 11.5, color: "rgba(11,14,19,0.7)", marginTop: 2, fontWeight: 600 }}>
              {completedCount}/{workoutDay.exercises.length} finished
            </div>
          )}
        </div>

        <div
          onClick={() => onNavigate("run")}
          style={{ cursor: "pointer", background: "linear-gradient(145deg, #1C2430 0%, #12161E 100%)", border: `1px solid rgba(255,255,255,0.1)`, borderRadius: 20, padding: 18, boxShadow: CARD_SHADOW }}
        >
          <div style={{ display: "flex", justifyContent: "space-between", alignItems: "flex-start", marginBottom: 12 }}>
            <IconBadge emoji="🏃" bg="rgba(215,255,62,0.16)" />
            <span style={{ fontSize: 10, background: "rgba(215,255,62,0.15)", color: TOKENS.ember, padding: "2px 6px", borderRadius: 6, fontWeight: 700 }}>STOKE</span>
          </div>
          <div style={{ fontSize: 10.5, color: TOKENS.mutedFaint, fontWeight: 700, textTransform: "uppercase", letterSpacing: 0.5 }}>Run Tracker</div>
          {lastRun ? (
            <div style={{ fontSize: 15, fontWeight: 800, color: "#FFFFFF", marginTop: 2 }}>{lastRun.distanceKm.toFixed(2)} km</div>
          ) : (
            <div style={{ fontSize: 15, fontWeight: 800, color: "#FFFFFF", marginTop: 2 }}>Start Run</div>
          )}
          <div style={{ fontSize: 11.5, color: TOKENS.muted, marginTop: 2 }}>
            {lastRun ? `${lastRun.calories} kcal burned` : "GPS & Story card"}
          </div>
        </div>
      </div>

      {/* AI Coach Daily Insight Card */}
      <div
        onClick={() => onNavigate("coach")}
        style={{
          cursor: "pointer",
          background: "linear-gradient(135deg, rgba(215,255,62,0.06) 0%, rgba(30,30,30,0.7) 100%)",
          backdropFilter: "blur(16px) saturate(180%)",
          WebkitBackdropFilter: "blur(16px) saturate(180%)",
          border: `1px solid rgba(215,255,62,0.25)`,
          borderRadius: 20,
          padding: "16px 18px",
          marginBottom: 14,
          boxShadow: CARD_SHADOW,
        }}
      >
        <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 8 }}>
          <div style={{ display: "flex", alignItems: "center", gap: 6 }}>
            <span style={{ fontSize: 15 }}>⚡</span>
            <span style={{ fontSize: 12, fontWeight: 800, color: TOKENS.ember, textTransform: "uppercase", letterSpacing: 0.5 }}>AI Coach Insight</span>
          </div>
          <span style={{ fontSize: 11, color: TOKENS.muted, fontWeight: 600 }}>Chat →</span>
        </div>
        <p style={{ margin: 0, fontSize: 13, lineHeight: 1.45, color: TOKENS.text }}>
          {coachTip}
        </p>
      </div>

      {/* Readiness / Energy Gauge */}
      <div
        style={{
          background: TOKENS.surface,
          border: `1px solid ${TOKENS.border}`,
          borderRadius: 18,
          padding: "14px 18px",
          display: "flex",
          justifyContent: "space-between",
          alignItems: "center",
        }}
      >
        <div style={{ display: "flex", alignItems: "center", gap: 10 }}>
          <div style={{ width: 36, height: 36, borderRadius: 10, background: "rgba(46,212,191,0.15)", display: "flex", alignItems: "center", justifyContent: "center", color: TOKENS.teal, fontSize: 16 }}>
            🔋
          </div>
          <div>
            <div style={{ fontSize: 13, fontWeight: 700, color: TOKENS.text }}>Readiness: Optimal (92%)</div>
            <div style={{ fontSize: 11, color: TOKENS.mutedFaint }}>Based on today's calories, training & hydration</div>
          </div>
        </div>
        <span style={{ fontSize: 12, fontWeight: 700, color: TOKENS.teal }}>Ready</span>
      </div>
    </div>
  );
}

const DOW_LABELS = ["S", "M", "T", "W", "T", "F", "S"];

function DaySelector() {
  const todayIdx = new Date().getDay();
  return (
    <div style={{ display: "flex", justifyContent: "space-between", marginBottom: 18 }}>
      {DOW_LABELS.map((d, i) => {
        const isToday = i === todayIdx;
        return (
          <div key={i} style={{ display: "flex", flexDirection: "column", alignItems: "center", gap: 6, opacity: isToday ? 1 : 0.35 }}>
            <span style={{ fontSize: 11, color: TOKENS.mutedFaint, fontWeight: 600 }}>{d}</span>
            <span
              style={{
                width: 24, height: 24, borderRadius: "50%",
                border: isToday ? `1.5px dashed ${TOKENS.ember}` : `1px solid ${TOKENS.border}`,
                display: "block",
              }}
            />
          </div>
        );
      })}
    </div>
  );
}

function MiniMacroCard({ label, value, goal, color }) {
  const pct = Math.min(100, (value / goal) * 100);
  return (
    <div style={{ flex: 1 }}>
      <div style={{ fontSize: 11, color: TOKENS.mutedFaint, marginBottom: 4 }}>{label}</div>
      <div style={{ fontSize: 15, fontWeight: 700, color: TOKENS.text, marginBottom: 6 }}>
        {Math.round(value)}g <span style={{ fontSize: 11, color: TOKENS.mutedFaint, fontWeight: 400 }}>/ {goal}</span>
      </div>
      <div style={{ height: 4, background: TOKENS.surface2, borderRadius: 2, overflow: "hidden" }}>
        <div style={{ height: "100%", width: `${pct}%`, background: color, borderRadius: 2 }} />
      </div>
    </div>
  );
}

function NutritionScreen({ meals, mealSlots, addMealSlot, removeMealSlot, water, setWater, addItem, removeItem, totals, calPct, goals }) {
  const [newMealName, setNewMealName] = useState("");
  const addMealInputRef = useRef(null);

  function handleAddSlot() {
    if (!newMealName.trim()) return;
    addMealSlot(newMealName.trim());
    setNewMealName("");
  }

  function handleFabClick() {
    addMealInputRef.current?.scrollIntoView({ behavior: "smooth", block: "center" });
    addMealInputRef.current?.focus();
  }

  const kcalLeft = Math.max(0, Math.round(goals.calories - totals.calories));

  return (
    <div>
      <div style={{ marginBottom: 18 }}>
        <div style={{ fontSize: 12, color: TOKENS.mutedFaint, letterSpacing: 0.5 }}>Nutrition</div>
        <h1 style={{ margin: "2px 0 0", fontSize: 24, fontWeight: 700, color: TOKENS.text }}>Today's fuel</h1>
      </div>

      <DaySelector />

      <div style={{ background: TOKENS.surface, backdropFilter: "blur(16px) saturate(180%)", WebkitBackdropFilter: "blur(16px) saturate(180%)", border: `1px solid ${TOKENS.border}`, borderRadius: 18, padding: "18px 20px", marginBottom: 12, boxShadow: CARD_SHADOW }}>
        <div style={{ fontSize: 12, color: TOKENS.mutedFaint, marginBottom: 8 }}>Calories</div>
        <div style={{ display: "flex", justifyContent: "space-between", alignItems: "baseline", marginBottom: 10 }}>
          <div style={{ fontSize: 24, fontWeight: 700, color: TOKENS.text }}>
            {Math.round(totals.calories)} <span style={{ fontSize: 13, color: TOKENS.mutedFaint, fontWeight: 400 }}>/ {goals.calories}</span>
          </div>
          <div style={{ fontSize: 14, fontWeight: 700, color: TOKENS.ember }}>{kcalLeft} <span style={{ fontSize: 11, color: TOKENS.mutedFaint, fontWeight: 500 }}>left</span></div>
        </div>
        <div style={{ height: 6, background: TOKENS.surface2, borderRadius: 3, overflow: "hidden" }}>
          <div style={{ height: "100%", width: `${Math.min(100, calPct * 100)}%`, background: TOKENS.ember, borderRadius: 3 }} />
        </div>
      </div>

      <div style={{ background: TOKENS.surface, backdropFilter: "blur(16px) saturate(180%)", WebkitBackdropFilter: "blur(16px) saturate(180%)", border: `1px solid ${TOKENS.border}`, borderRadius: 18, padding: "18px 20px", marginBottom: 18, display: "flex", gap: 18, boxShadow: CARD_SHADOW }}>
        <MiniMacroCard label="Carbs" value={totals.carbs} goal={goals.carbs} color={TOKENS.carbs} />
        <MiniMacroCard label="Fat" value={totals.fat} goal={goals.fat} color={TOKENS.fat} />
        <MiniMacroCard label="Protein" value={totals.protein} goal={goals.protein} color={TOKENS.protein} />
        <MiniMacroCard label="Fibre" value={totals.fiber} goal={goals.fiber} color={TOKENS.fiber} />
      </div>
      <div style={{ background: TOKENS.surface, backdropFilter: "blur(16px) saturate(180%)", WebkitBackdropFilter: "blur(16px) saturate(180%)", border: `1px solid ${TOKENS.border}`, borderRadius: 14, padding: "14px 18px", marginBottom: 22, display: "flex", alignItems: "center", justifyContent: "space-between", boxShadow: CARD_SHADOW }}>
        <div>
          <div style={{ fontSize: 13, color: TOKENS.muted, fontWeight: 500 }}>💧 Water</div>
          <div style={{ fontSize: 18, fontWeight: 700, color: TOKENS.text }}>{water.toFixed(1)}L <span style={{ fontSize: 13, color: TOKENS.mutedFaint, fontWeight: 400 }}>/ {goals.water}L</span></div>
        </div>
        <div style={{ display: "flex", gap: 8 }}>
          <button onClick={() => setWater((w) => Math.max(0, w - 0.25))} style={waterBtnStyle}>−</button>
          <button onClick={() => setWater((w) => w + 0.25)} style={waterBtnStyle}>+</button>
        </div>
      </div>
      {mealSlots.map((slot) => (
        <MealSection
          key={slot.key}
          mealKey={slot.key}
          label={slot.label}
          items={meals[slot.key] || []}
          onAdd={(item) => addItem(slot.key, item)}
          onRemove={(idx) => removeItem(slot.key, idx)}
          onRemoveSlot={mealSlots.length > 1 ? () => removeMealSlot(slot.key) : null}
        />
      ))}

      <div style={{ background: TOKENS.surface2, backdropFilter: "blur(16px) saturate(180%)", WebkitBackdropFilter: "blur(16px) saturate(180%)", border: `1px dashed ${TOKENS.border}`, borderRadius: 14, padding: 16, marginTop: 4 }}>
        <label style={{ fontSize: 11, color: TOKENS.mutedFaint, display: "block", marginBottom: 6 }}>Add a custom meal</label>
        <div style={{ display: "flex", gap: 8 }}>
          <input
            ref={addMealInputRef}
            value={newMealName}
            onChange={(e) => setNewMealName(e.target.value)}
            onKeyDown={(e) => e.key === "Enter" && handleAddSlot()}
            placeholder="e.g. Late Night Snack"
            style={{ flex: 1, background: TOKENS.bg, border: `1px solid ${TOKENS.border}`, borderRadius: 8, padding: "9px 12px", color: TOKENS.text, fontSize: 14, boxSizing: "border-box" }}
          />
          <button onClick={handleAddSlot} style={{ background: "#111111", color: "#FFFFFF", border: "none", borderRadius: 8, padding: "0 18px", fontSize: 13, fontWeight: 700, cursor: "pointer" }}>
            + Add
          </button>
        </div>
      </div>

      <button
        onClick={handleFabClick}
        aria-label="Quick add"
        style={{
          position: "fixed",
          right: 20,
          bottom: 86,
          width: 52,
          height: 52,
          borderRadius: "50%",
          background: TOKENS.ember,
          color: "#0B0E13",
          border: "none",
          fontSize: 26,
          fontWeight: 700,
          cursor: "pointer",
          boxShadow: "0 6px 18px rgba(215,255,62,0.35)",
          zIndex: 40,
        }}
      >
        +
      </button>
    </div>
  );
}

const waterBtnStyle = { width: 34, height: 34, borderRadius: "50%", border: "none", background: "#161616", color: TOKENS.text, fontSize: 18, cursor: "pointer", display: "flex", alignItems: "center", justifyContent: "center",
  boxShadow: "4px 4px 8px rgba(0,0,0,0.6), -4px -4px 8px rgba(255,255,255,0.04)" };

function WorkoutScreen({ week, programKey, onProgramChange, activeDay, setActiveDay, logs, updateSet, addSet, toggleComplete }) {
  const day = week[activeDay];
  const dayLog = logs[activeDay];
  const completedCount = day.exercises.filter((ex) => dayLog[ex.name]?.completed).length;
  return (
    <div>
      <div style={{ marginBottom: 18 }}>
        <div style={{ fontSize: 12, color: TOKENS.mutedFaint, letterSpacing: 0.5 }}>This week</div>
        <h1 style={{ margin: "2px 0 0", fontSize: 24, fontWeight: 700, color: TOKENS.text }}>Workout plan</h1>
      </div>

      {/* 10s Animation & English Voice Coach Banner */}
      <div style={{ background: "linear-gradient(135deg, rgba(215,255,62,0.12) 0%, rgba(34,197,94,0.06) 100%)", border: "1px solid rgba(215,255,62,0.25)", borderRadius: 16, padding: "12px 14px", marginBottom: 16, display: "flex", alignItems: "center", gap: 10, boxShadow: "0 4px 16px rgba(0,0,0,0.4)" }}>
        <span style={{ fontSize: 26 }}>⚡</span>
        <div>
          <div style={{ fontSize: 12.5, fontWeight: 800, color: "#D7FF3E" }}>10s Biomechanical Animation & English Voice Coach</div>
          <div style={{ fontSize: 11, color: "rgba(255,255,255,0.7)", marginTop: 1 }}>Tap "▶ 10s Animation & English Coach" on any exercise to watch 10-second exercise animations with spoken & written English coaching!</div>
        </div>
      </div>

      <div style={{ marginBottom: 14 }}>
        <label style={{ fontSize: 11, color: TOKENS.mutedFaint, display: "block", marginBottom: 6 }}>Program</label>
        <div style={{ display: "flex", gap: 8, overflowX: "auto", paddingBottom: 2 }}>
          {PROGRAM_NAMES.map((name) => {
            const active = name === programKey;
            return (
              <button
                key={name}
                onClick={() => onProgramChange(name)}
                style={{
                  flex: "0 0 auto",
                  padding: "9px 14px",
                  borderRadius: 10,
                  border: "none",
                  background: active ? TOKENS.ember : "#161616",
                  color: active ? "#0B0E13" : TOKENS.text,
                  fontSize: 12,
                  fontWeight: 600,
                  cursor: "pointer",
                  whiteSpace: "nowrap",
                  boxShadow: active
                    ? "inset 3px 3px 6px rgba(150,190,10,0.35), inset -3px -3px 6px rgba(255,255,150,0.15)"
                    : "4px 4px 8px rgba(0,0,0,0.6), -4px -4px 8px rgba(255,255,255,0.04)",
                }}
              >
                {name}
              </button>
            );
          })}
        </div>
      </div>

      <div style={{ display: "flex", gap: 6, marginBottom: 18, overflowX: "auto", paddingBottom: 2 }}>
        {DAY_ORDER.map((d) => {
          const isActive = d === activeDay;
          const dRest = week[d].rest;
          const dCompleted = !dRest && week[d].exercises.length > 0 && week[d].exercises.every((ex) => logs[d][ex.name]?.completed);
          return (
            <button key={d} onClick={() => setActiveDay(d)} style={{ flex: "0 0 auto", padding: "8px 14px", borderRadius: 10, border: "none",
              background: isActive ? TOKENS.ember : "#161616", color: isActive ? "#1A0F08" : dRest ? TOKENS.mutedFaint : TOKENS.text, fontSize: 13, fontWeight: 600, cursor: "pointer", position: "relative",
              boxShadow: isActive
                ? "inset 3px 3px 6px rgba(0,0,0,0.4), inset -3px -3px 6px rgba(255,255,255,0.08)"
                : "4px 4px 8px rgba(0,0,0,0.6), -4px -4px 8px rgba(255,255,255,0.04)" }}>
              {d}{dCompleted && !isActive && <span style={{ position: "absolute", top: -4, right: -4, fontSize: 10, color: TOKENS.teal }}>✓</span>}
            </button>
          );
        })}
      </div>
      <div style={{ background: TOKENS.surface, backdropFilter: "blur(16px) saturate(180%)", WebkitBackdropFilter: "blur(16px) saturate(180%)", border: `1px solid ${TOKENS.border}`, borderRadius: 14, padding: "16px 18px", marginBottom: 16, display: "flex", justifyContent: "space-between", alignItems: "center", boxShadow: CARD_SHADOW }}>
        <div>
          <div style={{ fontSize: 18, fontWeight: 700, color: TOKENS.text }}>{day.label}</div>
          {!day.rest && <div style={{ fontSize: 12, color: TOKENS.mutedFaint, marginTop: 2 }}>{completedCount} / {day.exercises.length} exercises done</div>}
        </div>
        {!day.rest && <SmallRing pct={completedCount / Math.max(1, day.exercises.length)} color={TOKENS.ember} />}
      </div>
      {day.rest ? (
        <div style={{ textAlign: "center", padding: "40px 0", color: TOKENS.mutedFaint, fontSize: 14 }}>Rest day — recover up. 🌱</div>
      ) : (
        day.exercises.map((ex) => (
          <ExerciseCard
            key={ex.name}
            ex={ex}
            log={dayLog[ex.name].sets}
            completed={dayLog[ex.name].completed}
            workoutLabel={day.label}
            allExercises={day.exercises}
            onSetChange={(i, field, val) => updateSet(ex.name, i, field, val)}
            onAddSet={() => addSet(ex.name)}
            onToggleComplete={() => toggleComplete(ex.name)}
          />
        ))
      )}
    </div>
  );
}

const GIRL_VOICES = [
  {
    id: "lily",
    name: "Lily",
    label: "🌸 Lily (Super Cute & Sweet)",
    tag: "Cute & Sweet",
    pitch: 1.55,
    rate: 1.08,
    avatar: "🌸",
