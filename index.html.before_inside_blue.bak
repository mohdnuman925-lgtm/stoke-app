                      {delta > 0 ? `+${delta}` : delta} kg
                    </button>
                  ))}
                </div>

                {/* Direct input entry */}
                <div style={{ display: "flex", gap: 10, marginBottom: 20 }}>
                  <input
                    type="number"
                    step="0.1"
                    placeholder="Enter weight in kg"
                    value={newWeightInput}
                    onChange={e => setNewWeightInput(e.target.value)}
                    style={{
                      flex: 1,
                      background: "#0B0E14",
                      border: "1.5px solid rgba(255,255,255,0.1)",
                      borderRadius: 14,
                      padding: "14px 16px",
                      color: "#FFFFFF",
                      fontSize: 16,
                      fontWeight: 700,
                      outline: "none",
                      boxShadow: "var(--neu-inset)"
                    }}
                  />
                  <button
                    onClick={() => handleLogWeight(newWeightInput)}
                    className="s3-primary-btn mat-ripple"
                    style={{ width: "auto", padding: "0 22px", borderRadius: 14 }}
                  >
                    Log Weight
                  </button>
                </div>

                {/* Recent Weigh-ins Table */}
                <div style={{ fontSize: 11, color: "rgba(255,255,255,0.38)", fontWeight: 800, letterSpacing: 2, textTransform: "uppercase", marginBottom: 8 }}>
                  Recent Weigh-ins
                </div>
                <div className="prof-section-card" style={{ marginBottom: 0 }}>
                  {weightLogs.slice(-4).reverse().map((log, i) => (
                    <div key={i} style={{ display: "flex", justifyContent: "space-between", padding: "12px 16px", borderBottom: i < 3 ? "1px solid rgba(255,255,255,0.05)" : "none" }}>
                      <span style={{ fontSize: 13, color: "rgba(255,255,255,0.7)" }}>{log.date}</span>
                      <span style={{ fontSize: 14, fontWeight: 800, color: "#FFFFFF" }}>{log.weight.toFixed(1)} kg</span>
                    </div>
                  ))}
                </div>
              </div>
            )}

            {/* ── MODAL 3: INTERMITTENT FASTING ── */}
            {activeModal === "fasting" && (
              <div style={{ textAlign: "center" }}>
                <div style={{
                  background: "#0B0E14",
                  borderRadius: 24,
                  padding: "28px 20px",
                  border: "1px solid rgba(255,255,255,0.06)",
                  boxShadow: "inset 3px 3px 8px rgba(0,0,0,0.7)",
                  marginBottom: 18
                }}>
                  <div style={{ fontSize: 11, color: "rgba(255,255,255,0.4)", fontWeight: 800, letterSpacing: 1.5, textTransform: "uppercase" }}>
                    {isFasting ? "Fast In Progress" : "Fasting Idle"} · {fastGoal}:8 Protocol
                  </div>
                  <div style={{ fontSize: 48, fontWeight: 900, color: LIME, letterSpacing: -1.5, margin: "8px 0" }}>
                    {fastHours}h {fastMins}m
                  </div>
                  <div style={{ fontSize: 13, color: CYAN, fontWeight: 700 }}>
                    🔥 Peak Autophagy & Fat Oxidation Active
                  </div>
                  {/* Progress bar */}
                  <div style={{ height: 8, background: "rgba(255,255,255,0.08)", borderRadius: 999, overflow: "hidden", margin: "18px 0 10px" }}>
                    <div style={{ width: `${Math.min(100, (fastHours / fastGoal) * 100)}%`, height: "100%", background: `linear-gradient(90deg, ${CYAN}, ${LIME})`, borderRadius: 999 }} />
                  </div>
                  <div style={{ display: "flex", justifyContent: "space-between", fontSize: 11, color: "rgba(255,255,255,0.4)" }}>
                    <span>Target: {fastGoal} hours</span>
                    <span>Elapsed: {((fastHours / fastGoal) * 100).toFixed(0)}%</span>
                  </div>
                </div>

                <div style={{ display: "flex", gap: 8, marginBottom: 18 }}>
                  {[14, 16, 18, 20].map(h => (
                    <button
                      key={h}
                      onClick={() => setFastGoal(h)}
                      className={`s3-pill${fastGoal === h ? " sel" : ""}`}
                      style={{ padding: "10px 0", fontSize: 13 }}
                    >
                      {h}:{24 - h}
                    </button>
                  ))}
                </div>

                <button
                  onClick={() => {
                    setIsFasting(!isFasting);
                    triggerToast(isFasting ? "Fast ended & logged" : "New fast started!");
                  }}
                  className="s3-primary-btn mat-ripple"
                  style={{ background: isFasting ? "linear-gradient(135deg, #EF4444 0%, #DC2626 100%)" : undefined, color: isFasting ? "#FFFFFF" : "#060809" }}
                >
                  {isFasting ? "🛑 Stop Fast" : "▶ Start New Fast"}
                </button>
              </div>
            )}

            {/* ── MODAL 4: CONNECTED DEVICES ── */}
            {activeModal === "devices" && (
              <div>
                <div style={{ display: "flex", flexDirection: "column", gap: 10 }}>
                  {[
                    { key: "appleHealth", name: "Apple Health", desc: "Syncs steps, workouts, heart rate & sleep", icon: "🍎" },
                    { key: "googleFit", name: "Google Fit", desc: "Syncs daily active minutes & distance", icon: "🌐" },
                    { key: "garmin", name: "Garmin Connect", desc: "GPS route telemetry and VO2 max", icon: "⌚" },
                    { key: "strava", name: "Strava", desc: "Auto-exports outdoor running splits", icon: "🏃" },
                  ].map(dev => (
                    <div
                      key={dev.key}
                      onClick={() => {
                        setDevices(prev => ({ ...prev, [dev.key]: !prev[dev.key] }));
                        triggerToast(`Updated ${dev.name} connection status`);
                      }}
                      className="s3-option"
                      style={{ padding: "14px 16px" }}
                    >
                      <div style={{ display: "flex", alignItems: "center", gap: 14 }}>
                        <span style={{ fontSize: 24 }}>{dev.icon}</span>
                        <div>
                          <div style={{ fontSize: 15, fontWeight: 700, color: "#FFFFFF" }}>{dev.name}</div>
                          <div style={{ fontSize: 11.5, color: "rgba(255,255,255,0.4)" }}>{dev.desc}</div>
                        </div>
                      </div>
                      <NeuCheckbox checked={devices[dev.key]} />
                    </div>
                  ))}
                </div>
              </div>
            )}

            {/* ── MODAL 5: REMINDERS ── */}
            {activeModal === "reminders" && (
              <div style={{ display: "flex", flexDirection: "column", gap: 10 }}>
                {[
                  { key: "breakfast", label: "Breakfast Logging Prompt", time: "8:30 AM" },
                  { key: "lunch", label: "Lunch Logging Prompt", time: "1:00 PM" },
                  { key: "dinner", label: "Dinner Logging Prompt", time: "7:30 PM" },
                  { key: "water", label: "Hourly Hydration Reminders", time: "Every 2 hrs" },
                  { key: "workout", label: "Daily Workout Notification", time: "5:00 PM" },
                ].map(r => (
                  <div
                    key={r.key}
                    onClick={() => {
                      setReminders(prev => ({ ...prev, [r.key]: !prev[r.key] }));
                      triggerToast("Reminder settings saved");
                    }}
                    className="s3-option"
                    style={{ padding: "14px 16px" }}
                  >
                    <div>
                      <div style={{ fontSize: 14, fontWeight: 700, color: "#FFFFFF" }}>{r.label}</div>
                      <div style={{ fontSize: 11, color: LIME }}>Scheduled for {r.time}</div>
                    </div>
                    <NeuCheckbox checked={reminders[r.key]} />
                  </div>
                ))}
              </div>
            )}

            {/* ── MODAL 6: PREMIUM MODAL ── */}
            {activeModal === "premium" && (
              <div style={{ textAlign: "center" }}>
                <div style={{ fontSize: 44, marginBottom: 12 }}>👑</div>
                <h3 style={{ fontSize: 22, fontWeight: 900, color: "#FFFFFF", margin: "0 0 6px" }}>Unlock STOKE Pro Elite</h3>
                <p style={{ fontSize: 13, color: "rgba(255,255,255,0.5)", margin: "0 0 20px" }}>Precision training & AI nutrition for high performers</p>
                <div style={{ display: "flex", flexDirection: "column", gap: 8, marginBottom: 24, textAlign: "left" }}>
                  {[
                    "AI Smart Camera: Snap any plate to log calories instantly",
                    "Voice Logging: Speak natural meals into instant macros",
                    "Advanced Fasting Stages: Cellular autophagy & ketosis radar",
                    "Live GPS Heart Rate Zones & cadence metrics",
                    "Custom macro splits & carb-cycling schedules",
                  ].map((feat, i) => (
                    <div key={i} style={{ display: "flex", alignItems: "center", gap: 10, fontSize: 13, color: "rgba(255,255,255,0.85)" }}>
                      <span style={{ color: LIME, fontWeight: 900 }}>✓</span> {feat}
                    </div>
                  ))}
                </div>
                <button
                  onClick={() => {
                    setActiveModal(null);
                    triggerToast("👑 STOKE Pro unlocked for your account!");
                  }}
                  className="s3-primary-btn mat-ripple"
                >
                  Start 14-Day Free Trial
                </button>
              </div>
            )}

            {/* ── MODAL 7: SLEEP & STEPS & OTHERS ── */}
            {(activeModal === "sleep" || activeModal === "steps" || activeModal === "settings" || activeModal === "privacy" || activeModal === "goals") && (
              <div>
                <div style={{ background: "#0B0E14", borderRadius: 18, padding: 20, textAlign: "center", marginBottom: 16 }}>
                  <div style={{ fontSize: 11, color: "rgba(255,255,255,0.4)", fontWeight: 800, textTransform: "uppercase", letterSpacing: 1.5 }}>
                    {activeModal === "sleep" ? "Recovery Index" : activeModal === "steps" ? "Daily Step Goal" : "Configuration Status"}
                  </div>
                  <div style={{ fontSize: 40, fontWeight: 900, color: LIME, margin: "6px 0" }}>
                    {activeModal === "sleep" ? "88 / 100" : activeModal === "steps" ? "7,420 steps" : "OPTIMIZED"}
                  </div>
                  <div style={{ fontSize: 13, color: "rgba(255,255,255,0.6)" }}>
                    {activeModal === "sleep" ? "7h 48m total sleep · 1h 50m deep sleep" : activeModal === "steps" ? "Goal: 10,000 steps · 2,580 steps to go" : "All local telemetry encrypted and backed up"}
                  </div>
                </div>
                <button onClick={() => setActiveModal(null)} className="s3-primary-btn mat-ripple">Done</button>
              </div>
            )}

          </div>
        </div>
      )}

    </div>
  );
}


/* ============================================================
   STOKE — MULTI-DESIGN-SYSTEM AUTH v3.0
   Fusing: Soft UI · Dark Neumorphism · Material Design · Swiss Design
   ============================================================ */

const AUTH_STYLES_V3 = `
  /* ── SWISS DESIGN: Typography foundation ── */
  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700;800;900&display=swap');

  /* ── KEYFRAMES ── */
  @keyframes neu-ripple {
    0%   { transform: scale(0); opacity: 0.6; }
    100% { transform: scale(4); opacity: 0; }
  }
  @keyframes fadeUp3 {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes slideRight3 {
    from { opacity: 0; transform: translateX(24px); }
    to   { opacity: 1; transform: translateX(0); }
  }
  @keyframes slideLeft3 {
    from { opacity: 0; transform: translateX(-24px); }
    to   { opacity: 1; transform: translateX(0); }
  }
  @keyframes scaleFadeIn {
    from { opacity: 0; transform: scale(0.92); }
    to   { opacity: 1; transform: scale(1); }
  }
  @keyframes breatheGlow {
    0%,100% { filter: drop-shadow(0 0 8px rgba(215,255,62,0.3)); }
    50%     { filter: drop-shadow(0 0 18px rgba(215,255,62,0.6)); }
  }
  @keyframes progressFill {
    from { transform: scaleX(0); }
    to   { transform: scaleX(1); }
  }
  @keyframes selectPop {
    0%   { transform: scale(1); }
    40%  { transform: scale(0.96); }
    70%  { transform: scale(1.02); }
    100% { transform: scale(1); }
  }
  @keyframes cardEntrance {
    from { opacity: 0; transform: translateY(12px) scale(0.97); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }
  @keyframes errorSlideIn {
    from { opacity: 0; transform: translateY(-8px); max-height: 0; margin-bottom: 0; padding: 0 14px; }
    to   { opacity: 1; transform: translateY(0); max-height: 80px; margin-bottom: 14px; padding: 10px 14px; }
  }
  @keyframes skeletonPulse {
    0%   { background-position: -200% 0; }
    100% { background-position: 200% 0; }
  }
  @keyframes gentleBounce {
    0%,100% { transform: translateY(0); }
    50%     { transform: translateY(-4px); }
  }
  @keyframes viewCrossFade {
    0%   { opacity: 0; transform: translateY(6px) scale(0.99); }
    100% { opacity: 1; transform: translateY(0) scale(1); }
  }
  @keyframes particle3 {
    0%   { transform: translateY(0) rotate(0deg); opacity: 0.8; }
    100% { transform: translateY(-110vh) rotate(360deg); opacity: 0; }
  }
  @keyframes spin3    { to { transform: rotate(360deg); } }
  @keyframes orb3 {
    0%,100% { transform: scale(1) translate(0,0); opacity: 0.5; }
    33%     { transform: scale(1.2) translate(12px,-8px); opacity: 0.75; }
    66%     { transform: scale(0.9) translate(-8px,10px); opacity: 0.6; }
  }
  @keyframes pulseGlow3 {
    0%,100% { box-shadow: 0 0 0 0 rgba(37,107,253,0.45); }
    50%     { box-shadow: 0 0 0 10px rgba(37,107,253,0); }
  }
  @keyframes shimmer3 {
    0%   { background-position: -200% center; }
    100% { background-position:  200% center; }
  }
  @keyframes checkBounce3 {
    0%   { transform: scale(0) rotate(-15deg); }
    70%  { transform: scale(1.2) rotate(5deg); }
    100% { transform: scale(1) rotate(0deg); }
  }

  /* ── LOGIN ENTRANCE ANIMATIONS (300-500ms staggered) ── */
  @keyframes loginLogoEntrance {
    0%   { opacity: 0; transform: scale(0.8) translateY(-10px); }
    100% { opacity: 1; transform: scale(1) translateY(0); }
  }
  @keyframes loginTextEntrance {
    0%   { opacity: 0; transform: translateY(18px); }
    100% { opacity: 1; transform: translateY(0); }
  }
  @keyframes loginInputEntrance1 {
    0%   { opacity: 0; transform: translateY(22px); }
    100% { opacity: 1; transform: translateY(0); }
  }
  @keyframes loginInputEntrance2 {
    0%   { opacity: 0; transform: translateY(22px); }
    100% { opacity: 1; transform: translateY(0); }
  }
  @keyframes loginBtnEntrance {
    0%   { opacity: 0; transform: translateY(24px) scale(0.96); }
    100% { opacity: 1; transform: translateY(0) scale(1); }
  }
  @keyframes loginBottomEntrance {
    0%   { opacity: 0; }
    100% { opacity: 1; }
  }

  /* ── MODERN MOBILE LOGIN FIELD ── */
  .stoke-login-field {
    display: flex;
    align-items: center;
    background: rgba(14, 18, 28, 0.85);
    border: 1.5px solid rgba(255, 255, 255, 0.08);
    border-radius: 18px;
    height: 56px;
    padding: 0 16px;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.35);
    position: relative;
    box-sizing: border-box;
    width: 100%;
  }
  .stoke-login-field:focus-within {
    border-color: #256BFD;
    background: rgba(16, 23, 38, 0.95);
    box-shadow: 0 0 0 3px rgba(37, 107, 253, 0.22), 0 8px 24px rgba(0, 0, 0, 0.45);
    transform: translateY(-1px);
  }
  .stoke-login-field input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    color: #FFFFFF;
    font-size: 15px;
    font-weight: 500;
    padding: 0 12px;
    height: 100%;
    font-family: inherit;
    caret-color: #256BFD;
    box-sizing: border-box;
  }
  .stoke-login-field input::placeholder {
    color: rgba(255, 255, 255, 0.35);
    font-weight: 400;
  }

  /* ── SOFT UI / NEUMORPHISM: Dark surface tokens ── */
  :root {
    --neu-bg:    #0B0F18;
    --neu-light: rgba(255,255,255,0.055);
    --neu-dark:  rgba(0,0,0,0.55);
    --neu-inset: inset 3px 3px 8px rgba(0,0,0,0.55), inset -2px -2px 6px rgba(255,255,255,0.04);
    --neu-raised: 5px 5px 14px rgba(0,0,0,0.6), -3px -3px 10px rgba(255,255,255,0.04);
    --neu-flat:  2px 2px 6px rgba(0,0,0,0.4), -1px -1px 4px rgba(255,255,255,0.03);
    --lime:      #256BFD;
    --lime-glow: rgba(37,107,253,0.4);
    --mat-elev1: 0 1px 3px rgba(0,0,0,0.5), 0 1px 2px rgba(0,0,0,0.4);
    --mat-elev2: 0 3px 6px rgba(0,0,0,0.5), 0 3px 6px rgba(0,0,0,0.35);
    --mat-elev3: 0 10px 30px rgba(0,0,0,0.6), 0 6px 10px rgba(0,0,0,0.4);
    --mat-elev4: 0 20px 50px rgba(0,0,0,0.7), 0 10px 20px rgba(0,0,0,0.4);
  }

  /* ── MATERIAL DESIGN: Ripple effect ── */
  .mat-ripple {
    position: relative;
    overflow: hidden;
  }
  .mat-ripple::after {
    content: '';
    position: absolute;
    width: 60px; height: 60px;
    border-radius: 50%;
    background: rgba(37, 107, 253, 0.28);
    transform: scale(0);
    top: var(--ry, 50%); left: var(--rx, 50%);
    margin-top: -30px; margin-left: -30px;
    pointer-events: none;
    animation: none;
  }
  .mat-ripple.rippling::after {
    animation: neu-ripple 0.55s ease-out forwards;
  }

  /* ── MAIN BUTTON: Soft UI + Material + Swiss ── */
  .s3-primary-btn {
    width: 100%;
    background: linear-gradient(135deg, #2A72FD 0%, #1754DC 50%, #2A72FD 100%);
    background-size: 200% auto;
    color: #FFFFFF;
    border: none;
    border-radius: 16px;
    padding: 18px 0;
    font-weight: 900;
    font-size: 15px;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    cursor: pointer;
    font-family: inherit;
    box-shadow: var(--neu-raised), 0 8px 28px rgba(37, 107, 253, 0.4);
    transition: transform 0.22s cubic-bezier(0.34,1.56,0.64,1), box-shadow 0.22s ease, filter 0.22s ease;
    position: relative;
    overflow: hidden;
  }
  .s3-primary-btn::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, transparent 40%, rgba(255,255,255,0.3) 50%, transparent 60%);
    background-size: 200%;
    opacity: 0;
    transition: opacity 0.3s;
  }
  .s3-primary-btn:hover { transform: translateY(-3px) scale(1.01); box-shadow: var(--neu-raised), 0 16px 40px rgba(37, 107, 253, 0.55); filter: brightness(1.1); }
  .s3-primary-btn:hover::before { opacity: 1; animation: shimmer3 0.65s ease; }
  .s3-primary-btn:active { transform: translateY(1px) scale(0.98); box-shadow: var(--neu-inset), 0 4px 12px rgba(37, 107, 253, 0.3); }
  .s3-primary-btn:disabled { opacity: 0.5; cursor: not-allowed; transform: none; filter: saturate(0.7); }

  /* ── ANIMATED ERROR MESSAGE ── */
  .s3-error-msg {
    background: rgba(255,60,60,0.09);
    border: 1px solid rgba(255,80,80,0.28);
    border-radius: 14px;
    padding: 10px 14px;
    font-size: 12.5px;
    color: #FF7070;
    font-weight: 600;
    margin-bottom: 14px;
    display: flex;
    align-items: center;
    gap: 8px;
    animation: errorSlideIn 0.35s cubic-bezier(0.34,1.56,0.64,1) both;
    overflow: hidden;
  }

  /* ── VIEW TRANSITION WRAPPER ── */
  .s3-view-enter {
    animation: viewCrossFade 0.4s cubic-bezier(0.22,1,0.36,1) both;
  }

  /* ── SKELETON LOADING ── */
  .s3-skeleton {
    background: linear-gradient(90deg, rgba(255,255,255,0.04) 25%, rgba(255,255,255,0.08) 50%, rgba(255,255,255,0.04) 75%);
    background-size: 200% 100%;
    animation: skeletonPulse 1.5s ease infinite;
    border-radius: 8px;
  }

  /* ── STAGGER CHILDREN ── */
  .s3-stagger > * { animation: cardEntrance 0.4s cubic-bezier(0.22,1,0.36,1) both; }
  .s3-stagger > *:nth-child(1) { animation-delay: 0.04s; }
  .s3-stagger > *:nth-child(2) { animation-delay: 0.08s; }
  .s3-stagger > *:nth-child(3) { animation-delay: 0.12s; }
  .s3-stagger > *:nth-child(4) { animation-delay: 0.16s; }
  .s3-stagger > *:nth-child(5) { animation-delay: 0.20s; }
  .s3-stagger > *:nth-child(6) { animation-delay: 0.24s; }
  .s3-stagger > *:nth-child(7) { animation-delay: 0.28s; }
  .s3-stagger > *:nth-child(8) { animation-delay: 0.32s; }

  /* ── CATEGORY BADGE ── */
  .s3-cat-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(215,255,62,0.08);
    border: 1px solid rgba(215,255,62,0.2);
    border-radius: 999px;
    padding: 4px 12px;
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--lime);
    animation: fadeUp3 0.3s ease-out both;
  }

  /* ── GOOGLE BUTTON: Material elevated card ── */
  .s3-google-btn {
    width: 100%;
    background: #FFFFFF;
    color: #1a1a2e;
    border: none;
    border-radius: 16px;
    padding: 15px 0;
    font-weight: 700;
    font-size: 15px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font-family: inherit;
    box-shadow: var(--mat-elev2);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
    letter-spacing: 0.1px;
  }
  .s3-google-btn:hover { transform: translateY(-2px); box-shadow: var(--mat-elev3); }
  .s3-google-btn:active { transform: translateY(0px); box-shadow: var(--mat-elev1); }

  /* ── GHOST BUTTON: Neumorphic outlined ── */
  .s3-ghost-btn {
    width: 100%;
    background: rgba(255,255,255,0.04);
    color: rgba(255,255,255,0.85);
    border: 1.5px solid rgba(255,255,255,0.1);
    border-radius: 16px;
    padding: 15px 0;
    font-weight: 700;
    font-size: 14px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font-family: inherit;
    box-shadow: var(--neu-flat);
    transition: all 0.18s ease;
    letter-spacing: 0.2px;
  }
  .s3-ghost-btn:hover { background: rgba(255,255,255,0.07); box-shadow: var(--neu-raised); border-color: rgba(255,255,255,0.18); transform: translateY(-1px); }
  .s3-ghost-btn:active { box-shadow: var(--neu-inset); transform: translateY(0); }

  /* ── NEUMORPHIC INPUT (floating label) ── */
  .s3-field {
    position: relative;
    margin-bottom: 0;
  }
  .s3-field input,
  .s3-field select {
    width: 100%;
    background: #0D1018;
    border: 1.5px solid rgba(255,255,255,0.07);
    border-radius: 14px;
    padding: 22px 18px 8px;
    color: #F5F5F5;
    font-size: 15px;
    font-weight: 600;
    font-family: inherit;
    outline: none;
    box-sizing: border-box;
    box-shadow: var(--neu-inset);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
    -webkit-appearance: none;
    appearance: none;
  }
  .s3-field label {
    position: absolute;
    left: 18px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 14px;
    font-weight: 600;
    color: rgba(255,255,255,0.35);
    pointer-events: none;
    transition: all 0.22s cubic-bezier(0.4,0,0.2,1);
    letter-spacing: 0.2px;
  }
  .s3-field input:focus,
  .s3-field select:focus {
    border-color: var(--lime);
    box-shadow: var(--neu-inset), 0 0 0 3px rgba(215,255,62,0.1), 0 0 20px rgba(215,255,62,0.08);
  }
  .s3-field input:focus + label,
  .s3-field.filled label,
  .s3-field select:focus + label,
  .s3-field select.filled + label {
    top: 12px;
    transform: translateY(0);
    font-size: 10px;
    font-weight: 800;
    color: var(--lime);
    letter-spacing: 1px;
    text-transform: uppercase;
  }
  /* auto-filled fix */
  .s3-field input:not(:placeholder-shown) + label { top:12px; transform:translateY(0); font-size:10px; font-weight:800; color:var(--lime); letter-spacing:1px; text-transform:uppercase; }

  /* ── OPTION CARD: Swiss grid + Neumorphic surface ── */
  .s3-option {
    background: #0D1018;
    border: 1.5px solid rgba(255,255,255,0.07);
    border-radius: 16px;
    padding: 16px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    box-shadow: var(--neu-raised);
    transition: all 0.25s cubic-bezier(0.34,1.56,0.64,1);
    user-select: none;
    position: relative;
    overflow: hidden;
  }
  .s3-option::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(135deg, rgba(215,255,62,0.08) 0%, transparent 60%);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }
  .s3-option:hover { box-shadow: var(--mat-elev2); border-color: rgba(255,255,255,0.14); transform: translateY(-2px); }
  .s3-option.selected {
    background: rgba(215,255,62,0.07);
    border-color: var(--lime);
    box-shadow: 0 0 0 1.5px rgba(215,255,62,0.25), var(--mat-elev2), 0 0 28px rgba(215,255,62,0.1);
    animation: selectPop 0.35s cubic-bezier(0.34,1.56,0.64,1);
  }
  .s3-option.selected::before { opacity: 1; }
  .s3-option:active { box-shadow: var(--neu-inset); transform: scale(0.98); }

  /* ── CHIP: Material + Swiss ── */
  .s3-chip {
    background: #0D1018;
    color: rgba(255,255,255,0.7);
    border: 1px solid rgba(255,255,255,0.09);
    border-radius: 999px;
    padding: 9px 16px;
    font-size: 12.5px;
    font-weight: 700;
    cursor: pointer;
    font-family: inherit;
    box-shadow: var(--neu-flat);
    transition: all 0.18s ease;
    letter-spacing: 0.2px;
  }
  .s3-chip:hover { box-shadow: var(--neu-raised); transform: translateY(-1px); border-color: rgba(255,255,255,0.15); }
  .s3-chip.sel {
    background: var(--lime);
    color: #060809;
    border-color: var(--lime);
    box-shadow: 0 4px 16px rgba(215,255,62,0.4), var(--neu-flat);
  }
  .s3-chip:active { box-shadow: var(--neu-inset); transform: translateY(0); }

  /* ── PILL TOGGLE: Soft UI ── */
  .s3-pill {
    flex: 1;
    background: #0D1018;
    border: 1.5px solid rgba(255,255,255,0.08);
    border-radius: 14px;
    padding: 16px 0;
    color: rgba(255,255,255,0.6);
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    font-family: inherit;
    box-shadow: var(--neu-raised);
    transition: all 0.2s ease;
    display: flex; align-items: center; justify-content: center; gap: 8px;
    letter-spacing: 0.3px;
  }
  .s3-pill:hover { box-shadow: var(--mat-elev2); color: rgba(255,255,255,0.85); transform: translateY(-1px); }
  .s3-pill.sel {
    background: rgba(215,255,62,0.1);
    border-color: var(--lime);
    color: var(--lime);
    box-shadow: 0 0 0 1px rgba(215,255,62,0.15), 0 0 20px rgba(215,255,62,0.12);
  }
  .s3-pill:active { box-shadow: var(--neu-inset); transform: translateY(0); }

  /* ── GLASS CARD: Soft UI + Material elevation ── */
  .s3-glass {
    background: rgba(255,255,255,0.03);
    backdrop-filter: blur(28px) saturate(160%);
    -webkit-backdrop-filter: blur(28px) saturate(160%);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 24px;
    box-shadow: var(--mat-elev3), inset 0 1px 0 rgba(255,255,255,0.07);
  }

  /* ── INTERMISSION CARD: Neumorphic deep container ── */
  .s3-intermission {
    border-radius: 28px;
    padding: 44px 28px;
    box-shadow: var(--mat-elev4);
    text-align: center;
    backdrop-filter: blur(20px);
  }

  /* ── SWISS: Progress bar ── */
  .s3-progress-bar {
    display: flex;
    gap: 4px;
    margin-bottom: 22px;
    padding: 0 2px;
  }
  .s3-progress-seg {
    flex: 1;
    height: 3.5px;
    border-radius: 2px;
    background: rgba(255,255,255,0.06);
    box-shadow: var(--neu-inset);
    overflow: hidden;
    position: relative;
    transition: background 0.4s ease;
  }
  .s3-progress-seg::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--lime) 0%, #a0e820 100%);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.5s cubic-bezier(0.34,1.56,0.64,1);
    box-shadow: 0 0 12px rgba(215,255,62,0.6);
  }
  .s3-progress-seg.done { background: transparent; }
  .s3-progress-seg.done::after {
    transform: scaleX(1);
  }

  /* ── MATERIAL: Checkbox ── */
  .s3-checkbox {
    width: 24px; height: 24px;
    border-radius: 7px;
    border: 2px solid rgba(255,255,255,0.2);
    background: #0D1018;
    box-shadow: var(--neu-inset);
    display: flex; align-items: center; justify-content: center;
    font-size: 13px; font-weight: 900;
    color: #060809;
    flex-shrink: 0;
    transition: all 0.22s ease;
    cursor: pointer;
  }
  .s3-checkbox.checked {
    background: var(--lime);
    border-color: var(--lime);
    box-shadow: 0 0 0 3px rgba(215,255,62,0.2), var(--mat-elev1);
    animation: checkBounce3 0.3s ease;
  }

  /* ── MATERIAL: Radio ── */
  .s3-radio {
    width: 22px; height: 22px;
    border-radius: 50%;
    border: 2px solid rgba(255,255,255,0.2);
    background: #0D1018;
    box-shadow: var(--neu-inset);
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
    transition: border-color 0.2s ease;
  }
  .s3-radio.checked { border-color: var(--lime); box-shadow: 0 0 0 3px rgba(215,255,62,0.15); }
  .s3-radio .dot { width: 11px; height: 11px; border-radius: 50%; background: var(--lime); animation: checkBounce3 0.25s ease; box-shadow: 0 0 8px rgba(215,255,62,0.6); }

  /* ── SWISS: Divider with label ── */
  .s3-divider {
    display: flex; align-items: center; gap: 12px; margin: 6px 0;
  }
  .s3-divider hr { flex:1; border:none; height:1px; background:rgba(255,255,255,0.08); box-shadow: 0 1px 0 rgba(255,255,255,0.03); }
  .s3-divider span { font-size: 11px; color: rgba(255,255,255,0.3); font-weight: 800; letter-spacing: 2px; text-transform: uppercase; }

  /* ── SOFT UI: Back button ── */
  .s3-back-btn {
    width: 38px; height: 38px;
    border-radius: 12px;
    background: #0D1018;
    border: none;
    color: rgba(255,255,255,0.7);
    font-size: 18px;
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    box-shadow: var(--neu-raised);
    transition: all 0.18s ease;
    font-family: inherit;
  }
  .s3-back-btn:hover { box-shadow: var(--mat-elev2); color: var(--lime); }
  .s3-back-btn:active { box-shadow: var(--neu-inset); }

  /* ── MATERIAL: Floating action card ── */
  .s3-calorie-card {
    border-radius: 24px;
    padding: 30px 24px;
    text-align: center;
    background: linear-gradient(145deg, rgba(215,255,62,0.07) 0%, rgba(11,14,20,0.95) 100%);
    border: 1.5px solid rgba(215,255,62,0.22);
    box-shadow: var(--mat-elev3), 0 0 40px rgba(215,255,62,0.06), inset 0 1px 0 rgba(215,255,62,0.1);
    backdrop-filter: blur(20px);
  }

  /* ── SOFT UI: Preference row ── */
  .s3-pref-row {
    display: flex;
    align-items: center;
    gap: 14px;
    cursor: pointer;
    padding: 14px 18px;
    background: #0D1018;
    border-radius: 14px;
    border: 1px solid rgba(255,255,255,0.06);
    box-shadow: var(--neu-raised);
    transition: all 0.18s ease;
  }
  .s3-pref-row:hover { box-shadow: var(--mat-elev2); border-color: rgba(255,255,255,0.11); }
  .s3-pref-row:active { box-shadow: var(--neu-inset); }

  /* ── SWISS: Feature chip card ── */
  .s3-feature-card {
    background: #0D1018;
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 16px;
    padding: 18px 20px;
    display: flex;
    align-items: center;
    gap: 16px;
    box-shadow: var(--neu-raised);
    transition: all 0.2s ease;
  }
  .s3-feature-card:hover { box-shadow: var(--mat-elev2); border-color: rgba(215,255,62,0.15); transform: translateY(-1px); }

  /* Spinner */
  .s3-spinner {
    width: 18px; height: 18px;
    border-radius: 50%;
    border: 2.5px solid transparent;
    border-top-color: #060809;
    display: inline-block;
    animation: spin3 0.7s linear infinite;
  }

  /* ── SOFT UI + NEUMORPHIC PROFILE TOKENS ── */
  .prof-hero-card {
    background: #0E121A;
    border: 1px solid rgba(255,255,255,0.065);
    border-radius: 24px;
    padding: 24px 20px;
    box-shadow: 8px 8px 24px rgba(0,0,0,0.65), -5px -5px 16px rgba(255,255,255,0.03);
    position: relative;
    overflow: hidden;
  }
  .prof-avatar-ring {
    width: 68px; height: 68px;
    border-radius: 50%;
    background: linear-gradient(135deg, #1C2433 0%, #0B0E14 100%);
    padding: 3px;
    box-shadow: 6px 6px 16px rgba(0,0,0,0.7), -4px -4px 12px rgba(255,255,255,0.05), 0 0 20px rgba(215,255,62,0.2);
    display: flex; align-items: center; justify-content: center;
    position: relative;
    flex-shrink: 0;
  }
  .prof-avatar-inner {
    width: 100%; height: 100%;
    border-radius: 50%;
    background: linear-gradient(135deg, #D7FF3E 0%, #2ED4BF 100%);
    color: #060809;
    display: flex; align-items: center; justify-content: center;
    font-size: 26px; font-weight: 900;
    letter-spacing: -0.5px;
  }
  .prof-badge-pro {
    position: absolute;
    bottom: -4px; right: -4px;
    background: #060809;
    border: 1.5px solid #D7FF3E;
    color: #D7FF3E;
    font-size: 9px; font-weight: 900;
    padding: 2px 6px;
    border-radius: 999px;
    letter-spacing: 1px;
    text-transform: uppercase;
    box-shadow: 0 2px 8px rgba(0,0,0,0.8);
  }

  /* â”€â”€ SWISS TELEMETRY 4-CELL GRID â”€â”€ */
  .prof-telemetry-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
    margin: 16px 0;
  }
  .prof-telemetry-cell {
    background: #0B0E14;
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 14px;
    padding: 12px 6px;
    text-align: center;
    box-shadow: inset 2px 2px 6px rgba(0,0,0,0.6), inset -1px -1px 4px rgba(255,255,255,0.025);
  }
  .prof-telemetry-val {
    font-size: 16px;
    font-weight: 900;
    color: #FFFFFF;
    letter-spacing: -0.4px;
    line-height: 1.1;
  }
  .prof-telemetry-lbl {
    font-size: 9px;
    font-weight: 800;
    color: rgba(255,255,255,0.38);
    letter-spacing: 1.2px;
    text-transform: uppercase;
    margin-top: 4px;
  }

  /* â”€â”€ SWISS MACRO RATIO BAR â”€â”€ */
  .prof-ratio-bar {
    display: flex;
    height: 6px;
    border-radius: 3px;
    overflow: hidden;
    background: rgba(255,255,255,0.08);
    box-shadow: inset 1px 1px 3px rgba(0,0,0,0.6);
    margin: 10px 0 8px;
  }

  /* â”€â”€ NEUMORPHIC STRATEGY CONTROL â”€â”€ */
  .prof-strategy-track {
    background: #0B0E14;
    border-radius: 16px;
    padding: 4px;
    display: flex;
    box-shadow: inset 3px 3px 8px rgba(0,0,0,0.7), inset -2px -2px 6px rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.05);
    gap: 4px;
    margin: 14px 0;
  }
  .prof-strategy-btn {
    flex: 1;
    border: none;
    background: transparent;
    color: rgba(255,255,255,0.5);
    font-size: 11px;
    font-weight: 800;
    padding: 10px 0;
    border-radius: 12px;
    cursor: pointer;
    letter-spacing: 0.3px;
    text-transform: uppercase;
    transition: all 0.22s ease;
    font-family: inherit;
  }
  .prof-strategy-btn.active {
    background: #141A24;
    color: #D7FF3E;
    box-shadow: 4px 4px 12px rgba(0,0,0,0.5), -2px -2px 8px rgba(255,255,255,0.05), 0 0 16px rgba(215,255,62,0.15);
    font-weight: 900;
  }

  /* â”€â”€ MATERIAL ELEVATED SECTION CARD â”€â”€ */
  .prof-section-card {
    background: #0E121A;
    border: 1px solid rgba(255,255,255,0.065);
    border-radius: 20px;
    overflow: hidden;
    margin-bottom: 14px;
    box-shadow: 6px 6px 18px rgba(0,0,0,0.55), -3px -3px 10px rgba(255,255,255,0.03);
  }
  .prof-row-item {
    padding: 15px 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    border-bottom: 1px solid rgba(255,255,255,0.05);
    transition: background 0.16s ease;
    position: relative;
  }
  .prof-row-item:last-child { border-bottom: none; }
  .prof-row-item:hover { background: rgba(255,255,255,0.035); }
  .prof-row-item:active { background: rgba(255,255,255,0.06); }
  .prof-icon-well {
    width: 38px; height: 38px;
    border-radius: 11px;
    background: #0B0E14;
    display: flex; align-items: center; justify-content: center;
    font-size: 17px;
    box-shadow: inset 2px 2px 5px rgba(0,0,0,0.6), inset -1px -1px 3px rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.04);
    flex-shrink: 0;
  }

  /* â”€â”€ MATERIAL BOTTOM SHEET MODAL â”€â”€ */
  .prof-modal-sheet {
    background: #0E131C;
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 28px 28px 0 0;
    width: 100%;
    max-width: 480px;
    max-height: 90vh;
    overflow-y: auto;
    padding: 24px 22px 34px;
    box-shadow: 0 -12px 48px rgba(0,0,0,0.85);
    animation: fadeUp3 0.3s cubic-bezier(0.2,0.8,0.2,1) both;
  }
  .prof-drag-handle {
    width: 42px; height: 4px;
    border-radius: 2px;
    background: rgba(255,255,255,0.22);
    margin: 0 auto 18px;
  }
`;

function injectAuthStylesV3() {
  if (document.getElementById("stoke-auth-v3")) return;
  const s = document.createElement("style");
  s.id = "stoke-auth-v3";
  s.textContent = AUTH_STYLES_V3;
  document.head.appendChild(s);
}

// ─── Animated background ────────────────────────────────────────
function NeuBackground({ accent = "#256BFD" }) {
  const rgb = "37,107,253";
  return (
    <div style={{ position:"fixed", inset:0, pointerEvents:"none", zIndex:0, overflow:"hidden", background:"#090D16" }}>
      {/* Deep gradient base */}
      <div style={{ position:"absolute", inset:0, background:`radial-gradient(ellipse at 25% 5%, rgba(${rgb},0.15) 0%, transparent 60%), radial-gradient(ellipse at 80% 95%, rgba(20,50,140,0.2) 0%, transparent 55%), linear-gradient(180deg, #0C101B 0%, #070A12 100%)` }} />
      {/* Soft orbs — Soft UI */}
      <div style={{ position:"absolute", top:"-80px", left:"50%", transform:"translateX(-50%)", width:340, height:340, borderRadius:"50%", background:`radial-gradient(circle, rgba(${rgb},0.18) 0%, transparent 72%)`, animation:"orb3 8s ease-in-out infinite" }} />
      <div style={{ position:"absolute", bottom:"-60px", right:"-40px", width:260, height:260, borderRadius:"50%", background:"radial-gradient(circle, rgba(30,80,220,0.18) 0%, transparent 70%)", animation:"orb3 12s ease-in-out infinite reverse" }} />
      {/* Floating particles */}
      {[
        {x:"7%",  sz:3, dur:18, del:0},
        {x:"22%", sz:2, dur:23, del:3},
        {x:"38%", sz:4, dur:16, del:7},
        {x:"55%", sz:2, dur:25, del:1},
        {x:"70%", sz:3, dur:19, del:5},
        {x:"84%", sz:2, dur:21, del:9},
        {x:"93%", sz:3, dur:22, del:2},
      ].map((p, i) => (
        <div key={i} style={{
          position:"absolute", bottom:-10, left:p.x,
          width:p.sz, height:p.sz, borderRadius:"50%",
          background: "#3B82F6", opacity:0,
          animation:`particle3 ${p.dur}s ${p.del}s ease-in infinite`,
          filter:`blur(${p.sz>2?1:0}px)`
        }} />
      ))}
      {/* Swiss grid lines (very subtle) */}
      <div style={{ position:"absolute", inset:0, backgroundImage:"linear-gradient(rgba(255,255,255,0.015) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.015) 1px, transparent 1px)", backgroundSize:"40px 40px", pointerEvents:"none" }} />
    </div>
  );
}

// ─── Ripple handler ────────────────────────────────────────────
function addRipple(e) {
  const el = e.currentTarget;
  el.classList.remove("rippling");
  void el.offsetWidth;
  const r = el.getBoundingClientRect();
  el.style.setProperty("--rx", (e.clientX - r.left) + "px");
  el.style.setProperty("--ry", (e.clientY - r.top) + "px");
  el.classList.add("rippling");
}

// ─── Google SVG ────────────────────────────────────────────────
function GIcon({sz=20}) {
  return (
    <svg width={sz} height={sz} viewBox="0 0 48 48">
      <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
      <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
      <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
      <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
    </svg>
  );
}

// ─── Logo Mark: Soft UI embossed ──────────────────────────────
function NeuLogo({ size = 52, variant = "blue" }) {
  const isBlue = variant !== "lime";
  return (
    <div style={{
      width:size, height:size,
      borderRadius: size * 0.28,
      background: isBlue ? "linear-gradient(145deg, #2A72FD 0%, #1557E0 100%)" : "linear-gradient(145deg, #D7FF3E 0%, #C0EC00 100%)",
      boxShadow: isBlue ? "5px 5px 14px rgba(0,0,0,0.6), -3px -3px 10px rgba(255,255,255,0.04), 0 0 32px rgba(37,107,253,0.55)" : "5px 5px 14px rgba(0,0,0,0.6), -3px -3px 10px rgba(255,255,255,0.04), 0 0 32px rgba(215,255,62,0.5)",
      display:"flex", alignItems:"center", justifyContent:"center",
      fontSize: size*0.5, fontWeight:900, color: isBlue ? "#FFFFFF" : "#060809",
      animation:"pulseGlow3 3s ease-in-out infinite, gentleBounce 4s ease-in-out infinite",
      flexShrink:0,
      transition:"transform 0.3s ease",
    }}>⚡</div>
  );
}

// ─── Floating label field ──────────────────────────────────────
function NeuInput({ label, type="text", value, onChange, onKeyDown, extraRight }) {
  return (
    <div className={`s3-field${value ? " filled" : ""}`} style={{ position:"relative" }}>
      <input type={type} value={value} onChange={onChange} onKeyDown={onKeyDown} placeholder=" " autoComplete="off" />
      <label>{label}</label>
      {extraRight}
    </div>
  );
}

// ─── Subcomponents ─────────────────────────────────────────────
function NeuCheckbox({ checked }) {
  return <div className={`s3-checkbox${checked?" checked":""}`}>{checked && "✓"}</div>;
}
function NeuRadio({ checked }) {
  return <div className={`s3-radio${checked?" checked":""}`}>{checked && <div className="dot" />}</div>;
}
function NeuSpinner() { return <span className="s3-spinner" />; }
function OrDivider3() {
  return (
    <div className="s3-divider">
      <hr/><span>or</span><hr/>
    </div>
  );
}

// ══════════════════════════════════════════════════════════════════════
//  REUSABLE PREMIUM ONBOARDING COMPONENTS (Clean Architecture)
// ══════════════════════════════════════════════════════════════════════

function AnimatedScreen({ children, keyId, direction = "forward", className = "", style = {} }) {
  return (
    <div
      key={keyId}
      className={`s3-animated-screen ${className}`}
      style={{
        display: "flex",
        flexDirection: "column",
        flex: 1,
        width: "100%",
        animation: direction === "backward"
          ? "slideLeft3 0.36s cubic-bezier(0.16, 1, 0.3, 1) both"
          : "slideRight3 0.36s cubic-bezier(0.16, 1, 0.3, 1) both",
        ...style
      }}
    >
      {children}
    </div>
  );
}

function ProgressIndicator({ step, total = 14, category, onBack, showBack = true }) {
  const percent = Math.min(100, Math.max(0, (step / total) * 100));
  return (
    <div style={{ marginBottom: 20, width: "100%" }}>
      {/* Top smooth animated progress bar */}
      <div style={{ height: 4, background: "rgba(255,255,255,0.08)", borderRadius: 999, overflow: "hidden", position: "relative", marginBottom: 14 }}>
        <div
          style={{
            height: "100%",
            width: `${percent}%`,
            background: "linear-gradient(90deg, #1A5EE5 0%, #256BFD 100%)",
            boxShadow: "0 0 12px rgba(37,107,253,0.8)",
            borderRadius: 999,
            transition: "width 0.4s cubic-bezier(0.25, 1, 0.5, 1)"
          }}
        />
      </div>

      {/* Navigation and Category Header */}
      <div style={{ display: "flex", alignItems: "center", justifyContent: "space-between", height: 38 }}>
        {showBack ? (
          <button
            type="button"
            className="s3-back-btn"
            onClick={onBack}
            aria-label="Go back"
            style={{
              width: 36,
              height: 36,
              borderRadius: 12,
              background: "rgba(255,255,255,0.05)",
              border: "1px solid rgba(255,255,255,0.08)",
              color: "#fff",
              fontSize: 16,
              cursor: "pointer",
              display: "flex",
              alignItems: "center",
              justifyContent: "center",
              transition: "all 0.2s ease"
            }}
          >
            ←
          </button>
        ) : (
          <div style={{ width: 36 }} />
        )}

        {category ? (
          <span style={{
            fontSize: 10,
            fontWeight: 800,
            color: "#3B82F6",
            letterSpacing: 1.5,
            textTransform: "uppercase",
            background: "rgba(37,107,253,0.12)",
            border: "1px solid rgba(37,107,253,0.3)",
            padding: "3px 10px",
            borderRadius: 999
          }}>
            {category}
          </span>
        ) : null}

        <div style={{
          fontSize: 12,
          fontWeight: 800,
          color: "rgba(255,255,255,0.35)",
          letterSpacing: 1,
          fontVariantNumeric: "tabular-nums"
        }}>
          {step} / {total}
        </div>
      </div>
    </div>
  );
}

function QuestionHeader({ title, subtitle, icon, badge }) {
  return (
    <div style={{ marginBottom: 24 }}>
      {badge && (
        <div style={{ display: "inline-flex", alignItems: "center", gap: 6, marginBottom: 10, background: "rgba(37,107,253,0.1)", padding: "3px 10px", borderRadius: 999, border: "1px solid rgba(37,107,253,0.25)" }}>
          <span style={{ width: 6, height: 6, borderRadius: "50%", background: "#256BFD", boxShadow: "0 0 8px #256BFD" }} />
          <span style={{ fontSize: 10, fontWeight: 800, color: "#3B82F6", letterSpacing: 1.5, textTransform: "uppercase" }}>{badge}</span>
        </div>
      )}
      {icon && <div style={{ fontSize: 44, marginBottom: 12 }}>{icon}</div>}
      <h1 style={{
        fontSize: 25,
        fontWeight: 900,
        color: "#FFFFFF",
        lineHeight: 1.25,
        margin: "0 0 6px",
        letterSpacing: -0.5
      }}>
        {title}
      </h1>
      {subtitle && (
        <p style={{
          fontSize: 13.5,
          color: "rgba(255,255,255,0.48)",
          lineHeight: 1.5,
          margin: 0,
          fontWeight: 400
        }}>
          {subtitle}
        </p>
      )}
    </div>
  );
}

function SelectionCard({
  selected,
  title,
  description,
  icon,
  badge,
  onClick,
  multi = false,
  disabled = false,
  style = {}
}) {
  return (
    <div
      onClick={!disabled ? onClick : undefined}
      className="s3-selection-card mat-ripple"
      style={{
        background: selected
          ? "linear-gradient(145deg, rgba(37,107,253,0.12) 0%, rgba(37,107,253,0.02) 100%)"
          : "rgba(13, 16, 24, 0.75)",
        border: selected ? "1.5px solid #256BFD" : "1.5px solid rgba(255, 255, 255, 0.08)",
        borderRadius: 16,
        padding: "15px 16px",
        cursor: disabled ? "not-allowed" : "pointer",
        transition: "all 0.22s cubic-bezier(0.16, 1, 0.3, 1)",
        display: "flex",
        alignItems: "center",
        justifyContent: "space-between",
        gap: 12,
        position: "relative",
        overflow: "hidden",
        boxShadow: selected
          ? "0 4px 20px rgba(37,107,253,0.25), inset 0 1px 0 rgba(37,107,253,0.3)"
          : "0 2px 6px rgba(0,0,0,0.25)",
        transform: selected ? "scale(1.008)" : "scale(1)",
        userSelect: "none",
        ...style
      }}
    >
      {selected && (
        <div style={{ position: "absolute", left: 0, top: 0, bottom: 0, width: 3.5, background: "#256BFD", boxShadow: "0 0 8px #256BFD" }} />
      )}

      <div style={{ display: "flex", alignItems: "center", gap: 12, minWidth: 0, flex: 1 }}>
        {icon && (
          <div style={{
            fontSize: 20,
            width: 38,
            height: 38,
            borderRadius: 12,
            background: selected ? "rgba(37,107,253,0.18)" : "rgba(255,255,255,0.05)",
            display: "flex",
            alignItems: "center",
            justifyContent: "center",
            flexShrink: 0
          }}>
            {icon}
          </div>
        )}
        <div style={{ minWidth: 0, flex: 1 }}>
          <div style={{ display: "flex", alignItems: "center", gap: 8 }}>
            <span style={{
              fontSize: 14.5,
              fontWeight: 700,
              color: selected ? "#FFFFFF" : "rgba(255,255,255,0.9)",
              letterSpacing: -0.2
            }}>
              {title}
            </span>
            {badge && (
              <span style={{ fontSize: 9, fontWeight: 800, color: "#3B82F6", background: "rgba(37,107,253,0.15)", padding: "2px 6px", borderRadius: 999 }}>
                {badge}
              </span>
            )}
          </div>
          {description && (
            <p style={{
              fontSize: 12,
              color: selected ? "rgba(255,255,255,0.65)" : "rgba(255,255,255,0.38)",
              margin: "3px 0 0",
              lineHeight: 1.4
            }}>
              {description}
            </p>
          )}
        </div>
      </div>

      <div
        style={{
          width: 24,
          height: 24,
          borderRadius: multi ? 7 : "50%",
          border: selected ? "none" : "1.5px solid rgba(255,255,255,0.22)",
          background: selected ? "#256BFD" : "rgba(255,255,255,0.03)",
          color: "#FFFFFF",
          display: "flex",
          alignItems: "center",
          justifyContent: "center",
          fontSize: 13,
          fontWeight: 900,
          flexShrink: 0,
          boxShadow: selected ? "0 0 12px rgba(37,107,253,0.55)" : "none",
          transition: "all 0.2s cubic-bezier(0.34, 1.56, 0.64, 1)",
          transform: selected ? "scale(1.05)" : "scale(1)"
        }}
      >
        {selected ? "✓" : null}
      </div>
    </div>
  );
}

function PrimaryButton({
  children,
  onClick,
  disabled = false,
  loading = false,
  variant = "blue",
  icon,
  style = {}
}) {
  const isGlass = variant === "glass";
  return (
    <button
      type="button"
      onClick={!disabled && !loading ? (e) => { addRipple(e); onClick && onClick(e); } : undefined}
      disabled={disabled || loading}
      className="s3-primary-btn mat-ripple"
      style={{
        width: "100%",
        height: 52,
        borderRadius: 16,
        border: isGlass ? "1px solid rgba(255,255,255,0.15)" : "none",
        background: disabled
          ? "rgba(255,255,255,0.08)"
          : isGlass
          ? "rgba(255,255,255,0.08)"
          : "linear-gradient(135deg, #2A72FD 0%, #1754DC 100%)",
        color: disabled ? "rgba(255,255,255,0.3)" : "#FFFFFF",
        fontWeight: 900,
        fontSize: 15,
        letterSpacing: 0.3,
        cursor: disabled || loading ? "not-allowed" : "pointer",
        display: "flex",
        alignItems: "center",
        justifyContent: "center",
        gap: 8,
        boxShadow: disabled || isGlass
          ? "none"
          : "0 4px 20px rgba(37,107,253,0.4)",
        fontFamily: "inherit",
        userSelect: "none",
        ...style
      }}
    >
      {loading ? (
        <span style={{ display: "flex", alignItems: "center", gap: 8 }}>
          <NeuSpinner /> Loading…
        </span>
      ) : (
        <>
          {children}
          {icon}
        </>
      )}
    </button>
  );
}

function LoadingState({ message = "Processing…" }) {
  return (
    <div style={{
      display: "flex",
      flexDirection: "column",
      alignItems: "center",
      justifyContent: "center",
      padding: "36px 20px",
      gap: 16
    }}>
      <div style={{
        width: 44,
        height: 44,
        borderRadius: "50%",
        border: "3px solid rgba(215,255,62,0.2)",
        borderTopColor: "#D7FF3E",
        animation: "spin3 0.8s linear infinite",
        boxShadow: "0 0 16px rgba(215,255,62,0.35)"
      }} />
      <div style={{ fontSize: 13, color: "rgba(255,255,255,0.6)", fontWeight: 600, letterSpacing: 0.5 }}>
        {message}
      </div>
    </div>
  );
}

function ErrorMessage({ message }) {
  if (!message) return null;
  return (
    <div
      className="s3-error-msg"
      style={{
        background: "rgba(239, 68, 68, 0.12)",
        border: "1px solid rgba(239, 68, 68, 0.32)",
        borderRadius: 14,
        padding: "10px 14px",
        color: "#FCA5A5",
        fontSize: 12.5,
        fontWeight: 600,
        display: "flex",
        alignItems: "center",
        gap: 10,
        marginBottom: 14,
        animation: "errorSlideIn 0.3s cubic-bezier(0.16, 1, 0.3, 1) both"
      }}
    >
      <span style={{ fontSize: 16 }}>⚠️</span>
      <span>{message}</span>
    </div>
  );
}

function OnboardingLayout({
  step,
  total = 14,
  category,
  onBack,
  showBack = true,
  children,
  footer,
  style = {}
}) {
  return (
    <div style={{
      position: "relative",
      minHeight: "100vh",
      fontFamily: "'Space Grotesk', -apple-system, BlinkMacSystemFont, ui-sans-serif, sans-serif",
      display: "flex",
      flexDirection: "column",
      overflow: "hidden",
      background: "#080A0E",
      color: "#FFFFFF",
      ...style
    }}>
      <NeuBackground accent="#D7FF3E" />
      <div style={{
        position: "relative",
        zIndex: 1,
        flex: 1,
        display: "flex",
        flexDirection: "column",
        maxWidth: 420,
        width: "100%",
        margin: "0 auto",
        padding: "20px 20px 30px",
        boxSizing: "border-box"
      }}>
        {step ? (
          <ProgressIndicator
            step={step}
            total={total}
            category={category}
            onBack={onBack}
            showBack={showBack}
          />
        ) : null}
        <div style={{ flex: 1, display: "flex", flexDirection: "column" }}>
          {children}
        </div>
        {footer ? (
          <div style={{ marginTop: "auto", paddingTop: 20 }}>
            {footer}
          </div>
        ) : null}
      </div>
    </div>
  );
}

// ══════════════════════════════════════════════════════════════════════
//  WELCOME CAROUSEL  ─ Swiss typography + Soft UI cards
// ══════════════════════════════════════════════════════════════════════
const WELCOME_SLIDES = [
  { id:0, quote:"Discover the impact of your food & fitness", sub:"Track every calorie, run, and workout in one place.", accent:"#D7FF3E", type:"dashboard" },
  { id:1, quote:"Ready for wins? Start tracking today!", sub:"Log workouts and crush personal records effortlessly.", accent:"#2ED4BF", type:"workout" },
  { id:2, quote:"Make mindful eating a habit for life", sub:"Balance your macros and fuel peak performance.", accent:"#FF8A3D", type:"nutrition" }
];

function WelcomeSlideVisual({ slide }) {
  const LIME = "#D7FF3E";
  if (slide.type === "dashboard") {
    return (
      <div className="s3-glass" style={{ height:268, padding:"18px", display:"flex", flexDirection:"column", justifyContent:"space-between", position:"relative", overflow:"hidden", borderColor:"rgba(215,255,62,0.18)" }}>
        <div style={{ position:"absolute", top:-30, right:-30, width:160, height:160, borderRadius:"50%", background:"radial-gradient(circle, rgba(215,255,62,0.16) 0%, transparent 70%)", pointerEvents:"none" }} />
        {/* Top */}
        <div style={{ display:"flex", justifyContent:"space-between", alignItems:"center" }}>
          <div style={{ display:"flex", alignItems:"center", gap:9 }}>
            <div style={{ width:32, height:32, borderRadius:"50%", background:"linear-gradient(135deg,#D7FF3E,#C0EC00)", boxShadow:"0 0 12px rgba(215,255,62,0.5)", display:"flex", alignItems:"center", justifyContent:"center", fontWeight:900, fontSize:13, color:"#000" }}>M</div>
            <div>
              <div style={{ fontSize:13, fontWeight:800, color:"#fff", letterSpacing:-0.3, display:"flex", alignItems:"center", gap:5 }}>Today <span style={{ fontSize:9, background:"rgba(215,255,62,0.15)", color:LIME, padding:"2px 6px", borderRadius:4, fontWeight:900, letterSpacing:0.5 }}>PRO</span></div>
              <div style={{ fontSize:10, color:"rgba(255,255,255,0.38)", fontWeight:600 }}>Monday · Sep 29</div>
            </div>
          </div>
          <span style={{ fontSize:11, color:LIME, fontWeight:800, letterSpacing:0.5 }}>EDIT</span>
        </div>
        {/* Ring + stats */}
        <div style={{ display:"flex", alignItems:"center", gap:16 }}>
          <div style={{ position:"relative", width:100, height:100, flexShrink:0 }}>
            <svg width="100" height="100" viewBox="0 0 100 100">
              <circle cx="50" cy="50" r="42" fill="none" stroke="rgba(255,255,255,0.05)" strokeWidth="10"/>
              <circle cx="50" cy="50" r="42" fill="none" stroke="url(#dg)" strokeWidth="10" strokeDasharray="264" strokeDashoffset="78" strokeLinecap="round" transform="rotate(-90 50 50)" style={{filter:"drop-shadow(0 0 10px rgba(215,255,62,0.7))"}}/>
              <defs><linearGradient id="dg" x1="0%" y1="0%" x2="100%"><stop offset="0%" stopColor="#D7FF3E"/><stop offset="100%" stopColor="#2ED4BF"/></linearGradient></defs>
            </svg>
            <div style={{ position:"absolute", inset:0, display:"flex", flexDirection:"column", alignItems:"center", justifyContent:"center" }}>
              <div style={{ fontSize:19, fontWeight:900, color:"#fff", lineHeight:1, letterSpacing:-0.5 }}>1,850</div>
              <div style={{ fontSize:9, color:"rgba(255,255,255,0.4)", fontWeight:700, marginTop:2, letterSpacing:0.5 }}>KCAL LEFT</div>
            </div>
          </div>
          <div style={{ flex:1, display:"flex", flexDirection:"column", gap:6 }}>
            {[["🎯 Goal","2,400","#fff"],["🥗 Food","550","#2ED4BF"],["⚡ Exercise","400",LIME]].map(([l,v,c],i)=>(
              <div key={i} style={{ display:"flex", justifyContent:"space-between", alignItems:"center", background:"rgba(255,255,255,0.03)", borderRadius:9, padding:"5px 10px", boxShadow:"inset 1px 1px 3px rgba(0,0,0,0.4)" }}>
                <span style={{ fontSize:11, color:"rgba(255,255,255,0.48)" }}>{l}</span>
                <span style={{ fontSize:12, fontWeight:800, color:c }}>{v}</span>
              </div>
            ))}
          </div>
        </div>
        {/* Bottom stat bars */}
        <div style={{ display:"flex", gap:8 }}>
          {[["👟","Steps","6,342","63%",LIME],["🔥","Workout","400 cal","42m","rgba(255,255,255,0.35)"]].map(([ic,l,v,s,sc],i)=>(
            <div key={i} style={{ flex:1, background:"rgba(255,255,255,0.03)", border:"1px solid rgba(255,255,255,0.06)", borderRadius:12, padding:"8px 10px", display:"flex", alignItems:"center", gap:8, boxShadow:"inset 1px 1px 3px rgba(0,0,0,0.35)" }}>
              <span style={{ fontSize:17 }}>{ic}</span>
              <div>
                <div style={{ fontSize:10, color:"rgba(255,255,255,0.35)", fontWeight:700, letterSpacing:0.5 }}>{l}</div>
                <div style={{ fontSize:12, fontWeight:800, color:"#fff" }}>{v} <span style={{ fontSize:9, color:sc }}>{s}</span></div>
              </div>
            </div>
          ))}
        </div>
      </div>
    );
  }
  if (slide.type === "workout") {
    return (
      <div className="s3-glass" style={{ height:268, padding:"20px 18px", display:"flex", flexDirection:"column", justifyContent:"space-between", position:"relative", overflow:"hidden", borderColor:"rgba(46,212,191,0.2)", background:"rgba(46,212,191,0.04)" }}>
        <div style={{ position:"absolute", top:8, right:10, opacity:0.75 }}>
          <svg width="130" height="130" viewBox="0 0 100 100">
            <circle cx="68" cy="20" r="8" fill="#2ED4BF" style={{filter:"drop-shadow(0 0 12px #2ED4BF)"}}/>
            <path d="M50 35 L66 32 L78 48 L90 42" stroke="#2ED4BF" strokeWidth="4" strokeLinecap="round" strokeLinejoin="round" fill="none"/>
            <path d="M50 35 L42 54 L25 60 L14 55" stroke="#2ED4BF" strokeWidth="4" strokeLinecap="round" strokeLinejoin="round" fill="none"/>
            <path d="M42 54 L52 70 L58 92" stroke="#D7FF3E" strokeWidth="4" strokeLinecap="round" strokeLinejoin="round" fill="none"/>
            <path d="M52 70 L35 78 L22 88" stroke="#D7FF3E" strokeWidth="4" strokeLinecap="round" strokeLinejoin="round" fill="none"/>
          </svg>
        </div>
        <span style={{ background:"rgba(46,212,191,0.12)", color:"#2ED4BF", border:"1px solid rgba(46,212,191,0.25)", borderRadius:999, padding:"4px 12px", fontSize:11, fontWeight:800, letterSpacing:0.8, display:"inline-flex", alignItems:"center", gap:6, alignSelf:"flex-start", boxShadow:"0 0 14px rgba(46,212,191,0.15)" }}>⚡ STOKE PERFORMANCE</span>
        <div style={{ background:"rgba(10,13,20,0.85)", backdropFilter:"blur(20px)", border:"1px solid rgba(255,255,255,0.09)", borderRadius:18, padding:"14px 16px", boxShadow:"0 12px 40px rgba(0,0,0,0.6), inset 0 1px 0 rgba(255,255,255,0.05)" }}>
          <div style={{ display:"flex", justifyContent:"space-between", alignItems:"center", marginBottom:10 }}>
            <div>
              <div style={{ fontSize:13, fontWeight:800, color:"#fff", letterSpacing:-0.2 }}>Protein <span style={{ fontSize:11, color:"rgba(255,255,255,0.38)", fontWeight:500 }}>· 7 days</span></div>
              <div style={{ fontSize:11, color:"#2ED4BF", fontWeight:700, marginTop:2 }}>Avg 162g · Target Met</div>
            </div>
            <div style={{ background:"rgba(215,255,62,0.12)", color:"#D7FF3E", fontSize:10, fontWeight:900, padding:"3px 8px", borderRadius:6, letterSpacing:0.5 }}>🔥 7-DAY</div>
          </div>
          <div style={{ display:"flex", alignItems:"flex-end", justifyContent:"space-between", height:50, gap:6, padding:"0 2px" }}>
            {[{h:42},{h:48},{h:36},{h:54},{h:46},{h:58},{h:52}].map((col,idx)=>(
              <div key={idx} style={{ flex:1, display:"flex", flexDirection:"column", alignItems:"center", gap:4 }}>
                <div style={{ width:"100%", height:col.h*0.86, background:col.h>=45?"linear-gradient(180deg,#D7FF3E,#2ED4BF)":"rgba(255,255,255,0.12)", borderRadius:4, boxShadow:col.h>=45?"0 0 10px rgba(215,255,62,0.35)":"none" }} />
                <span style={{ fontSize:9, color:"rgba(255,255,255,0.35)", fontWeight:700 }}>{["M","T","W","T","F","S","S"][idx]}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    );
  }
  return (
    <div className="s3-glass" style={{ height:268, padding:"20px 18px", display:"flex", flexDirection:"column", justifyContent:"space-between", position:"relative", overflow:"hidden", borderColor:"rgba(255,138,61,0.2)", background:"rgba(255,138,61,0.03)" }}>
      <div style={{ position:"absolute", top:8, right:12, opacity:0.85 }}>
        <svg width="120" height="120" viewBox="0 0 100 100">
          <circle cx="50" cy="50" r="42" fill="#131720" stroke="rgba(255,138,61,0.25)" strokeWidth="3"/>
          <path d="M20 50 Q50 88 80 50 Z" fill="rgba(255,138,61,0.2)" stroke="#FF8A3D" strokeWidth="2.5"/>
          <path d="M30 38 C30 30 44 26 44 38 C44 48 30 48 30 38 Z" fill="#2ED4BF" opacity="0.85"/>
          <circle cx="37" cy="40" r="4.5" fill="#D7FF3E"/>
          <ellipse cx="62" cy="35" rx="8" ry="4.5" fill="#FF8A3D" transform="rotate(-25 62 35)"/>
          <ellipse cx="68" cy="43" rx="7" ry="4" fill="#FF8A3D" transform="rotate(-15 68 43)"/>
          <circle cx="50" cy="48" r="2.5" fill="#D7FF3E"/>
          <circle cx="56" cy="52" r="2" fill="#D7FF3E"/>
          <circle cx="44" cy="53" r="2" fill="#2ED4BF"/>
        </svg>
      </div>
      <span style={{ background:"rgba(255,138,61,0.12)", color:"#FF8A3D", border:"1px solid rgba(255,138,61,0.25)", borderRadius:999, padding:"4px 12px", fontSize:11, fontWeight:800, letterSpacing:0.8, display:"inline-flex", alignItems:"center", gap:6, alignSelf:"flex-start" }}>🥗 MINDFUL FUEL</span>
      <div style={{ background:"rgba(10,13,20,0.85)", backdropFilter:"blur(20px)", border:"1px solid rgba(255,255,255,0.09)", borderRadius:18, padding:"14px 16px", boxShadow:"0 12px 40px rgba(0,0,0,0.6), inset 0 1px 0 rgba(255,255,255,0.05)" }}>
        <div style={{ fontSize:12, fontWeight:700, color:"rgba(255,255,255,0.5)", marginBottom:10, letterSpacing:0.5, textTransform:"uppercase", fontSize:11 }}>Target Macros</div>
        <div style={{ display:"flex", gap:8 }}>
          {[["Protein","32%","145g","#D7FF3E","rgba(215,255,62,0.1)"],["Fat","20%","52g","#2ED4BF","rgba(46,212,191,0.1)"],["Carbs","48%","220g","#FF8A3D","rgba(255,138,61,0.1)"]].map(([l,p,g,c,bg],i)=>(
            <div key={i} style={{ flex:1, background:bg, border:`1.5px solid ${c}`, borderRadius:12, padding:"10px 8px", textAlign:"center", boxShadow:`0 0 14px ${c}20` }}>
              <div style={{ fontSize:10, color:"rgba(255,255,255,0.5)", fontWeight:700, letterSpacing:0.5 }}>{l}</div>
              <div style={{ fontSize:17, fontWeight:900, color:c, marginTop:2 }}>{p}</div>
              <div style={{ fontSize:10, color:"#fff", fontWeight:700 }}>{g}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  );
}

function WelcomeCarousel({ onSignUp, onLogIn }) {
  useEffect(() => { injectAuthStylesV3(); }, []);
  const [idx, setIdx] = useState(0);
  useEffect(() => {
    const t = setInterval(() => setIdx(i => (i + 1) % WELCOME_SLIDES.length), 4000);
    return () => clearInterval(t);
  }, []);
  const slide = WELCOME_SLIDES[idx];

  return (
    <div style={{ position:"relative", minHeight:"100vh", fontFamily:"'Space Grotesk', ui-sans-serif, system-ui, sans-serif", display:"flex", flexDirection:"column", overflow:"hidden" }}>
      <NeuBackground accent={slide.accent} />
      <div style={{ position:"relative", zIndex:1, maxWidth:390, width:"100%", margin:"0 auto", display:"flex", flexDirection:"column", flex:1, justifyContent:"space-between", padding:"28px 22px 32px" }}>

        {/* Swiss brand header */}
        <div style={{ textAlign:"center", animation:"fadeUp3 0.5s ease-out both" }}>
          <div style={{ fontSize:10, color:"rgba(255,255,255,0.35)", fontWeight:800, letterSpacing:4, textTransform:"uppercase", marginBottom:8 }}>Welcome to</div>
          <div style={{ fontSize:42, fontWeight:900, letterSpacing:-2, background:"linear-gradient(90deg,#3B82F6 0%,#fff 65%)", WebkitBackgroundClip:"text", backgroundClip:"text", color:"transparent", display:"inline-block", lineHeight:1 }}>stoke⚡</div>
        </div>

        {/* Feature card — click to cycle */}
        <div onClick={() => setIdx(i => (i + 1) % WELCOME_SLIDES.length)} style={{ cursor:"pointer", animation:"fadeUp3 0.5s ease-out 0.08s both" }}>
          <WelcomeSlideVisual slide={slide} />
        </div>

        {/* Swiss copy */}
        <div style={{ textAlign:"center", padding:"14px 8px 8px", animation:"fadeUp3 0.5s ease-out 0.15s both" }}>
          <h2 style={{ fontSize:22, fontWeight:800, color:"#fff", margin:"0 0 8px", lineHeight:1.3, letterSpacing:-0.5 }}>{slide.quote}</h2>
          <p style={{ fontSize:13, color:"rgba(255,255,255,0.42)", margin:0, fontWeight:500, letterSpacing:0.1 }}>{slide.sub}</p>
        </div>

        {/* Pill dots */}
        <div style={{ display:"flex", justifyContent:"center", gap:8, margin:"6px 0 16px" }}>
          {WELCOME_SLIDES.map((_,i) => (
            <span key={i} onClick={() => setIdx(i)} style={{ width:i===idx?26:7, height:7, borderRadius:4, background:i===idx?"#256BFD":"rgba(255,255,255,0.18)", cursor:"pointer", transition:"all 0.35s ease", boxShadow:i===idx?`0 0 14px #256BFD`:"none", display:"inline-block" }} />
          ))}
        </div>

        {/* CTA buttons */}
        <div style={{ display:"flex", flexDirection:"column", gap:11, animation:"fadeUp3 0.5s ease-out 0.2s both" }}>
          <button className="s3-primary-btn mat-ripple" onClick={e => { addRipple(e); onSignUp(); }}>
            Get Started — It's Free
          </button>
          <button onClick={onLogIn} style={{ width:"100%", background:"transparent", border:"none", color:"rgba(255,255,255,0.55)", fontWeight:700, fontSize:14, padding:"10px 0 4px", cursor:"pointer", fontFamily:"inherit", letterSpacing:0.2, transition:"color 0.15s" }}
            onMouseEnter={e => e.currentTarget.style.color = "#3B82F6"}
            onMouseLeave={e => e.currentTarget.style.color = "rgba(255,255,255,0.55)"}>
            Already have an account? <span style={{ color:"#3B82F6", fontWeight:900 }}>Log In</span>
          </button>
          <div style={{ textAlign:"center", fontSize:10, color:"rgba(255,255,255,0.18)", letterSpacing:1, textTransform:"uppercase" }}>Version 26.37 · STOKE Inc.</div>
        </div>
      </div>
    </div>
  );
}

// ══════════════════════════════════════════════════════════════════════
//  AUTH SCREEN — all sub-views + 14-step questionnaire
// ══════════════════════════════════════════════════════════════════════
// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
//  STOKE AUTH & PROFILE FLOW (Modern Blue Edition)
// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•

const STEPS = [
  {
    key: "name",
    title: "What's your name?",
    subtitle: "Let's personalize your STOKE experience.",
    type: "input",
    placeholder: "Enter your name",
  },
  {
    key: "age",
    title: "How old are you?",
    subtitle: "This helps us personalize your training.",
    type: "input",
    placeholder: "Age",
  },
  {
    key: "goal",
    title: "What's your primary goal?",
    subtitle: "Choose what you want to achieve.",
    options: [
      "Build Muscle",
      "Lose Fat",
      "Get Stronger",
      "Improve Fitness",
    ],
  },
  {
    key: "level",
    title: "What's your fitness level?",
    subtitle: "Choose the option that best describes you.",
    options: ["Beginner", "Intermediate", "Advanced"],
  },
  {
    key: "height",
    title: "What's your height?",
    subtitle: "We'll use this to personalize your profile.",
    type: "input",
    placeholder: "Height in cm",
  },
  {
    key: "weight",
    title: "What's your weight?",
    subtitle: "Enter your current weight.",
    type: "input",
    placeholder: "Weight in kg",
  },
  {
    key: "frequency",
    title: "How often do you train?",
    subtitle: "Tell us about your weekly training.",
    options: [
      "1â€“2 days",
      "3â€“4 days",
      "5â€“6 days",
      "Every day",
    ],
  },
  {
    key: "activity",
    title: "What's your activity level?",
    subtitle: "Choose your usual daily activity.",
    options: ["Low", "Moderate", "High", "Very High"],
  },
];

function AuthScreen({ onSignIn, initialMode = "signin" }) {
  useEffect(() => {
    if (typeof injectAuthStylesV3 === "function") injectAuthStylesV3();
  }, []);

  const [screen, setScreen] = useState(initialMode === "signup" ? "signup" : "login");
  const [step, setStep] = useState(0);

  const [form, setForm] = useState({
    email: "",
    password: "",
    name: "",
    age: "",
    height: "",
    weight: "",
    goal: "",
    level: "",
    frequency: "",
    activity: "",
  });

  const [loading, setLoading] = useState(false);
  const [error, setError] = useState("");
  const [showPassword, setShowPassword] = useState(false);
  const [showGoogleModal, setShowGoogleModal] = useState(false);

  const GOOGLE_ACCOUNTS = [
    { name: "Mohd Numan", email: "mohdnuman701@gmail.com", avatar: "M", color: "#1A73E8", label: "Primary" },
    { name: "Mohd Numan", email: "mohdnuman925@gmail.com", avatar: "M", color: "#256BFD", label: "Personal" },
    { name: "KLH Edu", email: "mohdnuman@klh.edu.in", avatar: "N", color: "#E37400", label: "KLH Edu" },
    { name: "Mohammed numan .", email: "2210560148@klh.edu.in", avatar: "M", color: "#1E8E3E", label: "KLH Student" },
  ];

  const update = (key, value) => {
    setForm((prev) => ({
      ...prev,
      [key]: value,
    }));
    setError("");
  };

  /*
   * LOGIN
   */
  const handleLogin = async (customEmail) => {
    const emailToUse = customEmail || form.email;
    if (!emailToUse || (!customEmail && !form.password)) {
      setError("Please enter your email and password.");
      return;
    }

    setLoading(true);
    setError("");

    try {
      await new Promise((resolve) => setTimeout(resolve, 650));
      onSignIn(emailToUse);
    } catch (err) {
      setError("Unable to log in. Please try again.");
    } finally {
      setLoading(false);
    }
  };

  /*
   * CREATE ACCOUNT
   */
  const handleCreateAccount = async () => {
    if (!form.email || !form.password) {
      setError("Please enter your email and password.");
      return;
    }
    if (!form.email.includes("@")) {
      setError("Please enter a valid email address.");
      return;
    }
    if (form.password.length < 4) {
      setError("Password must be at least 4 characters.");
      return;
    }

    setError("");
    setStep(0);
    setScreen("profile");
  };

  /*
   * SELECT PROFILE OPTION
   */
  const selectOption = (value) => {
    const key = STEPS[step].key;
    update(key, value);
  };

  /*
   * NEXT PROFILE STEP
   */
  const nextStep = () => {
    const currentStep = STEPS[step];
    const value = form[currentStep.key];

    if (!value || String(value).trim() === "") {
      setError("Please complete this step before continuing.");
      return;
    }

    setError("");

    if (step < STEPS.length - 1) {
      setStep((prev) => prev + 1);
    } else {
      setScreen("summary");
    }
  };

  /*
   * BACK
   */
  const goBack = () => {
    setError("");

    if (step === 0) {
      if (screen === "profile") {
        setScreen("signup");
      }
      return;
    }

    setStep((prev) => prev - 1);
  };

  /*
   * FINISH PROFILE
   */
  const finishProfile = async () => {
    setLoading(true);
    setError("");

    try {
      await new Promise((resolve) => setTimeout(resolve, 700));

      const activityMap = {
        "Low": 1.2,
        "Moderate": 1.55,
        "High": 1.725,
        "Very High": 1.9,
      };
      const goalTypeMap = {
        "Build Muscle": "gain",
        "Lose Fat": "cut",
        "Get Stronger": "gain",
        "Improve Fitness": "maintain",
      };

      const userProfile = {
        ...DEFAULT_PROFILE,
        name: form.name || "Athlete",
        age: parseInt(form.age, 10) || 25,
        heightCm: parseFloat(form.height) || 175,
        weightKg: parseFloat(form.weight) || 70,
        goalType: goalTypeMap[form.goal] || "maintain",
        goal: form.goal || "Improve Fitness",
        level: form.level || "Intermediate",
        frequency: form.frequency || "3â€“4 days",
        activity: activityMap[form.activity] || 1.55,
        activityLevel: form.activity || "Moderate",
      };

      console.log("Profile completed:", userProfile);
      setLoading(false);
      onSignIn(form.email || "athlete@stoke.app", userProfile);
    } catch (err) {
      setError("Unable to save your profile. Please try again.");
      setLoading(false);
    }
  };

  /*
   * QUICK DEMO LOGIN (Mohd Numan)
   */
  const handleDemoLogin = () => {
    update("email", "mohdnuman701@gmail.com");
    update("password", "â€¢â€¢â€¢â€¢â€¢â€¢â€¢â€¢");
    handleLogin("mohdnuman701@gmail.com");
  };

  /*
   * LOGIN SCREEN
   */
  if (screen === "login") {
    return (
      <div style={{
        minHeight: "100vh",
        background: "radial-gradient(circle at 50% 0%, #10162A 0%, #08090E 70%)",
        color: "#FFFFFF",
        display: "flex",
        alignItems: "center",
        justifyContent: "center",
        padding: "32px 20px",
        fontFamily: "'Space Grotesk', ui-sans-serif, system-ui, sans-serif",
        position: "relative",
        overflowX: "hidden"
      }}>
        {/* Ambient lighting orb */}
        <div style={{
          position: "absolute",
          top: -100,
          left: "50%",
          transform: "translateX(-50%)",
          width: 320,
          height: 320,
          borderRadius: "50%",
          background: "radial-gradient(circle, rgba(37,107,253,0.18) 0%, transparent 70%)",
          pointerEvents: "none",
          filter: "blur(40px)"
        }} />

        <div style={{ width: "100%", maxWidth: 430, position: "relative", zIndex: 1 }}>

          {/* BRAND HEADER */}
          <div style={{ marginBottom: 36, animation: "loginLogoEntrance 0.5s ease-out both" }}>
            <div style={{
              display: "inline-flex",
              alignItems: "center",
              gap: 8,
              background: "rgba(37,107,253,0.12)",
              border: "1px solid rgba(37,107,253,0.3)",
              padding: "4px 12px",
              borderRadius: 999,
              marginBottom: 16
            }}>
              <span style={{ width: 6, height: 6, borderRadius: "50%", background: "#256BFD", boxShadow: "0 0 8px #256BFD" }} />
              <span style={{ color: "#3B82F6", fontSize: 11, fontWeight: 900, letterSpacing: "0.25em" }}>
                STOKE
              </span>
            </div>

            <h1 style={{ fontSize: 36, fontWeight: 900, letterSpacing: "-1px", lineHeight: 1.15, margin: "0 0 10px", color: "#FFFFFF" }}>
              Welcome back
            </h1>

            <p style={{ color: "rgba(255,255,255,0.48)", fontSize: 15, margin: 0, lineHeight: 1.5 }}>
              Sign in to continue your fitness journey.
            </p>
          </div>

          <div style={{ display: "flex", flexDirection: "column", gap: 14 }}>

            {/* CONTINUE WITH GOOGLE BUTTON */}
            <button
              type="button"
              onClick={() => setShowGoogleModal(true)}
              style={{
                width: "100%",
                height: 56,
                borderRadius: 18,
                background: "#FFFFFF",
                color: "#08090E",
                border: "none",
                fontWeight: 800,
                fontSize: 15,
                display: "flex",
                alignItems: "center",
                justifyContent: "center",
                gap: 12,
                cursor: "pointer",
                transition: "all 0.2s ease",
                boxShadow: "0 4px 18px rgba(0,0,0,0.3)"
              }}
              onMouseEnter={(e) => { e.currentTarget.style.transform = "translateY(-1px)"; }}
              onMouseLeave={(e) => { e.currentTarget.style.transform = "translateY(0)"; }}
            >
              <svg width="20" height="20" viewBox="0 0 24 24">
                <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.8-2.4 3.68v3.05h3.88c2.27-2.09 3.665-5.17 3.665-9.17z"/>
                <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.25v3.15C3.26 21.36 7.33 24 12 24z"/>
                <path fill="#FBBC05" d="M5.28 14.27c-.25-.72-.38-1.49-.38-2.27s.13-1.55.38-2.27V6.58H1.25C.45 8.18 0 9.99 0 12s.45 3.82 1.25 5.42l4.03-3.15z"/>
                <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.33 0 3.26 2.64 1.25 6.58l4.03 3.15c.95-2.83 3.6-4.98 6.72-4.98z"/>
              </svg>
              Continue with Google
            </button>

            {/* DIVIDER */}
            <div style={{ display: "flex", alignItems: "center", gap: 14, margin: "6px 0" }}>
              <div style={{ flex: 1, height: 1, background: "rgba(255,255,255,0.08)" }} />
              <span style={{ fontSize: 11, color: "rgba(255,255,255,0.35)", fontWeight: 800, letterSpacing: "1.5px" }}>
                OR
              </span>
              <div style={{ flex: 1, height: 1, background: "rgba(255,255,255,0.08)" }} />
            </div>

            {/* EMAIL INPUT */}
            <div style={{
              display: "flex",
              alignItems: "center",
              height: 56,
              padding: "0 18px",
              borderRadius: 18,
              background: "#101420",
              border: "1.5px solid rgba(255,255,255,0.08)",
              transition: "all 0.2s ease"
            }}>
              <input
                type="email"
                value={form.email}
                onChange={(e) => update("email", e.target.value)}
                placeholder="Email"
                style={{
                  width: "100%",
                  height: "100%",
                  background: "transparent",
                  border: "none",
                  outline: "none",
                  color: "#FFFFFF",
                  fontSize: 15,
                  fontWeight: 600,
                  fontFamily: "inherit"
                }}
                onFocus={(e) => {
                  e.currentTarget.parentElement.style.borderColor = "#256BFD";
                  e.currentTarget.parentElement.style.boxShadow = "0 0 0 3px rgba(37,107,253,0.2)";
                }}
                onBlur={(e) => {
                  e.currentTarget.parentElement.style.borderColor = "rgba(255,255,255,0.08)";
                  e.currentTarget.parentElement.style.boxShadow = "none";
                }}
              />
            </div>

            {/* PASSWORD INPUT */}
            <div style={{
              display: "flex",
              alignItems: "center",
              height: 56,
              padding: "0 18px",
              borderRadius: 18,
              background: "#101420",
              border: "1.5px solid rgba(255,255,255,0.08)",
              transition: "all 0.2s ease"
            }}>
              <input
                type={showPassword ? "text" : "password"}
                value={form.password}
                onChange={(e) => update("password", e.target.value)}
                onKeyDown={(e) => { if (e.key === "Enter") handleLogin(); }}
                placeholder="Password"
                style={{
                  width: "100%",
                  height: "100%",
                  background: "transparent",
                  border: "none",
                  outline: "none",
                  color: "#FFFFFF",
                  fontSize: 15,
                  fontWeight: 600,
                  fontFamily: "inherit"
                }}
                onFocus={(e) => {
                  e.currentTarget.parentElement.style.borderColor = "#256BFD";
                  e.currentTarget.parentElement.style.boxShadow = "0 0 0 3px rgba(37,107,253,0.2)";
                }}
                onBlur={(e) => {
                  e.currentTarget.parentElement.style.borderColor = "rgba(255,255,255,0.08)";
                  e.currentTarget.parentElement.style.boxShadow = "none";
                }}
              />
              <button
                type="button"
                onClick={() => setShowPassword(!showPassword)}
                style={{
                  background: "transparent",
                  border: "none",
                  color: "rgba(255,255,255,0.4)",
                  cursor: "pointer",
                  fontSize: 15,
                  padding: 4,
                  display: "flex",
                  alignItems: "center"
                }}
              >
                {showPassword ? "ðŸ‘ï¸" : "ðŸ™ˆ"}
              </button>
            </div>

            {/* ERROR MESSAGE */}
            {error && (
              <div style={{
                background: "rgba(255,80,80,0.12)",
                border: "1px solid rgba(255,80,80,0.3)",
                color: "#FF7070",
                fontSize: 13,
                fontWeight: 600,
                padding: "10px 14px",
                borderRadius: 14,
                display: "flex",
                alignItems: "center",
                gap: 8
              }}>
                <span>âš ï¸</span> {error}
              </div>
            )}

            {/* LOG IN PRIMARY BUTTON */}
            <button
              type="button"
              onClick={() => handleLogin()}
              disabled={loading}
              style={{
                width: "100%",
                height: 56,
                borderRadius: 18,
                background: "linear-gradient(135deg, #256BFD 0%, #1A5EE5 100%)",
                color: "#FFFFFF",
                border: "none",
                fontWeight: 900,
                fontSize: 15,
                letterSpacing: "0.5px",
                cursor: loading ? "not-allowed" : "pointer",
                transition: "all 0.2s cubic-bezier(0.16, 1, 0.3, 1)",
                boxShadow: "0 8px 30px rgba(37,107,253,0.38)",
                display: "flex",
                alignItems: "center",
                justifyContent: "center",
                gap: 8,
                opacity: loading ? 0.7 : 1
              }}
              onMouseEnter={(e) => { if (!loading) e.currentTarget.style.filter = "brightness(1.1)"; }}
              onMouseLeave={(e) => { e.currentTarget.style.filter = "none"; }}
            >
              {loading ? (
                <>
                  <span className="s3-spinner" style={{ borderTopColor: "#fff" }} />
                  <span>LOGGING IN...</span>
                </>
              ) : (
                <span>LOG IN â†’</span>
              )}
            </button>

            {/* QUICK DEMO ONE-TAP LOGIN */}
            <button
              type="button"
              onClick={handleDemoLogin}
              style={{
                background: "rgba(255,255,255,0.04)",
                border: "1px dashed rgba(37,107,253,0.35)",
                color: "#3B82F6",
                borderRadius: 14,
                padding: "11px 16px",
                fontSize: 12.5,
                fontWeight: 700,
                cursor: "pointer",
                display: "flex",
                alignItems: "center",
                justifyContent: "center",
                gap: 6,
                marginTop: 4,
                transition: "all 0.15s ease"
              }}
            >
              <span>âš¡</span> Quick Demo Login (Mohd Numan)
            </button>

          </div>

          {/* SIGN UP FOOTER LINK */}
          <p style={{ textAlign: "center", color: "rgba(255,255,255,0.45)", marginTop: 28, fontSize: 14 }}>
            New to STOKE?{" "}
            <button
              type="button"
              onClick={() => {
                setError("");
                setScreen("signup");
              }}
              style={{
                background: "transparent",
                border: "none",
                color: "#FFFFFF",
                fontWeight: 800,
                cursor: "pointer",
                fontSize: 14,
                textDecoration: "underline",
                textUnderlineOffset: 3
              }}
            >
              Create account
            </button>
          </p>

        </div>

        {/* GOOGLE ACCOUNTS MODAL */}
        {showGoogleModal && (
          <div style={{
            position: "fixed",
            inset: 0,
            background: "rgba(0,0,0,0.75)",
            backdropFilter: "blur(12px)",
            zIndex: 9999,
            display: "flex",
            alignItems: "center",
            justifyContent: "center",
            padding: 20
          }}>
            <div style={{
              background: "#101420",
              border: "1.5px solid rgba(255,255,255,0.1)",
              borderRadius: 24,
              padding: 24,
              maxWidth: 380,
              width: "100%",
              boxShadow: "0 20px 60px rgba(0,0,0,0.8)"
            }}>
              <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 18 }}>
                <h3 style={{ margin: 0, fontSize: 17, fontWeight: 900 }}>Select Google Account</h3>
                <button
                  type="button"
                  onClick={() => setShowGoogleModal(false)}
                  style={{ background: "transparent", border: "none", color: "rgba(255,255,255,0.5)", fontSize: 18, cursor: "pointer" }}
                >
                  âœ•
                </button>
              </div>
              <div style={{ display: "flex", flexDirection: "column", gap: 10 }}>
                {GOOGLE_ACCOUNTS.map((acc, i) => (
                  <div
                    key={i}
                    onClick={() => {
                      setShowGoogleModal(false);
                      update("email", acc.email);
                      handleLogin(acc.email);
                    }}
                    style={{
                      display: "flex",
                      alignItems: "center",
                      gap: 12,
                      padding: "12px 14px",
                      borderRadius: 16,
                      background: "rgba(255,255,255,0.04)",
                      border: "1px solid rgba(255,255,255,0.07)",
                      cursor: "pointer",
                      transition: "all 0.2s ease"
                    }}
                    onMouseEnter={(e) => { e.currentTarget.style.borderColor = "#256BFD"; }}
                    onMouseLeave={(e) => { e.currentTarget.style.borderColor = "rgba(255,255,255,0.07)"; }}
                  >
                    <div style={{
                      width: 38,
                      height: 38,
                      borderRadius: "50%",
                      background: acc.color,
                      color: "#fff",
                      display: "flex",
                      alignItems: "center",
