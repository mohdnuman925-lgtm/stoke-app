              style={{
                width: "100%",
                height: 56,
                borderRadius: 18,
                background: "#FFFFFF",
                color: "#08090E",
                border: "none",
                fontWeight: 800,
                fontSize: 15,
                display: "flex",
                alignItems: "center",
                justifyContent: "center",
                gap: 12,
                cursor: "pointer",
                transition: "all 0.2s ease",
                boxShadow: "0 4px 18px rgba(0,0,0,0.3)"
              }}
            >
              <svg width="20" height="20" viewBox="0 0 24 24">
                <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.8-2.4 3.68v3.05h3.88c2.27-2.09 3.665-5.17 3.665-9.17z"/>
                <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.25v3.15C3.26 21.36 7.33 24 12 24z"/>
                <path fill="#FBBC05" d="M5.28 14.27c-.25-.72-.38-1.49-.38-2.27s.13-1.55.38-2.27V6.58H1.25C.45 8.18 0 9.99 0 12s.45 3.82 1.25 5.42l4.03-3.15z"/>
                <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.33 0 3.26 2.64 1.25 6.58l4.03 3.15c.95-2.83 3.6-4.98 6.72-4.98z"/>
              </svg>
              Continue with Google
            </button>

            {/* DIVIDER */}
            <div style={{ display: "flex", alignItems: "center", gap: 14, margin: "6px 0" }}>
              <div style={{ flex: 1, height: 1, background: "rgba(255,255,255,0.08)" }} />
              <span style={{ fontSize: 11, color: "rgba(255,255,255,0.35)", fontWeight: 800, letterSpacing: "1.5px" }}>
                OR
              </span>
              <div style={{ flex: 1, height: 1, background: "rgba(255,255,255,0.08)" }} />
            </div>

            {/* EMAIL */}
            <div style={{
              display: "flex",
              alignItems: "center",
              height: 56,
              padding: "0 18px",
              borderRadius: 18,
              background: "#101420",
              border: "1.5px solid rgba(255,255,255,0.08)",
              transition: "all 0.2s ease"
            }}>
              <input
                type="email"
                value={form.email}
                onChange={(e) => update("email", e.target.value)}
                placeholder="Email"
                style={{
                  width: "100%",
                  height: "100%",
                  background: "transparent",
                  border: "none",
                  outline: "none",
                  color: "#FFFFFF",
                  fontSize: 15,
                  fontWeight: 600,
                  fontFamily: "inherit"
                }}
                onFocus={(e) => {
                  e.currentTarget.parentElement.style.borderColor = "#256BFD";
                  e.currentTarget.parentElement.style.boxShadow = "0 0 0 3px rgba(37,107,253,0.2)";
                }}
                onBlur={(e) => {
                  e.currentTarget.parentElement.style.borderColor = "rgba(255,255,255,0.08)";
                  e.currentTarget.parentElement.style.boxShadow = "none";
                }}
              />
            </div>

            {/* PASSWORD */}
            <div style={{
              display: "flex",
              alignItems: "center",
              height: 56,
              padding: "0 18px",
              borderRadius: 18,
              background: "#101420",
              border: "1.5px solid rgba(255,255,255,0.08)",
              transition: "all 0.2s ease"
            }}>
              <input
                type={showPassword ? "text" : "password"}
                value={form.password}
                onChange={(e) => update("password", e.target.value)}
                placeholder="Create password"
                style={{
                  width: "100%",
                  height: "100%",
                  background: "transparent",
                  border: "none",
                  outline: "none",
                  color: "#FFFFFF",
                  fontSize: 15,
                  fontWeight: 600,
                  fontFamily: "inherit"
                }}
                onFocus={(e) => {
                  e.currentTarget.parentElement.style.borderColor = "#256BFD";
                  e.currentTarget.parentElement.style.boxShadow = "0 0 0 3px rgba(37,107,253,0.2)";
                }}
                onBlur={(e) => {
                  e.currentTarget.parentElement.style.borderColor = "rgba(255,255,255,0.08)";
                  e.currentTarget.parentElement.style.boxShadow = "none";
                }}
              />
              <button
                type="button"
                onClick={() => setShowPassword(!showPassword)}
                style={{
                  background: "transparent",
                  border: "none",
                  color: "rgba(255,255,255,0.4)",
                  cursor: "pointer",
                  fontSize: 15,
                  padding: 4
                }}
              >
                {showPassword ? "ðŸ‘ï¸" : "ðŸ™ˆ"}
              </button>
            </div>

            {/* ERROR MESSAGE */}
            {error && (
              <div style={{
                background: "rgba(255,80,80,0.12)",
                border: "1px solid rgba(255,80,80,0.3)",
                color: "#FF7070",
                fontSize: 13,
                fontWeight: 600,
                padding: "10px 14px",
                borderRadius: 14,
                display: "flex",
                alignItems: "center",
                gap: 8
              }}>
                <span>âš ï¸</span> {error}
              </div>
            )}

            {/* CREATE ACCOUNT BUTTON */}
            <button
              type="button"
              onClick={handleCreateAccount}
              style={{
                width: "100%",
                height: 56,
                borderRadius: 18,
                background: "linear-gradient(135deg, #256BFD 0%, #1A5EE5 100%)",
                color: "#FFFFFF",
                border: "none",
                fontWeight: 900,
                fontSize: 15,
                letterSpacing: "0.5px",
                cursor: "pointer",
                transition: "all 0.2s cubic-bezier(0.16, 1, 0.3, 1)",
                boxShadow: "0 8px 30px rgba(37,107,253,0.38)",
                display: "flex",
                alignItems: "center",
                justifyContent: "center"
              }}
              onMouseEnter={(e) => { e.currentTarget.style.filter = "brightness(1.1)"; }}
              onMouseLeave={(e) => { e.currentTarget.style.filter = "none"; }}
            >
              CREATE ACCOUNT â†’
            </button>

          </div>

          {/* SIGN IN FOOTER LINK */}
          <p style={{ textAlign: "center", color: "rgba(255,255,255,0.45)", marginTop: 28, fontSize: 14 }}>
            Already have an account?{" "}
            <button
              type="button"
              onClick={() => {
                setError("");
                setScreen("login");
              }}
              style={{
                background: "transparent",
                border: "none",
                color: "#FFFFFF",
                fontWeight: 800,
                cursor: "pointer",
                fontSize: 14,
                textDecoration: "underline",
                textUnderlineOffset: 3
              }}
            >
              Log in
            </button>
          </p>

        </div>

        {/* GOOGLE ACCOUNTS MODAL */}
        {showGoogleModal && (
          <div style={{
            position: "fixed",
            inset: 0,
            background: "rgba(0,0,0,0.75)",
            backdropFilter: "blur(12px)",
            zIndex: 9999,
            display: "flex",
            alignItems: "center",
            justifyContent: "center",
            padding: 20
          }}>
            <div style={{
              background: "#101420",
              border: "1.5px solid rgba(255,255,255,0.1)",
              borderRadius: 24,
              padding: 24,
              maxWidth: 380,
              width: "100%",
              boxShadow: "0 20px 60px rgba(0,0,0,0.8)"
            }}>
              <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 18 }}>
                <h3 style={{ margin: 0, fontSize: 17, fontWeight: 900 }}>Select Google Account</h3>
                <button
                  type="button"
                  onClick={() => setShowGoogleModal(false)}
                  style={{ background: "transparent", border: "none", color: "rgba(255,255,255,0.5)", fontSize: 18, cursor: "pointer" }}
                >
                  âœ•
                </button>
              </div>
              <div style={{ display: "flex", flexDirection: "column", gap: 10 }}>
                {GOOGLE_ACCOUNTS.map((acc, i) => (
                  <div
                    key={i}
                    onClick={() => {
                      setShowGoogleModal(false);
                      update("email", acc.email);
                      update("password", "google_oauth_authorized");
                      setStep(0);
                      setScreen("profile");
                    }}
                    style={{
                      display: "flex",
                      alignItems: "center",
                      gap: 12,
                      padding: "12px 14px",
                      borderRadius: 16,
                      background: "rgba(255,255,255,0.04)",
                      border: "1px solid rgba(255,255,255,0.07)",
                      cursor: "pointer"
                    }}
                  >
                    <div style={{
                      width: 38,
                      height: 38,
                      borderRadius: "50%",
                      background: acc.color,
                      color: "#fff",
                      display: "flex",
                      alignItems: "center",
                      justifyContent: "center",
                      fontWeight: 900,
                      fontSize: 16
                    }}>
                      {acc.avatar}
                    </div>
                    <div style={{ flex: 1, minWidth: 0 }}>
                      <div style={{ fontWeight: 800, fontSize: 13, color: "#fff" }}>{acc.name}</div>
                      <div style={{ fontSize: 11.5, color: "rgba(255,255,255,0.45)", whiteSpace: "nowrap", overflow: "hidden", textOverflow: "ellipsis" }}>
                        {acc.email}
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        )}

      </div>
    );
  }

  /*
   * PROFILE ONBOARDING (8 STEPS)
   */
  if (screen === "profile") {
    const currentStep = STEPS[step];
    const currentValue = form[currentStep.key];

    return (
      <div style={{
        minHeight: "100vh",
        background: "radial-gradient(circle at 50% 0%, #10162A 0%, #08090E 70%)",
        color: "#FFFFFF",
        display: "flex",
        alignItems: "center",
        justifyContent: "center",
        padding: "28px 20px 36px",
        fontFamily: "'Space Grotesk', ui-sans-serif, system-ui, sans-serif",
        position: "relative",
        overflowX: "hidden"
      }}>
        {/* Ambient lighting orb */}
        <div style={{
          position: "absolute",
          top: -100,
          left: "50%",
          transform: "translateX(-50%)",
          width: 320,
          height: 320,
          borderRadius: "50%",
          background: "radial-gradient(circle, rgba(37,107,253,0.18) 0%, transparent 70%)",
          pointerEvents: "none",
          filter: "blur(40px)"
        }} />

        <div style={{ width: "100%", maxWidth: 430, position: "relative", zIndex: 1 }}>

          {/* TOP NAV: BACK BUTTON & STEP COUNTER */}
          <div style={{ display: "flex", alignItems: "center", justifyContent: "space-between", marginBottom: 24 }}>
            <button
              type="button"
              onClick={goBack}
              style={{
                width: 40,
                height: 40,
                borderRadius: "50%",
                background: "#101420",
                border: "1px solid rgba(255,255,255,0.1)",
                color: "#FFFFFF",
                display: "flex",
                alignItems: "center",
                justifyContent: "center",
                cursor: "pointer",
                fontSize: 18
              }}
            >
              â†
            </button>

            <span style={{ fontSize: 13, color: "rgba(255,255,255,0.45)", fontWeight: 800, letterSpacing: "1px" }}>
              {String(step + 1).padStart(2, "0")} / {String(STEPS.length).padStart(2, "0")}
            </span>
          </div>

          {/* 8-SEGMENT PROGRESS BAR */}
          <div style={{ display: "flex", gap: 6, marginBottom: 32 }}>
            {STEPS.map((_, index) => (
              <div
                key={index}
                style={{
                  height: 4,
                  flex: 1,
                  borderRadius: 2,
                  background: index <= step ? "#256BFD" : "rgba(255,255,255,0.1)",
                  boxShadow: index <= step ? "0 0 10px rgba(37,107,253,0.6)" : "none",
                  transition: "all 0.35s ease"
                }}
              />
            ))}
          </div>

          {/* STEP TITLE & SUBTITLE */}
          <h1 style={{
            fontSize: 32,
            fontWeight: 900,
            letterSpacing: "-0.8px",
            lineHeight: 1.2,
            margin: "0 0 8px",
            color: "#FFFFFF"
          }}>
            {currentStep.title}
          </h1>

          <p style={{
            color: "rgba(255,255,255,0.48)",
            fontSize: 15,
            marginTop: 0,
            marginBottom: 28,
            lineHeight: 1.5
          }}>
            {currentStep.subtitle}
          </p>

          {/* INPUT STEP */}
          {currentStep.type === "input" && (
            <div style={{
              display: "flex",
              alignItems: "center",
              height: 64,
              padding: "0 20px",
              borderRadius: 20,
              background: "#101420",
              border: "1.5px solid rgba(255,255,255,0.1)",
              transition: "all 0.2s ease"
            }}>
              <input
                autoFocus
                type={
                  currentStep.key === "age" ||
                  currentStep.key === "height" ||
                  currentStep.key === "weight"
                    ? "number"
                    : "text"
                }
                value={currentValue || ""}
                onChange={(e) => update(currentStep.key, e.target.value)}
                onKeyDown={(e) => { if (e.key === "Enter") nextStep(); }}
                placeholder={currentStep.placeholder}
                style={{
                  width: "100%",
                  height: "100%",
                  background: "transparent",
                  border: "none",
                  outline: "none",
                  color: "#FFFFFF",
                  fontSize: 18,
                  fontWeight: 800,
                  fontFamily: "inherit"
                }}
                onFocus={(e) => {
                  e.currentTarget.parentElement.style.borderColor = "#256BFD";
                  e.currentTarget.parentElement.style.boxShadow = "0 0 0 3px rgba(37,107,253,0.2)";
                }}
                onBlur={(e) => {
                  e.currentTarget.parentElement.style.borderColor = "rgba(255,255,255,0.1)";
                  e.currentTarget.parentElement.style.boxShadow = "none";
                }}
              />
            </div>
          )}

          {/* OPTIONS STEP */}
          {currentStep.options && (
            <div style={{ display: "flex", flexDirection: "column", gap: 12 }}>
              {currentStep.options.map((option) => {
                const selected = currentValue === option;

                return (
                  <button
                    key={option}
                    type="button"
                    onClick={() => selectOption(option)}
                    style={{
                      width: "100%",
                      minHeight: 62,
                      padding: "16px 20px",
                      borderRadius: 18,
                      display: "flex",
                      alignItems: "center",
                      justifyContent: "space-between",
                      textAlign: "left",
                      cursor: "pointer",
                      fontFamily: "inherit",
                      transition: "all 0.22s cubic-bezier(0.16, 1, 0.3, 1)",
                      border: selected ? "1.5px solid #256BFD" : "1.5px solid rgba(255,255,255,0.08)",
                      background: selected ? "rgba(37,107,253,0.14)" : "#101420",
                      boxShadow: selected ? "0 0 25px rgba(37,107,253,0.18)" : "0 4px 14px rgba(0,0,0,0.3)"
                    }}
                  >
                    <span style={{ fontWeight: 800, fontSize: 16, color: "#FFFFFF" }}>
                      {option}
                    </span>

                    <span style={{
                      width: 26,
                      height: 26,
                      borderRadius: "50%",
                      display: "flex",
                      alignItems: "center",
                      justifyContent: "center",
                      fontSize: 14,
                      fontWeight: 900,
                      border: selected ? "1.5px solid #256BFD" : "1.5px solid rgba(255,255,255,0.2)",
                      background: selected ? "#256BFD" : "transparent",
                      color: selected ? "#FFFFFF" : "transparent",
                      transition: "all 0.2s ease"
                    }}>
                      âœ“
                    </span>
                  </button>
                );
              })}
            </div>
          )}

          {/* ERROR */}
          {error && (
            <div style={{
              background: "rgba(255,80,80,0.12)",
              border: "1px solid rgba(255,80,80,0.3)",
              color: "#FF7070",
              fontSize: 13,
              fontWeight: 600,
              padding: "10px 14px",
              borderRadius: 14,
              marginTop: 18,
              display: "flex",
              alignItems: "center",
              gap: 8
            }}>
              <span>âš ï¸</span> {error}
            </div>
          )}

          {/* CONTINUE / FINISH BUTTON */}
          <button
            type="button"
            onClick={nextStep}
            style={{
              marginTop: 32,
              width: "100%",
              height: 56,
              borderRadius: 18,
              background: "linear-gradient(135deg, #256BFD 0%, #1A5EE5 100%)",
              color: "#FFFFFF",
              border: "none",
              fontWeight: 900,
              fontSize: 15,
              letterSpacing: "0.5px",
              cursor: "pointer",
              transition: "all 0.2s cubic-bezier(0.16, 1, 0.3, 1)",
              boxShadow: "0 8px 30px rgba(37,107,253,0.38)",
              display: "flex",
              alignItems: "center",
              justifyContent: "center"
            }}
            onMouseEnter={(e) => { e.currentTarget.style.filter = "brightness(1.1)"; }}
            onMouseLeave={(e) => { e.currentTarget.style.filter = "none"; }}
          >
            {step === STEPS.length - 1 ? "FINISH PROFILE â†’" : "CONTINUE â†’"}
          </button>

        </div>
      </div>
    );
  }

  /*
   * PROFILE SUMMARY SCREEN
   */
  return (
    <div style={{
      minHeight: "100vh",
      background: "radial-gradient(circle at 50% 0%, #10162A 0%, #08090E 70%)",
      color: "#FFFFFF",
      display: "flex",
      alignItems: "center",
      justifyContent: "center",
      padding: "32px 20px 40px",
      fontFamily: "'Space Grotesk', ui-sans-serif, system-ui, sans-serif",
      position: "relative",
      overflowX: "hidden"
    }}>
      {/* Ambient lighting orb */}
      <div style={{
        position: "absolute",
        top: -100,
        left: "50%",
        transform: "translateX(-50%)",
        width: 320,
        height: 320,
        borderRadius: "50%",
        background: "radial-gradient(circle, rgba(37,107,253,0.18) 0%, transparent 70%)",
        pointerEvents: "none",
        filter: "blur(40px)"
      }} />

      <div style={{ width: "100%", maxWidth: 430, position: "relative", zIndex: 1 }}>

        {/* SUMMARY HERO */}
        <div style={{ textAlign: "center", marginBottom: 28 }}>
          <div style={{
            margin: "0 auto",
            width: 88,
            height: 88,
            borderRadius: "50%",
            background: "linear-gradient(135deg, rgba(37,107,253,0.2) 0%, #101420 100%)",
            border: "1.5px solid rgba(37,107,253,0.4)",
            boxShadow: "0 0 35px rgba(37,107,253,0.25)",
            display: "flex",
            alignItems: "center",
            justifyContent: "center",
            fontSize: 36
          }}>
            ðŸ‘¤
          </div>

          <h1 style={{ fontSize: 32, fontWeight: 900, marginTop: 20, marginBottom: 8, letterSpacing: "-0.8px" }}>
            You're all set.
          </h1>

          <p style={{ color: "rgba(255,255,255,0.48)", margin: 0, fontSize: 15 }}>
            Your STOKE athlete profile is ready.
          </p>
        </div>

        {/* PROFILE ATTRIBUTES CARD */}
        <div style={{
          background: "#101420",
          border: "1.5px solid rgba(255,255,255,0.08)",
          borderRadius: 24,
          padding: "20px 22px",
          display: "flex",
          flexDirection: "column",
          gap: 4,
          boxShadow: "0 8px 32px rgba(0,0,0,0.4)"
        }}>
          <ProfileSummaryRow label="Name" value={form.name} />
          <ProfileSummaryRow label="Age" value={form.age ? `${form.age} years` : ""} />
          <ProfileSummaryRow label="Height" value={form.height ? `${form.height} cm` : ""} />
          <ProfileSummaryRow label="Weight" value={form.weight ? `${form.weight} kg` : ""} />
          <ProfileSummaryRow label="Goal" value={form.goal} />
          <ProfileSummaryRow label="Fitness level" value={form.level} />
          <ProfileSummaryRow label="Training" value={form.frequency} />
          <ProfileSummaryRow label="Activity" value={form.activity} isLast />
        </div>

        {/* ERROR */}
        {error && (
          <div style={{
            background: "rgba(255,80,80,0.12)",
            border: "1px solid rgba(255,80,80,0.3)",
            color: "#FF7070",
            fontSize: 13,
            fontWeight: 600,
            padding: "10px 14px",
            borderRadius: 14,
            marginTop: 18,
            display: "flex",
            alignItems: "center",
            gap: 8
          }}>
            <span>âš ï¸</span> {error}
          </div>
        )}

        {/* START MY JOURNEY BUTTON */}
        <button
          type="button"
          onClick={finishProfile}
          disabled={loading}
          style={{
            marginTop: 24,
            width: "100%",
            height: 56,
            borderRadius: 18,
            background: "linear-gradient(135deg, #256BFD 0%, #1A5EE5 100%)",
            color: "#FFFFFF",
            border: "none",
            fontWeight: 900,
            fontSize: 15,
            letterSpacing: "0.5px",
            boxShadow: "0 8px 30px rgba(37,107,253,0.4)",
            cursor: loading ? "not-allowed" : "pointer",
            transition: "all 0.2s cubic-bezier(0.16, 1, 0.3, 1)",
            opacity: loading ? 0.7 : 1,
            display: "flex",
            alignItems: "center",
            justifyContent: "center",
            gap: 8
          }}
          onMouseEnter={(e) => { if (!loading) e.currentTarget.style.filter = "brightness(1.1)"; }}
          onMouseLeave={(e) => { e.currentTarget.style.filter = "none"; }}
        >
          {loading ? (
            <>
              <span className="s3-spinner" style={{ borderTopColor: "#fff" }} />
              <span>SETTING UP PROFILE...</span>
            </>
          ) : (
            <span>START MY JOURNEY â†’</span>
          )}
        </button>

        {/* EDIT PROFILE BUTTON */}
        <button
          type="button"
          onClick={() => {
            setStep(0);
            setScreen("profile");
          }}
          style={{
            width: "100%",
            marginTop: 14,
            padding: "10px 0",
            background: "transparent",
            border: "none",
            fontSize: 14,
            fontWeight: 700,
            color: "rgba(255,255,255,0.45)",
            cursor: "pointer",
            textDecoration: "underline",
            textUnderlineOffset: 3
          }}
        >
          Edit profile
        </button>

      </div>
    </div>
  );
}

function ProfileSummaryRow({ label, value, isLast = false }) {
  return (
    <div style={{
      display: "flex",
      alignItems: "center",
      justifyContent: "space-between",
      padding: "10px 0",
      borderBottom: isLast ? "none" : "1px solid rgba(255,255,255,0.06)"
    }}>
      <p style={{
        fontSize: 11.5,
        color: "rgba(255,255,255,0.4)",
        textTransform: "uppercase",
        letterSpacing: "1px",
        fontWeight: 800,
        margin: 0
      }}>
        {label}
      </p>

      <p style={{
        fontWeight: 800,
        fontSize: 14,
        margin: 0,
        color: value ? "#FFFFFF" : "rgba(255,255,255,0.3)"
      }}>
        {value || "Not provided"}
      </p>
    </div>
  );
}



/* ---------- app shell ---------- */

function NavIcon({ name, size = 18 }) {
  const common = { width: size, height: size, viewBox: "0 0 24 24", fill: "none", stroke: "currentColor", strokeWidth: 1.8, strokeLinecap: "round", strokeLinejoin: "round" };
  switch (name) {
    case "home":
      return (
        <svg {...common}>
          <path d="M4 11.5L12 4l8 7.5" />
          <path d="M6.5 10v9.5h11V10" />
          <path d="M10 19.5v-5h4v5" />
        </svg>
      );
    case "nutrition":
      return (
        <svg {...common}>
          <circle cx="12" cy="14" r="6.5" />
          <path d="M12 7.5V5" />
          <path d="M12 5c1-1.2 2.3-1.4 3.3-0.6" />
        </svg>
      );
    case "workout":
      return (
        <svg {...common}>
          <circle cx="5" cy="12" r="2.2" />
          <circle cx="19" cy="12" r="2.2" />
          <line x1="7.2" y1="12" x2="16.8" y2="12" />
          <line x1="5" y1="9.3" x2="5" y2="14.7" />
          <line x1="19" y1="9.3" x2="19" y2="14.7" />
        </svg>
      );
    case "run":
      return (
        <svg {...common}>
          <circle cx="15.5" cy="5" r="1.8" />
          <path d="M9 20l2.5-5.5 2 1.8 3.5-1" />
          <path d="M7 13.5l3.5-2.5 2 2.5-2.5 3.5" />
        </svg>
      );
    case "coach":
      return (
        <svg {...common}>
          <path d="M4.5 5.5h15v10.5H10l-3.5 3.5v-3.5H4.5z" />
        </svg>
      );
    case "profile":
    case "more":
      return (
        <svg {...common}>
          <circle cx="5" cy="12" r="1.8" fill="currentColor" />
          <circle cx="12" cy="12" r="1.8" fill="currentColor" />
          <circle cx="19" cy="12" r="1.8" fill="currentColor" />
        </svg>
      );
    default:
      return null;
  }
}

const TABS = [
  { key: "home", label: "Today", icon: "home" },
  { key: "nutrition", label: "Nutrition", icon: "nutrition" },
  { key: "workout", label: "Workout", icon: "workout" },
  { key: "coach", label: "Coach", icon: "coach" },
  { key: "more", label: "More", icon: "more" },
];

function StokeApp() {
  const urlParams = typeof window !== "undefined" ? new URLSearchParams(window.location.search) : new URLSearchParams();
  const initialAuthed = urlParams.get("authed") === "true";
  const initialTab = urlParams.get("tab") || "home";
  const initialShowWelcome = urlParams.get("welcome") === "true";
  const initialAuthMode = urlParams.get("mode") || "signin";

  const [tab, setTab] = useState(initialTab);
  const [authed, setAuthed] = useState(initialAuthed);
  const [userPhone, setUserPhone] = useState(initialAuthed ? "mohdnuman701@gmail.com" : "");
  const [showWelcome, setShowWelcome] = useState(initialShowWelcome);
  const [authMode, setAuthMode] = useState(initialAuthMode);

  function handleSignIn(phone, profileFromSignup) {
    setUserPhone(phone);
    if (profileFromSignup) {
      setProfile(profileFromSignup);
    }
    setTab("home");
    setAuthed(true);
  }
  function handleSignOut() {
    setAuthed(false);
    setUserPhone("");
    setTab("home");
    setShowWelcome(true);
  }

  const [profile, setProfile] = useState(DEFAULT_PROFILE);
  const goals = computeGoals(profile);

  const [mealSlots, setMealSlots] = useState(DEFAULT_MEAL_SLOTS);
  const [meals, setMeals] = useState(() => {
    const init = {};
    DEFAULT_MEAL_SLOTS.forEach((s) => { init[s.key] = []; });
    return init;
  });
  const [water, setWater] = useState(0);
  const totals = macroSum(meals);
  const calPct = totals.calories / goals.calories;
  function addItem(mealKey, item) { setMeals((prev) => ({ ...prev, [mealKey]: [...prev[mealKey], item] })); }
  function removeItem(mealKey, idx) { setMeals((prev) => ({ ...prev, [mealKey]: prev[mealKey].filter((_, i) => i !== idx) })); }
  function addMealSlot(name) {
    const key = `custom_${Date.now()}`;
    setMealSlots((prev) => [...prev, { key, label: name }]);
    setMeals((prev) => ({ ...prev, [key]: [] }));
  }
  function removeMealSlot(key) {
    setMealSlots((prev) => prev.filter((s) => s.key !== key));
    setMeals((prev) => {
      const next = { ...prev };
      delete next[key];
      return next;
    });
  }

  const [programKey, setProgramKey] = useState("Classic Split");
  const weekIndex = getWeekIndex();
  const week = resolveWeek(WORKOUT_PROGRAMS[programKey], weekIndex);
  const [activeDay, setActiveDay] = useState(TODAY_KEY);
  const [logs, setLogs] = useState(() => buildLogs(resolveWeek(WORKOUT_PROGRAMS["Classic Split"], getWeekIndex())));
  function switchProgram(name) {
    setProgramKey(name);
    setLogs(buildLogs(resolveWeek(WORKOUT_PROGRAMS[name], weekIndex)));
    setActiveDay(TODAY_KEY);
  }
  function updateSet(exName, setIdx, field, value) {
    setLogs((prev) => ({ ...prev, [activeDay]: { ...prev[activeDay], [exName]: { ...prev[activeDay][exName], sets: prev[activeDay][exName].sets.map((s, i) => (i === setIdx ? { ...s, [field]: value } : s)) } } }));
  }
  function addSet(exName) {
    setLogs((prev) => ({ ...prev, [activeDay]: { ...prev[activeDay], [exName]: { ...prev[activeDay][exName], sets: [...prev[activeDay][exName].sets, { reps: "", weight: "" }] } } }));
  }
  function toggleComplete(exName) {
    setLogs((prev) => ({ ...prev, [activeDay]: { ...prev[activeDay], [exName]: { ...prev[activeDay][exName], completed: !prev[activeDay][exName].completed } } }));
  }

  const [runs, setRuns] = useState([]);
  const [runStatus, setRunStatus] = useState("idle");
  const [runElapsed, setRunElapsed] = useState(0);
  const [runDistanceKm, setRunDistanceKm] = useState(0);
  const [runGpsError, setRunGpsError] = useState(null);
  const [runAccuracy, setRunAccuracy] = useState(null);
  const [runShareCardUrl, setRunShareCardUrl] = useState(null);
  const [runShareStyle, setRunShareStyle] = useState("dark");
  const [runLiveGpsPos, setRunLiveGpsPos] = useState(null);
  const runWatchIdRef = useRef(null);
  const runLastPointRef = useRef(null);
  const runPathRef = useRef([]);
  const runTimerRef = useRef(null);
  const lastGpsMotionRef = useRef(0);

  useEffect(() => {
    return () => {
      if (runWatchIdRef.current !== null && navigator.geolocation) navigator.geolocation.clearWatch(runWatchIdRef.current);
      if (runTimerRef.current) clearInterval(runTimerRef.current);
    };
  }, []);

  function runStartWatch() {
    if (!navigator.geolocation) {
      setRunGpsError("GPS isn't available in this preview environment — on a real device the app requests high-accuracy location.");
      return;
    }
    runWatchIdRef.current = navigator.geolocation.watchPosition(
      (pos) => {
        const point = { lat: pos.coords.latitude, lng: pos.coords.longitude };
        setRunAccuracy(pos.coords.accuracy);
        setRunLiveGpsPos([point.lat, point.lng]);
        if (runLastPointRef.current) {
          const d = haversineKm(runLastPointRef.current, point);
          // Only add distance if actual movement occurred (> 5 meters) to ignore stationary jitter
          if (d >= 0.005 && d < 0.2) {
            setRunDistanceKm((prev) => Number((prev + d).toFixed(3)));
            runPathRef.current.push(point);
            lastGpsMotionRef.current = Date.now();
          }
        } else {
          runPathRef.current.push(point);
          lastGpsMotionRef.current = Date.now();
        }
        runLastPointRef.current = point;
      },
      (err) => setRunGpsError(err.message || "Location permission was denied."),
      { enableHighAccuracy: true, maximumAge: 1000, timeout: 15000 }
    );
  }
  function runStartTimer() {
    runTimerRef.current = setInterval(() => {
      setRunElapsed((e) => e + 1);
    }, 1000);
  }
  function runStopTimer() {
    if (runTimerRef.current) clearInterval(runTimerRef.current);
  }
  function handleRunStart() {
    setRunStatus("active");
    setRunElapsed(0);
    setRunDistanceKm(0);
    setRunGpsError(null);
    setRunShareCardUrl(null);
    setRunShareStyle("dark");
    runLastPointRef.current = null;
    runPathRef.current = [];
    lastGpsMotionRef.current = 0;
    runStartWatch();
    runStartTimer();
  }
  function handleRunPause() {
    setRunStatus("paused");
    runStopTimer();
  }
  function handleRunResume() {
    setRunStatus("active");
    runStartTimer();
  }
  function handleRunFinish() {
    setRunStatus("finished");
    runStopTimer();
    if (runWatchIdRef.current !== null && navigator.geolocation) navigator.geolocation.clearWatch(runWatchIdRef.current);
    const liveDist = runDistanceKm > 0 ? runDistanceKm : 0;
    const paceMinPerKm = (liveDist >= 0.01 && runElapsed > 0) ? (runElapsed / 60 / liveDist) : 0;
    const calories = Math.round(liveDist * RUNNER_WEIGHT_KG * 1.036);
    setRunShareCardUrl(drawShareCard({ distanceKm: liveDist, elapsed: runElapsed, paceMinPerKm, path: runPathRef.current, style: runShareStyle }));
    setRuns((prev) => [
      { date: new Date().toLocaleDateString(undefined, { month: "short", day: "numeric" }), distanceKm: liveDist, elapsed: runElapsed, paceMinPerKm, calories, path: [...runPathRef.current] },
      ...prev,
    ]);
  }
  function handleRunChangeStyle(style) {
    setRunShareStyle(style);
    const liveDist = runDistanceKm > 0 ? runDistanceKm : 0;
    const paceMinPerKm = (liveDist >= 0.01 && runElapsed > 0) ? (runElapsed / 60 / liveDist) : 0;
    setRunShareCardUrl(drawShareCard({ distanceKm: liveDist, elapsed: runElapsed, paceMinPerKm, path: runPathRef.current, style }));
  }
  function handleRunReset() {
    setRunStatus("idle");
    setRunElapsed(0);
    setRunDistanceKm(0);
    setRunGpsError(null);
    setRunAccuracy(null);
    setRunShareCardUrl(null);
  }

  const [messages, setMessages] = useState([]);
  const [input, setInput] = useState("");
  const [loading, setLoading] = useState(false);
  const remaining = {
    calories: Math.max(0, Math.round(goals.calories - totals.calories)),
    protein: Math.max(0, Math.round(goals.protein - totals.protein)),
    carbs: Math.max(0, Math.round(goals.carbs - totals.carbs)),
    fat: Math.max(0, Math.round(goals.fat - totals.fat)),
  };

  if (showWelcome) {
    return (
      <WelcomeCarousel
        onSignUp={() => { setAuthMode("signup"); setShowWelcome(false); }}
        onLogIn={() => { setAuthMode("signin"); setShowWelcome(false); }}
      />
    );
  }

  if (!authed) {
    return <AuthScreen onSignIn={handleSignIn} initialMode={authMode} />;
  }

  return (
    <div style={{ background: "radial-gradient(circle at 50% 0%, #1A1A1A 0%, #000000 60%)", height: "100vh", fontFamily: "'Space Grotesk', ui-sans-serif, system-ui, sans-serif", display: "flex", flexDirection: "column" }}>
      <div style={{ maxWidth: 480, width: "100%", margin: "0 auto", display: "flex", flexDirection: "column", height: "100%", position: "relative" }}>
        <div style={{
          flex: 1,
          overflowY: "auto",
          WebkitOverflowScrolling: "touch",
          padding: tab === "run" ? "16px 14px 110px" : "24px 16px 90px",
          display: "flex",
          flexDirection: "column",
          position: "relative"
        }}>
          {tab === "home" && <HomeScreen totals={totals} calPct={calPct} goals={goals} workoutDay={week[TODAY_KEY]} workoutLog={logs[TODAY_KEY]} lastRun={runs[0]} profileName={profile.name} water={water} setWater={setWater} onNavigate={setTab} />}
          {tab === "nutrition" && <NutritionScreen meals={meals} mealSlots={mealSlots} addMealSlot={addMealSlot} removeMealSlot={removeMealSlot} water={water} setWater={setWater} addItem={addItem} removeItem={removeItem} totals={totals} calPct={calPct} goals={goals} />}
          {tab === "workout" && <WorkoutScreen week={week} programKey={programKey} onProgramChange={switchProgram} activeDay={activeDay} setActiveDay={setActiveDay} logs={logs} updateSet={updateSet} addSet={addSet} toggleComplete={toggleComplete} />}
          {tab === "run" && (
            <RunScreen
              profile={profile}
              runs={runs}
              setRuns={setRuns}
              status={runStatus}
              elapsed={runElapsed}
              distanceKm={runDistanceKm}
              setDistanceKm={setRunDistanceKm}
              gpsError={runGpsError}
              accuracy={runAccuracy}
              shareCardUrl={runShareCardUrl}
              shareStyle={runShareStyle}
              onChangeStyle={handleRunChangeStyle}
              pathRef={runPathRef}
              handleStart={handleRunStart}
              handlePause={handleRunPause}
              handleResume={handleRunResume}
              handleFinish={handleRunFinish}
              handleReset={handleRunReset}
              liveGpsPos={runLiveGpsPos}
            />
          )}
          {tab === "coach" && <CoachScreen remaining={remaining} goals={goals} messages={messages} setMessages={setMessages} input={input} setInput={setInput} loading={loading} setLoading={setLoading} profile={profile} onNavigate={setTab} addItem={addItem} />}
          {(tab === "more" || tab === "profile") && <MoreHubScreen profile={profile} setProfile={setProfile} goals={goals} userPhone={userPhone} onSignOut={handleSignOut} onSwitchAccount={handleSignIn} totals={totals} onNavigate={setTab} />}
        </div>
        <div style={{ padding: "0 12px 14px", background: "transparent" }}>
          <div style={{ position: "relative", display: "flex", background: "rgba(22,27,36,0.75)", backdropFilter: "blur(20px) saturate(180%)", WebkitBackdropFilter: "blur(20px) saturate(180%)", border: "1px solid rgba(255,255,255,0.1)", borderRadius: 999, padding: 6, boxShadow: "0 8px 24px rgba(0,0,0,0.4)" }}>
            <div
              style={{
                position: "absolute",
                top: 6,
                bottom: 6,
                left: `calc(${(TABS.findIndex((t) => t.key === tab) / TABS.length) * 100}% + 6px)`,
                width: `calc(${100 / TABS.length}% - 12px)`,
                borderRadius: 999,
                background: "linear-gradient(155deg, rgba(215,255,62,0.35), rgba(215,255,62,0.12))",
                backdropFilter: "blur(6px)",
                WebkitBackdropFilter: "blur(6px)",
                border: "1px solid rgba(215,255,62,0.4)",
                boxShadow: "0 0 16px rgba(215,255,62,0.25)",
                transition: "left 0.45s cubic-bezier(0.34, 1.56, 0.64, 1)",
              }}
            />
            {TABS.map((t) => (
              <button key={t.key} onClick={() => setTab(t.key)} style={{ flex: 1, background: "none", border: "none", padding: "9px 0 7px", cursor: "pointer",
                color: tab === t.key ? TOKENS.ember : TOKENS.mutedFaint, display: "flex", flexDirection: "column", alignItems: "center", gap: 2, position: "relative", zIndex: 1 }}>
                <span style={{ position: "relative", display: "flex" }}>
                  <NavIcon name={t.icon} size={19} />
                  {t.key === "run" && runStatus === "active" && (
                    <span style={{ position: "absolute", top: -2, right: -6, width: 8, height: 8, borderRadius: "50%", background: TOKENS.ember, border: "1.5px solid rgba(22,27,36,0.9)" }} />
                  )}
                </span>
                <span style={{ fontSize: 9.5, fontWeight: 600 }}>{t.label}</span>
              </button>
            ))}
          </div>
        </div>
      </div>
    </div>
  );
}

ReactDOM.createRoot(document.getElementById("root")).render(<StokeApp />);
  </script>
</body>
</html>
