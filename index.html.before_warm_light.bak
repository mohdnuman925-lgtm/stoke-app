<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Stoke ⚡ — Fitness, Nutrition & Running Tracker</title>
  <meta name="theme-color" content="#000000" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="STOKE" />
  <meta name="application-name" content="STOKE" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="leaflet.css" />
  <script src="leaflet.js"></script>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body, #root { height: 100%; width: 100%; overflow: hidden; }
    body {
      font-family: 'Space Grotesk', ui-sans-serif, system-ui, -apple-system, sans-serif;
      background: #000000;
      color: #F5F5F5;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      -webkit-tap-highlight-color: transparent;
    }
    input, select, button, textarea { font-family: inherit; }
    ::-webkit-scrollbar { width: 0; height: 0; }
    input[type="number"]::-webkit-inner-spin-button,
    input[type="number"]::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
    input[type="number"] { -moz-appearance: textfield; }
    @keyframes stokeFadeUp { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: translateY(0); } }
    @keyframes stokeFadeIn { from { opacity: 0; } to { opacity: 1; } }
    @keyframes spin { to { transform: rotate(360deg); } }
    .stoke-auth-header { animation: stokeFadeUp 0.5s ease-out both; }
    .stoke-auth-card { animation: stokeFadeUp 0.5s ease-out 0.12s both; }
    .stoke-auth-footer { animation: stokeFadeIn 0.6s ease-out 0.3s both; }
    .stoke-btn-primary { transition: transform 0.15s ease, opacity 0.15s ease; }
    .stoke-btn-primary:active { transform: scale(0.97); opacity: 0.9; }
    .stoke-btn-secondary { transition: transform 0.15s ease, background 0.15s ease; }
    .stoke-btn-secondary:active { transform: scale(0.97); }
    .stoke-auth-input { transition: border-color 0.15s ease; }
    .stoke-auth-input:focus { outline: none; border-color: #256BFD !important; }

    /* Leaflet Dark Customizations */
    .leaflet-container {
      background: #0B0E14 !important;
      font-family: inherit !important;
    }
    .leaflet-control-attribution {
      display: none !important;
    }
    .stoke-runner-beacon {
      position: relative;
      width: 28px;
      height: 28px;
      pointer-events: none;
    }
    .stoke-runner-dot {
      position: absolute;
      top: 7px;
      left: 7px;
      width: 14px;
      height: 14px;
      background: #256BFD;
      border: 2.5px solid #0B0E13;
      border-radius: 50%;
      box-shadow: 0 0 14px rgba(37, 107, 253, 0.95);
      z-index: 2;
    }
    .stoke-runner-pulse {
      position: absolute;
      top: -2px;
      left: -2px;
      width: 32px;
      height: 32px;
      background: rgba(37, 107, 253, 0.35);
      border-radius: 50%;
      animation: stokeBeaconPulse 2s infinite ease-out;
      z-index: 1;
    }
    .stoke-runner-beam {
      position: absolute;
      top: -22px;
      left: -2px;
      width: 32px;
      height: 30px;
      background: radial-gradient(circle at 50% 100%, rgba(37, 107, 253, 0.55) 0%, rgba(37, 107, 253, 0) 75%);
      clip-path: polygon(50% 100%, 0% 0%, 100% 0%);
      pointer-events: none;
    }
    @keyframes stokeBeaconPulse {
      0% { transform: scale(0.6); opacity: 0.9; }
      100% { transform: scale(2.2); opacity: 0; }
    }
    @keyframes stokeSwoosh {
      0% { transform: scale(0.7) translateY(40px); opacity: 0; }
      60% { transform: scale(1.05) translateY(-5px); opacity: 1; }
      100% { transform: scale(1) translateY(0); opacity: 1; }
    }
    @keyframes stokeSparkle {
      0%, 100% { transform: scale(0.8) rotate(0deg); opacity: 0.6; }
      50% { transform: scale(1.2) rotate(15deg); opacity: 1; }
    }
    @keyframes stokeLaserScan {
      0% { top: 4px; opacity: 0.3; }
      50% { top: calc(100% - 8px); opacity: 0.95; }
      100% { top: 4px; opacity: 0.3; }
    }
    @keyframes stokeMicPulse {
      0% { transform: scale(1); box-shadow: 0 0 0 0 rgba(37, 107, 253, 0.7); }
      70% { transform: scale(1.08); box-shadow: 0 0 0 16px rgba(37, 107, 253, 0); }
      100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(37, 107, 253, 0); }
    }
    @keyframes stokeConfettiPop {
      0% { transform: scale(0.6) translateY(20px); opacity: 0; }
      50% { transform: scale(1.1) translateY(-6px); opacity: 1; }
      100% { transform: scale(1) translateY(0); opacity: 1; }
    }
  </style>
</head>
<body>
  <div id="root"></div>
  <div id="stoke-fatal-error" style="display:none; position:fixed; inset:0; z-index:9999999; background:#0B0E14; color:#FF5252; padding:24px; font-family:monospace; font-size:14px; overflow:auto; white-space:pre-wrap; border:3px solid #256BFD;"></div>

  <script>
    function reportAppError(title, err) {
      var str = (err && err.stack ? err.stack : String(err));
      if (!str || str.indexOf('[BABEL]') !== -1 || str.indexOf('deoptimised') !== -1) {
        return; // Ignore harmless Babel formatting notes
      }
      var box = document.getElementById('stoke-fatal-error');
      if (box) {
        box.style.display = 'block';
        box.innerHTML += '<h3>' + title + '</h3>' + str + '\n\n';
      }
    }
    window.addEventListener('error', function(e) {
      if (e.message && (e.message.indexOf('[BABEL]') !== -1 || e.message.indexOf('deoptimised') !== -1)) return;
      reportAppError('Window Error (' + e.filename + ':' + e.lineno + ':' + e.colno + ')', e.message || e.error);
    });
  </script>

  <script src="react.min.js"></script>
  <script src="react-dom.min.js"></script>
  <script src="babel.min.js"></script>
  <script src="supabase.min.js"></script>
  <script src="supabase_client.js"></script>
  <script src="exercise_database.js"></script>
  <script src="exercise_youtube_database.js"></script>

  <script type="text/babel" data-presets="react" data-compact="true">
const { useState, useRef, useEffect } = React;

const TOKENS = {
  bg: "#000000",
  surface: "rgba(20,20,20,0.7)",
  surface2: "rgba(32,32,32,0.65)",
  border: "rgba(255,255,255,0.1)",
  text: "#F5F5F5",
  muted: "#9A9A9A",
  mutedFaint: "#666666",
  ember: "#256BFD",
  protein: "#2DD4BF",
  carbs: "#4A7DFF",
  fat: "#FF8A3D",
  fiber: "#6FCB4F",
  water: "#3DDCFF",
  teal: "#2DD4BF",
};

const DEFAULT_PROFILE = { name: "", weightKg: 70, heightCm: 175, age: 28, sex: "male", goalType: "maintain", activity: 1.55 };

function computeGoals(profile) {
  const { weightKg, heightCm, age, sex, goalType, activity } = profile;
  const bmr = sex === "female"
    ? 10 * weightKg + 6.25 * heightCm - 5 * age - 161
    : 10 * weightKg + 6.25 * heightCm - 5 * age + 5;
  const tdee = bmr * (activity || 1.55);
  const calculatedCal = Math.round(goalType === "cut" ? tdee - 500 : goalType === "gain" ? tdee + 300 : tdee);
  const calories = profile.customCalories ? Number(profile.customCalories) : calculatedCal;
  const protein = profile.customProtein ? Number(profile.customProtein) : Math.round(weightKg * (goalType === "cut" ? 2.0 : 1.8));
  const fat = profile.customFat ? Number(profile.customFat) : Math.round((calories * 0.25) / 9);
  const carbs = profile.customCarbs ? Number(profile.customCarbs) : Math.max(0, Math.round((calories - protein * 4 - fat * 9) / 4));
  const fiber = Math.round((calories / 1000) * 14);
  const water = profile.customWater ? Number(profile.customWater) : (Math.round(((weightKg * 0.033) + 0.3) * 10) / 10);
  return { calories, protein, carbs, fat, fiber, water };
}

