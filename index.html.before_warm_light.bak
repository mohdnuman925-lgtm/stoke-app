                  {activeModal === "profile" && "Athlete Biometrics & Profile"}
                  {activeModal === "weight" && "Weight & Body Telemetry"}
                  {activeModal === "goals" && "Daily Target Strategy & Macros"}
                  {activeModal === "fasting" && "Intermittent Fasting"}
                  {activeModal === "sleep" && "Sleep Recovery Analysis"}
                  {activeModal === "steps" && "Daily Step Tracker"}
                  {activeModal === "devices" && "Connected Health Sensors"}
                  {activeModal === "reminders" && "Notification Schedules"}
                  {activeModal === "premium" && "STOKE Pro Elite Pass"}
                  {activeModal === "settings" && "App Settings & Units"}
                  {activeModal === "privacy" && "Biometric Data Security"}
                </h2>
              </div>
              <button
