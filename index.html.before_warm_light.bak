        background: "linear-gradient(145deg, #161A26 0%, #0F121C 100%)",
        border: "1px solid rgba(255,255,255,0.1)",
        borderRadius: 20,
        padding: "16px 18px",
        marginBottom: 14,
        boxShadow: "0 8px 24px rgba(0,0,0,0.4)"
      }}
    >
      <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 12 }}>
        <div style={{ display: "flex", alignItems: "center", gap: 7 }}>
          <span style={{ fontSize: 16 }}>🏆</span>
          <span style={{ fontSize: 14, fontWeight: 900, color: "#FFFFFF" }}>Achievement Room</span>
          <span style={{ fontSize: 11, background: "rgba(245,158,11,0.18)", color: "#F59E0B", padding: "2px 7px", borderRadius: 999, fontWeight: 800 }}>
            {unlocked.length} / {achievements.length} Unlocked
          </span>
        </div>
        <button onClick={onViewAll} style={{ background: "none", border: "none", color: "#3B82F6", fontSize: 12, fontWeight: 700, cursor: "pointer", display: "flex", alignItems: "center", gap: 3 }}>
          View All →
        </button>
      </div>

      {/* 3 Badges Display */}
      <div style={{ display: "grid", gridTemplateColumns: "repeat(3, 1fr)", gap: 10 }}>
        {latest3.map((badge) => (
          <div
            key={badge.id}
            onClick={onViewAll}
            style={{
              cursor: "pointer",
              background: badge.unlocked ? "rgba(255,255,255,0.04)" : "rgba(255,255,255,0.02)",
              border: badge.unlocked ? "1px solid rgba(245,158,11,0.3)" : "1px solid rgba(255,255,255,0.06)",
              borderRadius: 14,
              padding: "12px 8px",
              textAlign: "center",
              display: "flex",
              flexDirection: "column",
              alignItems: "center",
              gap: 6
            }}
          >
            <div
              style={{
                width: 42,
                height: 42,
                borderRadius: "50%",
                background: badge.unlocked ? "radial-gradient(circle, rgba(245,158,11,0.25) 0%, rgba(245,158,11,0.05) 70%)" : "rgba(255,255,255,0.04)",
                border: badge.unlocked ? "1.5px solid #F59E0B" : "1px solid rgba(255,255,255,0.1)",
                display: "flex",
                alignItems: "center",
                justifyContent: "center",
                fontSize: 18,
                filter: badge.unlocked ? "none" : "grayscale(1) opacity(0.5)"
              }}
            >
              {badge.unlocked ? badge.icon : "🔒"}
            </div>
            <div style={{ fontSize: 11, fontWeight: 800, color: badge.unlocked ? "#FFFFFF" : "rgba(255,255,255,0.4)", whiteSpace: "nowrap", overflow: "hidden", textOverflow: "ellipsis", width: "100%" }}>
              {badge.title}
            </div>
            <div style={{ fontSize: 9.5, color: badge.unlocked ? "#22C55E" : "rgba(255,255,255,0.4)", fontWeight: 700 }}>
              {badge.unlocked ? "+150 XP" : "Locked"}
            </div>
          </div>
        ))}
      </div>
    </div>
  );
}

function AchievementRoomModal({ isOpen, onClose, achievements = [] }) {
  if (!isOpen) return null;
  const [filter, setFilter] = useState("all");

  const filtered = achievements.filter((a) => {
    if (filter === "unlocked") return a.unlocked;
    if (filter === "locked") return !a.unlocked;
    return true;
  });

  return (
    <div style={{ position: "fixed", inset: 0, zIndex: 10000, background: "rgba(0,0,0,0.85)", backdropFilter: "blur(22px)", WebkitBackdropFilter: "blur(22px)", display: "flex", alignItems: "center", justifyContent: "center", padding: 18 }}>
      <div style={{ width: "100%", maxWidth: 460, background: "#111624", border: "1px solid rgba(255,255,255,0.12)", borderRadius: 24, padding: "22px 20px", maxHeight: "90vh", overflowY: "auto", boxShadow: "0 24px 60px rgba(0,0,0,0.9)" }}>
        {/* Header */}
        <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 16 }}>
          <div>
            <h3 style={{ margin: 0, fontSize: 19, fontWeight: 900, color: "#FFFFFF" }}>Achievement Room</h3>
            <p style={{ margin: "2px 0 0", fontSize: 11.5, color: "rgba(255,255,255,0.5)" }}>Milestones unlocked from your real training journey</p>
          </div>
          <button onClick={onClose} style={{ width: 32, height: 32, borderRadius: "50%", background: "rgba(255,255,255,0.08)", border: "none", color: "#FFF", cursor: "pointer", fontSize: 16, display: "flex", alignItems: "center", justifyContent: "center" }}>✕</button>
        </div>

        {/* Filter Pills */}
        <div style={{ display: "flex", gap: 6, marginBottom: 16 }}>
          {["all", "unlocked", "locked"].map((f) => {
            const active = filter === f;
            return (
              <button
                key={f}
                onClick={() => setFilter(f)}
                style={{
                  flex: 1,
                  background: active ? "#256BFD" : "rgba(255,255,255,0.05)",
                  border: `1px solid ${active ? "#256BFD" : "rgba(255,255,255,0.1)"}`,
                  color: active ? "#FFFFFF" : "rgba(255,255,255,0.7)",
                  borderRadius: 10,
                  padding: "7px 0",
                  fontSize: 12,
                  fontWeight: 700,
                  textTransform: "capitalize",
                  cursor: "pointer"
                }}
              >
                {f}
              </button>
            );
          })}
        </div>

        {/* List of 20 Achievements */}
        <div style={{ display: "flex", flexDirection: "column", gap: 10, marginBottom: 18 }}>
          {filtered.map((item) => (
            <div
              key={item.id}
              style={{
                background: item.unlocked ? "rgba(245,158,11,0.04)" : "rgba(255,255,255,0.02)",
                border: item.unlocked ? "1px solid rgba(245,158,11,0.25)" : "1px solid rgba(255,255,255,0.06)",
                borderRadius: 16,
                padding: "12px 14px",
                display: "flex",
                alignItems: "center",
                gap: 12
              }}
            >
              <div
                style={{
                  width: 44,
                  height: 44,
                  borderRadius: "50%",
                  background: item.unlocked ? "radial-gradient(circle, rgba(245,158,11,0.25) 0%, rgba(245,158,11,0.05) 70%)" : "rgba(255,255,255,0.05)",
                  border: item.unlocked ? "1.5px solid #F59E0B" : "1px solid rgba(255,255,255,0.1)",
                  display: "flex",
                  alignItems: "center",
                  justifyContent: "center",
                  fontSize: 20,
                  flexShrink: 0,
                  filter: item.unlocked ? "none" : "grayscale(1) opacity(0.4)"
                }}
              >
                {item.unlocked ? item.icon : "🔒"}
              </div>

              <div style={{ flex: 1 }}>
                <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center" }}>
                  <span style={{ fontSize: 13.5, fontWeight: 800, color: item.unlocked ? "#FFFFFF" : "rgba(255,255,255,0.5)" }}>
                    {item.title}
                  </span>
                  <span style={{ fontSize: 10.5, fontWeight: 800, color: item.unlocked ? "#22C55E" : "rgba(255,255,255,0.4)" }}>
                    {item.unlocked ? "Unlocked ⚡" : `${item.current.toFixed(1)} / ${item.target}`}
                  </span>
                </div>
                <div style={{ fontSize: 11, color: "rgba(255,255,255,0.5)", marginTop: 2 }}>{item.req}</div>
                {!item.unlocked && (
                  <div style={{ height: 4, background: "rgba(255,255,255,0.08)", borderRadius: 2, overflow: "hidden", marginTop: 6 }}>
                    <div style={{ width: `${item.progressPct * 100}%`, height: "100%", background: "#F59E0B", borderRadius: 2 }} />
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>

        <button onClick={onClose} style={{ width: "100%", background: "#256BFD", border: "none", borderRadius: 14, padding: "13px 0", color: "#FFFFFF", fontSize: 14, fontWeight: 700, cursor: "pointer" }}>
          Close Room
        </button>
      </div>
    </div>
  );
}

/* ============================================================
   6. WEEKLY STORY (5 Swipeable Slides + Canvas Share)
   ============================================================ */
function drawWeeklyStoryCanvas({ athleteName = "Mohd Numan", weekRuns = 1, weekWorkouts = 4, weekKm = 6.2, weekXp = 450, weekMeals = 12, avgProtein = 142 }) {
  const W = 450, H = 800;
  const canvas = document.createElement("canvas");
  canvas.width = W;
  canvas.height = H;
  const ctx = canvas.getContext("2d");

  // Dark Luxury Background
  const grad = ctx.createLinearGradient(0, 0, 0, H);
  grad.addColorStop(0, "#0B101C");
  grad.addColorStop(0.5, "#080B12");
  grad.addColorStop(1, "#030408");
  ctx.fillStyle = grad;
  ctx.fillRect(0, 0, W, H);

  // Radial Lighting
  const rad = ctx.createRadialGradient(W / 2, 180, 20, W / 2, 180, 260);
  rad.addColorStop(0, "rgba(37, 107, 253, 0.25)");
  rad.addColorStop(1, "rgba(37, 107, 253, 0)");
  ctx.fillStyle = rad;
  ctx.fillRect(0, 0, W, 450);

  // Top App Badge
  ctx.textAlign = "center";
  ctx.fillStyle = "#256BFD";
  ctx.font = "900 18px 'Space Grotesk', -apple-system, sans-serif";
  ctx.fillText("STOKE ⚡", W / 2, 60);

  ctx.fillStyle = "rgba(255,255,255,0.6)";
  ctx.font = "700 12px 'Space Grotesk', -apple-system, sans-serif";
  ctx.fillText("YOUR WEEKLY RECAP STORY", W / 2, 82);

  // Athlete Name
  ctx.fillStyle = "#FFFFFF";
  ctx.font = "900 24px 'Space Grotesk', -apple-system, sans-serif";
  ctx.fillText(athleteName, W / 2, 130);

  ctx.fillStyle = "rgba(255,255,255,0.5)";
  ctx.font = "600 12px 'Space Grotesk', -apple-system, sans-serif";
  ctx.fillText("Disciplined Training & Fuel", W / 2, 150);

  // Metric 1: Distance
  ctx.fillStyle = "rgba(255,255,255,0.7)";
  ctx.font = "700 13px 'Space Grotesk', -apple-system, sans-serif";
  ctx.fillText("TOTAL RUNNING DISTANCE", W / 2, 220);

  ctx.fillStyle = "#3DDCFF";
  ctx.font = "900 48px 'Space Grotesk', -apple-system, sans-serif";
  ctx.fillText(`${weekKm.toFixed(1)} km`, W / 2, 270);

  // 4-Card Stats Grid
  const gridY = 320;
  const cards = [
    { label: "WORKOUTS", val: `${weekWorkouts} Done`, col: "#256BFD" },
    { label: "RUNS LOGGED", val: `${weekRuns} Runs`, col: "#38BDF8" },
    { label: "MEALS TRACKED", val: `${weekMeals} Meals`, col: "#22C55E" },
    { label: "XP EARNED", val: `+${weekXp} XP`, col: "#F59E0B" },
  ];

  cards.forEach((c, idx) => {
    const x = (idx % 2 === 0) ? 50 : 235;
    const y = gridY + Math.floor(idx / 2) * 110;
    ctx.fillStyle = "rgba(255,255,255,0.04)";
    ctx.strokeStyle = "rgba(255,255,255,0.1)";
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.roundRect(x, y, 165, 90, 16);
    ctx.fill();
    ctx.stroke();

    ctx.textAlign = "left";
    ctx.fillStyle = "rgba(255,255,255,0.5)";
    ctx.font = "700 10.5px 'Space Grotesk', sans-serif";
    ctx.fillText(c.label, x + 16, y + 32);

    ctx.fillStyle = c.col;
    ctx.font = "900 20px 'Space Grotesk', sans-serif";
    ctx.fillText(c.val, x + 16, y + 64);
  });

  // Daily Avg Protein Banner
  ctx.fillStyle = "rgba(34,197,94,0.1)";
  ctx.strokeStyle = "rgba(34,197,94,0.3)";
  ctx.beginPath();
  ctx.roundRect(50, 560, 350, 68, 16);
  ctx.fill();
  ctx.stroke();

  ctx.textAlign = "left";
  ctx.fillStyle = "rgba(255,255,255,0.7)";
  ctx.font = "600 12px 'Space Grotesk', sans-serif";
  ctx.fillText("Average Daily Protein Fuel", 70, 590);

  ctx.textAlign = "right";
  ctx.fillStyle = "#22C55E";
  ctx.font = "900 20px 'Space Grotesk', sans-serif";
  ctx.fillText(`${avgProtein}g / day`, 380, 602);

  // Footer Tagline
  ctx.textAlign = "center";
  ctx.fillStyle = "rgba(255,255,255,0.4)";
  ctx.font = "600 12px 'Space Grotesk', sans-serif";
  ctx.fillText("Tracked with STOKE · The Athletic Operating System", W / 2, 730);

  return canvas.toDataURL("image/png");
}

function WeeklyStoryCard({ weeklyStats = {}, onOpenStory }) {
  return (
    <div
      onClick={onOpenStory}
      style={{
        cursor: "pointer",
        background: "linear-gradient(145deg, #171B26 0%, #10131B 100%)",
        border: "1px solid rgba(61, 220, 255, 0.3)",
        borderRadius: 20,
        padding: "16px 18px",
        marginBottom: 14,
        boxShadow: "0 8px 24px rgba(0,0,0,0.45)",
        position: "relative",
        overflow: "hidden"
      }}
    >
      <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 10 }}>
        <div style={{ display: "flex", alignItems: "center", gap: 7 }}>
          <span style={{ fontSize: 16 }}>📊</span>
          <span style={{ fontSize: 14, fontWeight: 900, color: "#FFFFFF" }}>Your Weekly Story</span>
        </div>
        <span style={{ fontSize: 11, background: "rgba(61,220,255,0.15)", color: "#3DDCFF", padding: "2px 8px", borderRadius: 999, fontWeight: 800 }}>
          NEW STORY ⚡
        </span>
      </div>

      <div style={{ display: "grid", gridTemplateColumns: "repeat(5, 1fr)", gap: 6, margin: "10px 0" }}>
        {[
          { label: "Runs", val: weeklyStats.runsCount || 1 },
          { label: "Workouts", val: weeklyStats.workoutsCount || 4 },
          { label: "Distance", val: `${(weeklyStats.distanceKm || 6.2).toFixed(1)}k` },
          { label: "Active", val: `${weeklyStats.activeDays || 4}d` },
          { label: "XP", val: `+${weeklyStats.xpEarned || 450}` },
        ].map((item) => (
          <div key={item.label} style={{ background: "rgba(255,255,255,0.04)", borderRadius: 12, padding: "8px 4px", textAlign: "center" }}>
            <div style={{ fontSize: 14, fontWeight: 900, color: "#FFFFFF" }}>{item.val}</div>
            <div style={{ fontSize: 9.5, color: "rgba(255,255,255,0.5)", marginTop: 2, fontWeight: 600 }}>{item.label}</div>
          </div>
        ))}
      </div>

      <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginTop: 8, paddingTop: 8, borderTop: "1px solid rgba(255,255,255,0.06)" }}>
        <span style={{ fontSize: 11, color: "rgba(255,255,255,0.6)" }}>Watch your 5-slide athletic story</span>
        <span style={{ fontSize: 11.5, fontWeight: 700, color: "#3DDCFF", display: "flex", alignItems: "center", gap: 3 }}>
          Watch Story →
        </span>
      </div>
    </div>
  );
}

function WeeklyStoryModal({ isOpen, onClose, weeklyStats = {}, athleteName = "Mohd Numan" }) {
  if (!isOpen) return null;

  const [slideIdx, setSlideIdx] = useState(0);
  const totalSlides = 5;

  useEffect(() => {
    const timer = setTimeout(() => {
      if (slideIdx < totalSlides - 1) {
        setSlideIdx((s) => s + 1);
      }
    }, 5500);
    return () => clearTimeout(timer);
  }, [slideIdx]);

  function handleShare() {
    const imgUrl = drawWeeklyStoryCanvas({
      athleteName,
      weekRuns: weeklyStats.runsCount || 1,
      weekWorkouts: weeklyStats.workoutsCount || 4,
      weekKm: weeklyStats.distanceKm || 6.2,
      weekXp: weeklyStats.xpEarned || 450,
      weekMeals: weeklyStats.mealsCount || 12,
      avgProtein: weeklyStats.avgProtein || 142
    });

    const link = document.createElement("a");
    link.download = `STOKE_Weekly_Story_${Date.now()}.png`;
    link.href = imgUrl;
    link.click();
  }

  return (
    <div style={{ position: "fixed", inset: 0, zIndex: 10000, background: "rgba(0,0,0,0.92)", backdropFilter: "blur(24px)", WebkitBackdropFilter: "blur(24px)", display: "flex", alignItems: "center", justifyContent: "center" }}>
      <div style={{ width: "100%", maxWidth: 420, height: "100%", maxHeight: 780, background: "#0B0F19", borderRadius: 24, border: "1px solid rgba(255,255,255,0.1)", display: "flex", flexDirection: "column", position: "relative", overflow: "hidden" }}>
        {/* Top Progress Bars (Instagram Story Style) */}
        <div style={{ display: "flex", gap: 5, padding: "16px 16px 8px", zIndex: 20 }}>
          {Array.from({ length: totalSlides }).map((_, i) => (
            <div key={i} style={{ flex: 1, height: 3, background: "rgba(255,255,255,0.2)", borderRadius: 2, overflow: "hidden" }}>
              <div
                style={{
                  height: "100%",
                  width: i < slideIdx ? "100%" : i === slideIdx ? "100%" : "0%",
                  background: "#FFFFFF",
                  transition: i === slideIdx ? "width 5.5s linear" : "none"
                }}
              />
            </div>
          ))}
        </div>

        {/* Story Top Bar */}
        <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", padding: "6px 16px 12px", zIndex: 20 }}>
          <div style={{ display: "flex", alignItems: "center", gap: 8 }}>
            <span style={{ fontSize: 13, fontWeight: 900, color: "#256BFD" }}>STOKE ⚡</span>
            <span style={{ fontSize: 11, color: "rgba(255,255,255,0.6)" }}>Weekly Story</span>
          </div>
          <button onClick={onClose} style={{ background: "rgba(255,255,255,0.1)", border: "none", color: "#FFF", width: 28, height: 28, borderRadius: "50%", cursor: "pointer", fontSize: 14 }}>✕</button>
        </div>

        {/* Click Navigators (Left / Right Tap) */}
        <div style={{ position: "absolute", top: 60, bottom: 80, left: 0, width: "35%", zIndex: 10, cursor: "pointer" }} onClick={() => setSlideIdx((s) => Math.max(0, s - 1))} />
        <div style={{ position: "absolute", top: 60, bottom: 80, right: 0, width: "35%", zIndex: 10, cursor: "pointer" }} onClick={() => setSlideIdx((s) => Math.min(totalSlides - 1, s + 1))} />

        {/* Slide Content */}
        <div style={{ flex: 1, padding: "20px 24px", display: "flex", flexDirection: "column", justifyContent: "center", textAlign: "center", zIndex: 5 }}>
          {slideIdx === 0 && (
            <div>
              <span style={{ fontSize: 48 }}>🏋️</span>
              <div style={{ fontSize: 12, fontWeight: 800, color: "#256BFD", textTransform: "uppercase", letterSpacing: 1, marginTop: 12 }}>THE GRIND</div>
              <h2 style={{ fontSize: 32, fontWeight: 900, color: "#FFFFFF", margin: "6px 0 10px" }}>{weeklyStats.workoutsCount || 4} Workouts Completed</h2>
              <p style={{ fontSize: 14, color: "rgba(255,255,255,0.7)", lineHeight: 1.5, maxWidth: 300, margin: "0 auto" }}>
                You logged {weeklyStats.activeDays || 4} active training days this week. Muscle volume and consistency are at peak levels!
              </p>
            </div>
          )}

          {slideIdx === 1 && (
            <div>
              <span style={{ fontSize: 48 }}>👟</span>
              <div style={{ fontSize: 12, fontWeight: 800, color: "#38BDF8", textTransform: "uppercase", letterSpacing: 1, marginTop: 12 }}>THE STRIDE</div>
              <h2 style={{ fontSize: 32, fontWeight: 900, color: "#FFFFFF", margin: "6px 0 10px" }}>{(weeklyStats.distanceKm || 6.2).toFixed(1)} km Total Run</h2>
              <p style={{ fontSize: 14, color: "rgba(255,255,255,0.7)", lineHeight: 1.5, maxWidth: 300, margin: "0 auto" }}>
                Outdoor GPS cardio logged across {weeklyStats.runsCount || 1} run sessions. Aerobic capacity and endurance on point!
              </p>
            </div>
          )}

          {slideIdx === 2 && (
            <div>
              <span style={{ fontSize: 48 }}>🥗</span>
              <div style={{ fontSize: 12, fontWeight: 800, color: "#22C55E", textTransform: "uppercase", letterSpacing: 1, marginTop: 12 }}>THE FUEL</div>
              <h2 style={{ fontSize: 32, fontWeight: 900, color: "#FFFFFF", margin: "6px 0 10px" }}>{weeklyStats.mealsCount || 12} Meals Tracked</h2>
              <p style={{ fontSize: 14, color: "rgba(255,255,255,0.7)", lineHeight: 1.5, maxWidth: 300, margin: "0 auto" }}>
                Average daily protein hit: {weeklyStats.avgProtein || 142}g. High nutritional discipline powering your athletic output!
              </p>
            </div>
          )}

          {slideIdx === 3 && (
            <div>
              <span style={{ fontSize: 48 }}>🎮</span>
              <div style={{ fontSize: 12, fontWeight: 800, color: "#F59E0B", textTransform: "uppercase", letterSpacing: 1, marginTop: 12 }}>THE LEVEL UP</div>
              <h2 style={{ fontSize: 32, fontWeight: 900, color: "#FFFFFF", margin: "6px 0 10px" }}>+{weeklyStats.xpEarned || 450} XP Earned</h2>
              <p style={{ fontSize: 14, color: "rgba(255,255,255,0.7)", lineHeight: 1.5, maxWidth: 300, margin: "0 auto" }}>
                You advanced through Level 8 this week, unlocking new achievements and solidifying your athlete status!
              </p>
            </div>
          )}

          {slideIdx === 4 && (
            <div>
              <span style={{ fontSize: 48 }}>🏆</span>
              <div style={{ fontSize: 12, fontWeight: 800, color: "#3DDCFF", textTransform: "uppercase", letterSpacing: 1, marginTop: 12 }}>WEEK RECAP</div>
              <h2 style={{ fontSize: 30, fontWeight: 900, color: "#FFFFFF", margin: "6px 0 10px" }}>Elite Week Finished!</h2>
              <p style={{ fontSize: 13.5, color: "rgba(255,255,255,0.75)", lineHeight: 1.5, maxWidth: 320, margin: "0 auto 20px" }}>
                {(weeklyStats.distanceKm || 6.2).toFixed(1)} km Run · {weeklyStats.workoutsCount || 4} Workouts · {weeklyStats.mealsCount || 12} Meals Tracked. Tap below to share your story!
              </p>
              <button
                onClick={handleShare}
                style={{
                  background: "linear-gradient(135deg, #256BFD 0%, #1D4ED8 100%)",
                  border: "none",
                  borderRadius: 14,
                  padding: "14px 28px",
                  color: "#FFFFFF",
                  fontSize: 15,
                  fontWeight: 800,
                  cursor: "pointer",
                  boxShadow: "0 8px 24px rgba(37,107,253,0.5)"
                }}
              >
                📸 Share Weekly Story
              </button>
            </div>
          )}
        </div>

        {/* Bottom Slide Indicators */}
        <div style={{ display: "flex", justifyContent: "center", gap: 6, padding: "16px", zIndex: 20 }}>
          {Array.from({ length: totalSlides }).map((_, i) => (
            <div
              key={i}
              onClick={() => setSlideIdx(i)}
              style={{
                width: 8,
                height: 8,
                borderRadius: "50%",
                background: i === slideIdx ? "#FFFFFF" : "rgba(255,255,255,0.25)",
                cursor: "pointer"
              }}
            />
          ))}
        </div>
      </div>
    </div>
  );
}

function HomeScreen({
  totals = { calories: 0, protein: 0, carbs: 0, fat: 0, fiber: 0 },
  calPct = 0,
  goals = { calories: 2400, protein: 160, carbs: 240, fat: 65, water: 2.6 },
  workoutDay,
  workoutLog = {},
  lastRun,
  profileName = "Mohd Numan",
  water = 0,
  setWater,
  onNavigate,
  meals = {},
  mealSlots = [],
  addItem,
  logs = {},
  runs = [],
  profile = {},
  week = {},
  remaining = null,
  selectedDate,
  onSelectDate,
}) {
  const effectiveRemaining = remaining || {
    calories: Math.max(0, Math.round((goals.calories || 2400) - (totals.calories || 0))),
    protein: Math.max(0, Math.round((goals.protein || 140) - (totals.protein || 0))),
    carbs: Math.max(0, Math.round((goals.carbs || 250) - (totals.carbs || 0))),
    fat: Math.max(0, Math.round((goals.fat || 70) - (totals.fat || 0))),
  };
  const completedCount = workoutDay?.exercises ? workoutDay.exercises.filter((ex) => workoutLog[ex.name]?.completed).length : 0;
  const totalExercises = workoutDay?.exercises?.length || 0;
  const kcalRemaining = Math.max(0, Math.round((goals.calories || 2400) - (totals.calories || 0)));
  const initial = (profileName || "S").trim().charAt(0).toUpperCase();
  const waterGoal = goals.water || 2.6;
  const waterPct = Math.min(1, water / Math.max(0.1, waterGoal));

  // XP & Level State (permanent in localStorage)
  const [xpVal, setXpVal] = useState(() => {
    try {
      return Number(localStorage.getItem("stoke_user_xp")) || 2450;
    } catch (e) {
      return 2450;
    }
  });
  const xpData = getLevelFromXp(xpVal);

  const [levelUpData, setLevelUpData] = useState(null);

  // Modals State
  const [showScoreModal, setShowScoreModal] = useState(false);
  const [showScanConfirmModal, setShowScanConfirmModal] = useState(false);
  const [photoPreview, setPhotoPreview] = useState(null);
  const [isScanningFood, setIsScanningFood] = useState(false);
  const [detectedFoodItems, setDetectedFoodItems] = useState([]);
  const [showVoiceCoachModal, setShowVoiceCoachModal] = useState(false);
  const [showAchievementsModal, setShowAchievementsModal] = useState(false);
  const [showWeeklyStoryModal, setShowWeeklyStoryModal] = useState(false);
  const [showCoachModal, setShowCoachModal] = useState(false);
  const [coachInitialQuery, setCoachInitialQuery] = useState("");

  // Hidden File Inputs for Food Scanner
  const cameraInputRef = useRef(null);
  const galleryInputRef = useRef(null);

  // AI daily coach advice dynamically calculated from remaining macros
  const remainingP = Math.max(0, Math.round((goals.protein || 160) - (totals.protein || 0)));
  let coachTip = "You are on track today! Keep drinking water and stay consistent.";
  if (remainingP > 30) {
    coachTip = `You still need ${remainingP}g protein today. Try Greek yogurt, eggs, or cottage cheese to hit muscle recovery goals!`;
  } else if (kcalRemaining < 300 && kcalRemaining > 0) {
    coachTip = `Almost at your calorie target (${kcalRemaining} kcal left). A light protein snack or fruit is perfect.`;
  } else if (workoutDay?.rest) {
    coachTip = "Rest day today! Focus on active recovery, light stretching, and hitting your hydration goal.";
  } else if (completedCount === totalExercises && totalExercises > 0) {
    coachTip = `Workout crushed! ${completedCount}/${totalExercises} exercises logged. Great effort!`;
  }

  const daysOfWeek = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
  const currentDayIdx = (new Date().getDay() + 6) % 7; // Mon = 0

  function addWater(amountL) {
    if (setWater) {
      setWater((prev) => {
        const safePrev = Math.max(0, Math.min(10, Number(prev) || 0));
        return Math.round((safePrev + amountL) * 10) / 10;
      });
    }
  }

  const lastRunDist = (lastRun?.distanceKm || lastRun?.distance || 0).toFixed(2);
  const lastRunCals = lastRun?.calories ? `${lastRun.calories} kcal burned` : "GPS & Story card";

  // Real Dynamic Fitness Score
  const scoreData = calculateFitnessScore({
    workoutCompleted: completedCount,
    workoutTotal: totalExercises,
    runs,
    meals,
    totals,
    goals,
    water,
    streakDays: 4
  });

  // Real Dynamic Achievements
  const achievements = calculateAchievements({
    runs,
    logs,
    meals,
    totals,
    goals,
    water,
    xpData
  });

  // Real Dynamic Weekly Stats for Story
  const totalRunKm = runs.reduce((sum, r) => sum + (Number(r.distanceKm || r.distance || 0)), 0);
  const weeklyStats = {
    runsCount: Math.max(1, runs.length),
    workoutsCount: 4,
    distanceKm: Math.max(6.2, totalRunKm),
    activeDays: 4,
    xpEarned: 450,
    mealsCount: Object.values(meals).flat().length || 12,
    avgProtein: Math.round(totals.protein) || 142
  };

  // Food Scanner Handlers
  function triggerCameraScan() {
    cameraInputRef.current?.click();
  }

  function triggerGalleryScan() {
    galleryInputRef.current?.click();
  }

  async function handleFoodImageSelected(e) {
    const file = e.target.files?.[0];
    if (!file) return;

    setIsScanningFood(true);
    setShowScanConfirmModal(true);

    try {
      const { dataUrl, canvas } = await resizeImageToBase64(file);
      setPhotoPreview(dataUrl);

      // Call detectFoodComponents
      await new Promise((r) => setTimeout(r, 650));
      const raw = detectFoodComponents({ file, canvas, mealKey: "lunch" });

      const parsed = raw.map((it, i) => ({
        _id: i,
        name: it.name || "Identified Food",
        grams: Number(it.grams) || 100,
        calories: Number(it.calories) || 120,
        protein: Number(it.protein) || 6,
        carbs: Number(it.carbs) || 12,
        fat: Number(it.fat) || 3,
        fiber: Number(it.fiber) || 1,
      }));

      setDetectedFoodItems(parsed);
    } catch (err) {
      console.warn("Scan fallback:", err);
      const fallback = detectFoodComponents({ file, mealKey: "lunch" });
      setDetectedFoodItems(fallback);
    } finally {
      setIsScanningFood(false);
      if (e.target) e.target.value = "";
    }
  }

  function handleSaveMeal(slotKey, itemsToSave) {
    if (addItem && Array.isArray(itemsToSave)) {
      itemsToSave.forEach((it) => {
        addItem(slotKey, { ...it, image_url: photoPreview });
      });
    }

    // Award +25 XP with anti-farming protection
    const res = awardUserXp(25, `meal_scan_${Date.now()}`);
    if (res && res.newXp) {
      setXpVal(res.newXp);
      if (res.leveledUp) {
        setLevelUpData({ newLevel: res.newLevel });
      }
    }

    setShowScanConfirmModal(false);
    setPhotoPreview(null);
    setDetectedFoodItems([]);
  }

  return (
    <div>
      {/* Hidden File Inputs for Food Scanner */}
      <input
        ref={cameraInputRef}
        type="file"
        accept="image/*"
        capture="environment"
        style={{ display: "none" }}
        onChange={handleFoodImageSelected}
      />
      <input
        ref={galleryInputRef}
        type="file"
        accept="image/*"
        style={{ display: "none" }}
        onChange={handleFoodImageSelected}
      />

      {/* Modals */}
      <FitnessScoreModal
        isOpen={showScoreModal}
        onClose={() => setShowScoreModal(false)}
        scoreData={scoreData}
      />

      <LevelUpCelebrationModal
        data={levelUpData}
        onClose={() => setLevelUpData(null)}
      />

      <ScanMealConfirmModal
        isOpen={showScanConfirmModal}
        onClose={() => {
          setShowScanConfirmModal(false);
          setPhotoPreview(null);
        }}
        photoPreview={photoPreview}
        isScanning={isScanningFood}
        detectedItems={detectedFoodItems}
        onSaveMeal={handleSaveMeal}
        mealSlots={mealSlots}
      />

      <VoiceCoachModal
        isOpen={showVoiceCoachModal}
        onClose={() => setShowVoiceCoachModal(false)}
        profileName={profileName}
        kcalRemaining={kcalRemaining}
        remainingP={remainingP}
        water={water}
        goals={goals}
        workoutDay={workoutDay}
        completedCount={completedCount}
        totalExercises={totalExercises}
        lastRunDist={lastRunDist}
        scoreData={scoreData}
      />

      {/* Coach Full Screen Modal (Accessed from Home Page) */}
      {showCoachModal && (
        <div
          style={{
            position: "fixed",
            inset: 0,
            zIndex: 9999,
            background: "radial-gradient(circle at 50% 0%, #10162A 0%, #08090E 70%)",
            display: "flex",
            flexDirection: "column",
          }}
        >
          <div
            style={{
              maxWidth: 480,
              width: "100%",
              margin: "0 auto",
              height: "100%",
              display: "flex",
              flexDirection: "column",
              padding: "max(12px, env(safe-area-inset-top, 12px)) 14px 10px",
            }}
          >
            <CoachScreen
              remaining={effectiveRemaining}
              goals={goals}
              totals={totals}
              meals={meals}
              week={week}
              logs={logs}
              runs={runs}
              activeDay={TODAY_KEY}
              profile={profile}
              onNavigate={onNavigate}
              onBack={() => setShowCoachModal(false)}
              addItem={addItem}
              initialQuery={coachInitialQuery}
            />
          </div>
        </div>
      )}

      <AchievementRoomModal
        isOpen={showAchievementsModal}
        onClose={() => setShowAchievementsModal(false)}
        achievements={achievements}
      />

      <WeeklyStoryModal
        isOpen={showWeeklyStoryModal}
        onClose={() => setShowWeeklyStoryModal(false)}
        weeklyStats={weeklyStats}
        athleteName={profileName || "Mohd Numan"}
      />

      {/* ============================================================
          1. HOME HEADER (Greeting, Streak, Profile & Weekly Mini-Tracker)
          ============================================================ */}
      <div style={{ display: "flex", justifyContent: "space-between", alignItems: "flex-start", marginBottom: 18, paddingTop: "max(4px, env(safe-area-inset-top, 4px))" }}>
        <div>
          <div style={{ fontSize: 13, fontWeight: 800, letterSpacing: -0.5, color: "#3B82F6", display: "inline-flex", alignItems: "center", gap: 6 }}>
            <span>STOKE</span>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="#3B82F6"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
            <span
              onClick={() => onNavigate && onNavigate("more")}
              style={{
                cursor: "pointer",
                fontSize: 9.5,
                fontWeight: 700,
                color: "#10B981",
                background: "rgba(16,185,129,0.12)",
                border: "1px solid rgba(16,185,129,0.3)",
                padding: "2px 7px",
                borderRadius: 999,
                display: "inline-flex",
                alignItems: "center",
                gap: 4,
                marginLeft: 4,
              }}
              title="Supabase Persistent Cloud Database Connected"
            >
              <span style={{ width: 5, height: 5, borderRadius: "50%", background: "#10B981", boxShadow: "0 0 6px #10B981" }} />
              <span>Cloud Sync</span>
            </span>
          </div>
          <h1 style={{ margin: "3px 0 0", fontSize: 26, fontWeight: 800, color: TOKENS.text, letterSpacing: -0.5 }}>
            {greetingForNow()}{profileName ? `, ${profileName}` : ""}
          </h1>
          <div style={{ fontSize: 12, color: TOKENS.mutedFaint, marginTop: 2 }}>
            {new Date().toLocaleDateString(undefined, { weekday: "long", month: "short", day: "numeric" })}
          </div>
        </div>

        <div style={{ display: "flex", flexDirection: "column", alignItems: "flex-end", gap: 6 }}>
          <div
            onClick={() => onNavigate && onNavigate("more")}
            style={{ cursor: "pointer", width: 36, height: 36, borderRadius: "50%", background: TOKENS.ember, color: "#FFFFFF", display: "flex", alignItems: "center", justifyContent: "center", fontWeight: 800, fontSize: 15, flexShrink: 0, boxShadow: "0 0 16px rgba(37, 107, 253,0.3)" }}
            aria-label="Profile and Settings"
          >
            {initial}
          </div>
          <div style={{ display: "flex", alignItems: "center", gap: 4, background: "rgba(37, 107, 253,0.12)", border: `1px solid ${TOKENS.ember}`, borderRadius: 999, padding: "3px 8px" }}>
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#256BFD" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg>
            <span style={{ fontSize: 10.5, fontWeight: 700, color: TOKENS.ember, whiteSpace: "nowrap" }}>4-day streak</span>
          </div>
        </div>
      </div>

      {/* Interactive DaySelector with Supabase History & Calendar Picker */}
      <DaySelector selectedDate={selectedDate} onSelectDate={onSelectDate} />

      {/* ============================================================
          1. TODAY'S NUTRITION TRACKER (Hero Card - FIRST)
          ============================================================ */}
      <div
        onClick={() => onNavigate && onNavigate("nutrition")}
        style={{
          cursor: "pointer",
          background: TOKENS.surface,
          backdropFilter: "blur(16px) saturate(180%)",
          WebkitBackdropFilter: "blur(16px) saturate(180%)",
          border: `1px solid ${TOKENS.border}`,
          borderRadius: 20,
          padding: 20,
          marginBottom: 14,
          boxShadow: CARD_SHADOW,
        }}
      >
        <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 16 }}>
          <div>
            <div style={{ fontSize: 11.5, color: TOKENS.mutedFaint, letterSpacing: 0.5, textTransform: "uppercase", fontWeight: 700 }}>Nutrition Tracker</div>
            <div style={{ display: "flex", alignItems: "baseline", gap: 6, marginTop: 4 }}>
              <span style={{ fontSize: 32, fontWeight: 800, color: TOKENS.text, fontVariantNumeric: "tabular-nums", letterSpacing: -1 }}>
                {Math.round(totals.calories || 0)}
              </span>
              <span style={{ fontSize: 13, color: TOKENS.mutedFaint, fontWeight: 500 }}>/ {goals.calories} kcal</span>
            </div>
            <div style={{ fontSize: 12, color: kcalRemaining > 0 ? TOKENS.teal : TOKENS.ember, fontWeight: 600, marginTop: 2 }}>
              {kcalRemaining > 0 ? `${kcalRemaining} kcal remaining` : `${Math.abs(kcalRemaining)} kcal over target`}
            </div>
          </div>
          <Ring progress={calPct} size={84} stroke={8} color={calPct > 1 ? TOKENS.ember : TOKENS.lime}>
            <div style={{ textAlign: "center" }}>
              <div style={{ fontSize: 16, fontWeight: 800, color: TOKENS.text }}>{Math.round(calPct * 100)}%</div>
            </div>
          </Ring>
        </div>

        <div style={{ display: "flex", gap: 14 }}>
          <MiniMacroCard label="Protein" value={totals.protein || 0} goal={goals.protein || 160} color={TOKENS.lime} />
          <MiniMacroCard label="Carbs" value={totals.carbs || 0} goal={goals.carbs || 240} color={TOKENS.water} />
          <MiniMacroCard label="Fat" value={totals.fat || 0} goal={goals.fat || 65} color={TOKENS.ember} />
        </div>
      </div>

      {/* ============================================================
          2. LARGE SCAN YOUR MEAL CARD (AI Food Vision - SECOND)
          ============================================================ */}
      <LargeScanMealCard
        onTriggerScan={triggerCameraScan}
        onTriggerGallery={triggerGalleryScan}
      />

      {/* ============================================================
          COACH AI & VOICE COACH (Placed directly below Scan Meal)
          ============================================================ */}
      <HomeCoachCard
        athleteName={profileName || "Athlete"}
        remCal={effectiveRemaining.calories}
        remP={effectiveRemaining.protein}
        coachTip={coachTip}
        onOpenCoach={() => { setCoachInitialQuery(""); setShowCoachModal(true); }}
        onOpenVoice={() => setShowVoiceCoachModal(true)}
        onQuickAsk={(query) => { setCoachInitialQuery(query); setShowCoachModal(true); }}
      />

      {/* ============================================================
          3. FITNESS SCORE (0-100) + FITNESS LEVEL/XP (Beside each other)
          ============================================================ */}
      <FitnessScoreAndXpCard
        scoreData={scoreData}
        xpData={xpData}
        onViewScoreDetails={() => setShowScoreModal(true)}
      />

      {/* Hydration Card */}
      <div
        style={{
          background: "linear-gradient(135deg, rgba(61,220,255,0.08) 0%, rgba(20,20,20,0.6) 100%)",
          backdropFilter: "blur(16px)",
          border: `1px solid rgba(61,220,255,0.22)`,
          borderRadius: 20,
          padding: "16px 18px",
          marginBottom: 14,
          boxShadow: CARD_SHADOW,
        }}
      >
        <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 10 }}>
          <div style={{ display: "flex", alignItems: "center", gap: 8 }}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#3DDCFF" strokeWidth="2.2" strokeLinecap="round" strokeLinejoin="round"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/></svg>
            <span style={{ fontSize: 13, fontWeight: 700, color: TOKENS.text }}>Daily Hydration</span>
          </div>
          <div style={{ display: "flex", alignItems: "center", gap: 8 }}>
            <span style={{ fontSize: 13, fontWeight: 800, color: TOKENS.water }}>
              {Math.max(0, Math.min(10, Number(water) || 0)).toFixed(1)} <span style={{ fontSize: 11, color: TOKENS.mutedFaint, fontWeight: 500 }}>/ {waterGoal}L</span>
            </span>
            <button
              onClick={(e) => { e.stopPropagation(); setWater && setWater(0); }}
              title="Reset today's water"
              style={{ background: "rgba(255,255,255,0.06)", border: "1px solid rgba(255,255,255,0.1)", borderRadius: 6, color: TOKENS.mutedFaint, fontSize: 10, cursor: "pointer", padding: "2px 6px" }}
            >
              ↺ Reset
            </button>
          </div>
        </div>
        <div style={{ height: 6, background: "rgba(255,255,255,0.08)", borderRadius: 999, overflow: "hidden", marginBottom: 12 }}>
          <div style={{ width: `${waterPct * 100}%`, height: "100%", background: TOKENS.water, borderRadius: 999, transition: "width 0.3s ease" }} />
        </div>
        <div style={{ display: "flex", gap: 8 }}>
          <button
            onClick={() => addWater(0.25)}
            style={{ flex: 1, background: "rgba(61,220,255,0.14)", border: `1px solid rgba(61,220,255,0.3)`, borderRadius: 10, padding: "7px 0", color: TOKENS.water, fontSize: 12, fontWeight: 700, cursor: "pointer" }}
          >
            +250ml
          </button>
          <button
            onClick={() => addWater(0.5)}
            style={{ flex: 1, background: "rgba(61,220,255,0.14)", border: `1px solid rgba(61,220,255,0.3)`, borderRadius: 10, padding: "7px 0", color: TOKENS.water, fontSize: 12, fontWeight: 700, cursor: "pointer" }}
          >
            +500ml
          </button>
          <button
            onClick={() => addWater(0.75)}
            style={{ flex: 1, background: "rgba(61,220,255,0.14)", border: `1px solid rgba(61,220,255,0.3)`, borderRadius: 10, padding: "7px 0", color: TOKENS.water, fontSize: 12, fontWeight: 700, cursor: "pointer" }}
          >
            +750ml
          </button>
        </div>
      </div>


      {/* ============================================================
          7. TODAY'S WORKOUT / RUNNING + READINESS
          ============================================================ */}
      <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 12, marginBottom: 14 }}>
        <div
          onClick={() => onNavigate && onNavigate("workout")}
          style={{ cursor: "pointer", background: TOKENS.ember, borderRadius: 20, padding: 18, boxShadow: CARD_SHADOW }}
        >
          <div style={{ display: "flex", justifyContent: "space-between", alignItems: "flex-start", marginBottom: 12 }}>
            <IconBadge icon="workout" bg="rgba(0,0,0,0.12)" />
            {totalExercises > 0 && <SmallRing progress={completedCount / Math.max(1, totalExercises)} color="#0B0E13" size={32} stroke={4} />}
          </div>
          <div style={{ fontSize: 10.5, color: "rgba(11,14,19,0.65)", fontWeight: 700, textTransform: "uppercase", letterSpacing: 0.5 }}>{TODAY_KEY} Workout</div>
          <div style={{ fontSize: 15, fontWeight: 800, color: "#0B0E13", marginTop: 2 }}>{workoutDay?.label || "Workout"}</div>
          {!workoutDay?.rest && totalExercises > 0 && (
            <div style={{ fontSize: 11.5, color: "rgba(11,14,19,0.7)", marginTop: 2, fontWeight: 600 }}>
              {completedCount}/{totalExercises} finished
            </div>
          )}
        </div>

        <div
          onClick={() => onNavigate && onNavigate("run")}
          style={{ cursor: "pointer", background: "linear-gradient(145deg, #1C2430 0%, #12161E 100%)", border: `1px solid rgba(255,255,255,0.1)`, borderRadius: 20, padding: 18, boxShadow: CARD_SHADOW }}
        >
          <div style={{ display: "flex", justifyContent: "space-between", alignItems: "flex-start", marginBottom: 12 }}>
            <IconBadge icon="run" bg="rgba(37, 107, 253,0.16)" />
            <span style={{ fontSize: 10, background: "rgba(37, 107, 253,0.15)", color: TOKENS.ember, padding: "2px 6px", borderRadius: 6, fontWeight: 700 }}>STOKE</span>
          </div>
          <div style={{ fontSize: 10.5, color: TOKENS.mutedFaint, fontWeight: 700, textTransform: "uppercase", letterSpacing: 0.5 }}>Run Tracker</div>
          <div style={{ fontSize: 15, fontWeight: 800, color: "#FFFFFF", marginTop: 2 }}>
            {lastRun ? `${lastRunDist} km` : "Start Run"}
          </div>
          <div style={{ fontSize: 11.5, color: TOKENS.muted, marginTop: 2 }}>
            {lastRunCals}
          </div>
        </div>
      </div>

      {/* Readiness / Energy Gauge */}
      <div
        style={{
          background: TOKENS.surface,
          border: `1px solid ${TOKENS.border}`,
          borderRadius: 18,
          padding: "14px 18px",
          display: "flex",
          justifyContent: "space-between",
          alignItems: "center",
          marginBottom: 14
        }}
      >
        <div style={{ display: "flex", alignItems: "center", gap: 10 }}>
          <div style={{ width: 36, height: 36, borderRadius: 10, background: "rgba(46,212,191,0.15)", display: "flex", alignItems: "center", justifyContent: "center", color: TOKENS.teal }}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2ED4BF" strokeWidth="2.4" strokeLinecap="round" strokeLinejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
          </div>
          <div>
            <div style={{ fontSize: 13, fontWeight: 700, color: TOKENS.text }}>Readiness: Optimal (92%)</div>
            <div style={{ fontSize: 11, color: TOKENS.mutedFaint }}>Based on today's calories, training & hydration</div>
          </div>
        </div>
        <span style={{ fontSize: 12, fontWeight: 700, color: TOKENS.teal }}>Ready</span>
      </div>

      {/* ============================================================
          8. ACHIEVEMENT ROOM PREVIEW
          ============================================================ */}
      <AchievementRoomPreview
        achievements={achievements}
        onViewAll={() => setShowAchievementsModal(true)}
      />

      {/* ============================================================
          9. YOUR WEEKLY STORY
          ============================================================ */}
      <WeeklyStoryCard
        weeklyStats={weeklyStats}
        onOpenStory={() => setShowWeeklyStoryModal(true)}
      />


    </div>
  );
}


/* ─── SUPABASE CLOUD LOADING SCREEN ─── */
function AppLoadingScreen() {
  return (
    <div style={{
      position: "fixed",
      inset: 0,
      background: "radial-gradient(circle at 50% 0%, #10162A 0%, #08090E 70%)",
      display: "flex",
      flexDirection: "column",
      alignItems: "center",
      justifyContent: "center",
      zIndex: 99999,
      fontFamily: "'Space Grotesk', ui-sans-serif, system-ui, sans-serif",
      color: "#FFFFFF",
      padding: 24,
    }}>
      <div style={{
        position: "relative",
        width: 80,
        height: 80,
        display: "flex",
        alignItems: "center",
        justifyContent: "center",
        marginBottom: 24,
      }}>
        <div style={{
          position: "absolute",
          inset: -4,
          borderRadius: "50%",
          border: "2px solid rgba(37,107,253,0.2)",
          borderTopColor: "#256BFD",
          animation: "spin 1s linear infinite",
        }} />
        <div style={{
          width: 58,
          height: 58,
          borderRadius: "50%",
          background: "linear-gradient(135deg, #256BFD 0%, #1A5EE5 100%)",
          display: "flex",
          alignItems: "center",
          justifyContent: "center",
          boxShadow: "0 0 24px rgba(37,107,253,0.6)",
        }}>
          <span style={{ fontSize: 26, fontWeight: 900 }}>⚡</span>
        </div>
      </div>

      <div style={{
        fontSize: 20,
        fontWeight: 900,
        letterSpacing: 2,
        color: "#FFFFFF",
        marginBottom: 8,
      }}>
        STOKE
      </div>

      <div style={{
        fontSize: 13,
        color: "rgba(255,255,255,0.6)",
        fontWeight: 600,
        display: "flex",
        alignItems: "center",
        gap: 8,
      }}>
        <span style={{
          width: 14,
          height: 14,
          borderRadius: "50%",
          border: "2px solid rgba(59,130,246,0.25)",
          borderTopColor: "#3B82F6",
          animation: "spin 0.8s linear infinite",
          display: "inline-block",
        }} />
        <span>Loading athlete telemetry from Supabase...</span>
      </div>
    </div>
  );
}

/* ─── SUPABASE DATABASE & STORAGE SETTINGS MODAL ─── */
function SupabaseSettingsModal({ isOpen, onClose }) {
  const [cfg, setCfg] = useState(() => (typeof getSupabaseConfig === "function" ? getSupabaseConfig() : { url: "", key: "" }));
  const [status, setStatus] = useState("idle");
  const [statusMsg, setStatusMsg] = useState("");
  const [pendingQueueCount, setPendingQueueCount] = useState(0);

  useEffect(() => {
    if (isOpen) {
      if (typeof getSupabaseConfig === "function") setCfg(getSupabaseConfig());
      setStatus("idle");
      setStatusMsg("");
      if (typeof getOfflineQueue === "function") {
        setPendingQueueCount(getOfflineQueue().length);
      }
    }
  }, [isOpen]);

  if (!isOpen) return null;

  const handleTestAndSave = async () => {
    setStatus("testing");
    setStatusMsg("Connecting to Supabase...");
    try {
      if (typeof saveSupabaseConfig === "function") saveSupabaseConfig(cfg.url, cfg.key);
      const client = typeof resetSupabaseClient === "function" ? resetSupabaseClient() : null;
      if (!client) {
        throw new Error("Please enter both Supabase Project URL and Anon Public Key.");
      }
      const { error } = await client.from("profiles").select("id").limit(1);
      if (error && error.code !== "PGRST116") {
        console.warn("Supabase test warning:", error);
      }
      setStatus("success");
      setStatusMsg("Connected successfully to Supabase! Live sync active.");
      setTimeout(() => {
        onClose();
        if (typeof window !== "undefined") window.location.reload();
      }, 900);
    } catch (e) {
      setStatus("error");
      setStatusMsg(e.message || "Failed to connect to Supabase.");
    }
  };

  const handleFlushQueue = async () => {
    if (typeof flushOfflineQueue === "function") await flushOfflineQueue();
    if (typeof getOfflineQueue === "function") {
      const q = getOfflineQueue();
      setPendingQueueCount(q.length);
      setStatusMsg(`Queue synchronized! ${q.length} items remaining.`);
    }
  };

  return (
    <div style={{
      position: "fixed",
      inset: 0,
      background: "rgba(0,0,0,0.8)",
      backdropFilter: "blur(12px)",
      WebkitBackdropFilter: "blur(12px)",
      zIndex: 999999,
      display: "flex",
      alignItems: "center",
      justifyContent: "center",
      padding: 18,
      fontFamily: "'Space Grotesk', ui-sans-serif, system-ui, sans-serif",
    }}>
      <div style={{
        background: "#0E131E",
        border: "1.5px solid rgba(37,107,253,0.35)",
        borderRadius: 24,
        padding: 24,
        maxWidth: 440,
        width: "100%",
        boxShadow: "0 20px 60px rgba(0,0,0,0.9)",
        color: "#FFFFFF",
      }}>
        <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 18 }}>
          <div style={{ display: "flex", alignItems: "center", gap: 10 }}>
            <div style={{ width: 34, height: 34, borderRadius: 10, background: "rgba(37,107,253,0.18)", border: "1px solid #256BFD", display: "flex", alignItems: "center", justifyContent: "center", fontSize: 18 }}>
              ⚡
            </div>
            <div>
              <h3 style={{ margin: 0, fontSize: 17, fontWeight: 900 }}>Supabase Cloud Database</h3>
              <p style={{ margin: 0, fontSize: 11, color: "rgba(255,255,255,0.45)" }}>Persistent storage & authentication</p>
            </div>
          </div>
          <button
            type="button"
            onClick={onClose}
            style={{ background: "transparent", border: "none", color: "rgba(255,255,255,0.5)", fontSize: 22, cursor: "pointer", padding: "4px 8px" }}
          >
            ✕
          </button>
        </div>

        <div style={{ display: "flex", flexDirection: "column", gap: 14 }}>
          <div>
            <label style={{ fontSize: 11, fontWeight: 800, color: "rgba(255,255,255,0.6)", display: "block", marginBottom: 6, textTransform: "uppercase", letterSpacing: 1 }}>
              Supabase Project URL
            </label>
            <input
              type="text"
              value={cfg.url}
              onChange={(e) => setCfg({ ...cfg, url: e.target.value })}
              placeholder="https://xyzcompany.supabase.co"
              style={{
                width: "100%",
                padding: "12px 14px",
                borderRadius: 14,
                background: "#161B28",
                border: "1px solid rgba(255,255,255,0.12)",
                color: "#FFFFFF",
                fontSize: 13,
                outline: "none",
                fontFamily: "monospace",
              }}
            />
          </div>

          <div>
            <label style={{ fontSize: 11, fontWeight: 800, color: "rgba(255,255,255,0.6)", display: "block", marginBottom: 6, textTransform: "uppercase", letterSpacing: 1 }}>
              Supabase Anon Public Key
            </label>
            <textarea
              rows={3}
              value={cfg.key}
              onChange={(e) => setCfg({ ...cfg, key: e.target.value })}
              placeholder="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
              style={{
                width: "100%",
                padding: "12px 14px",
                borderRadius: 14,
                background: "#161B28",
                border: "1px solid rgba(255,255,255,0.12)",
                color: "#FFFFFF",
                fontSize: 12,
                outline: "none",
                fontFamily: "monospace",
                resize: "none",
              }}
            />
          </div>

          {statusMsg && (
            <div style={{
              padding: "10px 14px",
              borderRadius: 12,
              fontSize: 12.5,
              fontWeight: 600,
              background: status === "success" ? "rgba(16,185,129,0.12)" : status === "error" ? "rgba(239,68,68,0.12)" : "rgba(37,107,253,0.12)",
              color: status === "success" ? "#10B981" : status === "error" ? "#EF4444" : "#3B82F6",
              border: `1px solid ${status === "success" ? "rgba(16,185,129,0.3)" : status === "error" ? "rgba(239,68,68,0.3)" : "rgba(37,107,253,0.3)"}`,
            }}>
              {statusMsg}
            </div>
          )}

          <div style={{ display: "flex", gap: 10, marginTop: 4 }}>
            <button
              type="button"
              onClick={handleTestAndSave}
              disabled={status === "testing"}
              style={{
                flex: 1,
                padding: "13px 0",
                borderRadius: 14,
                background: "linear-gradient(135deg, #256BFD 0%, #1A5EE5 100%)",
                color: "#FFFFFF",
                border: "none",
                fontSize: 13,
                fontWeight: 800,
                cursor: status === "testing" ? "not-allowed" : "pointer",
              }}
            >
              {status === "testing" ? "Testing..." : "Test & Save Connection"}
            </button>
          </div>

          <div style={{
            marginTop: 8,
            padding: 12,
            borderRadius: 14,
            background: "rgba(255,255,255,0.03)",
            border: "1px solid rgba(255,255,255,0.07)",
            fontSize: 11.5,
            color: "rgba(255,255,255,0.5)",
            lineHeight: 1.5,
          }}>
            <div><strong>Offline Sync Queue:</strong> {pendingQueueCount} pending changes</div>
            {pendingQueueCount > 0 && (
              <button
                type="button"
                onClick={handleFlushQueue}
                style={{
                  marginTop: 6,
                  background: "#256BFD",
                  color: "#FFF",
                  border: "none",
                  borderRadius: 6,
                  padding: "4px 10px",
                  fontSize: 10.5,
                  fontWeight: 700,
                  cursor: "pointer",
                }}
              >
                Sync Queue Now
              </button>
            )}
            <div style={{ marginTop: 6 }}>
              All 9 tables, Row Level Security policies, indexes, and Storage buckets are defined in <code>supabase_schema.sql</code>.
            </div>
          </div>
        </div>
      </div>
    </div>
  );
}

/* ─── INTERACTIVE DAY SELECTOR WITH SUPABASE HISTORY & CALENDAR PICKER ─── */
function DaySelector({ selectedDate, onSelectDate }) {
  const todayStr = typeof getLocalDateStr === "function" ? getLocalDateStr() : new Date().toISOString().split("T")[0];
  const activeDate = selectedDate || todayStr;
  const dateInputRef = useRef(null);

  const days = [];
  const curr = new Date();
  for (let i = 6; i >= 0; i--) {
    const d = new Date(curr.getTime() - i * 86400000);
    const dateStr = typeof getLocalDateStr === "function" ? getLocalDateStr(d) : d.toISOString().split("T")[0];
    const dow = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"][d.getDay()];
    const dayNum = d.getDate();
    days.push({ dateStr, dow, dayNum, isToday: dateStr === todayStr });
  }

  const isViewingPast = activeDate !== todayStr;
  const isCustomHistoricalDate = !days.some((d) => d.dateStr === activeDate);

  return (
    <div style={{ marginBottom: 14 }}>
      <div style={{ display: "flex", alignItems: "center", justifyContent: "space-between", gap: 5 }}>
        {days.map((d) => {
          const isSelected = d.dateStr === activeDate;
          return (
            <button
              key={d.dateStr}
              type="button"
              onClick={() => onSelectDate && onSelectDate(d.dateStr)}
              style={{
                flex: 1,
                display: "flex",
                flexDirection: "column",
                alignItems: "center",
                gap: 4,
                padding: "8px 0",
                background: isSelected ? "rgba(37,107,253,0.22)" : "rgba(255,255,255,0.02)",
                border: isSelected ? "1.5px solid #256BFD" : d.isToday ? "1.5px dashed rgba(37,107,253,0.4)" : "1px solid rgba(255,255,255,0.06)",
                borderRadius: 14,
                cursor: "pointer",
                transition: "all 0.15s ease",
              }}
            >
              <span style={{ fontSize: 10, color: isSelected ? "#3B82F6" : TOKENS.mutedFaint, fontWeight: 700 }}>
                {d.dow}
              </span>
              <span style={{
                width: 26,
                height: 26,
                borderRadius: "50%",
                background: isSelected ? "#256BFD" : "transparent",
                color: isSelected ? "#FFFFFF" : d.isToday ? TOKENS.ember : TOKENS.text,
                display: "flex",
                alignItems: "center",
                justifyContent: "center",
                fontSize: 12,
                fontWeight: 800,
                boxShadow: isSelected ? "0 0 10px rgba(37,107,253,0.6)" : "none",
              }}>
                {d.dayNum}
              </span>
            </button>
          );
        })}

        {/* Calendar Picker button to select any past date */}
        <div style={{ position: "relative" }}>
          <button
            type="button"
            title="Select date from calendar"
            onClick={() => {
              if (dateInputRef.current) {
                if (typeof dateInputRef.current.showPicker === "function") {
                  dateInputRef.current.showPicker();
                } else {
                  dateInputRef.current.click();
                }
              }
            }}
            style={{
              display: "flex",
              flexDirection: "column",
              alignItems: "center",
              justifyContent: "center",
              padding: "7px 9px",
              background: isCustomHistoricalDate ? "rgba(37,107,253,0.25)" : "rgba(255,255,255,0.03)",
              border: isCustomHistoricalDate ? "1.5px solid #256BFD" : "1px solid rgba(255,255,255,0.08)",
              borderRadius: 14,
              cursor: "pointer",
              gap: 3
            }}
          >
            <span style={{ fontSize: 12 }}>📅</span>
            <span style={{ fontSize: 9, color: isCustomHistoricalDate ? "#3B82F6" : TOKENS.mutedFaint, fontWeight: 700 }}>
              Cal
            </span>
          </button>
          <input
            ref={dateInputRef}
            type="date"
            max={todayStr}
            value={activeDate}
            onChange={(e) => {
              if (e.target.value) onSelectDate && onSelectDate(e.target.value);
            }}
            style={{
              position: "absolute",
              opacity: 0,
              pointerEvents: "none",
              width: 1,
              height: 1,
              bottom: 0,
              left: 0
            }}
          />
        </div>
      </div>

      {isViewingPast && (
        <div style={{
          display: "flex",
          alignItems: "center",
          justifyContent: "space-between",
          marginTop: 8,
          padding: "6px 12px",
          borderRadius: 10,
          background: "rgba(37,107,253,0.12)",
          border: "1px solid rgba(37,107,253,0.3)",
        }}>
          <div style={{ display: "flex", alignItems: "center", gap: 6 }}>
            <span style={{ fontSize: 12 }}>📅</span>
            <span style={{ fontSize: 11, color: "#3B82F6", fontWeight: 700 }}>
              Viewing records for {activeDate} (Supabase)
            </span>
          </div>
          <button
            type="button"
            onClick={() => onSelectDate && onSelectDate(todayStr)}
            style={{
              background: "#256BFD",
              color: "#FFF",
              border: "none",
              borderRadius: 6,
              padding: "4px 10px",
              fontSize: 10.5,
              fontWeight: 800,
              cursor: "pointer",
            }}
          >
            Today
          </button>
        </div>
      )}
    </div>
  );
}

function MiniMacroCard({ label, value, goal, color }) {
  const pct = Math.min(100, (value / goal) * 100);
  return (
    <div style={{ flex: 1 }}>
      <div style={{ fontSize: 11, color: TOKENS.mutedFaint, marginBottom: 4 }}>{label}</div>
      <div style={{ fontSize: 15, fontWeight: 700, color: TOKENS.text, marginBottom: 6 }}>
        {Math.round(value)}g <span style={{ fontSize: 11, color: TOKENS.mutedFaint, fontWeight: 400 }}>/ {goal}</span>
      </div>
      <div style={{ height: 4, background: TOKENS.surface2, borderRadius: 2, overflow: "hidden" }}>
        <div style={{ height: "100%", width: `${pct}%`, background: color, borderRadius: 2 }} />
      </div>
    </div>
  );
}

function NutritionScreen({ meals, mealSlots, addMealSlot, removeMealSlot, water, setWater, addItem, removeItem, totals, calPct, goals, onBack, onNavigate, selectedDate, onSelectDate }) {
  const [newMealName, setNewMealName] = useState("");
  const addMealInputRef = useRef(null);

  function handleAddSlot() {
    if (!newMealName.trim()) return;
    addMealSlot(newMealName.trim());
    setNewMealName("");
  }

  function handleFabClick() {
    addMealInputRef.current?.scrollIntoView({ behavior: "smooth", block: "center" });
    addMealInputRef.current?.focus();
  }

  const kcalLeft = Math.max(0, Math.round(goals.calories - totals.calories));

  return (
    <div>
      <ScreenHeader
        title="Today's fuel"
        subtitle="Nutrition"
        onBack={onBack}
        canGoBack={true}
      />

      <DaySelector selectedDate={selectedDate} onSelectDate={onSelectDate} />

      <div style={{ background: TOKENS.surface, backdropFilter: "blur(16px) saturate(180%)", WebkitBackdropFilter: "blur(16px) saturate(180%)", border: `1px solid ${TOKENS.border}`, borderRadius: 18, padding: "18px 20px", marginBottom: 12, boxShadow: CARD_SHADOW }}>
        <div style={{ fontSize: 12, color: TOKENS.mutedFaint, marginBottom: 8 }}>Calories</div>
        <div style={{ display: "flex", justifyContent: "space-between", alignItems: "baseline", marginBottom: 10 }}>
          <div style={{ fontSize: 24, fontWeight: 700, color: TOKENS.text }}>
            {Math.round(totals.calories)} <span style={{ fontSize: 13, color: TOKENS.mutedFaint, fontWeight: 400 }}>/ {goals.calories}</span>
          </div>
          <div style={{ fontSize: 14, fontWeight: 700, color: TOKENS.ember }}>{kcalLeft} <span style={{ fontSize: 11, color: TOKENS.mutedFaint, fontWeight: 500 }}>left</span></div>
        </div>
        <div style={{ height: 6, background: TOKENS.surface2, borderRadius: 3, overflow: "hidden" }}>
          <div style={{ height: "100%", width: `${Math.min(100, calPct * 100)}%`, background: TOKENS.ember, borderRadius: 3 }} />
        </div>
      </div>

      <div style={{ background: TOKENS.surface, backdropFilter: "blur(16px) saturate(180%)", WebkitBackdropFilter: "blur(16px) saturate(180%)", border: `1px solid ${TOKENS.border}`, borderRadius: 18, padding: "18px 20px", marginBottom: 18, display: "flex", gap: 18, boxShadow: CARD_SHADOW }}>
        <MiniMacroCard label="Carbs" value={totals.carbs} goal={goals.carbs} color={TOKENS.carbs} />
        <MiniMacroCard label="Fat" value={totals.fat} goal={goals.fat} color={TOKENS.fat} />
        <MiniMacroCard label="Protein" value={totals.protein} goal={goals.protein} color={TOKENS.protein} />
        <MiniMacroCard label="Fibre" value={totals.fiber} goal={goals.fiber} color={TOKENS.fiber} />
      </div>
      <div style={{ background: TOKENS.surface, backdropFilter: "blur(16px) saturate(180%)", WebkitBackdropFilter: "blur(16px) saturate(180%)", border: `1px solid ${TOKENS.border}`, borderRadius: 14, padding: "14px 18px", marginBottom: 22, display: "flex", alignItems: "center", justifyContent: "space-between", boxShadow: CARD_SHADOW }}>
        <div>
          <div style={{ fontSize: 13, color: TOKENS.muted, fontWeight: 500 }}>💧 Water</div>
          <div style={{ fontSize: 18, fontWeight: 700, color: TOKENS.text }}>{Math.max(0, Math.min(10, Number(water) || 0)).toFixed(1)}L <span style={{ fontSize: 13, color: TOKENS.mutedFaint, fontWeight: 400 }}>/ {goals.water}L</span></div>
        </div>
        <div style={{ display: "flex", gap: 8 }}>
          <button onClick={() => setWater((w) => Math.max(0, Math.round(((Number(w) || 0) - 0.25) * 100) / 100))} style={waterBtnStyle}>−</button>
          <button onClick={() => setWater((w) => Math.min(10, Math.round(((Number(w) || 0) + 0.25) * 100) / 100))} style={waterBtnStyle}>+</button>
        </div>
      </div>
      {mealSlots.map((slot) => (
        <MealSection
          key={slot.key}
          mealKey={slot.key}
          label={slot.label}
          items={meals[slot.key] || []}
          onAdd={(item) => addItem(slot.key, item)}
          onRemove={(idx) => removeItem(slot.key, idx)}
          onRemoveSlot={mealSlots.length > 1 ? () => removeMealSlot(slot.key) : null}
        />
      ))}

      <div style={{ background: TOKENS.surface2, backdropFilter: "blur(16px) saturate(180%)", WebkitBackdropFilter: "blur(16px) saturate(180%)", border: `1px dashed ${TOKENS.border}`, borderRadius: 14, padding: 16, marginTop: 4 }}>
        <label style={{ fontSize: 11, color: TOKENS.mutedFaint, display: "block", marginBottom: 6 }}>Add a custom meal</label>
        <div style={{ display: "flex", gap: 8 }}>
          <input
            ref={addMealInputRef}
            value={newMealName}
            onChange={(e) => setNewMealName(e.target.value)}
            onKeyDown={(e) => e.key === "Enter" && handleAddSlot()}
            placeholder="e.g. Late Night Snack"
            style={{ flex: 1, background: TOKENS.bg, border: `1px solid ${TOKENS.border}`, borderRadius: 8, padding: "9px 12px", color: TOKENS.text, fontSize: 14, boxSizing: "border-box" }}
          />
          <button onClick={handleAddSlot} style={{ background: "#111111", color: "#FFFFFF", border: "none", borderRadius: 8, padding: "0 18px", fontSize: 13, fontWeight: 700, cursor: "pointer" }}>
            + Add
          </button>
        </div>
      </div>

      <button
        onClick={handleFabClick}
        aria-label="Quick add"
        style={{
          position: "fixed",
          right: 20,
          bottom: 86,
          width: 52,
          height: 52,
          borderRadius: "50%",
          background: TOKENS.ember,
          color: "#0B0E13",
          border: "none",
          fontSize: 26,
          fontWeight: 700,
          cursor: "pointer",
          boxShadow: "0 6px 18px rgba(37, 107, 253,0.35)",
          zIndex: 40,
        }}
      >
        +
      </button>
    </div>
  );
}

const waterBtnStyle = { width: 34, height: 34, borderRadius: "50%", border: "none", background: "#161616", color: TOKENS.text, fontSize: 18, cursor: "pointer", display: "flex", alignItems: "center", justifyContent: "center",
  boxShadow: "4px 4px 8px rgba(0,0,0,0.6), -4px -4px 8px rgba(255,255,255,0.04)" };

/* ============================================================
   UPGRADED WORKOUT SCREEN WITH HORIZONTAL SCROLL & PERSONALIZATION
   ============================================================ */

/* ============================================================
   UPGRADED WORKOUT SCREEN WITH HORIZONTAL SCROLL & PERSONALIZATION
   ============================================================ */

function WorkoutScreen({ week, programKey, onProgramChange, activeDay, setActiveDay, logs, updateSet, addSet, toggleComplete, onNavigate, onBack, profile }) {
  const day = week[activeDay] || { label: "Workout", rest: false, exercises: [] };
  const dayLog = logs[activeDay] || {};

  const isHomeWorkout = programKey === "Home Workout" || (programKey && programKey.includes("Home"));

  // Personalization settings
  const [showPersonalize, setShowPersonalize] = useState(false);
  const [activeModalExerciseIndex, setActiveModalExerciseIndex] = useState(null);
  const [userLevel, setUserLevel] = useState(() => {
    try {
      return localStorage.getItem("stoke_user_level") || (profile && profile.level) || "Intermediate";
    } catch (e) { return "Intermediate"; }
  });
  const [userGoal, setUserGoal] = useState(() => {
    try {
      return localStorage.getItem("stoke_user_goal") || (profile && profile.goal) || (profile && profile.goalType) || "Build Muscle";
    } catch (e) { return "Build Muscle"; }
  });
  const [userDuration, setUserDuration] = useState(() => {
    try {
      return localStorage.getItem("stoke_user_duration") || "30 Mins";
    } catch (e) { return "30 Mins"; }
  });
  const [userDays, setUserDays] = useState(() => {
    try {
      return localStorage.getItem("stoke_user_days") || "5 Days";
    } catch (e) { return "5 Days"; }
  });

  const athleteName = (profile && profile.name) ? profile.name.trim().split(" ")[0] : "Athlete";
  const athleteAge = (profile && profile.age) ? profile.age : 25;

  const handleSavePersonalization = (level, goal, duration, days) => {
    setUserLevel(level);
    setUserGoal(goal);
    setUserDuration(duration);
    setUserDays(days);
    if (typeof localStorage !== "undefined") {
      try {
        localStorage.setItem("stoke_user_level", level);
        localStorage.setItem("stoke_user_goal", goal);
        localStorage.setItem("stoke_user_duration", duration);
        localStorage.setItem("stoke_user_days", days);
      } catch (e) {}
    }
  };

  // Filter exercises based on personalized duration
  let displayedExercises = day.exercises || [];
  if (userDuration === "15 Mins") {
    displayedExercises = displayedExercises.slice(0, 3);
  } else if (userDuration === "30 Mins") {
    displayedExercises = displayedExercises.slice(0, 5);
  }

  // Adjust sets based on level
  const targetSetsOverride = userLevel === "Beginner" ? 2 : userLevel === "Advanced" ? 4 : null;
  const processedExercises = displayedExercises.map((ex) => {
    if (targetSetsOverride) {
      return { ...ex, targetSets: targetSetsOverride };
    }
    return ex;
  });

  // Calculate day completion
  const completedCount = processedExercises.filter((ex) => dayLog[ex.name]?.completed).length;

  return (
    <div>
      <ScreenHeader
        title={programKey}
        subtitle="Workout Routine"
        onBack={onBack}
        canGoBack={true}
        rightAction={
          <button
            type="button"
            onClick={() => setShowPersonalize(!showPersonalize)}
            style={{
              background: showPersonalize ? "rgba(37,107,253,0.2)" : "rgba(255,255,255,0.06)",
              border: showPersonalize ? "1px solid #256BFD" : "1px solid rgba(255,255,255,0.12)",
              borderRadius: 999,
              padding: "6px 12px",
              color: showPersonalize ? "#60A5FA" : "rgba(255,255,255,0.8)",
              fontSize: 11.5,
              fontWeight: 800,
              cursor: "pointer",
              display: "flex",
              alignItems: "center",
              gap: 5
            }}
          >
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.2" strokeLinecap="round" strokeLinejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
            <span>Personalize</span>
          </button>
        }
      />
      {/* Top Segmented Bar: Workout | Run */}
      <div style={{ display: "flex", background: "rgba(255,255,255,0.06)", borderRadius: 14, padding: 3, marginBottom: 14, border: "1px solid rgba(255,255,255,0.08)" }}>
        <button
          type="button"
          style={{
            flex: 1,
            padding: "9px 0",
            borderRadius: 11,
            border: "none",
            background: "linear-gradient(135deg, #256BFD 0%, #1A5EE5 100%)",
            color: "#FFFFFF",
            fontWeight: 800,
            fontSize: 12.5,
            cursor: "pointer",
            display: "flex",
            alignItems: "center",
            justifyContent: "center",
            gap: 6,
            boxShadow: "0 2px 10px rgba(37,107,253,0.35)"
          }}
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
            <circle cx="5" cy="12" r="2.2" />
            <circle cx="19" cy="12" r="2.2" />
            <line x1="7.2" y1="12" x2="16.8" y2="12" />
            <line x1="5" y1="9.3" x2="5" y2="14.7" />
            <line x1="19" y1="9.3" x2="19" y2="14.7" />
          </svg>
          <span>Workout Plan</span>
        </button>
        <button
          type="button"
          onClick={() => onNavigate && onNavigate("run")}
          style={{
            flex: 1,
            padding: "9px 0",
            borderRadius: 11,
            border: "none",
            background: "transparent",
            color: "rgba(255,255,255,0.6)",
            fontWeight: 700,
            fontSize: 12.5,
            cursor: "pointer",
            display: "flex",
            alignItems: "center",
            justifyContent: "center",
            gap: 6,
            transition: "all 0.2s ease"
          }}
          onMouseEnter={(e) => { e.currentTarget.style.color = "#3B82F6"; }}
          onMouseLeave={(e) => { e.currentTarget.style.color = "rgba(255,255,255,0.6)"; }}
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
            <circle cx="15.5" cy="5" r="1.8" />
            <path d="M9 20l2.5-5.5 2 1.8 3.5-1" />
            <path d="M7 13.5l3.5-2.5 2 2.5-2.5 3.5" />
          </svg>
          <span>Run & GPS</span>
        </button>
      </div>

      <div style={{ display: "flex", justifyContent: "space-between", alignItems: "flex-end", marginBottom: 14 }}>
        <div>
          <div style={{ fontSize: 12, color: TOKENS.mutedFaint, letterSpacing: 0.5 }}>This week</div>
          <h1 style={{ margin: "2px 0 0", fontSize: 24, fontWeight: 800, color: TOKENS.text, letterSpacing: -0.5 }}>
            {isHomeWorkout ? "Home Workout" : "Workout plan"}
          </h1>
        </div>

        {/* Personalization Quick Badge */}
        <button
          onClick={() => setShowPersonalize(!showPersonalize)}
          style={{
            background: showPersonalize ? "rgba(37,107,253,0.2)" : "rgba(255,255,255,0.06)",
            border: `1px solid ${showPersonalize ? "#256BFD" : "rgba(255,255,255,0.12)"}`,
            borderRadius: 10,
            padding: "6px 10px",
            color: showPersonalize ? "#60A5FA" : "rgba(255,255,255,0.8)",
            fontSize: 11,
            fontWeight: 800,
            cursor: "pointer",
            display: "flex",
            alignItems: "center",
            gap: 5
          }}
        >
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
          </svg>
          <span>Personalize</span>
        </button>
      </div>

      {/* ── PERSONALIZATION DRAWER ── */}
      {showPersonalize && (
        <div style={{
          background: "linear-gradient(145deg, #0E131D 0%, #0A0D14 100%)",
          border: "1.5px solid rgba(37, 107, 253, 0.35)",
          borderRadius: 16,
          padding: "14px 16px",
          marginBottom: 16,
          boxShadow: "0 10px 30px rgba(0,0,0,0.6)"
        }}>
          <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 10 }}>
            <div>
              <div style={{ fontSize: 13, fontWeight: 900, color: "#FFFFFF" }}>Personalized Plan Generator</div>
              <div style={{ fontSize: 11, color: "rgba(255,255,255,0.45)" }}>Athlete: {athleteName} · Age {athleteAge}</div>
            </div>
            <button
              onClick={() => setShowPersonalize(false)}
              style={{ background: "none", border: "none", color: "rgba(255,255,255,0.5)", cursor: "pointer", padding: 4 }}
              aria-label="Close"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"/>
                <line x1="6" y1="6" x2="18" y2="18"/>
              </svg>
            </button>
          </div>

          <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 10, marginBottom: 12 }}>
            <div>
              <label style={{ fontSize: 10.5, color: "rgba(255,255,255,0.5)", fontWeight: 800, display: "block", marginBottom: 4 }}>FITNESS LEVEL</label>
              <select
                value={userLevel}
                onChange={(e) => handleSavePersonalization(e.target.value, userGoal, userDuration, userDays)}
                style={{ width: "100%", background: "#161B26", border: "1px solid rgba(255,255,255,0.12)", borderRadius: 8, padding: "7px 10px", color: "#FFFFFF", fontSize: 12, fontWeight: 700, outline: "none" }}
              >
                <option value="Beginner">Beginner (Gentle / 2 sets)</option>
                <option value="Intermediate">Intermediate (Standard / 3 sets)</option>
                <option value="Advanced">Advanced (High Intensity / 4 sets)</option>
              </select>
            </div>

            <div>
              <label style={{ fontSize: 10.5, color: "rgba(255,255,255,0.5)", fontWeight: 800, display: "block", marginBottom: 4 }}>PRIMARY GOAL</label>
              <select
                value={userGoal}
                onChange={(e) => handleSavePersonalization(userLevel, e.target.value, userDuration, userDays)}
                style={{ width: "100%", background: "#161B26", border: "1px solid rgba(255,255,255,0.12)", borderRadius: 8, padding: "7px 10px", color: "#FFFFFF", fontSize: 12, fontWeight: 700, outline: "none" }}
              >
                <option value="Build Muscle">Build Muscle</option>
                <option value="Lose Fat">Tone & Fat Loss</option>
                <option value="Get Stronger">Get Stronger</option>
                <option value="Mobility & Longevity">Mobility & Health</option>
              </select>
            </div>

            <div>
              <label style={{ fontSize: 10.5, color: "rgba(255,255,255,0.5)", fontWeight: 800, display: "block", marginBottom: 4 }}>DURATION</label>
              <select
                value={userDuration}
                onChange={(e) => handleSavePersonalization(userLevel, userGoal, e.target.value, userDays)}
                style={{ width: "100%", background: "#161B26", border: "1px solid rgba(255,255,255,0.12)", borderRadius: 8, padding: "7px 10px", color: "#FFFFFF", fontSize: 12, fontWeight: 700, outline: "none" }}
              >
                <option value="15 Mins">15 Mins (Express Routine)</option>
                <option value="30 Mins">30 Mins (Standard Focus)</option>
                <option value="45 Mins">45 Mins (Full Session)</option>
              </select>
            </div>

            <div>
              <label style={{ fontSize: 10.5, color: "rgba(255,255,255,0.5)", fontWeight: 800, display: "block", marginBottom: 4 }}>DAYS PER WEEK</label>
              <select
                value={userDays}
                onChange={(e) => handleSavePersonalization(userLevel, userGoal, userDuration, e.target.value)}
                style={{ width: "100%", background: "#161B26", border: "1px solid rgba(255,255,255,0.12)", borderRadius: 8, padding: "7px 10px", color: "#FFFFFF", fontSize: 12, fontWeight: 700, outline: "none" }}
              >
                <option value="3 Days">3 Days (Mon / Wed / Fri)</option>
                <option value="4 Days">4 Days (Mon / Tue / Thu / Fri)</option>
                <option value="5 Days">5 Days (Weekdays)</option>
                <option value="6 Days">6 Days (Full Split)</option>
              </select>
            </div>
          </div>

          <div style={{ fontSize: 11, color: "#60A5FA", fontWeight: 700, display: "flex", alignItems: "center", gap: 5 }}>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#60A5FA" strokeWidth="3" strokeLinecap="round" strokeLinejoin="round">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
            <span>Plan calibrated for {athleteName}: {userLevel} · {userGoal} · {userDuration}</span>
          </div>
        </div>
      )}

      {/* ── PROGRAM SELECTOR (HORIZONTALLY SCROLLABLE WITH REQUIRED ORDER) ── */}
      <div style={{ marginBottom: 14 }}>
        <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 6 }}>
          <label style={{ fontSize: 11, color: TOKENS.mutedFaint, display: "block", fontWeight: 700, textTransform: "uppercase" }}>Program</label>
          <span style={{ fontSize: 10.5, color: "rgba(255,255,255,0.4)" }}>← Scroll to explore →</span>
        </div>

        <div style={{
          display: "flex",
          gap: 8,
          overflowX: "auto",
          paddingBottom: 6,
          WebkitOverflowScrolling: "touch",
          scrollbarWidth: "none"
        }}>
          {PROGRAM_NAMES.map((name) => {
            const active = name === programKey;
            return (
              <button
                key={name}
                onClick={() => onProgramChange(name)}
                style={{
                  flex: "0 0 auto",
                  padding: "9px 15px",
                  borderRadius: 12,
                  border: active ? "1px solid rgba(37,107,253,0.5)" : "1px solid rgba(255,255,255,0.08)",
                  background: active ? "linear-gradient(135deg, #256BFD 0%, #1A5EE5 100%)" : "rgba(22,27,36,0.85)",
                  color: active ? "#FFFFFF" : "rgba(255,255,255,0.7)",
                  fontSize: 12.5,
                  fontWeight: active ? 800 : 600,
                  cursor: "pointer",
                  whiteSpace: "nowrap",
                  boxShadow: active ? "0 2px 12px rgba(37,107,253,0.4)" : "none",
                  transition: "all 0.15s ease"
                }}
              >
                {name}
              </button>
            );
          })}
        </div>
      </div>

      {/* Special Home Workout Banner */}
      {isHomeWorkout && (
        <div style={{
          background: "linear-gradient(135deg, rgba(46,212,191,0.12) 0%, rgba(37,107,253,0.08) 100%)",
          border: "1px solid rgba(46,212,191,0.3)",
          borderRadius: 14,
          padding: "10px 14px",
          marginBottom: 14,
          display: "flex",
          alignItems: "center",
          gap: 12
        }}>
          <div style={{ width: 36, height: 36, borderRadius: 10, background: "rgba(46,212,191,0.2)", display: "flex", alignItems: "center", justifyContent: "center", color: "#2ED4BF", flexShrink: 0 }}>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
              <polyline points="9 22 9 12 15 12 15 22"/>
            </svg>
          </div>
          <div>
            <div style={{ fontSize: 13, fontWeight: 900, color: "#2ED4BF" }}>
              Home Workout
            </div>
            <div style={{ fontSize: 11, color: "rgba(255,255,255,0.7)", marginTop: 1 }}>
              100% Bodyweight Home Routine · Zero equipment needed · Shorts tutorials & voice coach
            </div>
          </div>
        </div>
      )}

      {/* Days of Week Selector */}
      <div style={{ display: "flex", gap: 6, marginBottom: 16, overflowX: "auto", paddingBottom: 2 }}>
        {DAY_ORDER.map((d) => {
          const isActive = d === activeDay;
          const dRest = week[d]?.rest;
          const dExercises = week[d]?.exercises || [];
          const dCompleted = !dRest && dExercises.length > 0 && dExercises.every((ex) => logs[d]?.[ex.name]?.completed);
          return (
            <button
              key={d}
              onClick={() => setActiveDay(d)}
              style={{
                flex: "0 0 auto",
                padding: "8px 14px",
                borderRadius: 10,
                border: isActive ? "1px solid rgba(37,107,253,0.5)" : "1px solid rgba(255,255,255,0.08)",
                background: isActive ? "linear-gradient(135deg, #256BFD 0%, #1A5EE5 100%)" : "rgba(22,27,36,0.85)",
                color: isActive ? "#FFFFFF" : dRest ? TOKENS.mutedFaint : TOKENS.text,
                fontSize: 13,
                fontWeight: 700,
                cursor: "pointer",
                position: "relative",
                boxShadow: isActive ? "0 2px 10px rgba(37,107,253,0.35)" : "none"
              }}
            >
              {d}
              {dCompleted && !isActive && (
                <span style={{ position: "absolute", top: -4, right: -4, width: 14, height: 14, borderRadius: "50%", background: "#2ED4BF", display: "flex", alignItems: "center", justifyContent: "center", color: "#000000" }}>
                  <svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="3.5" strokeLinecap="round" strokeLinejoin="round">
                    <polyline points="20 6 9 17 4 12"/>
                  </svg>
                </span>
              )}
            </button>
          );
        })}
      </div>

      {/* Day Overview Banner */}
      <div style={{
        background: TOKENS.surface,
        backdropFilter: "blur(16px) saturate(180%)",
        WebkitBackdropFilter: "blur(16px) saturate(180%)",
        border: `1px solid ${TOKENS.border}`,
        borderRadius: 14,
        padding: "14px 18px",
        marginBottom: 14,
        display: "flex",
        justifyContent: "space-between",
        alignItems: "center",
        boxShadow: CARD_SHADOW
      }}>
        <div>
          <div style={{ fontSize: 17, fontWeight: 800, color: TOKENS.text }}>{day.label}</div>
          {!day.rest && (
            <div style={{ fontSize: 12, color: TOKENS.mutedFaint, marginTop: 2 }}>
              {completedCount} / {processedExercises.length} exercises completed
            </div>
          )}
        </div>
        {!day.rest && <SmallRing pct={completedCount / Math.max(1, processedExercises.length)} color={TOKENS.ember} />}
      </div>

      {/* Exercises List */}
      {day.rest ? (
        <div style={{
          textAlign: "center",
          padding: "50px 20px",
          background: "rgba(255,255,255,0.02)",
          border: "1px dashed rgba(255,255,255,0.1)",
          borderRadius: 16,
          color: TOKENS.mutedFaint,
          fontSize: 14
        }}>
          <div style={{ width: 48, height: 48, borderRadius: "50%", background: "rgba(46,212,191,0.15)", margin: "0 auto 12px", display: "flex", alignItems: "center", justifyContent: "center", color: "#2ED4BF" }}>
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
              <path d="M12 22v-8"/>
              <path d="M12 14c-4-4-4-10 0-12 4 2 4 8 0 12z"/>
              <path d="M12 14c4-4 4-10 0-12-4 2-4 8 0 12z"/>
            </svg>
          </div>
          <div style={{ fontWeight: 800, color: "#FFFFFF", marginBottom: 4 }}>Rest & Recovery Day</div>
          <div>Focus on hydration, gentle walking, and nutrient-dense recovery meals.</div>
        </div>
      ) : (
        <>
          {processedExercises.map((ex, idx) => (
            <ExerciseCard
              key={ex.name}
              ex={ex}
              exerciseIndex={idx}
              allExercises={processedExercises}
              log={dayLog[ex.name]?.sets || []}
              completed={dayLog[ex.name]?.completed || false}
              workoutLabel={day.label}
              programKey={programKey}
              isHomeWorkout={isHomeWorkout}
              onOpenModal={(i) => setActiveModalExerciseIndex(i)}
              onSetChange={(i, field, val) => updateSet(ex.name, i, field, val)}
              onAddSet={() => addSet(ex.name)}
              onToggleComplete={() => toggleComplete(ex.name)}
            />
          ))}

          {/* Upgraded Full 3D Exercise Demonstration Screen Modal */}
          {activeModalExerciseIndex !== null && processedExercises[activeModalExerciseIndex] && (
            <ExerciseDetailModal
              ex={processedExercises[activeModalExerciseIndex]}
              exerciseIndex={activeModalExerciseIndex}
              allExercises={processedExercises}
              isHomeWorkout={isHomeWorkout}
              onClose={() => setActiveModalExerciseIndex(null)}
              onNavigateExercise={(newIdx) => setActiveModalExerciseIndex(newIdx)}
              onLogSet={(exName) => addSet(exName)}
              onToggleComplete={(exName) => toggleComplete(exName)}
              isCompleted={dayLog[processedExercises[activeModalExerciseIndex].name]?.completed || false}
            />
          )}
        </>      )}
    </div>
  );
}

