  { lat: 17.3345, lng: 77.9012, ele: 624 }
];
function formatPace(paceMin) {
  if (!paceMin || !isFinite(paceMin) || paceMin <= 0 || paceMin > 30) return "--'--\"";
  const mins = Math.floor(paceMin);
  const secs = Math.round((paceMin - mins) * 60);
  if (secs === 60) return `${mins + 1}'00"`;
  return `${mins}'${secs < 10 ? "0" : ""}${secs}"`;
}

function getTimeOfDay(date) {
  const d = date instanceof Date ? date : new Date(date || Date.now());
  const h = d.getHours();
  if (h >= 5 && h < 12) return "Morning";
  if (h >= 12 && h < 17) return "Afternoon";
  if (h >= 17 && h < 21) return "Evening";
  return "Night";
}

function getActivityTitleByTime(startDate, sportType = "run") {
  const tod = getTimeOfDay(startDate);
  const sportLabel = sportType === "bike" ? "Ride" : sportType === "walk" ? "Walk" : "Run";
  return `${tod} ${sportLabel}`;
}

function formatRunDateTime(startDate) {
  const d = startDate instanceof Date ? startDate : new Date(startDate || Date.now());
  const now = new Date();
  const timeLabel = d.toLocaleTimeString([], { hour: "numeric", minute: "2-digit" });

  const isToday = (d.getFullYear() === now.getFullYear() &&
                   d.getMonth() === now.getMonth() &&
                   d.getDate() === now.getDate());

  const yDate = new Date(now);
  yDate.setDate(now.getDate() - 1);
  const isYesterday = (d.getFullYear() === yDate.getFullYear() &&
                       d.getMonth() === yDate.getMonth() &&
                       d.getDate() === yDate.getDate());

  let datePrefix = "";
  if (isToday) {
    datePrefix = "Today";
  } else if (isYesterday) {
    datePrefix = "Yesterday";
  } else {
    datePrefix = d.toLocaleDateString([], { weekday: "short", month: "short", day: "numeric" });
  }

  return {
    datePrefix,
    timeLabel,
    fullLabel: `${datePrefix} at ${timeLabel}`
  };
}

