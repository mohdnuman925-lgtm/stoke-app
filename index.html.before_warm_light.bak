                  />
                  <NeuInput
                    label="Height"
                    type="number"
                    value={editHeight}
                    onChange={e => setEditHeight(e.target.value)}
                    extraRight={<span style={{ position: "absolute", right: 16, top: "50%", transform: "translateY(-50%)", color: CYAN, fontWeight: 900, fontSize: 12 }}>cm</span>}
                  />
                </div>

                <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 12 }}>
                  <NeuInput
                    label="Age"
                    type="number"
                    value={editAge}
                    onChange={e => setEditAge(e.target.value)}
                    extraRight={<span style={{ position: "absolute", right: 16, top: "50%", transform: "translateY(-50%)", color: "rgba(255,255,255,0.35)", fontWeight: 700, fontSize: 11 }}>yrs</span>}
                  />
                  {/* Sex toggle */}
                  <div style={{ display: "flex", gap: 6 }}>
                    {[{ id: "male", l: "♂ Male" }, { id: "female", l: "♀ Female" }].map(s => (
                      <button
                        key={s.id}
                        type="button"
                        onClick={() => setEditSex(s.id)}
                        className={`s3-pill${editSex === s.id ? " sel" : ""}`}
                        style={{ padding: "14px 0", fontSize: 13 }}
                      >
                        {s.l}
                      </button>
                    ))}
                  </div>
                </div>

                {/* Activity level selector */}
                <div>
                  <div style={{ fontSize: 11, fontWeight: 800, color: "rgba(255,255,255,0.4)", textTransform: "uppercase", letterSpacing: 1.5, marginBottom: 8 }}>
                    Physical Activity Factor
                  </div>
                  <div style={{ display: "flex", flexDirection: "column", gap: 8 }}>
                    {[
                      { val: 1.2, t: "Sedentary", d: "Desk job, little movement" },
                      { val: 1.375, t: "Lightly Active", d: "1-3 workout sessions / wk" },
                      { val: 1.55, t: "Moderately Active", d: "3-5 intense workouts / wk" },
                      { val: 1.725, t: "Very Active (Athlete)", d: "Daily heavy training / physical job" },
                    ].map(act => {
                      const sel = editActivity === act.val || Math.abs(editActivity - act.val) < 0.05;
                      return (
                        <div
                          key={act.val}
                          onClick={() => setEditActivity(act.val)}
                          className={`s3-option${sel ? " selected" : ""}`}
                          style={{ padding: "11px 14px", cursor: "pointer" }}
                        >
                          <div>
                            <div style={{ fontSize: 13, fontWeight: 700, color: "#FFFFFF" }}>{act.t}</div>
                            <div style={{ fontSize: 11, color: "rgba(255,255,255,0.4)" }}>{act.d}</div>
                          </div>
                          <NeuRadio checked={sel} />
                        </div>
                      );
                    })}
                  </div>
                </div>

                {/* Target Strategy */}
                <div>
                  <div style={{ fontSize: 11, fontWeight: 800, color: "rgba(255,255,255,0.4)", textTransform: "uppercase", letterSpacing: 1.5, marginBottom: 8 }}>
