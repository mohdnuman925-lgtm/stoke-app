      <div style={{ width: "100%", maxWidth: 360, background: "linear-gradient(145deg, #1B202D 0%, #0F1219 100%)", border: "1.5px solid #F59E0B", borderRadius: 28, padding: "30px 24px", textAlign: "center", boxShadow: "0 0 50px rgba(245, 158, 11, 0.4)", animation: "stokeConfettiPop 0.5s ease-out" }}>
        <div style={{ width: 80, height: 80, borderRadius: "50%", background: "radial-gradient(circle, rgba(245,158,11,0.3) 0%, rgba(245,158,11,0.05) 70%)", border: "2px solid #F59E0B", margin: "0 auto 16px", display: "flex", alignItems: "center", justifyContent: "center", boxShadow: "0 0 24px rgba(245,158,11,0.5)" }}>
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#F59E0B" strokeWidth="2.2" strokeLinecap="round" strokeLinejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        </div>
        <div style={{ fontSize: 12, fontWeight: 800, color: "#F59E0B", textTransform: "uppercase", letterSpacing: 1.5, marginBottom: 6 }}>LEVEL UP!</div>
        <h2 style={{ margin: 0, fontSize: 32, fontWeight: 900, color: "#FFFFFF", letterSpacing: -0.5 }}>Level {data.newLevel} Unlocked</h2>
        <p style={{ margin: "10px 0 22px", fontSize: 13, lineHeight: 1.45, color: "rgba(255,255,255,0.7)" }}>
          You reached a new training milestone! Keep crushing workouts, runs, and healthy fuel to reach the next tier.
