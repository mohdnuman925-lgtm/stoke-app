  { lat: 17.3345, lng: 77.9012, ele: 624 },
  { lat: 17.3352, lng: 77.9026, ele: 627 },
  { lat: 17.3361, lng: 77.9041, ele: 631 },
  { lat: 17.3368, lng: 77.9055, ele: 636 },
  { lat: 17.3379, lng: 77.9068, ele: 640 },
  { lat: 17.3392, lng: 77.9079, ele: 642 },
  { lat: 17.3405, lng: 77.9072, ele: 639 },
  { lat: 17.3418, lng: 77.9061, ele: 635 },
  { lat: 17.3426, lng: 77.9048, ele: 631 },
  { lat: 17.3432, lng: 77.9032, ele: 628 },
  { lat: 17.3428, lng: 77.9015, ele: 625 },
  { lat: 17.3415, lng: 77.9004, ele: 626 },
  { lat: 17.3398, lng: 77.8998, ele: 629 },
