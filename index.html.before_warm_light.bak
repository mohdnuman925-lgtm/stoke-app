];

function generateScenicLoop(centerLat, centerLng, distKm = 4.2) {
  const points = [];
  const numPoints = 20;
  const radiusLat = (distKm / 111) * 0.35;
  const radiusLng = (distKm / (111 * Math.cos((centerLat * Math.PI) / 180))) * 0.35;

  for (let i = 0; i < numPoints; i++) {
    const angle = (i / numPoints) * 2 * Math.PI;
    const wobble = 1 + 0.22 * Math.sin(3 * angle) + 0.12 * Math.cos(2 * angle);
    const pLat = centerLat + Math.sin(angle) * radiusLat * wobble;
    const pLng = centerLng + Math.cos(angle) * radiusLng * wobble;
    points.push({ lat: Number(pLat.toFixed(5)), lng: Number(pLng.toFixed(5)), ele: Math.round(50 + 25 * Math.sin(angle)) });
  }
  points.push({ ...points[0] });
  return points;
}

function getLatLng(p) {
  if (!p) return null;
  if (Array.isArray(p) && p.length >= 2 && !isNaN(p[0]) && !isNaN(p[1])) return [Number(p[0]), Number(p[1])];
  if (typeof p === 'object' && p !== null && !isNaN(p.lat) && !isNaN(p.lng)) return [Number(p.lat), Number(p.lng)];
  return null;
}

function StokeLiveMap({
  path = [],
  routePath = [],
  userPos = null,
  setUserPos = () => {},
  setRoutePath = () => {},
  is3DTilted = false,
  mapTileType = "dark",
  simulating = false,
  runStage = "map_idle",
  flyoverActive = false,
  height = "100%"
}) {
  const containerRef = useRef(null);
  const mapRef = useRef(null);
  const tileLayerRef = useRef(null);
  const markerRef = useRef(null);
  const polylineRef = useRef(null);
  const [userPanned, setUserPanned] = useState(false);
  const userPannedRef = useRef(false);
  const lastPanPosRef = useRef(null);

  const initialCenter = userPos && userPos.length === 2 && !isNaN(userPos[0])
    ? [userPos[0], userPos[1]]
    : [VIKARABAD_SCENIC_ROUTE[0].lat, VIKARABAD_SCENIC_ROUTE[0].lng];

  useEffect(() => {
    if (!containerRef.current || typeof window === "undefined" || !window.L) return;
    if (!mapRef.current) {
      const map = L.map(containerRef.current, {
        zoomControl: false,
        attributionControl: false,
        fadeAnimation: true,
        scrollWheelZoom: false
      }).setView(initialCenter, 16);
      mapRef.current = map;

      const tileUrls = {
        dark: "https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Dark_Gray_Base/MapServer/tile/{z}/{y}/{x}",
        satellite: "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",
        topo: "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
      };

      const tileLayer = L.tileLayer(tileUrls[mapTileType] || tileUrls.dark, { maxZoom: 19, maxNativeZoom: 16 }).addTo(map);
      tileLayerRef.current = tileLayer;

      const runnerIcon = L.divIcon({
        className: "custom-runner-icon",
        html: `<div class="stoke-runner-beacon"><div class="stoke-runner-pulse"></div><div class="stoke-runner-dot"></div><div class="stoke-runner-beam"></div></div>`,
        iconSize: [28, 28],
        iconAnchor: [14, 14]
      });

      markerRef.current = L.marker(initialCenter, { icon: runnerIcon }).addTo(map);

      polylineRef.current = L.polyline([], {
        color: "#256BFD",
        weight: 5,
        opacity: 0.95,
        lineCap: "round",
        lineJoin: "round"
      }).addTo(map);

      // Listen to user map dragging/zooming to disable auto recenter fight
      map.on("dragstart movestart", (e) => {
        if (e.originalEvent) {
          userPannedRef.current = true;
          setUserPanned(true);
        }
      });
    }

    return () => {
      if (mapRef.current) {
        mapRef.current.remove();
        mapRef.current = null;
      }
    };
  }, []);

  useEffect(() => {
    if (!mapRef.current || !tileLayerRef.current || !window.L) return;
    const tileUrls = {
      dark: "https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Dark_Gray_Base/MapServer/tile/{z}/{y}/{x}",
      satellite: "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",
      topo: "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
    };
    tileLayerRef.current.setUrl(tileUrls[mapTileType] || tileUrls.dark);
  }, [mapTileType]);

  useEffect(() => {
    if (!mapRef.current || !window.L) return;

    let sourcePath = [];
    if (runStage === "map_active" || runStage === "paused" || simulating || runStage === "activity_detail") {
      sourcePath = (path && path.length > 1) ? path : [];
    }
    const latLngs = sourcePath.map(getLatLng);
    if (polylineRef.current) {
      polylineRef.current.setLatLngs(latLngs);
    }

    const currentPos = getLatLng(userPos);
    if (markerRef.current && currentPos) {
      markerRef.current.setLatLng(currentPos);

      // Follow runner smoothly only if user hasn't manually panned away
      if (!userPannedRef.current && !flyoverActive && mapRef.current) {
        if (runStage === "map_active" || runStage === "paused" || simulating) {
          let shouldPan = true;
          if (lastPanPosRef.current) {
            const dKm = haversineKm(
              { lat: lastPanPosRef.current[0], lng: lastPanPosRef.current[1] },
              { lat: currentPos[0], lng: currentPos[1] }
            );
            if (dKm * 1000 < 12) {
              shouldPan = false; // Deadband to avoid jerky camera shaking
            }
          }
          if (shouldPan) {
            mapRef.current.panTo(currentPos, { animate: true, duration: 0.9 });
            lastPanPosRef.current = currentPos;
          }
        }
      }
    }
  }, [path, routePath, userPos, flyoverActive, runStage, simulating]);

  const handleRecenter = () => {
    userPannedRef.current = false;
    setUserPanned(false);
    const currentPos = getLatLng(userPos);
    if (mapRef.current && currentPos) {
      mapRef.current.setView(currentPos, 16, { animate: true });
      lastPanPosRef.current = currentPos;
    }
  };

  return (
    <div style={{ position: "relative", width: "100%", height: height }}>
      <div
        ref={containerRef}
        style={{
          width: "100%",
          height: "100%",
          position: "relative",
          background: "#0B0E14",
          transform: is3DTilted ? "perspective(900px) rotateX(24deg) scale(1.05)" : "none",
          transition: "transform 0.4s cubic-bezier(0.4, 0, 0.2, 1)",
        }}
      />
      {userPanned && (
        <button
          onClick={handleRecenter}
          style={{
            position: "absolute",
            bottom: (runStage === "map_active" || runStage === "paused") ? 220 : 170,
            right: 14,
            zIndex: 1001,
            background: "#256BFD",
            border: "1px solid rgba(255,255,255,0.25)",
            color: "#FFF",
            padding: "8px 14px",
            borderRadius: 999,
            fontSize: 12,
            fontWeight: 800,
            cursor: "pointer",
            display: "flex",
            alignItems: "center",
            gap: 6,
            boxShadow: "0 4px 16px rgba(37,107,253,0.5)"
          }}
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round"><circle cx="12" cy="12" r="3"/><circle cx="12" cy="12" r="8"/><line x1="12" y1="2" x2="12" y2="4"/><line x1="12" y1="20" x2="12" y2="22"/><line x1="2" y1="12" x2="4" y2="12"/><line x1="20" y1="12" x2="22" y2="12"/></svg>
          <span>Re-center</span>
        </button>
      )}
    </div>
  );
}
// Compact canvas-based GPS route thumbnail for Activity History feed
function StokeRouteThumb({ path = [] }) {
  const canvasRef = useRef(null);
  useEffect(() => {
    if (!canvasRef.current || !path || path.length < 2) return;
    const canvas = canvasRef.current;
    const ctx = canvas.getContext("2d");
    const W = canvas.width;
    const H = canvas.height;
    ctx.clearRect(0, 0, W, H);

    const lats = path.map((p) => p.lat);
    const lngs = path.map((p) => p.lng);
    const minLat = Math.min(...lats), maxLat = Math.max(...lats);
    const minLng = Math.min(...lngs), maxLng = Math.max(...lngs);
    const pad = 10;
    const rangeX = maxLng - minLng || 0.0001;
    const rangeY = maxLat - minLat || 0.0001;
    const scale = Math.min((W - pad * 2) / rangeX, (H - pad * 2) / rangeY);

    const toX = (lng) => pad + (lng - minLng) * scale;
    const toY = (lat) => H - pad - (lat - minLat) * scale;

    // Route line
    ctx.beginPath();
    ctx.moveTo(toX(path[0].lng), toY(path[0].lat));
    for (let i = 1; i < path.length; i++) ctx.lineTo(toX(path[i].lng), toY(path[i].lat));
    ctx.strokeStyle = "#256BFD";
    ctx.lineWidth = 2.5;
    ctx.lineJoin = "round";
    ctx.lineCap = "round";
    ctx.stroke();

    // Start dot
    ctx.beginPath();
    ctx.arc(toX(path[0].lng), toY(path[0].lat), 4, 0, Math.PI * 2);
    ctx.fillStyle = "#22C55E";
    ctx.fill();

    // End dot
    ctx.beginPath();
    ctx.arc(toX(path[path.length - 1].lng), toY(path[path.length - 1].lat), 4, 0, Math.PI * 2);
    ctx.fillStyle = "#FF4040";
    ctx.fill();
  }, [path]);

  return <canvas ref={canvasRef} width={90} height={90} style={{ width: "100%", height: "100%", display: "block" }} />;
}

function RunScreen({
  profile,
  runs,
  setRuns,
  status,
  elapsed,
  distanceKm,
  setDistanceKm,
  gpsError,
  accuracy,
  gpsStatus = "acquiring",
  liveSpeed = 0,
  shareCardUrl,
  shareStyle,
  onChangeStyle,
  pathRef,
  handleStart,
  handlePause,
  handleResume,
  handleFinish,
  handleReset,
  liveGpsPos = null,
  runStartTimeRef = null,
  onNavigate,
  onBack
}) {
  const [activityType, setActivityType] = useState("run"); // "run" | "bike" | "walk"
  const [runStage, setRunStage] = useState("map_idle"); // "map_idle" | "map_active" | "hud_fullscreen" | "paused" | "save_form" | "celebration" | "activity_detail"
  const [mapTileType, setMapTileType] = useState("dark"); // "dark" | "satellite" | "topo"
  const [is3DTilted, setIs3DTilted] = useState(false);
  const simulating = false;
  const [flyoverActive, setFlyoverActive] = useState(false);
  const [audioCues, setAudioCues] = useState(true);
  const [selectedVoice, setSelectedVoice] = useState("lily"); // "lily" | "chloe" | "maya"
  const [showVoicePicker, setShowVoicePicker] = useState(false);
  const [kudosCount, setKudosCount] = useState(1);
  const [hasLiked, setHasLiked] = useState(false);
  const [activeSubTab, setActiveSubTab] = useState("tracker");

  // Global City & Real GPS State
  const [selectedCity, setSelectedCity] = useState(GLOBAL_RUN_CITIES[0]);
  const [showLocationPicker, setShowLocationPicker] = useState(false);
  const [citySearchQuery, setCitySearchQuery] = useState("");
  const [citySearchResults, setCitySearchResults] = useState([]);
  const [isSearchingCity, setIsSearchingCity] = useState(false);
  const [leaderboardFilter, setLeaderboardFilter] = useState("worldwide");

  // Live Leaflet Route & Marker State
  const [routePath, setRoutePath] = useState(VIKARABAD_SCENIC_ROUTE);
  const [userPos, setUserPos] = useState([VIKARABAD_SCENIC_ROUTE[0].lat, VIKARABAD_SCENIC_ROUTE[0].lng]);
  const [customSteps, setCustomSteps] = useState(0);

  // Sync userPos directly with real live outdoor GPS watchPosition
  useEffect(() => {
    if (liveGpsPos && Array.isArray(liveGpsPos) && liveGpsPos.length === 2 && !isNaN(liveGpsPos[0])) {
      setUserPos(liveGpsPos);
    }
  }, [liveGpsPos]);

  // Auto-detect real device GPS anywhere in the world on load
  useEffect(() => {
    if (navigator.geolocation) {
      navigator.geolocation.getCurrentPosition(
        (pos) => {
          const lat = pos.coords.latitude;
          const lng = pos.coords.longitude;
          const liveCity = {
            id: "my_gps",
            name: "Current GPS Location",
            country: "Live Position",
            lat,
            lng,
            flag: "📍",
            desc: "Device GPS tracking active"
          };
          setSelectedCity(liveCity);
          setUserPos([lat, lng]);
          setRoutePath(generateScenicLoop(lat, lng, 4.5));
          fetch(`https://nominatim.openstreetmap.org/reverse?lat=${lat}&lon=${lng}&format=json`)
            .then((r) => r.json())
            .then((data) => {
              const detectedCity = data.address?.city || data.address?.town || data.address?.suburb || data.address?.state_district || "Local Area";
              const detectedCountry = data.address?.country || "Earth";
              setSelectedCity({ ...liveCity, name: detectedCity, country: detectedCountry });
            })
            .catch(() => {});
        },
        () => {
          // If denied, default to Dubai Marina
          const fallback = GLOBAL_RUN_CITIES[1];
          setSelectedCity(fallback);
          setUserPos([fallback.lat, fallback.lng]);
          setRoutePath(generateScenicLoop(fallback.lat, fallback.lng, 5.0));
        },
        { enableHighAccuracy: true, timeout: 6000 }
      );
    }
  }, []);

  function selectGlobalCity(city) {
    if (city.id === "my_gps" || (city.lat === null && city.lng === null)) {
      if (navigator.geolocation) {
        navigator.geolocation.getCurrentPosition(
          (pos) => {
            const lat = pos.coords.latitude;
            const lng = pos.coords.longitude;
            const liveCity = {
              id: "my_gps",
              name: "My Live Location",
              country: "Real GPS",
              lat,
              lng,
              flag: "📍",
              desc: "Accurate real-time GPS tracking"
            };
            setSelectedCity(liveCity);
            setUserPos([lat, lng]);
            setRoutePath(generateScenicLoop(lat, lng, 4.5));
            setShowLocationPicker(false);
            fetch(`https://nominatim.openstreetmap.org/reverse?lat=${lat}&lon=${lng}&format=json`)
              .then((r) => r.json())
              .then((data) => {
                const detectedName = data.address?.city || data.address?.town || data.address?.suburb || "Local Area";
                const detectedCountry = data.address?.country || "Earth";
                setSelectedCity({ ...liveCity, name: detectedName, country: detectedCountry });
              })
              .catch(() => {});
          },
          () => {
            alert("Could not access GPS. Please check location permissions.");
          },
          { enableHighAccuracy: true, timeout: 10000 }
        );
      }
      return;
    }

    setSelectedCity(city);
    setUserPos([city.lat, city.lng]);
    setRoutePath(generateScenicLoop(city.lat, city.lng, 5.0));
    setShowLocationPicker(false);
  }

  async function handleCitySearch() {
    if (!citySearchQuery.trim()) return;
    setIsSearchingCity(true);
    try {
      const res = await fetch(`https://nominatim.openstreetmap.org/search?q=${encodeURIComponent(citySearchQuery)}&format=json&limit=5`);
      const data = await res.json();
      setCitySearchResults(data || []);
    } catch (e) {
      console.warn("City search error:", e);
    } finally {
      setIsSearchingCity(false);
    }
  }

  function handleSelectSearchResult(item) {
    const lat = parseFloat(item.lat);
    const lng = parseFloat(item.lon);
    const parts = item.display_name.split(",");
    const cityName = parts[0].trim();
    const countryName = parts[parts.length - 1].trim();
    const customCity = {
      id: `custom_${Date.now()}`,
      name: cityName,
      country: countryName,
      lat,
      lng,
      flag: "🌍",
      desc: item.display_name
    };
    setSelectedCity(customCity);
    setUserPos([lat, lng]);
    setRoutePath(generateScenicLoop(lat, lng, 4.8));
    setCitySearchResults([]);
    setCitySearchQuery("");
    setShowLocationPicker(false);
  }

  // Save Form Inputs
  const [activityTitle, setActivityTitle] = useState(() => getActivityTitleByTime(new Date(), activityType));
  const [activityDesc, setActivityDesc] = useState("");
  const [selectedTag, setSelectedTag] = useState("Workout");
  const [exertionRating, setExertionRating] = useState(5);
  const [privateNotes, setPrivateNotes] = useState("");
  const [selectedGear, setSelectedGear] = useState("Nike Air Zoom Pegasus 40");
  const [activityPhotos, setActivityPhotos] = useState([]);
  const [savedActivity, setSavedActivity] = useState(null);

  // Aliases for JSX bindings
  const perceivedExertion = exertionRating;
  const setPerceivedExertion = setExertionRating;

  // Story Generator State
  const [showStoryModal, setShowStoryModal] = useState(false);
  const [cardPhoto, setCardPhoto] = useState(null);
  const [generatedCardUrl, setGeneratedCardUrl] = useState(null);
  const fileInputRef = useRef(null);
  const photoUploadInputRef = useRef(null);
  const lastAnnouncedKmRef = useRef(0);
  const simIntervalRef = useRef(null);
  const [challenges, setChallenges] = useState(INITIAL_CHALLENGES);
  const [isPlayingMusic, setIsPlayingMusic] = useState(false);
  const [currentTrackIdx, setCurrentTrackIdx] = useState(0);

  const activePersona = GIRL_VOICES.find((v) => v.id === selectedVoice) || GIRL_VOICES[0];

  const metFactor = activityType === "bike" ? 0.55 : activityType === "walk" ? 0.75 : 1.036;
  const liveDist = distanceKm > 0 ? distanceKm : 0;
  const hasValidDistance = liveDist >= 0.03;
  const livePace = (hasValidDistance && elapsed > 0) ? (elapsed / 60 / liveDist) : 0;
  const liveCalories = Math.round(liveDist * RUNNER_WEIGHT_KG * metFactor);
  const liveSteps = Math.max(customSteps, Math.round(liveDist * (activityType === "walk" ? 1350 : 1240)));

  const pace = livePace;
  const calories = liveCalories;
  const paceMinPerKm = livePace;
  const speedKmh = hasValidDistance && elapsed > 0 ? (liveDist / (elapsed / 3600)) : 0;

  // Sync runStage with parent status
  useEffect(() => {
    if (status === "active" && runStage === "map_idle") {
      setRunStage("map_active");
    } else if (status === "paused" && runStage === "map_active") {
      setRunStage("paused");
    }
  }, [status]);

  // Live hardware accelerometer step counting when walking
  useEffect(() => {
    if (status !== "active" || activityType !== "walk") return;

    let lastAccel = 0;
    let lastStepTime = 0;
    const threshold = 1.8;

    const onMotion = (event) => {
      const acc = event.accelerationIncludingGravity || event.acceleration;
      if (!acc) return;
      const mag = Math.sqrt((acc.x || 0) ** 2 + (acc.y || 0) ** 2 + (acc.z || 0) ** 2);
      const delta = Math.abs(mag - lastAccel);
      lastAccel = mag;

      const now = Date.now();
      if (delta > threshold && now - lastStepTime > 320) {
        lastStepTime = now;
        setCustomSteps((s) => s + 1);
      }
    };

    if (typeof window !== "undefined" && window.DeviceMotionEvent) {
      window.addEventListener("devicemotion", onMotion, { passive: true });
    }

    return () => {
      if (typeof window !== "undefined" && window.DeviceMotionEvent) {
        window.removeEventListener("devicemotion", onMotion);
      }
    };
  }, [status, activityType]);

  // Voice announcements for split milestones
  useEffect(() => {
    if (status === "active" && audioCues && distanceKm >= 1) {
      const currentKm = Math.floor(distanceKm);
      if (currentKm > lastAnnouncedKmRef.current) {
        lastAnnouncedKmRef.current = currentKm;
        const paceM = Math.floor(paceMinPerKm);
        const paceS = Math.round((paceMinPerKm % 1) * 60);
        const msg = activePersona.splitMsg(currentKm, paceM, paceS, speedKmh, activityType === "bike");
        speakAudioCue(msg, selectedVoice);
      }
    }
  }, [distanceKm, status, audioCues, paceMinPerKm, speedKmh, activityType, selectedVoice, activePersona]);

  // Generate 9:16 Story Card
  useEffect(() => {
    if (showStoryModal || runStage === "activity_detail") {
      const activeDist = Number(liveDist.toFixed(2));
      const activeElapsed = elapsed > 0 ? elapsed : 1;
      const activePace = livePace;
      const activeSpeed = speedKmh;

      const loc = selectedCity ? `${selectedCity.name}, ${selectedCity.country}` : "Worldwide Athlete";
      const realPath = (pathRef && pathRef.current && pathRef.current.length > 1 && activeDist > 0.02)
        ? pathRef.current
        : (savedActivity?.path && savedActivity.path.length > 1 && (savedActivity.distance || savedActivity.distanceKm) > 0.02 ? savedActivity.path : []);

      const cardParams = {
        activityType,
        distanceKm: activeDist,
        elapsed: activeElapsed,
        paceMinPerKm: activePace,
        speedKmh: activeSpeed,
        path: realPath,
        style: cardPhoto ? "custom" : shareStyle,
        brand: "STOKE",
        customImage: null,
        athleteName: profile?.name || "Mohd Numan",
        location: loc
      };

      if (cardPhoto) {
        const img = new Image();
        img.onload = () => {
          cardParams.customImage = img;
          setGeneratedCardUrl(drawShareCard(cardParams));
        };
        img.src = cardPhoto;
      } else {
        setGeneratedCardUrl(drawShareCard(cardParams));
      }
    }
  }, [showStoryModal, runStage, distanceKm, elapsed, shareStyle, cardPhoto, activityType, selectedCity]);

  const onStartWithVoice = () => {
    lastAnnouncedKmRef.current = 0;
    setRunStage("map_active");
    if (audioCues) speakAudioCue(activePersona.startMsg(activityType), selectedVoice);
    handleStart();
    const now = new Date();
    setActivityTitle(getActivityTitleByTime(now, activityType));
  };

  const onPauseWithVoice = () => {
    setRunStage("paused");
    if (audioCues) speakAudioCue(activePersona.pauseMsg, selectedVoice);
    handlePause();
  };

  const onResumeWithVoice = () => {
    setRunStage("map_active");
    if (audioCues) speakAudioCue(activePersona.resumeMsg, selectedVoice);
    handleResume();
  };

  const onFinishWithVoice = () => {
    handleFinish();
    setRunStage("save_form");
    const startTime = (runStartTimeRef && runStartTimeRef.current) ? runStartTimeRef.current : new Date();
    setActivityTitle(getActivityTitleByTime(startTime, activityType));
    if (audioCues) {
      speakAudioCue(activePersona.finishMsg(Number(liveDist.toFixed(2)), liveSteps), selectedVoice);
    }
  };

  const handleSaveActivitySubmit = () => {
    const finalDist = Number(liveDist.toFixed(2));
    const finalElapsed = elapsed > 0 ? elapsed : 1;
    const finalPace = (finalDist >= 0.03 && finalElapsed > 0) ? (finalElapsed / 60 / finalDist) : 0;
    const finalCalories = liveCalories;
    const finalSteps = liveSteps;
    const finalPath = (pathRef && pathRef.current && pathRef.current.length > 1 && finalDist > 0.02) ? [...pathRef.current] : [];

    const startTime = (runStartTimeRef && runStartTimeRef.current) ? runStartTimeRef.current : new Date();
    const endTime = new Date();
    const autoTitle = getActivityTitleByTime(startTime, activityType);
    const finalTitle = (activityTitle && activityTitle.trim() && activityTitle !== "Afternoon Run" && activityTitle !== "Evening Run")
      ? activityTitle
      : autoTitle;

    const speedKmhFinal = (finalElapsed > 0 && finalDist >= 0.03) ? (finalDist / (finalElapsed / 3600)) : 0;
    const dtInfo = formatRunDateTime(startTime);
    const locString = selectedCity ? `${selectedCity.name}, ${selectedCity.country}` : "Worldwide GPS";

    const newActivity = {
      id: Date.now(),
      title: finalTitle,
      description: activityDesc,
      sport: activityType,
      distance: finalDist,
      distanceKm: finalDist,
      time: finalElapsed,
      elapsed: finalElapsed,
      pace: finalPace,
      paceMinPerKm: finalPace,
      speedKmh: speedKmhFinal,
      calories: finalCalories,
      elevationGain: Math.max(1, Math.round(finalDist * 16)),
      maxElevation: 682,
      steps: finalSteps,
      tag: selectedTag,
      exertion: exertionRating,
      notes: privateNotes,
      gear: selectedGear,
      path: finalPath,
      photos: activityPhotos,
      athleteName: profile && profile.name ? profile.name : "Athlete",
      location: locString,
      startTime: startTime.toISOString(),
      endTime: endTime.toISOString(),
      timeOfDay: getTimeOfDay(startTime),
      date: dtInfo.datePrefix,
      dateLabel: dtInfo.datePrefix,
      timeLabel: dtInfo.timeLabel,
      dateStr: `${dtInfo.fullLabel} · ${locString}`,
      activityType: activityType
    };

    setSavedActivity(newActivity);
    setActivityTitle(finalTitle);

    setRuns((prev) => {
      const updated = [newActivity, ...prev];
      try { localStorage.setItem("stoke_runs_v2", JSON.stringify(updated)); } catch {}
      return updated;
    });

    setRunStage("celebration");
    setTimeout(() => {
      setRunStage("activity_detail");
    }, 2200);
  };
  const handleSaveActivity = handleSaveActivitySubmit;

  const toggleLayerStyle = () => {
    setMapTileType((prev) => (prev === "dark" ? "satellite" : prev === "satellite" ? "topo" : "dark"));
  };

  const handlePhotoAdd = (e) => {
    const file = e.target.files && e.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = (evt) => {
      setActivityPhotos((prev) => [...prev, evt.target.result]);
    };
    reader.readAsDataURL(file);
  };

  const handleStoryPhotoUpload = (e) => {
    const file = e.target.files && e.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = (evt) => {
      setCardPhoto(evt.target.result);
      onChangeStyle("custom");
    };
    reader.readAsDataURL(file);
  };

  const activeDistDisplay = Number(liveDist.toFixed(2));
  const activeElapsedDisplay = elapsed;
  const activePaceDisplay = livePace;

  function handlePhotoUpload(e) {
    const file = e.target.files && e.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = (event) => {
      const dataUri = event.target.result;
      setCardPhoto(dataUri);
      onChangeStyle("custom");

      const img = new Image();
      img.onload = () => {
        const activeDist = Number(liveDist.toFixed(2));
        const activeElapsed = elapsed > 0 ? elapsed : 1;
        const loc = selectedCity ? `${selectedCity.name}, ${selectedCity.country}` : "Worldwide Athlete";
        const realPath = (pathRef && pathRef.current && pathRef.current.length > 1 && activeDist > 0.02)
          ? pathRef.current
          : (savedActivity?.path && savedActivity.path.length > 1 && (savedActivity.distance || savedActivity.distanceKm) > 0.02 ? savedActivity.path : []);
        const cardParams = {
          activityType,
          distanceKm: activeDist,
          elapsed: activeElapsed,
          paceMinPerKm: livePace,
          speedKmh,
          path: realPath,
          style: "custom",
          brand: "STOKE",
          customImage: img,
          athleteName: profile?.name || "Mohd Numan",
          location: loc
        };
        const generated = drawShareCard(cardParams);
        setGeneratedCardUrl(generated);
      };
      img.src = dataUri;
    };
    reader.readAsDataURL(file);
  }

  async function handleShare() {
    const urlToShare = generatedCardUrl || shareCardUrl;
    if (!urlToShare) return;
    try {
      const blob = await (await fetch(urlToShare)).blob();
      const filename = `stoke-${activityType}-story.png`;
      const file = new File([blob], filename, { type: "image/png" });
      if (navigator.canShare && navigator.canShare({ files: [file] })) {
        await navigator.share({
          files: [file],
          title: `My STOKE ${activityType.toUpperCase()} Activity`,
          text: `Crushed a ${distanceKm.toFixed(2)} km ${activityType}! ⚡🔥`,
        });
      } else {
        const a = document.createElement("a");
        a.href = urlToShare;
        a.download = filename;
        a.click();
      }
    } catch (err) {
      console.log("Share skipped", err);
    }
  }

  function toggleJoinChallenge(id) {
    setChallenges((prev) =>
      prev.map((c) => (c.id === id ? { ...c, joined: !c.joined, participants: c.joined ? c.participants - 1 : c.participants + 1 } : c))
    );
  }

  const ACTIVITIES = [
    { key: "run", label: "Run", sport: "RUN", unit: "/km pace", desc: "Pace & Splits" },
    { key: "bike", label: "Bike / Ride", sport: "RIDE", unit: "km/h speed", desc: "Speed & Distance" },
    { key: "walk", label: "Walk", sport: "WALK", unit: "steps count", desc: "Steps & Active Time" },
  ];
  const currentTrack = WORKOUT_TRACKS[currentTrackIdx];

  return (
    <div style={{ position: "relative", minHeight: "100vh", paddingBottom: 60 }}>
      {/* Voice Coach Picker Modal */}
      {showVoicePicker && (
        <div style={{ position: "fixed", inset: 0, zIndex: 9999, background: "rgba(0,0,0,0.85)", backdropFilter: "blur(8px)", display: "flex", alignItems: "center", justifyContent: "center", padding: 16 }}>
          <div style={{ background: "#13171F", border: `1px solid rgba(255,128,191,0.4)`, borderRadius: 22, padding: 22, maxWidth: 380, width: "100%", boxShadow: "0 20px 50px rgba(0,0,0,0.8)" }}>
            <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 14 }}>
              <div style={{ display: "flex", alignItems: "center", gap: 8 }}>
                <span style={{ fontSize: 20 }}>🎀</span>
                <div>
                  <div style={{ fontSize: 16, fontWeight: 800, color: TOKENS.text }}>Choose Voice Coach</div>
                  <div style={{ fontSize: 11, color: TOKENS.mutedFaint }}>Pick your favorite cute voice personality</div>
                </div>
              </div>
              <button onClick={() => setShowVoicePicker(false)} style={{ background: "rgba(255,255,255,0.1)", border: "none", color: "#fff", width: 28, height: 28, borderRadius: "50%", cursor: "pointer", fontSize: 14 }}>✕</button>
            </div>

            <div style={{ display: "flex", flexDirection: "column", gap: 10, marginBottom: 16 }}>
              {GIRL_VOICES.map((v) => {
                const isSelected = selectedVoice === v.id;
                return (
                  <div
                    key={v.id}
                    onClick={() => {
                      setSelectedVoice(v.id);
                      speakAudioCue(v.preview, v.id);
                    }}
                    style={{
                      display: "flex",
                      alignItems: "center",
                      justifyContent: "space-between",
                      padding: "12px 14px",
                      borderRadius: 14,
                      background: isSelected ? "rgba(255, 128, 191, 0.15)" : "rgba(255,255,255,0.03)",
                      border: isSelected ? `1.5px solid #FF80BF` : `1px solid rgba(255,255,255,0.06)`,
                      cursor: "pointer",
                      transition: "all 0.15s ease",
                    }}
                  >
                    <div style={{ display: "flex", alignItems: "center", gap: 10 }}>
                      <div style={{ width: 38, height: 38, borderRadius: 12, background: isSelected ? "rgba(255,128,191,0.25)" : "rgba(255,255,255,0.06)", display: "flex", alignItems: "center", justifyContent: "center", fontSize: 20 }}>
                        {v.avatar}
                      </div>
                      <div>
                        <div style={{ fontSize: 13.5, fontWeight: 800, color: isSelected ? "#FF80BF" : TOKENS.text }}>
                          Coach {v.name}
                        </div>
                        <div style={{ fontSize: 11, color: TOKENS.mutedFaint }}>{v.tag}</div>
                      </div>
                    </div>

                    <button
                      onClick={(e) => {
                        e.stopPropagation();
                        setSelectedVoice(v.id);
                        speakAudioCue(v.preview, v.id);
                      }}
                      style={{
                        padding: "5px 10px",
                        borderRadius: 8,
                        background: isSelected ? "#FF80BF" : "rgba(255,255,255,0.08)",
                        color: isSelected ? "#000" : TOKENS.text,
                        border: "none",
                        fontSize: 11,
                        fontWeight: 700,
                        cursor: "pointer",
                      }}
                    >
                      ▶ Listen
                    </button>
                  </div>
                );
              })}
            </div>

            <button
              onClick={() => setShowVoicePicker(false)}
              style={{ width: "100%", padding: "12px 0", borderRadius: 12, background: TOKENS.ember, border: "none", color: "#0B0E13", fontWeight: 800, fontSize: 13.5, cursor: "pointer" }}
            >
              ✓ Set Active Coach
            </button>
          </div>
        </div>
      )}

      {/* Worldwide Running Location Picker Modal */}
      {showLocationPicker && (
        <div style={{ position: "fixed", inset: 0, zIndex: 99999, background: "rgba(0,0,0,0.88)", backdropFilter: "blur(10px)", display: "flex", alignItems: "center", justifyContent: "center", padding: 16 }}>
          <div style={{ background: "#11151D", border: `1px solid rgba(255,255,255,0.15)`, borderRadius: 24, padding: 22, maxWidth: 440, width: "100%", maxHeight: "88vh", overflowY: "auto", boxShadow: "0 24px 60px rgba(0,0,0,0.9)" }}>
            <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 14 }}>
              <div style={{ display: "flex", alignItems: "center", gap: 8 }}>
                <span style={{ fontSize: 24 }}>🌍</span>
                <div>
                  <div style={{ fontSize: 17, fontWeight: 900, color: TOKENS.text }}>Choose Running Location</div>
                  <div style={{ fontSize: 11, color: TOKENS.mutedFaint }}>Run anywhere in the world with live GPS & routes</div>
                </div>
              </div>
              <button onClick={() => setShowLocationPicker(false)} style={{ background: "rgba(255,255,255,0.1)", border: "none", color: "#fff", width: 28, height: 28, borderRadius: "50%", cursor: "pointer", fontSize: 14 }}>✕</button>
            </div>

            {/* City Search Bar */}
            <div style={{ display: "flex", gap: 8, marginBottom: 16 }}>
              <input
                type="text"
                value={citySearchQuery}
                onChange={(e) => setCitySearchQuery(e.target.value)}
                onKeyDown={(e) => { if (e.key === "Enter") handleCitySearch(); }}
                placeholder="Search any city or country worldwide..."
                style={{ flex: 1, background: "rgba(255,255,255,0.06)", border: `1px solid rgba(255,255,255,0.15)`, borderRadius: 12, padding: "10px 14px", color: "#FFF", fontSize: 13, outline: "none" }}
              />
              <button
                onClick={handleCitySearch}
                style={{ background: "linear-gradient(135deg, #256BFD 0%, #1A5EE5 100%)", border: "none", color: "#FFFFFF", padding: "0 16px", borderRadius: 12, fontWeight: 800, fontSize: 13, cursor: "pointer" }}
              >
                {isSearchingCity ? "..." : "Search"}
              </button>
            </div>

            {/* Search Results if any */}
            {citySearchResults.length > 0 && (
              <div style={{ marginBottom: 16, background: "rgba(255,255,255,0.04)", borderRadius: 16, border: `1px solid rgba(255,255,255,0.1)`, padding: 8 }}>
                <div style={{ fontSize: 11, fontWeight: 800, color: "#256BFD", padding: "4px 8px 6px" }}>SEARCH RESULTS</div>
                {citySearchResults.map((item, idx) => (
                  <div
                    key={idx}
                    onClick={() => handleSelectSearchResult(item)}
                    style={{ padding: "10px 12px", borderRadius: 10, cursor: "pointer", display: "flex", alignItems: "center", gap: 10, borderBottom: idx < citySearchResults.length - 1 ? "1px solid rgba(255,255,255,0.06)" : "none" }}
                  >
                    <span style={{ fontSize: 18 }}>📍</span>
                    <div style={{ flex: 1, overflow: "hidden" }}>
                      <div style={{ fontSize: 13, fontWeight: 800, color: "#FFF", textOverflow: "ellipsis", overflow: "hidden", whiteSpace: "nowrap" }}>{item.display_name.split(",")[0]}</div>
                      <div style={{ fontSize: 10.5, color: TOKENS.mutedFaint, textOverflow: "ellipsis", overflow: "hidden", whiteSpace: "nowrap" }}>{item.display_name}</div>
                    </div>
                    <span style={{ fontSize: 12, color: "#256BFD", fontWeight: 800 }}>Select →</span>
                  </div>
                ))}
              </div>
            )}

            {/* Real Device GPS Button */}
            <div
              onClick={() => selectGlobalCity(GLOBAL_RUN_CITIES[0])}
              style={{
                display: "flex",
                alignItems: "center",
                gap: 12,
                padding: "14px 16px",
                borderRadius: 16,
                background: selectedCity?.id === "my_gps" ? "rgba(34,197,94,0.18)" : "rgba(255,255,255,0.04)",
                border: `1.5px solid ${selectedCity?.id === "my_gps" ? "#22C55E" : "rgba(255,255,255,0.1)"}`,
                cursor: "pointer",
                marginBottom: 16,
                boxShadow: selectedCity?.id === "my_gps" ? "0 0 16px rgba(34,197,94,0.3)" : "none"
              }}
            >
              <div style={{ width: 40, height: 40, borderRadius: 12, background: "#22C55E", display: "flex", alignItems: "center", justifyContent: "center", fontSize: 20 }}>
                📍
              </div>
              <div style={{ flex: 1 }}>
                <div style={{ fontSize: 14, fontWeight: 900, color: "#FFF", display: "flex", alignItems: "center", gap: 6 }}>
                  <span>Use My Live GPS (Anywhere on Earth)</span>
                  <span style={{ background: "#22C55E", color: "#000", fontSize: 9, fontWeight: 900, padding: "2px 6px", borderRadius: 999 }}>LIVE</span>
                </div>
                <div style={{ fontSize: 11, color: TOKENS.mutedFaint }}>Detects your real latitude & longitude automatically</div>
              </div>
            </div>

            {/* Curated Global Running Capitals */}
            <div style={{ fontSize: 11.5, fontWeight: 800, color: TOKENS.mutedFaint, textTransform: "uppercase", letterSpacing: 0.8, marginBottom: 10 }}>
              World-Famous Running Capitals
            </div>

            <div style={{ display: "flex", flexDirection: "column", gap: 8 }}>
              {GLOBAL_RUN_CITIES.filter((c) => c.id !== "my_gps").map((city) => {
                const isSelected = selectedCity?.id === city.id;
                return (
                  <div
                    key={city.id}
                    onClick={() => selectGlobalCity(city)}
                    style={{
                      display: "flex",
                      alignItems: "center",
                      justifyContent: "space-between",
                      padding: "11px 14px",
                      borderRadius: 14,
                      background: isSelected ? "rgba(37, 107, 253,0.18)" : "rgba(255,255,255,0.03)",
                      border: isSelected ? `1.5px solid #256BFD` : `1px solid rgba(255,255,255,0.06)`,
                      cursor: "pointer",
                      transition: "all 0.15s ease"
                    }}
                  >
                    <div style={{ display: "flex", alignItems: "center", gap: 10 }}>
                      <span style={{ fontSize: 24 }}>{city.flag}</span>
                      <div>
                        <div style={{ fontSize: 13.5, fontWeight: 800, color: isSelected ? "#256BFD" : "#FFF" }}>{city.name}</div>
                        <div style={{ fontSize: 11, color: TOKENS.mutedFaint }}>{city.country} • {city.desc}</div>
                      </div>
                    </div>
                    {isSelected && <span style={{ color: "#256BFD", fontWeight: 900, fontSize: 14 }}>✓</span>}
                  </div>
                );
              })}
            </div>
          </div>
        </div>
      )}

      {/* Top Segmented Bar: Workout | Run */}
      {runStage !== "hud_fullscreen" && runStage !== "save_form" && runStage !== "celebration" && (
        <div style={{ display: "flex", background: "rgba(255,255,255,0.06)", borderRadius: 14, padding: 3, marginBottom: 14, border: "1px solid rgba(255,255,255,0.08)" }}>
          <button
            type="button"
            onClick={() => onNavigate && onNavigate("workout")}
            style={{
              flex: 1,
              padding: "9px 0",
              borderRadius: 11,
              border: "none",
              background: "transparent",
              color: "rgba(255,255,255,0.6)",
              fontWeight: 700,
              fontSize: 12.5,
              cursor: "pointer",
              display: "flex",
              alignItems: "center",
              justifyContent: "center",
              gap: 6,
              transition: "all 0.2s ease"
            }}
            onMouseEnter={(e) => { e.currentTarget.style.color = "#3B82F6"; }}
            onMouseLeave={(e) => { e.currentTarget.style.color = "rgba(255,255,255,0.6)"; }}
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><circle cx="5" cy="12" r="2.2" /><circle cx="19" cy="12" r="2.2" /><line x1="7.2" y1="12" x2="16.8" y2="12" /><line x1="5" y1="9.3" x2="5" y2="14.7" /><line x1="19" y1="9.3" x2="19" y2="14.7" /></svg> <span>Workout Plan</span>
          </button>
          <button
            type="button"
            style={{
              flex: 1,
              padding: "9px 0",
              borderRadius: 11,
              border: "none",
              background: "linear-gradient(135deg, #256BFD 0%, #1A5EE5 100%)",
              color: "#FFFFFF",
              fontWeight: 800,
              fontSize: 12.5,
              cursor: "pointer",
              display: "flex",
              alignItems: "center",
              justifyContent: "center",
              gap: 6,
              boxShadow: "0 2px 10px rgba(37,107,253,0.35)"
            }}
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><circle cx="15.5" cy="5" r="1.8" /><path d="M9 20l2.5-5.5 2 1.8 3.5-1" /><path d="M7 13.5l3.5-2.5 2 2.5-2.5 3.5" /></svg> <span>Run & GPS</span></button>
        </div>
      )}

      {/* Top Header & Sub-Nav Switcher */}
      {runStage !== "hud_fullscreen" && runStage !== "save_form" && runStage !== "celebration" && (
        <ScreenHeader
          title={activityType === "run" ? "Running" : activityType === "bike" ? "Cycling & Riding" : "Walking"}
          subtitle="STOKE ⚡ LIVE GPS"
          onBack={onBack}
          canGoBack={true}
          rightAction={
            <div style={{ display: "flex", gap: 6, alignItems: "center" }}>
              {/* Global City Switcher Button */}
              <button
                onClick={() => setShowLocationPicker(true)}
                style={{
                  display: "flex",
                  alignItems: "center",
                  gap: 5,
                  padding: "6px 11px",
                  borderRadius: 999,
                  border: `1px solid rgba(255,255,255,0.15)`,
                  background: "rgba(255,255,255,0.06)",
                  color: "#FFF",
                  fontSize: 11,
                  fontWeight: 700,
                  cursor: "pointer",
                  maxWidth: 140,
                  overflow: "hidden",
                  whiteSpace: "nowrap"
                }}
                title="Change Running City Worldwide"
              >
                <span>{selectedCity?.flag || "🌍"}</span>
                <span style={{ overflow: "hidden", textOverflow: "ellipsis" }}>{selectedCity ? selectedCity.name.split(" ")[0] : "World"}</span>
                <span style={{ fontSize: 9.5, opacity: 0.8 }}>▼</span>
              </button>

              <button
                onClick={() => setShowVoicePicker(true)}
                style={{
                  display: "flex",
                  alignItems: "center",
                  gap: 5,
                  padding: "6px 11px",
                  borderRadius: 999,
                  border: `1px solid ${audioCues ? "#FF80BF" : TOKENS.border}`,
                  background: audioCues ? "rgba(255, 128, 191, 0.16)" : "rgba(255,255,255,0.04)",
                  color: audioCues ? "#FF80BF" : TOKENS.muted,
                  fontSize: 11,
                  fontWeight: 700,
                  cursor: "pointer",
                }}
              >
                <span>{activePersona.avatar} {activePersona.name}</span>
                <span style={{ fontSize: 9.5, opacity: 0.8 }}>▼</span>
              </button>
            </div>
          }
        />
      )}


      {/* Hub Sub-Tabs: Tracker · Challenges · Leaderboard */}
      <div style={{ display: "flex", gap: 6, background: "rgba(255,255,255,0.04)", padding: 4, borderRadius: 14, border: `1px solid ${TOKENS.border}`, marginBottom: 16 }}>
        {[
          { key: "tracker", label: "⚡ Live GPS Tracker" },
          { key: "challenges", label: "🏆 Challenges" },
          { key: "leaderboard", label: "👑 Leaderboard" },
        ].map((t) => (
          <button
            key={t.key}
            onClick={() => setActiveSubTab(t.key)}
            style={{
              flex: 1,
              padding: "7px 0",
              borderRadius: 10,
              border: "none",
              background: activeSubTab === t.key ? "#256BFD" : "transparent",
              color: activeSubTab === t.key ? "#FFFFFF" : TOKENS.muted,
              fontSize: 11.5,
              fontWeight: 800,
              cursor: "pointer",
              transition: "all 0.2s ease",
            }}
          >
            {t.label}
          </button>
        ))}
      </div>

      {/* SUB-TAB 1: LIVE TRACKER */}
      {activeSubTab === "tracker" && (
        <div>
          {/* STAGE 1: MAP IDLE & MAP ACTIVE & PAUSED */}
          {(runStage === "map_idle" || runStage === "map_active" || runStage === "paused") && (
            <div style={{ position: "relative", width: "100%", height: "calc(100vh - 210px)", minHeight: 480, borderRadius: 24, overflow: "hidden", border: `1px solid ${TOKENS.border}`, boxShadow: "0 12px 36px rgba(0,0,0,0.6)" }}>
              {/* Leaflet Map */}
              <StokeLiveMap
                path={pathRef && pathRef.current ? [...pathRef.current] : []}
                userPos={userPos}
                setUserPos={setUserPos}
                routePath={[]}
                setRoutePath={setRoutePath}
                is3DTilted={is3DTilted}
                mapTileType={mapTileType}
                simulating={simulating}
                runStage={runStage}
              />

              {/* GPS Accuracy Status Pill Top Center */}
              {runStage === "map_active" && (
                <div style={{ position: "absolute", top: 14, left: "50%", transform: "translateX(-50%)", zIndex: 1000, display: "flex", alignItems: "center", gap: 6, background: "rgba(0,0,0,0.8)", backdropFilter: "blur(10px)", padding: "6px 14px", borderRadius: 999, border: gpsStatus === "ready" ? "1px solid rgba(34,197,94,0.5)" : gpsStatus === "weak" ? "1px solid rgba(239,68,68,0.5)" : "1px solid rgba(234,179,8,0.5)", boxShadow: "0 4px 16px rgba(0,0,0,0.5)" }}>
                  <div style={{ width: 7, height: 7, borderRadius: "50%", background: gpsStatus === "ready" ? "#22C55E" : gpsStatus === "weak" ? "#EF4444" : "#EAB308", animation: gpsStatus === "ready" ? "none" : "pulse 1.2s infinite" }} />
                  <span style={{ fontSize: 11, fontWeight: 800, color: "#FFF", letterSpacing: 0.3 }}>
                    {gpsStatus === "ready" ? `GPS Ready${accuracy ? ` (±${Math.round(accuracy)}m)` : ""}` : gpsStatus === "weak" ? `Weak GPS${accuracy ? ` (±${Math.round(accuracy)}m)` : ""}` : "Acquiring GPS..."}
                  </span>
                </div>
              )}
              {/* Map Floating Controls Top Right */}
              <div style={{ position: "absolute", top: 14, right: 14, zIndex: 1000, display: "flex", flexDirection: "column", gap: 8 }}>
                <button
                  onClick={toggleLayerStyle}
                  title="Layer Switcher (Dark/Sat/Topo)"
                  style={{ width: 40, height: 40, borderRadius: 12, background: "rgba(11,14,19,0.85)", backdropFilter: "blur(8px)", border: `1px solid rgba(255,255,255,0.15)`, color: "#FFF", fontSize: 16, fontWeight: 800, cursor: "pointer", display: "flex", alignItems: "center", justifyContent: "center", boxShadow: "0 4px 12px rgba(0,0,0,0.4)" }}
                >
                  {mapTileType === "dark" ? "🗺️" : mapTileType === "satellite" ? "🛰️" : "⛰️"}
                </button>
                <button
                  onClick={() => setIs3DTilted(!is3DTilted)}
                  title="3D Tilt Toggle"
                  style={{ width: 40, height: 40, borderRadius: 12, background: is3DTilted ? "#256BFD" : "rgba(11,14,19,0.85)", backdropFilter: "blur(8px)", border: `1px solid ${is3DTilted ? "#256BFD" : "rgba(255,255,255,0.15)"}`, color: "#FFFFFF", fontSize: 13, fontWeight: 800, cursor: "pointer", display: "flex", alignItems: "center", justifyContent: "center", boxShadow: "0 4px 12px rgba(0,0,0,0.4)" }}
                >
                  3D
                </button>
                <button
                  onClick={() => setShowLocationPicker(true)}
                  title="Choose City Worldwide"
                  style={{ width: 40, height: 40, borderRadius: 12, background: "rgba(11,14,19,0.85)", backdropFilter: "blur(8px)", border: `1px solid rgba(255,255,255,0.15)`, color: "#FFF", fontSize: 16, cursor: "pointer", display: "flex", alignItems: "center", justifyContent: "center", boxShadow: "0 4px 12px rgba(0,0,0,0.4)" }}
                >
                  🌍
                </button>
                <button
                  onClick={() => {
                    if (userPos) {
                      setUserPos([...userPos]);
                    }
                  }}
                  title="Recenter Map"
                  style={{ width: 40, height: 40, borderRadius: 12, background: "rgba(11,14,19,0.85)", backdropFilter: "blur(8px)", border: `1px solid rgba(255,255,255,0.15)`, color: "#FFF", fontSize: 16, cursor: "pointer", display: "flex", alignItems: "center", justifyContent: "center", boxShadow: "0 4px 12px rgba(0,0,0,0.4)" }}
                >
                  🎯
                </button>
              </div>

              {/* Status Banner overlay for Paused State */}
              {runStage === "paused" && (
                <div style={{ position: "absolute", top: 14, left: 14, right: 70, zIndex: 1000, background: "rgba(234, 179, 8, 0.9)", backdropFilter: "blur(8px)", padding: "8px 16px", borderRadius: 14, color: "#000", fontWeight: 800, fontSize: 13, display: "flex", alignItems: "center", gap: 8, boxShadow: "0 4px 16px rgba(0,0,0,0.4)" }}>
                  <span>⏸ PAUSED</span>
                  <span style={{ fontSize: 11, opacity: 0.8, fontWeight: 600 }}>- Take a breath or finish your run</span>
                </div>
              )}

              {/* BOTTOM FLOATING HUD CARD (Idle / Active / Paused) */}
              <div style={{ position: "absolute", bottom: 0, left: 0, right: 0, zIndex: 1000, background: "rgba(11, 14, 19, 0.92)", backdropFilter: "blur(16px) saturate(180%)", WebkitBackdropFilter: "blur(16px) saturate(180%)", borderTop: `1px solid rgba(255,255,255,0.12)`, padding: "16px 20px 24px", borderTopLeftRadius: 28, borderTopRightRadius: 28, boxShadow: "0 -10px 40px rgba(0,0,0,0.8)" }}>

                {/* IDLE BOTTOM CARD */}
                {runStage === "map_idle" && (
                  <div>
                    <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 14 }}>
                      <div style={{ display: "flex", alignItems: "center", gap: 6, background: "rgba(34, 197, 94, 0.15)", border: "1px solid rgba(34, 197, 94, 0.3)", padding: "4px 10px", borderRadius: 999 }}>
                        <div style={{ width: 8, height: 8, borderRadius: "50%", background: "#22C55E", boxShadow: "0 0 8px #22C55E" }} />
                        <span style={{ fontSize: 11, fontWeight: 800, color: "#22C55E", letterSpacing: 0.5 }}>GPS ACQUIRED</span>
                      </div>

                      <button
                        onClick={() => setRunStage("hud_fullscreen")}
                        style={{ background: "rgba(255,255,255,0.06)", border: "1px solid rgba(255,255,255,0.1)", color: TOKENS.text, padding: "5px 12px", borderRadius: 999, fontSize: 11, fontWeight: 700, cursor: "pointer", display: "flex", alignItems: "center", gap: 4 }}
                      >
                        <span>Fullscreen HUD</span>
                        <span>⤢</span>
                      </button>
                    </div>

                    {/* Sport Picker Row */}
                    <div style={{ display: "flex", gap: 8, marginBottom: 16 }}>
                      {ACTIVITIES.map((act) => {
                        const active = activityType === act.key;
                        return (
                          <button
                            key={act.key}
                            onClick={() => setActivityType(act.key)}
                            style={{
                              flex: 1,
                              display: "flex",
                              alignItems: "center",
                              justifyContent: "center",
                              gap: 6,
                              padding: "9px 0",
                              borderRadius: 12,
                              background: active ? "rgba(37, 107, 253,0.18)" : "rgba(255,255,255,0.04)",
                              border: active ? "1.5px solid #256BFD" : "1px solid rgba(255,255,255,0.06)",
                              color: active ? "#256BFD" : TOKENS.muted,
                              fontSize: 12.5,
                              fontWeight: 800,
                              cursor: "pointer",
                            }}
                          >
                            <span>{act.label}</span>
                          </button>
                        );
                      })}
                    </div>

                    {/* Metrics 3-column & Big Start Button */}
                    <div style={{ display: "flex", alignItems: "center", justifyContent: "space-between" }}>
                      <div style={{ display: "flex", gap: 20 }}>
                        <div>
                          <div style={{ fontSize: 10, color: TOKENS.mutedFaint, textTransform: "uppercase", fontWeight: 800 }}>TIME</div>
                          <div style={{ fontSize: 20, fontWeight: 900, color: TOKENS.text, fontFamily: "monospace" }}>00:00</div>
                        </div>
                        <div>
                          <div style={{ fontSize: 10, color: TOKENS.mutedFaint, textTransform: "uppercase", fontWeight: 800 }}>{activityType === "walk" ? "👟 STEPS" : activityType === "bike" ? "SPEED" : "AVG PACE"}</div>
                          <div style={{ fontSize: 20, fontWeight: 900, color: activityType === "walk" ? "#256BFD" : TOKENS.text, fontFamily: "monospace" }}>
                            {activityType === "walk" ? "0" : activityType === "bike" ? "0.0 km/h" : "--:--"}
                          </div>
                        </div>
                        <div>
                          <div style={{ fontSize: 10, color: TOKENS.mutedFaint, textTransform: "uppercase", fontWeight: 800 }}>DIST (KM)</div>
                          <div style={{ fontSize: 20, fontWeight: 900, color: TOKENS.text, fontFamily: "monospace" }}>0.00</div>
                        </div>
                      </div>

                      <button
                        onClick={onStartWithVoice}
                        style={{
                          width: 72,
                          height: 72,
                          borderRadius: "50%",
                          background: "linear-gradient(135deg, #256BFD 0%, #1A5EE5 100%)",
                          border: "none",
                          color: "#0B0E13",
                          fontWeight: 900,
                          fontSize: 14,
                          cursor: "pointer",
                          boxShadow: "0 0 24px rgba(37, 107, 253,0.6)",
                          display: "flex",
                          flexDirection: "column",
                          alignItems: "center",
                          justifyContent: "center",
                          letterSpacing: 0.5,
                          transition: "transform 0.15s ease",
                        }}
                      >
                        <span style={{ fontSize: 16, marginBottom: -2 }}>▶</span>
                        <span>START</span>
                      </button>
                    </div>
                  </div>
                )}

                {/* ACTIVE BOTTOM CARD */}
                {runStage === "map_active" && (
                  <div>
                    <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 14 }}>
                      <div style={{ display: "flex", alignItems: "center", gap: 6 }}>
                        <div style={{ width: 10, height: 10, borderRadius: "50%", background: "#256BFD", animation: "pulse 1.2s infinite" }} />
                        <span style={{ fontSize: 12, fontWeight: 900, color: "#256BFD", letterSpacing: 0.8, textTransform: "uppercase" }}>STOKE LIVE RECORDING</span>
                      </div>
                      <button
                        onClick={() => setRunStage("hud_fullscreen")}
                        style={{ background: "rgba(255,255,255,0.08)", border: "1px solid rgba(255,255,255,0.15)", color: TOKENS.text, padding: "6px 14px", borderRadius: 999, fontSize: 11.5, fontWeight: 800, cursor: "pointer", display: "flex", alignItems: "center", gap: 5 }}
                      >
                        <span>OLED HUD</span>
                        <span>⤢</span>
                      </button>
                    </div>

                    <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr 1fr", gap: 12, marginBottom: 16 }}>
                      <div style={{ background: "rgba(255,255,255,0.03)", padding: "10px 12px", borderRadius: 14, border: "1px solid rgba(255,255,255,0.05)" }}>
                        <div style={{ fontSize: 10, color: TOKENS.mutedFaint, fontWeight: 800, textTransform: "uppercase" }}>DISTANCE</div>
                        <div style={{ fontSize: 24, fontWeight: 900, color: TOKENS.text, fontFamily: "monospace" }}>{liveDist.toFixed(2)} <span style={{ fontSize: 12, color: TOKENS.muted }}>KM</span></div>
                      </div>
                      <div style={{ background: "rgba(255,255,255,0.03)", padding: "10px 12px", borderRadius: 14, border: "1px solid rgba(255,255,255,0.05)" }}>
                        <div style={{ fontSize: 10, color: TOKENS.mutedFaint, fontWeight: 800, textTransform: "uppercase" }}>TIME</div>
                        <div style={{ fontSize: 24, fontWeight: 900, color: TOKENS.text, fontFamily: "monospace" }}>{formatTime(elapsed)}</div>
                      </div>
                      <div style={{ background: "rgba(255,255,255,0.03)", padding: "10px 12px", borderRadius: 14, border: "1px solid rgba(255,255,255,0.05)" }}>
                        <div style={{ fontSize: 10, color: TOKENS.mutedFaint, fontWeight: 800, textTransform: "uppercase" }}>
                          {activityType === "walk" ? "LIVE STEPS" : activityType === "bike" ? "SPEED" : "SPLIT PACE"}
                        </div>
                        <div style={{ fontSize: 24, fontWeight: 900, color: "#256BFD", fontFamily: "monospace" }}>
                          {activityType === "walk" ? liveSteps.toLocaleString() : activityType === "bike" ? `${speedKmh.toFixed(1)} km/h` : formatPace(pace)}
                        </div>
                      </div>
                    </div>

                    <button
                      onClick={onPauseWithVoice}
                      style={{
                        width: "100%",
                        padding: "16px 0",
                        borderRadius: 16,
                        background: "linear-gradient(135deg, #256BFD 0%, #1A5EE5 100%)",
                        border: "none",
                        color: "#0B0E13",
                        fontWeight: 900,
                        fontSize: 16,
                        cursor: "pointer",
                        boxShadow: "0 6px 20px rgba(37, 107, 253,0.4)",
                        display: "flex",
                        alignItems: "center",
                        justifyContent: "center",
                        gap: 8,
                      }}
                    >
                      <span>⏸</span>
                      <span>PAUSE WORKOUT</span>
                    </button>
                  </div>
                )}

                {/* PAUSED BOTTOM CARD */}
                {runStage === "paused" && (
                  <div>
                    <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr 1fr", gap: 12, marginBottom: 18 }}>
                      <div style={{ background: "rgba(255,255,255,0.03)", padding: "10px 12px", borderRadius: 14 }}>
                        <div style={{ fontSize: 10, color: TOKENS.mutedFaint, fontWeight: 800 }}>TOTAL DISTANCE</div>
                        <div style={{ fontSize: 22, fontWeight: 900, color: TOKENS.text, fontFamily: "monospace" }}>{liveDist.toFixed(2)} km</div>
                      </div>
                      <div style={{ background: "rgba(255,255,255,0.03)", padding: "10px 12px", borderRadius: 14 }}>
                        <div style={{ fontSize: 10, color: TOKENS.mutedFaint, fontWeight: 800 }}>DURATION</div>
                        <div style={{ fontSize: 22, fontWeight: 900, color: TOKENS.text, fontFamily: "monospace" }}>{formatTime(elapsed)}</div>
                      </div>
                      <div style={{ background: "rgba(255,255,255,0.03)", padding: "10px 12px", borderRadius: 14 }}>
                        <div style={{ fontSize: 10, color: TOKENS.mutedFaint, fontWeight: 800 }}>{activityType === "walk" ? "TOTAL STEPS" : "EST. KCAL"}</div>
                        <div style={{ fontSize: 22, fontWeight: 900, color: activityType === "walk" ? "#256BFD" : TOKENS.text, fontFamily: "monospace" }}>
                          {activityType === "walk" ? liveSteps.toLocaleString() : calories}
                        </div>
                      </div>
                    </div>

                    <div style={{ display: "flex", gap: 12 }}>
                      <button
                        onClick={onResumeWithVoice}
                        style={{
                          flex: 1,
                          padding: "16px 0",
                          borderRadius: 16,
                          background: "linear-gradient(135deg, #256BFD 0%, #1A5EE5 100%)",
                          border: "none",
                          color: "#0B0E13",
                          fontWeight: 900,
                          fontSize: 15,
                          cursor: "pointer",
                          boxShadow: "0 6px 20px rgba(37, 107, 253,0.4)",
                          display: "flex",
                          alignItems: "center",
                          justifyContent: "center",
                          gap: 6,
                        }}
                      >
                        <span>▶</span>
                        <span>RESUME</span>
                      </button>

                      <button
                        onClick={onFinishWithVoice}
                        style={{
                          flex: 1,
                          padding: "16px 0",
                          borderRadius: 16,
                          background: "#1E2430",
                          border: "1px solid rgba(255,255,255,0.15)",
                          color: "#FFF",
                          fontWeight: 900,
                          fontSize: 15,
                          cursor: "pointer",
                          display: "flex",
                          alignItems: "center",
                          justifyContent: "center",
                          gap: 6,
                        }}
                      >
                        <span>🏁</span>
                        <span>FINISH & SAVE</span>
                      </button>
                    </div>
                  </div>
                )}
              </div>
            </div>
          )}

          {/* Scrollable Content Below Map (when idle) */}
          {runStage === "map_idle" && (
            <div style={{ marginTop: 20, display: "flex", flexDirection: "column", gap: 16 }}>
              {/* Global City Weather & Running Status Card */}
              <div style={{ background: "rgba(255,255,255,0.03)", border: `1px solid ${TOKENS.border}`, borderRadius: 20, padding: "16px 18px", display: "flex", justifyContent: "space-between", alignItems: "center" }}>
                <div style={{ display: "flex", alignItems: "center", gap: 12 }}>
                  <span style={{ fontSize: 28 }}>{selectedCity?.flag || "🌤️"}</span>
                  <div>
                    <div style={{ fontSize: 14, fontWeight: 800, color: TOKENS.text }}>{selectedCity ? `${selectedCity.name} (${selectedCity.country})` : "Worldwide GPS"}</div>
                    <div style={{ fontSize: 11.5, color: "#22C55E", fontWeight: 700 }}>24°C • Ideal Running Weather • AQI 35 (Good)</div>
                  </div>
                </div>
                <button
                  onClick={() => setShowLocationPicker(true)}
                  style={{ background: "rgba(37, 107, 253,0.15)", border: "1px solid #256BFD", color: "#256BFD", padding: "6px 12px", borderRadius: 999, fontSize: 11, fontWeight: 800, cursor: "pointer", flexShrink: 0 }}
                >
                  Change City 🌍
                </button>
              </div>

              {/* Quick Worldwide Running Hubs */}
              <div style={{ background: "rgba(255,255,255,0.03)", border: `1px solid ${TOKENS.border}`, borderRadius: 20, padding: 18 }}>
                <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 12 }}>
                  <div style={{ fontSize: 14, fontWeight: 900, color: TOKENS.text }}>Worldwide Running Hubs & Circuits</div>
                  <button
                    onClick={() => setShowLocationPicker(true)}
                    style={{ background: "none", border: "none", color: "#256BFD", fontSize: 11, fontWeight: 800, cursor: "pointer" }}
                  >
                    View All 10+ 🌍
                  </button>
                </div>

                <div style={{ display: "flex", flexDirection: "column", gap: 10 }}>
                  {GLOBAL_RUN_CITIES.filter((c) => c.id !== "my_gps").slice(0, 5).map((city) => (
                    <div
                      key={city.id}
                      onClick={() => selectGlobalCity(city)}
                      style={{
                        display: "flex",
                        justifyContent: "space-between",
                        alignItems: "center",
                        background: selectedCity?.id === city.id ? "rgba(37, 107, 253,0.12)" : "rgba(255,255,255,0.03)",
                        border: selectedCity?.id === city.id ? "1px solid #256BFD" : `1px solid rgba(255,255,255,0.06)`,
                        padding: "12px 14px",
                        borderRadius: 14,
                        cursor: "pointer",
                        transition: "all 0.15s ease"
                      }}
                    >
                      <div style={{ display: "flex", alignItems: "center", gap: 10 }}>
                        <span style={{ fontSize: 22 }}>{city.flag}</span>
                        <div>
                          <div style={{ fontSize: 13, fontWeight: 800, color: TOKENS.text }}>{city.name}</div>
                          <div style={{ fontSize: 11, color: TOKENS.mutedFaint }}>{city.country} • {city.desc}</div>
                        </div>
                      </div>
                      <div style={{ textAlign: "right", flexShrink: 0 }}>
                        <div style={{ fontSize: 12, fontWeight: 900, color: "#256BFD" }}>Run Here →</div>
                      </div>
                    </div>
                  ))}
                </div>
              </div>

              {/* Activity History Feed - Strava-Style */}
              {runs && runs.length > 0 && (
                <div style={{ background: "rgba(255,255,255,0.02)", border: `1px solid ${TOKENS.border}`, borderRadius: 20, overflow: "hidden" }}>
                  {/* Section Header */}
                  <div style={{ padding: "16px 18px 10px", display: "flex", justifyContent: "space-between", alignItems: "center" }}>
                    <div style={{ fontSize: 15, fontWeight: 900, color: TOKENS.text }}>Activity History</div>
                    <div style={{ fontSize: 11, color: TOKENS.mutedFaint, fontWeight: 700 }}>{runs.length} {runs.length === 1 ? "activity" : "activities"}</div>
                  </div>

                  <div style={{ display: "flex", flexDirection: "column" }}>
                    {runs.slice(0, 8).map((r, i) => {
                      const runBadgeText = r.sport === "bike" || r.type === "bike" ? "RIDE" : r.sport === "walk" || r.type === "walk" ? "WALK" : "RUN";
                      const runTitle = r.title || (r.type === "bike" ? "Ride" : r.type === "walk" ? "Walk" : "Run");
                      const runDist = (r.distanceKm || r.distance || 0).toFixed(2);
                      const runTime = formatTime(r.elapsed || r.time || 0);
                      const runPace = formatPace(r.paceMinPerKm || r.pace || 0);
                      const runDate = r.dateLabel || r.date || "Recent";
                      const hasPath = r.path && r.path.length > 1 && (r.distanceKm || r.distance) > 0.02;
                      return (
                        <div
                          key={r.id || i}
                          onClick={() => { setSavedActivity(r); setRunStage("activity_detail"); }}
                          style={{
                            display: "flex",
                            alignItems: "stretch",
                            gap: 0,
                            borderTop: i > 0 ? "1px solid rgba(255,255,255,0.05)" : "none",
                            cursor: "pointer",
                            transition: "background 0.15s ease"
                          }}
                          onMouseEnter={(e) => e.currentTarget.style.background = "rgba(255,255,255,0.03)"}
                          onMouseLeave={(e) => e.currentTarget.style.background = "transparent"}
                        >
                          {/* Mini Route Map Thumbnail */}
                          <div style={{ width: 90, height: 90, flexShrink: 0, background: "#13171F", position: "relative", overflow: "hidden", margin: "10px 0 10px 14px", borderRadius: 12, border: "1px solid rgba(255,255,255,0.08)" }}>
                            {hasPath ? (
                              <StokeRouteThumb path={r.path} />
                            ) : (
                              <div style={{ width: "100%", height: "100%", display: "flex", flexDirection: "column", alignItems: "center", justifyContent: "center", gap: 4 }}>
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#256BFD" strokeWidth="2.2" strokeLinecap="round" strokeLinejoin="round">
                                  <circle cx="15.5" cy="5" r="1.8"/>
                                  <path d="M9 20l2.5-5.5 2 1.8 3.5-1"/>
                                  <path d="M7 13.5l3.5-2.5 2 2.5-2.5 3.5"/>
                                </svg>
                                <span style={{ fontSize: 9.5, fontWeight: 900, color: "#256BFD", letterSpacing: 0.5 }}>{runBadgeText}</span>
                              </div>
                            )}
                          </div>

                          {/* Activity Info */}
                          <div style={{ flex: 1, padding: "14px 14px 14px 12px", display: "flex", flexDirection: "column", justifyContent: "center" }}>
                            <div style={{ fontSize: 13.5, fontWeight: 800, color: TOKENS.text, marginBottom: 2 }}>{runTitle}</div>
                            <div style={{ fontSize: 11, color: TOKENS.mutedFaint, marginBottom: 8 }}>{runDate}</div>
                            <div style={{ display: "flex", gap: 14 }}>
                              <div>
                                <div style={{ fontSize: 16, fontWeight: 900, color: "#256BFD", fontFamily: "monospace" }}>{runDist} <span style={{ fontSize: 11, color: TOKENS.muted }}>km</span></div>
                              </div>
                              <div>
                                <div style={{ fontSize: 12, fontWeight: 700, color: TOKENS.muted, fontFamily: "monospace" }}>{runTime}</div>
                              </div>
                              <div>
                                <div style={{ fontSize: 12, fontWeight: 700, color: TOKENS.muted, fontFamily: "monospace" }}>{runPace} <span style={{ fontSize: 10 }}>/km</span></div>
                              </div>
                            </div>
                          </div>
                          <div style={{ display: "flex", alignItems: "center", paddingRight: 14 }}>
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.3)" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round">
                              <polyline points="9 18 15 12 9 6" />
                            </svg>
                          </div>
                        </div>
                      );
                    })}
                  </div>
                </div>
              )}
            </div>
          )}

          {/* STAGE 2: OLED FULLSCREEN HUD */}
          {runStage === "hud_fullscreen" && (
            <div style={{ position: "fixed", inset: 0, zIndex: 99999, background: "#000000", color: "#FFFFFF", display: "flex", flexDirection: "column", padding: "40px 24px 32px" }}>
              {/* Header Bar */}
              <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 20 }}>
                <div style={{ display: "flex", alignItems: "center", gap: 8 }}>
                  <div style={{ width: 10, height: 10, borderRadius: "50%", background: status === "paused" ? "#EAB308" : "#256BFD", animation: status === "paused" ? "none" : "pulse 1.2s infinite" }} />
                  <span style={{ fontSize: 13, fontWeight: 900, letterSpacing: 1.2, color: status === "paused" ? "#EAB308" : "#256BFD", textTransform: "uppercase" }}>
                    STOKE OLED HUD • {activityType.toUpperCase()}
                  </span>
                </div>

                <button
                  onClick={() => setRunStage(status === "idle" ? "map_idle" : status === "paused" ? "paused" : "map_active")}
                  style={{ background: "rgba(255,255,255,0.12)", border: "1px solid rgba(255,255,255,0.2)", color: "#FFF", padding: "8px 16px", borderRadius: 999, fontSize: 12, fontWeight: 800, cursor: "pointer", display: "flex", alignItems: "center", gap: 6 }}
                >
                  <span>🗺️ MAP VIEW</span>
                </button>
              </div>

              {/* Main Huge Metrics Section */}
              <div style={{ flex: 1, display: "flex", flexDirection: "column", justifyContent: "center", alignItems: "center", textAlign: "center" }}>
                {/* Timer */}
                <div style={{ fontSize: 14, fontWeight: 800, color: "rgba(255,255,255,0.5)", letterSpacing: 1.5, textTransform: "uppercase", marginBottom: 4 }}>
                  DURATION
                </div>
                <div style={{ fontSize: "clamp(48px, 14vw, 84px)", fontWeight: 900, fontFamily: "monospace", letterSpacing: -1, lineHeight: 1, color: "#FFFFFF", marginBottom: 28 }}>
                  {formatTime(elapsed)}
                </div>

                {/* Hero Metric: Large Steps when walking, Distance when run/bike */}
                <div style={{ fontSize: 14, fontWeight: 800, color: "rgba(255,255,255,0.5)", letterSpacing: 1.5, textTransform: "uppercase", marginBottom: 4 }}>
                  {activityType === "walk" ? "👟 LIVE STEPS" : "DISTANCE (KILOMETERS)"}
                </div>
                <div style={{ fontSize: "clamp(56px, 16vw, 96px)", fontWeight: 900, fontFamily: "monospace", letterSpacing: -2, lineHeight: 1, color: "#256BFD", marginBottom: 32 }}>
                  {activityType === "walk" ? liveSteps.toLocaleString() : liveDist.toFixed(2)}
                </div>

                {/* 2 Grid Cards */}
                <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 16, width: "100%", maxWidth: 420 }}>
                  <div style={{ background: "rgba(255,255,255,0.06)", padding: "16px 14px", borderRadius: 20, border: "1px solid rgba(255,255,255,0.08)", textAlign: "center" }}>
                    <div style={{ fontSize: 11, color: "rgba(255,255,255,0.5)", fontWeight: 800, textTransform: "uppercase" }}>
                      {activityType === "walk" ? "DISTANCE" : activityType === "bike" ? "⚡ SPEED" : "AVG PACE"}
                    </div>
                    <div style={{ fontSize: 28, fontWeight: 900, fontFamily: "monospace", color: "#FFF", marginTop: 4 }}>
                      {activityType === "walk" ? `${liveDist.toFixed(2)} km` : activityType === "bike" ? `${speedKmh.toFixed(1)} km/h` : formatPace(pace)}
                    </div>
                  </div>

                  <div style={{ background: "rgba(255,255,255,0.06)", padding: "16px 14px", borderRadius: 20, border: "1px solid rgba(255,255,255,0.08)", textAlign: "center" }}>
                    <div style={{ fontSize: 11, color: "rgba(255,255,255,0.5)", fontWeight: 800, textTransform: "uppercase" }}>ACTIVE KCAL</div>
                    <div style={{ fontSize: 28, fontWeight: 900, fontFamily: "monospace", color: "#FFF", marginTop: 4 }}>{calories}</div>
                  </div>
                </div>

                {/* Kilometer / Step Progress Bar indicator */}
                <div style={{ width: "100%", maxWidth: 420, marginTop: 28, background: "rgba(255,255,255,0.04)", padding: 14, borderRadius: 16, border: "1px solid rgba(255,255,255,0.06)" }}>
                  <div style={{ display: "flex", justifyContent: "space-between", fontSize: 11, fontWeight: 800, color: "rgba(255,255,255,0.6)", marginBottom: 8 }}>
                    <span>{activityType === "walk" ? "DAILY STEP GOAL (10,000)" : "KM SPLIT PROGRESS"}</span>
                    <span>{activityType === "walk" ? `${Math.min(100, Math.round((liveSteps / 10000) * 100))}%` : `KM ${Math.floor(liveDist) + 1} (${((liveDist % 1) * 100).toFixed(0)}%)`}</span>
                  </div>
                  <div style={{ width: "100%", height: 8, background: "rgba(255,255,255,0.1)", borderRadius: 999, overflow: "hidden" }}>
                    <div style={{ width: activityType === "walk" ? `${Math.min(100, (liveSteps / 10000) * 100)}%` : `${(distanceKm % 1) * 100}%`, height: "100%", background: "#256BFD", borderRadius: 999 }} />
                  </div>
                </div>
              </div>

              {/* Bottom Huge Controls */}
              <div style={{ display: "flex", gap: 14, marginTop: 24, maxWidth: 420, width: "100%", margin: "24px auto 0" }}>
                {status === "idle" && (
                  <button
                    onClick={onStartWithVoice}
                    style={{ flex: 1, padding: "18px 0", borderRadius: 20, background: "linear-gradient(135deg, #256BFD 0%, #1A5EE5 100%)", border: "none", color: "#FFFFFF", fontWeight: 900, fontSize: 18, cursor: "pointer", boxShadow: "0 8px 30px rgba(37, 107, 253,0.5)" }}
                  >
                    ▶ START RECORDING
                  </button>
                )}

                {status === "active" && (
                  <button
                    onClick={onPauseWithVoice}
                    style={{ flex: 1, padding: "18px 0", borderRadius: 20, background: "linear-gradient(135deg, #256BFD 0%, #1A5EE5 100%)", border: "none", color: "#FFFFFF", fontWeight: 900, fontSize: 18, cursor: "pointer", boxShadow: "0 8px 30px rgba(37, 107, 253,0.5)" }}
                  >
                    ⏸ PAUSE WORKOUT
                  </button>
                )}

                {status === "paused" && (
                  <>
                    <button
                      onClick={onResumeWithVoice}
                      style={{ flex: 1, padding: "18px 0", borderRadius: 20, background: "linear-gradient(135deg, #256BFD 0%, #1A5EE5 100%)", border: "none", color: "#FFFFFF", fontWeight: 900, fontSize: 16, cursor: "pointer" }}
                    >
                      ▶ RESUME
                    </button>
                    <button
                      onClick={onFinishWithVoice}
                      style={{ flex: 1, padding: "18px 0", borderRadius: 20, background: "rgba(255,255,255,0.15)", border: "1px solid rgba(255,255,255,0.3)", color: "#FFF", fontWeight: 900, fontSize: 16, cursor: "pointer" }}
                    >
                      🏁 FINISH & SAVE
                    </button>
                  </>
                )}
              </div>
            </div>
          )}

          {/* STAGE 3: SAVE ACTIVITY FORM */}
          {runStage === "save_form" && (
            <div style={{ background: "#0D1117", borderRadius: 24, border: `1px solid ${TOKENS.border}`, padding: 22, boxShadow: "0 12px 40px rgba(0,0,0,0.8)" }}>
              {/* Form Top Nav */}
              <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 20, paddingBottom: 14, borderBottom: "1px solid rgba(255,255,255,0.08)" }}>
                <button
                  onClick={() => setRunStage("paused")}
                  style={{ background: "transparent", border: "none", color: "#256BFD", fontSize: 14, fontWeight: 800, cursor: "pointer" }}
                >
                  ‹ Resume
                </button>
                <div style={{ fontSize: 16, fontWeight: 900, color: TOKENS.text }}>Save Activity</div>
                <button
                  onClick={handleSaveActivity}
                  style={{ background: "linear-gradient(135deg, #256BFD 0%, #1A5EE5 100%)", border: "none", color: "#FFFFFF", padding: "6px 14px", borderRadius: 999, fontSize: 12, fontWeight: 800, cursor: "pointer" }}
                >
                  Save
                </button>
              </div>

              {/* Title Input */}
              <div style={{ marginBottom: 18 }}>
                <label style={{ fontSize: 11, fontWeight: 800, color: TOKENS.mutedFaint, textTransform: "uppercase", display: "block", marginBottom: 6 }}>
                  Title
                </label>
                <input
                  type="text"
                  value={activityTitle}
                  onChange={(e) => setActivityTitle(e.target.value)}
                  style={{ width: "100%", background: "rgba(255,255,255,0.04)", border: `1px solid ${TOKENS.border}`, borderRadius: 14, padding: "12px 14px", color: TOKENS.text, fontSize: 15, fontWeight: 700, outline: "none" }}
                  placeholder="e.g. Afternoon Run"
                />
              </div>

              {/* Description Input */}
              <div style={{ marginBottom: 18 }}>
                <label style={{ fontSize: 11, fontWeight: 800, color: TOKENS.mutedFaint, textTransform: "uppercase", display: "block", marginBottom: 6 }}>
                  Description
                </label>
                <textarea
                  value={activityDesc}
                  onChange={(e) => setActivityDesc(e.target.value)}
                  rows={3}
                  style={{ width: "100%", background: "rgba(255,255,255,0.04)", border: `1px solid ${TOKENS.border}`, borderRadius: 14, padding: "12px 14px", color: TOKENS.text, fontSize: 13.5, outline: "none", resize: "none" }}
                  placeholder="How did it feel? Tag friends, gear, or add notes..."
                />
              </div>

              {/* Media Upload Card */}
              <div style={{ marginBottom: 20 }}>
                <label style={{ fontSize: 11, fontWeight: 800, color: TOKENS.mutedFaint, textTransform: "uppercase", display: "block", marginBottom: 6 }}>
                  Photos & Media
                </label>
                <div style={{ display: "flex", gap: 10, overflowX: "auto", paddingBottom: 6 }}>
                  <label style={{ width: 90, height: 90, borderRadius: 16, border: `2px dashed ${TOKENS.border}`, background: "rgba(255,255,255,0.02)", display: "flex", flexDirection: "column", alignItems: "center", justifyContent: "center", cursor: "pointer", flexShrink: 0 }}>
                    <span style={{ fontSize: 24, marginBottom: 2 }}>📸</span>
                    <span style={{ fontSize: 10, fontWeight: 800, color: "#256BFD" }}>+ Add Photo</span>
                    <input type="file" accept="image/*" onChange={handlePhotoAdd} style={{ display: "none" }} />
                  </label>

                  {activityPhotos.map((img, i) => (
                    <div key={i} style={{ width: 90, height: 90, borderRadius: 16, overflow: "hidden", border: `1px solid ${TOKENS.border}`, flexShrink: 0, position: "relative" }}>
                      <img src={img} alt="Uploaded photo" style={{ width: "100%", height: "100%", objectFit: "cover" }} />
                    </div>
                  ))}
                </div>
              </div>

              {/* Map Type Switcher Card */}
              <div style={{ background: "rgba(255,255,255,0.03)", borderRadius: 16, padding: 14, border: `1px solid ${TOKENS.border}`, marginBottom: 20, display: "flex", justifyContent: "space-between", alignItems: "center" }}>
                <div>
                  <div style={{ fontSize: 13, fontWeight: 800, color: TOKENS.text }}>Map Type</div>
                  <div style={{ fontSize: 11, color: TOKENS.mutedFaint }}>Current: {mapTileType.toUpperCase()} street tiles</div>
                </div>
                <button
                  onClick={toggleLayerStyle}
                  style={{ background: "rgba(37, 107, 253,0.15)", border: "1px solid #256BFD", color: "#256BFD", padding: "6px 12px", borderRadius: 999, fontSize: 11.5, fontWeight: 800, cursor: "pointer" }}
                >
                  Change Map Type 🗺️
                </button>
              </div>

              {/* Perceived Exertion Slider */}
              <div style={{ marginBottom: 22 }}>
                <div style={{ display: "flex", justifyContent: "space-between", marginBottom: 6 }}>
                  <label style={{ fontSize: 11, fontWeight: 800, color: TOKENS.mutedFaint, textTransform: "uppercase" }}>Perceived Exertion</label>
                  <span style={{ fontSize: 12, fontWeight: 800, color: "#256BFD" }}>{perceivedExertion} / 10 - {perceivedExertion <= 3 ? "Easy" : perceivedExertion <= 6 ? "Moderate" : perceivedExertion <= 8 ? "Hard" : "Max Effort"}</span>
                </div>
                <input
                  type="range"
                  min="1"
                  max="10"
                  value={perceivedExertion}
                  onChange={(e) => setPerceivedExertion(parseInt(e.target.value))}
                  style={{ width: "100%", accentColor: "#256BFD", cursor: "pointer" }}
                />
              </div>

              {/* Big Save Button */}
              <button
                onClick={handleSaveActivity}
                style={{
                  width: "100%",
                  padding: "16px 0",
                  borderRadius: 16,
                  background: "linear-gradient(135deg, #256BFD 0%, #1A5EE5 100%)",
                  border: "none",
                  color: "#0B0E13",
                  fontWeight: 900,
                  fontSize: 16,
                  cursor: "pointer",
                  boxShadow: "0 8px 24px rgba(37, 107, 253,0.4)",
                }}
              >
                Save Activity ⚡
              </button>
            </div>
          )}

          {/* STAGE 4: CELEBRATION SPLASH */}
          {runStage === "celebration" && (
            <div style={{ position: "fixed", inset: 0, zIndex: 99999, background: "#090B0E", display: "flex", flexDirection: "column", alignItems: "center", justifyContent: "center", textAlign: "center", padding: 24 }}>
              <div style={{ fontSize: 72, marginBottom: 16, animation: "bounce 1s infinite" }}>👟</div>
              <h1 style={{ fontSize: 32, fontWeight: 900, color: "#FFF", margin: "0 0 8px" }}>Nice work, {profile && profile.name ? profile.name.split(" ")[0] : "Athlete"}!</h1>
              <p style={{ fontSize: 14, color: "#256BFD", fontWeight: 800, margin: 0 }}>Activity saved! Preparing your STOKE intelligence report...</p>
            </div>
          )}

          {/* STAGE 5: ACTIVITY DETAIL PAGE SHEET - STRAVA-STYLE */}
          {runStage === "activity_detail" && savedActivity && (
            <div style={{ background: "#0B0E13", borderRadius: 0, overflow: "hidden" }}>
              {/* Full-width Header Map */}
              <div style={{ position: "relative", width: "100%", height: 280, background: "#13171F" }}>
                <StokeLiveMap
                  path={savedActivity.path && savedActivity.path.length > 1 && (savedActivity.distance || savedActivity.distanceKm) > 0.02 ? savedActivity.path : []}
                  userPos={savedActivity.path && savedActivity.path.length > 0 ? [savedActivity.path[0].lat, savedActivity.path[0].lng] : userPos}
                  setUserPos={setUserPos}
                  routePath={[]}
                  setRoutePath={setRoutePath}
                  is3DTilted={false}
                  mapTileType={mapTileType}
                  simulating={false}
                  runStage="activity_detail"
                />
                {/* Gradient overlay at bottom of map */}
                <div style={{ position: "absolute", bottom: 0, left: 0, right: 0, height: 80, background: "linear-gradient(to top, #0B0E13, transparent)", zIndex: 500, pointerEvents: "none" }} />
                                <div style={{ position: "absolute", top: "max(14px, env(safe-area-inset-top, 14px))", left: 14, zIndex: 1000 }}>
                  <button
                    onClick={() => setRunStage("map_idle")}
                    style={{
                      background: "rgba(11,14,19,0.85)",
                      backdropFilter: "blur(12px)",
                      WebkitBackdropFilter: "blur(12px)",
                      border: "1px solid rgba(255,255,255,0.18)",
                      color: "#FFFFFF",
                      padding: "8px 14px",
                      borderRadius: 999,
                      fontSize: 12.5,
                      fontWeight: 800,
                      cursor: "pointer",
                      display: "flex",
                      alignItems: "center",
                      gap: 6,
                      boxShadow: "0 4px 16px rgba(0,0,0,0.6)"
                    }}
                  >
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round">
                      <line x1="19" y1="12" x2="5" y2="12" />
                      <polyline points="12 19 5 12 12 5" />
                    </svg>
                    <span>Back to Activities</span>
                  </button>
                </div>
              </div>

              {/* Activity Header */}
              <div style={{ padding: "20px 20px 0" }}>
                {/* Clean Activity Badge */}
                <div style={{ display: "flex", alignItems: "center", gap: 8, marginBottom: 10 }}>
                  <span style={{ fontSize: 11, fontWeight: 900, color: "#256BFD", textTransform: "uppercase", letterSpacing: 1, background: "rgba(37,107,253,0.12)", border: "1px solid rgba(37,107,253,0.3)", padding: "4px 12px", borderRadius: 999, display: "inline-flex", alignItems: "center", gap: 6 }}>
                    {savedActivity.sport === "bike" ? "RIDE" : savedActivity.sport === "walk" ? "WALK" : "RUN"}
                  </span>
                  <span style={{ fontSize: 11, color: TOKENS.mutedFaint, fontWeight: 600 }}>{savedActivity.dateStr ? savedActivity.dateStr.split(" · ")[0] : (savedActivity.date || savedActivity.dateLabel)}</span>
                </div>

                {/* Activity Title */}
                <h2 style={{ margin: "0 0 4px", fontSize: 24, fontWeight: 900, color: TOKENS.text, lineHeight: 1.1 }}>{savedActivity.title}</h2>
                <div style={{ fontSize: 12, color: TOKENS.mutedFaint, marginBottom: 18 }}>
                  {savedActivity.dateStr || (savedActivity.timeLabel ? `${savedActivity.timeLabel} · ${savedActivity.location || "Worldwide GPS"}` : "")}
                </div>

                {/* Hero Distance */}
                <div style={{ marginBottom: 22 }}>
                  <div style={{ fontSize: 52, fontWeight: 900, color: TOKENS.text, fontFamily: "monospace", letterSpacing: -2, lineHeight: 1 }}>
                    {(savedActivity.distance || savedActivity.distanceKm || 0).toFixed(2)}
                  </div>
                  <div style={{ fontSize: 13, color: TOKENS.muted, fontWeight: 700, marginTop: 2 }}>kilometers</div>
                </div>

                {/* Primary stat grid: Moving Time + Avg Pace */}
                <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 1, marginBottom: 1 }}>
                  <div style={{ background: "rgba(255,255,255,0.03)", border: "1px solid rgba(255,255,255,0.06)", borderRadius: "16px 4px 4px 16px", padding: "14px 16px" }}>
                    <div style={{ fontSize: 10.5, color: TOKENS.mutedFaint, fontWeight: 800, textTransform: "uppercase", letterSpacing: 0.5, marginBottom: 4 }}>Moving Time</div>
                    <div style={{ fontSize: 22, fontWeight: 900, color: TOKENS.text, fontFamily: "monospace" }}>{formatTime(savedActivity.time || savedActivity.elapsed)}</div>
                  </div>
                  <div style={{ background: "rgba(255,255,255,0.03)", border: "1px solid rgba(255,255,255,0.06)", borderRadius: "4px 16px 16px 4px", padding: "14px 16px" }}>
                    <div style={{ fontSize: 10.5, color: TOKENS.mutedFaint, fontWeight: 800, textTransform: "uppercase", letterSpacing: 0.5, marginBottom: 4 }}>Avg Pace</div>
                    <div style={{ fontSize: 22, fontWeight: 900, color: TOKENS.text, fontFamily: "monospace" }}>
                      {formatPace(savedActivity.pace || savedActivity.paceMinPerKm)} <span style={{ fontSize: 12, fontWeight: 700, color: TOKENS.muted }}>/km</span>
                    </div>
                  </div>
                </div>

                {/* Secondary stat grid: Calories + Avg Speed */}
                <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 1, marginBottom: 22, marginTop: 1 }}>
                  <div style={{ background: "rgba(255,255,255,0.03)", border: "1px solid rgba(255,255,255,0.06)", borderRadius: "16px 4px 4px 16px", padding: "14px 16px" }}>
                    <div style={{ fontSize: 10.5, color: TOKENS.mutedFaint, fontWeight: 800, textTransform: "uppercase", letterSpacing: 0.5, marginBottom: 4 }}>Calories</div>
                    <div style={{ fontSize: 22, fontWeight: 900, color: TOKENS.text, fontFamily: "monospace" }}>
                      {savedActivity.calories || 0} <span style={{ fontSize: 12, fontWeight: 700, color: TOKENS.muted }}>kcal</span>
                    </div>
                  </div>
                  <div style={{ background: "rgba(255,255,255,0.03)", border: "1px solid rgba(255,255,255,0.06)", borderRadius: "4px 16px 16px 4px", padding: "14px 16px" }}>
                    <div style={{ fontSize: 10.5, color: TOKENS.mutedFaint, fontWeight: 800, textTransform: "uppercase", letterSpacing: 0.5, marginBottom: 4 }}>Avg Speed</div>
                    <div style={{ fontSize: 22, fontWeight: 900, color: TOKENS.text, fontFamily: "monospace" }}>
                      {savedActivity.speedKmh ? savedActivity.speedKmh.toFixed(1) : (savedActivity.time > 0 && savedActivity.distance >= 0.03 ? (savedActivity.distance / (savedActivity.time / 3600)).toFixed(1) : "0.0")} <span style={{ fontSize: 12, fontWeight: 700, color: TOKENS.muted }}>km/h</span>
                    </div>
                  </div>
                </div>

                {/* Action Buttons Row */}
                <div style={{ display: "flex", gap: 10, marginBottom: 20 }}>
                  <button
                    onClick={() => setKudosCount(kudosCount + 1)}
                    style={{ flex: 1, padding: "11px 0", borderRadius: 14, background: hasLiked ? "rgba(37,107,253,0.2)" : "rgba(255,255,255,0.04)", border: `1px solid ${hasLiked ? "#256BFD" : "rgba(255,255,255,0.1)"}`, color: hasLiked ? "#256BFD" : TOKENS.muted, fontWeight: 800, fontSize: 13, cursor: "pointer", display: "flex", alignItems: "center", justifyContent: "center", gap: 6, transition: "all 0.2s ease" }}
                    onMouseEnter={() => setHasLiked(true)}
                  >
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="#256BFD"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                    <span>Kudos</span>
                    <span style={{ background: "#256BFD", color: "#FFF", padding: "2px 7px", borderRadius: 999, fontSize: 11, fontWeight: 900 }}>{kudosCount}</span>
                  </button>
                  <button
                    onClick={() => setShowStoryModal(true)}
                    style={{ flex: 1, padding: "11px 0", borderRadius: 14, background: "linear-gradient(135deg, #256BFD, #1A5EE5)", border: "none", color: "#FFF", fontWeight: 800, fontSize: 13, cursor: "pointer", display: "flex", alignItems: "center", justifyContent: "center", gap: 6 }}
                  >
                    <span>Share Card</span>
                  </button>
                  <button
                    onClick={() => setRunStage("map_idle")}
                    style={{ padding: "11px 16px", borderRadius: 14, background: "rgba(255,255,255,0.04)", border: "1px solid rgba(255,255,255,0.1)", color: TOKENS.muted, fontWeight: 800, fontSize: 13, cursor: "pointer" }}
                  >
                    + New
                  </button>
                </div>

                {/* Intelligence Card */}
                <div style={{ background: "linear-gradient(135deg, rgba(37,107,253,0.1) 0%, rgba(37,107,253,0.04) 100%)", borderRadius: 18, padding: 16, border: "1px solid rgba(37,107,253,0.2)", marginBottom: 24 }}>
                  <div style={{ display: "flex", alignItems: "center", gap: 8, marginBottom: 8 }}>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="#256BFD"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                    <div style={{ fontSize: 14, fontWeight: 900, color: "#256BFD" }}>STOKE Intelligence</div>
                  </div>
                  <p style={{ margin: 0, fontSize: 12.5, color: TOKENS.muted, lineHeight: 1.6 }}>
                    {(savedActivity.distance || 0) >= 0.03
                      ? `Great ${savedActivity.timeOfDay ? savedActivity.timeOfDay.toLowerCase() : "run"}! You covered ${(savedActivity.distance || 0).toFixed(2)} km in ${formatTime(savedActivity.time || 0)} at an average pace of ${formatPace(savedActivity.pace || 0)}/km. Estimated recovery: 12-18 hours.`
                      : `Stationary warm-up or quick session recorded. When you run outdoors with high-accuracy GPS, real-time tracking will plot your exact trail, splits, elevation, and active calories.`}
                  </p>
                </div>
              </div>
            </div>
          )}
        </div>
      )}

      {/* SUB-TAB 2: CHALLENGES */}
      {activeSubTab === "challenges" && (
        <div style={{ display: "flex", flexDirection: "column", gap: 14, paddingBottom: 30 }}>
          <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center" }}>
            <div>
              <div style={{ fontSize: 18, fontWeight: 900, color: TOKENS.text }}>Monthly Challenges</div>
              <div style={{ fontSize: 12, color: TOKENS.mutedFaint }}>Compete, earn badges & build endurance</div>
            </div>
            <div style={{ background: "rgba(37, 107, 253,0.15)", border: "1px solid #256BFD", color: "#256BFD", padding: "4px 10px", borderRadius: 999, fontSize: 11, fontWeight: 800 }}>
              {challenges.filter((c) => c.joined).length} Active
            </div>
          </div>

          {challenges.map((c) => {
            const pct = Math.min(100, Math.round((c.current / c.target) * 100));
            return (
              <div key={c.id} style={{ background: "rgba(255,255,255,0.03)", border: `1px solid ${c.joined ? "rgba(37, 107, 253,0.5)" : TOKENS.border}`, borderRadius: 20, padding: 18, position: "relative", overflow: "hidden" }}>
                <div style={{ display: "flex", alignItems: "flex-start", gap: 12, marginBottom: 12 }}>
                  <div style={{ width: 44, height: 44, borderRadius: 14, background: "rgba(255,255,255,0.06)", display: "flex", alignItems: "center", justifyContent: "center", fontSize: 24, flexShrink: 0 }}>
                    {c.icon}
                  </div>
                  <div style={{ flex: 1 }}>
                    <div style={{ fontSize: 15, fontWeight: 800, color: TOKENS.text, marginBottom: 3 }}>{c.title}</div>
                    <div style={{ fontSize: 12, color: TOKENS.muted, lineHeight: 1.4, marginBottom: 8 }}>{c.desc}</div>
                    <div style={{ display: "flex", alignItems: "center", gap: 10, fontSize: 11, color: TOKENS.mutedFaint }}>
                      <span>👥 {c.participants.toLocaleString()} athletes</span>
                      <span>•</span>
                      <span style={{ color: "#256BFD", fontWeight: 700 }}>{c.reward}</span>
                    </div>
                  </div>
                </div>

                {/* Progress bar */}
                <div style={{ marginBottom: 14 }}>
                  <div style={{ display: "flex", justifyContent: "space-between", fontSize: 12, fontWeight: 800, marginBottom: 6 }}>
                    <span style={{ color: TOKENS.text }}>{c.current} / {c.target} {c.unit}</span>
                    <span style={{ color: "#256BFD" }}>{pct}%</span>
                  </div>
                  <div style={{ height: 8, borderRadius: 999, background: "rgba(255,255,255,0.08)", overflow: "hidden" }}>
                    <div style={{ height: "100%", width: `${pct}%`, background: "linear-gradient(90deg, #256BFD, #3B82F6)", borderRadius: 999, transition: "width 0.4s ease" }} />
                  </div>
                </div>

                <button
                  onClick={() => toggleJoinChallenge(c.id)}
                  style={{
                    width: "100%",
                    padding: "10px 0",
                    borderRadius: 12,
                    border: c.joined ? "1px solid rgba(255,255,255,0.15)" : "none",
                    background: c.joined ? "rgba(255,255,255,0.06)" : "#256BFD",
                    color: c.joined ? "#FFF" : "#0B0E13",
                    fontWeight: 800,
                    fontSize: 12.5,
                    cursor: "pointer",
                    transition: "all 0.2s ease"
                  }}
                >
                  {c.joined ? "✓ Challenge Active (Leave)" : "Join Challenge ⚡"}
                </button>
              </div>
            );
          })}
        </div>
      )}

      {/* SUB-TAB 3: LEADERBOARD */}
      {activeSubTab === "leaderboard" && (
        <div style={{ display: "flex", flexDirection: "column", gap: 14, paddingBottom: 30 }}>
          <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center" }}>
            <div>
              <div style={{ fontSize: 18, fontWeight: 900, color: TOKENS.text }}>Worldwide Leaderboard</div>
              <div style={{ fontSize: 12, color: TOKENS.mutedFaint }}>Global rankings & regional contenders</div>
            </div>
            <div style={{ display: "flex", gap: 4, background: "rgba(255,255,255,0.06)", padding: 3, borderRadius: 999 }}>
              <button
                onClick={() => setLeaderboardFilter("worldwide")}
                style={{ background: leaderboardFilter === "worldwide" ? "#256BFD" : "transparent", border: "none", color: "#FFFFFF", padding: "3px 9px", borderRadius: 999, fontSize: 10.5, fontWeight: 800, cursor: "pointer" }}
              >
                🌍 Global
              </button>
              <button
                onClick={() => setLeaderboardFilter("regional")}
                style={{ background: leaderboardFilter === "regional" ? "#256BFD" : "transparent", border: "none", color: "#FFFFFF", padding: "3px 9px", borderRadius: 999, fontSize: 10.5, fontWeight: 800, cursor: "pointer" }}
              >
                🏙️ Regional
              </button>
            </div>
          </div>

          {/* Top 3 Podium */}
          <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr 1fr", gap: 8, alignItems: "flex-end", marginBottom: 10, paddingTop: 10 }}>
            {/* Rank 2 */}
            <div style={{ background: "rgba(255,255,255,0.03)", border: `1px solid ${TOKENS.border}`, borderRadius: 16, padding: "14px 8px 12px", textAlign: "center", display: "flex", flexDirection: "column", alignItems: "center" }}>
              <div style={{ fontSize: 20, marginBottom: 4 }}>🥈</div>
              <div style={{ fontSize: 11, fontWeight: 800, color: TOKENS.text, whiteSpace: "nowrap", overflow: "hidden", textOverflow: "ellipsis", maxWidth: "100%" }}>Sarah J.</div>
              <div style={{ fontSize: 13, fontWeight: 900, color: "#256BFD", marginTop: 4 }}>76.5 km</div>
            </div>

            {/* Rank 1 */}
            <div style={{ background: "linear-gradient(180deg, rgba(37, 107, 253,0.2) 0%, rgba(255,255,255,0.03) 100%)", border: "1px solid #256BFD", borderRadius: 18, padding: "18px 8px 14px", textAlign: "center", display: "flex", flexDirection: "column", alignItems: "center", transform: "scale(1.04)" }}>
              <div style={{ fontSize: 24, marginBottom: 4 }}>👑</div>
              <div style={{ fontSize: 12, fontWeight: 900, color: "#FFF", whiteSpace: "nowrap", overflow: "hidden", textOverflow: "ellipsis", maxWidth: "100%" }}>Alex Chen</div>
              <div style={{ fontSize: 15, fontWeight: 900, color: "#256BFD", marginTop: 4 }}>84.2 km</div>
            </div>

            {/* Rank 3 */}
            <div style={{ background: "rgba(255,255,255,0.03)", border: `1px solid ${TOKENS.border}`, borderRadius: 16, padding: "14px 8px 12px", textAlign: "center", display: "flex", flexDirection: "column", alignItems: "center" }}>
              <div style={{ fontSize: 20, marginBottom: 4 }}>🥉</div>
              <div style={{ fontSize: 11, fontWeight: 800, color: TOKENS.text, whiteSpace: "nowrap", overflow: "hidden", textOverflow: "ellipsis", maxWidth: "100%" }}>Marcus V.</div>
              <div style={{ fontSize: 13, fontWeight: 900, color: "#256BFD", marginTop: 4 }}>69.8 km</div>
            </div>
          </div>

          {/* Full List */}
          <div style={{ display: "flex", flexDirection: "column", gap: 8 }}>
            {LEADERBOARD_USERS.map((u) => {
              const isCurrentUser = u.isUser || u.name.includes("You") || u.name.includes("mohdnuman");
              return (
                <div
                  key={u.rank}
                  style={{
                    display: "flex",
                    alignItems: "center",
                    gap: 12,
                    padding: "12px 14px",
                    borderRadius: 16,
                    background: isCurrentUser ? "rgba(37, 107, 253,0.14)" : "rgba(255,255,255,0.03)",
                    border: `1px solid ${isCurrentUser ? "#256BFD" : TOKENS.border}`,
                  }}
                >
                  <div style={{ width: 24, fontSize: 13, fontWeight: 900, color: isCurrentUser ? "#256BFD" : TOKENS.muted, textAlign: "center" }}>
                    #{u.rank}
                  </div>
                  <div style={{ width: 36, height: 36, borderRadius: "50%", background: isCurrentUser ? "#256BFD" : "rgba(255,255,255,0.08)", display: "flex", alignItems: "center", justifyContent: "center", fontWeight: 900, fontSize: 14, color: "#FFFFFF" }}>
                    {isCurrentUser ? "M" : u.badge || "🏃"}
                  </div>
                  <div style={{ flex: 1 }}>
                    <div style={{ fontSize: 13.5, fontWeight: 800, color: isCurrentUser ? "#FFF" : TOKENS.text, display: "flex", alignItems: "center", gap: 6 }}>
                      <span>{isCurrentUser ? "Mohd Numan (You)" : u.name}</span>
                      {isCurrentUser && <span style={{ background: "#256BFD", color: "#FFFFFF", fontSize: 9, fontWeight: 800, padding: "1px 6px", borderRadius: 999 }}>YOU</span>}
                    </div>
                    <div style={{ fontSize: 11, color: TOKENS.mutedFaint }}>{u.activity}</div>
                  </div>
                  <div style={{ textAlign: "right" }}>
                    <div style={{ fontSize: 14, fontWeight: 900, color: isCurrentUser ? "#256BFD" : TOKENS.text, fontFamily: "monospace" }}>{u.dist.toFixed(1)} km</div>
                    <div style={{ fontSize: 10, color: TOKENS.mutedFaint }}>Total distance</div>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      )}

      {/* 9:16 STORY CARD MODAL */}
      {showStoryModal && (
        <div style={{ position: "fixed", inset: 0, zIndex: 99999, background: "rgba(0,0,0,0.9)", backdropFilter: "blur(12px)", display: "flex", alignItems: "center", justifyContent: "center", padding: 16 }}>
          <div style={{ background: "#11141B", border: `1px solid rgba(255,255,255,0.15)`, borderRadius: 24, padding: 22, maxWidth: 380, width: "100%", boxShadow: "0 20px 60px rgba(0,0,0,0.9)", display: "flex", flexDirection: "column", maxHeight: "90vh", overflowY: "auto" }}>
            <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 14 }}>
              <div style={{ fontSize: 16, fontWeight: 900, color: "#FFF" }}>9:16 Story Card</div>
              <button onClick={() => setShowStoryModal(false)} style={{ background: "rgba(255,255,255,0.1)", border: "none", color: "#FFF", width: 28, height: 28, borderRadius: "50%", cursor: "pointer" }}>✕</button>
            </div>

            {/* Canvas Preview Container */}
            <div style={{ width: "100%", aspectRatio: "9/16", background: "#000", borderRadius: 18, overflow: "hidden", border: "1px solid rgba(255,255,255,0.15)", marginBottom: 12, position: "relative", boxShadow: "0 10px 30px rgba(0,0,0,0.8)" }}>
              {generatedCardUrl ? (
                <img src={generatedCardUrl} alt="STOKE 9:16 Story Card" style={{ width: "100%", height: "100%", objectFit: "cover", display: "block" }} />
              ) : (
                <div style={{ position: "relative", width: "100%", height: "100%", display: "flex", flexDirection: "column", justifyContent: "space-between", padding: 22, textAlign: "center", background: "#0B0E14" }}>
                  {cardPhoto && (
                    <img src={cardPhoto} alt="Story Background" style={{ position: "absolute", inset: 0, width: "100%", height: "100%", objectFit: "cover" }} />
                  )}
                  <div style={{ position: "absolute", inset: 0, background: "linear-gradient(180deg, rgba(0,0,0,0.72) 0%, rgba(0,0,0,0.28) 32%, rgba(0,0,0,0.52) 65%, rgba(0,0,0,0.88) 100%)", pointerEvents: "none" }} />
                  
                  {/* Top Branding */}
                  <div style={{ position: "relative", zIndex: 2 }}>
                    <div style={{ fontSize: 20, fontWeight: 900, color: "#256BFD", letterSpacing: 2.5, marginBottom: 2 }}>STOKE ⚡</div>
                    <div style={{ fontSize: 11, fontWeight: 800, color: "rgba(255,255,255,0.75)", letterSpacing: 1.5, textTransform: "uppercase" }}>{activityType === "run" ? "OUTDOOR RUN" : activityType.toUpperCase()}</div>
                  </div>

                  {/* Hero Metric */}
                  <div style={{ position: "relative", zIndex: 2, margin: "auto 0" }}>
                    <div style={{ fontSize: 12, fontWeight: 800, color: "rgba(255,255,255,0.75)", letterSpacing: 1.5, marginBottom: 2 }}>DISTANCE</div>
                    <div style={{ fontSize: 48, fontWeight: 900, color: "#FFF", fontFamily: "monospace", letterSpacing: -1 }}>{Number(liveDist.toFixed(2)).toFixed(2)} KM</div>
                    <div style={{ fontSize: 15, fontWeight: 800, color: "rgba(255,255,255,0.88)", marginTop: 4 }}>{formatPace(livePace)} /km • {formatTime(elapsed)}</div>
                  </div>

                  {/* Athlete & Location Footer */}
                  <div style={{ position: "relative", zIndex: 2 }}>
                    <div style={{ fontSize: 13, fontWeight: 800, color: "#FFF" }}>{profile?.name || "Mohd Numan"}</div>
                    <div style={{ fontSize: 11, color: "rgba(255,255,255,0.65)", marginTop: 2 }}>{selectedCity ? `${selectedCity.name}, ${selectedCity.country}` : "Worldwide Athlete"}</div>
                    <div style={{ fontSize: 10, fontWeight: 800, color: "#256BFD", letterSpacing: 2, marginTop: 8 }}>STOKE ⚡ ATHLETES CLUB</div>
                  </div>
                </div>
              )}
            </div>

            {/* Remove Custom Photo Option */}
            {cardPhoto && (
              <div style={{ display: "flex", justifyContent: "center", marginBottom: 12 }}>
                <button
                  onClick={() => {
                    setCardPhoto(null);
                    onChangeStyle("dark");
                    const activeDist = Number(liveDist.toFixed(2));
                    const activeElapsed = elapsed > 0 ? elapsed : 1;
                    const loc = selectedCity ? `${selectedCity.name}, ${selectedCity.country}` : "Worldwide Athlete";
                    const realPath = (pathRef && pathRef.current && pathRef.current.length > 1 && activeDist > 0.02)
                      ? pathRef.current
                      : (savedActivity?.path && savedActivity.path.length > 1 && (savedActivity.distance || savedActivity.distanceKm) > 0.02 ? savedActivity.path : []);
                    const cardParams = {
                      activityType,
                      distanceKm: activeDist,
                      elapsed: activeElapsed,
                      paceMinPerKm: livePace,
                      speedKmh,
                      path: realPath,
                      style: "dark",
                      brand: "STOKE",
                      customImage: null,
                      athleteName: profile?.name || "Mohd Numan",
                      location: loc
                    };
                    setGeneratedCardUrl(drawShareCard(cardParams));
                  }}
                  style={{ background: "rgba(255,255,255,0.06)", border: "1px solid rgba(255,255,255,0.15)", color: "rgba(255,255,255,0.75)", padding: "5px 14px", borderRadius: 999, fontSize: 11.5, fontWeight: 700, cursor: "pointer" }}
                >
                  ✕ Remove Custom Photo (Reset to Dark)
                </button>
              </div>
            )}

            {/* Actions */}
            <div style={{ display: "flex", gap: 10 }}>
              <label style={{ flex: 1, padding: "12px 0", borderRadius: 14, background: "rgba(255,255,255,0.06)", border: "1px solid rgba(255,255,255,0.15)", color: "#FFF", fontWeight: 800, fontSize: 12, cursor: "pointer", display: "flex", alignItems: "center", justifyContent: "center" }}>
                <span>📷 Upload Photo</span>
                <input type="file" accept="image/*" onChange={handlePhotoUpload} style={{ display: "none" }} />
              </label>

              <button
                onClick={handleShare}
                style={{ flex: 1, padding: "12px 0", borderRadius: 14, background: "linear-gradient(135deg, #256BFD 0%, #1A5EE5 100%)", border: "none", color: "#FFFFFF", fontWeight: 900, fontSize: 12, cursor: "pointer" }}
              >
                📲 Share / Save
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}

/* ============================================================
   STOKE — COACH (v3.0)
   Features:
   - ChatGPT-style fitness & nutrition conversational assistant
   - Multi-session chat history with New Chat & auto titles
   - Live telemetry (calories, macros, workouts, profile)
   - Real interactive Meal Cards (Add to Diary, Save Meal)
   - Real interactive Workout Cards (Start Workout, Save Routine)
   - Typing/streaming animations, speech synth, markdown parsing
   ============================================================ */


function CoachScreen({ remaining, goals, totals, meals, week, logs, runs, activeDay, profile, onNavigate, onBack, addItem, initialQuery }) {
  const messagesEndRef = useRef(null);
  const inputRef = useRef(null);
  const streamIntervalRef = useRef(null);

  const LIME = "#256BFD";
  const BLUE_LIGHT = "#3B82F6";
  const CYAN = "#2ED4BF";
  const AMBER = "#FF8A3D";

  const athleteName = (profile && profile.name) ? profile.name.trim().split(" ")[0] : "Athlete";
  const userGoal = (profile && profile.goalType) ? String(profile.goalType).toUpperCase() : "MAINTAIN";
  const userWeight = (profile && profile.weightKg) ? profile.weightKg : 70;

  const remCal = (remaining && remaining.calories !== undefined) ? remaining.calories : (goals ? goals.calories : 2450);
  const remP = (remaining && remaining.protein !== undefined) ? remaining.protein : (goals ? goals.protein : 140);
  const remC = (remaining && remaining.carbs !== undefined) ? remaining.carbs : (goals ? goals.carbs : 250);
  const remF = (remaining && remaining.fat !== undefined) ? remaining.fat : (goals ? goals.fat : 70);

  const consumedCal = (totals && totals.calories) ? totals.calories : 0;
  const consumedP = (totals && totals.protein) ? totals.protein : 0;
  const consumedC = (totals && totals.carbs) ? totals.carbs : 0;
  const consumedF = (totals && totals.fat) ? totals.fat : 0;

  const createInitialGreeting = () => {
    const hour = new Date().getHours();
    const timeGreet = hour < 12 ? "Good morning" : hour < 17 ? "Good afternoon" : "Good evening";
    return {
      id: "msg_init_" + Date.now(),
      role: "assistant",
      timestamp: new Date().toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" }),
      content: `**${timeGreet}, ${athleteName}!** 👋 I am your **Coach** — your conversational nutritionist, workout architect, and performance guide.\n\nYou have **${remCal} kcal** and **${remP}g protein** remaining today toward your ${goals ? goals.calories : 2450} kcal target.\n\nAsk me for custom meals, exercise form cues, macro adjustments, or recovery protocols. What are we optimizing right now?`,
      suggestions: [
        "What should I eat with my remaining macros?",
        "High-protein vegetarian breakfast",
        "Create today's workout",
        "Analyse my nutrition today"
      ]
    };
  };

  // ── MULTI-SESSION CHAT INITIALIZATION ──
  const [sessions, setSessions] = useState(() => {
    if (typeof localStorage !== "undefined") {
      try {
        const saved = localStorage.getItem("stoke_coach_sessions");
        if (saved) {
          const parsed = JSON.parse(saved);
          if (Array.isArray(parsed) && parsed.length > 0) {
            return parsed.map(s => ({
              id: s.id || ("session_" + Math.random()),
              title: s.title || "Conversation",
              updatedAt: s.updatedAt || Date.now(),
              messages: Array.isArray(s.messages) && s.messages.length > 0 ? s.messages : [createInitialGreeting()]
            }));
          }
        }
      } catch (e) {}
    }
    return [
      {
        id: "session_default",
        title: "Welcome to Coach",
        updatedAt: Date.now(),
        messages: [createInitialGreeting()]
      }
    ];
  });

  const [activeSessionId, setActiveSessionId] = useState(() => {
    if (typeof localStorage !== "undefined") {
      try {
        const savedId = localStorage.getItem("stoke_coach_active_id");
        if (savedId) return savedId;
      } catch (e) {}
    }
    return "session_default";
  });

  // Local active messages state
  const currentSession = sessions.find(s => s.id === activeSessionId) || sessions[0];
  const [messages, setMessages] = useState(() => currentSession ? (currentSession.messages || [createInitialGreeting()]) : [createInitialGreeting()]);

  const [showHistoryDrawer, setShowHistoryDrawer] = useState(false);
  const [inputText, setInputText] = useState("");
  const [isGenerating, setIsGenerating] = useState(false);
  const [isListening, setIsListening] = useState(false);
  const [toastMsg, setToastMsg] = useState("");

  const triggerToast = (msg) => {
    setToastMsg(msg);
    setTimeout(() => setToastMsg(""), 3000);
  };

  // Sync active session when activeSessionId changes
  useEffect(() => {
    const target = sessions.find(s => s.id === activeSessionId) || sessions[0];
    if (target) {
      setMessages(target.messages && target.messages.length > 0 ? target.messages : [createInitialGreeting()]);
    }
  }, [activeSessionId]);

  // Save completed conversation to sessions and localStorage
  useEffect(() => {
    if (!isGenerating && messages.length > 0) {
      setSessions(prevSessions => {
        const updated = prevSessions.map(s => {
          if (s.id === activeSessionId) {
            return { ...s, messages, updatedAt: Date.now() };
          }
          return s;
        });
        if (typeof localStorage !== "undefined") {
          try {
            localStorage.setItem("stoke_coach_sessions", JSON.stringify(updated));
            localStorage.setItem("stoke_coach_active_id", activeSessionId);
          } catch (e) {}
        }
        return updated;
      });
    }
  }, [messages, isGenerating, activeSessionId]);

  // Auto-scroll to bottom
  const scrollToBottom = (behavior = "smooth") => {
    if (messagesEndRef.current) {
      messagesEndRef.current.scrollIntoView({ behavior });
    }
  };

  useEffect(() => {
    scrollToBottom("smooth");
  }, [messages, isGenerating]);

  // Speech synthesis
  const handleSpeak = (text) => {
    if (typeof window === "undefined" || !("speechSynthesis" in window)) {
      triggerToast("Speech synthesis not supported in this browser");
      return;
    }
    window.speechSynthesis.cancel();
    const clean = text.replace(/[*_#•`|]/g, "").replace(/\[.*?\]/g, "");
    const utterance = new SpeechSynthesisUtterance(clean);
    utterance.rate = 1.05;
    window.speechSynthesis.speak(utterance);
    triggerToast("Reading response aloud...");
  };

  // Speech-to-text mic
  const handleVoiceInput = () => {
    if (typeof window === "undefined") return;
    const SpeechRec = window.SpeechRecognition || window.webkitSpeechRecognition;
    if (!SpeechRec) {
      triggerToast("Voice recognition not supported in this browser");
      return;
    }
    if (isListening) return;

    try {
      const rec = new SpeechRec();
      rec.lang = "en-US";
      rec.interimResults = false;
      setIsListening(true);
      triggerToast("Listening... speak now");

      rec.onresult = (e) => {
        const transcript = e.results[0][0].transcript;
        setInputText(transcript);
        setIsListening(false);
        setTimeout(() => sendMessage(transcript), 300);
      };
      rec.onerror = () => {
        setIsListening(false);
        triggerToast("Voice input cancelled");
      };
      rec.onend = () => setIsListening(false);
      rec.start();
    } catch (e) {
      setIsListening(false);
      triggerToast("Microphone activation failed");
    }
  };

  // Copy message
  const handleCopy = (text) => {
    if (typeof navigator !== "undefined" && navigator.clipboard) {
      navigator.clipboard.writeText(text);
      triggerToast("Copied to clipboard");
    }
  };

  // Stop generating
  const handleStopGenerating = () => {
    if (streamIntervalRef.current) {
      clearInterval(streamIntervalRef.current);
      streamIntervalRef.current = null;
    }
    setIsGenerating(false);
    triggerToast("Response stopped");
  };

  // Start a new chat session
  const handleNewChat = () => {
    handleStopGenerating();
    const newSessionId = "session_" + Date.now();
    const newGreeting = createInitialGreeting();
    const newSession = {
      id: newSessionId,
      title: "New Conversation",
      updatedAt: Date.now(),
      messages: [newGreeting]
    };
    const updatedSessions = [newSession, ...sessions];
    setSessions(updatedSessions);
    setActiveSessionId(newSessionId);
    setMessages([newGreeting]);
    if (typeof localStorage !== "undefined") {
      try {
        localStorage.setItem("stoke_coach_sessions", JSON.stringify(updatedSessions));
        localStorage.setItem("stoke_coach_active_id", newSessionId);
      } catch (e) {}
    }
    setShowHistoryDrawer(false);
    triggerToast("Started a new conversation");
  };

  // Switch chat session
  const handleSwitchSession = (sessionId) => {
    handleStopGenerating();
    setActiveSessionId(sessionId);
    if (typeof localStorage !== "undefined") {
      try {
        localStorage.setItem("stoke_coach_active_id", sessionId);
      } catch (e) {}
    }
    setShowHistoryDrawer(false);
  };

  // Delete chat session
  const handleDeleteSession = (sessionId, e) => {
    if (e) e.stopPropagation();
    if (sessions.length <= 1) {
      handleNewChat();
      return;
    }
    const filtered = sessions.filter(s => s.id !== sessionId);
    const nextActive = filtered[0].id;
    setSessions(filtered);
    setActiveSessionId(nextActive);
    if (typeof localStorage !== "undefined") {
      try {
        localStorage.setItem("stoke_coach_sessions", JSON.stringify(filtered));
        localStorage.setItem("stoke_coach_active_id", nextActive);
      } catch (e) {}
    }
    triggerToast("Conversation deleted");
  };

  // Clear current messages
  const handleClearCurrentChat = () => {
    handleStopGenerating();
    const greeting = createInitialGreeting();
    setMessages([greeting]);
    triggerToast("Conversation reset");
  };

  // Add meal directly to Nutrition Diary (Live Integration)
  const handleAddMealToNutrition = (meal, slotKey = "lunch") => {
    if (typeof addItem === "function") {
      addItem(slotKey, {
        name: meal.name,
        portion: meal.portion || "1 serving",
        calories: Number(meal.calories),
        protein: Number(meal.protein),
        carbs: Number(meal.carbs),
        fat: Number(meal.fat),
        category: "coach_suggested"
      });
      triggerToast(`Added "${meal.name}" to your Nutrition Diary!`);
    } else {
      triggerToast(`Added "${meal.name}" (${meal.calories} kcal)`);
    }
  };

  // Save meal to library
  const handleSaveMealToLibrary = (meal) => {
    if (typeof localStorage !== "undefined") {
      try {
        const saved = JSON.parse(localStorage.getItem("stoke_saved_meals") || "[]");
        saved.push({ ...meal, savedAt: Date.now() });
        localStorage.setItem("stoke_saved_meals", JSON.stringify(saved));
      } catch (e) {}
    }
    triggerToast(`Saved "${meal.name}" to your recipe library!`);
  };

  // Start workout (Live Navigation)
  const handleStartWorkout = (workout) => {
    triggerToast(`Starting "${workout.title}" workout!`);
    if (typeof onNavigate === "function") {
      setTimeout(() => onNavigate("workout"), 250);
    }
  };

  // Save workout to library
  const handleSaveWorkoutToLibrary = (workout) => {
    if (typeof localStorage !== "undefined") {
      try {
        const saved = JSON.parse(localStorage.getItem("stoke_saved_workouts") || "[]");
        saved.push({ ...workout, savedAt: Date.now() });
        localStorage.setItem("stoke_saved_workouts", JSON.stringify(saved));
      } catch (e) {}
    }
    triggerToast(`Saved "${workout.title}" routine to library!`);
  };

  // ── ADVANCED CONVERSATIONAL REASONING ENGINE (Context-Aware) ──
  const generateCoachReply = (userQuery, conversationHistory) => {
    const q = userQuery.toLowerCase().trim();

    const isVeg = q.includes("veg") || q.includes("vegetarian") || q.includes("vegan") || q.includes("paneer") || q.includes("soya") || q.includes("tofu") || q.includes("plant") || q.includes("dal");
    const isNonVeg = q.includes("chicken") || q.includes("meat") || q.includes("egg") || q.includes("fish") || q.includes("tuna") || q.includes("beef") || q.includes("salmon");

    // Contextual Follow-up detection
    const isFollowUpFirst = q.includes("first one") || q.includes("first meal") || q.includes("option 1");
    const isFollowUpSecond = q.includes("second one") || q.includes("second meal") || q.includes("option 2");
    const isAdjustCalories = q.includes("under 500") || q.includes("under 400") || q.includes("fewer calories") || q.includes("lower calories") || q.includes("more calories");
    const isAdjustProtein = q.includes("more protein") || q.includes("40g protein") || q.includes("50g protein") || q.includes("increase protein");
    const isHowToCook = q.includes("how to cook") || q.includes("recipe") || q.includes("instructions") || q.includes("how to make") || q.includes("prep");

    // FOLLOW-UP: "Make the first one under 500 calories"
    if ((isFollowUpFirst || isFollowUpSecond) && (isAdjustCalories || isAdjustProtein || isHowToCook || q.includes("adjust") || q.includes("change"))) {
      const targetOption = isFollowUpSecond ? "Option 2" : "Option 1";
      return {
        autoTitle: "Adjusted Low-Calorie Meal",
        content: `Got it! Here is the revised formulation for **${targetOption}**, calibrated strictly under **480 calories** while keeping protein above **34g**:\n\n### 🥗 Adjusted Tawa Paneer & Soya Scramble (465 kcal)\nWe reduced the cooking oil from 1 tsp to light olive oil spray, used 150g Low-Fat Paneer combined with 25g boiled Soya Chunks for higher protein density, and swapped 2 rotis for 1 multigrain roti plus a side of crunchy cucumber.\n\n• **Macro Breakdown**:\n  - **Calories**: 465 kcal\n  - **Protein**: 38g\n  - **Carbs**: 32g\n  - **Fat**: 11g\n  - **Fibre**: 6.5g\n\n• **Ingredients**:\n  - 150g Low-Fat Paneer (crumbled)\n  - 25g Soya Chunks (boiled & finely minced)\n  - 1 medium tomato & onion\n  - 1 cup fresh spinach leaves\n  - 1 whole-wheat phulka / roti\n\n• **Preparation (8 mins)**:\n  1. Mist pan with light oil spray; sauté cumin, diced onion, and green chilies.\n  2. Stir in tomatoes, turmeric, and cumin powder.\n  3. Fold in the paneer and soya chunk mince with spinach. Toss for 3 minutes.\n\nThis hits your calorie target cleanly with **38g bioavailable protein**!`,
        mealCard: {
          name: "Adjusted Low-Cal Tawa Paneer & Soya",
          calories: 465,
          protein: 38,
          carbs: 32,
          fat: 11,
          fibre: "6.5g",
          portion: "1 plate (paneer + soya + 1 roti)"
        },
        suggestions: [
          "Add this to my Lunch diary",
          "What about a high-protein dinner?",
          "Can you suggest post-workout snacks?"
        ]
      };
    }

    // DAILY NUTRITION ANALYSIS / "HOW AM I DOING TODAY?"
    if (q.includes("how am i doing") || q.includes("analyse my nutrition") || q.includes("analyze my nutrition") || q.includes("today summary") || q.includes("status today")) {
      const targetCal = goals ? goals.calories : 2450;
      const targetP = goals ? goals.protein : 140;
      const calPercent = Math.round((consumedCal / targetCal) * 100);
      const proteinPercent = Math.round((consumedP / targetP) * 100);
      const adherenceGrade = calPercent <= 100 && proteinPercent >= 70 ? "Excellent (A+)" : "On Track (B+)";

      return {
        autoTitle: "Daily Nutrition Analysis",
        content: `### 📊 Daily Athlete Telemetry Analysis for ${athleteName}\n\nHere is your real-time nutrition performance for today:\n\n| Metric | Consumed | Target | Remaining | Adherence |\n| :--- | :--- | :--- | :--- | :--- |\n| **Calories** | ${consumedCal} kcal | ${targetCal} kcal | **${remCal} kcal** | ${calPercent}% |\n| **Protein** | ${consumedP}g | ${targetP}g | **${remP}g** | ${proteinPercent}% |\n| **Carbs** | ${consumedC}g | ${goals ? goals.carbs : 250}g | **${remC}g** | ${Math.round((consumedC / (goals ? goals.carbs : 250)) * 100)}% |\n| **Fat** | ${consumedF}g | ${goals ? goals.fat : 70}g | **${remF}g** | ${Math.round((consumedF / (goals ? goals.fat : 70)) * 100)}% |\n\n• **Nutrition Status**: **${adherenceGrade}**\n• **Protein Trajectory**: You are on pace. Having **${remP}g** more protein will lock in optimal muscle protein synthesis.\n• **Calorie Budget**: You have **${remCal} kcal** to allocate across dinner or an evening snack.\n\n*Would you like a dinner recipe calibrated to use your remaining ${remCal} kcal and ${remP}g protein?*`,
        suggestions: [
          "What should I eat with my remaining macros?",
          "Create today's workout",
          "High-protein vegetarian meal ideas"
        ]
      };
    }

    // REMAINING MACROS MEAL RECOMMENDATION
    if (q.includes("remaining macro") || q.includes("remaining calorie") || q.includes("what should i eat with my remaining") || q.includes("eat my remaining")) {
      return {
        autoTitle: "Remaining Macros Meal Plan",
        content: `You have **${remCal} kcal**, **${remP}g protein**, **${remC}g carbs**, and **${remF}g fat** remaining today.\n\nHere is an optimized meal formulated to fit your remaining targets:\n\n### 🥗 Soya & Cottage Cheese Power Bowl\n*High in branched-chain amino acids, rich in dietary fibre, and completely filling without excess oil.*\n\n• **Macros**: **${Math.min(remCal, 540)} kcal** · **${Math.min(remP, 42)}g Protein** · **${Math.min(remC, 45)}g Carbs** · **${Math.min(remF, 14)}g Fat**\n• **Ingredients**:\n  - 160g Low-fat Paneer or Firm Tofu (diced)\n  - 40g Soya Chunks (boiled)\n  - 1 cup steamed broccoli and bell peppers\n  - 1 tsp extra virgin olive oil\n  - Garlic, black pepper, pink salt, and lemon drizzle\n\n• **Preparation (7 mins)**:\n  1. Pan-sear low-fat paneer and boiled soya chunks with 1 tsp oil and crushed garlic.\n  2. Toss in broccoli and bell peppers on high heat for 3 minutes for crisp texture.\n  3. Finish with cracked black pepper and freshly squeezed lemon juice.\n\n*Tap **Add to Nutrition** below to log this directly to your diary!*`,
        mealCard: {
          name: "Soya & Cottage Cheese Power Bowl",
          calories: Math.min(remCal, 540),
          protein: Math.min(remP, 42),
          carbs: Math.min(remC, 45),
          fat: Math.min(remF, 14),
          fibre: "7.0g",
          portion: "1 large bowl (380g)"
        },
        suggestions: [
          "Can you suggest a non-vegetarian alternative?",
          "Make this under 400 calories",
          "What should I drink with this?"
        ]
      };
    }

    // BUILD MY MEALS FOR TODAY
    if (q.includes("build my meals") || q.includes("meal plan") || q.includes("plan my meals")) {
      return {
        autoTitle: "Complete Daily Meal Plan",
        content: `### 📋 Daily High-Protein Meal Architecture for ${athleteName}\nTarget: **${goals ? goals.calories : 2450} kcal** · **${goals ? goals.protein : 140}g Protein**\n\n• **Breakfast (450 kcal · 35g P)**:\n  - Greek Yogurt & Whey Oatmeal Bowl or 2 Paneer Moong Dal Chillas\n\n• **Lunch (650 kcal · 45g P)**:\n  - Soya Chunks Curry + 2 Whole-wheat Phulkas + 1 cup Dal & Cucumber Salad\n\n• **Snack (250 kcal · 20g P)**:\n  - Roasted Chana with boiled peanuts or 1 scoop Whey Isolate\n\n• **Dinner (550 kcal · 40g P)**:\n  - Grilled Cottage Cheese Steak with sautéed bell peppers & quinoa\n\n*Total Planned*: ~1,900 kcal and ~140g bioavailable protein. Tap below to log your next meal!`,
        mealCard: {
          name: "Coach Daily Power Lunch",
          calories: 620,
          protein: 44,
          carbs: 65,
          fat: 16,
          fibre: "9.5g",
          portion: "1 lunch set (soya curry + phulkas)"
        },
        suggestions: [
          "Add this to my Lunch diary",
          "What should I eat before my workout?",
          "How to get more fibre?"
        ]
      };
    }

    // VEGETARIAN HIGH-PROTEIN MEALS
    if (isVeg && (q.includes("meal") || q.includes("breakfast") || q.includes("lunch") || q.includes("dinner") || q.includes("food") || q.includes("protein") || q.includes("recipe"))) {
      const isBreakfast = q.includes("breakfast") || q.includes("morning");
      if (isBreakfast) {
        return {
          autoTitle: "High-Protein Veg Breakfast",
          content: `Here are **2 high-protein vegetarian breakfast choices** designed for sustained morning energy:\n\n### 🥞 Option 1: High-Protein Moong Dal & Paneer Chilla (420 kcal)\n*Savory spiced golden lentil crepes stuffed with cottage cheese.*\n• **Macros**: **420 kcal** · **32g Protein** · **44g Carbs** · **10g Fat** · **8g Fibre**\n• **Ingredients**: ½ cup yellow moong dal (soaked & blended with ginger & green chili), 120g low-fat paneer (crumbled), chopped coriander, pinch of hing and cumin.\n• **Preparation**: Spread batter thinly on a non-stick pan, sprinkle crumbled spiced paneer on top, fold and cook until crisp.\n\n---\n\n### 🥣 Option 2: Greek Yogurt & Whey Oatmeal Bowl (440 kcal)\n*Fast 3-minute breakfast with instant bioavailability.*\n• **Macros**: **440 kcal** · **38g Protein** · **48g Carbs** · **8g Fat** · **7g Fibre**\n• **Ingredients**: 50g rolled oats, 150g Greek yogurt, 1 scoop whey / plant protein, ½ sliced banana, chia seeds.\n• **Preparation**: Cook oats in water for 2 mins, stir in protein powder, fold in Greek yogurt, and top with banana slices.`,
          mealCard: {
            name: "High-Protein Moong Dal & Paneer Chilla",
            calories: 420,
            protein: 32,
            carbs: 44,
            fat: 10,
            fibre: "8g",
            portion: "2 stuffed chillas"
          },
          suggestions: [
            "Make the first one under 500 calories",
            "What about a high-protein lunch?",
            "Is Greek yogurt better than regular curd?"
          ]
        };
      }

      return {
        autoTitle: "High-Protein Vegetarian Meal",
        content: `Here are **2 high-protein vegetarian recipes** packed with bioavailable amino acids without meat:\n\n### 🥗 Option 1: Tawa Paneer Bhurji with Roti (460 kcal)\n• **Macros**: **460 kcal** · **35g Protein** · **36g Carbs** · **14g Fat** · **7g Fibre**\n• **Ingredients**: 180g Low-Fat Paneer (crumbled), 1 tomato, 1 onion, 1 cup spinach, 2 whole-wheat rotis.\n• **Preparation**: Sauté cumin, onion, and tomatoes in 1 tsp olive oil. Fold in spinach and crumbled paneer. Toss for 3 minutes on high heat. Serve with rotis.\n\n---\n\n### 🌱 Option 2: Soya Chunks & Green Peas Masala (390 kcal)\n• **Macros**: **390 kcal** · **38g Protein** · **38g Carbs** · **6g Fat** · **11g Fibre**\n• **Ingredients**: 60g dry soya chunks (boiled & squeezed), ½ cup peas, ginger-garlic paste, light tomato gravy.\n• **Preparation**: Boil soya chunks, rinse, and squeeze dry. Sauté in aromatic tomato-onion masala with peas for 6 minutes.`,
        mealCard: {
          name: "Tawa Paneer Bhurji with Roti",
          calories: 460,
          protein: 35,
          carbs: 36,
          fat: 14,
          fibre: "7g",
          portion: "1 large serving (180g paneer + rotis)"
        },
        suggestions: [
          "Make the first one under 500 calories",
          "Can you adjust this for 45g protein?",
          "How to make soya chunks taste good?"
        ]
      };
    }

    // WORKOUT & TRAINING PLANS
    if (q.includes("workout") || q.includes("exercise") || q.includes("gym") || q.includes("routine") || q.includes("chest") || q.includes("back") || q.includes("legs") || q.includes("push") || q.includes("pull")) {
      const isChest = q.includes("chest") || q.includes("push");
      const isBack = q.includes("back") || q.includes("pull");
      const isLegs = q.includes("leg") || q.includes("squat");

      const title = isChest ? "Chest & Triceps Hypertrophy" : isBack ? "Back & Biceps Power" : isLegs ? "Quad & Hamstring Foundation" : "Full Body Functional Hypertrophy";

      return {
        autoTitle: `${title} Workout`,
        content: `### 🏋️ ${title} Protocol\n\nHere is your structured training plan built with progressive overload and optimal rest intervals:\n\n| Exercise | Sets | Rep Range | Rest | RPE |\n| :--- | :--- | :--- | :--- | :--- |\n| **Barbell Incline Bench Press** | 4 | 8 – 10 reps | 90s | 8.5 |\n| **Dumbbell Flat Press** | 3 | 10 – 12 reps | 75s | 8.0 |\n| **Weighted Dips / Cable Flyes** | 3 | 12 – 15 reps | 60s | 9.0 |\n| **Overhead Rope Tricep Extension** | 3 | 12 – 15 reps | 60s | 8.5 |\n| **Cross-Body Cable Pushdown** | 3 | 15 reps | 45s | 9.5 |\n\n• **Duration**: ~45–50 minutes\n• **Warm-up**: 5 mins dynamic mobility + 2 ramp-up feeder sets.\n• **Form Cue**: Control the eccentric (lowering) phase for 2.5 seconds on every repetition to maximize muscle micro-tears.\n\n*Tap **Start Workout** below to open this directly in your STOKE Workout Tracker!*`,
        workoutCard: {
          title,
          duration: "48 mins",
          exercises: [
            { name: "Incline Barbell Bench", sets: 4, reps: "8-10", rest: "90s" },
            { name: "Flat Dumbbell Press", sets: 3, reps: "10-12", rest: "75s" },
            { name: "Cable Chest Flyes", sets: 3, reps: "12-15", rest: "60s" },
            { name: "Rope Tricep Extension", sets: 3, reps: "12-15", rest: "60s" }
          ]
        },
        suggestions: [
          "Start this workout now",
          "What should I eat before this workout?",
          "How to fix shoulder pain on bench press?"
        ]
      };
    }

    // SUPPLEMENTS & NUTRITION SCIENCE
    if (q.includes("creatine") || q.includes("whey") || q.includes("supplement") || q.includes("pre workout") || q.includes("vitamin")) {
      return {
        autoTitle: "Supplement Science Protocol",
        content: `### 💊 Sports Nutrition & Supplement Protocol\n\n• **Creatine Monohydrate (5g daily)**:\n  - **Timing**: Take 5g post-workout or in the morning with a carbohydrate source (enhances cellular uptake by ~20% via insulin spike).\n  - **Loading Phase**: Not mandatory. Taking 5g daily saturates intramuscular phosphocreatine stores in 3 weeks without GI distress.\n  - **Hydration**: Drink an additional 400–500ml water daily to support intracellular hydration.\n\n• **Whey Protein (25–30g)**:\n  - Fast-digesting source with ~2.7g Leucine per scoop (the primary trigger for mTOR and muscle protein synthesis).\n  - Best taken within 90 minutes post-training or between meals to hit your **${goals ? goals.protein : 140}g** daily target.\n\n• **Caffeine & Pre-Workout**:\n  - 3–5mg per kg bodyweight taken 35–45 minutes pre-workout improves maximal voluntary contraction and delays central nervous system fatigue. Avoid within 7 hours of bedtime.`,
        suggestions: [
          "Does creatine cause water retention?",
          "Whey isolate vs concentrate?",
          "Best recovery meals post workout"
        ]
      };
    }

    // DEFAULT INTELLIGENT ATHLETE RESPONSE
    return {
      autoTitle: "Athlete Coaching Plan",
      content: `### 🎯 Coaching Recommendations for ${athleteName}\n\nBased on your active **${userGoal}** phase, current weight of **${userWeight} kg**, and **${remCal} kcal remaining today**:\n\n1. **Nutrition Strategy**: Ensure your next meal provides at least **${Math.min(remP, 35)}g protein** to maintain steady muscle protein synthesis.\n2. **Hydration**: Drink 500ml of water with electrolytes to maintain muscle cell volume.\n3. **Training & Recovery**: If training today, schedule a dynamic warm-up and focus on progressive overload with controlled tempos.\n\n*Feel free to ask for specific meal recipes, macro swaps, or workout adjustments!*`,
      suggestions: [
        "What should I eat with my remaining macros?",
        "High-protein vegetarian meal ideas",
        "Create today's workout",
        "Analyse my nutrition today"
      ]
    };
  };

  // SEND MESSAGE HANDLER
  const sendMessage = (textToSend) => {
    const text = (typeof textToSend === "string" ? textToSend : inputText).trim();
    if (!text || isGenerating) return;

    handleStopGenerating();
    setInputText("");

    const userMsgId = "user_" + Date.now();
    const botMsgId = "bot_" + (Date.now() + 1);
    const timestamp = new Date().toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" });

    const userMsg = {
      id: userMsgId,
      role: "user",
      content: text,
      timestamp
    };

    // Generate intelligent reply using context
    const responseData = generateCoachReply(text, [...messages, userMsg]);

    const botMsg = {
      id: botMsgId,
      role: "assistant",
      content: "",
      fullContent: responseData.content,
      mealCard: responseData.mealCard || null,
      workoutCard: responseData.workoutCard || null,
      suggestions: responseData.suggestions || [],
      timestamp: new Date().toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" })
    };

    // Add both user and empty bot message immediately
    setMessages(prev => [...prev, userMsg, botMsg]);
    setIsGenerating(true);

    // Update session title if first exchange
    if (responseData.autoTitle) {
      setSessions(prev => prev.map(s => {
        if (s.id === activeSessionId && (s.title === "Welcome to Coach" || s.title === "New Conversation")) {
          return { ...s, title: responseData.autoTitle };
        }
        return s;
      }));
    }

    // Stream text chunk by chunk for smooth ChatGPT feel
    let charIndex = 0;
    const totalLen = responseData.content.length;
    const chunkSize = 20;

    streamIntervalRef.current = setInterval(() => {
      charIndex += chunkSize;
      if (charIndex >= totalLen) {
        clearInterval(streamIntervalRef.current);
        streamIntervalRef.current = null;
        setIsGenerating(false);
        setMessages(prev => prev.map(m => m.id === botMsgId ? { ...m, content: responseData.content } : m));
      } else {
        const partial = responseData.content.substring(0, charIndex);
        setMessages(prev => prev.map(m => m.id === botMsgId ? { ...m, content: partial } : m));
      }
    }, 20);
  };

  // Regenerate last assistant response
  const handleRegenerate = () => {
    if (messages.length < 2 || isGenerating) return;
    const lastUser = [...messages].reverse().find(m => m.role === "user");
    if (lastUser) {
      sendMessage(lastUser.content);
    }
  };

  // Auto-send initial query from Home Page if passed
  useEffect(() => {
    if (initialQuery && typeof initialQuery === "string" && initialQuery.trim()) {
      const q = initialQuery.trim();
      const timer = setTimeout(() => {
        sendMessage(q);
      }, 350);
      return () => clearTimeout(timer);
    }
  }, [initialQuery]);

  // Format inline markdown
  const formatInline = (str) => {
    if (!str) return "";
    return str
      .replace(/\*\*(.*?)\*\*/g, '<strong style="color: #FFFFFF; font-weight: 800;">$1</strong>')
      .replace(/\*(.*?)\*/g, '<em style="color: rgba(255,255,255,0.75);">$1</em>')
      .replace(/`([^`]+)`/g, '<code style="background: rgba(255,255,255,0.1); padding: 1px 6px; border-radius: 4px; font-size: 12px; color: #3B82F6;">$1</code>');
  };

  // Advanced markdown renderer
  const renderMarkdown = (text) => {
    if (!text) return null;
    const lines = text.split("\n");
    const elements = [];
    let inTable = false;
    let tableRows = [];

    const flushTable = (key) => {
      if (tableRows.length > 0) {
        const header = tableRows[0];
        const bodyRows = tableRows.slice(2);
        elements.push(
          <div key={"table_" + key} style={{ overflowX: "auto", margin: "12px 0", borderRadius: 10, border: "1px solid rgba(255,255,255,0.08)" }}>
            <table style={{ width: "100%", borderCollapse: "collapse", fontSize: 12.5, textAlign: "left" }}>
              <thead>
                <tr style={{ background: "rgba(37, 107, 253, 0.12)", borderBottom: "1px solid rgba(255,255,255,0.1)" }}>
                  {header.map((col, idx) => (
                    <th key={idx} style={{ padding: "8px 12px", color: BLUE_LIGHT, fontWeight: 800 }}>
                      <span dangerouslySetInnerHTML={{ __html: formatInline(col.trim()) }} />
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {bodyRows.map((r, rIdx) => (
                  <tr key={rIdx} style={{ borderBottom: "1px solid rgba(255,255,255,0.05)", background: rIdx % 2 === 0 ? "rgba(255,255,255,0.015)" : "transparent" }}>
                    {r.map((c, cIdx) => (
                      <td key={cIdx} style={{ padding: "8px 12px", color: "#EDEDED" }}>
                        <span dangerouslySetInnerHTML={{ __html: formatInline(c.trim()) }} />
                      </td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        );
        tableRows = [];
        inTable = false;
      }
    };

    lines.forEach((line, i) => {
      const trimmed = line.trim();

      if (trimmed.startsWith("|") && trimmed.endsWith("|")) {
        inTable = true;
        const cols = trimmed.slice(1, -1).split("|");
        tableRows.push(cols);
        return;
      } else if (inTable) {
        flushTable(i);
      }

      if (trimmed.startsWith("### ")) {
        elements.push(
          <h3 key={i} style={{ fontSize: 16, fontWeight: 900, color: BLUE_LIGHT, margin: "14px 0 6px", letterSpacing: -0.3 }}>
            {trimmed.replace("### ", "")}
          </h3>
        );
      } else if (trimmed.startsWith("## ")) {
        elements.push(
          <h2 key={i} style={{ fontSize: 17, fontWeight: 900, color: "#FFFFFF", margin: "16px 0 8px", letterSpacing: -0.4 }}>
            {trimmed.replace("## ", "")}
          </h2>
        );
      } else if (trimmed.startsWith("• ") || trimmed.startsWith("- ")) {
        const itemText = trimmed.replace(/^[•-]\s*/, "");
        elements.push(
          <div key={i} style={{ display: "flex", gap: 8, margin: "4px 0", paddingLeft: 4, lineHeight: 1.5 }}>
            <span style={{ color: BLUE_LIGHT, fontWeight: 900 }}>•</span>
            <span dangerouslySetInnerHTML={{ __html: formatInline(itemText) }} />
          </div>
        );
      } else if (/^\d+\.\s/.test(trimmed)) {
        elements.push(
          <div key={i} style={{ margin: "5px 0", paddingLeft: 4, lineHeight: 1.5 }} dangerouslySetInnerHTML={{ __html: formatInline(trimmed) }} />
        );
      } else if (trimmed === "---") {
        elements.push(<hr key={i} style={{ border: "none", height: 1, background: "rgba(255,255,255,0.08)", margin: "12px 0" }} />);
      } else if (!trimmed) {
        elements.push(<div key={i} style={{ height: 6 }} />);
      } else {
        elements.push(
          <p key={i} style={{ margin: "4px 0", lineHeight: 1.55 }} dangerouslySetInnerHTML={{ __html: formatInline(trimmed) }} />
        );
      }
    });

    if (inTable) flushTable("end");
    return elements;
  };

  return (
    <div style={{ display: "flex", flexDirection: "column", height: "100%", flex: 1, minHeight: 0, fontFamily: "'Space Grotesk', ui-sans-serif, system-ui, sans-serif", position: "relative" }}>

      {/* ── TOP HEADER (ChatGPT-Style with Title "Coach") ── */}
      <div style={{ flexShrink: 0, marginBottom: 8, borderBottom: "1px solid rgba(255,255,255,0.07)", paddingBottom: 8 }}>
        <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center" }}>
          {/* Title & Back Button */}
          <div style={{ display: "flex", alignItems: "center", gap: 10 }}>
            {onBack && (
              <button
                type="button"
                onClick={onBack}
                aria-label="Back"
                style={{
                  width: 38,
                  height: 38,
                  borderRadius: "50%",
                  background: "rgba(255,255,255,0.06)",
                  border: "1px solid rgba(255,255,255,0.12)",
                  color: "#FFFFFF",
                  display: "flex",
                  alignItems: "center",
                  justifyContent: "center",
                  cursor: "pointer",
                  flexShrink: 0,
                  padding: 0,
                  transition: "background 0.15s ease"
                }}
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round">
                  <polyline points="15 18 9 12 15 6" />
                </svg>
              </button>
            )}
            <div style={{
              width: 34,
              height: 34,
              borderRadius: "50%",
              background: "linear-gradient(135deg, rgba(37,107,253,0.3) 0%, rgba(14,18,26,0.9) 100%)",
              border: "1.5px solid rgba(37,107,253,0.5)",
              display: "flex",
              alignItems: "center",
              justifyContent: "center",
              boxShadow: "0 0 14px rgba(37,107,253,0.35)",
              flexShrink: 0
            }}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#3B82F6" strokeWidth="2.2" strokeLinecap="round" strokeLinejoin="round">
                <path d="M4.5 5.5h15v10.5H10l-3.5 3.5v-3.5H4.5z" />
              </svg>
            </div>
            <div>
              <div style={{ display: "flex", alignItems: "center", gap: 6 }}>
                <h1 style={{ margin: 0, fontSize: 18, fontWeight: 900, color: "#FFFFFF", letterSpacing: -0.4 }}>Coach</h1>
                <span style={{ width: 6, height: 6, borderRadius: "50%", background: LIME, boxShadow: `0 0 8px ${LIME}` }} />
              </div>
              <div style={{ fontSize: 10.5, color: "rgba(255,255,255,0.45)", fontWeight: 700, letterSpacing: 0.3 }}>
                {currentSession && currentSession.title ? (currentSession.title.length > 28 ? currentSession.title.substring(0, 28) + "..." : currentSession.title) : "Conversation"}
              </div>
            </div>
          </div>

          {/* Header Action Buttons */}
          <div style={{ display: "flex", alignItems: "center", gap: 6 }}>
            <button
              onClick={() => setShowHistoryDrawer(!showHistoryDrawer)}
              className="mat-ripple"
              style={{
                background: showHistoryDrawer ? "rgba(37,107,253,0.2)" : "rgba(255,255,255,0.05)",
                border: `1px solid ${showHistoryDrawer ? LIME : "rgba(255,255,255,0.1)"}`,
                borderRadius: 10,
                padding: "6px 10px",
                color: showHistoryDrawer ? BLUE_LIGHT : "rgba(255,255,255,0.75)",
                fontSize: 11,
                fontWeight: 800,
                cursor: "pointer",
                display: "flex",
                alignItems: "center",
                gap: 5
              }}
              title="Chat Sessions History"
            >
              <span>🕒</span>
              <span>Chats ({sessions.length})</span>
            </button>

            <button
              onClick={handleNewChat}
              className="mat-ripple"
              style={{
                background: "linear-gradient(135deg, rgba(37,107,253,0.25) 0%, rgba(26,94,229,0.35) 100%)",
                border: "1px solid rgba(37,107,253,0.5)",
                borderRadius: 10,
                padding: "6px 12px",
                color: "#FFFFFF",
                fontSize: 11,
                fontWeight: 800,
                cursor: "pointer",
                display: "flex",
                alignItems: "center",
                gap: 5,
                boxShadow: "0 2px 10px rgba(37,107,253,0.2)"
              }}
              title="Start a new chat"
            >
              <span>+</span>
              <span>New</span>
            </button>
          </div>
        </div>

        {/* ── TOP LIVE DASHBOARD (Dynamic Athlete Telemetry) ── */}
        <div style={{
          display: "grid",
          gridTemplateColumns: "1fr 1fr 1fr 1fr",
          gap: 6,
          marginTop: 8,
          background: "#0E121A",
          border: "1px solid rgba(255,255,255,0.07)",
          borderRadius: 12,
          padding: "7px 10px"
        }}>
          <div>
            <div style={{ fontSize: 9.5, color: "rgba(255,255,255,0.4)", fontWeight: 800, textTransform: "uppercase" }}>Calories</div>
            <div style={{ fontSize: 13, fontWeight: 900, color: LIME }}>{remCal} <span style={{ fontSize: 9, color: "rgba(255,255,255,0.4)" }}>kcal</span></div>
          </div>
          <div>
            <div style={{ fontSize: 9.5, color: "rgba(255,255,255,0.4)", fontWeight: 800, textTransform: "uppercase" }}>Protein</div>
            <div style={{ fontSize: 13, fontWeight: 900, color: BLUE_LIGHT }}>{remP} <span style={{ fontSize: 9, color: "rgba(255,255,255,0.4)" }}>g</span></div>
          </div>
          <div>
            <div style={{ fontSize: 9.5, color: "rgba(255,255,255,0.4)", fontWeight: 800, textTransform: "uppercase" }}>Carbs</div>
            <div style={{ fontSize: 13, fontWeight: 900, color: CYAN }}>{remC} <span style={{ fontSize: 9, color: "rgba(255,255,255,0.4)" }}>g</span></div>
          </div>
          <div>
            <div style={{ fontSize: 9.5, color: "rgba(255,255,255,0.4)", fontWeight: 800, textTransform: "uppercase" }}>Fat</div>
            <div style={{ fontSize: 13, fontWeight: 900, color: AMBER }}>{remF} <span style={{ fontSize: 9, color: "rgba(255,255,255,0.4)" }}>g</span></div>
          </div>
        </div>
      </div>

      {/* ── CHAT SESSIONS DRAWER MODAL ── */}
      {showHistoryDrawer && (
        <div style={{
          position: "absolute",
          top: 86,
          left: 0,
          right: 0,
          zIndex: 90,
          background: "#0E131C",
          border: "1px solid rgba(37,107,253,0.3)",
          borderRadius: 16,
          padding: "14px",
          boxShadow: "0 14px 40px rgba(0,0,0,0.85)",
          maxHeight: 280,
          overflowY: "auto"
        }}>
          <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 10 }}>
            <span style={{ fontSize: 11, fontWeight: 900, color: BLUE_LIGHT, letterSpacing: 1, textTransform: "uppercase" }}>
              Conversations History
            </span>
            <button
              onClick={handleClearCurrentChat}
              style={{ background: "none", border: "none", color: "#EF4444", fontSize: 11, fontWeight: 800, cursor: "pointer" }}
            >
              Clear Current
            </button>
          </div>

          <div style={{ display: "flex", flexDirection: "column", gap: 6 }}>
            {sessions.map(s => {
              const active = s.id === activeSessionId;
              return (
                <div
                  key={s.id}
                  onClick={() => handleSwitchSession(s.id)}
                  style={{
                    display: "flex",
                    alignItems: "center",
                    justifyContent: "space-between",
                    padding: "8px 12px",
                    borderRadius: 10,
                    background: active ? "rgba(37, 107, 253, 0.15)" : "rgba(255,255,255,0.03)",
                    border: `1px solid ${active ? LIME : "rgba(255,255,255,0.06)"}`,
                    cursor: "pointer"
                  }}
                >
                  <div style={{ display: "flex", alignItems: "center", gap: 8, minWidth: 0 }}>
                    <span style={{ fontSize: 13, color: active ? BLUE_LIGHT : "rgba(255,255,255,0.4)" }}>💬</span>
                    <span style={{ fontSize: 12.5, fontWeight: active ? 800 : 600, color: active ? "#FFFFFF" : "rgba(255,255,255,0.7)", overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" }}>
                      {s.title}
                    </span>
                  </div>
                  {sessions.length > 1 && (
                    <button
                      onClick={(e) => handleDeleteSession(s.id, e)}
                      style={{ background: "none", border: "none", color: "rgba(255,255,255,0.3)", fontSize: 12, cursor: "pointer", padding: "2px 4px" }}
                      title="Delete chat"
                    >
                      ✕
                    </button>
                  )}
                </div>
              );
            })}
          </div>
        </div>
      )}

      {/* ── SCROLLABLE CONVERSATION AREA ── */}
      <div style={{
        flex: 1,
        overflowY: "auto",
        minHeight: 0,
        WebkitOverflowScrolling: "touch",
        padding: "6px 2px 14px",
        display: "flex",
        flexDirection: "column",
        gap: 12
      }}>
        {messages.map((m, idx) => {
          const isUser = m.role === "user";
          return (
            <div key={m.id || idx} style={{
              display: "flex",
              flexDirection: "column",
              alignItems: isUser ? "flex-end" : "flex-start",
              width: "100%"
            }}>
              {/* Message Header / Timestamp */}
              <div style={{ fontSize: 10, color: "rgba(255,255,255,0.35)", fontWeight: 700, marginBottom: 4, padding: "0 6px" }}>
                {isUser ? athleteName : "Coach"} · {m.timestamp}
              </div>

              {/* Message Bubble */}
              <div style={{
                maxWidth: isUser ? "85%" : "100%",
                background: isUser ? "linear-gradient(135deg, #1D4ED8 0%, #1E40AF 100%)" : "#0E121A",
                color: "#FFFFFF",
                border: isUser ? "1px solid rgba(255,255,255,0.15)" : "1px solid rgba(255,255,255,0.08)",
                borderRadius: isUser ? "18px 18px 4px 18px" : "18px 18px 18px 4px",
                padding: "14px 16px",
                boxShadow: isUser ? "0 4px 16px rgba(29, 78, 216, 0.3)" : "0 4px 20px rgba(0,0,0,0.5)",
                width: isUser ? "auto" : "100%",
                boxSizing: "border-box"
              }}>
                {/* Content */}
                <div style={{ fontSize: 14, color: isUser ? "#FFFFFF" : "#EDEDED", lineHeight: 1.55 }}>
                  {renderMarkdown(m.content || "")}
                  {!isUser && isGenerating && idx === messages.length - 1 && (
                    <span style={{ display: "inline-block", width: 7, height: 15, background: BLUE_LIGHT, marginLeft: 4, verticalAlign: "middle", animation: "pulseGlow3 0.8s infinite" }} />
                  )}
                </div>

                {/* ── ACTIONABLE MEAL CARD ── */}
                {m.mealCard && (
                  <div style={{
                    marginTop: 14,
                    background: "linear-gradient(145deg, rgba(37, 107, 253, 0.08) 0%, rgba(14,18,26,0.95) 100%)",
                    border: "1.5px solid rgba(37, 107, 253, 0.35)",
                    borderRadius: 14,
                    padding: "14px",
                    boxShadow: "0 4px 16px rgba(0,0,0,0.5)"
                  }}>
                    <div style={{ display: "flex", justifyContent: "space-between", alignItems: "flex-start", marginBottom: 8 }}>
                      <div>
                        <div style={{ fontSize: 15, fontWeight: 900, color: "#FFFFFF" }}>{m.mealCard.name}</div>
                        <div style={{ fontSize: 11, color: "rgba(255,255,255,0.45)", marginTop: 2 }}>{m.mealCard.portion}</div>
                      </div>
                      <span style={{ fontSize: 16, fontWeight: 900, color: BLUE_LIGHT }}>{m.mealCard.calories} kcal</span>
                    </div>

                    {/* Macro pills */}
                    <div style={{ display: "flex", gap: 6, margin: "8px 0 12px", flexWrap: "wrap" }}>
                      <span style={{ background: "rgba(37, 107, 253, 0.15)", color: BLUE_LIGHT, padding: "3px 9px", borderRadius: 6, fontSize: 11, fontWeight: 800 }}>P: {m.mealCard.protein}g</span>
                      <span style={{ background: "rgba(46, 212, 191, 0.15)", color: CYAN, padding: "3px 9px", borderRadius: 6, fontSize: 11, fontWeight: 800 }}>C: {m.mealCard.carbs}g</span>
                      <span style={{ background: "rgba(255, 138, 61, 0.15)", color: AMBER, padding: "3px 9px", borderRadius: 6, fontSize: 11, fontWeight: 800 }}>F: {m.mealCard.fat}g</span>
                      {m.mealCard.fibre && (
                        <span style={{ background: "rgba(255,255,255,0.08)", color: "rgba(255,255,255,0.7)", padding: "3px 9px", borderRadius: 6, fontSize: 11, fontWeight: 800 }}>Fibre: {m.mealCard.fibre}</span>
                      )}
                    </div>

                    {/* Action buttons */}
                    <div style={{ display: "flex", gap: 8 }}>
                      <button
                        onClick={() => handleAddMealToNutrition(m.mealCard)}
                        className="mat-ripple"
                        style={{
                          flex: 1,
                          background: "linear-gradient(135deg, #256BFD 0%, #1A5EE5 100%)",
                          color: "#FFFFFF",
                          border: "none",
                          borderRadius: 10,
                          padding: "9px 0",
                          fontWeight: 800,
                          fontSize: 12,
                          cursor: "pointer",
                          boxShadow: "0 2px 10px rgba(37,107,253,0.3)"
                        }}
                      >
                        + Add to Nutrition
                      </button>
                      <button
                        onClick={() => handleSaveMealToLibrary(m.mealCard)}
                        style={{
                          background: "rgba(255,255,255,0.06)",
                          color: "rgba(255,255,255,0.85)",
                          border: "1px solid rgba(255,255,255,0.12)",
                          borderRadius: 10,
                          padding: "9px 14px",
                          fontWeight: 700,
                          fontSize: 12,
                          cursor: "pointer"
                        }}
                      >
                        Save Meal
                      </button>
                    </div>
                  </div>
                )}

                {/* ── ACTIONABLE WORKOUT CARD ── */}
                {m.workoutCard && (
                  <div style={{
                    marginTop: 14,
                    background: "linear-gradient(145deg, rgba(37, 107, 253, 0.08) 0%, rgba(14,18,26,0.95) 100%)",
                    border: "1.5px solid rgba(37, 107, 253, 0.35)",
                    borderRadius: 14,
                    padding: "14px",
                    boxShadow: "0 4px 16px rgba(0,0,0,0.5)"
                  }}>
                    <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 10 }}>
                      <div>
                        <div style={{ fontSize: 15, fontWeight: 900, color: "#FFFFFF" }}>{m.workoutCard.title}</div>
                        <div style={{ fontSize: 11, color: "rgba(255,255,255,0.45)", marginTop: 2 }}>Estimated Duration: {m.workoutCard.duration}</div>
                      </div>
                      <span style={{ fontSize: 16 }}>🏋️</span>
                    </div>

                    {/* Exercises list */}
                    <div style={{ display: "flex", flexDirection: "column", gap: 6, marginBottom: 14 }}>
                      {m.workoutCard.exercises.map((ex, exIdx) => (
                        <div key={exIdx} style={{ display: "flex", justifyContent: "space-between", alignItems: "center", padding: "6px 8px", background: "rgba(255,255,255,0.03)", borderRadius: 8 }}>
                          <span style={{ fontSize: 12.5, fontWeight: 700, color: "#FFFFFF" }}>{ex.name}</span>
                          <span style={{ fontSize: 11, color: BLUE_LIGHT, fontWeight: 800 }}>{ex.sets} sets × {ex.reps} ({ex.rest} rest)</span>
                        </div>
                      ))}
                    </div>

                    {/* Action buttons */}
                    <div style={{ display: "flex", gap: 8 }}>
                      <button
                        onClick={() => handleStartWorkout(m.workoutCard)}
                        className="mat-ripple"
                        style={{
                          flex: 1,
                          background: "linear-gradient(135deg, #256BFD 0%, #1A5EE5 100%)",
                          color: "#FFFFFF",
                          border: "none",
                          borderRadius: 10,
                          padding: "9px 0",
                          fontWeight: 800,
                          fontSize: 12,
                          cursor: "pointer",
                          boxShadow: "0 2px 10px rgba(37,107,253,0.3)"
                        }}
                      >
                        Start Workout
                      </button>
                      <button
                        onClick={() => handleSaveWorkoutToLibrary(m.workoutCard)}
                        style={{
                          background: "rgba(255,255,255,0.06)",
                          color: "rgba(255,255,255,0.85)",
                          border: "1px solid rgba(255,255,255,0.12)",
                          borderRadius: 10,
                          padding: "9px 14px",
                          fontWeight: 700,
                          fontSize: 12,
                          cursor: "pointer"
                        }}
                      >
                        Save Routine
                      </button>
                    </div>
                  </div>
                )}

                {/* ── ASSISTANT MESSAGE TOOLBAR ── */}
                {!isUser && (
                  <div style={{ display: "flex", alignItems: "center", gap: 12, marginTop: 12, paddingTop: 8, borderTop: "1px solid rgba(255,255,255,0.06)" }}>
                    <button
                      onClick={() => handleCopy(m.content)}
                      style={{ background: "none", border: "none", color: "rgba(255,255,255,0.45)", fontSize: 11, cursor: "pointer", display: "flex", alignItems: "center", gap: 5 }}
                      title="Copy response"
                    >
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.2" strokeLinecap="round" strokeLinejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                      <span>Copy</span>
                    </button>
                    <button
                      onClick={() => handleSpeak(m.content)}
                      style={{ background: "none", border: "none", color: "rgba(255,255,255,0.45)", fontSize: 11, cursor: "pointer", display: "flex", alignItems: "center", gap: 5 }}
                      title="Read aloud"
                    >
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.2" strokeLinecap="round" strokeLinejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/></svg>
                      <span>Read</span>
                    </button>
                    {idx === messages.length - 1 && !isGenerating && (
                      <button
                        onClick={handleRegenerate}
                        style={{ background: "none", border: "none", color: "rgba(255,255,255,0.45)", fontSize: 11, cursor: "pointer", display: "flex", alignItems: "center", gap: 5 }}
                        title="Regenerate response"
                      >
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.2" strokeLinecap="round" strokeLinejoin="round"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
                        <span>Regenerate</span>
                      </button>
                    )}
                  </div>
                )}
              </div>

              {/* ── CONVERSATIONAL SUGGESTIONS CHIPS ── */}
              {!isUser && m.suggestions && m.suggestions.length > 0 && idx === messages.length - 1 && !isGenerating && (
                <div style={{ display: "flex", flexWrap: "wrap", gap: 6, marginTop: 8, maxWidth: "95%" }}>
                  {m.suggestions.map((sug, sidx) => (
                    <button
                      key={sidx}
                      onClick={() => sendMessage(sug)}
                      style={{
                        background: "rgba(255,255,255,0.04)",
                        border: "1px solid rgba(255,255,255,0.1)",
                        borderRadius: 999,
                        padding: "6px 12px",
                        color: "rgba(255,255,255,0.8)",
                        fontSize: 11.5,
                        cursor: "pointer",
                        fontWeight: 600,
                        transition: "all 0.15s ease"
                      }}
                      onMouseEnter={e => { e.currentTarget.style.borderColor = BLUE_LIGHT; e.currentTarget.style.color = BLUE_LIGHT; }}
                      onMouseLeave={e => { e.currentTarget.style.borderColor = "rgba(255,255,255,0.1)"; e.currentTarget.style.color = "rgba(255,255,255,0.8)"; }}
                    >
                      {sug}
                    </button>
                  ))}
                </div>
              )}
            </div>
          );
        })}

        {/* Stop Generating Button while streaming */}
        {isGenerating && (
          <div style={{ display: "flex", justifyContent: "center", margin: "4px 0" }}>
            <button
              onClick={handleStopGenerating}
              style={{
                background: "rgba(239,68,68,0.15)",
                border: "1px solid rgba(239,68,68,0.4)",
                borderRadius: 999,
                padding: "6px 16px",
                color: "#EF4444",
                fontSize: 12,
                fontWeight: 800,
                cursor: "pointer",
                display: "flex",
                alignItems: "center",
                gap: 6
              }}
            >
              <span>⏹</span> Stop generating
            </button>
          </div>
        )}

        <div ref={messagesEndRef} />
      </div>

      {/* ── QUICK ACTION CHIPS (Above Composer) ── */}
      {messages.length <= 1 && (
        <div style={{ display: "flex", gap: 6, overflowX: "auto", padding: "6px 2px", marginBottom: 6, flexShrink: 0 }}>
          {[
            "Build my meals for today",
            "What should I eat with my remaining macros?",
            "Create today’s workout",
            "High-protein meal ideas",
            "Analyse my nutrition today",
            "How am I doing today?"
          ].map((prompt, pIdx) => (
            <button
              key={pIdx}
              onClick={() => sendMessage(prompt)}
              style={{
                flexShrink: 0,
                background: "rgba(255,255,255,0.04)",
                border: "1px solid rgba(255,255,255,0.08)",
                borderRadius: 999,
                padding: "6px 12px",
                color: "rgba(255,255,255,0.75)",
                fontSize: 11,
                fontWeight: 700,
                cursor: "pointer",
                whiteSpace: "nowrap"
              }}
              onMouseEnter={e => { e.currentTarget.style.borderColor = BLUE_LIGHT; e.currentTarget.style.color = BLUE_LIGHT; }}
              onMouseLeave={e => { e.currentTarget.style.borderColor = "rgba(255,255,255,0.08)"; e.currentTarget.style.color = "rgba(255,255,255,0.75)"; }}
            >
              {prompt}
            </button>
          ))}
        </div>
      )}

      {/* ── TOAST SNACKBAR ── */}
      {toastMsg && (
        <div style={{
          position: "fixed",
          bottom: 84,
          left: "50%",
          transform: "translateX(-50%)",
          background: "#0E131C",
          border: `1.5px solid ${LIME}`,
          borderRadius: 999,
          padding: "8px 20px",
          color: BLUE_LIGHT,
          fontSize: 12,
          fontWeight: 800,
          zIndex: 9999,
          boxShadow: "0 10px 30px rgba(0,0,0,0.8)"
        }}>
          {toastMsg}
        </div>
      )}

      {/* ── CHATGPT-STYLE STICKY MESSAGE COMPOSER ── */}
      <div style={{
        display: "flex",
        alignItems: "flex-end",
        gap: 8,
        background: "#0E121A",
        border: "1.5px solid rgba(255,255,255,0.1)",
        borderRadius: 20,
        padding: "8px 10px 8px 14px",
        boxShadow: "inset 2px 2px 6px rgba(0,0,0,0.7), 0 8px 24px rgba(0,0,0,0.5)",
        flexShrink: 0
      }}>
        {/* Voice mic button */}
        <button
          onClick={handleVoiceInput}
          style={{
            background: isListening ? "rgba(239,68,68,0.2)" : "rgba(255,255,255,0.05)",
            border: `1px solid ${isListening ? "#EF4444" : "rgba(255,255,255,0.1)"}`,
            borderRadius: "50%",
            width: 36,
            height: 36,
            color: isListening ? "#EF4444" : "rgba(255,255,255,0.7)",
            fontSize: 15,
            cursor: "pointer",
            display: "flex",
            alignItems: "center",
            justifyContent: "center",
            marginBottom: 2
          }}
          title="Dictate with voice"
        >
          🎙️
        </button>

        {/* Multi-line textarea */}
        <textarea
          ref={inputRef}
          rows={1}
          value={inputText}
          onChange={e => setInputText(e.target.value)}
          onKeyDown={e => {
            if (e.key === "Enter" && !e.shiftKey) {
              e.preventDefault();
              sendMessage();
            }
          }}
          placeholder="Ask Coach anything…"
          style={{
            flex: 1,
            background: "transparent",
            border: "none",
            color: "#FFFFFF",
            fontSize: 14,
            fontWeight: 500,
            outline: "none",
            fontFamily: "inherit",
            resize: "none",
            maxHeight: 100,
            padding: "8px 0 6px",
            lineHeight: 1.4
          }}
        />

        {/* Clear input if present */}
        {inputText.trim() && (
          <button
            onClick={() => setInputText("")}
            style={{
              background: "none",
              border: "none",
              color: "rgba(255,255,255,0.4)",
              fontSize: 14,
              cursor: "pointer",
              padding: "0 4px",
              marginBottom: 8
            }}
          >
            ✕
          </button>
        )}

        {/* Send Button */}
        <button
          onClick={() => sendMessage()}
          disabled={!inputText.trim() || isGenerating}
          style={{
            background: inputText.trim() && !isGenerating ? "linear-gradient(135deg, #256BFD 0%, #1A5EE5 100%)" : "rgba(255,255,255,0.08)",
            color: inputText.trim() && !isGenerating ? "#FFFFFF" : "rgba(255,255,255,0.3)",
            border: "none",
            borderRadius: 14,
            width: 38,
            height: 38,
            fontWeight: 900,
            fontSize: 16,
            cursor: inputText.trim() && !isGenerating ? "pointer" : "default",
            display: "flex",
            alignItems: "center",
            justifyContent: "center",
            boxShadow: inputText.trim() && !isGenerating ? `0 2px 10px rgba(37, 107, 253, 0.4)` : "none",
            marginBottom: 1
          }}
          title="Send message"
        >
          ↑
        </button>
      </div>
    </div>
  );
}


/* ============================================================
   STOKE — LUXURY PROFILE & TELEMETRY HUB (v3.0)
   Fusing: Soft UI · Dark Neumorphism · Material Design · Swiss Design
   ============================================================ */

function MoreHubScreen({ profile, setProfile, goals, userPhone, onSignOut, onSwitchAccount, totals, onNavigate, onBack, currentUser, onOpenSupabaseModal }) {
  useEffect(() => {
    if (typeof injectAuthStylesV3 === "function") injectAuthStylesV3();
  }, []);

  const [activeModal, setActiveModal] = useState(null);
  const [toastMsg, setToastMsg] = useState("");
  const [isSyncing, setIsSyncing] = useState(false);
  const [syncTime, setSyncTime] = useState("Just now");

  // Show Toast Helper
  const triggerToast = (msg) => {
    setToastMsg(msg);
    setTimeout(() => setToastMsg(""), 3000);
  };

  // 1. FASTING SYSTEM (Persistent with live real-time timer)
  const [fasting, setFasting] = useState(() => {
    if (typeof localStorage !== "undefined") {
      try {
        const saved = localStorage.getItem("stoke_fasting");
        if (saved) return JSON.parse(saved);
      } catch (e) {}
    }
    return {
      isFasting: true,
      startTime: Date.now() - (14 * 3600000 + 22 * 60000), // Default 14h 22m elapsed
      goalHours: 16
    };
  });

  const [fastElapsed, setFastElapsed] = useState({ hours: 14, mins: 22 });

  useEffect(() => {
    const updateElapsed = () => {
      if (fasting.isFasting && fasting.startTime) {
        const diffMs = Math.max(0, Date.now() - fasting.startTime);
        const h = Math.floor(diffMs / 3600000);
        const m = Math.floor((diffMs % 3600000) / 60000);
        setFastElapsed({ hours: h, mins: m });
      }
    };
    updateElapsed();
    const interval = setInterval(updateElapsed, 10000);
    return () => clearInterval(interval);
  }, [fasting]);

  const toggleFasting = () => {
    if (fasting.isFasting) {
      // Stop Fast
      const updated = {
        ...fasting,
        isFasting: false,
        lastFastDuration: `${fastElapsed.hours}h ${fastElapsed.mins}m`,
        lastEnded: new Date().toLocaleDateString()
      };
      setFasting(updated);
      if (typeof localStorage !== "undefined") localStorage.setItem("stoke_fasting", JSON.stringify(updated));
      triggerToast(`Fast ended & logged (${fastElapsed.hours}h ${fastElapsed.mins}m)`);
    } else {
      // Start Fast
      const updated = {
        ...fasting,
        isFasting: true,
        startTime: Date.now()
      };
      setFasting(updated);
      setFastElapsed({ hours: 0, mins: 0 });
      if (typeof localStorage !== "undefined") localStorage.setItem("stoke_fasting", JSON.stringify(updated));
      triggerToast("New fast started! Timer is now active.");
    }
  };

  const setFastingGoal = (h) => {
    const updated = { ...fasting, goalHours: h };
    setFasting(updated);
    if (typeof localStorage !== "undefined") localStorage.setItem("stoke_fasting", JSON.stringify(updated));
    triggerToast(`Fasting protocol set to ${h}:${24 - h}`);
  };

  // 2. WEIGHT LOGGING SYSTEM (Persistent with BMI calculations)
  const [weightLogs, setWeightLogs] = useState(() => {
    if (typeof localStorage !== "undefined") {
      try {
        const saved = localStorage.getItem("stoke_weight_logs");
        if (saved) return JSON.parse(saved);
      } catch (e) {}
    }
    return [
      { id: 1, date: "Sep 1", weight: 71.5 },
      { id: 2, date: "Sep 8", weight: 71.0 },
      { id: 3, date: "Sep 15", weight: 70.6 },
      { id: 4, date: "Today", weight: Number(profile.weightKg) || 70.0 },
    ];
  });
  const [newWeightInput, setNewWeightInput] = useState(String(profile.weightKg || 70.0));

  const handleLogWeight = (val) => {
    const num = parseFloat(val);
    if (isNaN(num) || num < 30 || num > 250) {
      triggerToast("Please enter a valid weight between 30 and 250 kg");
      return;
    }
    const rounded = Number(num.toFixed(1));
    const nowStr = new Date().toLocaleDateString(undefined, { month: "short", day: "numeric" });
    const newEntry = { id: Date.now(), date: nowStr, weight: rounded };
    const updatedLogs = [...weightLogs, newEntry];
    setWeightLogs(updatedLogs);
    setNewWeightInput(String(rounded));
    setProfile(prev => ({ ...prev, weightKg: rounded }));
    if (typeof localStorage !== "undefined") {
      localStorage.setItem("stoke_weight_logs", JSON.stringify(updatedLogs));
    }
    // Sync weight to Supabase profile & daily progress
    if (currentUser?.id && typeof dbUpdateProfile === "function") {
      dbUpdateProfile(currentUser.id, { weight: rounded });
      const todayStr = typeof getLocalDateStr === "function" ? getLocalDateStr() : new Date().toISOString().split("T")[0];
      if (typeof dbUpsertDailyProgress === "function") {
        dbUpsertDailyProgress(currentUser.id, todayStr, { weight_kg: rounded });
      }
    }
    triggerToast(`Logged weight: ${rounded} kg (Updated telemetry)`);
  };

  const handleDeleteWeightLog = (id) => {
    const updated = weightLogs.filter(item => item.id !== id);
    setWeightLogs(updated);
    if (typeof localStorage !== "undefined") {
      localStorage.setItem("stoke_weight_logs", JSON.stringify(updated));
    }
    triggerToast("Weight entry removed");
  };

  // 3. SLEEP & RECOVERY (Persistent)
  const [sleepData, setSleepData] = useState(() => {
    if (typeof localStorage !== "undefined") {
      try {
        const saved = localStorage.getItem("stoke_sleep_data");
        if (saved) return JSON.parse(saved);
      } catch (e) {}
    }
    return {
      hours: 7.8,
      deepHours: 1.8,
      remHours: 2.1,
      lightHours: 3.9,
      recoveryScore: 88,
      targetHours: 8.0,
      qualityRating: 5
    };
  });

  const handleSaveSleep = (newHours, newQuality) => {
    const h = Number(newHours);
    const score = Math.min(100, Math.round((h / sleepData.targetHours) * 85 + (newQuality * 3)));
    const updated = {
      ...sleepData,
      hours: h,
      qualityRating: newQuality,
      recoveryScore: score,
      deepHours: Number((h * 0.23).toFixed(1)),
      remHours: Number((h * 0.27).toFixed(1)),
      lightHours: Number((h * 0.50).toFixed(1))
    };
    setSleepData(updated);
    if (typeof localStorage !== "undefined") {
      localStorage.setItem("stoke_sleep_data", JSON.stringify(updated));
    }
    triggerToast(`Sleep logged: ${h} hrs (Recovery Score: ${score}%)`);
    setActiveModal(null);
  };

  // 4. DAILY STEPS (Persistent)
  const [stepsData, setStepsData] = useState(() => {
    if (typeof localStorage !== "undefined") {
      try {
        const saved = localStorage.getItem("stoke_steps_data");
        if (saved) return JSON.parse(saved);
      } catch (e) {}
    }
    return {
      steps: 7420,
      goal: 10000
    };
  });

  const handleAddSteps = (count) => {
    const updated = {
      ...stepsData,
      steps: Math.max(0, stepsData.steps + count)
    };
    setStepsData(updated);
    if (typeof localStorage !== "undefined") {
      localStorage.setItem("stoke_steps_data", JSON.stringify(updated));
    }
    triggerToast(`Added ${count > 0 ? "+" + count : count} steps (Total: ${updated.steps.toLocaleString()})`);
  };

  const handleSetStepGoal = (g) => {
    const updated = { ...stepsData, goal: g };
    setStepsData(updated);
    if (typeof localStorage !== "undefined") {
      localStorage.setItem("stoke_steps_data", JSON.stringify(updated));
    }
    triggerToast(`Daily step goal set to ${g.toLocaleString()}`);
  };

  // 5. APPS & CONNECTED DEVICES (Persistent)
  const [devices, setDevices] = useState(() => {
    if (typeof localStorage !== "undefined") {
      try {
        const saved = localStorage.getItem("stoke_connected_devices");
        if (saved) return JSON.parse(saved);
      } catch (e) {}
    }
    return {
      appleHealth: true,
      googleFit: true,
      garmin: false,
      strava: true
    };
  });

  const toggleDevice = (key, name) => {
    const updated = { ...devices, [key]: !devices[key] };
    setDevices(updated);
    if (typeof localStorage !== "undefined") {
      localStorage.setItem("stoke_connected_devices", JSON.stringify(updated));
    }
    triggerToast(`${name}: ${updated[key] ? "Connected" : "Disconnected"}`);
  };

  // 6. REMINDERS & NOTIFICATION SCHEDULES (Persistent)
  const [reminders, setReminders] = useState(() => {
    if (typeof localStorage !== "undefined") {
      try {
        const saved = localStorage.getItem("stoke_reminders");
        if (saved) return JSON.parse(saved);
      } catch (e) {}
    }
    return {
      breakfast: { enabled: true, time: "8:30 AM" },
      lunch: { enabled: true, time: "1:00 PM" },
      dinner: { enabled: true, time: "7:30 PM" },
      water: { enabled: true, time: "Every 2 hrs" },
      workout: { enabled: true, time: "5:00 PM" }
    };
  });

  const toggleReminder = (key, label) => {
    const updated = {
      ...reminders,
      [key]: { ...reminders[key], enabled: !reminders[key].enabled }
    };
    setReminders(updated);
    if (typeof localStorage !== "undefined") {
      localStorage.setItem("stoke_reminders", JSON.stringify(updated));
    }
    triggerToast(`${label} reminder ${updated[key].enabled ? "enabled" : "muted"}`);
  };

  // 7. APP SETTINGS & PREFERENCES (Persistent)
  const [appSettings, setAppSettings] = useState(() => {
    if (typeof localStorage !== "undefined") {
      try {
        const saved = localStorage.getItem("stoke_settings");
        if (saved) return JSON.parse(saved);
      } catch (e) {}
    }
    return {
      units: "metric", // metric (kg/cm) vs imperial (lbs/in)
      soundHaptics: true,
      autoSync: true,
      theme: "Dark Obsidian Neumorphic"
    };
  });

  const updateSetting = (key, val, label) => {
    const updated = { ...appSettings, [key]: val };
    setAppSettings(updated);
    if (typeof localStorage !== "undefined") {
      localStorage.setItem("stoke_settings", JSON.stringify(updated));
    }
    triggerToast(`${label || key} updated`);
  };

  // 8. PRIVACY & SECURITY (Persistent)
  const [privacySettings, setPrivacySettings] = useState(() => {
    if (typeof localStorage !== "undefined") {
      try {
        const saved = localStorage.getItem("stoke_privacy");
        if (saved) return JSON.parse(saved);
      } catch (e) {}
    }
    return {
      biometricLock: false,
      diagnosticSharing: true,
      encryptedTelemetry: true
    };
  });

  const togglePrivacy = (key, label) => {
    const updated = { ...privacySettings, [key]: !privacySettings[key] };
    setPrivacySettings(updated);
    if (typeof localStorage !== "undefined") {
      localStorage.setItem("stoke_privacy", JSON.stringify(updated));
    }
    triggerToast(`${label}: ${updated[key] ? "Enabled" : "Disabled"}`);
  };

  // EXPORT TELEMETRY DATA AS JSON
  const handleExportData = () => {
    const exportBundle = {
      app: "STOKE Fitness & Athlete Telemetry",
      version: "26.37",
      timestamp: new Date().toISOString(),
      athlete: {
        name: profile.name || "Mohd Numan",
        email: userPhone || "mohdnuman701@gmail.com",
        weightKg: profile.weightKg || 70,
        heightCm: profile.heightCm || 167,
        age: profile.age || 21,
        sex: profile.sex || "male",
        strategy: profile.goalType || "maintain",
        isPro: !!profile.isPro
      },
      goals,
      weightHistory: weightLogs,
      fasting,
      sleep: sleepData,
      steps: stepsData,
      devices,
      reminders
    };
    const jsonStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(exportBundle, null, 2));
    const dlAnchor = document.createElement("a");
    dlAnchor.setAttribute("href", jsonStr);
    dlAnchor.setAttribute("download", `stoke_athlete_telemetry_${Date.now()}.json`);
    document.body.appendChild(dlAnchor);
    dlAnchor.click();
    dlAnchor.remove();
    triggerToast("Exported all biometric and health telemetry to JSON!");
  };

  // RESET APP DEMO DATA
  const handleResetData = () => {
    if (window.confirm("Reset STOKE app demo data to factory defaults? Your profile settings will be refreshed.")) {
      if (typeof localStorage !== "undefined") {
        localStorage.removeItem("stoke_weight_logs");
        localStorage.removeItem("stoke_fasting");
        localStorage.removeItem("stoke_sleep_data");
        localStorage.removeItem("stoke_steps_data");
        localStorage.removeItem("stoke_connected_devices");
        localStorage.removeItem("stoke_reminders");
        localStorage.removeItem("stoke_settings");
        localStorage.removeItem("stoke_privacy");
      }
      triggerToast("App settings restored to factory defaults.");
      setActiveModal(null);
      setTimeout(() => {
        window.location.reload();
      }, 700);
    }
  };

  // 9. EDIT BIOMETRICS FORM STATE
  const [editName, setEditName] = useState(profile.name || "Mohd Numan");
  const [editWeight, setEditWeight] = useState(String(profile.weightKg || 70));
  const [editHeight, setEditHeight] = useState(String(profile.heightCm || 167));
  const [editAge, setEditAge] = useState(String(profile.age || 21));
  const [editSex, setEditSex] = useState(profile.sex || "male");
  const [editActivity, setEditActivity] = useState(profile.activity || 1.725);
  const [editGoalType, setEditGoalType] = useState(profile.goalType || "maintain");

  // Synchronize edit fields when modal opens
  useEffect(() => {
    if (activeModal === "profile") {
      setEditName(profile.name || "Mohd Numan");
      setEditWeight(String(profile.weightKg || 70));
      setEditHeight(String(profile.heightCm || 167));
      setEditAge(String(profile.age || 21));
      setEditSex(profile.sex || "male");
      setEditActivity(profile.activity || 1.725);
      setEditGoalType(profile.goalType || "maintain");
    }
  }, [activeModal, profile]);

  const handleSaveProfile = () => {
    const w = parseFloat(editWeight) || profile.weightKg || 70;
    const h = parseFloat(editHeight) || profile.heightCm || 167;
    const a = parseInt(editAge) || profile.age || 21;
    const updated = {
      ...profile,
      name: editName.trim() || profile.name || "Mohd Numan",
      weightKg: w,
      heightCm: h,
      age: a,
      sex: editSex,
      activity: typeof editActivity === "number" ? editActivity : parseFloat(editActivity),
      goalType: editGoalType,
    };
    setProfile(updated);
    setActiveModal(null);
    triggerToast("Profile & daily targets successfully updated!");
  };

  // 10. TARGET GOALS & MACRO CONFIGURATOR
  const [goalCalInput, setGoalCalInput] = useState(String(goals.calories || 2450));
  const [goalWaterInput, setGoalWaterInput] = useState(String(goals.water || 2.6));
  const [goalStrategy, setGoalStrategy] = useState(profile.goalType || "maintain");
  const [macroPreset, setMacroPreset] = useState("balanced");

  useEffect(() => {
    if (activeModal === "goals") {
      setGoalCalInput(String(goals.calories || 2450));
      setGoalWaterInput(String(goals.water || 2.6));
      setGoalStrategy(profile.goalType || "maintain");
    }
  }, [activeModal, goals, profile]);

  const handleSaveGoals = () => {
    const cal = parseInt(goalCalInput) || goals.calories;
    const waterVal = parseFloat(goalWaterInput) || goals.water || 2.6;
    let customProtein = Math.round(profile.weightKg * 2.0);
    let customCarbs = Math.round((cal * 0.45) / 4);
    let customFat = Math.round((cal * 0.25) / 9);

    if (macroPreset === "high_protein") {
      customProtein = Math.round((cal * 0.35) / 4);
      customCarbs = Math.round((cal * 0.40) / 4);
      customFat = Math.round((cal * 0.25) / 9);
    } else if (macroPreset === "low_carb") {
      customProtein = Math.round((cal * 0.35) / 4);
      customCarbs = Math.round((cal * 0.20) / 4);
      customFat = Math.round((cal * 0.45) / 9);
    } else if (macroPreset === "keto") {
      customProtein = Math.round((cal * 0.25) / 4);
      customCarbs = Math.round((cal * 0.05) / 4);
      customFat = Math.round((cal * 0.70) / 9);
    }

    const updated = {
      ...profile,
      goalType: goalStrategy,
      customCalories: cal,
      customWater: waterVal,
      customProtein,
      customCarbs,
      customFat
    };
    setProfile(updated);
    setActiveModal(null);
    triggerToast(`Daily targets saved: ${cal} kcal · ${waterVal}L water`);
  };

  // Quick Strategy Change
  const setStrategy = (type) => {
    setProfile(prev => ({ ...prev, goalType: type }));
    setEditGoalType(type);
    triggerToast(`Target strategy changed to ${type.toUpperCase()}`);
  };

  // Trigger sync with animated rotation
  const handleSync = () => {
    setIsSyncing(true);
    setTimeout(() => {
      setIsSyncing(false);
      const now = new Date();
      setSyncTime(now.toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" }));
      triggerToast("Telemetry & Apple Health sensors synced");
    }, 850);
  };

  // Colors & Theme constants
  const LIME = "#256BFD";
  const CYAN = "#2ED4BF";
  const AMBER = "#FF8A3D";

  const username = profile.name || userPhone || "Mohd Numan";
  const avatarLetter = (username || "M").trim().charAt(0).toUpperCase();

  // Live BMI & Telemetry Calculations
  const curWeight = profile.weightKg || 70;
  const curHeight = profile.heightCm || 167;
  const heightM = curHeight / 100;
  const bmi = (curWeight / (heightM * heightM)).toFixed(1);
  const bmiStatus = bmi < 18.5 ? "Underweight" : bmi < 25 ? "Optimal" : bmi < 30 ? "Overweight" : "Obese";

  // Macro distribution
  const proteinG = goals.protein || Math.round(curWeight * 2.2);
  const carbsG = goals.carbs || Math.round((goals.calories * 0.45) / 4);
  const fatG = goals.fat || Math.round((goals.calories * 0.25) / 9);
  const totalMacroCal = (proteinG * 4) + (carbsG * 4) + (fatG * 9);
  const pPct = Math.round(((proteinG * 4) / totalMacroCal) * 100);
  const cPct = Math.round(((carbsG * 4) / totalMacroCal) * 100);
  const fPct = Math.max(0, 100 - pPct - cPct);

  return (
    <div style={{ color: "#FFFFFF", paddingBottom: 36, fontFamily: "'Space Grotesk', ui-sans-serif, system-ui, sans-serif" }}>

      {/* Screen Header with Safe Area Back Button */}
      <ScreenHeader
        title="More & Profile"
        subtitle="Athlete Telemetry"
        onBack={onBack}
        canGoBack={true}
        rightAction={
          <div style={{ display: "flex", alignItems: "center", gap: 10 }}>
            <span style={{ fontSize: 10, color: LIME, fontWeight: 800, letterSpacing: 1 }}>SYSTEM ONLINE</span>
            <button
              onClick={onSignOut}
              className="s3-ghost-btn"
              style={{ width: "auto", padding: "4px 10px", fontSize: 11, borderRadius: 8, height: 26, borderColor: "rgba(239,68,68,0.3)", color: "#EF4444", cursor: "pointer" }}
              title="Log out of STOKE session"
            >
              Sign Out
            </button>
          </div>
        }
      />

      {/* -- LUXURY ATHLETE HERO CARD (Soft UI + Neumorphism + Swiss) -- */}
      <div className="prof-hero-card" style={{ marginBottom: 16, position: "relative" }}>
        <div style={{ position: "absolute", top: -40, right: -40, width: 140, height: 140, borderRadius: "50%", background: "radial-gradient(circle, rgba(37, 107, 253,0.15) 0%, transparent 70%)", pointerEvents: "none" }} />

        <div style={{ display: "flex", alignItems: "center", gap: 16, position: "relative", zIndex: 1 }}>
          {/* Avatar ring */}
          <div
            className="prof-avatar-ring"
            onClick={() => setActiveModal("premium")}
            style={{ cursor: "pointer" }}
            title="View PRO Membership status"
          >
            <div className="prof-avatar-inner">
              {avatarLetter}
            </div>
            <div className="prof-badge-pro" style={{ background: profile.isPro ? "linear-gradient(135deg, #FBBF24 0%, #D97706 100%)" : undefined, color: profile.isPro ? "#000" : undefined }}>
              {profile.isPro ? "ELITE" : "PRO"}
            </div>
          </div>

          <div style={{ flex: 1, minWidth: 0 }}>
            <div style={{ display: "flex", alignItems: "center", gap: 6 }}>
              <h2 style={{ margin: 0, fontSize: 20, fontWeight: 900, color: "#FFFFFF", letterSpacing: -0.5, overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" }}>
                {username}
              </h2>
              <span style={{ color: LIME, fontSize: 14 }} title="Verified STOKE Athlete">✓</span>
            </div>
            <div style={{ fontSize: 12, color: "rgba(255,255,255,0.45)", marginTop: 2, letterSpacing: 0.2 }}>
              {profile.isPro ? "STOKE Pro Elite Athlete · Level 12" : "STOKE Member · Level 12 Athlete"}
            </div>
            <div style={{ display: "flex", gap: 8, marginTop: 8, flexWrap: "wrap" }}>
              <button
                onClick={() => setActiveModal("profile")}
                className="mat-ripple"
                style={{
                  background: "rgba(37, 107, 253,0.1)",
                  border: "1px solid rgba(37, 107, 253,0.3)",
                  borderRadius: 10,
                  padding: "5px 12px",
                  color: LIME,
                  fontSize: 11,
                  fontWeight: 800,
                  cursor: "pointer",
                  letterSpacing: 0.5,
                  display: "inline-flex",
                  alignItems: "center",
                  gap: 5,
                  boxShadow: "0 2px 8px rgba(0,0,0,0.4)"
                }}
              >
                <span>✏️</span> Edit Biometrics
              </button>

              <button
                onClick={() => setActiveModal("profile_login")}
                className="mat-ripple"
                style={{
                  background: "rgba(37, 107, 253,0.18)",
                  border: "1px solid " + LIME,
                  borderRadius: 10,
                  padding: "5px 12px",
                  color: LIME,
                  fontSize: 11,
                  fontWeight: 900,
                  cursor: "pointer",
                  letterSpacing: 0.5,
                  display: "inline-flex",
                  alignItems: "center",
                  gap: 5,
                  boxShadow: "0 0 12px rgba(37, 107, 253,0.2)"
                }}
              >
                <span>🔐</span> Switch Account
              </button>

              <button
                onClick={handleSync}
                className="mat-ripple"
                style={{
                  background: "rgba(255,255,255,0.05)",
                  border: "1px solid rgba(255,255,255,0.1)",
                  borderRadius: 10,
                  padding: "5px 10px",
                  color: "rgba(255,255,255,0.8)",
                  fontSize: 11,
                  fontWeight: 700,
                  cursor: "pointer",
                  display: "inline-flex",
                  alignItems: "center",
                  gap: 5
                }}
              >
                <span style={{ display: "inline-block", transform: isSyncing ? "rotate(360deg)" : "none", transition: isSyncing ? "transform 0.8s ease" : "none" }}>🔄</span>
                <span>{isSyncing ? "Syncing…" : "Sync"}</span>
              </button>

              <button
                onClick={() => onOpenSupabaseModal && onOpenSupabaseModal()}
                className="mat-ripple"
                style={{
                  background: "rgba(16,185,129,0.15)",
                  border: "1px solid rgba(16,185,129,0.4)",
                  borderRadius: 10,
                  padding: "5px 11px",
                  color: "#10B981",
                  fontSize: 11,
                  fontWeight: 800,
                  cursor: "pointer",
                  display: "inline-flex",
                  alignItems: "center",
                  gap: 5,
                  boxShadow: "0 0 10px rgba(16,185,129,0.2)"
                }}
                title="Configure Supabase Cloud Database"
              >
                <span>⚡</span>
                <span>Supabase Cloud</span>
              </button>
            </div>
          </div>
        </div>

        {/* -- SWISS TELEMETRY 4-CELL GRID (All Clickable to Respective Tools) -- */}
        <div className="prof-telemetry-grid">
          <div className="prof-telemetry-cell" onClick={() => setActiveModal("weight")} style={{ cursor: "pointer" }} title="Log or view weight history">
            <div className="prof-telemetry-val" style={{ color: "#FFFFFF" }}>{curWeight} <span style={{ fontSize: 10, color: LIME }}>KG</span></div>
            <div className="prof-telemetry-lbl">Weight ›</div>
          </div>
          <div className="prof-telemetry-cell" onClick={() => setActiveModal("steps")} style={{ cursor: "pointer" }} title="View daily steps & activity">
            <div className="prof-telemetry-val" style={{ color: AMBER }}>{stepsData.steps.toLocaleString()} <span style={{ fontSize: 10 }}>👟</span></div>
            <div className="prof-telemetry-lbl">Today Steps ›</div>
          </div>
          <div className="prof-telemetry-cell" onClick={() => setActiveModal("goals")} style={{ cursor: "pointer" }} title="Configure target calorie and macro split">
            <div className="prof-telemetry-val" style={{ color: LIME }}>{goals.calories}</div>
            <div className="prof-telemetry-lbl">Target kcal ›</div>
          </div>
          <div className="prof-telemetry-cell" onClick={() => onNavigate && onNavigate("nutrition")} style={{ cursor: "pointer" }} title="Track daily water and meals in Nutrition">
            <div className="prof-telemetry-val" style={{ color: CYAN }}>{goals.water || 2.6} <span style={{ fontSize: 10 }}>L</span></div>
            <div className="prof-telemetry-lbl">Hydration ›</div>
          </div>
        </div>

        {/* -- NEUMORPHIC STRATEGY CONTROL -- */}
        <div style={{ marginTop: 14 }}>
          <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 6 }}>
            <span style={{ fontSize: 10, fontWeight: 900, color: "rgba(255,255,255,0.4)", letterSpacing: 1.5, textTransform: "uppercase" }}>Active Strategy</span>
            <span style={{ fontSize: 11, color: LIME, fontWeight: 800 }}>
              {profile.goalType === "cut" ? "Deficit (-400 kcal)" : profile.goalType === "gain" ? "Surplus (+400 kcal)" : "Maintenance (Energy balance)"}
            </span>
          </div>
          <div className="prof-strategy-track">
            {[
              { id: "cut", label: "Cut · Fat Loss" },
              { id: "maintain", label: "Maintain" },
              { id: "gain", label: "Bulk · Muscle" },
            ].map(s => {
              const active = profile.goalType === s.id;
              return (
                <button
                  key={s.id}
                  onClick={() => setStrategy(s.id)}
                  className={`prof-strategy-btn${active ? " active" : ""}`}
                >
                  {s.label}
                </button>
              );
            })}
          </div>
        </div>

        {/* -- SWISS MACRO RATIO BAR -- */}
        <div onClick={() => setActiveModal("goals")} style={{ cursor: "pointer" }} title="Click to edit Macro split & targets">
          <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", fontSize: 11, fontWeight: 700 }}>
            <span style={{ color: LIME }}>P: {proteinG}g ({pPct}%)</span>
            <span style={{ color: CYAN }}>C: {carbsG}g ({cPct}%)</span>
            <span style={{ color: AMBER }}>F: {fatG}g ({fPct}%)</span>
          </div>
          <div className="prof-ratio-bar">
            <div style={{ width: `${pPct}%`, background: LIME, transition: "width 0.4s ease" }} />
            <div style={{ width: `${cPct}%`, background: CYAN, transition: "width 0.4s ease" }} />
