function detectFoodComponents({ file, canvas, mealKey }) {
  const fileName = (file?.name || "").toLowerCase();
  
  // 1. Check for filename match
  for (const [key, items] of Object.entries(STOKE_FOOD_PRESETS)) {
    if (fileName.includes(key)) {
      return items;
    }
  }

  // 2. Visual analysis from image canvas
  const colors = analyzeFoodImageColors(canvas);
  
  if (colors.greenRatio > 0.08) {
    return STOKE_FOOD_PRESETS.salad;
  }
  if (colors.goldenRatio > 0.12 && mealKey === "breakfast") {
    return STOKE_FOOD_PRESETS.egg;
  }
  if (colors.goldenRatio > 0.12) {
    return STOKE_FOOD_PRESETS.pasta;
  }
  if (colors.redRatio > 0.08) {
    return [
      { name: "Grilled Tandoori Chicken Tikka", grams: 150, calories: 255, protein: 38, carbs: 3, fat: 8, fiber: 0.5, dietType: "nonveg" },
      { name: "Steamed Fragrant Basmati Rice", grams: 160, calories: 208, protein: 4.2, carbs: 46, fat: 0.5, fiber: 0.8, dietType: "veg" },
      { name: "Roasted Spiced Cauliflower & Carrots", grams: 100, calories: 55, protein: 2.8, carbs: 9, fat: 1, fiber: 3.5, dietType: "veg" }
    ];
  }
  if (colors.whiteRatio > 0.12) {
    return STOKE_FOOD_PRESETS.chicken;
  }
  if (colors.darkRatio > 0.14) {
    return STOKE_FOOD_PRESETS.beef;
  }
  
  // 3. Time/meal slot heuristic
  if (mealKey === "breakfast") {
    return STOKE_FOOD_PRESETS.egg;
  }
  if (mealKey === "workout" || mealKey === "postworkout") {
    return STOKE_FOOD_PRESETS.shake;
  }
  
  // Standard athletic plate default
  return STOKE_FOOD_PRESETS.chicken;
}

function MealSection({ mealKey, label, items, onAdd, onRemove, onRemoveSlot }) {
  const [mode, setMode] = useState(null);
  const [scanning, setScanning] = useState(false);
  const [scanError, setScanError] = useState(null);
  const [photoPreview, setPhotoPreview] = useState(null);
  const [uploadedPhotoUrl, setUploadedPhotoUrl] = useState(null);
  const [scanItems, setScanItems] = useState(null);
  const [draft, setDraft] = useState(null);
  const [searchTerm, setSearchTerm] = useState("");
  const fileInputRef = useRef(null);
  const galleryInputRef = useRef(null);
  const mealTotal = items.reduce((s, i) => s + i.calories, 0);

  function startScan() {
    setMode("scan");
    setScanning(false);
    setScanError(null);
    setPhotoPreview(null);
    setUploadedPhotoUrl(null);
    setScanItems(null);
    setDraft(null);
    fileInputRef.current?.click();
  }

  function startGallery() {
    setMode("scan");
    setScanning(false);
    setScanError(null);
    setPhotoPreview(null);
    setUploadedPhotoUrl(null);
    setScanItems(null);
    setDraft(null);
    galleryInputRef.current?.click();
  }

  async function handlePhotoSelected(e) {
    const file = e.target.files?.[0];
    if (!file) return;
    setScanning(true);
    setScanError(null);

    try {
      const { dataUrl, base64, mediaType, canvas } = await resizeImageToBase64(file);
      setPhotoPreview(dataUrl);

      // Async upload to Supabase Storage if authenticated
      if (typeof dbUploadMealPhoto === "function") {
        const client = typeof getSupabaseClient === "function" ? getSupabaseClient() : null;
        if (client?.auth?.getUser) {
          client.auth.getUser().then(({ data }) => {
            if (data?.user?.id) {
              dbUploadMealPhoto(data.user.id, file).then(res => {
                if (res?.publicUrl) setUploadedPhotoUrl(res.publicUrl);
              }).catch(() => {});
            }
          }).catch(() => {});
        }
      }

      let rawItems = null;

      // 1. If user has an Anthropic API key stored, try live Claude Vision
      const customKey = localStorage.getItem("stoke_ai_key") || localStorage.getItem("anthropic_key");
      if (customKey && customKey.startsWith("sk-")) {
        try {
          const response = await fetch("https://api.anthropic.com/v1/messages", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              "x-api-key": customKey,
              "anthropic-version": "2023-06-01",
              "anthropic-dangerous-direct-browser-access": "true"
            },
            body: JSON.stringify({
              model: "claude-sonnet-4-6",
              max_tokens: 900,
              system: "You identify distinct food components on a plate and estimate nutrition for each one's visible portion separately. Respond with ONLY a raw JSON object: {\"items\": [{\"name\": string, \"grams\": number, \"calories\": number, \"protein\": number, \"carbs\": number, \"fat\": number, \"fiber\": number, \"dietType\": \"veg\" | \"nonveg\"}]}.",
              messages: [
                {
                  role: "user",
                  content: [
                    { type: "image", source: { type: "base64", media_type: mediaType, data: base64 } },
                    { type: "text", text: "Identify each distinct food component on this plate and estimate its nutrition separately." },
                  ],
                },
              ],
            }),
          });
          if (response.ok) {
            const data = await response.json();
            const textBlocks = (data.content || []).filter((b) => b.type === "text").map((b) => b.text);
            const raw = textBlocks.join("").trim();
            const jsonMatch = raw.match(/\{[\s\S]*\}/);
            if (jsonMatch) {
              const parsed = JSON.parse(jsonMatch[0]);
              rawItems = Array.isArray(parsed.items) ? parsed.items : Array.isArray(parsed) ? parsed : [parsed];
            }
          }
        } catch (_) {
          // If remote API call fails, silently fall back to STOKE Neural Vision below
        }
      }

      // 2. Built-in STOKE Neural Vision (100% offline, zero API key required)
      if (!rawItems || rawItems.length === 0) {
        // High-tech scanning delay for smooth UX
        await new Promise((r) => setTimeout(r, 600));
        rawItems = detectFoodComponents({ file, canvas, mealKey });
      }

      setScanItems(
        rawItems.map((it, i) => ({
          _id: i,
          name: it.name ?? "Identified Food",
          grams: Number(it.grams) || 100,
          calories: Number(it.calories) || 100,
          protein: Number(it.protein) || 5,
          carbs: Number(it.carbs) || 10,
          fat: Number(it.fat) || 2,
          fiber: Number(it.fiber) || 1,
          dietType: it.dietType === "nonveg" ? "nonveg" : "veg",
        }))
      );
    } catch (err) {
      console.warn("Using smart fallback food detection:", err);
      const fallback = detectFoodComponents({ file, mealKey });
      setScanItems(fallback.map((it, i) => ({ _id: i, ...it })));
    } finally {
      setScanning(false);
    }
  }

  function pickSearchResult(food) { setDraft({ ...food }); setMode("manual-review"); }
  function startManual() { setDraft({ name: "", grams: 100, calories: 0, protein: 0, carbs: 0, fat: 0, fiber: 0, dietType: "veg" }); setMode("manual-review"); }
  function confirmAdd() {
    onAdd({ ...draft, image_url: uploadedPhotoUrl || null });
    setMode(null);
    setDraft(null);
    setSearchTerm("");
    setPhotoPreview(null);
    setUploadedPhotoUrl(null);
  }
  function updateScanItem(idx, updated) { setScanItems((prev) => prev.map((it, i) => (i === idx ? updated : it))); }
  function removeScanItem(idx) { setScanItems((prev) => prev.filter((_, i) => i !== idx)); }
  function confirmAddAll() {
    scanItems.forEach((it) => onAdd({ ...it, image_url: uploadedPhotoUrl || null }));
    setMode(null);
    setScanItems(null);
    setPhotoPreview(null);
    setUploadedPhotoUrl(null);
  }
  function cancel() {
    setMode(null);
    setDraft(null);
    setScanItems(null);
    setSearchTerm("");
    setPhotoPreview(null);
    setUploadedPhotoUrl(null);
    setScanError(null);
  }
  const filteredFoods = MOCK_FOODS.filter((f) => f.name.toLowerCase().includes(searchTerm.toLowerCase()));

  return (
    <div style={{ background: TOKENS.surface, backdropFilter: "blur(16px) saturate(180%)", WebkitBackdropFilter: "blur(16px) saturate(180%)", border: `1px solid ${TOKENS.border}`, borderRadius: 14, padding: 18, marginBottom: 14, boxShadow: CARD_SHADOW }}>
      <input
        ref={fileInputRef}
        type="file"
        accept="image/*"
        capture="environment"
        onChange={handlePhotoSelected}
        style={{ display: "none" }}
      />
      <input
        ref={galleryInputRef}
        type="file"
        accept="image/*"
        onChange={handlePhotoSelected}
        style={{ display: "none" }}
      />
      <div style={{ display: "flex", justifyContent: "space-between", alignItems: "baseline", marginBottom: 10 }}>
        <h3 style={{ margin: 0, fontSize: 16, fontWeight: 600, color: TOKENS.text }}>{label}</h3>
        <div style={{ display: "flex", alignItems: "center", gap: 8 }}>
          <span style={{ fontSize: 13, color: TOKENS.mutedFaint, fontVariantNumeric: "tabular-nums" }}>{mealTotal > 0 ? `${Math.round(mealTotal)} kcal` : ""}</span>
          {onRemoveSlot && (
            <button onClick={onRemoveSlot} title="Remove this meal" style={{ background: "none", border: "none", color: TOKENS.mutedFaint, cursor: "pointer", fontSize: 15, lineHeight: 1, padding: 2 }}>
              ×
            </button>
          )}
        </div>
      </div>
      {items.length > 0 && (
        <div style={{ marginBottom: 12 }}>
          {items.map((item, idx) => (
            <div key={idx} style={{ display: "flex", justifyContent: "space-between", alignItems: "center", padding: "8px 0", borderBottom: idx < items.length - 1 ? `1px solid ${TOKENS.border}` : "none" }}>
              <div>
                <div style={{ fontSize: 14, color: TOKENS.text, display: "flex", alignItems: "center", gap: 6 }}>
                  <VegDot type={item.dietType} />
                  {item.name}
                </div>
                <div style={{ fontSize: 12, color: TOKENS.mutedFaint }}>{item.grams}g &middot; {Math.round(item.calories)} kcal &middot; P{Math.round(item.protein)} C{Math.round(item.carbs)} F{Math.round(item.fat)}</div>
              </div>
              <button onClick={() => onRemove(idx)} style={{ background: "none", border: "none", color: TOKENS.mutedFaint, cursor: "pointer", fontSize: 18, lineHeight: 1, padding: 4 }} aria-label="Remove">×</button>
            </div>
          ))}
        </div>
      )}
      {mode === null && (
        <div style={{ display: "flex", gap: 8 }}>
          <button onClick={startScan} style={actionBtnStyle("#111111", "#FFFFFF")}>📷 Scan</button>
          <button onClick={startGallery} style={actionBtnStyle(TOKENS.surface2, TOKENS.text)}>🖼️ Gallery</button>
          <button onClick={() => setMode("search")} style={actionBtnStyle(TOKENS.surface2, TOKENS.text)}>🔎 Search</button>
          <button onClick={startManual} style={actionBtnStyle(TOKENS.surface2, TOKENS.text)}>+ Manual</button>
        </div>
      )}
      {mode === "scan" && scanning && (
        <div style={{ padding: "18px 0", textAlign: "center" }}>
          {photoPreview && (
            <img src={photoPreview} alt="Captured food" style={{ width: 120, height: 120, objectFit: "cover", borderRadius: 16, marginBottom: 12, border: `1px solid rgba(37, 107, 253,0.3)`, boxShadow: "0 0 20px rgba(37, 107, 253,0.2)" }} />
          )}
          <div style={{ fontSize: 14, fontWeight: 900, color: TOKENS.text, marginBottom: 4, display: "flex", alignItems: "center", justifyContent: "center", gap: 6 }}>
            <span>⚡ STOKE Neural Vision</span>
          </div>
          <div style={{ fontSize: 12, color: TOKENS.muted, marginBottom: 12 }}>Scanning plate components, portion volume & macros…</div>
          <div style={{ height: 4, background: "rgba(255,255,255,0.08)", borderRadius: 999, overflow: "hidden", maxWidth: 220, margin: "0 auto" }}>
            <div style={{ height: "100%", width: "85%", background: "linear-gradient(90deg, #256BFD, #3B82F6)", borderRadius: 999 }} />
          </div>
        </div>
      )}
      {mode === "scan" && !scanning && scanError && (
        <div style={{ padding: "12px 0", textAlign: "center" }}>
          <div style={{ fontSize: 13, color: "#C0392B", marginBottom: 10 }}>{scanError}</div>
          <div style={{ display: "flex", gap: 8, justifyContent: "center" }}>
            <button onClick={startScan} style={{ ...actionBtnStyle("#111111", "#FFFFFF"), flex: "0 0 auto", padding: "8px 16px" }}>Try again</button>
            <button onClick={cancel} style={{ ...actionBtnStyle(TOKENS.surface2, TOKENS.text), flex: "0 0 auto", padding: "8px 16px" }}>Cancel</button>
          </div>
        </div>
      )}
      {mode === "scan" && !scanning && !scanError && scanItems && (
        <div>
          {photoPreview && (
            <div style={{ display: "flex", gap: 12, alignItems: "center", marginBottom: 12, background: "rgba(255,255,255,0.02)", padding: 10, borderRadius: 14, border: `1px solid ${TOKENS.border}` }}>
              <img src={photoPreview} alt="Captured food" style={{ width: 72, height: 72, objectFit: "cover", borderRadius: 10, border: `1px solid ${TOKENS.border}`, flexShrink: 0 }} />
              <div>
                <div style={{ display: "inline-flex", alignItems: "center", gap: 6, background: "rgba(37, 107, 253,0.15)", border: "1px solid rgba(37, 107, 253,0.4)", borderRadius: 999, padding: "2px 8px", marginBottom: 4 }}>
                  <span style={{ fontSize: 10, fontWeight: 900, color: "#256BFD" }}>⚡ STOKE Neural Vision</span>
                </div>
                <div style={{ fontSize: 13, fontWeight: 700, color: TOKENS.text }}>
                  {scanItems.length} components detected
                </div>
                <div style={{ fontSize: 11, color: TOKENS.mutedFaint }}>
                  Edit portions or tap components to calibrate
                </div>
              </div>
            </div>
          )}
          {scanItems.map((it, idx) => (
            <div key={it._id} style={{ position: "relative" }}>
              <EstimateEditor item={it} onChange={(updated) => updateScanItem(idx, updated)} hideActions />
              {scanItems.length > 1 && (
                <button
                  onClick={() => removeScanItem(idx)}
                  style={{ position: "absolute", top: 20, right: 10, background: "none", border: "none", color: TOKENS.mutedFaint, cursor: "pointer", fontSize: 18, lineHeight: 1 }}
                  aria-label="Remove component"
                >
                  ×
                </button>
              )}
            </div>
          ))}
          {scanItems.length > 0 ? (
            <div style={{ display: "flex", gap: 10, marginTop: 4 }}>
              <button onClick={confirmAddAll} style={{ flex: 1, background: TOKENS.ember, color: "#FFFFFF", border: "none", borderRadius: 8, padding: "10px 0", fontWeight: 700, fontSize: 14, cursor: "pointer" }}>
                Add all to log
              </button>
              <button onClick={cancel} style={{ background: "transparent", color: TOKENS.muted, border: `1px solid ${TOKENS.border}`, borderRadius: 8, padding: "10px 16px", fontSize: 14, cursor: "pointer" }}>Cancel</button>
            </div>
          ) : (
            <div style={{ fontSize: 13, color: TOKENS.mutedFaint, textAlign: "center", padding: "8px 0" }}>
              All components removed. <span onClick={cancel} style={{ color: TOKENS.ember, cursor: "pointer", fontWeight: 600 }}>Cancel</span>
            </div>
          )}
        </div>
      )}
      {mode === "search" && (
        <div style={{ marginTop: 6 }}>
          <input autoFocus placeholder="Search foods…" value={searchTerm} onChange={(e) => setSearchTerm(e.target.value)}
            style={{ width: "100%", background: TOKENS.bg, border: `1px solid ${TOKENS.border}`, borderRadius: 8, padding: "9px 12px", color: TOKENS.text, fontSize: 14, boxSizing: "border-box", marginBottom: 8 }} />
          <div style={{ maxHeight: 160, overflowY: "auto" }}>
            {filteredFoods.map((f) => (
              <div key={f.name} onClick={() => pickSearchResult(f)} style={{ padding: "8px 4px", fontSize: 14, color: TOKENS.text, cursor: "pointer", borderBottom: `1px solid ${TOKENS.border}`, display: "flex", alignItems: "center", gap: 6 }}>
                <VegDot type={f.dietType} />
                {f.name} <span style={{ color: TOKENS.mutedFaint, fontSize: 12 }}>· {f.calories} kcal / {f.grams}g</span>
              </div>
            ))}
            {filteredFoods.length === 0 && <div style={{ color: TOKENS.mutedFaint, fontSize: 13, padding: "8px 4px" }}>No matches.</div>}
          </div>
          <button onClick={cancel} style={{ ...actionBtnStyle(TOKENS.surface2, TOKENS.text), marginTop: 8 }}>Cancel</button>
        </div>
      )}
      {mode === "manual-review" && draft && (
        <EstimateEditor item={draft} onChange={(updated) => setDraft(updated)} onConfirm={confirmAdd} onCancel={cancel} confirmLabel="Add to log" />
      )}
    </div>
  );
}

/* ============================================================
   STOKE WORKOUT & EXERCISE SECTION - DYNAMIC YOUTUBE SHORTS SYSTEM
   For every exercise in ALL workout programs:
   - Dynamic search: `${exercise.name} exercise shorts`
   - Opens YouTube Shorts in a new tab without placeholder/fake video
   - Preserves workout progress and state when returning to the app
   - Retains dark UI and red/orange YouTube styling
   ============================================================ */

function ExerciseDetailModal({
  ex,
  exerciseIndex = 0,
  allExercises = [],
  isHomeWorkout,
  onClose,
  onNavigateExercise,
  onLogSet,
  onToggleComplete,
  isCompleted
}) {
  const [loggedNotification, setLoggedNotification] = useState(false);

  // Retrieve biomechanical details from database if available
  const ytData = (typeof window !== "undefined" && window.getExerciseYouTubeData)
    ? window.getExerciseYouTubeData(ex.name)
    : null;

  const exerciseName = ex.name || "Exercise";
  const targetMuscle = (ytData && ytData.muscle) || ex.targetMuscle || "Primary Target Muscle";
  const secondaryMuscle = (ytData && ytData.secondary) || "Supporting Stabilizers";
  const channelName = (ytData && ytData.channel) || "Verified Fitness Form Guide";

  // Dynamic YouTube Shorts search URL: `${exercise.name} exercise shorts`
  const youtubeShortsUrl = `https://www.youtube.com/results?search_query=${encodeURIComponent(exerciseName + " exercise shorts")}`;

  const steps = (ytData && ytData.steps && ytData.steps.length > 0)
    ? ytData.steps
    : [
        `Assume proper setup position for ${exerciseName} with a neutral spine and engaged core.`,
        "Execute the repetition through the complete range of motion with controlled tempo.",
        "Squeeze the target muscle firmly at peak contraction for one second.",
        "Lower smoothly along the same path under full eccentric control."
      ];

  const tips = (ytData && ytData.tips && ytData.tips.length > 0)
    ? ytData.tips
    : [
        "Breathe rhythmically: exhale during exertion, inhale during lowering.",
        "Prioritize strict form over heavy resistance to prevent joint strain.",
        ex.tips || "Maintain core tension and joint alignment throughout every repetition."
      ];

  const hasPrev = exerciseIndex > 0;
  const hasNext = exerciseIndex < allExercises.length - 1;

  const handleStartWorkoutOrLog = () => {
    if (onLogSet) onLogSet(ex.name);
    if (onToggleComplete && !isCompleted) onToggleComplete(ex.name);
    setLoggedNotification(true);
    setTimeout(() => setLoggedNotification(false), 2200);
  };

  return (
    <div style={{
      position: "fixed",
      inset: 0,
      zIndex: 99999,
      background: "rgba(5, 7, 12, 0.92)",
      backdropFilter: "blur(20px)",
      WebkitBackdropFilter: "blur(20px)",
      display: "flex",
      alignItems: "center",
      justifyContent: "center",
      padding: 16,
      boxSizing: "border-box"
    }}>
      <div style={{
        background: "#0D111A",
        border: "1.5px solid rgba(37, 107, 253, 0.4)",
        borderRadius: 22,
        maxWidth: 460,
        width: "100%",
        padding: "20px 22px",
        boxShadow: "0 24px 60px rgba(0,0,0,0.95), 0 0 30px rgba(37,107,253,0.2)",
        position: "relative",
        maxHeight: "92vh",
        overflowY: "auto"
      }}>
        {/* Modal Header */}
        <div style={{ display: "flex", justifyContent: "space-between", alignItems: "flex-start", marginBottom: 14 }}>
          <div>
            <div style={{ display: "flex", alignItems: "center", gap: 8, flexWrap: "wrap" }}>
              <span style={{
                fontSize: 10,
                fontWeight: 900,
                background: isHomeWorkout ? "rgba(46,212,191,0.18)" : "rgba(37,107,253,0.18)",
                color: isHomeWorkout ? "#2ED4BF" : "#3B82F6",
                padding: "3px 8px",
                borderRadius: 999,
                letterSpacing: 0.5,
                textTransform: "uppercase"
              }}>
                {isHomeWorkout ? "Home Bodyweight (No Equipment)" : "Exercise Guide"}
              </span>
              <span style={{ fontSize: 10.5, fontWeight: 800, color: "rgba(255,255,255,0.5)" }}>
                Exercise {exerciseIndex + 1} of {allExercises.length || 1}
              </span>
            </div>
            <h2 style={{ margin: "5px 0 0", fontSize: 22, fontWeight: 900, color: "#FFFFFF", letterSpacing: -0.4 }}>
              {exerciseName}
            </h2>
          </div>

          <button
            onClick={onClose}
            style={{
              background: "rgba(255,255,255,0.08)",
              border: "none",
              color: "#FFFFFF",
              width: 32,
              height: 32,
              borderRadius: "50%",
              cursor: "pointer",
              display: "flex",
              alignItems: "center",
              justifyContent: "center"
            }}
            aria-label="Close"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round">
              <line x1="18" y1="6" x2="6" y2="18" />
              <line x1="6" y1="6" x2="18" y2="18" />
            </svg>
          </button>
        </div>

        {/* 1. Dynamic YouTube Shorts Showcase (No fake or placeholder video) */}
        <div style={{
          background: "linear-gradient(145deg, #181116 0%, #0D0F17 100%)",
          border: "1.5px solid rgba(255, 30, 0, 0.45)",
          borderRadius: 16,
          padding: "16px 18px",
          marginBottom: 16,
          boxShadow: "0 10px 30px rgba(0,0,0,0.7), 0 0 20px rgba(255,0,0,0.12)"
        }}>
          <div style={{ display: "flex", alignItems: "center", justifyContent: "space-between", marginBottom: 12 }}>
            <div style={{ display: "flex", alignItems: "center", gap: 8 }}>
              {/* Official YouTube Red Icon */}
              <div style={{
                background: "#FF0000",
                width: 28,
                height: 20,
                borderRadius: 6,
                display: "flex",
                alignItems: "center",
                justifyContent: "center",
                boxShadow: "0 0 12px rgba(255,0,0,0.6)"
              }}>
                <svg width="11" height="11" viewBox="0 0 24 24" fill="#FFFFFF">
                  <polygon points="5 3 19 12 5 21 5 3" />
                </svg>
              </div>
              <div>
                <span style={{ fontSize: 13, fontWeight: 900, color: "#FFFFFF", letterSpacing: 0.2 }}>YouTube Shorts Tutorial</span>
                <span style={{ fontSize: 11, color: "rgba(255,255,255,0.5)", marginLeft: 6 }}>· Form & Technique</span>
              </div>
            </div>
            <span style={{ fontSize: 10, fontWeight: 800, color: "#FF4D4D", background: "rgba(255,0,0,0.15)", padding: "3px 8px", borderRadius: 999, letterSpacing: 0.3 }}>
              Shorts Guide
            </span>
          </div>

          <p style={{ margin: "0 0 12px", fontSize: 12, color: "rgba(255,255,255,0.7)", lineHeight: 1.45 }}>
            Watch fast, mobile-friendly tutorial Shorts demonstrating proper setup, range of motion, and injury prevention for <strong style={{ color: "#FFFFFF" }}>{exerciseName}</strong>.
          </p>

          {/* Primary Action Button: Watch on YouTube Shorts ↗ */}
          <a
            href={youtubeShortsUrl}
            target="_blank"
            rel="noopener noreferrer"
            onClick={(e) => e.stopPropagation()}
            className="mat-ripple"
            style={{
              display: "flex",
              alignItems: "center",
              justifyContent: "center",
              gap: 8,
              width: "100%",
              boxSizing: "border-box",
              background: "linear-gradient(135deg, #FF1E00 0%, #D40000 100%)",
              border: "1px solid rgba(255,100,80,0.4)",
              borderRadius: 12,
              padding: "12px 16px",
              color: "#FFFFFF",
              fontSize: 13.5,
              fontWeight: 900,
              cursor: "pointer",
              textDecoration: "none",
              boxShadow: "0 6px 20px rgba(255,0,0,0.4)",
              transition: "transform 0.15s ease"
            }}
          >
            <div style={{ width: 18, height: 14, background: "#FFFFFF", borderRadius: 4, display: "flex", alignItems: "center", justifyContent: "center" }}>
              <svg width="8" height="8" viewBox="0 0 24 24" fill="#FF0000">
                <polygon points="5 3 19 12 5 21 5 3" />
              </svg>
            </div>
            <span>▶ Watch on YouTube Shorts ↗</span>
          </a>
        </div>

        {/* 2. Sets x Reps / Duration & Rest Time Cards */}
        <div style={{
          display: "grid",
          gridTemplateColumns: "1fr 1fr",
          gap: 8,
          marginBottom: 12
        }}>
          <div style={{ background: "rgba(255,255,255,0.03)", border: "1px solid rgba(255,255,255,0.08)", borderRadius: 12, padding: "10px 12px" }}>
            <div style={{ fontSize: 10, color: "rgba(255,255,255,0.45)", fontWeight: 800 }}>SETS × REPS / DURATION</div>
            <div style={{ fontSize: 14.5, fontWeight: 900, color: "#FFFFFF", marginTop: 3 }}>
              {ex.targetSets} Sets × {ex.targetReps || ex.targetDuration || 12} {ex.isDuration ? "sec hold" : "reps"}
            </div>
          </div>

          <div style={{ background: "rgba(255,255,255,0.03)", border: "1px solid rgba(255,255,255,0.08)", borderRadius: 12, padding: "10px 12px" }}>
            <div style={{ fontSize: 10, color: "rgba(255,255,255,0.45)", fontWeight: 800 }}>REST TIME</div>
            <div style={{ fontSize: 14.5, fontWeight: 900, color: "#2ED4BF", marginTop: 3, display: "flex", alignItems: "center", gap: 5 }}>
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round">
                <circle cx="12" cy="12" r="10" />
                <polyline points="12 6 12 12 16 14" />
              </svg>
              <span>{ex.restTime || "45s"}</span>
            </div>
          </div>
        </div>

        {/* 3. Target Muscle Card */}
        <div style={{ background: "rgba(255,255,255,0.03)", border: "1px solid rgba(255,255,255,0.08)", borderRadius: 12, padding: "10px 12px", marginBottom: 14 }}>
          <div style={{ display: "flex", alignItems: "center", gap: 6, marginBottom: 4, flexWrap: "wrap" }}>
            <span style={{ fontSize: 10, color: "rgba(255,255,255,0.45)", fontWeight: 800 }}>TARGET MUSCLE:</span>
            <span style={{ fontSize: 12.5, fontWeight: 800, color: "#FF4D4D" }}>{targetMuscle}</span>
          </div>
          <div style={{ display: "flex", alignItems: "center", gap: 6, flexWrap: "wrap" }}>
            <span style={{ fontSize: 10, color: "rgba(255,255,255,0.45)", fontWeight: 800 }}>SECONDARY:</span>
            <span style={{ fontSize: 11.5, color: "#38BDF8", fontWeight: 700 }}>{secondaryMuscle}</span>
          </div>
        </div>

        {/* 4. How to Perform (Step-by-Step) */}
        <div style={{ marginBottom: 14 }}>
          <div style={{ fontSize: 12, fontWeight: 900, color: "#60A5FA", textTransform: "uppercase", letterSpacing: 0.5, marginBottom: 8, display: "flex", alignItems: "center", gap: 6 }}>
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#60A5FA" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round">
              <polyline points="9 11 12 14 22 4" />
              <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" />
            </svg>
            <span>How to Perform</span>
          </div>
          <div style={{ display: "flex", flexDirection: "column", gap: 7 }}>
            {steps.map((step, idx) => (
              <div key={idx} style={{ display: "flex", alignItems: "flex-start", gap: 9, fontSize: 12, color: "rgba(255,255,255,0.85)", lineHeight: 1.45 }}>
                <span style={{
                  width: 18,
                  height: 18,
                  borderRadius: "50%",
                  background: "rgba(37,107,253,0.2)",
                  color: "#60A5FA",
                  display: "flex",
                  alignItems: "center",
                  justifyContent: "center",
                  fontSize: 10,
                  fontWeight: 900,
                  flexShrink: 0,
                  marginTop: 1
                }}>
                  {idx + 1}
                </span>
                <span style={{ flex: 1 }}>{step}</span>
              </div>
            ))}
          </div>
        </div>

        {/* 5. Form Tips & Injury Prevention */}
        <div style={{ marginBottom: 16 }}>
          <div style={{ fontSize: 12, fontWeight: 900, color: "#F59E0B", textTransform: "uppercase", letterSpacing: 0.5, marginBottom: 8, display: "flex", alignItems: "center", gap: 6 }}>
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#F59E0B" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round">
              <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
              <line x1="12" y1="9" x2="12" y2="13" />
              <line x1="12" y1="17" x2="12.01" y2="17" />
            </svg>
            <span>Form Tips & Injury Prevention</span>
          </div>
          <div style={{ display: "flex", flexDirection: "column", gap: 6 }}>
            {tips.map((tip, idx) => (
              <div key={idx} style={{
                display: "flex",
                alignItems: "flex-start",
                gap: 8,
                fontSize: 11.5,
                color: "rgba(255,255,255,0.75)",
                lineHeight: 1.4,
                background: "rgba(245,158,11,0.06)",
                border: "1px solid rgba(245,158,11,0.15)",
                padding: "8px 10px",
                borderRadius: 8
              }}>
                <span style={{ color: "#F59E0B", fontWeight: 900, fontSize: 13, lineHeight: 1 }}>•</span>
                <span style={{ flex: 1 }}>{tip}</span>
              </div>
            ))}
          </div>
        </div>

        {/* 6. Navigation & Start / Log Set Controls */}
        <div style={{
          display: "flex",
          gap: 8,
          alignItems: "center",
          paddingTop: 10,
          borderTop: "1px solid rgba(255,255,255,0.08)"
        }}>
          <button
            onClick={() => onNavigateExercise && onNavigateExercise(exerciseIndex - 1)}
            disabled={!hasPrev}
            style={{
              flex: 1,
              background: hasPrev ? "rgba(255,255,255,0.08)" : "rgba(255,255,255,0.02)",
              border: "1px solid rgba(255,255,255,0.1)",
              borderRadius: 10,
              padding: "9px 0",
              color: hasPrev ? "#FFFFFF" : "rgba(255,255,255,0.2)",
              fontSize: 11.5,
              fontWeight: 800,
              cursor: hasPrev ? "pointer" : "not-allowed",
              display: "flex",
              alignItems: "center",
              justifyContent: "center",
              gap: 5
            }}
          >
            <span>← Previous</span>
          </button>

          <button
            onClick={handleStartWorkoutOrLog}
            style={{
              flex: 2,
              background: isCompleted ? "linear-gradient(135deg, #10B981 0%, #059669 100%)" : "linear-gradient(135deg, #256BFD 0%, #1A5EE5 100%)",
              border: "none",
              borderRadius: 10,
              padding: "10px 0",
              color: "#FFFFFF",
              fontSize: 12.5,
              fontWeight: 900,
              cursor: "pointer",
              boxShadow: "0 4px 14px rgba(37,107,253,0.35)",
              display: "flex",
              alignItems: "center",
              justifyContent: "center",
              gap: 6
            }}
          >
            {loggedNotification ? (
              <span>✓ Set Recorded!</span>
            ) : isCompleted ? (
              <span>✓ Exercise Complete</span>
            ) : (
              <span>Start Workout / Log Set</span>
            )}
          </button>

          <button
            onClick={() => onNavigateExercise && onNavigateExercise(exerciseIndex + 1)}
            disabled={!hasNext}
            style={{
              flex: 1,
              background: hasNext ? "rgba(255,255,255,0.08)" : "rgba(255,255,255,0.02)",
              border: "1px solid rgba(255,255,255,0.1)",
              borderRadius: 10,
              padding: "9px 0",
              color: hasNext ? "#FFFFFF" : "rgba(255,255,255,0.2)",
              fontSize: 11.5,
              fontWeight: 800,
              cursor: hasNext ? "pointer" : "not-allowed",
              display: "flex",
              alignItems: "center",
              justifyContent: "center",
              gap: 5
            }}
          >
            <span>Next →</span>
          </button>
        </div>
      </div>
    </div>
  );
}

function ExerciseCard({
  ex,
  log,
  onSetChange,
  onAddSet,
  onToggleComplete,
  completed,
  workoutLabel,
  allExercises = [],
  exerciseIndex = 0,
  programKey,
  isHomeWorkout,
  onOpenModal
}) {
  const [showModal, setShowModal] = useState(false);
  const [showFormTips, setShowFormTips] = useState(false);

  const isHome = isHomeWorkout || programKey === "Home Workout" || (programKey && programKey.includes("Home"));

  // Dynamic YouTube Shorts search URL: `${exercise.name} exercise shorts`
  const youtubeShortsUrl = `https://www.youtube.com/results?search_query=${encodeURIComponent(ex.name + " exercise shorts")}`;

  const ytData = (typeof window !== "undefined" && window.getExerciseYouTubeData)
    ? window.getExerciseYouTubeData(ex.name)
    : null;

  const handleOpenPage = (e) => {
    if (e) e.stopPropagation();
    if (onOpenModal) {
      onOpenModal(exerciseIndex);
    } else {
      setShowModal(true);
    }
  };

  const handleSpeakVoice = (e) => {
    if (e) e.stopPropagation();
    if (typeof window !== "undefined" && "speechSynthesis" in window) {
      window.speechSynthesis.cancel();
      const voiceText = ex.voice || `${ex.name}. Target muscle is ${(ytData && ytData.muscle) || "primary muscle"}. Maintain controlled tempo and steady breathing.`;
      const utterance = new SpeechSynthesisUtterance(voiceText);
      utterance.rate = 1.0;
      utterance.pitch = 1.05;
      utterance.lang = "en-US";
      window.speechSynthesis.speak(utterance);
    }
  };

  return (
    <div style={{
      background: TOKENS.surface2,
      backdropFilter: "blur(16px) saturate(180%)",
      WebkitBackdropFilter: "blur(16px) saturate(180%)",
      border: `1px solid ${completed ? "rgba(37, 107, 253, 0.4)" : TOKENS.border}`,
      borderRadius: 14,
      padding: 14,
      marginBottom: 12,
      opacity: completed ? 0.8 : 1,
      transition: "all 0.2s ease",
      boxShadow: completed ? "0 4px 16px rgba(37,107,253,0.15)" : "none"
    }}>
      {/* Exercise Card Header */}
      <div style={{ display: "flex", justifyContent: "space-between", alignItems: "flex-start", marginBottom: 10 }}>
        <div style={{ flex: 1, paddingRight: 8, cursor: "pointer" }} onClick={handleOpenPage}>
          <div style={{ display: "flex", alignItems: "center", gap: 6, flexWrap: "wrap" }}>
            <span style={{ fontSize: 15, fontWeight: 800, color: TOKENS.text, textDecoration: completed ? "line-through" : "none" }}>
              {ex.name}
            </span>
            {isHome && (
              <span style={{ fontSize: 9.5, fontWeight: 800, background: "rgba(46,212,191,0.15)", color: "#2ED4BF", padding: "2px 7px", borderRadius: 999 }}>
                Home Bodyweight
              </span>
            )}
          </div>

          <div style={{ display: "flex", alignItems: "center", gap: 8, marginTop: 4 }}>
            <span style={{ fontSize: 12, color: TOKENS.mutedFaint }}>
              Target: {ex.targetSets} × {ex.targetReps || ex.targetDuration || 12} {ex.isDuration ? "sec" : "reps"}
            </span>
            <span style={{ fontSize: 11, background: "rgba(255,255,255,0.06)", color: "rgba(255,255,255,0.75)", padding: "2px 7px", borderRadius: 6, fontWeight: 700, display: "inline-flex", alignItems: "center", gap: 4 }}>
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
                <circle cx="12" cy="12" r="10" />
                <polyline points="12 6 12 12 16 14" />
              </svg>
              <span>{ex.restTime || "45s"}</span>
            </span>
          </div>
        </div>

        {/* Complete Checkbox */}
        <button
          onClick={onToggleComplete}
          style={{
            width: 34,
            height: 34,
            borderRadius: "50%",
            border: `1.5px solid ${completed ? "#256BFD" : TOKENS.border}`,
            background: completed ? "linear-gradient(135deg, #256BFD 0%, #1A5EE5 100%)" : "transparent",
            color: completed ? "#FFFFFF" : TOKENS.mutedFaint,
            cursor: "pointer",
            flexShrink: 0,
            display: "flex",
            alignItems: "center",
            justifyContent: "center",
            boxShadow: completed ? "0 0 14px rgba(37,107,253,0.4)" : "none",
            transition: "all 0.15s ease"
          }}
          aria-label="Mark completed"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke={completed ? "#FFFFFF" : "rgba(255,255,255,0.3)"} strokeWidth="3" strokeLinecap="round" strokeLinejoin="round">
            <polyline points="20 6 9 17 4 12" />
          </svg>
        </button>
      </div>

      {/* Action Buttons: Watch on YouTube Shorts, Exercise Page, Voice, Form */}
      <div style={{ display: "flex", gap: 6, marginBottom: 12, flexWrap: "wrap" }}>
        {/* Dynamic Watch on YouTube Shorts Button (For EVERY exercise) */}
        <a
          href={youtubeShortsUrl}
          target="_blank"
          rel="noopener noreferrer"
          onClick={(e) => e.stopPropagation()}
          className="mat-ripple"
          style={{
            background: "linear-gradient(135deg, rgba(255, 30, 0, 0.22) 0%, rgba(220, 20, 0, 0.32) 100%)",
            border: "1px solid rgba(255, 60, 30, 0.5)",
            borderRadius: 8,
            padding: "6px 12px",
            color: "#FFA8A8",
            fontSize: 11,
            fontWeight: 800,
            cursor: "pointer",
            display: "inline-flex",
            alignItems: "center",
            gap: 6,
            textDecoration: "none",
            boxShadow: "0 2px 8px rgba(255,0,0,0.2)",
            transition: "all 0.15s ease"
          }}
          title={`Watch ${ex.name} Shorts on YouTube`}
        >
          <div style={{ width: 14, height: 11, background: "#FF0000", borderRadius: 3, display: "flex", alignItems: "center", justifyContent: "center" }}>
            <svg width="6" height="6" viewBox="0 0 24 24" fill="#FFFFFF">
              <polygon points="5 3 19 12 5 21 5 3" />
            </svg>
          </div>
          <span>▶ Watch on YouTube Shorts ↗</span>
        </a>

        {/* View Full Exercise Page Button */}
        <button
          onClick={handleOpenPage}
          style={{
            flex: 1,
            minWidth: 100,
            background: "linear-gradient(135deg, rgba(37,107,253,0.15) 0%, rgba(26,94,229,0.25) 100%)",
            border: "1px solid rgba(37,107,253,0.35)",
            borderRadius: 8,
            padding: "6px 10px",
            color: "#93C5FD",
            fontSize: 11,
            fontWeight: 800,
            cursor: "pointer",
            display: "flex",
            alignItems: "center",
            justifyContent: "center",
            gap: 5
          }}
        >
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round">
            <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
            <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
          </svg>
          <span>Exercise Page</span>
        </button>

        {/* Voice Audio Coach Button */}
        <button
          onClick={handleSpeakVoice}
          style={{
            background: "rgba(255,255,255,0.06)",
            border: "1px solid rgba(255,255,255,0.12)",
            borderRadius: 8,
            padding: "6px 9px",
            color: "rgba(255,255,255,0.85)",
            fontSize: 11,
            fontWeight: 700,
            cursor: "pointer",
            display: "flex",
            alignItems: "center",
            gap: 4
          }}
          title="Listen to audio coach form cue"
        >
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round">
            <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5" />
            <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07" />
          </svg>
          <span>Voice</span>
        </button>

        {/* Form Tips Dropdown Toggle */}
        <button
          onClick={(e) => { e.stopPropagation(); setShowFormTips(!showFormTips); }}
          style={{
            background: showFormTips ? "rgba(245,158,11,0.2)" : "rgba(255,255,255,0.06)",
            border: `1px solid ${showFormTips ? "rgba(245,158,11,0.5)" : "rgba(255,255,255,0.12)"}`,
            borderRadius: 8,
            padding: "6px 9px",
            color: showFormTips ? "#F59E0B" : "rgba(255,255,255,0.85)",
            fontSize: 11,
            fontWeight: 700,
            cursor: "pointer",
            display: "flex",
            alignItems: "center",
            gap: 4
          }}
        >
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
            <circle cx="12" cy="12" r="10" />
            <line x1="12" y1="16" x2="12" y2="12" />
            <line x1="12" y1="8" x2="12.01" y2="8" />
          </svg>
          <span>Form</span>
        </button>
      </div>

      {/* Expandable Form Tip Card */}
      {showFormTips && (
        <div style={{
          background: "rgba(245,158,11,0.08)",
          border: "1px solid rgba(245,158,11,0.25)",
          borderRadius: 10,
          padding: "10px 12px",
          marginBottom: 12,
          fontSize: 11.5,
          color: "rgba(255,255,255,0.9)",
          lineHeight: 1.45
        }}>
          <div style={{ display: "flex", alignItems: "center", gap: 6, fontWeight: 800, color: "#F59E0B", marginBottom: 4 }}>
            <span>Key Technique Cue:</span>
          </div>
          <div>{ex.tips || (ytData && ytData.tips && ytData.tips[0]) || "Maintain core tension and controlled tempo throughout every rep."}</div>
        </div>
      )}

      {/* Sets Logger Grid */}
      <div style={{
        display: "grid",
        gridTemplateColumns: isHome ? "36px 1fr 48px" : "36px 1fr 1fr 48px",
        gap: 6,
        padding: "0 0 6px",
        borderBottom: "1px solid rgba(255,255,255,0.08)",
        marginBottom: 6,
        fontSize: 10.5,
        color: TOKENS.mutedFaint,
        fontWeight: 700,
        textTransform: "uppercase"
      }}>
        <div>Set</div>
        <div>{ex.isDuration ? "Secs" : "Reps"}</div>
        {!isHome && <div>Kg</div>}
        <div style={{ textAlign: "center" }}>Done</div>
      </div>

      {log.map((set, setIdx) => {
        const isDone = !!(set.reps || set.completed);
        return (
          <div
            key={setIdx}
            style={{
              display: "grid",
              gridTemplateColumns: isHome ? "36px 1fr 48px" : "36px 1fr 1fr 48px",
              gap: 6,
              alignItems: "center",
              marginBottom: 6
            }}
          >
            <div style={{ fontSize: 12, fontWeight: 700, color: TOKENS.muted }}>
              {setIdx + 1}
            </div>

            {/* Reps Input */}
            <input
              type="number"
              placeholder={String(ex.targetReps || ex.targetDuration || 12)}
              value={set.reps || ""}
              onChange={(e) => onSetChange && onSetChange(setIdx, "reps", e.target.value)}
              style={{
                background: "rgba(255,255,255,0.05)",
                border: "1px solid rgba(255,255,255,0.1)",
                borderRadius: 8,
                padding: "6px 8px",
                color: "#FFFFFF",
                fontSize: 13,
                fontWeight: 700,
                textAlign: "center",
                width: "100%",
                boxSizing: "border-box"
              }}
            />

            {/* Weight Input (Hidden for Home Workouts) */}
            {!isHome && (
              <input
                type="number"
                placeholder="kg"
                value={set.weight || ""}
                onChange={(e) => onSetChange && onSetChange(setIdx, "weight", e.target.value)}
                style={{
                  background: "rgba(255,255,255,0.05)",
                  border: "1px solid rgba(255,255,255,0.1)",
                  borderRadius: 8,
                  padding: "6px 8px",
                  color: "#FFFFFF",
                  fontSize: 13,
                  fontWeight: 700,
                  textAlign: "center",
                  width: "100%",
                  boxSizing: "border-box"
                }}
              />
            )}

            {/* Checkmark Button */}
            <button
              onClick={() => onSetChange && onSetChange(setIdx, "completed", !set.completed)}
              style={{
                width: 32,
                height: 32,
                borderRadius: 8,
                border: `1.5px solid ${isDone ? "#256BFD" : "rgba(255,255,255,0.15)"}`,
                background: isDone ? "linear-gradient(135deg, #256BFD 0%, #1A5EE5 100%)" : "rgba(255,255,255,0.04)",
                color: isDone ? "#FFFFFF" : "rgba(255,255,255,0.3)",
                cursor: "pointer",
                margin: "0 auto",
                display: "flex",
                alignItems: "center",
                justifyContent: "center",
                boxShadow: isDone ? "0 0 10px rgba(37,107,253,0.3)" : "none",
                transition: "all 0.15s ease"
              }}
            >
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="3" strokeLinecap="round" strokeLinejoin="round">
                <polyline points="20 6 9 17 4 12" />
              </svg>
            </button>
          </div>
        );
      })}

      {/* Add Set Button */}
      <div style={{ display: "flex", justifyContent: "flex-end", marginTop: 4 }}>
        <button
          onClick={onAddSet}
          style={{
            background: "transparent",
            border: "none",
            color: "#60A5FA",
            fontSize: 11.5,
            fontWeight: 800,
            cursor: "pointer",
            padding: "4px 8px"
          }}
        >
          + Add Set
        </button>
      </div>

      {/* Standalone Modal Fallback */}
      {showModal && (
        <ExerciseDetailModal
          ex={ex}
          exerciseIndex={exerciseIndex}
          allExercises={allExercises}
          isHomeWorkout={isHome}
          onClose={() => setShowModal(false)}
          onLogSet={() => onAddSet && onAddSet()}
          onToggleComplete={onToggleComplete}
          isCompleted={completed}
        />
      )}
    </div>
  );
}

/* ---------- screens ---------- */

function greetingForNow() {
  const h = new Date().getHours();
  if (h < 12) return "Good morning";
  if (h < 17) return "Good afternoon";
  return "Good evening";
}

function IconBadge({ emoji, icon, bg }) {
  return (
    <div style={{ width: 44, height: 44, borderRadius: 13, background: bg, display: "flex", alignItems: "center", justifyContent: "center", fontSize: 20, flexShrink: 0,
      boxShadow: "5px 5px 10px rgba(0,0,0,0.6), -5px -5px 10px rgba(255,255,255,0.04)" }}>
      {icon === "workout" ? (
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0B0E13" strokeWidth="2.4" strokeLinecap="round" strokeLinejoin="round"><path d="M6.5 6.5h11M6 20v-2a6 6 0 0 1 12 0v2M2 9v6M22 9v6M4 7h2v10H4zM18 7h2v10h-2z"/></svg>
      ) : icon === "run" ? (
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#256BFD" strokeWidth="2.4" strokeLinecap="round" strokeLinejoin="round"><circle cx="15.5" cy="5" r="1.8"/><path d="M9 20l2.5-5.5 2 1.8 3.5-1"/><path d="M7 13.5l3.5-2.5 2 2.5-2.5 3.5"/></svg>
      ) : emoji}
    </div>
  );
}
const CARD_SHADOW = "0 1px 2px rgba(31,42,27,0.04), 0 6px 20px rgba(31,42,27,0.06)";

function ScreenHeader({ title, subtitle, onBack, rightAction, canGoBack = true }) {
  return (
    <div style={{
      display: 'flex',
      alignItems: 'center',
      justifyContent: 'space-between',
      marginBottom: 16,
      paddingTop: 'max(4px, env(safe-area-inset-top, 4px))',
      position: 'relative',
      zIndex: 10
    }}>
      <div style={{ display: 'flex', alignItems: 'center', gap: 12 }}>
        {canGoBack && onBack && (
          <button
            onClick={onBack}
            style={{
              width: 38,
              height: 38,
              borderRadius: '50%',
              background: 'rgba(255,255,255,0.06)',
              border: '1px solid rgba(255,255,255,0.12)',
              color: '#FFFFFF',
              cursor: 'pointer',
              display: 'flex',
              alignItems: 'center',
              justifyContent: 'center',
              padding: 0,
              boxShadow: '0 2px 8px rgba(0,0,0,0.3)',
              transition: 'transform 0.15s ease, background 0.15s ease',
              flexShrink: 0
            }}
            aria-label='Back'
          >
            <svg width='18' height='18' viewBox='0 0 24 24' fill='none' stroke='currentColor' strokeWidth='2.4' strokeLinecap='round' strokeLinejoin='round'>
              <line x1='19' y1='12' x2='5' y2='12' />
              <polyline points='12 19 5 12 12 5' />
            </svg>
          </button>
        )}
        <div>
          {subtitle && <div style={{ fontSize: 11, color: TOKENS.mutedFaint, letterSpacing: 0.5, textTransform: 'uppercase', fontWeight: 700 }}>{subtitle}</div>}
          <h1 style={{ margin: subtitle ? '2px 0 0' : 0, fontSize: 22, fontWeight: 900, color: TOKENS.text, letterSpacing: -0.4 }}>{title}</h1>
        </div>
      </div>
      {rightAction && <div>{rightAction}</div>}
    </div>
  );
}

