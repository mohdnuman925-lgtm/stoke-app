      return <svg width={size} height={size} viewBox='0 0 24 24' fill='none' stroke={color} strokeWidth='2.2' strokeLinecap='round' strokeLinejoin='round'><path d='M4 16v-2.38C4 11.5 5.5 9 8 9h8c2.5 0 4 2.5 4 4.62V16M2 20h20M7 20v-4M17 20v-4'/></svg>;
