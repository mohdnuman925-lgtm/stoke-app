function RoutePreview({ path, size = 180, color = "#256BFD", mapMode = "map" }) {
  const [interactiveMode, setInteractiveMode] = useState(mapMode);

  if (!path || path.length < 2) {
    return (
      <div style={{ position: "relative", width: "100%", height: size, margin: "0 auto", display: "flex", flexDirection: "column", alignItems: "center", justifyContent: "center", background: "#0D1117", borderRadius: 16, border: `1px solid ${TOKENS.border}`, overflow: "hidden" }}>
        {/* Dark Grid Background */}
        <div style={{ position: "absolute", inset: 0, backgroundImage: "linear-gradient(rgba(255,255,255,0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.04) 1px, transparent 1px)", backgroundSize: "20px 20px" }} />
        <div style={{ position: "relative", zIndex: 2, display: "flex", alignItems: "center", gap: 8 }}>
          <div style={{ width: 10, height: 10, borderRadius: "50%", background: TOKENS.ember, boxShadow: "0 0 10px #256BFD", animation: "stokeFadeIn 1s infinite alternate" }} />
          <span style={{ fontSize: 12, color: TOKENS.mutedFaint, fontWeight: 600 }}>Acquiring GPS Satellite Lock…</span>
        </div>
      </div>
    );
  }

  const lats = path.map((p) => p.lat);
  const lngs = path.map((p) => p.lng);
  const minLat = Math.min(...lats), maxLat = Math.max(...lats);
  const minLng = Math.min(...lngs), maxLng = Math.max(...lngs);
  const latRange = maxLat - minLat || 0.0005;
  const lngRange = maxLng - minLng || 0.0005;
  const W = 320;
  const H = size;
  const scale = (Math.min(W, H) * 0.75) / Math.max(latRange, lngRange);
  const midLat = (minLat + maxLat) / 2, midLng = (minLng + maxLng) / 2;

  const points = path
    .map((p) => `${W / 2 + (p.lng - midLng) * scale},${H / 2 - (p.lat - midLat) * scale}`)
    .join(" ");

  const startPt = path[0];
  const startX = W / 2 + (startPt.lng - midLng) * scale;
  const startY = H / 2 - (startPt.lat - midLat) * scale;

  const last = path[path.length - 1];
  const lastX = W / 2 + (last.lng - midLng) * scale;
  const lastY = H / 2 - (last.lat - midLat) * scale;

  return (
    <div style={{ position: "relative", width: "100%", height: H, borderRadius: 16, overflow: "hidden", background: "#0B0E14", border: `1px solid ${TOKENS.border}`, boxShadow: "inset 0 0 20px rgba(0,0,0,0.8)" }}>
      {/* Map Mode: Dark street vector layer */}
      {interactiveMode === "map" && (
        <div style={{ position: "absolute", inset: 0, opacity: 0.85, pointerEvents: "none" }}>
          {/* Simulated Dark Mode Roads & Water */}
          <svg width="100%" height="100%" style={{ position: "absolute", inset: 0 }}>
            {/* Road lines */}
            <path d="M 0 40 Q 120 70 320 30" stroke="rgba(255,255,255,0.08)" strokeWidth="8" fill="none" />
            <path d="M 40 0 Q 70 100 80 200" stroke="rgba(255,255,255,0.06)" strokeWidth="6" fill="none" />
            <path d="M 0 130 L 320 120" stroke="rgba(255,255,255,0.07)" strokeWidth="5" fill="none" />
            <path d="M 220 0 L 240 200" stroke="rgba(255,255,255,0.06)" strokeWidth="6" fill="none" />
            <circle cx="280" cy="140" r="28" fill="rgba(46,212,191,0.06)" />
            {/* Street labels */}
            <text x="14" y="32" fill="rgba(255,255,255,0.22)" fontSize="8.5" fontWeight="600" letterSpacing="0.5">STOKE PARKWAY</text>
            <text x="140" y="114" fill="rgba(255,255,255,0.22)" fontSize="8.5" fontWeight="600" letterSpacing="0.5">AVENUE 7</text>
          </svg>
        </div>
      )}

      {/* Grid Pattern */}
      <div style={{ position: "absolute", inset: 0, backgroundImage: "linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px)", backgroundSize: "24px 24px", pointerEvents: "none" }} />

      {/* SVG Polyline Overlay */}
      <svg width="100%" height="100%" viewBox={`0 0 ${W} ${H}`} style={{ position: "absolute", inset: 0 }}>
        <defs>
          <filter id="routeGlow" x="-20%" y="-20%" width="140%" height="140%">
            <feDropShadow dx="0" dy="0" stdDeviation="3" floodColor="#256BFD" floodOpacity="0.8" />
          </filter>
        </defs>
        {/* Route Outer Shadow */}
        <polyline points={points} fill="none" stroke="rgba(37, 107, 253,0.3)" strokeWidth={7} strokeLinejoin="round" strokeLinecap="round" />
        {/* Route Core */}
        <polyline points={points} fill="none" stroke={color} strokeWidth={3.5} strokeLinejoin="round" strokeLinecap="round" filter="url(#routeGlow)" />
        {/* Start Point */}
        <circle cx={startX} cy={startY} r={5} fill="#10B981" stroke="#FFFFFF" strokeWidth={1.5} />
        {/* Live Runner Beacon with Pulsing Halo */}
        <circle cx={lastX} cy={lastY} r={10} fill="rgba(37, 107, 253,0.3)" />
        <circle cx={lastX} cy={lastY} r={5.5} fill="#256BFD" stroke="#0B0E13" strokeWidth={1.5} />
      </svg>

      {/* Map Mode Switcher Pill */}
      <div style={{ position: "absolute", top: 8, right: 8, zIndex: 10, display: "flex", gap: 4, background: "rgba(0,0,0,0.65)", backdropFilter: "blur(8px)", padding: "2px 4px", borderRadius: 8, border: "1px solid rgba(255,255,255,0.1)" }}>
        <button
          onClick={() => setInteractiveMode("map")}
          style={{ background: interactiveMode === "map" ? "rgba(37, 107, 253,0.25)" : "transparent", color: interactiveMode === "map" ? TOKENS.ember : TOKENS.muted, border: "none", borderRadius: 6, padding: "3px 6px", fontSize: 10, fontWeight: 700, cursor: "pointer" }}
        >
          🗺️ Street Map
        </button>
        <button
          onClick={() => setInteractiveMode("neon")}
          style={{ background: interactiveMode === "neon" ? "rgba(37, 107, 253,0.25)" : "transparent", color: interactiveMode === "neon" ? TOKENS.ember : TOKENS.muted, border: "none", borderRadius: 6, padding: "3px 6px", fontSize: 10, fontWeight: 700, cursor: "pointer" }}
        >
          ⚡ Polyline
        </button>
      </div>

      {/* Live Coordinates Pill */}
      <div style={{ position: "absolute", bottom: 8, left: 8, zIndex: 10, background: "rgba(0,0,0,0.65)", backdropFilter: "blur(8px)", padding: "3px 8px", borderRadius: 6, border: "1px solid rgba(255,255,255,0.1)", fontSize: 9.5, color: TOKENS.muted, fontVariantNumeric: "tabular-nums" }}>
        GPS: {last.lat.toFixed(4)}, {last.lng.toFixed(4)}
      </div>
    </div>
  );
}

function haversineKm(a, b) {
  const R = 6371;
  const dLat = ((b.lat - a.lat) * Math.PI) / 180;
  const dLng = ((b.lng - a.lng) * Math.PI) / 180;
  const lat1 = (a.lat * Math.PI) / 180;
  const lat2 = (b.lat * Math.PI) / 180;
  const h = Math.sin(dLat / 2) ** 2 + Math.cos(lat1) * Math.cos(lat2) * Math.sin(dLng / 2) ** 2;
  return R * 2 * Math.atan2(Math.sqrt(h), Math.sqrt(1 - h));
}

function formatTime(totalSeconds) {
  const m = Math.floor(totalSeconds / 60);
  const s = Math.floor(totalSeconds % 60);
  return `${m}:${String(s).padStart(2, "0")}`;
}

function formatDurationRunning(totalSeconds) {
  if (totalSeconds >= 3600) {
    const h = Math.floor(totalSeconds / 3600);
    const m = Math.floor((totalSeconds % 3600) / 60);
    return `${h}h ${m}m`;
  }
  const m = Math.floor(totalSeconds / 60);
  const s = Math.floor(totalSeconds % 60);
  return `${m}h ${s}m`.replace("0h ", "") || `${m}m ${s}s`;
}

const SHARE_CARD_STYLES = [
  { key: "custom", label: "📸 Upload Photo" },
  { key: "dark", label: "🌑 OLED Black" },
];

function drawCardBackground(ctx, W, H, style, customImage = null) {
  if (customImage && customImage.complete && customImage.naturalWidth > 0) {
    // Draw user custom photo with cover aspect ratio
    const imgRatio = customImage.naturalWidth / customImage.naturalHeight;
    const canvasRatio = W / H;
    let sx = 0, sy = 0, sw = customImage.naturalWidth, sh = customImage.naturalHeight;
    if (imgRatio > canvasRatio) {
      sw = customImage.naturalHeight * canvasRatio;
      sx = (customImage.naturalWidth - sw) / 2;
    } else {
      sh = customImage.naturalWidth / canvasRatio;
      sy = (customImage.naturalHeight - sh) / 2;
    }
    ctx.drawImage(customImage, sx, sy, sw, sh, 0, 0, W, H);

    // Soft cinematic gradient overlay preserving photo brilliance
    const darkOverlay = ctx.createLinearGradient(0, 0, 0, H);
    darkOverlay.addColorStop(0, "rgba(0,0,0,0.40)");
    darkOverlay.addColorStop(0.22, "rgba(0,0,0,0.10)");
    darkOverlay.addColorStop(0.55, "rgba(0,0,0,0.0)");
    darkOverlay.addColorStop(0.85, "rgba(0,0,0,0.30)");
    darkOverlay.addColorStop(1, "rgba(0,0,0,0.70)");
    ctx.fillStyle = darkOverlay;
    ctx.fillRect(0, 0, W, H);
    return { textColor: "#FFFFFF", mutedColor: "rgba(255,255,255,0.85)", isPhoto: true };
  }

  // "dark" / Clean Pure OLED Black
  ctx.fillStyle = "#000000";
  ctx.fillRect(0, 0, W, H);

  // Subtle aesthetic glow in background
  const glow = ctx.createRadialGradient(W / 2, H * 0.52, 40, W / 2, H * 0.52, 320);
  glow.addColorStop(0, "rgba(37, 107, 253, 0.22)");
  glow.addColorStop(0.6, "rgba(37, 107, 253, 0.04)");
  glow.addColorStop(1, "rgba(0,0,0,0)");
  ctx.fillStyle = glow;
  ctx.fillRect(0, 0, W, H);

  // Subtle grid pattern
  ctx.strokeStyle = "rgba(255, 255, 255, 0.04)";
  ctx.lineWidth = 1;
  for (let x = 0; x < W; x += 30) {
    ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, H); ctx.stroke();
  }
  for (let y = 0; y < H; y += 30) {
    ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(W, y); ctx.stroke();
  }

  return { textColor: "#FFFFFF", mutedColor: "rgba(255,255,255,0.75)", isPhoto: false };
}

function drawShareCard({ activityType = "run", distanceKm, elapsed, paceMinPerKm, speedKmh, path = [], style = "dark", customImage = null, brand = "STOKE", customSteps = null, athleteName = "Mohd Numan", location = "Worldwide Athlete" }) {
  const W = 450, H = 800;
  const canvas = document.createElement("canvas");
  canvas.width = W;
  canvas.height = H;
  const ctx = canvas.getContext("2d");

  const theme = drawCardBackground(ctx, W, H, style, customImage);

  // Calculate all live stats
  const distVal = typeof distanceKm === "number" ? distanceKm : 0;
  const timeSecs = typeof elapsed === "number" ? elapsed : 0;
  const timeFormatted = formatTime(timeSecs);
  
  // Pace or Speed
  let paceOrSpeedLabel = "Pace";
  let paceOrSpeedVal = (paceMinPerKm > 0 && distVal > 0) ? `${formatPace(paceMinPerKm)} /km` : "--'--\" /km";
  if (activityType === "bike") {
    paceOrSpeedLabel = "Avg Speed";
    const calcSpeed = speedKmh > 0 ? speedKmh : (timeSecs > 0 && distVal > 0 ? distVal / (timeSecs / 3600) : 0);
    paceOrSpeedVal = `${calcSpeed.toFixed(1)} km/h`;
  }

  // Steps
  const stepsVal = (customSteps || Math.round(distVal * (activityType === "walk" ? 1350 : 1240))).toLocaleString();

  // Calories
  const metFactor = activityType === "bike" ? 0.55 : activityType === "walk" ? 0.75 : 1.036;
  const calVal = `${Math.round(distVal * RUNNER_WEIGHT_KG * metFactor)} kcal`;

  // 1. TOP BRANDING BADGE
  ctx.textAlign = "center";
  ctx.shadowColor = "rgba(0, 0, 0, 0.8)";
  ctx.shadowBlur = 8;
  ctx.shadowOffsetX = 0;
  ctx.shadowOffsetY = 2;

  // App Logo
  ctx.fillStyle = "#256BFD";
  ctx.font = "900 18px -apple-system, BlinkMacSystemFont, 'Space Grotesk', Roboto, sans-serif";
  ctx.letterSpacing = "3px";
  ctx.fillText("STOKE ⚡", W / 2, 58);

  // Activity Tag
  ctx.fillStyle = "rgba(255, 255, 255, 0.65)";
  ctx.font = "700 12px -apple-system, BlinkMacSystemFont, 'Space Grotesk', Roboto, sans-serif";
  ctx.letterSpacing = "1.5px";
  const actName = activityType === "run" ? "OUTDOOR RUN" : activityType === "bike" ? "CYCLING RIDE" : "OUTDOOR WALK";
  ctx.fillText(actName, W / 2, 80);

  // 2. HERO DISTANCE
  ctx.fillStyle = "rgba(255, 255, 255, 0.75)";
  ctx.font = "600 14px -apple-system, BlinkMacSystemFont, 'Space Grotesk', Roboto, sans-serif";
  ctx.letterSpacing = "1px";
  ctx.fillText("DISTANCE", W / 2, 125);

  ctx.fillStyle = "#FFFFFF";
  ctx.font = "900 52px -apple-system, BlinkMacSystemFont, 'Space Grotesk', Roboto, sans-serif";
  ctx.letterSpacing = "-1px";
  ctx.fillText(`${distVal.toFixed(2)} km`, W / 2, 175);

  // 3. 4-STAT LIVE TELEMETRY GRID (Pace, Steps, Calories, Time)
  const gridY = 205;
  const gridH = 150;
  
  // Translucent Stats Card ONLY in OLED Black mode (NO black box on photos!)
  if (!theme.isPhoto) {
    ctx.fillStyle = "rgba(20, 24, 33, 0.65)";
    ctx.beginPath();
    ctx.roundRect(28, gridY, W - 56, gridH, 18);
    ctx.fill();
    ctx.strokeStyle = "rgba(255, 255, 255, 0.12)";
    ctx.lineWidth = 1.5;
    ctx.stroke();

    // Divider Line
    ctx.strokeStyle = "rgba(255, 255, 255, 0.08)";
    ctx.beginPath();
    ctx.moveTo(44, gridY + 75);
    ctx.lineTo(W - 44, gridY + 75);
    ctx.stroke();
  }

  // Stat text shadow for crisp legibility over custom photo
  ctx.shadowColor = "rgba(0, 0, 0, 0.95)";
  ctx.shadowBlur = 10;
  ctx.shadowOffsetX = 0;
  ctx.shadowOffsetY = 2;

  // Stat 1: Pace / Speed (Top Left)
  ctx.textAlign = "left";
  const col1X = 52;
  const col2X = W / 2 + 20;

  // Row 1
  ctx.fillStyle = "rgba(255, 255, 255, 0.75)";
  ctx.font = "700 12px -apple-system, BlinkMacSystemFont, 'Space Grotesk', Roboto, sans-serif";
  ctx.fillText(`⚡ ${paceOrSpeedLabel.toUpperCase()}`, col1X, gridY + 34);

  ctx.fillStyle = "#FFFFFF";
  ctx.font = "800 24px -apple-system, BlinkMacSystemFont, 'Space Grotesk', Roboto, sans-serif";
  ctx.fillText(paceOrSpeedVal, col1X, gridY + 62);

  // Stat 2: Steps (Top Right)
  ctx.fillStyle = "rgba(255, 255, 255, 0.75)";
  ctx.font = "700 12px -apple-system, BlinkMacSystemFont, 'Space Grotesk', Roboto, sans-serif";
  ctx.fillText("👟 STEPS", col2X, gridY + 34);

  ctx.fillStyle = "#FFFFFF";
  ctx.font = "800 24px -apple-system, BlinkMacSystemFont, 'Space Grotesk', Roboto, sans-serif";
  ctx.fillText(stepsVal, col2X, gridY + 62);

  // Row 2
  // Stat 3: Calories (Bottom Left)
  ctx.fillStyle = "rgba(255, 255, 255, 0.75)";
  ctx.font = "700 12px -apple-system, BlinkMacSystemFont, 'Space Grotesk', Roboto, sans-serif";
  ctx.fillText("🔥 CALORIES", col1X, gridY + 104);

  ctx.fillStyle = "#FFFFFF";
  ctx.font = "800 24px -apple-system, BlinkMacSystemFont, 'Space Grotesk', Roboto, sans-serif";
  ctx.fillText(calVal, col1X, gridY + 132);

  // Stat 4: Time (Bottom Right)
  ctx.fillStyle = "rgba(255, 255, 255, 0.75)";
  ctx.font = "700 12px -apple-system, BlinkMacSystemFont, 'Space Grotesk', Roboto, sans-serif";
  ctx.fillText("⏱️ TIME", col2X, gridY + 104);

  ctx.fillStyle = "#FFFFFF";
  ctx.font = "800 24px -apple-system, BlinkMacSystemFont, 'Space Grotesk', Roboto, sans-serif";
  ctx.fillText(timeFormatted, col2X, gridY + 132);

  // 4. GPS ROUTE POLYLINE (Floating cleanly with no black box when photo uploaded)
  const mapY = 380;
  const mapH = 340;
  const mapW = W - 56;
  const mapX = 28;

  // Only draw black card frame in OLED Black mode
  if (!theme.isPhoto) {
    ctx.fillStyle = "rgba(10, 14, 20, 0.75)";
    ctx.beginPath();
    ctx.roundRect(mapX, mapY, mapW, mapH, 20);
    ctx.fill();
    ctx.strokeStyle = "rgba(255, 255, 255, 0.14)";
    ctx.lineWidth = 1.5;
    ctx.stroke();

    ctx.textAlign = "left";
    ctx.fillStyle = "rgba(255, 255, 255, 0.8)";
    ctx.font = "700 11px -apple-system, BlinkMacSystemFont, 'Space Grotesk', Roboto, sans-serif";
    ctx.fillText("📍 LIVE GPS ROUTE MAP", mapX + 16, mapY + 26);
  }

  // Only draw the route if user ACTUALLY recorded live GPS movement points AND ran real distance
  const hasRealRun = Array.isArray(path) && path.length > 1 && distVal > 0.02;

  if (hasRealRun) {
    const validPath = path;
    const innerBoxW = mapW * 0.85;
    const innerBoxH = mapH * 0.75;
    const innerBoxX = mapX + (mapW - innerBoxW) / 2;
    const innerBoxY = mapY + (mapH - innerBoxH) / 2;

    const toMapXY = (p) => {
      const pLat = p.lat !== undefined ? p.lat : (Array.isArray(p) ? p[0] : (p.x !== undefined ? p.x : 0));
      const pLng = p.lng !== undefined ? p.lng : (Array.isArray(p) ? p[1] : (p.y !== undefined ? p.y : 0));
      
      const lats = validPath.map((pt) => pt.lat !== undefined ? pt.lat : (Array.isArray(pt) ? pt[0] : 0));
      const lngs = validPath.map((pt) => pt.lng !== undefined ? pt.lng : (Array.isArray(pt) ? pt[1] : 0));
      const minLat = Math.min(...lats), maxLat = Math.max(...lats);
      const minLng = Math.min(...lngs), maxLng = Math.max(...lngs);
      const latRange = maxLat - minLat || 0.0005;
      const lngRange = maxLng - minLng || 0.0005;
      const scale = (innerBoxW * 0.85) / Math.max(latRange, lngRange);
      const midLat = (minLat + maxLat) / 2, midLng = (minLng + maxLng) / 2;
      return [innerBoxX + innerBoxW / 2 + (pLng - midLng) * scale, innerBoxY + innerBoxH / 2 - (pLat - midLat) * scale];
    };

    // Glowing Outer Polyline floating directly over photo
    ctx.shadowColor = "rgba(37, 107, 253, 0.95)";
    ctx.shadowBlur = 18;
    ctx.strokeStyle = "rgba(37, 107, 253, 0.55)";
    ctx.lineWidth = 10;
    ctx.lineJoin = "round";
    ctx.lineCap = "round";
    ctx.beginPath();
    validPath.forEach((p, i) => {
      const [x, y] = toMapXY(p);
      if (i === 0) ctx.moveTo(x, y);
      else ctx.lineTo(x, y);
    });
    ctx.stroke();

    // Sharp Core Line
    ctx.strokeStyle = "#256BFD";
    ctx.lineWidth = 4.5;
    ctx.stroke();

    // Start Marker 🟢
    const [sX, sY] = toMapXY(validPath[0]);
    ctx.fillStyle = "#10B981";
    ctx.beginPath(); ctx.arc(sX, sY, 6, 0, Math.PI * 2); ctx.fill();
    ctx.strokeStyle = "#FFFFFF";
    ctx.lineWidth = 2;
    ctx.stroke();

    // Finish / Current Live Marker 🟡
    const [eX, eY] = toMapXY(validPath[validPath.length - 1]);
    ctx.fillStyle = "rgba(37, 107, 253, 0.35)";
    ctx.beginPath(); ctx.arc(eX, eY, 12, 0, Math.PI * 2); ctx.fill();
    ctx.fillStyle = "#256BFD";
    ctx.beginPath(); ctx.arc(eX, eY, 6.5, 0, Math.PI * 2); ctx.fill();
    ctx.strokeStyle = "#0B0E13";
    ctx.lineWidth = 1.5;
    ctx.stroke();
  }

  // 5. ATHLETE & LOCATION
  ctx.textAlign = "center";
  ctx.fillStyle = "#FFFFFF";
  ctx.font = "800 13px -apple-system, BlinkMacSystemFont, 'Space Grotesk', Roboto, sans-serif";
  ctx.fillText(athleteName, W / 2, 738);

  ctx.fillStyle = "rgba(255, 255, 255, 0.65)";
  ctx.font = "600 10.5px -apple-system, BlinkMacSystemFont, 'Space Grotesk', Roboto, sans-serif";
  ctx.fillText(location, W / 2, 754);

  // 6. FOOTER BRAND
  ctx.fillStyle = "#256BFD";
  ctx.font = "800 11px -apple-system, BlinkMacSystemFont, 'Space Grotesk', Roboto, sans-serif";
  ctx.letterSpacing = "2.5px";
  ctx.fillText("STOKE ⚡ ATHLETES CLUB", W / 2, 775);

  return canvas.toDataURL("image/png");
}

const RUNNER_WEIGHT_KG = 70;

