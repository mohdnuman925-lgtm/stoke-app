      {/* Large Action Buttons */}
      <div style={{ display: "flex", gap: 10, marginTop: 16 }}>
        <button
          onClick={onTriggerScan}
          style={{
            flex: 1.4,
            background: "linear-gradient(135deg, #256BFD 0%, #1D4ED8 100%)",
            border: "none",
            borderRadius: 14,
            padding: "13px 14px",
            color: "#FFFFFF",
            fontSize: 14,
            fontWeight: 800,
            cursor: "pointer",
            display: "flex",
            alignItems: "center",
            justifyContent: "center",
            gap: 8,
            boxShadow: "0 6px 20px rgba(37, 107, 253, 0.45)",
            transition: "all 0.15s ease"
          }}
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.4" strokeLinecap="round" strokeLinejoin="round">
            <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z" />
            <circle cx="12" cy="13" r="4" />
          </svg>
          <span>Scan Meal</span>
        </button>

        <button
          onClick={onTriggerGallery}
          style={{
            flex: 1,
            background: "rgba(255, 255, 255, 0.07)",
            border: "1px solid rgba(255, 255, 255, 0.14)",
            borderRadius: 14,
            padding: "13px 12px",
            color: "rgba(255,255,255,0.9)",
            fontSize: 13,
            fontWeight: 700,
            cursor: "pointer",
            display: "flex",
            alignItems: "center",
            justifyContent: "center",
            gap: 6
          }}
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
            <circle cx="8.5" cy="8.5" r="1.5"/>
            <polyline points="21 15 16 10 5 21"/>
          </svg>
          <span>Gallery</span>
        </button>
      </div>
    </div>
  );
}

/* ============================================================
   CONFIRM DETECTED MEAL MODAL
   ============================================================ */
function ScanMealConfirmModal({ isOpen, onClose, photoPreview, isScanning, detectedItems = [], onSaveMeal, mealSlots = [] }) {
  if (!isOpen) return null;

  const defaultSlot = (() => {
    const hr = new Date().getHours();
    if (hr < 11) return "breakfast";
    if (hr < 16) return "lunch";
    if (hr < 21) return "dinner";
    return "snack";
  })();

  const [selectedSlot, setSelectedSlot] = useState(defaultSlot);
  const [items, setItems] = useState(() => {
    return (detectedItems || []).map((it) => ({
      ...it,
      baseGrams: it.grams || 100,
      baseCalories: it.calories || 0,
      baseProtein: it.protein || 0,
      baseCarbs: it.carbs || 0,
      baseFat: it.fat || 0,
      baseFiber: it.fiber || 0,
    }));
  });

  useEffect(() => {
    if (detectedItems && detectedItems.length > 0) {
      setItems(detectedItems.map((it) => ({
        ...it,
        baseGrams: it.grams || 100,
        baseCalories: it.calories || 0,
        baseProtein: it.protein || 0,
        baseCarbs: it.carbs || 0,
        baseFat: it.fat || 0,
        baseFiber: it.fiber || 0,
      })));
    } else {
      setItems([]);
    }
  }, [detectedItems]);

  const totalCals = items.reduce((s, it) => s + (Number(it.calories) || 0), 0);
  const totalP = items.reduce((s, it) => s + (Number(it.protein) || 0), 0);
  const totalC = items.reduce((s, it) => s + (Number(it.carbs) || 0), 0);
  const totalF = items.reduce((s, it) => s + (Number(it.fat) || 0), 0);
  const totalFib = items.reduce((s, it) => s + (Number(it.fiber) || 0), 0);

  function setItemGrams(idx, rawVal) {
    setItems((prev) =>
      prev.map((it, i) => {
        if (i !== idx) return it;
        const baseG = it.baseGrams || it.grams || 100;
        const baseCal = it.baseCalories !== undefined ? it.baseCalories : (it.calories || 0);
        const baseP = it.baseProtein !== undefined ? it.baseProtein : (it.protein || 0);
        const baseC = it.baseCarbs !== undefined ? it.baseCarbs : (it.carbs || 0);
        const baseF = it.baseFat !== undefined ? it.baseFat : (it.fat || 0);
        const baseFib = it.baseFiber !== undefined ? it.baseFiber : (it.fiber || 0);

        if (rawVal === "" || rawVal === null) {
          return {
            ...it,
            grams: "",
            calories: 0,
            protein: 0,
            carbs: 0,
            fat: 0,
            fiber: 0,
          };
        }

        const validGrams = Math.max(1, Math.min(3000, Number(rawVal) || 0));
        const ratio = validGrams / (baseG || 1);
        return {
          ...it,
          grams: validGrams,
          calories: Math.round(baseCal * ratio),
          protein: Math.round(baseP * ratio * 10) / 10,
          carbs: Math.round(baseC * ratio * 10) / 10,
          fat: Math.round(baseF * ratio * 10) / 10,
          fiber: Math.round(baseFib * ratio * 10) / 10,
        };
      })
    );
  }

  function adjustGrams(idx, delta) {
    const it = items[idx];
    if (!it) return;
    const currentG = Number(it.grams) || 100;
    const newG = Math.max(10, currentG + delta);
    setItemGrams(idx, newG);
  }

  function removeItem(idx) {
    setItems((prev) => prev.filter((_, i) => i !== idx));
  }

  function handleConfirm() {
    if (items.length === 0) return;
    const cleaned = items.map((it) => ({
      ...it,
      grams: Math.max(1, Number(it.grams) || it.baseGrams || 100),
    }));
    onSaveMeal(selectedSlot, cleaned);
  }

  return (
    <div style={{ position: "fixed", inset: 0, zIndex: 10000, background: "rgba(0,0,0,0.85)", backdropFilter: "blur(20px)", WebkitBackdropFilter: "blur(20px)", display: "flex", alignItems: "center", justifyContent: "center", padding: 16 }}>
      <div style={{ width: "100%", maxWidth: 440, background: "#111622", border: "1px solid rgba(255,255,255,0.12)", borderRadius: 24, padding: "20px 20px", maxHeight: "90vh", overflowY: "auto", boxShadow: "0 24px 60px rgba(0,0,0,0.9)" }}>
        {/* Top Header */}
        <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 14 }}>
          <div>
            <h3 style={{ margin: 0, fontSize: 18, fontWeight: 800, color: "#FFFFFF" }}>Review Scanned Meal</h3>
            <p style={{ margin: "2px 0 0", fontSize: 11, color: "rgba(255,255,255,0.5)" }}>Confirm or adjust portions before saving</p>
          </div>
          <button onClick={onClose} style={{ width: 32, height: 32, borderRadius: "50%", background: "rgba(255,255,255,0.08)", border: "none", color: "#FFF", cursor: "pointer", fontSize: 16, display: "flex", alignItems: "center", justifyContent: "center" }}>✕</button>
        </div>

        {/* Photo Preview Thumbnail & Status */}
        {photoPreview && (
          <div style={{ position: "relative", width: "100%", height: 140, borderRadius: 16, overflow: "hidden", marginBottom: 14, border: "1px solid rgba(255,255,255,0.12)" }}>
            <img src={photoPreview} alt="Scanned Food" style={{ width: "100%", height: "100%", objectFit: "cover" }} />
            {isScanning && (
              <div style={{ position: "absolute", inset: 0, background: "rgba(10,14,24,0.75)", display: "flex", flexDirection: "column", alignItems: "center", justifyContent: "center", gap: 8 }}>
                <div style={{ width: 28, height: 28, border: "3px solid #256BFD", borderTopColor: "transparent", borderRadius: "50%", animation: "spin 0.8s linear infinite" }} />
                <span style={{ fontSize: 12, fontWeight: 700, color: "#3DDCFF" }}>Detecting food components...</span>
              </div>
            )}
          </div>
        )}

        {/* Meal Slot Picker */}
        <div style={{ marginBottom: 14 }}>
          <label style={{ fontSize: 11, fontWeight: 700, color: "rgba(255,255,255,0.5)", textTransform: "uppercase", display: "block", marginBottom: 6 }}>
            Target Meal Slot
          </label>
          <div style={{ display: "grid", gridTemplateColumns: "repeat(4, 1fr)", gap: 6 }}>
            {["breakfast", "lunch", "dinner", "snack"].map((s) => {
              const active = selectedSlot === s;
              return (
                <button
                  key={s}
                  onClick={() => setSelectedSlot(s)}
                  style={{
                    background: active ? "#256BFD" : "rgba(255,255,255,0.05)",
                    border: `1px solid ${active ? "#256BFD" : "rgba(255,255,255,0.1)"}`,
                    color: active ? "#FFFFFF" : "rgba(255,255,255,0.7)",
                    borderRadius: 10,
                    padding: "8px 0",
                    fontSize: 12,
                    fontWeight: 700,
                    textTransform: "capitalize",
                    cursor: "pointer"
                  }}
                >
                  {s}
                </button>
              );
            })}
          </div>
        </div>

        {/* Detected Items List */}
        <div style={{ marginBottom: 16 }}>
          <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 8 }}>
            <span style={{ fontSize: 11, fontWeight: 700, color: "rgba(255,255,255,0.5)", textTransform: "uppercase" }}>
              Identified Food Items ({items.length})
            </span>
          </div>

          <div style={{ display: "flex", flexDirection: "column", gap: 10 }}>
            {items.map((it, idx) => (
              <div key={idx} style={{ background: "rgba(255,255,255,0.04)", border: "1px solid rgba(255,255,255,0.08)", borderRadius: 14, padding: "12px 14px" }}>
                <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 6 }}>
                  <div style={{ fontWeight: 800, fontSize: 14, color: "#FFFFFF" }}>{it.name}</div>
                  <button onClick={() => removeItem(idx)} style={{ background: "transparent", border: "none", color: "#EF4444", fontSize: 12, cursor: "pointer", fontWeight: 700 }}>Remove</button>
                </div>

                <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", gap: 10 }}>
                  {/* Grams Adjustment with Direct Typing */}
                  <div style={{ display: "flex", alignItems: "center", gap: 4, background: "rgba(255,255,255,0.06)", border: "1px solid rgba(255,255,255,0.14)", borderRadius: 10, padding: "3px 6px" }}>
                    <button
                      type="button"
                      onClick={() => adjustGrams(idx, -25)}
                      style={{ background: "none", border: "none", color: "#FFF", fontSize: 16, cursor: "pointer", fontWeight: 800, padding: "0 4px", lineHeight: 1 }}
                      title="Minus 25g"
                    >−</button>

                    <div style={{ display: "flex", alignItems: "center", background: "rgba(0,0,0,0.5)", borderRadius: 7, padding: "2px 5px", border: "1px solid rgba(255,255,255,0.12)" }}>
                      <input
                        type="number"
                        min="1"
                        max="3000"
                        value={it.grams === "" ? "" : (it.grams ?? 100)}
                        onChange={(e) => setItemGrams(idx, e.target.value)}
                        placeholder="100"
                        style={{
                          width: 48,
                          background: "transparent",
                          border: "none",
                          color: "#FFFFFF",
                          fontSize: 13,
                          fontWeight: 800,
                          textAlign: "right",
                          outline: "none",
                          fontFamily: "'Space Grotesk', ui-sans-serif, system-ui, sans-serif",
                          padding: 0
                        }}
                      />
                      <span style={{ fontSize: 11.5, fontWeight: 700, color: "rgba(255,255,255,0.55)", marginLeft: 2, marginRight: 2 }}>g</span>
                    </div>

                    <button
                      type="button"
                      onClick={() => adjustGrams(idx, 25)}
                      style={{ background: "none", border: "none", color: "#FFF", fontSize: 16, cursor: "pointer", fontWeight: 800, padding: "0 4px", lineHeight: 1 }}
                      title="Plus 25g"
                    >+</button>
                  </div>

                  {/* Macro Badges */}
                  <div style={{ display: "flex", gap: 6, fontSize: 11, fontWeight: 700, flexWrap: "wrap", justifyContent: "flex-end" }}>
                    <span style={{ color: "#FFFFFF" }}>{it.calories} kcal</span>
                    <span style={{ color: "#22C55E" }}>{it.protein}g P</span>
                    <span style={{ color: "#3DDCFF" }}>{it.carbs}g C</span>
                    <span style={{ color: "#F59E0B" }}>{it.fat}g F</span>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>

        {/* Macro Totals Banner */}
        <div style={{ background: "rgba(37,107,253,0.1)", border: "1px solid rgba(37,107,253,0.3)", borderRadius: 16, padding: "12px 16px", marginBottom: 16 }}>
          <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 6 }}>
            <span style={{ fontSize: 12, color: "rgba(255,255,255,0.7)", fontWeight: 600 }}>Estimated Total</span>
            <span style={{ fontSize: 17, fontWeight: 900, color: "#FFFFFF" }}>{totalCals} kcal</span>
          </div>
          <div style={{ display: "flex", justifyContent: "space-between", fontSize: 11.5, fontWeight: 700 }}>
            <span style={{ color: "#22C55E" }}>Protein: {Math.round(totalP)}g</span>
            <span style={{ color: "#3DDCFF" }}>Carbs: {Math.round(totalC)}g</span>
            <span style={{ color: "#F59E0B" }}>Fat: {Math.round(totalF)}g</span>
            <span style={{ color: "rgba(255,255,255,0.6)" }}>Fibre: {Math.round(totalFib)}g</span>
          </div>
        </div>

        {/* Buttons */}
        <div style={{ display: "flex", gap: 10 }}>
          <button onClick={onClose} style={{ flex: 1, background: "rgba(255,255,255,0.08)", border: "none", borderRadius: 14, padding: "13px 0", color: "#FFFFFF", fontSize: 13, fontWeight: 700, cursor: "pointer" }}>
            Cancel
          </button>
          <button
            onClick={handleConfirm}
            style={{
              flex: 2,
              background: "linear-gradient(135deg, #22C55E 0%, #16A34A 100%)",
              border: "none",
              borderRadius: 14,
              padding: "13px 0",
              color: "#FFFFFF",
              fontSize: 14,
              fontWeight: 800,
              cursor: "pointer",
              boxShadow: "0 6px 20px rgba(34,197,94,0.4)"
            }}
          >
            Save to Nutrition ⚡
          </button>
        </div>
      </div>
    </div>
  );
}

/* ============================================================
   4. VOICE COACH CARD & MODAL (Strictly named "Coach")
   ============================================================ */
function HomeCoachCard({
  onOpenCoach,
  onOpenVoice,
  athleteName = "Athlete",
  remCal = 0,
  remP = 0,
  coachTip = "",
  onQuickAsk,
}) {
  const [localInput, setLocalInput] = useState("");

  const handleSend = (e) => {
    if (e) e.preventDefault();
    if (!localInput.trim()) {
      onOpenCoach();
      return;
    }
    onQuickAsk(localInput.trim());
    setLocalInput("");
  };

  const chips = [
    { label: "🥗 What to eat?", q: "What should I eat with my remaining macros?" },
    { label: "🏋️ Today's workout", q: "Give me form cues and tips for today's workout" },
    { label: "⚡ Recovery advice", q: "How can I optimize muscle recovery and soreness?" },
    { label: "🥛 Hit protein goal", q: "High-protein quick snack recommendations" },
  ];

  return (
    <div
      style={{
        background: "linear-gradient(145deg, rgba(37, 107, 253, 0.12) 0%, rgba(18, 24, 38, 0.95) 100%)",
        backdropFilter: "blur(20px)",
        WebkitBackdropFilter: "blur(20px)",
        border: "1px solid rgba(37, 107, 253, 0.35)",
        borderRadius: 22,
        padding: "16px 18px",
        marginBottom: 14,
        boxShadow: "0 10px 30px rgba(0,0,0,0.5)",
        position: "relative",
        overflow: "hidden",
      }}
    >
      {/* Background ambient glow */}
      <div
        style={{
          position: "absolute",
          top: -20,
          right: -20,
          width: 120,
          height: 120,
          borderRadius: "50%",
          background: "radial-gradient(circle, rgba(37, 107, 253, 0.25) 0%, transparent 70%)",
          pointerEvents: "none",
        }}
      />

      {/* Header with Title and BOTH Voice Coach & Chat AI buttons */}
      <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 12, flexWrap: "wrap", gap: 8 }}>
        <div style={{ display: "flex", alignItems: "center", gap: 10 }}>
          <div
            style={{
              width: 40,
              height: 40,
              borderRadius: 13,
              background: "linear-gradient(135deg, #256BFD 0%, #1D4ED8 100%)",
              display: "flex",
              alignItems: "center",
              justifyContent: "center",
              boxShadow: "0 0 16px rgba(37, 107, 253, 0.5)",
              flexShrink: 0,
            }}
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" strokeWidth="2.4" strokeLinecap="round" strokeLinejoin="round">
              <path d="M4.5 5.5h15v10.5H10l-3.5 3.5v-3.5H4.5z" />
            </svg>
          </div>
          <div>
            <div style={{ display: "flex", alignItems: "center", gap: 6 }}>
              <span style={{ fontSize: 14.5, fontWeight: 900, color: "#FFFFFF", letterSpacing: 0.3 }}>Coach</span>
              <span style={{ display: "inline-flex", alignItems: "center", gap: 4, background: "rgba(34, 197, 94, 0.15)", border: "1px solid rgba(34, 197, 94, 0.35)", padding: "2px 7px", borderRadius: 999, fontSize: 9.5, fontWeight: 800, color: "#22C55E" }}>
                <span style={{ width: 6, height: 6, borderRadius: "50%", background: "#22C55E", display: "inline-block" }} />
                ACTIVE
              </span>
            </div>
            <div style={{ fontSize: 11, color: "rgba(255,255,255,0.6)", marginTop: 1 }}>
              Personalized nutritionist & training architect
            </div>
          </div>
        </div>

        {/* Action Buttons: Voice Coach & Chat */}
        <div style={{ display: "flex", alignItems: "center", gap: 6 }}>
          <button
            type="button"
            onClick={onOpenVoice}
            title="Talk to Voice Coach"
            style={{
              background: "linear-gradient(135deg, rgba(34, 197, 94, 0.2) 0%, rgba(16, 185, 129, 0.3) 100%)",
              border: "1px solid rgba(34, 197, 94, 0.45)",
              borderRadius: 11,
              padding: "6px 11px",
              color: "#4ADE80",
              fontSize: 11.5,
              fontWeight: 800,
              cursor: "pointer",
              display: "flex",
              alignItems: "center",
              gap: 5,
              boxShadow: "0 0 12px rgba(34, 197, 94, 0.2)",
            }}
          >
            <span>🎙️</span>
            <span>Voice Coach</span>
          </button>

          <button
            type="button"
            onClick={onOpenCoach}
            title="Chat with Coach"
            style={{
              background: "rgba(37, 107, 253, 0.22)",
              border: "1px solid rgba(37, 107, 253, 0.45)",
              borderRadius: 11,
              padding: "6px 11px",
              color: "#60A5FA",
              fontSize: 11.5,
              fontWeight: 800,
              cursor: "pointer",
              display: "flex",
              alignItems: "center",
              gap: 4,
            }}
          >
            <span>Chat</span>
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round">
              <polyline points="9 18 15 12 9 6" />
            </svg>
          </button>
        </div>
      </div>

      {/* Dynamic Status / Coach Insight Message */}
      <div
        onClick={onOpenCoach}
        style={{
          cursor: "pointer",
          background: "rgba(0, 0, 0, 0.3)",
          border: "1px solid rgba(255, 255, 255, 0.08)",
          borderRadius: 14,
          padding: "10px 14px",
          marginBottom: 11,
          fontSize: 12.5,
          lineHeight: 1.45,
          color: "rgba(255, 255, 255, 0.9)",
        }}
      >
        💡 <strong style={{ color: "#60A5FA" }}>Coach Advice:</strong> {coachTip || `You have ${remCal} kcal and ${remP}g protein remaining today. Ask Coach to optimize your meals or workout!`}
      </div>

      {/* Quick Prompts Chips */}
      <div
        style={{
          display: "flex",
          gap: 6,
          overflowX: "auto",
          paddingBottom: 4,
          marginBottom: 11,
          scrollbarWidth: "none",
        }}
      >
        {chips.map((c, i) => (
          <button
            key={i}
            onClick={() => onQuickAsk(c.q)}
            style={{
              whiteSpace: "nowrap",
              background: "rgba(255, 255, 255, 0.05)",
              border: "1px solid rgba(255, 255, 255, 0.12)",
              borderRadius: 20,
              padding: "5px 11px",
              fontSize: 11,
              fontWeight: 700,
              color: "#E2E8F0",
              cursor: "pointer",
              transition: "all 0.15s ease",
            }}
          >
            {c.label}
          </button>
        ))}
      </div>

      {/* Interactive Input Form */}
      <form
        onSubmit={handleSend}
        style={{
          display: "flex",
          alignItems: "center",
          gap: 7,
          background: "rgba(10, 14, 23, 0.85)",
          border: "1px solid rgba(37, 107, 253, 0.4)",
          borderRadius: 13,
          padding: "5px 7px 5px 12px",
        }}
      >
        <input
          type="text"
          value={localInput}
          onChange={(e) => setLocalInput(e.target.value)}
          placeholder={`Ask Coach anything, ${athleteName}...`}
          style={{
            flex: 1,
            background: "transparent",
            border: "none",
            color: "#FFFFFF",
            fontSize: 12.5,
            outline: "none",
          }}
        />

        <button
          type="button"
          onClick={onOpenVoice}
          title="Voice Coach"
          style={{
            background: "linear-gradient(135deg, rgba(34, 197, 94, 0.2) 0%, rgba(16, 185, 129, 0.3) 100%)",
            border: "1px solid rgba(34, 197, 94, 0.4)",
            borderRadius: 9,
            width: 30,
            height: 30,
            display: "flex",
            alignItems: "center",
            justifyContent: "center",
            color: "#4ADE80",
            cursor: "pointer",
            flexShrink: 0,
          }}
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.4" strokeLinecap="round" strokeLinejoin="round">
            <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/>
            <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
            <line x1="12" y1="19" x2="12" y2="23"/>
            <line x1="8" y1="23" x2="16" y2="23"/>
          </svg>
        </button>

        <button
          type="submit"
          style={{
            background: "linear-gradient(135deg, #256BFD 0%, #1D4ED8 100%)",
            border: "none",
            borderRadius: 9,
            width: 30,
            height: 30,
            display: "flex",
            alignItems: "center",
            justifyContent: "center",
            color: "#FFFFFF",
            cursor: "pointer",
            flexShrink: 0,
          }}
        >
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round">
            <line x1="22" y1="2" x2="11" y2="13"/>
            <polygon points="22 2 15 22 11 13 2 9 22 2"/>
          </svg>
        </button>
      </form>
    </div>
  );
}

function VoiceCoachCard({ onOpenVoiceCoach }) {
  return (
    <div
      onClick={onOpenVoiceCoach}
      style={{
        cursor: "pointer",
        background: "linear-gradient(135deg, rgba(37, 107, 253, 0.12) 0%, rgba(15, 20, 32, 0.9) 100%)",
        backdropFilter: "blur(16px)",
        WebkitBackdropFilter: "blur(16px)",
        border: "1px solid rgba(37, 107, 253, 0.35)",
        borderRadius: 20,
        padding: "16px 18px",
        marginBottom: 14,
        display: "flex",
        alignItems: "center",
        justifyContent: "space-between",
        boxShadow: "0 8px 24px rgba(0,0,0,0.5)",
        position: "relative",
        overflow: "hidden"
      }}
    >
      <div style={{ display: "flex", alignItems: "center", gap: 14 }}>
        <div
          style={{
            width: 44,
            height: 44,
            borderRadius: 14,
            background: "linear-gradient(135deg, #256BFD 0%, #1D4ED8 100%)",
            display: "flex",
            alignItems: "center",
            justifyContent: "center",
            boxShadow: "0 0 16px rgba(37, 107, 253, 0.5)",
            flexShrink: 0
          }}
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" strokeWidth="2.4" strokeLinecap="round" strokeLinejoin="round">
            <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/>
            <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
            <line x1="12" y1="19" x2="12" y2="23"/>
            <line x1="8" y1="23" x2="16" y2="23"/>
          </svg>
        </div>

        <div>
          <div style={{ display: "flex", alignItems: "center", gap: 6 }}>
            <span style={{ fontSize: 14, fontWeight: 900, color: "#FFFFFF" }}>Talk to Coach</span>
            <span style={{ width: 7, height: 7, borderRadius: "50%", background: "#22C55E", display: "inline-block" }} />
          </div>
          <div style={{ fontSize: 11.5, color: "rgba(255,255,255,0.65)", marginTop: 2 }}>
            Live voice answers on workouts, runs, macros & recovery
          </div>
        </div>
      </div>

      <div style={{ background: "rgba(37, 107, 253, 0.2)", border: "1px solid rgba(37, 107, 253, 0.4)", borderRadius: 10, padding: "7px 12px", color: "#3DDCFF", fontSize: 12, fontWeight: 800, whiteSpace: "nowrap" }}>
        🎙️ Speak
      </div>
    </div>
  );
}

function VoiceCoachModal({ isOpen, onClose, profileName, kcalRemaining, remainingP, water, goals, workoutDay, completedCount, totalExercises, lastRunDist, scoreData }) {
  if (!isOpen) return null;

  const [isListening, setIsListening] = useState(false);
  const [transcript, setTranscript] = useState("");
  const [coachResponse, setCoachResponse] = useState("Hello! I'm your Coach. Tap the microphone and ask me anything about today's workout, runs, nutrition, or your fitness progress!");
  const [isSpeaking, setIsSpeaking] = useState(false);
  const recognitionRef = useRef(null);

  // Initialize Speech Recognition
  useEffect(() => {
    const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
    if (SpeechRecognition) {
      const recognition = new SpeechRecognition();
      recognition.continuous = false;
      recognition.interimResults = true;
      recognition.lang = "en-US";

      recognition.onstart = () => {
        setIsListening(true);
      };

      recognition.onresult = (e) => {
        let current = "";
        for (let i = e.resultIndex; i < e.results.length; i++) {
          current += e.results[i][0].transcript;
        }
        setTranscript(current);
        if (e.results[e.results.length - 1].isFinal) {
          handleUserQuery(current);
        }
      };

      recognition.onerror = () => {
        setIsListening(false);
      };

      recognition.onend = () => {
        setIsListening(false);
      };

      recognitionRef.current = recognition;
    }

    return () => {
      if (recognitionRef.current) recognitionRef.current.abort();
      if (window.speechSynthesis) window.speechSynthesis.cancel();
    };
  }, []);

  function handleUserQuery(query) {
    const q = (query || "").toLowerCase();
    let reply = "";

    if (q.includes("workout") || q.includes("lift") || q.includes("exercise")) {
      if (workoutDay?.rest) {
        reply = "Today is a scheduled rest day! Focus on active recovery, light mobility, and adequate hydration.";
      } else {
        reply = `Today's session is ${workoutDay?.label || "your workout"}. You have completed ${completedCount} out of ${totalExercises} exercises so far. Stay explosive and log every set!`;
      }
    } else if (q.includes("nutrition") || q.includes("protein") || q.includes("eat") || q.includes("food") || q.includes("calorie")) {
      if (remainingP > 25) {
        reply = `You still need ${remainingP} grams of protein today to hit your muscle recovery target. Try Greek yogurt, whey isolate, chicken breast, or tofu! You also have ${kcalRemaining} calories remaining.`;
      } else {
        reply = `Your protein intake is in a great spot today! You have ${kcalRemaining} calories remaining. Focus on clean carbs and micronutrients for sustained energy.`;
      }
    } else if (q.includes("run") || q.includes("running") || q.includes("pace") || q.includes("gps")) {
      reply = `Your latest recorded run was ${lastRunDist} km. Consistent aerobic volume will boost your VO2 max and cardio score. Remember to warm up your calves and maintain a steady cadence!`;
    } else if (q.includes("water") || q.includes("hydrate") || q.includes("drink")) {
      reply = `You have logged ${water.toFixed(1)} liters of water today against your ${goals.water || 2.6} liter target. Drinking another 500ml right now will keep your cellular hydration optimal!`;
    } else if (q.includes("score") || q.includes("fitness score") || q.includes("level")) {
      reply = `Your current Fitness Score is ${scoreData?.total || 78} out of 100. ${scoreData?.tip || "Keep up your training consistency to unlock higher tiers!"}`;
    } else {
      reply = `Got it, ${profileName || "athlete"}! You have ${completedCount}/${totalExercises} exercises logged today, ${kcalRemaining} kcal left, and ${water.toFixed(1)}L water. Keep up the high discipline!`;
    }

    setCoachResponse(reply);
    speakResponse(reply);
  }

  function speakResponse(text) {
    if (typeof window !== "undefined" && window.speechSynthesis) {
      window.speechSynthesis.cancel();
      const utterance = new SpeechSynthesisUtterance(text);
      utterance.rate = 1.0;
      utterance.pitch = 1.0;
      utterance.onstart = () => setIsSpeaking(true);
      utterance.onend = () => setIsSpeaking(false);
      utterance.onerror = () => setIsSpeaking(false);
      window.speechSynthesis.speak(utterance);
    }
  }

  function startListening() {
    if (window.speechSynthesis) window.speechSynthesis.cancel();
    setIsSpeaking(false);
    setTranscript("");
    if (recognitionRef.current) {
      try {
        recognitionRef.current.start();
      } catch (e) {
        // Recognition might already be running
      }
    } else {
      // Fallback if browser doesn't support Web Speech API
      const fallbackPrompt = prompt("Speech recognition not supported in this browser. Enter your question:");
      if (fallbackPrompt) {
        setTranscript(fallbackPrompt);
        handleUserQuery(fallbackPrompt);
      }
    }
  }

  function stopListening() {
    if (recognitionRef.current) recognitionRef.current.stop();
    setIsListening(false);
  }

  return (
    <div style={{ position: "fixed", inset: 0, zIndex: 10000, background: "rgba(0,0,0,0.85)", backdropFilter: "blur(22px)", WebkitBackdropFilter: "blur(22px)", display: "flex", alignItems: "center", justifyContent: "center", padding: 18 }}>
      <div style={{ width: "100%", maxWidth: 420, background: "#101624", border: "1px solid rgba(37,107,253,0.35)", borderRadius: 28, padding: "26px 22px", textAlign: "center", boxShadow: "0 24px 60px rgba(0,0,0,0.9)", position: "relative" }}>
        {/* Header */}
        <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 20 }}>
          <div style={{ display: "flex", alignItems: "center", gap: 8 }}>
            <span style={{ width: 8, height: 8, borderRadius: "50%", background: "#22C55E", boxShadow: "0 0 10px #22C55E" }} />
            <h3 style={{ margin: 0, fontSize: 18, fontWeight: 900, color: "#FFFFFF", letterSpacing: -0.3 }}>Coach</h3>
          </div>
          <button onClick={onClose} style={{ width: 32, height: 32, borderRadius: "50%", background: "rgba(255,255,255,0.08)", border: "none", color: "#FFF", cursor: "pointer", fontSize: 16, display: "flex", alignItems: "center", justifyContent: "center" }}>✕</button>
        </div>

        {/* Big Pulsing Mic Circle */}
        <div style={{ margin: "20px 0 24px" }}>
          <div
            onClick={isListening ? stopListening : startListening}
            style={{
              width: 90,
              height: 90,
              borderRadius: "50%",
              background: isListening ? "radial-gradient(circle, #EF4444 0%, #B91C1C 100%)" : "radial-gradient(circle, #256BFD 0%, #1D4ED8 100%)",
              margin: "0 auto",
              display: "flex",
              alignItems: "center",
              justifyContent: "center",
              cursor: "pointer",
              boxShadow: isListening ? "0 0 35px rgba(239,68,68,0.7)" : "0 0 35px rgba(37,107,253,0.6)",
              animation: isListening ? "stokeMicPulse 1.5s infinite" : "none",
              transition: "all 0.2s ease"
            }}
          >
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" strokeWidth="2.3" strokeLinecap="round" strokeLinejoin="round">
              <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/>
              <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
              <line x1="12" y1="19" x2="12" y2="23"/>
              <line x1="8" y1="23" x2="16" y2="23"/>
            </svg>
          </div>
          <div style={{ fontSize: 12, fontWeight: 700, color: isListening ? "#EF4444" : "#3DDCFF", marginTop: 12 }}>
            {isListening ? "Listening... Speak clearly" : "Tap microphone to talk"}
          </div>
        </div>

        {/* Live User Transcript */}
        {transcript && (
          <div style={{ background: "rgba(255,255,255,0.06)", borderRadius: 14, padding: "10px 14px", marginBottom: 14, textAlign: "left" }}>
            <span style={{ fontSize: 10, color: "rgba(255,255,255,0.45)", fontWeight: 700, textTransform: "uppercase" }}>You said:</span>
            <p style={{ margin: "2px 0 0", fontSize: 13, color: "#FFFFFF", fontStyle: "italic" }}>"{transcript}"</p>
          </div>
        )}

        {/* Coach Voice Response Bubble */}
        <div style={{ background: "rgba(37,107,253,0.1)", border: "1px solid rgba(37,107,253,0.25)", borderRadius: 16, padding: "14px 16px", marginBottom: 18, textAlign: "left" }}>
          <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 4 }}>
            <span style={{ fontSize: 11, fontWeight: 800, color: "#3B82F6", textTransform: "uppercase" }}>Coach Response</span>
            {isSpeaking && <span style={{ fontSize: 10, color: "#22C55E", fontWeight: 700 }}>Speaking 🔊</span>}
          </div>
          <p style={{ margin: 0, fontSize: 13, lineHeight: 1.5, color: "#FFFFFF" }}>{coachResponse}</p>
        </div>

        {/* Suggestion Chips */}
        <div style={{ display: "flex", flexWrap: "wrap", gap: 6, marginBottom: 18, justifyContent: "center" }}>
          {["What is my workout today?", "How is my nutrition today?", "How was my last run?", "How do I boost my score?"].map((chip) => (
            <button
              key={chip}
              onClick={() => {
                setTranscript(chip);
                handleUserQuery(chip);
              }}
              style={{
                background: "rgba(255,255,255,0.05)",
                border: "1px solid rgba(255,255,255,0.1)",
                borderRadius: 999,
                padding: "6px 10px",
                color: "rgba(255,255,255,0.8)",
                fontSize: 11,
                fontWeight: 600,
                cursor: "pointer"
              }}
            >
              {chip}
            </button>
          ))}
        </div>

        {/* Controls */}
        <div style={{ display: "flex", gap: 10 }}>
          <button
            onClick={isListening ? stopListening : startListening}
            style={{
              flex: 1,
              background: isListening ? "#EF4444" : "#256BFD",
              border: "none",
              borderRadius: 14,
              padding: "13px 0",
              color: "#FFFFFF",
              fontSize: 14,
              fontWeight: 800,
              cursor: "pointer"
            }}
          >
            {isListening ? "Stop Listening" : "Start Listening"}
          </button>
          <button onClick={onClose} style={{ width: 80, background: "rgba(255,255,255,0.08)", border: "none", borderRadius: 14, padding: "13px 0", color: "#FFFFFF", fontSize: 14, fontWeight: 700, cursor: "pointer" }}>
            Close
          </button>
        </div>
      </div>
    </div>
  );
}

/* ============================================================
   5. ACHIEVEMENT ROOM (20 Real Milestones from User History)
   ============================================================ */
const ACHIEVEMENTS_LIST = [
  { id: "first_workout", cat: "workout", title: "Iron Rookie", req: "Complete 1st workout", target: 1, icon: "🏋️" },
  { id: "workout_3", cat: "workout", title: "Triple Threat", req: "Complete 3 workouts", target: 3, icon: "🔥" },
  { id: "workout_5", cat: "workout", title: "Full Week Warrior", req: "Complete 5 workouts", target: 5, icon: "⚡" },
  { id: "heavy_lifter", cat: "workout", title: "Heavy Duty", req: "Log 10 sets in a session", target: 10, icon: "🛡️" },
  { id: "first_run", cat: "running", title: "First Stride", req: "Log 1st outdoor run", target: 1, icon: "👟" },
  { id: "run_5k", cat: "running", title: "5K Crusher", req: "Complete 5.0 km run", target: 5, icon: "🏃" },
  { id: "run_10k", cat: "running", title: "10K Pioneer", req: "Complete 10.0 km run", target: 10, icon: "🏅" },
  { id: "run_25km", cat: "running", title: "Distance Builder", req: "25 km total running", target: 25, icon: "⛰️" },
  { id: "run_50km", cat: "running", title: "Half Marathon Club", req: "50 km total running", target: 50, icon: "🌟" },
  { id: "run_100km", cat: "running", title: "Century Runner", req: "100 km total running", target: 100, icon: "👑" },
  { id: "clean_fuel", cat: "nutrition", title: "Clean Fuel", req: "Log 1st meal", target: 1, icon: "🥗" },
  { id: "macro_discipline", cat: "nutrition", title: "Macro Discipline", req: "Log 3 meals in a day", target: 3, icon: "🍱" },
  { id: "protein_beast", cat: "nutrition", title: "Protein Beast", req: "Hit protein goal", target: 1, icon: "🥩" },
  { id: "hydration_hero", cat: "nutrition", title: "Hydration Hero", req: "Drink 2.5L water", target: 2.5, icon: "💧" },
  { id: "water_champion", cat: "nutrition", title: "Water Champion", req: "Drink 3.5L water", target: 3.5, icon: "🌊" },
  { id: "streak_3", cat: "streaks", title: "3-Day Momentum", req: "3-day logging streak", target: 3, icon: "⚡" },
  { id: "streak_7", cat: "streaks", title: "7-Day Discipline", req: "7-day logging streak", target: 7, icon: "🏆" },
  { id: "level_5", cat: "streaks", title: "Level 5 Master", req: "Reach Level 5", target: 5, icon: "💎" },
  { id: "level_8", cat: "streaks", title: "Level 8 Elite", req: "Reach Level 8", target: 8, icon: "🎮" },
  { id: "level_10", cat: "streaks", title: "Grandmaster Tier", req: "Reach Level 10", target: 10, icon: "🔱" },
];

function calculateAchievements({ runs = [], logs = {}, meals = {}, totals = {}, goals = {}, water = 0, xpData = { level: 8 } }) {
  const totalKm = runs.reduce((sum, r) => sum + (Number(r.distanceKm || r.distance || 0)), 0);
  const maxSingleKm = runs.reduce((max, r) => Math.max(max, Number(r.distanceKm || r.distance || 0)), 0);
  const runsCount = runs.length;

  let totalCompletedExercises = 0;
  let totalSets = 0;
  Object.values(logs).forEach((dayLog) => {
    Object.values(dayLog).forEach((ex) => {
      if (ex.completed) totalCompletedExercises++;
      if (Array.isArray(ex.sets)) totalSets += ex.sets.length;
    });
  });

  const mealsCount = Object.values(meals).flat().length;
  const userLevel = xpData.level || 8;

  return ACHIEVEMENTS_LIST.map((ach) => {
    let current = 0;
    switch (ach.id) {
      case "first_workout": current = Math.min(1, totalCompletedExercises); break;
      case "workout_3": current = Math.min(3, Math.floor(totalCompletedExercises / 4)); break;
      case "workout_5": current = Math.min(5, Math.floor(totalCompletedExercises / 4)); break;
      case "heavy_lifter": current = Math.min(10, totalSets); break;
      case "first_run": current = Math.min(1, runsCount); break;
      case "run_5k": current = Math.min(5, maxSingleKm); break;
      case "run_10k": current = Math.min(10, maxSingleKm); break;
      case "run_25km": current = Math.min(25, totalKm); break;
      case "run_50km": current = Math.min(50, totalKm); break;
      case "run_100km": current = Math.min(100, totalKm); break;
      case "clean_fuel": current = Math.min(1, mealsCount); break;
      case "macro_discipline": current = Math.min(3, mealsCount); break;
      case "protein_beast": current = totals.protein >= (goals.protein || 150) ? 1 : 0; break;
      case "hydration_hero": current = Math.min(2.5, water); break;
      case "water_champion": current = Math.min(3.5, water); break;
      case "streak_3": current = 3; break; // Streak is 4 days
      case "streak_7": current = 4; break;
      case "level_5": current = Math.min(5, userLevel); break;
      case "level_8": current = Math.min(8, userLevel); break;
      case "level_10": current = Math.min(10, userLevel); break;
      default: current = 0;
    }

    const unlocked = current >= ach.target;
    const progressPct = Math.min(1, current / ach.target);
    return { ...ach, current, unlocked, progressPct };
  });
}

function AchievementRoomPreview({ achievements = [], onViewAll }) {
  const unlocked = achievements.filter((a) => a.unlocked);
  const latest3 = (unlocked.length >= 3 ? unlocked.slice(0, 3) : achievements.slice(0, 3));

  return (
    <div
