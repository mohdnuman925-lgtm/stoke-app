// Clean Inline SVG Icons (Zero encoding dependency)
function AuthEyeIcon({ visible }) {
  if (visible) {
    return (
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.7)" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" style={{ display: "block" }}>
        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
        <circle cx="12" cy="12" r="3" />
      </svg>
    );
  }
  return (
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.45)" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" style={{ display: "block" }}>
      <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24" />
      <line x1="1" y1="1" x2="23" y2="23" />
    </svg>
  );
}

function AuthBackIcon() {
  return (
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.4" strokeLinecap="round" strokeLinejoin="round" style={{ display: "block" }}>
      <path d="M19 12H5M12 19l-7-7 7-7" />
    </svg>
  );
}

function AuthCloseIcon() {
  return (
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.4" strokeLinecap="round" strokeLinejoin="round" style={{ display: "block" }}>
      <line x1="18" y1="6" x2="6" y2="18" />
      <line x1="6" y1="6" x2="18" y2="18" />
    </svg>
  );
}

function AuthCheckIcon() {
  return (
    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" strokeWidth="3.2" strokeLinecap="round" strokeLinejoin="round" style={{ display: "block" }}>
      <polyline points="20 6 9 17 4 12" />
    </svg>
  );
}

function AuthAlertIcon() {
  return (
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#FF7070" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" style={{ flexShrink: 0 }}>
      <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
      <line x1="12" y1="9" x2="12" y2="13" />
      <line x1="12" y1="17" x2="12.01" y2="17" />
    </svg>
  );
}

function AuthUserAvatar() {
  return (
    <svg width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="#3B82F6" strokeWidth="1.8" strokeLinecap="round" strokeLinejoin="round">
      <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
      <circle cx="12" cy="7" r="4" />
    </svg>
  );
}

function AuthLightningIcon() {
  return (
    <svg width="14" height="14" viewBox="0 0 24 24" fill="#3B82F6" style={{ display: "block" }}>
      <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
    </svg>
  );
}

function AuthScreen({ onSignIn, initialMode = "signin" }) {
  useEffect(() => {
    if (typeof injectAuthStylesV3 === "function") injectAuthStylesV3();
  }, []);

  const [screen, setScreen] = useState(initialMode === "signup" ? "signup" : "login");
  const [step, setStep] = useState(0);

  const [form, setForm] = useState({
    email: "",
    password: "",
    name: "",
    age: "",
    height: "",
    weight: "",
    goal: "",
    level: "",
    frequency: "",
    activity: "",
  });

  const [loading, setLoading] = useState(false);
  const [error, setError] = useState("");
  const [showPassword, setShowPassword] = useState(false);
  const [showGoogleModal, setShowGoogleModal] = useState(false);

  const GOOGLE_ACCOUNTS = [
    { name: "Mohd Numan", email: "mohdnuman701@gmail.com", avatar: "M", color: "#1A73E8", label: "Primary" },
    { name: "Mohd Numan", email: "mohdnuman925@gmail.com", avatar: "M", color: "#256BFD", label: "Personal" },
    { name: "KLH Edu", email: "mohdnuman@klh.edu.in", avatar: "N", color: "#E37400", label: "KLH Edu" },
    { name: "Mohammed numan .", email: "2210560148@klh.edu.in", avatar: "M", color: "#1E8E3E", label: "KLH Student" },
  ];

  const update = (key, value) => {
    setForm((prev) => ({
      ...prev,
      [key]: value,
    }));
    setError("");
  };

  /*
   * LOGIN
   */
  const handleLogin = async (customEmail) => {
    const emailToUse = customEmail || form.email;
    if (!emailToUse || (!customEmail && !form.password)) {
      setError("Please enter your email and password.");
      return;
    }

    setLoading(true);
    setError("");

    try {
      if (typeof dbSignIn === "function") {
        await dbSignIn(emailToUse, form.password || "password123");
      }
      onSignIn(emailToUse);
    } catch (err) {
      setError(err?.message || "Unable to log in. Please try again.");
    } finally {
      setLoading(false);
    }
  };

  /*
   * FORGOT PASSWORD
   */
  const handleForgotPassword = async () => {
    if (!form.email || !form.email.includes("@")) {
      setError("Please enter your email above to receive a password reset link.");
      return;
    }
    setLoading(true);
    setError("");
    try {
      if (typeof dbResetPassword === "function") {
        await dbResetPassword(form.email);
        alert(`A password reset link has been sent to ${form.email}`);
      } else {
        alert(`Reset link sent to ${form.email}`);
      }
    } catch (err) {
      setError(err?.message || "Failed to send reset link.");
    } finally {
      setLoading(false);
    }
  };

  /*
   * CREATE ACCOUNT
   */
  const handleCreateAccount = async () => {
    if (!form.email || !form.password) {
      setError("Please enter your email and password.");
      return;
    }
    if (!form.email.includes("@")) {
      setError("Please enter a valid email address.");
      return;
    }
    if (form.password.length < 4) {
      setError("Password must be at least 4 characters.");
      return;
    }

    setError("");
    setStep(0);
    setScreen("profile");
  };

  /*
   * SELECT PROFILE OPTION
   */
  const selectOption = (value) => {
    const key = STEPS[step].key;
    update(key, value);
  };

  /*
   * NEXT PROFILE STEP
   */
  const nextStep = () => {
    const currentStep = STEPS[step];
    const value = form[currentStep.key];

    if (!value || String(value).trim() === "") {
      setError("Please complete this step before continuing.");
      return;
    }

    setError("");

    if (step < STEPS.length - 1) {
      setStep((prev) => prev + 1);
    } else {
      setScreen("summary");
    }
  };

  /*
   * BACK
   */
  const goBack = () => {
    setError("");

    if (step === 0) {
      if (screen === "profile") {
        setScreen("signup");
      }
      return;
    }

    setStep((prev) => prev - 1);
  };

  /*
   * FINISH PROFILE
   */
  const finishProfile = async () => {
    setLoading(true);
    setError("");

    try {
      await new Promise((resolve) => setTimeout(resolve, 700));

      const activityMap = {
        "Low": 1.2,
        "Moderate": 1.55,
        "High": 1.725,
        "Very High": 1.9,
      };
      const goalTypeMap = {
        "Build Muscle": "gain",
        "Lose Fat": "cut",
        "Get Stronger": "gain",
        "Improve Fitness": "maintain",
      };

      const userProfile = {
        ...DEFAULT_PROFILE,
        name: form.name || "Athlete",
        age: parseInt(form.age, 10) || 25,
        heightCm: parseFloat(form.height) || 175,
        weightKg: parseFloat(form.weight) || 70,
        goalType: goalTypeMap[form.goal] || "maintain",
        goal: form.goal || "Improve Fitness",
        level: form.level || "Intermediate",
        frequency: form.frequency || "3-4 days",
        activity: activityMap[form.activity] || 1.55,
        activityLevel: form.activity || "Moderate",
      };

      if (typeof dbSignUp === "function") {
        await dbSignUp(form.email || "athlete@stoke.app", form.password || "password123", {
          name: userProfile.name,
          age: userProfile.age,
          height: userProfile.heightCm,
          weight: userProfile.weightKg,
          goal: userProfile.goalType,
          activity: userProfile.activityLevel
        });
      }

      console.log("Profile completed:", userProfile);
      setLoading(false);
      onSignIn(form.email || "athlete@stoke.app", userProfile);
    } catch (err) {
      setError(err?.message || "Unable to save your profile. Please try again.");
      setLoading(false);
    }
  };

  /*
   * QUICK DEMO LOGIN (Mohd Numan)
   */
  const handleDemoLogin = () => {
    update("email", "mohdnuman701@gmail.com");
    update("password", "password123");
    handleLogin("mohdnuman701@gmail.com");
  };

  /*
   * LOGIN SCREEN
   */
  if (screen === "login") {
    return (
      <div style={{
        minHeight: "100vh",
        background: "radial-gradient(circle at 50% 0%, #10162A 0%, #08090E 70%)",
        color: "#FFFFFF",
        display: "flex",
        alignItems: "center",
        justifyContent: "center",
        padding: "32px 20px",
        fontFamily: "'Space Grotesk', ui-sans-serif, system-ui, sans-serif",
        position: "relative",
        overflowX: "hidden"
      }}>
        {/* Ambient lighting orb */}
        <div style={{
          position: "absolute",
          top: -100,
          left: "50%",
          transform: "translateX(-50%)",
          width: 320,
          height: 320,
          borderRadius: "50%",
          background: "radial-gradient(circle, rgba(37,107,253,0.18) 0%, transparent 70%)",
          pointerEvents: "none",
          filter: "blur(40px)"
        }} />

        <div style={{ width: "100%", maxWidth: 430, position: "relative", zIndex: 1 }}>

          {/* BRAND HEADER */}
          <div style={{ marginBottom: 36, animation: "loginLogoEntrance 0.5s ease-out both" }}>
            <div style={{
              display: "inline-flex",
              alignItems: "center",
              gap: 8,
              background: "rgba(37,107,253,0.12)",
              border: "1px solid rgba(37,107,253,0.3)",
              padding: "4px 12px",
              borderRadius: 999,
              marginBottom: 16
            }}>
              <span style={{ width: 6, height: 6, borderRadius: "50%", background: "#256BFD", boxShadow: "0 0 8px #256BFD" }} />
              <span style={{ color: "#3B82F6", fontSize: 11, fontWeight: 900, letterSpacing: "0.25em" }}>
                STOKE
              </span>
            </div>

            <h1 style={{ fontSize: 36, fontWeight: 900, letterSpacing: "-1px", lineHeight: 1.15, margin: "0 0 10px", color: "#FFFFFF" }}>
              Welcome back
            </h1>

            <p style={{ color: "rgba(255,255,255,0.48)", fontSize: 15, margin: 0, lineHeight: 1.5 }}>
              Sign in to continue your fitness journey.
            </p>
          </div>

          <div style={{ display: "flex", flexDirection: "column", gap: 14 }}>

            {/* CONTINUE WITH GOOGLE BUTTON */}
            <button
              type="button"
              onClick={() => setShowGoogleModal(true)}
              style={{
                width: "100%",
                height: 56,
                borderRadius: 18,
                background: "#FFFFFF",
                color: "#08090E",
                border: "none",
                fontWeight: 800,
                fontSize: 15,
                display: "flex",
                alignItems: "center",
                justifyContent: "center",
                gap: 12,
                cursor: "pointer",
                transition: "all 0.2s ease",
                boxShadow: "0 4px 18px rgba(0,0,0,0.3)"
              }}
              onMouseEnter={(e) => { e.currentTarget.style.transform = "translateY(-1px)"; }}
              onMouseLeave={(e) => { e.currentTarget.style.transform = "translateY(0)"; }}
            >
              <svg width="20" height="20" viewBox="0 0 24 24">
                <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.8-2.4 3.68v3.05h3.88c2.27-2.09 3.665-5.17 3.665-9.17z"/>
                <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.25v3.15C3.26 21.36 7.33 24 12 24z"/>
                <path fill="#FBBC05" d="M5.28 14.27c-.25-.72-.38-1.49-.38-2.27s.13-1.55.38-2.27V6.58H1.25C.45 8.18 0 9.99 0 12s.45 3.82 1.25 5.42l4.03-3.15z"/>
                <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.33 0 3.26 2.64 1.25 6.58l4.03 3.15c.95-2.83 3.6-4.98 6.72-4.98z"/>
              </svg>
              Continue with Google
            </button>

            {/* DIVIDER */}
            <div style={{ display: "flex", alignItems: "center", gap: 14, margin: "6px 0" }}>
              <div style={{ flex: 1, height: 1, background: "rgba(255,255,255,0.08)" }} />
              <span style={{ fontSize: 11, color: "rgba(255,255,255,0.35)", fontWeight: 800, letterSpacing: "1.5px" }}>
                OR
              </span>
              <div style={{ flex: 1, height: 1, background: "rgba(255,255,255,0.08)" }} />
            </div>

            {/* EMAIL INPUT */}
            <div style={{
              display: "flex",
              alignItems: "center",
              height: 56,
              padding: "0 18px",
              borderRadius: 18,
              background: "#101420",
              border: "1.5px solid rgba(255,255,255,0.08)",
              transition: "all 0.2s ease"
            }}>
              <input
                type="email"
                value={form.email}
                onChange={(e) => update("email", e.target.value)}
                placeholder="Email"
                style={{
                  width: "100%",
                  height: "100%",
                  background: "transparent",
                  border: "none",
                  outline: "none",
                  color: "#FFFFFF",
                  fontSize: 15,
                  fontWeight: 600,
                  fontFamily: "inherit"
                }}
                onFocus={(e) => {
                  e.currentTarget.parentElement.style.borderColor = "#256BFD";
                  e.currentTarget.parentElement.style.boxShadow = "0 0 0 3px rgba(37,107,253,0.2)";
                }}
                onBlur={(e) => {
                  e.currentTarget.parentElement.style.borderColor = "rgba(255,255,255,0.08)";
                  e.currentTarget.parentElement.style.boxShadow = "none";
                }}
              />
            </div>

            {/* PASSWORD INPUT WITH CLEAN SVG EYE ICON */}
            <div style={{
              display: "flex",
              alignItems: "center",
              height: 56,
              padding: "0 18px",
              borderRadius: 18,
              background: "#101420",
              border: "1.5px solid rgba(255,255,255,0.08)",
              transition: "all 0.2s ease"
            }}>
              <input
                type={showPassword ? "text" : "password"}
                value={form.password}
                onChange={(e) => update("password", e.target.value)}
                onKeyDown={(e) => { if (e.key === "Enter") handleLogin(); }}
                placeholder="Password"
                style={{
                  width: "100%",
                  height: "100%",
                  background: "transparent",
                  border: "none",
                  outline: "none",
                  color: "#FFFFFF",
                  fontSize: 15,
                  fontWeight: 600,
                  fontFamily: "inherit"
                }}
                onFocus={(e) => {
                  e.currentTarget.parentElement.style.borderColor = "#256BFD";
                  e.currentTarget.parentElement.style.boxShadow = "0 0 0 3px rgba(37,107,253,0.2)";
                }}
                onBlur={(e) => {
                  e.currentTarget.parentElement.style.borderColor = "rgba(255,255,255,0.08)";
                  e.currentTarget.parentElement.style.boxShadow = "none";
                }}
              />
              <button
                type="button"
                onClick={() => setShowPassword(!showPassword)}
                aria-label={showPassword ? "Hide password" : "Show password"}
                style={{
                  background: "transparent",
                  border: "none",
                  padding: 4,
                  cursor: "pointer",
                  display: "flex",
                  alignItems: "center",
                  justifyContent: "center",
                  marginLeft: 8
                }}
              >
                <AuthEyeIcon visible={showPassword} />
              </button>
            </div>

            {/* FORGOT PASSWORD LINK */}
            <div style={{ display: "flex", justifyContent: "flex-end", marginTop: -4 }}>
              <button
                type="button"
                onClick={handleForgotPassword}
                style={{
                  background: "transparent",
                  border: "none",
                  color: "#3B82F6",
                  fontSize: 12.5,
                  fontWeight: 600,
                  cursor: "pointer",
                  padding: "2px 4px",
                  textDecoration: "none"
                }}
                onMouseEnter={(e) => { e.currentTarget.style.textDecoration = "underline"; }}
                onMouseLeave={(e) => { e.currentTarget.style.textDecoration = "none"; }}
              >
                Forgot password?
              </button>
            </div>

            {/* ERROR MESSAGE WITH CLEAN SVG ALERT ICON */}
            {error && (
              <div style={{
                background: "rgba(255,80,80,0.12)",
                border: "1px solid rgba(255,80,80,0.3)",
                color: "#FF7070",
                fontSize: 13,
                fontWeight: 600,
                padding: "10px 14px",
                borderRadius: 14,
                display: "flex",
                alignItems: "center",
                gap: 8
              }}>
                <AuthAlertIcon />
                <span>{error}</span>
              </div>
            )}

            {/* LOG IN PRIMARY BUTTON - EXACTLY "LOG IN" WITH ZERO SYMBOLS */}
            <button
              type="button"
              onClick={() => handleLogin()}
              disabled={loading}
              style={{
                width: "100%",
                height: 56,
                borderRadius: 18,
                background: "linear-gradient(135deg, #256BFD 0%, #1A5EE5 100%)",
                color: "#FFFFFF",
                border: "none",
                fontWeight: 900,
                fontSize: 15,
                letterSpacing: "0.5px",
                cursor: loading ? "not-allowed" : "pointer",
                transition: "all 0.2s cubic-bezier(0.16, 1, 0.3, 1)",
                boxShadow: "0 8px 30px rgba(37,107,253,0.38)",
                display: "flex",
                alignItems: "center",
                justifyContent: "center",
                opacity: loading ? 0.7 : 1
              }}
              onMouseEnter={(e) => { if (!loading) e.currentTarget.style.filter = "brightness(1.1)"; }}
              onMouseLeave={(e) => { e.currentTarget.style.filter = "none"; }}
            >
              {loading ? (
                <span style={{ display: "flex", alignItems: "center", gap: 8 }}>
                  <span className="s3-spinner" style={{ borderTopColor: "#fff" }} />
                  <span>LOGGING IN...</span>
                </span>
              ) : (
                "LOG IN"
              )}
            </button>

            {/* QUICK DEMO ONE-TAP LOGIN */}
            <button
              type="button"
              onClick={handleDemoLogin}
              style={{
                background: "rgba(255,255,255,0.04)",
                border: "1px dashed rgba(37,107,253,0.35)",
                color: "#3B82F6",
                borderRadius: 14,
                padding: "11px 16px",
                fontSize: 12.5,
                fontWeight: 700,
                cursor: "pointer",
                display: "flex",
                alignItems: "center",
                justifyContent: "center",
                gap: 8,
                marginTop: 4,
                transition: "all 0.15s ease"
              }}
            >
              <AuthLightningIcon />
              <span>Quick Demo Login (Mohd Numan)</span>
            </button>

          </div>

          {/* SIGN UP FOOTER LINK */}
          <p style={{ textAlign: "center", color: "rgba(255,255,255,0.45)", marginTop: 28, fontSize: 14 }}>
            New to STOKE?{" "}
            <button
              type="button"
              onClick={() => {
                setError("");
                setScreen("signup");
              }}
              style={{
                background: "transparent",
                border: "none",
                color: "#FFFFFF",
                fontWeight: 800,
                cursor: "pointer",
                fontSize: 14,
                textDecoration: "underline",
                textUnderlineOffset: 3
              }}
            >
              Create account
            </button>
          </p>

        </div>

        {/* GOOGLE ACCOUNTS MODAL */}
        {showGoogleModal && (
          <div style={{
            position: "fixed",
            inset: 0,
            background: "rgba(0,0,0,0.75)",
            backdropFilter: "blur(12px)",
            zIndex: 9999,
            display: "flex",
            alignItems: "center",
            justifyContent: "center",
            padding: 20
          }}>
            <div style={{
              background: "#101420",
              border: "1.5px solid rgba(255,255,255,0.1)",
              borderRadius: 24,
              padding: 24,
              maxWidth: 380,
              width: "100%",
              boxShadow: "0 20px 60px rgba(0,0,0,0.8)"
            }}>
              <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 18 }}>
                <h3 style={{ margin: 0, fontSize: 17, fontWeight: 900 }}>Select Google Account</h3>
                <button
                  type="button"
                  onClick={() => setShowGoogleModal(false)}
                  style={{ background: "transparent", border: "none", color: "rgba(255,255,255,0.5)", cursor: "pointer", padding: 4 }}
                >
                  <AuthCloseIcon />
                </button>
              </div>
              <div style={{ display: "flex", flexDirection: "column", gap: 10 }}>
                {GOOGLE_ACCOUNTS.map((acc, i) => (
                  <div
                    key={i}
                    onClick={() => {
                      setShowGoogleModal(false);
                      update("email", acc.email);
                      handleLogin(acc.email);
                    }}
                    style={{
                      display: "flex",
                      alignItems: "center",
                      gap: 12,
                      padding: "12px 14px",
                      borderRadius: 16,
                      background: "rgba(255,255,255,0.04)",
                      border: "1px solid rgba(255,255,255,0.07)",
                      cursor: "pointer",
                      transition: "all 0.2s ease"
                    }}
                    onMouseEnter={(e) => { e.currentTarget.style.borderColor = "#256BFD"; }}
                    onMouseLeave={(e) => { e.currentTarget.style.borderColor = "rgba(255,255,255,0.07)"; }}
                  >
                    <div style={{
                      width: 38,
                      height: 38,
                      borderRadius: "50%",
                      background: acc.color,
                      color: "#fff",
                      display: "flex",
                      alignItems: "center",
                      justifyContent: "center",
                      fontWeight: 900,
                      fontSize: 16
                    }}>
                      {acc.avatar}
                    </div>
                    <div style={{ flex: 1, minWidth: 0 }}>
                      <div style={{ fontWeight: 800, fontSize: 13, color: "#fff" }}>{acc.name}</div>
                      <div style={{ fontSize: 11.5, color: "rgba(255,255,255,0.45)", whiteSpace: "nowrap", overflow: "hidden", textOverflow: "ellipsis" }}>
                        {acc.email}
                      </div>
                    </div>
                    <span style={{ fontSize: 10, background: "rgba(37,107,253,0.15)", color: "#3B82F6", padding: "2px 8px", borderRadius: 999, fontWeight: 800 }}>
                      {acc.label}
                    </span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        )}

      </div>
    );
  }

  /*
   * SIGN UP SCREEN
   */
  if (screen === "signup") {
    return (
      <div style={{
        minHeight: "100vh",
        background: "radial-gradient(circle at 50% 0%, #10162A 0%, #08090E 70%)",
        color: "#FFFFFF",
        display: "flex",
        alignItems: "center",
        justifyContent: "center",
        padding: "32px 20px",
        fontFamily: "'Space Grotesk', ui-sans-serif, system-ui, sans-serif",
        position: "relative",
        overflowX: "hidden"
      }}>
        {/* Ambient lighting orb */}
        <div style={{
          position: "absolute",
          top: -100,
          left: "50%",
          transform: "translateX(-50%)",
          width: 320,
          height: 320,
          borderRadius: "50%",
          background: "radial-gradient(circle, rgba(37,107,253,0.18) 0%, transparent 70%)",
          pointerEvents: "none",
          filter: "blur(40px)"
        }} />

        <div style={{ width: "100%", maxWidth: 430, position: "relative", zIndex: 1 }}>

          {/* BACK BUTTON WITH CLEAN SVG ARROW */}
          <button
            type="button"
            onClick={() => setScreen("login")}
            style={{
              width: 40,
              height: 40,
              borderRadius: "50%",
              background: "#101420",
              border: "1px solid rgba(255,255,255,0.1)",
              color: "#FFFFFF",
              display: "flex",
              alignItems: "center",
              justifyContent: "center",
              marginBottom: 28,
              cursor: "pointer",
              transition: "all 0.2s ease"
            }}
          >
            <AuthBackIcon />
          </button>

          {/* BRAND HEADER */}
          <div style={{ marginBottom: 36 }}>
            <div style={{
              display: "inline-flex",
              alignItems: "center",
              gap: 8,
              background: "rgba(37,107,253,0.12)",
              border: "1px solid rgba(37,107,253,0.3)",
              padding: "4px 12px",
              borderRadius: 999,
              marginBottom: 16
            }}>
              <span style={{ width: 6, height: 6, borderRadius: "50%", background: "#256BFD", boxShadow: "0 0 8px #256BFD" }} />
              <span style={{ color: "#3B82F6", fontSize: 11, fontWeight: 900, letterSpacing: "0.25em" }}>
                STOKE
              </span>
            </div>

            <h1 style={{ fontSize: 36, fontWeight: 900, letterSpacing: "-1px", lineHeight: 1.15, margin: "0 0 10px", color: "#FFFFFF" }}>
              Create account
            </h1>

            <p style={{ color: "rgba(255,255,255,0.48)", fontSize: 15, margin: 0, lineHeight: 1.5 }}>
              Create your athlete profile and start your journey.
            </p>
          </div>

          <div style={{ display: "flex", flexDirection: "column", gap: 14 }}>

            {/* CONTINUE WITH GOOGLE */}
            <button
              type="button"
              onClick={() => setShowGoogleModal(true)}
              style={{
                width: "100%",
                height: 56,
                borderRadius: 18,
                background: "#FFFFFF",
                color: "#08090E",
                border: "none",
                fontWeight: 800,
                fontSize: 15,
                display: "flex",
                alignItems: "center",
                justifyContent: "center",
                gap: 12,
                cursor: "pointer",
                transition: "all 0.2s ease",
                boxShadow: "0 4px 18px rgba(0,0,0,0.3)"
              }}
            >
              <svg width="20" height="20" viewBox="0 0 24 24">
                <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.8-2.4 3.68v3.05h3.88c2.27-2.09 3.665-5.17 3.665-9.17z"/>
                <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.25v3.15C3.26 21.36 7.33 24 12 24z"/>
                <path fill="#FBBC05" d="M5.28 14.27c-.25-.72-.38-1.49-.38-2.27s.13-1.55.38-2.27V6.58H1.25C.45 8.18 0 9.99 0 12s.45 3.82 1.25 5.42l4.03-3.15z"/>
                <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.33 0 3.26 2.64 1.25 6.58l4.03 3.15c.95-2.83 3.6-4.98 6.72-4.98z"/>
              </svg>
              Continue with Google
            </button>

            {/* DIVIDER */}
            <div style={{ display: "flex", alignItems: "center", gap: 14, margin: "6px 0" }}>
              <div style={{ flex: 1, height: 1, background: "rgba(255,255,255,0.08)" }} />
              <span style={{ fontSize: 11, color: "rgba(255,255,255,0.35)", fontWeight: 800, letterSpacing: "1.5px" }}>
                OR
              </span>
              <div style={{ flex: 1, height: 1, background: "rgba(255,255,255,0.08)" }} />
            </div>

            {/* EMAIL */}
            <div style={{
              display: "flex",
              alignItems: "center",
              height: 56,
              padding: "0 18px",
              borderRadius: 18,
              background: "#101420",
              border: "1.5px solid rgba(255,255,255,0.08)",
              transition: "all 0.2s ease"
            }}>
              <input
                type="email"
                value={form.email}
                onChange={(e) => update("email", e.target.value)}
                placeholder="Email"
                style={{
                  width: "100%",
                  height: "100%",
                  background: "transparent",
                  border: "none",
                  outline: "none",
                  color: "#FFFFFF",
                  fontSize: 15,
                  fontWeight: 600,
                  fontFamily: "inherit"
                }}
                onFocus={(e) => {
                  e.currentTarget.parentElement.style.borderColor = "#256BFD";
                  e.currentTarget.parentElement.style.boxShadow = "0 0 0 3px rgba(37,107,253,0.2)";
                }}
                onBlur={(e) => {
                  e.currentTarget.parentElement.style.borderColor = "rgba(255,255,255,0.08)";
                  e.currentTarget.parentElement.style.boxShadow = "none";
                }}
              />
            </div>

            {/* PASSWORD WITH CLEAN SVG EYE ICON */}
            <div style={{
              display: "flex",
              alignItems: "center",
              height: 56,
              padding: "0 18px",
              borderRadius: 18,
              background: "#101420",
              border: "1.5px solid rgba(255,255,255,0.08)",
              transition: "all 0.2s ease"
            }}>
              <input
                type={showPassword ? "text" : "password"}
                value={form.password}
                onChange={(e) => update("password", e.target.value)}
                placeholder="Create password"
                style={{
                  width: "100%",
                  height: "100%",
                  background: "transparent",
                  border: "none",
                  outline: "none",
                  color: "#FFFFFF",
                  fontSize: 15,
                  fontWeight: 600,
                  fontFamily: "inherit"
                }}
                onFocus={(e) => {
                  e.currentTarget.parentElement.style.borderColor = "#256BFD";
                  e.currentTarget.parentElement.style.boxShadow = "0 0 0 3px rgba(37,107,253,0.2)";
                }}
                onBlur={(e) => {
                  e.currentTarget.parentElement.style.borderColor = "rgba(255,255,255,0.08)";
                  e.currentTarget.parentElement.style.boxShadow = "none";
                }}
              />
              <button
                type="button"
                onClick={() => setShowPassword(!showPassword)}
                aria-label={showPassword ? "Hide password" : "Show password"}
                style={{
                  background: "transparent",
                  border: "none",
                  padding: 4,
                  cursor: "pointer",
                  display: "flex",
                  alignItems: "center",
                  justifyContent: "center",
                  marginLeft: 8
                }}
              >
                <AuthEyeIcon visible={showPassword} />
              </button>
            </div>

            {/* ERROR MESSAGE WITH CLEAN SVG ALERT ICON */}
            {error && (
              <div style={{
                background: "rgba(255,80,80,0.12)",
                border: "1px solid rgba(255,80,80,0.3)",
                color: "#FF7070",
                fontSize: 13,
                fontWeight: 600,
                padding: "10px 14px",
                borderRadius: 14,
                display: "flex",
                alignItems: "center",
                gap: 8
              }}>
                <AuthAlertIcon />
                <span>{error}</span>
              </div>
            )}

            {/* CREATE ACCOUNT BUTTON - EXACTLY "CREATE ACCOUNT" WITH ZERO EXTRA SYMBOLS */}
            <button
              type="button"
              onClick={handleCreateAccount}
              style={{
                width: "100%",
                height: 56,
                borderRadius: 18,
                background: "linear-gradient(135deg, #256BFD 0%, #1A5EE5 100%)",
                color: "#FFFFFF",
                border: "none",
                fontWeight: 900,
                fontSize: 15,
                letterSpacing: "0.5px",
                cursor: "pointer",
                transition: "all 0.2s cubic-bezier(0.16, 1, 0.3, 1)",
                boxShadow: "0 8px 30px rgba(37,107,253,0.38)",
                display: "flex",
                alignItems: "center",
                justifyContent: "center"
              }}
              onMouseEnter={(e) => { e.currentTarget.style.filter = "brightness(1.1)"; }}
              onMouseLeave={(e) => { e.currentTarget.style.filter = "none"; }}
            >
              CREATE ACCOUNT
            </button>

          </div>

          {/* SIGN IN FOOTER LINK */}
          <p style={{ textAlign: "center", color: "rgba(255,255,255,0.45)", marginTop: 28, fontSize: 14 }}>
            Already have an account?{" "}
            <button
              type="button"
              onClick={() => {
                setError("");
                setScreen("login");
              }}
              style={{
                background: "transparent",
                border: "none",
                color: "#FFFFFF",
                fontWeight: 800,
                cursor: "pointer",
                fontSize: 14,
                textDecoration: "underline",
                textUnderlineOffset: 3
              }}
            >
              Log in
            </button>
          </p>

        </div>

        {/* GOOGLE ACCOUNTS MODAL */}
        {showGoogleModal && (
          <div style={{
            position: "fixed",
            inset: 0,
            background: "rgba(0,0,0,0.75)",
            backdropFilter: "blur(12px)",
            zIndex: 9999,
            display: "flex",
            alignItems: "center",
            justifyContent: "center",
            padding: 20
          }}>
            <div style={{
              background: "#101420",
              border: "1.5px solid rgba(255,255,255,0.1)",
              borderRadius: 24,
              padding: 24,
              maxWidth: 380,
              width: "100%",
              boxShadow: "0 20px 60px rgba(0,0,0,0.8)"
            }}>
              <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 18 }}>
                <h3 style={{ margin: 0, fontSize: 17, fontWeight: 900 }}>Select Google Account</h3>
                <button
                  type="button"
                  onClick={() => setShowGoogleModal(false)}
                  style={{ background: "transparent", border: "none", color: "rgba(255,255,255,0.5)", cursor: "pointer", padding: 4 }}
                >
                  <AuthCloseIcon />
                </button>
              </div>
              <div style={{ display: "flex", flexDirection: "column", gap: 10 }}>
                {GOOGLE_ACCOUNTS.map((acc, i) => (
                  <div
                    key={i}
                    onClick={() => {
                      setShowGoogleModal(false);
                      update("email", acc.email);
                      update("password", "google_oauth_authorized");
                      setStep(0);
                      setScreen("profile");
                    }}
                    style={{
                      display: "flex",
                      alignItems: "center",
                      gap: 12,
                      padding: "12px 14px",
                      borderRadius: 16,
                      background: "rgba(255,255,255,0.04)",
                      border: "1px solid rgba(255,255,255,0.07)",
                      cursor: "pointer"
                    }}
                  >
                    <div style={{
                      width: 38,
                      height: 38,
                      borderRadius: "50%",
                      background: acc.color,
                      color: "#fff",
                      display: "flex",
                      alignItems: "center",
                      justifyContent: "center",
                      fontWeight: 900,
                      fontSize: 16
                    }}>
                      {acc.avatar}
                    </div>
                    <div style={{ flex: 1, minWidth: 0 }}>
                      <div style={{ fontWeight: 800, fontSize: 13, color: "#fff" }}>{acc.name}</div>
                      <div style={{ fontSize: 11.5, color: "rgba(255,255,255,0.45)", whiteSpace: "nowrap", overflow: "hidden", textOverflow: "ellipsis" }}>
                        {acc.email}
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        )}

      </div>
    );
  }

  /*
   * PROFILE ONBOARDING (8 STEPS)
   */
  if (screen === "profile") {
    const currentStep = STEPS[step];
    const currentValue = form[currentStep.key];

    return (
      <div style={{
        minHeight: "100vh",
        background: "radial-gradient(circle at 50% 0%, #10162A 0%, #08090E 70%)",
        color: "#FFFFFF",
        display: "flex",
        alignItems: "center",
        justifyContent: "center",
        padding: "28px 20px 36px",
        fontFamily: "'Space Grotesk', ui-sans-serif, system-ui, sans-serif",
        position: "relative",
        overflowX: "hidden"
      }}>
        {/* Ambient lighting orb */}
        <div style={{
          position: "absolute",
          top: -100,
          left: "50%",
          transform: "translateX(-50%)",
          width: 320,
          height: 320,
          borderRadius: "50%",
          background: "radial-gradient(circle, rgba(37,107,253,0.18) 0%, transparent 70%)",
          pointerEvents: "none",
          filter: "blur(40px)"
        }} />

        <div style={{ width: "100%", maxWidth: 430, position: "relative", zIndex: 1 }}>

          {/* TOP NAV: BACK BUTTON WITH SVG ARROW & STEP COUNTER */}
          <div style={{ display: "flex", alignItems: "center", justifyContent: "space-between", marginBottom: 24 }}>
            <button
              type="button"
              onClick={goBack}
              style={{
                width: 40,
                height: 40,
                borderRadius: "50%",
                background: "#101420",
                border: "1px solid rgba(255,255,255,0.1)",
                color: "#FFFFFF",
                display: "flex",
                alignItems: "center",
                justifyContent: "center",
                cursor: "pointer"
              }}
            >
              <AuthBackIcon />
            </button>

            <span style={{ fontSize: 13, color: "rgba(255,255,255,0.45)", fontWeight: 800, letterSpacing: "1px" }}>
              {String(step + 1).padStart(2, "0")} / {String(STEPS.length).padStart(2, "0")}
            </span>
          </div>

          {/* 8-SEGMENT PROGRESS BAR */}
          <div style={{ display: "flex", gap: 6, marginBottom: 32 }}>
            {STEPS.map((_, index) => (
              <div
                key={index}
                style={{
                  height: 4,
                  flex: 1,
                  borderRadius: 2,
                  background: index <= step ? "#256BFD" : "rgba(255,255,255,0.1)",
                  boxShadow: index <= step ? "0 0 10px rgba(37,107,253,0.6)" : "none",
                  transition: "all 0.35s ease"
                }}
              />
            ))}
          </div>

          {/* STEP TITLE & SUBTITLE */}
          <h1 style={{
            fontSize: 32,
            fontWeight: 900,
            letterSpacing: "-0.8px",
            lineHeight: 1.2,
            margin: "0 0 8px",
            color: "#FFFFFF"
          }}>
            {currentStep.title}
          </h1>

          <p style={{
            color: "rgba(255,255,255,0.48)",
            fontSize: 15,
            marginTop: 0,
            marginBottom: 28,
            lineHeight: 1.5
          }}>
            {currentStep.subtitle}
          </p>

          {/* INPUT STEP */}
          {currentStep.type === "input" && (
            <div style={{
              display: "flex",
              alignItems: "center",
              height: 64,
              padding: "0 20px",
              borderRadius: 20,
              background: "#101420",
              border: "1.5px solid rgba(255,255,255,0.1)",
              transition: "all 0.2s ease"
            }}>
              <input
                autoFocus
                type={
                  currentStep.key === "age" ||
                  currentStep.key === "height" ||
                  currentStep.key === "weight"
                    ? "number"
                    : "text"
                }
                value={currentValue || ""}
                onChange={(e) => update(currentStep.key, e.target.value)}
                onKeyDown={(e) => { if (e.key === "Enter") nextStep(); }}
                placeholder={currentStep.placeholder}
                style={{
                  width: "100%",
                  height: "100%",
                  background: "transparent",
                  border: "none",
                  outline: "none",
                  color: "#FFFFFF",
                  fontSize: 18,
                  fontWeight: 800,
                  fontFamily: "inherit"
                }}
                onFocus={(e) => {
                  e.currentTarget.parentElement.style.borderColor = "#256BFD";
                  e.currentTarget.parentElement.style.boxShadow = "0 0 0 3px rgba(37,107,253,0.2)";
                }}
                onBlur={(e) => {
                  e.currentTarget.parentElement.style.borderColor = "rgba(255,255,255,0.1)";
                  e.currentTarget.parentElement.style.boxShadow = "none";
                }}
              />
            </div>
          )}

          {/* OPTIONS STEP WITH CLEAN SVG CHECKMARK */}
          {currentStep.options && (
            <div style={{ display: "flex", flexDirection: "column", gap: 12 }}>
              {currentStep.options.map((option) => {
                const selected = currentValue === option;

                return (
                  <button
                    key={option}
                    type="button"
                    onClick={() => selectOption(option)}
                    style={{
                      width: "100%",
                      minHeight: 62,
                      padding: "16px 20px",
                      borderRadius: 18,
                      display: "flex",
                      alignItems: "center",
                      justifyContent: "space-between",
                      textAlign: "left",
                      cursor: "pointer",
                      fontFamily: "inherit",
                      transition: "all 0.22s cubic-bezier(0.16, 1, 0.3, 1)",
                      border: selected ? "1.5px solid #256BFD" : "1.5px solid rgba(255,255,255,0.08)",
                      background: selected ? "rgba(37,107,253,0.14)" : "#101420",
                      boxShadow: selected ? "0 0 25px rgba(37,107,253,0.18)" : "0 4px 14px rgba(0,0,0,0.3)"
                    }}
                  >
                    <span style={{ fontWeight: 800, fontSize: 16, color: "#FFFFFF" }}>
                      {option}
                    </span>

                    <span style={{
                      width: 26,
                      height: 26,
                      borderRadius: "50%",
                      display: "flex",
                      alignItems: "center",
                      justifyContent: "center",
                      border: selected ? "1.5px solid #256BFD" : "1.5px solid rgba(255,255,255,0.2)",
                      background: selected ? "#256BFD" : "transparent",
                      transition: "all 0.2s ease"
                    }}>
                      {selected && <AuthCheckIcon />}
                    </span>
                  </button>
                );
              })}
            </div>
          )}

          {/* ERROR MESSAGE WITH CLEAN SVG ALERT ICON */}
          {error && (
            <div style={{
              background: "rgba(255,80,80,0.12)",
              border: "1px solid rgba(255,80,80,0.3)",
              color: "#FF7070",
              fontSize: 13,
              fontWeight: 600,
              padding: "10px 14px",
              borderRadius: 14,
              marginTop: 18,
              display: "flex",
              alignItems: "center",
              gap: 8
            }}>
              <AuthAlertIcon />
              <span>{error}</span>
            </div>
          )}

          {/* CONTINUE / FINISH BUTTON - CLEAN TEXT ONLY */}
          <button
            type="button"
            onClick={nextStep}
            style={{
              marginTop: 32,
              width: "100%",
              height: 56,
              borderRadius: 18,
              background: "linear-gradient(135deg, #256BFD 0%, #1A5EE5 100%)",
              color: "#FFFFFF",
              border: "none",
              fontWeight: 900,
              fontSize: 15,
              letterSpacing: "0.5px",
              cursor: "pointer",
              transition: "all 0.2s cubic-bezier(0.16, 1, 0.3, 1)",
              boxShadow: "0 8px 30px rgba(37,107,253,0.38)",
              display: "flex",
              alignItems: "center",
              justifyContent: "center"
            }}
            onMouseEnter={(e) => { e.currentTarget.style.filter = "brightness(1.1)"; }}
            onMouseLeave={(e) => { e.currentTarget.style.filter = "none"; }}
          >
            {step === STEPS.length - 1 ? "FINISH PROFILE" : "CONTINUE"}
          </button>

        </div>
      </div>
    );
  }

  /*
   * PROFILE SUMMARY SCREEN
   */
  return (
    <div style={{
      minHeight: "100vh",
      background: "radial-gradient(circle at 50% 0%, #10162A 0%, #08090E 70%)",
      color: "#FFFFFF",
      display: "flex",
      alignItems: "center",
      justifyContent: "center",
      padding: "32px 20px 40px",
      fontFamily: "'Space Grotesk', ui-sans-serif, system-ui, sans-serif",
      position: "relative",
      overflowX: "hidden"
    }}>
      {/* Ambient lighting orb */}
      <div style={{
        position: "absolute",
        top: -100,
        left: "50%",
        transform: "translateX(-50%)",
        width: 320,
        height: 320,
        borderRadius: "50%",
        background: "radial-gradient(circle, rgba(37,107,253,0.18) 0%, transparent 70%)",
        pointerEvents: "none",
        filter: "blur(40px)"
      }} />

      <div style={{ width: "100%", maxWidth: 430, position: "relative", zIndex: 1 }}>

        {/* SUMMARY HERO WITH CLEAN SVG USER AVATAR */}
        <div style={{ textAlign: "center", marginBottom: 28 }}>
          <div style={{
            margin: "0 auto",
            width: 88,
            height: 88,
            borderRadius: "50%",
            background: "linear-gradient(135deg, rgba(37,107,253,0.2) 0%, #101420 100%)",
            border: "1.5px solid rgba(37,107,253,0.4)",
            boxShadow: "0 0 35px rgba(37,107,253,0.25)",
            display: "flex",
            alignItems: "center",
            justifyContent: "center"
          }}>
            <AuthUserAvatar />
          </div>

          <h1 style={{ fontSize: 32, fontWeight: 900, marginTop: 20, marginBottom: 8, letterSpacing: "-0.8px" }}>
            You're all set.
          </h1>

          <p style={{ color: "rgba(255,255,255,0.48)", margin: 0, fontSize: 15 }}>
            Your STOKE athlete profile is ready.
          </p>
        </div>

        {/* PROFILE ATTRIBUTES CARD */}
        <div style={{
          background: "#101420",
          border: "1.5px solid rgba(255,255,255,0.08)",
          borderRadius: 24,
          padding: "20px 22px",
          display: "flex",
          flexDirection: "column",
          gap: 4,
          boxShadow: "0 8px 32px rgba(0,0,0,0.4)"
        }}>
          <ProfileSummaryRow label="Name" value={form.name} />
          <ProfileSummaryRow label="Age" value={form.age ? `${form.age} years` : ""} />
          <ProfileSummaryRow label="Height" value={form.height ? `${form.height} cm` : ""} />
          <ProfileSummaryRow label="Weight" value={form.weight ? `${form.weight} kg` : ""} />
          <ProfileSummaryRow label="Goal" value={form.goal} />
          <ProfileSummaryRow label="Fitness level" value={form.level} />
          <ProfileSummaryRow label="Training" value={form.frequency} />
          <ProfileSummaryRow label="Activity" value={form.activity} isLast />
        </div>

        {/* ERROR MESSAGE WITH CLEAN SVG ALERT ICON */}
        {error && (
          <div style={{
            background: "rgba(255,80,80,0.12)",
            border: "1px solid rgba(255,80,80,0.3)",
            color: "#FF7070",
            fontSize: 13,
            fontWeight: 600,
            padding: "10px 14px",
            borderRadius: 14,
            marginTop: 18,
            display: "flex",
            alignItems: "center",
            gap: 8
          }}>
            <AuthAlertIcon />
            <span>{error}</span>
          </div>
        )}

        {/* START MY JOURNEY BUTTON - CLEAN TEXT ONLY */}
        <button
          type="button"
          onClick={finishProfile}
          disabled={loading}
          style={{
            marginTop: 24,
            width: "100%",
            height: 56,
            borderRadius: 18,
            background: "linear-gradient(135deg, #256BFD 0%, #1A5EE5 100%)",
            color: "#FFFFFF",
            border: "none",
            fontWeight: 900,
            fontSize: 15,
            letterSpacing: "0.5px",
            boxShadow: "0 8px 30px rgba(37,107,253,0.4)",
            cursor: loading ? "not-allowed" : "pointer",
            transition: "all 0.2s cubic-bezier(0.16, 1, 0.3, 1)",
            opacity: loading ? 0.7 : 1,
            display: "flex",
            alignItems: "center",
            justifyContent: "center",
            gap: 8
          }}
          onMouseEnter={(e) => { if (!loading) e.currentTarget.style.filter = "brightness(1.1)"; }}
          onMouseLeave={(e) => { e.currentTarget.style.filter = "none"; }}
        >
          {loading ? (
            <span style={{ display: "flex", alignItems: "center", gap: 8 }}>
              <span className="s3-spinner" style={{ borderTopColor: "#fff" }} />
              <span>SETTING UP PROFILE...</span>
            </span>
          ) : (
            "START MY JOURNEY"
          )}
        </button>

        {/* EDIT PROFILE BUTTON */}
        <button
          type="button"
          onClick={() => {
            setStep(0);
            setScreen("profile");
          }}
          style={{
            width: "100%",
            marginTop: 14,
            padding: "10px 0",
            background: "transparent",
            border: "none",
            fontSize: 14,
            fontWeight: 700,
            color: "rgba(255,255,255,0.45)",
            cursor: "pointer",
            textDecoration: "underline",
            textUnderlineOffset: 3
          }}
        >
          Edit profile
        </button>

      </div>
    </div>
  );
}

function ProfileSummaryRow({ label, value, isLast = false }) {
  return (
    <div style={{
      display: "flex",
      alignItems: "center",
      justifyContent: "space-between",
      padding: "10px 0",
      borderBottom: isLast ? "none" : "1px solid rgba(255,255,255,0.06)"
    }}>
      <p style={{
        fontSize: 11.5,
        color: "rgba(255,255,255,0.4)",
        textTransform: "uppercase",
        letterSpacing: "1px",
        fontWeight: 800,
        margin: 0
      }}>
        {label}
      </p>

      <p style={{
        fontWeight: 800,
        fontSize: 14,
        margin: 0,
        color: value ? "#FFFFFF" : "rgba(255,255,255,0.3)"
      }}>
        {value || "Not provided"}
      </p>
    </div>
  );
}


/* ---------- app shell ---------- */

function NavIcon({ name, size = 18 }) {
  const common = { width: size, height: size, viewBox: "0 0 24 24", fill: "none", stroke: "currentColor", strokeWidth: 1.8, strokeLinecap: "round", strokeLinejoin: "round" };
  switch (name) {
    case "home":
      return (
        <svg {...common}>
          <path d="M4 11.5L12 4l8 7.5" />
          <path d="M6.5 10v9.5h11V10" />
          <path d="M10 19.5v-5h4v5" />
        </svg>
      );
    case "nutrition":
      return (
        <svg {...common}>
          <circle cx="12" cy="14" r="6.5" />
          <path d="M12 7.5V5" />
          <path d="M12 5c1-1.2 2.3-1.4 3.3-0.6" />
        </svg>
      );
    case "workout":
      return (
        <svg {...common}>
          <circle cx="5" cy="12" r="2.2" />
          <circle cx="19" cy="12" r="2.2" />
          <line x1="7.2" y1="12" x2="16.8" y2="12" />
          <line x1="5" y1="9.3" x2="5" y2="14.7" />
          <line x1="19" y1="9.3" x2="19" y2="14.7" />
        </svg>
      );
    case "run":
      return (
        <svg {...common}>
          <circle cx="15.5" cy="5" r="1.8" />
          <path d="M9 20l2.5-5.5 2 1.8 3.5-1" />
          <path d="M7 13.5l3.5-2.5 2 2.5-2.5 3.5" />
        </svg>
      );
    case "coach":
      return (
        <svg {...common}>
          <path d="M4.5 5.5h15v10.5H10l-3.5 3.5v-3.5H4.5z" />
        </svg>
      );
    case "profile":
    case "more":
      return (
        <svg {...common}>
          <circle cx="5" cy="12" r="1.8" fill="currentColor" />
          <circle cx="12" cy="12" r="1.8" fill="currentColor" />
          <circle cx="19" cy="12" r="1.8" fill="currentColor" />
        </svg>
      );
    default:
      return null;
  }
}

const TABS = [
  { key: "home", label: "Today", icon: "home" },
  { key: "nutrition", label: "Nutrition", icon: "nutrition" },
  { key: "workout", label: "Workout", icon: "workout" },
  { key: "run", label: "Run", icon: "run" },
  { key: "more", label: "More", icon: "more" },
];

function StokeApp() {
  const urlParams = typeof window !== "undefined" ? new URLSearchParams(window.location.search) : new URLSearchParams();
  const savedAuthed = typeof localStorage !== "undefined" && localStorage.getItem("stoke_authed") === "true";
  const initialAuthed = urlParams.get("authed") === "true" || savedAuthed;
  const initialTab = (urlParams.get("tab") || "home") === "coach" ? "home" : (urlParams.get("tab") || "home");
  const initialShowWelcome = urlParams.get("welcome") === "true" || (!initialAuthed && !urlParams.has("authed"));
  const initialAuthMode = urlParams.get("mode") || "signin";
  const savedPhone = typeof localStorage !== "undefined" ? (localStorage.getItem("stoke_userPhone") || "mohdnuman701@gmail.com") : "mohdnuman701@gmail.com";

  const [tab, setTab] = useState(initialTab);
  const [navHistory, setNavHistory] = useState([initialTab]);

  function handleNavigate(targetTab) {
    if (!targetTab) return;
    if (targetTab === "coach") targetTab = "home";
    if (targetTab === tab) return;
    setNavHistory((prev) => {
      const filtered = prev.filter((t) => t !== targetTab);
      return [...filtered, targetTab];
    });
    setTab(targetTab);
  }

  function handleBack() {
    setNavHistory((prev) => {
      if (prev.length <= 1) {
        if (tab !== "home") setTab("home");
        return ["home"];
      }
      const next = prev.slice(0, prev.length - 1);
      const target = next[next.length - 1] || "home";
      setTab(target);
      return next;
    });
  }

  function handleTabClick(targetTab) {
    if (targetTab === tab) return;
    if (targetTab === "home") {
      setNavHistory(["home"]);
      setTab("home");
    } else {
      setNavHistory((prev) => {
        const filtered = prev.filter((t) => t !== targetTab);
        return [...filtered, targetTab];
      });
      setTab(targetTab);
    }
  }

  const [authed, setAuthed] = useState(initialAuthed);
  const [userPhone, setUserPhone] = useState(savedPhone);
  const [showWelcome, setShowWelcome] = useState(initialShowWelcome);
  const [authMode, setAuthMode] = useState(initialAuthMode);
  const [profile, setProfile] = useState(() => {
    if (typeof localStorage !== "undefined") {
      try {
        const saved = localStorage.getItem("stoke_profile");
        if (saved) return { ...DEFAULT_PROFILE, ...JSON.parse(saved) };
      } catch (e) {}
    }
    return { ...DEFAULT_PROFILE, name: "Mohd Numan", weightKg: 70, heightCm: 167, age: 21, goalType: "maintain" };
  });

  useEffect(() => {
    if (typeof localStorage !== "undefined" && profile) {
      try {
        localStorage.setItem("stoke_profile", JSON.stringify(profile));
      } catch (e) {}
    }
  }, [profile]);

  function handleSignIn(phone, profileFromSignup) {
    if (typeof localStorage !== "undefined") {
      localStorage.setItem("stoke_authed", "true");
      if (phone) localStorage.setItem("stoke_userPhone", phone);
      if (profileFromSignup) localStorage.setItem("stoke_profile", JSON.stringify(profileFromSignup));
    }
    setUserPhone(phone || "mohdnuman701@gmail.com");
    if (profileFromSignup) {
      setProfile(profileFromSignup);
    }
    setTab("home");
    setAuthed(true);
  }

  function handleSignOut() {
    if (typeof localStorage !== "undefined") {
      localStorage.removeItem("stoke_authed");
      localStorage.removeItem("stoke_userPhone");
    }
    setAuthed(false);
    setUserPhone("");
    setTab("home");
    setShowWelcome(true);
  }

  const goals = computeGoals(profile);

  const [currentUser, setCurrentUser] = useState(() => ({
    id: "e8a3c22b-87d4-4f91-92b4-52d194c5e317",
    email: savedPhone || "mohdnuman701@gmail.com",
    user_metadata: { name: "Mohd Numan" }
  }));

  const [selectedDate, setSelectedDate] = useState(() => {
    return typeof getLocalDateStr === "function" ? getLocalDateStr() : new Date().toISOString().split("T")[0];
  });

  const [userXp, setUserXp] = useState(() => {
    if (typeof localStorage !== "undefined") {
      try {
        const saved = localStorage.getItem("stoke_user_xp");
        if (saved) return JSON.parse(saved);
      } catch (e) {}
    }
    return { current_xp: 2450, current_level: 8, fitness_score: 78 };
  });

  const [showSupabaseModal, setShowSupabaseModal] = useState(false);

  const [mealSlots, setMealSlots] = useState(DEFAULT_MEAL_SLOTS);
  const [meals, setMeals] = useState(() => {
    const init = {};
    DEFAULT_MEAL_SLOTS.forEach((s) => { init[s.key] = []; });
    return init;
  });
  const [water, setWater] = useState(0);

  // Sync session and initial XP on mount
  useEffect(() => {
    if (typeof dbGetSession === "function") {
      dbGetSession().then((sess) => {
        if (sess?.user) setCurrentUser(sess.user);
      });
    }
    if (typeof dbGetUserXp === "function" && currentUser?.id) {
      dbGetUserXp(currentUser.id).then((res) => {
        if (res) setUserXp(res);
      });
    }
  }, []);

  // Load meals and water for the selected date from persistent database
  useEffect(() => {
    if (typeof dbGetMealsByDate === "function" && currentUser?.id) {
      dbGetMealsByDate(currentUser.id, selectedDate).then((loadedMeals) => {
        if (Array.isArray(loadedMeals)) {
          const grouped = {};
          mealSlots.forEach((s) => { grouped[s.key] = []; });
          loadedMeals.forEach((m) => {
            const slot = m.meal_type || "lunch";
            if (!grouped[slot]) grouped[slot] = [];
            grouped[slot].push({
              name: m.food_name,
              calories: m.calories,
              protein: m.protein,
              carbs: m.carbs,
              fat: m.fat,
              fiber: m.fiber,
              grams: m.grams,
              imageUrl: m.image_url,
              dbId: m.id
            });
          });
          setMeals(grouped);
        }
      });
    }

    if (typeof dbGetWaterByDate === "function" && currentUser?.id) {
      dbGetWaterByDate(currentUser.id, selectedDate).then((res) => {
        if (res && typeof res.total_ml === "number") {
          let liters = Number((res.total_ml / 1000).toFixed(2));
          if (isNaN(liters) || liters < 0 || liters > 15) {
            liters = Math.min(10, Math.max(0, liters > 15 ? 2.0 : 0));
          }
          setWater(liters);
        }
      });
    }
  }, [selectedDate, currentUser?.id]);

  const totals = macroSum(meals);
  const calPct = totals.calories / goals.calories;

  function addItem(mealKey, item) {
    setMeals((prev) => ({ ...prev, [mealKey]: [...(prev[mealKey] || []), item] }));
    if (currentUser?.id && typeof dbAddMeal === "function") {
      dbAddMeal(currentUser.id, item, mealKey, selectedDate).then((saved) => {
        if (typeof dbSaveUserXp === "function") {
          const newXp = (userXp?.current_xp || 2450) + 15;
          setUserXp((prev) => ({ ...(prev || {}), current_xp: newXp }));
          dbSaveUserXp(currentUser.id, newXp);
        }
      });
    }
  }

  function removeItem(mealKey, idx) {
    const itemToRemove = meals[mealKey]?.[idx];
    setMeals((prev) => ({ ...prev, [mealKey]: (prev[mealKey] || []).filter((_, i) => i !== idx) }));
    if (itemToRemove?.dbId && typeof dbDeleteMeal === "function") {
      dbDeleteMeal(itemToRemove.dbId);
    }
  }

  function handleSetWater(updater) {
    setWater((prev) => {
      const currentPrev = (typeof prev === "number" && !isNaN(prev) && prev >= 0 && prev <= 15) ? prev : 0;
      const nextVal = typeof updater === "function" ? updater(currentPrev) : updater;
      const safeVal = Math.max(0, Math.min(10, Number(Number(nextVal).toFixed(2)) || 0));
      if (currentUser?.id) {
        if (typeof dbSetDailyWater === "function") {
          dbSetDailyWater(currentUser.id, safeVal, selectedDate);
        } else if (typeof dbLogWater === "function") {
          dbLogWater(currentUser.id, Math.round(safeVal * 1000), selectedDate);
        }
      }
      return safeVal;
    });
  }

  function addMealSlot(name) {
    const key = `custom_${Date.now()}`;
    setMealSlots((prev) => [...prev, { key, label: name }]);
    setMeals((prev) => ({ ...prev, [key]: [] }));
  }
  function removeMealSlot(key) {
    setMealSlots((prev) => prev.filter((s) => s.key !== key));
    setMeals((prev) => {
      const next = { ...prev };
      delete next[key];
      return next;
    });
  }

  const [programKey, setProgramKey] = useState("Classic Split");
  const weekIndex = getWeekIndex();
  const week = resolveWeek(WORKOUT_PROGRAMS[programKey] || WORKOUT_PROGRAMS["Classic Split"], weekIndex);
  const [activeDay, setActiveDay] = useState(TODAY_KEY);
  const [logs, setLogs] = useState(() => buildLogs(resolveWeek(WORKOUT_PROGRAMS["Classic Split"], getWeekIndex())));
  function switchProgram(name) {
    const validName = (WORKOUT_PROGRAMS[name] ? name : "Home Workout");
    setProgramKey(validName);
    setLogs(buildLogs(resolveWeek(WORKOUT_PROGRAMS[validName], weekIndex)));
    setActiveDay(TODAY_KEY);
  }
  function updateSet(exName, setIdx, field, value) {
    setLogs((prev) => ({ ...prev, [activeDay]: { ...prev[activeDay], [exName]: { ...prev[activeDay][exName], sets: prev[activeDay][exName].sets.map((s, i) => (i === setIdx ? { ...s, [field]: value } : s)) } } }));
  }
  function addSet(exName) {
    setLogs((prev) => ({ ...prev, [activeDay]: { ...prev[activeDay], [exName]: { ...prev[activeDay][exName], sets: [...prev[activeDay][exName].sets, { reps: "", weight: "" }] } } }));
  }
  function toggleComplete(exName) {
    setLogs((prev) => {
      const isNowCompleted = !prev[activeDay]?.[exName]?.completed;
      const updated = { ...prev, [activeDay]: { ...prev[activeDay], [exName]: { ...prev[activeDay][exName], completed: isNowCompleted } } };

      // Persist workout state and award XP in Supabase
      if (currentUser?.id && typeof dbSaveWorkout === "function") {
        const todayStr = typeof getLocalDateStr === "function" ? getLocalDateStr() : new Date().toISOString().split("T")[0];
        const exSets = prev[activeDay]?.[exName]?.sets || [];
        dbSaveWorkout(currentUser.id, {
          workout_date: todayStr,
          program_name: programKey,
          day_name: activeDay,
          notes: `Completed: ${exName}`
        }).then(res => {
          if (res?.data?.id && typeof dbLogExerciseSet === "function") {
            exSets.forEach((s, idx) => {
              dbLogExerciseSet(currentUser.id, {
                workout_id: res.data.id,
                exercise_name: exName,
                set_number: idx + 1,
                reps: parseInt(s.reps, 10) || 0,
                weight_kg: parseFloat(s.weight) || 0,
                completed: isNowCompleted
              });
            });
          }
          if (isNowCompleted && typeof dbSaveUserXp === "function") {
            const newXp = (userXp?.current_xp || 2450) + 25;
            setUserXp(p => ({ ...(p || {}), current_xp: newXp }));
            dbSaveUserXp(currentUser.id, newXp);
          }
        }).catch(err => console.warn("Supabase workout log notice:", err));
      }

      return updated;
    });
  }

  const [runs, setRuns] = useState(() => {
    try {
      const saved = localStorage.getItem("stoke_runs_v2");
      return saved ? JSON.parse(saved) : [];
    } catch { return []; }
  });
  const [runStatus, setRunStatus] = useState("idle");
  const [runElapsed, setRunElapsed] = useState(0);
  const [runDistanceKm, setRunDistanceKm] = useState(0);
  const [runGpsError, setRunGpsError] = useState(null);
  const [runAccuracy, setRunAccuracy] = useState(null);
  const [runGpsStatus, setRunGpsStatus] = useState("acquiring"); // "acquiring" | "ready" | "weak"
  const [runLiveSpeed, setRunLiveSpeed] = useState(0);
  const [runShareCardUrl, setRunShareCardUrl] = useState(null);
  const [runShareStyle, setRunShareStyle] = useState("dark");
  const [runLiveGpsPos, setRunLiveGpsPos] = useState(null);
  const runWatchIdRef = useRef(null);
  const runLastAcceptedPointRef = useRef(null);
  const smoothedMarkerPosRef = useRef(null);
  const runPathRef = useRef([]);
  const runTimerRef = useRef(null);
  const lastGpsMotionRef = useRef(0);
  const runStartTimeRef = useRef(null);

  useEffect(() => {
    return () => {
      if (runWatchIdRef.current !== null && navigator.geolocation) {
        navigator.geolocation.clearWatch(runWatchIdRef.current);
        runWatchIdRef.current = null;
      }
      if (runTimerRef.current) {
        clearInterval(runTimerRef.current);
        runTimerRef.current = null;
      }
    };
  }, []);

  function runStartWatch() {
    if (!navigator.geolocation) {
      setRunGpsError("GPS isn't available on this device.");
      setRunGpsStatus("weak");
      return;
    }
    if (runWatchIdRef.current !== null) {
      navigator.geolocation.clearWatch(runWatchIdRef.current);
      runWatchIdRef.current = null;
    }
    runWatchIdRef.current = navigator.geolocation.watchPosition(
      (pos) => {
        const coords = pos.coords;
        const rawLat = coords.latitude;
        const rawLng = coords.longitude;
        const accuracy = coords.accuracy;
        const speed = coords.speed;
        const heading = coords.heading;
        const timestamp = pos.timestamp || Date.now();

        if (isNaN(rawLat) || isNaN(rawLng) || rawLat < -90 || rawLat > 90 || rawLng < -180 || rawLng > 180) {
          return;
        }

        setRunAccuracy(accuracy);

        // Filter inaccurate readings: must be <= 28 meters
        if (!accuracy || isNaN(accuracy) || accuracy > 28) {
          setRunGpsStatus("weak");
          return; // Ignore poor accuracy points
        }

        setRunGpsStatus("ready");

        const currentPoint = { lat: rawLat, lng: rawLng, accuracy, speed, heading, timestamp };

        // Visual marker smoothing to prevent erratic jitter when stationary
        if (!smoothedMarkerPosRef.current) {
          smoothedMarkerPosRef.current = [rawLat, rawLng];
          setRunLiveGpsPos([rawLat, rawLng]);
        } else {
          const mDistM = haversineKm(
            { lat: smoothedMarkerPosRef.current[0], lng: smoothedMarkerPosRef.current[1] },
            { lat: rawLat, lng: rawLng }
          ) * 1000;
          if (mDistM >= 2.5) {
            const factor = mDistM > 20 ? 0.8 : 0.35;
            const sLat = smoothedMarkerPosRef.current[0] + (rawLat - smoothedMarkerPosRef.current[0]) * factor;
            const sLng = smoothedMarkerPosRef.current[1] + (rawLng - smoothedMarkerPosRef.current[1]) * factor;
            smoothedMarkerPosRef.current = [sLat, sLng];
            setRunLiveGpsPos([sLat, sLng]);
          }
        }

        // If first accepted point
        if (!runLastAcceptedPointRef.current) {
          runLastAcceptedPointRef.current = currentPoint;
          runPathRef.current = [{ lat: rawLat, lng: rawLng }];
          return;
        }

        const lastPoint = runLastAcceptedPointRef.current;
        const distKm = haversineKm(lastPoint, currentPoint);
        const distMeters = distKm * 1000;
        const dtSeconds = Math.max(0.5, (timestamp - lastPoint.timestamp) / 1000);
        const calculatedSpeedKmh = (distKm / (dtSeconds / 3600));

        // Rejection rule 1: Unrealistic movement / GPS teleportation glitch (> 50 km/h)
        if (calculatedSpeedKmh > 50) {
          return;
        }

        // Rejection rule 2: Stationary GPS drift
        const isHardwareStationary = (speed !== null && speed !== undefined && !isNaN(speed) && speed < 0.6);
        const minThresholdMeters = Math.max(7.5, accuracy * 0.55);

        if (distMeters < minThresholdMeters || isHardwareStationary) {
          setRunLiveSpeed(0);
          return; // Ignore drift while stationary
        }

        // Genuine movement detected: accept coordinate
        runLastAcceptedPointRef.current = currentPoint;
        runPathRef.current.push({ lat: rawLat, lng: rawLng });
        setRunDistanceKm((prev) => Number((prev + distKm).toFixed(3)));

        const currentSpeedKmh = (speed !== null && speed !== undefined && !isNaN(speed) && speed >= 0.5)
          ? (speed * 3.6)
          : calculatedSpeedKmh;
        setRunLiveSpeed(currentSpeedKmh);
        lastGpsMotionRef.current = Date.now();
      },
      (err) => {
        setRunGpsError(err.message || "Location permission was denied.");
        setRunGpsStatus("weak");
      },
      { enableHighAccuracy: true, maximumAge: 1000, timeout: 20000 }
    );
  }

  function runStartTimer() {
    if (runTimerRef.current) clearInterval(runTimerRef.current);
    runTimerRef.current = setInterval(() => {
      setRunElapsed((e) => e + 1);
    }, 1000);
  }

  function runStopTimer() {
    if (runTimerRef.current) {
      clearInterval(runTimerRef.current);
      runTimerRef.current = null;
    }
  }

  function handleRunStart() {
    setRunStatus("active");
    setRunElapsed(0);
    setRunDistanceKm(0);
    setRunGpsError(null);
    setRunAccuracy(null);
    setRunGpsStatus("acquiring");
    setRunLiveSpeed(0);
    setRunShareCardUrl(null);
    setRunShareStyle("dark");
    runStartTimeRef.current = new Date();
    runLastAcceptedPointRef.current = null;
    smoothedMarkerPosRef.current = null;
    runPathRef.current = [];
    lastGpsMotionRef.current = 0;
    runStartWatch();
    runStartTimer();
  }

  function handleRunPause() {
    setRunStatus("paused");
    runStopTimer();
  }

  function handleRunResume() {
    setRunStatus("active");
    runStartTimer();
  }

  function handleRunFinish() {
    setRunStatus("finished");
    runStopTimer();
    if (runWatchIdRef.current !== null && navigator.geolocation) {
      navigator.geolocation.clearWatch(runWatchIdRef.current);
      runWatchIdRef.current = null;
    }
    const liveDist = runDistanceKm > 0 ? runDistanceKm : 0;
    const paceMinPerKm = (liveDist >= 0.03 && runElapsed > 0) ? (runElapsed / 60 / liveDist) : 0;
    const calories = Math.round(liveDist * RUNNER_WEIGHT_KG * 1.036);
    setRunShareCardUrl(drawShareCard({ distanceKm: liveDist, elapsed: runElapsed, paceMinPerKm, path: runPathRef.current, style: runShareStyle }));
    
    const startTime = runStartTimeRef.current || new Date();
    const dtInfo = formatRunDateTime(startTime);
    const title = getActivityTitleByTime(startTime, "run");

    setRuns((prev) => {
      const newEntry = {
        date: dtInfo.datePrefix,
        dateLabel: dtInfo.datePrefix,
        timeLabel: dtInfo.timeLabel,
        dateStr: `${dtInfo.fullLabel} · Live GPS`,
        title: title,
        sport: "run",
        distanceKm: liveDist,
        distance: liveDist,
        elapsed: runElapsed,
        time: runElapsed,
        paceMinPerKm,
        pace: paceMinPerKm,
        calories,
        path: [...runPathRef.current],
        id: Date.now()
      };
      const updated = [newEntry, ...prev];
      try { localStorage.setItem("stoke_runs_v2", JSON.stringify(updated)); } catch {}

      // Persist running activity and GPS coordinates to Supabase
      if (currentUser?.id && typeof dbSaveRunningActivity === "function") {
        const actDate = dtInfo?.datePrefix || (typeof getLocalDateStr === "function" ? getLocalDateStr() : new Date().toISOString().split("T")[0]);
        dbSaveRunningActivity(currentUser.id, {
          activity_date: actDate,
          distance_km: liveDist,
          duration_seconds: runElapsed,
          pace_seconds_per_km: paceMinPerKm > 0 ? Math.round(paceMinPerKm * 60) : 0,
          calories_burned: calories,
          route_coordinates: runPathRef.current || [],
          sport_type: "run",
          title: title,
        }).then(res => {
          if (res?.data && typeof dbSaveUserXp === "function") {
            const runXpGain = Math.min(300, Math.round(50 + (liveDist * 20)));
            const newTotal = (userXp?.current_xp || 2450) + runXpGain;
            setUserXp(prev => ({ ...(prev || {}), current_xp: newTotal }));
            dbSaveUserXp(currentUser.id, newTotal);
          }
        }).catch(err => console.warn("Supabase run save error:", err));
      }

      return updated;
    });
  }

  function handleRunChangeStyle(style) {
    setRunShareStyle(style);
    const liveDist = runDistanceKm > 0 ? runDistanceKm : 0;
    const paceMinPerKm = (liveDist >= 0.03 && runElapsed > 0) ? (runElapsed / 60 / liveDist) : 0;
    setRunShareCardUrl(drawShareCard({ distanceKm: liveDist, elapsed: runElapsed, paceMinPerKm, path: runPathRef.current, style }));
  }

  function handleRunReset() {
    setRunStatus("idle");
    setRunElapsed(0);
    setRunDistanceKm(0);
    setRunGpsError(null);
    setRunAccuracy(null);
    setRunGpsStatus("acquiring");
    setRunLiveSpeed(0);
    setRunShareCardUrl(null);
    if (runWatchIdRef.current !== null && navigator.geolocation) {
      navigator.geolocation.clearWatch(runWatchIdRef.current);
      runWatchIdRef.current = null;
    }
    if (runTimerRef.current) {
      clearInterval(runTimerRef.current);
      runTimerRef.current = null;
    }
  }
  const [messages, setMessages] = useState([]);
  const [input, setInput] = useState("");
  const [loading, setLoading] = useState(false);
  const remaining = {
    calories: Math.max(0, Math.round(goals.calories - totals.calories)),
    protein: Math.max(0, Math.round(goals.protein - totals.protein)),
    carbs: Math.max(0, Math.round(goals.carbs - totals.carbs)),
    fat: Math.max(0, Math.round(goals.fat - totals.fat)),
  };

  if (showWelcome) {
    return (
      <WelcomeCarousel
        onSignUp={() => { setAuthMode("signup"); setShowWelcome(false); }}
        onLogIn={() => { setAuthMode("signin"); setShowWelcome(false); }}
      />
    );
  }

  if (!authed) {
    return <AuthScreen onSignIn={handleSignIn} initialMode={authMode} />;
  }

  return (
    <div style={{ background: "radial-gradient(circle at 50% 0%, #10162A 0%, #08090E 70%)", height: "100vh", fontFamily: "'Space Grotesk', ui-sans-serif, system-ui, sans-serif", display: "flex", flexDirection: "column" }}>
      <div style={{ maxWidth: 480, width: "100%", margin: "0 auto", display: "flex", flexDirection: "column", height: "100%", position: "relative" }}>
        <div style={{
          flex: 1,
          overflowY: "auto",
          WebkitOverflowScrolling: "touch",
          padding: tab === "run" ? "max(16px, env(safe-area-inset-top, 16px)) 14px 110px" : "max(20px, env(safe-area-inset-top, 20px)) 16px 90px",
          display: "flex",
          flexDirection: "column",
          position: "relative"
        }}>
          {tab === "home" && (
            <HomeScreen
              totals={totals}
              calPct={calPct}
              goals={goals}
              workoutDay={week[TODAY_KEY]}
              workoutLog={logs[TODAY_KEY]}
              lastRun={runs[0]}
              profileName={profile.name}
              water={water}
              setWater={handleSetWater}
              onNavigate={handleNavigate}
              meals={meals}
              mealSlots={mealSlots}
              addItem={addItem}
              logs={logs}
              runs={runs}
              profile={profile}
              week={week}
              remaining={remaining}
              selectedDate={selectedDate}
              onSelectDate={setSelectedDate}
            />
          )}
          {tab === "nutrition" && (
            <NutritionScreen
              meals={meals}
              mealSlots={mealSlots}
              addMealSlot={addMealSlot}
              removeMealSlot={removeMealSlot}
              water={water}
              setWater={handleSetWater}
              addItem={addItem}
              removeItem={removeItem}
              totals={totals}
              calPct={calPct}
              goals={goals}
              onBack={handleBack}
              onNavigate={handleNavigate}
              selectedDate={selectedDate}
              onSelectDate={setSelectedDate}
            />
          )}
          {tab === "workout" && <WorkoutScreen week={week} programKey={programKey} onProgramChange={switchProgram} activeDay={activeDay} setActiveDay={setActiveDay} logs={logs} updateSet={updateSet} addSet={addSet} toggleComplete={toggleComplete} onNavigate={handleNavigate} onBack={handleBack} profile={profile} />}
          {tab === "run" && (
            <RunScreen
              profile={profile}
              runs={runs}
              setRuns={setRuns}
              status={runStatus}
              elapsed={runElapsed}
              distanceKm={runDistanceKm}
              setDistanceKm={setRunDistanceKm}
              gpsError={runGpsError}
              accuracy={runAccuracy}
              gpsStatus={runGpsStatus}
              liveSpeed={runLiveSpeed}
              shareCardUrl={runShareCardUrl}
              shareStyle={runShareStyle}
              onChangeStyle={handleRunChangeStyle}
              pathRef={runPathRef}
              handleStart={handleRunStart}
              handlePause={handleRunPause}
              handleResume={handleRunResume}
              handleFinish={handleRunFinish}
              handleReset={handleRunReset}
              liveGpsPos={runLiveGpsPos}
              runStartTimeRef={runStartTimeRef}
              onNavigate={handleNavigate}
              onBack={handleBack}
            />
          )}

          {(tab === "more" || tab === "profile") && <MoreHubScreen profile={profile} setProfile={setProfile} goals={goals} userPhone={userPhone} onSignOut={handleSignOut} onSwitchAccount={handleSignIn} totals={totals} onNavigate={handleNavigate} onBack={handleBack} currentUser={currentUser} onOpenSupabaseModal={() => setShowSupabaseModal(true)} />}
        </div>
        <div style={{ padding: "0 12px max(14px, env(safe-area-inset-bottom, 14px))", background: "transparent" }}>
          <div style={{ position: "relative", display: "flex", background: "rgba(22,27,36,0.75)", backdropFilter: "blur(20px) saturate(180%)", WebkitBackdropFilter: "blur(20px) saturate(180%)", border: "1px solid rgba(255,255,255,0.1)", borderRadius: 999, padding: 6, boxShadow: "0 8px 24px rgba(0,0,0,0.4)" }}>
            <div
              style={{
                position: "absolute",
                top: 6,
                bottom: 6,
                left: `calc(${(TABS.findIndex((t) => t.key === tab) / TABS.length) * 100}% + 6px)`,
                width: `calc(${100 / TABS.length}% - 12px)`,
                borderRadius: 999,
                background: "linear-gradient(155deg, rgba(37,107,253,0.38), rgba(37,107,253,0.12))",
                backdropFilter: "blur(6px)",
                WebkitBackdropFilter: "blur(6px)",
                border: "1px solid rgba(37,107,253,0.45)",
                boxShadow: "0 0 16px rgba(37,107,253,0.35)",
                transition: "left 0.45s cubic-bezier(0.34, 1.56, 0.64, 1)",
              }}
            />
            {TABS.map((t) => (
              <button key={t.key} onClick={() => handleTabClick(t.key)} style={{ flex: 1, background: "none", border: "none", padding: "9px 0 7px", cursor: "pointer",
                color: tab === t.key ? "#3B82F6" : TOKENS.mutedFaint, display: "flex", flexDirection: "column", alignItems: "center", gap: 2, position: "relative", zIndex: 1 }}>
                <span style={{ position: "relative", display: "flex" }}>
                  <NavIcon name={t.icon} size={19} />
                  {t.key === "run" && runStatus === "active" && (
                    <span style={{ position: "absolute", top: -2, right: -6, width: 8, height: 8, borderRadius: "50%", background: TOKENS.ember, border: "1.5px solid rgba(22,27,36,0.9)" }} />
                  )}
                </span>
                <span style={{ fontSize: 9.5, fontWeight: 600 }}>{t.label}</span>
              </button>
            ))}
          </div>
        </div>
        <SupabaseSettingsModal isOpen={showSupabaseModal} onClose={() => setShowSupabaseModal(false)} />
      </div>
    </div>
  );
}

ReactDOM.createRoot(document.getElementById("root")).render(<StokeApp />);
  </script>
</body>
</html>
