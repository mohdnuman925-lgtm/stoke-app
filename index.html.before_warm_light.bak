        <button onClick={onClose} style={{ width: "100%", background: "linear-gradient(135deg, #F59E0B 0%, #D97706 100%)", border: "none", borderRadius: 14, padding: "14px 0", color: "#0B0E13", fontSize: 15, fontWeight: 800, cursor: "pointer", boxShadow: "0 8px 24px rgba(245,158,11,0.4)" }}>
          Claim Glory ⚡
        </button>
      </div>
    </div>
  );
}

/* ============================================================
   1 & 2. FITNESS SCORE + LEVEL/XP CARD ROW
   ============================================================ */
function FitnessScoreAndXpCard({ scoreData, xpData, onViewScoreDetails }) {
  if (!scoreData || !xpData) return null;

  // Segmented progress bar calculation (10 blocks)
  const totalBlocks = 10;
  const filledBlocks = Math.min(totalBlocks, Math.max(1, Math.round(xpData.progressPct * totalBlocks)));

  return (
    <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 10, marginBottom: 14 }}>
      {/* Card 1: Fitness Score */}
      <div
        onClick={onViewScoreDetails}
        style={{
          cursor: "pointer",
          background: "linear-gradient(145deg, rgba(20,26,42,0.85) 0%, rgba(12,15,24,0.92) 100%)",
          backdropFilter: "blur(16px)",
          WebkitBackdropFilter: "blur(16px)",
          border: "1px solid rgba(37, 107, 253, 0.28)",
          borderRadius: 20,
          padding: "16px 14px",
          display: "flex",
          flexDirection: "column",
          justifyContent: "space-between",
          boxShadow: "0 8px 24px rgba(0,0,0,0.45)",
          position: "relative",
          overflow: "hidden"
        }}
      >
        <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 8 }}>
          <div style={{ display: "flex", alignItems: "center", gap: 5 }}>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="#3B82F6"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
            <span style={{ fontSize: 10.5, fontWeight: 800, color: "#3B82F6", textTransform: "uppercase", letterSpacing: 0.5 }}>Fitness Score</span>
          </div>
          <span style={{ fontSize: 9.5, background: "rgba(34,197,94,0.16)", color: "#22C55E", padding: "2px 6px", borderRadius: 999, fontWeight: 700 }}>
            ▲ {scoreData.weeklyDelta}
          </span>
        </div>

        {/* Circular Progress & Big Number */}
        <div style={{ display: "flex", alignItems: "center", gap: 12, margin: "6px 0" }}>
          <div style={{ width: 54, height: 54, position: "relative", display: "flex", alignItems: "center", justifyContent: "center", flexShrink: 0 }}>
            <svg width="54" height="54" viewBox="0 0 54 54" style={{ transform: "rotate(-90deg)" }}>
              <circle cx="27" cy="27" r="22" stroke="rgba(255,255,255,0.08)" strokeWidth="4.5" fill="none" />
              <circle
                cx="27"
                cy="27"
                r="22"
                stroke="url(#homeScoreGrad)"
                strokeWidth="4.5"
                fill="none"
                strokeDasharray={138.2}
                strokeDashoffset={138.2 * (1 - scoreData.total / 100)}
                strokeLinecap="round"
                style={{ transition: "stroke-dashoffset 0.8s ease" }}
              />
              <defs>
                <linearGradient id="homeScoreGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stopColor="#256BFD" />
                  <stop offset="100%" stopColor="#3DDCFF" />
                </linearGradient>
              </defs>
            </svg>
            <div style={{ position: "absolute", fontSize: 14, fontWeight: 900, color: "#FFFFFF" }}>{scoreData.total}</div>
          </div>

          <div>
            <div style={{ fontSize: 19, fontWeight: 900, color: "#FFFFFF", lineHeight: 1.1 }}>
              {scoreData.total} <span style={{ fontSize: 11, color: "rgba(255,255,255,0.45)", fontWeight: 600 }}>/ 100</span>
            </div>
            <div style={{ fontSize: 10, color: "rgba(255,255,255,0.6)", marginTop: 3, lineHeight: 1.2 }}>
              Consistency Index
            </div>
          </div>
        </div>

        <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginTop: 4, paddingTop: 6, borderTop: "1px solid rgba(255,255,255,0.06)" }}>
          <span style={{ fontSize: 10, color: "rgba(255,255,255,0.5)" }}>Hydration & Lift</span>
          <span style={{ fontSize: 10.5, fontWeight: 700, color: "#3B82F6", display: "flex", alignItems: "center", gap: 2 }}>
            View Details →
          </span>
        </div>
      </div>

      {/* Card 2: Fitness Level + XP */}
      <div
        style={{
          background: "linear-gradient(145deg, rgba(28,24,18,0.85) 0%, rgba(15,13,10,0.92) 100%)",
          backdropFilter: "blur(16px)",
          WebkitBackdropFilter: "blur(16px)",
          border: "1px solid rgba(245, 158, 11, 0.3)",
          borderRadius: 20,
          padding: "16px 14px",
          display: "flex",
          flexDirection: "column",
          justifyContent: "space-between",
          boxShadow: "0 8px 24px rgba(0,0,0,0.45)",
          position: "relative",
          overflow: "hidden"
        }}
      >
        <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 6 }}>
          <div style={{ display: "flex", alignItems: "center", gap: 5 }}>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="#F59E0B"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <span style={{ fontSize: 10.5, fontWeight: 800, color: "#F59E0B", textTransform: "uppercase", letterSpacing: 0.5 }}>Level {xpData.level}</span>
          </div>
          <span style={{ fontSize: 9.5, background: "rgba(245,158,11,0.18)", color: "#F59E0B", padding: "2px 6px", borderRadius: 999, fontWeight: 800 }}>
            ATHLETE
          </span>
        </div>

        <div>
          <div style={{ fontSize: 15, fontWeight: 800, color: "#FFFFFF", letterSpacing: -0.3 }}>
            {xpData.xp.toLocaleString()} <span style={{ fontSize: 11, color: "rgba(255,255,255,0.45)", fontWeight: 500 }}>/ {xpData.nextLevelThreshold.toLocaleString()} XP</span>
          </div>

          {/* High-tech Segmented Bar: ████████░░ */}
          <div style={{ display: "flex", gap: 3, margin: "8px 0" }}>
            {Array.from({ length: totalBlocks }).map((_, idx) => {
              const isFilled = idx < filledBlocks;
              return (
                <div
                  key={idx}
                  style={{
                    flex: 1,
                    height: 8,
                    borderRadius: 2,
                    background: isFilled ? "linear-gradient(180deg, #FBBF24 0%, #D97706 100%)" : "rgba(255,255,255,0.08)",
                    boxShadow: isFilled ? "0 0 6px rgba(245,158,11,0.4)" : "none",
                    transition: "all 0.3s ease"
                  }}
                />
              );
            })}
          </div>

          <div style={{ fontSize: 10.5, color: "rgba(255,255,255,0.6)", fontWeight: 600 }}>
            {xpData.xpUntilNext.toLocaleString()} XP until Level {xpData.level + 1}
          </div>
        </div>

        <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginTop: 4, paddingTop: 6, borderTop: "1px solid rgba(255,255,255,0.06)" }}>
          <span style={{ fontSize: 10, color: "rgba(255,255,255,0.45)" }}>Workouts +100 · Runs +50</span>
        </div>
      </div>
    </div>
  );
}

